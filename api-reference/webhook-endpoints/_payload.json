y-Signature"," header in the ",[211,212,214],"a",{"href":213},"/guides/webhooks#verifying-signatures","Webhooks guide",").",[198,217,218,219,223],{},"There is ",[220,221,222],"strong",{},"at most one endpoint per mode"," — one for test and one for live — and the mode is determined by the API token you use. Managing endpoints from the API is useful for provisioning from CI / infrastructure-as-code, or pointing an ephemeral preview environment at its own public URL.",[225,226,227,228,231],"note",{},"The signing ",[220,229,230],{},"secret is write-only",": you supply it on creation (and may rotate it via update), but it is never returned in any response. Store the value you send — the API will not give it back.",[233,234,236],"h3",{"id":235},"properties","Properties",[238,239,240,256],"table",{},[241,242,243],"thead",{},[244,245,246,250,253],"tr",{},[247,248,249],"th",{},"Name",[247,251,252],{},"Type",[247,254,255],{},"Description",[257,258,259,278,296,311,325,339],"tbody",{},[244,260,261,267,272],{},[262,263,264],"td",{},[202,265,266],{},"id",[262,268,269],{},[202,270,271],{},"string",[262,273,274,275,215],{},"Unique identifier for the webhook endpoint (starts with ",[202,276,277],{},"webhook_",[244,279,280,285,289],{},[262,281,282],{},[202,283,284],{},"resource",[262,286,287],{},[202,288,271],{},[262,290,291,292,295],{},"The resource type. Always ",[202,293,294],{},"webhook_endpoint",".",[244,297,298,303,308],{},[262,299,300],{},[202,301,302],{},"testmode",[262,304,305],{},[202,306,307],{},"boolean",[262,309,310],{},"Whether this endpoint receives test-mode events.",[244,312,313,318,322],{},[262,314,315],{},[202,316,317],{},"url",[262,319,320],{},[202,321,271],{},[262,323,324],{},"The HTTPS URL deliveries are POSTed to.",[244,326,327,332,336],{},[262,328,329],{},[202,330,331],{},"createdAt",[262,333,334],{},[202,335,271],{},[262,337,338],{},"When this endpoint was created (ISO 8601 format).",[244,340,341,346,351],{},[262,342,343],{},[202,344,345],{},"links",[262,347,348],{},[202,349,350],{},"object",[262,352,353,354,295],{},"HATEOAS links to related resources. Contains ",[202,355,356],{},"self",[358,359],"hr",{},[193,361,363],{"id":362},"list-webhook-endpoints","List webhook endpoints",[198,365,366],{},[202,367,368],{},"GET /v1/webhook-endpoints",[198,370,371],{},"Returns the webhook endpoints for the authenticated merchant, filtered by the testmode determined from the API token. Because there is at most one endpoint per mode, this returns at most one endpoint. The signing secret is never included.",[233,373,375],{"id":374},"optional-attributes","Optional attributes",[238,377,378,388],{},[241,379,380],{},[244,381,382,384,386],{},[247,383,249],{},[247,385,252],{},[247,387,255],{},[257,389,390,405,419],{},[244,391,392,397,402],{},[262,393,394],{},[202,395,396],{},"limit",[262,398,399],{},[202,400,401],{},"integer",[262,403,404],{},"The number of endpoints to return (default: 10, max: 100).",[244,406,407,412,416],{},[262,408,409],{},[202,410,411],{},"startingAfter",[262,413,414],{},[202,415,271],{},[262,417,418],{},"A cursor for use in pagination. Returns results after this endpoint ID.",[244,420,421,426,430],{},[262,422,423],{},[202,424,425],{},"endingBefore",[262,427,428],{},[202,429,271],{},[262,431,432],{},"A cursor for use in pagination. Returns results before this endpoint ID.",[434,435,437,482,587],"code-group",{"sync":436},"api",[438,439,444],"pre",{"className":440,"code":441,"filename":442,"language":443,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -G https://api.vatly.com/v1/webhook-endpoints \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","cURL","bash",[202,445,446,466],{"__ignoreMap":109},[447,448,451,455,459,462],"span",{"class":449,"line":450},"line",1,[447,452,454],{"class":453},"sBMFI","curl",[447,456,458],{"class":457},"sfazB"," -G",[447,460,461],{"class":457}," https://api.vatly.com/v1/webhook-endpoints",[447,463,465],