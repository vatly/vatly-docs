ages/php/webhookendpoints","3.packages/1.php/99.webhookendpoints",{"title":152,"path":153,"stem":154,"children":155,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[156,159,162,165,168,171,174,178,182],{"title":117,"path":157,"stem":158},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":160,"stem":161},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":163,"stem":164},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":166,"stem":167},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":169,"stem":170},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":172,"stem":173},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":175,"path":176,"stem":177},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":179,"path":180,"stem":181},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":183,"path":184,"stem":185},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":187,"path":188,"stem":189},"Integrations","/integrations","4.integrations",{"id":191,"title":64,"body":192,"description":1498,"extension":1499,"links":1500,"meta":1501,"navigation":556,"path":65,"seo":1502,"stem":66,"__hash__":1503},"docs/2.api-reference/11.test-helpers.md",{"type":193,"value":194,"toc":1491},"minimark",[195,200,204,213,216,220,225,228,231,247,252,255,373,381,1414,1417,1487],[196,197,199],"h2",{"id":198},"test-helper-endpoints","Test helper endpoints",[201,202,203],"p",{},"Vatly provides a small set of test helper endpoints for recurring billing scenarios. These endpoints are only available in test mode.",[205,206,207,208,212],"warning",{},"Use a ",[209,210,211],"code",{},"test_"," API token for every endpoint on this page. Test helper endpoints are not available with live credentials.",[214,215],"hr",{},[196,217,219],{"id":218},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[201,221,222],{},[209,223,224],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[201,226,227],{},"Simulate a renewal cycle for an existing subscription.",[201,229,230],{},"Useful for:",[232,233,234,238,241,244],"ul",{},[235,236,237],"li",{},"testing renewal billing flows without waiting for the real billing interval",[235,239,240],{},"verifying subscription lifecycle events and webhook delivery",[235,242,243],{},"validating dunning or invoice follow-up automation in your sandbox flow",[235,245,246],{},"forcing the renewal payment to fail so you can exercise your payment-recovery handling",[248,249,251],"h3",{"id":250},"request-body","Request body",[201,253,254],{},"The request body is optional. Omit it to advance the billing cycle and leave the renewal payment pending (this endpoint's original behaviour).",[256,257,258,274],"table",{},[259,260,261],"thead",{},[262,263,264,268,271],"tr",{},[265,266,267],"th",{},"Attribute",[265,269,270],{},"Type",[265,272,273],{},"Description",[275,276,277,309],"tbody",{},[262,278,279,285,288],{},[280,281,282],"td",{},[209,283,284],{},"paymentStatus",[280,286,287],{},"string",[280,289,290,291,294,295,298,299,301,302,305,306,308],{},"Optional. Outcome to force on the renewal payment. One of ",[209,292,293],{},"paid"," or ",[209,296,297],{},"failed",". Omit to leave the renewal payment pending. ",[209,300,297],{}," declines the payment and starts a payment recovery for the renewal order (delivering ",[209,303,304],{},"order.payment_failed"," to your webhook endpoint); ",[209,307,293],{}," settles it.",[262,310,311,316,318],{},[280,312,313],{},[209,314,315],{},"failureReason",[280,317,287],{},[280,319,320,321,324,325,327,328,331,332,331,335,338,339,341,342,331,344,331,346,331,348,331,351,331,354,331,357,331,360,331,363,331,366,331,369,372],{},"Optional. Which decline to simulate. Only valid alongside ",[209,322,323],{},"paymentStatus: failed"," (sending it with ",[209,326,293],{}," is rejected). Soft declines (",[209,329,330],{},"insufficient_funds",", ",[209,333,334],{},"temporary_decline",[209,336,337],{},"general_failure",") keep the payment method and retry on a multi-week timeline; every other value is a hard decline that drives the customer to supply a new payment method on a short timeline. Defaults to ",[209,340,337],{},". Allowed values: ",[209,343,330],{},[209,345,334],{},[209,347,337],{},[209,349,350],{},"invalid_mandate",[209,352,353],{},"mandate_canceled",[209,355,356],{},"account_closed",[209,358,359],{},"card_expired",[209,361,362],{},"card_lost_or_stolen",[209,364,365],{},"invalid_card_details",[209,367,368],{},"authentication_failed",[209,370,371],{},"fraud_suspected",".",[374,375,376,377,380],"note",{},"Requesting an outcome for a renewal that produced no payable order, or whose payment has already settled, returns a ",[209,378,379],{},"409"," error rather than a silent no-op.",[382,383,384,481,641],"code-group",{},[385,386,391],"pre",{"className":387,"code":388,"filename":389,"language":390,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"paymentStatus\": \"failed\",\n    \"failureReason\": \"card_expired\"\n  }'\n","cURL","bash",[209,392,393,416,434,448,460,466,472],{"__ignoreMap":109},[394,395,398,402,406,409,412],"span",{"class":396,"line":397},"line",1,[394,399,401],{"class":400},"sBMFI","curl",[394,403,405],{"class":404},"sfazB"," -X",[394,407,408],{"class":404}," POST",[394,410,411],{"class":404}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3m