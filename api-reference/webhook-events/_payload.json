"id",[234,240,241],{},[195,242,243],{},"string",[234,245,246,247,250],{},"Unique identifier for the webhook event (starts with ",[195,248,249],{},"webhook_event_",").",[216,252,253,258,262],{},[234,254,255],{},[195,256,257],{},"resource",[234,259,260],{},[195,261,243],{},[234,263,264,265,203],{},"The resource type. Always ",[195,266,267],{},"webhook_event",[216,269,270,275,279],{},[234,271,272],{},[195,273,274],{},"eventName",[234,276,277],{},[195,278,243],{},[234,280,281,282,285,286,289,290,293],{},"The event name, such as ",[195,283,284],{},"order.paid"," or ",[195,287,288],{},"refund.completed",". See the ",[200,291,202],{"href":292},"/guides/webhooks#event-types"," for the full list.",[216,295,296,301,305],{},[234,297,298],{},[195,299,300],{},"entityType",[234,302,303],{},[195,304,243],{},[234,306,307,308,311,312,311,315,311,318,321,322,203],{},"The resource type the event refers to, such as ",[195,309,310],{},"order",", ",[195,313,314],{},"refund",[195,316,317],{},"chargeback",[195,319,320],{},"subscription",", or ",[195,323,324],{},"checkout",[216,326,327,332,336],{},[234,328,329],{},[195,330,331],{},"entityId",[234,333,334],{},[195,335,243],{},[234,337,338],{},"The ID of the related resource.",[216,340,341,346,350],{},[234,342,343],{},[195,344,345],{},"object",[234,347,348],{},[195,349,345],{},[234,351,352,353,355,356,359,360,362,363,366,367,203],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, or Checkout), keyed by its own ",[195,354,257],{}," field. Note ",[195,357,358],{},"object.resource"," can differ from ",[195,361,300],{},": chargeback events carry ",[195,364,365],{},"entityType: order"," but a Chargeback ",[195,368,345],{},[216,370,371,376,380],{},[234,372,373],{},[195,374,375],{},"createdAt",[234,377,378],{},[195,379,243],{},[234,381,382],{},"When the event occurred (ISO 8601 format).",[216,384,385,390,395],{},[234,386,387],{},[195,388,389],{},"testmode",[234,391,392],{},[195,393,394],{},"boolean",[234,396,397],{},"Whether the event originated from a test-mode resource.",[216,399,400,405,409],{},[234,401,402],{},[195,403,404],{},"links",[234,406,407],{},[195,408,345],{},[234,410,411,412,203],{},"HATEOAS links. Contains ",[195,413,414],{},"self",[416,417],"hr",{},[181,419,421],{"id":420},"get-a-webhook-event","Get a webhook event",[186,423,424],{},[195,425,426],{},"GET /v1/webhook-events/:eventId",[186,428,429],{},"This endpoint returns the full webhook event payload for a specific event ID.",[205,431,433],{"id":432},"parameters","Parameters",[210,435,436,446],{},[213,437,438],{},[216,439,440,442,444],{},[219,441,221],{},[219,443,224],{},[219,445,227],{},[229,447,448],{},[216,449,450,455,459],{},[234,451,452],{},[195,453,454],{},"eventId",[234,456,457],{},[195,458,243],{},[234,460,461],{},"The unique identifier of the webhook event.",[463,464,466,508,622],"code-group",{"sync":465},"api",[467,468,473],"pre",{"className":469,"code":470,"filename":471,"language":472,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSvWm2NjLhYcZaE \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","cURL","bash",[195,474,475,492],{"__ignoreMap":105},[476,477,480,484,488],"span",{"class":478,"line":479},"line",1,[476,481,483],{"class":482},"sBMFI","curl",[476,485,487],{"class":486},"sfazB"," https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSvWm2NjLhYcZaE",[476,489,491],{"class":490},"sTEyZ"," \\\n",[476,493,495,498,502,505],{"class":478,"line":494},2,[476,496,497],{"class":486},"  -H",[476,499,501],{"class":500},"sMK4o"," \"",[476,503,504],{"class":486},"Authorization: Bearer live_your_api_key_here",[476,506,507],{"class":500},"\"\n",[467,509,514],{"className":510,"code":511,"filename":512,"language":513,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-pa