ver persisted, so it does not appear here. For the full list of events and the live delivery envelope, see the ",[442,443,444],"a",{"href":51},"Webhooks guide",".",[447,448,450],"h3",{"id":449},"properties","Properties",[452,453,454,470],"table",{},[455,456,457],"thead",{},[458,459,460,464,467],"tr",{},[461,462,463],"th",{},"Name",[461,465,466],{},"Type",[461,468,469],{},"Description",[471,472,473,493,510,540,573,605,619,649,663,678],"tbody",{},[458,474,475,481,486],{},[476,477,478],"td",{},[437,479,480],{},"id",[476,482,483],{},[437,484,485],{},"string",[476,487,488,489,492],{},"Unique identifier for the webhook event (starts with ",[437,490,491],{},"webhook_event_",").",[458,494,495,500,504],{},[476,496,497],{},[437,498,499],{},"resource",[476,501,502],{},[437,503,485],{},[476,505,506,507,445],{},"The resource type. Always ",[437,508,509],{},"webhook_event",[458,511,512,517,521],{},[476,513,514],{},[437,515,516],{},"eventName",[476,518,519],{},[437,520,485],{},[476,522,523,524,527,528,531,532,535,536,539],{},"The event name, such as ",[437,525,526],{},"order.paid",", ",[437,529,530],{},"refund.completed",", or ",[437,533,534],{},"subscription_plan.update_approved",". See the ",[442,537,444],{"href":538},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[458,541,542,547,552],{},[476,543,544],{},[437,545,546],{},"reason",[476,548,549],{},[437,550,551],{},"string | null",[476,553,554,555,558,559,562,563,527,566,531,569,572],{},"Why the event fired, for events with more than one cause. Always present; ",[437,556,557],{},"null"," for every event except ",[437,560,561],{},"subscription.updated",", where it is ",[437,564,565],{},"updated_immediately",[437,567,568],{},"updated_on_renewal",[437,570,571],{},"renewed",". New values may be added over time.",[458,574,575,580,584],{},[476,576,577],{},[437,578,579],{},"entityType",[476,581,582],{},[437,583,485],{},[476,585,586,587,527,590,527,593,527,596,527,599,531,602,445],{},"The resource type the event refers to