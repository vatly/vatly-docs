ou inspect the exact payload Vatly generated for a domain event. This is the ",[480,481,482],"strong",{},"persisted"," event, the record returned by this endpoint. The ",[485,486,487],"code",{},"webhook.setup"," verification call is a delivery-only handshake and is never persisted, so it does not appear here. For the full list of events and the live delivery envelope, see the ",[490,491,492],"a",{"href":51},"Webhooks guide",".",[495,496,498],"h3",{"id":497},"properties","Properties",[500,501,502,518],"table",{},[503,504,505],"thead",{},[506,507,508,512,515],"tr",{},[509,510,511],"th",{},"Name",[509,513,514],{},"Type",[509,516,517],{},"Description",[519,520,521,541,558,588,621,653,667,697,711,726],"tbody",{},[506,522,523,529,534],{},[524,525,526],"td",{},[485,527,528],{},"id",[524,530,531],{},[485,532,533],{},"string",[524,535,536,537,540],{},"Unique identifier for the webhook event (starts with ",[485,538,539],{},"webhook_event_",").",[506,542,543,548,552],{},[524,544,545],{},[485,546,547],{},"resource",[524,549,550],{},[485,551,533],{},[524,553,554,555,493],{},"The resource type. Always ",[485,556,557],{},"webhook_event",[506,559,560,565,569],{},[524,561,562],{},[485,563,564],{},"eventName",[524,566,567],{},[485,568,533],{},[524,570,571,572,575,576,579,580,583,584,587],{},"The event name, such as ",[485,573,574],{},"order.paid",", ",[485,577,578],{},"refund.completed",", or ",[485,581,582],{},"subscription_plan.update_approved",". See the ",[490,585,492],{"href":586},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[506,589,590,595,600],{},[524,591,592],{},[485,593,594],{},"reason",[524,596,597],{},[485,598,599],{},"string | null",[524,601,602,603,606,607,610,611,575,614,579,617,620],{},"Why the event fired, for events with more than one cause. Always present; ",[485,604,605],{},"null"," for every event except ",[485,608,609],{},"subscription.updated",", where it is ",[485,612,613],{},"updated_immediately",[485,615,616],{},"updated_on_renewal",[485,618,619],{},"renewed",". New values may be added over time.",[506,622,623,628,632],{},[524,624,625],{},[485,626,627],{},"entityType",[524,629,630],{},[485,631,533],{},[524,633,634,635,575,638,575,641,575,644,575,647,579,650,493],{},"The resource type the event refers to, such as ",[485,636,637],{},"order",[485,639,640],{},"refund",[485,642,643],{},"subscription",[485,645,646],{},"checkout",[485,648,649],{},"one_off_product",[485,651,652],{},"subscription_plan",[506,654,655,660,664],{},[524,656,657],{},[485,658,659],{},"entityId",[524,661,662],{},[485,663,533],{},[524,665,666],{},"The ID of the related resource.",[506,668,669,674,678],{},[524,670,671],{},[485,672,673],{},"object",[524,675,676],{},[485,677,673],{},[524,679,680,681,683,684,687,688,690,691,694,695,493],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, Checkout, OneOffProduct, or SubscriptionPlan), keyed by its own ",[485,682,547],{}," field. Note ",[485,685,686],{},"object.resource"," can differ from ",[485,689,627],{},": chargeback events carry ",[485,692,693],{},"entityType: order"," but a Chargeback ",[485,696,673],{},[506,698,699,704,708],{},[524,700,701],{},[485,702,703],{},"createdAt",[524,705,706],{},[485,707,533],{},[524,709,710],{},"When the event occurred (ISO 8601 format).",[506,712,713,718,723],{},[524,714,715],{},[485,716,717],{},"testmode",[524,719,720],{},[485,721,722],{},"boolean",[524,724,725],{},"Whether the event originated from a test-mode resource.",[506,727,728,733,737],{},[524,729,730],{},[485,731,732],{},"links",[524,734,735],{},[485,736,673],{},[524,738,739,740,493],{},"HATEOAS links. Contains ",[485,741,742],{},"self",[744,745],"hr",{},[471,747,749],{"id":748},"get-a-webhook-event","Get a webhook event",[476,751,752],{},[485,753,754],{},"GET \u002Fv1\u002Fwebhook-events\u002F:eventId",[476,756,757],{},"This endpoint returns the full webhook event payload for a specific event ID.",[495,759,761],{"id":760},"parameters",