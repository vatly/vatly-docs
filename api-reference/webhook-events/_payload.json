y this endpoint. The ",[482,483,484],"code",{},"webhook.setup"," verification call is a delivery-only handshake and is never persisted, so it does not appear here. For the full list of events and the live delivery envelope, see the ",[487,488,489],"a",{"href":51},"Webhooks guide",".",[492,493,495],"h3",{"id":494},"properties","Properties",[497,498,499,515],"table",{},[500,501,502],"thead",{},[503,504,505,509,512],"tr",{},[506,507,508],"th",{},"Name",[506,510,511],{},"Type",[506,513,514],{},"Description",[516,517,518,538,555,585,618,650,664,694,708,723],"tbody",{},[503,519,520,526,531],{},[521,522,523],"td",{},[482,524,525],{},"id",[521,527,528],{},[482,529,530],{},"string",[521,532,533,534,537],{},"Unique identifier for the webhook event (starts with ",[482,535,536],{},"webhook_event_",").",[503,539,540,545,549],{},[521,541,542],{},[482,543,544],{},"resource",[521,546,547],{},[482,548,530],{},[521,550,551,552,490],{},"The resource type. Always ",[482,553,554],{},"webhook_event",[503,556,557,562,566],{},[521,558,559],{},[482,560,561],{},"eventName",[521,563,564],{},[482,565,530],{},[521,567,568,569,572,573,576,577,580,581,584],{},"The event name, such as ",[482,570,571],{},"order.paid",", ",[482,574,575],{},"refund.completed",", or ",[482,578,579],{},"subscription_plan.update_approved",". See the ",[487,582,489],{"href":583},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[503,586,587,592,597],{},[521,588,589],{},[482,590,591],{},"reason",[521,593,594],{},[482,595,596],{},"string | null",[521,598,599,600,603,604,607,608,572,611,576,614,617],{},"Why the event fired, for events with more than one cause. Always present; ",[482,601,602],{},"null"," for every event except ",[482,605,606],{},"subscription.updated",", where it is ",[482,609,610],{},"updated_immediately",[482,612,613],{},"updated_on_renewal",[482,615,616],{},"renewed",". New values may be added over time.",[503,619,620,625,629],{},[521,621,622],{},[482,623,624],{},"entityType",[521,626,627],{}