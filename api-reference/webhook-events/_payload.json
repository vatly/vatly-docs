ot appear here. For the full list of events and the live delivery envelope, see the ",[212,213,214],"a",{"href":39},"Webhooks guide",".",[217,218,220],"h3",{"id":219},"properties","Properties",[222,223,224,240],"table",{},[225,226,227],"thead",{},[228,229,230,234,237],"tr",{},[231,232,233],"th",{},"Name",[231,235,236],{},"Type",[231,238,239],{},"Description",[241,242,243,263,280,306,337,351,381,395,410],"tbody",{},[228,244,245,251,256],{},[246,247,248],"td",{},[207,249,250],{},"id",[246,252,253],{},[207,254,255],{},"string",[246,257,258,259,262],{},"Unique identifier for the webhook event (starts with ",[207,260,261],{},"webhook_event_",").",[228,264,265,270,274],{},[246,266,267],{},[207,268,269],{},"resource",[246,271,272],{},[207,273,255],{},[246,275,276,277,215],{},"The resource type. Always ",[207,278,279],{},"webhook_event",[228,281,282,287,291],{},[246,283,284],{},[207,285,286],{},"eventName",[246,288,289],{},[207,290,255],{},[246,292,293,294,297,298,301,302,305],{},"The event name, such as ",[207,295,296],{},"order.paid"," or ",[207,299,300],{},"refund.completed",". See the ",[212,303,214],{"href":304},"/guides/webhooks#event-types"," for the full list.",[228,307,308,313,317],{},[246,309,310],{},[207,311,312],{},"entityType",[246,314,315],{},[207,316,255],{},[246,318,319,320,323,324,323,327,323,330,333,334,215],{},"The resource type the event refers to, such as ",[207,321,322],{},"order",", ",[207,325,326],{},"refund",[207,328,329],{},"chargeback",[207,331,332],{},"subscription",", or ",[207,335,336],{},"checkout",[228,338,339,344,348],{},[246,340,341],{},[207,342,343],{},"entityId",[246,345,346],{},[207,347,255],{},[246,349,350],{},"The ID of the related resource.",[228,352,353,358,362],{},[246,354,355],{},[207,356,357],{},"object",[246,359,360],{},[207,361,357],{},[246,363,364,365,367,368,371,372,374,375,378,379,215],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, or Checkout), keyed by its own ",[207,366,269],{}," field. Note ",[207,369,370],{},"object.resource"," can differ from ",[207,373,312],{},": chargeback events carry ",[207,376,377],{},"entityType: order"," but a Chargeback ",[207,380,357],{},[228,382,383,388,392],{},[246,384,385],{},[207,386,387],{},"createdAt",[246,389,390],{},[207,391,255],{},[246,393,394],{},"When the event occurred (ISO 8601 format).",[228,396,397,402,407],{},[246,398,399],{},[207,400,401],{},"testmode",[246,403,404],{},[207,405,406],{},"boolean",[246,408,409],{},"Whether the event originated from a test-mode resource.",[228,411,412,417,421],{},[246,413,414],{},[207,415,416],{},"links",[246,418,419],{},[207,420,357],{},[246,422,423,424,215],{},"HATEOAS links. Contains ",[207,425,426],{},"self",[428,429],"hr",{},[193,431,433],{"id":432},"get-a-webhook-event","Get a webhook event",[198,435,436],{},[207,437,438],{},"GET /v1/webhook-events/:eventId",[198,440,441],{},"This endpoint returns the full webhook event payload for a specific event ID.",[217,443,445],{"id":444},"parameters","Parameters",[222,447,448,458],{},[225,449,450],{},[228,451,452,454,456],{},[231,453,233],{},[231,455,236],{},[231,457,239],{},[241,459,460],{},[228,461,462,467,471],{},[246,463,464],{},[207,465,466],{},"eventId",[246,468,469],{},[207,470,255],{},[246,472,473],{},"The unique identifier of the webhook event.",[475,476,478,520,634],"code-group",{"sync":477},"api",[479,480,485],"pre",{"className":481,"code":482,"filename":483,"language":484,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSvWm2NjLhYcZaE \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","cURL","bash",[207,486,487,504],{"__ignoreMap":105},[488,489,492,496,500],"span",{"class":490,"line":491},"line",1,[488,493,495],{"class":494},"sBMFI","curl",[488,497,499],{"class":498},"sfazB"," https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSv