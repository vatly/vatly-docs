01,604,605,608],{},"The event name, such as ",[506,594,595],{},"order.paid",", ",[506,598,599],{},"refund.completed",", or ",[506,602,603],{},"subscription_plan.update_approved",". See the ",[511,606,513],{"href":607},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[527,610,611,616,621],{},[545,612,613],{},[506,614,615],{},"reason",[545,617,618],{},[506,619,620],{},"string | null",[545,622,623,624,627,628,631,632,596,635,600,638,641],{},"Why the event fired, for events with more than one cause. Always present; ",[506,625,626],{},"null"," for every event except ",[506,629,630],{},"subscription.updated",", where it is ",[506,633,634],{},"updated_immediately",[506,636,637],{},"updated_on_renewal",[506,639,640],{},"renewed",". New values may be added over time.",[527,643,644,649,653],{},[545,645,646],{},[506,647,648],{},"entityType",[545,650,651],{},[506,652,554],{},[545,654,655,656,596,659,596,662,596,665,596,668,600,671,514],{},"The resource type the event refers to, such as ",[506,657,658],{},"order",[506,660,661],{},"refund",[506,663,664],{},"subscription",[506,666,667],{},"checkout",[506,669,670],{},"one_off_product",[506,672,673],{},"subscription_plan",[527,675,676,681,685],{},[545,677,678],{},[506,679,680],{},"entityId",[545,682,683],{},[506,684,554],{},[545,686,687],{},"The ID of the related resource.",[527,689,690,695,699],{},[545,691,692],{},[506,693,694],{},"object",[545,696,697],{},[506,698,694],{},[545,700,701,702,704,705,708,709,711,712,715,716,514],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, Checkout, OneOffProduct, or SubscriptionPlan), keyed by its own ",[506,703,568],{}," field. Note ",[506,706,707],{},"object.resource"," can differ from ",[506,710,648],{},": chargeback events carry ",[506,713,714],{},"entityType: order"," but a Chargeback ",[506,717,694],{},[527,719,720,725,729],{},[545,721,722],{},[506,723,724],{},"createdAt",[545,726,727],{},[506,728,554],{},[545,730