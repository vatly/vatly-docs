":608},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[528,611,612,617,622],{},[546,613,614],{},[507,615,616],{},"reason",[546,618,619],{},[507,620,621],{},"string | null",[546,623,624,625,628,629,632,633,597,636,601,639,642],{},"Why the event fired, for events with more than one cause. Always present; ",[507,626,627],{},"null"," for every event except ",[507,630,631],{},"subscription.updated",", where it is ",[507,634,635],{},"updated_immediately",[507,637,638],{},"updated_on_renewal",[507,640,641],{},"renewed",". New values may be added over time.",[528,644,645,650,654],{},[546,646,647],{},[507,648,649],{},"entityType",[546,651,652],{},[507,653,555],{},[546,655,656,657,597,660,597,663,597,666,597,669,601,672,515],{},"The resource type the event refers to, such as ",[507,658,659],{},"order",[507,661,662],{},"refund",[507,664,665],{},"subscription",[507,667,668],{},"checkout",[507,670,671],{},"one_off_product",[507,673,674],{},"subscription_plan",[528,676,677,682,686],{},[546,678,679],{},[507,680,681],{},"entityId",[546,683,684],{},[507,685,555],{},[546,687,688],{},"The ID of the related resource.",[528,690,691,696,700],{},[546,692,693],{},[507,694,695],{},"object",[546,697,698],{},[507,699,695],{},[546,701,702,703,705,706,709,710,712,713,716,717,515],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, Checkout, OneOffProduct, or SubscriptionPlan), keyed by its own ",[507,704,569],{}," field. Note ",[507,707,708],{},"object.resource"," can differ from ",[507,711,649],{},": chargeback events carry ",[507,714,715],{},"entityType: order"," but a Chargeback ",[507,718,695],{},[528,720,721,726,730],{},[546,722,723],{},[507,724,725],{},"createdAt",[546,727,728],{},[507,729,555],{},[546,731,732],{},"When the event occurred (ISO 8601 format).",[528,734,735,740,745],{},[546,736,737],{},[507,738,739],{},"testmode",[546,741,742],{},[507,743,744],{},"boolean",[546,746,747],{},"Whether the event origina