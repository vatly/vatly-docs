nts let you inspect the exact payload Vatly generated for a domain event. This is the ",[437,438,439],"strong",{},"persisted"," event, the record returned by this endpoint. The ",[442,443,444],"code",{},"webhook.setup"," verification call is a delivery-only handshake and is never persisted, so it does not appear here. For the full list of events and the live delivery envelope, see the ",[447,448,449],"a",{"href":51},"Webhooks guide",".",[452,453,455],"h3",{"id":454},"properties","Properties",[457,458,459,475],"table",{},[460,461,462],"thead",{},[463,464,465,469,472],"tr",{},[466,467,468],"th",{},"Name",[466,470,471],{},"Type",[466,473,474],{},"Description",[476,477,478,498,515,545,578,610,624,654,668,683],"tbody",{},[463,479,480,486,491],{},[481,482,483],"td",{},[442,484,485],{},"id",[481,487,488],{},[442,489,490],{},"string",[481,492,493,494,497],{},"Unique identifier for the webhook event (starts with ",[442,495,496],{},"webhook_event_",").",[463,499,500,505,509],{},[481,501,502],{},[442,503,504],{},"resource",[481,506,507],{},[442,508,490],{},[481,510,511,512,450],{},"The resource type. Always ",[442,513,514],{},"webhook_event",[463,516,517,522,526],{},[481,518,519],{},[442,520,521],{},"eventName",[481,523,524],{},[442,525,490],{},[481,527,528,529,532,533,536,537,540,541,544],{},"The event name, such as ",[442,530,531],{},"order.paid",", ",[442,534,535],{},"refund.completed",", or ",[442,538,539],{},"subscription_plan.update_approved",". See the ",[447,542,449],{"href":543},"\u002Fguides\u002Fwebhooks#event-types"," for the full list.",[463,546,547,552,557],{},[481,548,549],{},[442,550,551],{},"reason",[481,553,554],{},[442,555,556],{},"string | null",[481,558,559,560,563,564,567,568,532,571,536,574,577],{},"Why the event fired, for events with more than one cause. Always present; ",[442,561,562],{},"null"," for every event except ",[442,565,566],{},"subscription.updated",", where it is ",[442,569,570],{},"updated_immediately",[442,572,573],{},"updated_on_renewal",[442,575,576],{},"renewed",". New values may be added over time.",[463,579,580,585,589],{},[481,581,582],{},[442,583,584],{},"entityType",[481,586,587],{},[442,588,490],{},[481,590,591,592,532,595,532,598,532,601,532,604,536,607,450],{},"The resource type the event refers to, such as ",[442,593,594],{},"order",[442,596,597],{},"refund",[442,599,600],{},"subscription",[442,602,603],{},"checkout",[442,605,606],{},"one_off_product",[442,608,609],{},"subscription_plan",[463,611,612,617,621],{},[481,613,614],{},[442,615,616],{},"entityId",[481,618,619],{},[442,620,490],{},[481,622,623],{},"The ID of the related resource.",[463,625,626,631,635],{},[481,627,628],{},[442,629,630],{},"object",[481,632,633],{},[442,634,630],{},[481,636,637,638,640,641,644,645,647,648,651,652,450],{},"The full resource payload as it existed when the event occurred (an Order, Chargeback, Refund, Subscription, Checkout, OneOffProduct, or SubscriptionPlan), keyed by its own ",[442,639,504],{}," field. Note ",[442,642,643],{},"object.resource"," can differ from ",[442,646,584],{},": chargeback events carry ",[442,649,650],{},"entityType: order"," but a Chargeback ",[442,653,630],{},[463,655,656,661,665],{},[481,657,658],{},[442,659,660],{},"createdAt",[481,662,663],{},[442,664,490],{},[481,666,667],{},"When the event occurred (ISO 8601 format).",[463,669,670,675,680],{},[481,671,672],{},[442,673,674],{},"testmode",[481,676,677],{},[442,678,679],{},"boolean",[481,681,682],{},"Whether the event originated from a test-mode resource.",[463,684,685,690,694],{},[481,686,687],{},[442,688,689],{},"links",[481,691,692],{},[442,693,630],{},[481,695,696,697,450],{},"HATEOAS links. Contains ",[442,698,699],{},"self",[701,702],"hr",{},[428,704,706],{"id":705},"get-a-webhook-event","Get a webhook event",[433,708,709],{},[442,710,711],{},"GET \u002Fv1\u002Fwebhook-events\u002F:eventId",[433,713,714],{},"This endpoint returns the full webhook event payload for a specific event ID.",[452,716,718],{"id":717},"par