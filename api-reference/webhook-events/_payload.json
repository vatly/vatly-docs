a Chargeback ",[203,376,353],{},[224,378,379,384,388],{},[242,380,381],{},[203,382,383],{},"createdAt",[242,385,386],{},[203,387,251],{},[242,389,390],{},"When the event occurred (ISO 8601 format).",[224,392,393,398,403],{},[242,394,395],{},[203,396,397],{},"testmode",[242,399,400],{},[203,401,402],{},"boolean",[242,404,405],{},"Whether the event originated from a test-mode resource.",[224,407,408,413,417],{},[242,409,410],{},[203,411,412],{},"links",[242,414,415],{},[203,416,353],{},[242,418,419,420,211],{},"HATEOAS links. Contains ",[203,421,422],{},"self",[424,425],"hr",{},[189,427,429],{"id":428},"get-a-webhook-event","Get a webhook event",[194,431,432],{},[203,433,434],{},"GET /v1/webhook-events/:eventId",[194,436,437],{},"This endpoint returns the full webhook event payload for a specific event ID.",[213,439,441],{"id":440},"parameters","Parameters",[218,443,444,454],{},[221,445,446],{},[224,447,448,450,452],{},[227,449,229],{},[227,451,232],{},[227,453,235],{},[237,455,456],{},[224,457,458,463,467],{},[242,459,460],{},[203,461,462],{},"eventId",[242,464,465],{},[203,466,251],{},[242,468,469],{},"The unique identifier of the webhook event.",[471,472,474,516,630],"code-group",{"sync":473},"api",[475,476,481],"pre",{"className":477,"code":478,"filename":479,"language":480,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSvWm2NjLhYcZaE \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","cURL","bash",[203,482,483,500],{"__ignoreMap":105},[484,485,488,492,496],"span",{"class":486,"line":487},"line",1,[484,489,491],{"class":490},"sBMFI","curl",[484,493,495],{"class":494},"sfazB"," https://api.vatly.com/v1/webhook-events/webhook_event_Qk8pRtSvWm2NjLhYcZaE",[484,497,499],{"class":498},"sTEyZ"," \\\n",[484,501,503,506,510,513],{"class":486,"line":502},2,[484,504,505],{"class":494},"  -H",[484,507,509],{"class":508},"sMK4o"