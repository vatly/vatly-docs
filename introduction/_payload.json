tions\u002F2.bolt",{"id":488,"title":5,"body":489,"description":658,"extension":659,"links":660,"meta":661,"navigation":662,"path":6,"seo":663,"stem":7,"__hash__":664},"docs\u002F0.introduction.md",{"type":490,"value":491,"toc":651},"minimark",[492,496,513,543,548,580,584,587,610,614],[493,494,495],"p",{},"Vatly is the European merchant of record for AI, software and digital products. It becomes the legal seller on every sale and handles payments, tax and compliance, so you just ship. Sell subscriptions and one-off products through a single API.",[493,497,498,499,502,503,505,506,508,509,512],{},"To understand what adopting Vatly involves, start with ",[500,501,26],"a",{"href":27},". Using a specific platform? Find ",[500,504,480],{"href":481}," and ",[500,507,484],{"href":485}," under ",[510,511,473],"strong",{},", with platform-specific setup and agent prompts.",[514,515,516,524,530,537],"card-group",{},[517,518,521],"card",{"icon":519,"title":520,"to":81},"i-heroicons:shopping-cart","Hosted Checkouts",[493,522,523],{},"Create hosted checkout sessions with one API call. Support for one-off products and subscription plans with automatic tax calculation.",[517,525,527],{"icon":526,"title":88,"to":89},"i-heroicons:arrow-path",[493,528,529],{},"Full subscription lifecycle management. Handle upgrades, downgrades, proration, trials, and cancellations.",[517,531,534],{"icon":532,"title":533,"to":97},"i-heroicons:document-text","Orders & Invoices",[493,535,536],{},"Every payment generates an order with automatic tax calculation and invoicing. Vatly handles EU VAT, US sales tax, and reporting as your Merchant of Record.",[517,538,540],{"icon":539,"title":50,"to":51},"i-heroicons:bell-alert",[493,541,542],{},"Real-time event notifications for checkouts, orders, subscriptions, refunds, and chargebacks.",[544,545,547],"h2",{"id":546},"get-started-in-minutes","Get started in minutes",[549,550,551,562,568,571,574],"ol",{},[552,553,554,555,561],"li",{},"Create a new account at ",[500,556,560],{"href":557,"rel":558},"https:\u002F\u002Fmy.vatly.com",[559],"nofollow","vatly.com",".",[552,563,564,565,561],{},"Grab your API keys from ",[510,566,567],{},"Developers » API keys",[552,569,570],{},"Connect your Mollie account.",[552,572,573],{},"Set up your products.",[552,575,576,577,561],{},"Integrate Vatly using one of our ",[500,578,579],{"href":117},"packages",[544,581,583],{"id":582},"going-live","Going live",[493,585,586],{},"Test mode works from the start, so you can build and test your integration right away. Your live keys work once Vatly has approved you and Mollie has verified your business.",[588,589,590,596,602],"ul",{},[552,591,592,595],{},[510,593,594],{},"Product review."," Vatly is the seller on every sale, so it reviews every product before it goes on sale. A review typically takes one to two business days, and you get an email whether or not the product is approved.",[552,597,598,601],{},[510,599,600],{},"Mollie verification."," Mollie verifies your business on your own connected Mollie account. Connect the account you already have, or open one in the same flow.",[552,603,604,607,608,561],{},[510,605,606],{},"Payouts."," Your earnings go to your own Mollie account after a 7-day hold that covers refunds and disputes. See ",[500,609,18],{"href":19},[544,611,613],{"id":612},"next-steps","Next steps",[588,615,616,621,627,632,638,643],{},[552,617,618,620],{},[500,619,26],{"href":27},": plan what your app needs and brief your developer or agent",[552,622,623,626],{},[500,624,625],{"href":15},"Quickstart guide",": make your first API call",[552,628,629,631],{},[500,630,38],{"href":39},": learn how API keys work",[552,633,634,637],{},[500,635,636],{"href":69},"API Reference",": explore all endpoints",[552,639,640,642],{},[500,641,123],{"href":129},": get the official PHP package",[552,644,645,650],{},[500,646,649],{"href":647,"rel":648},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[559],"Download OpenAPI spec"," for code generation and tooling",{"title":652,"searchDepth":653,"depth":653,"links":654},"",2,[655,656,657],{"id":546,"depth":653,"text":547},{"id":582,"depth":653,"text":583},{"id":612,"depth":653,"text":613},"Vatly is the European merchant of record for AI, software and digital products. Sell worldwide with payments, tax and compliance handled.","md",null,{},true,{"title":5,"description":658},"9jpUo6AyZ1UDBepRoZ1iVVe-ZIRVl4od6blofx-kNRg",[660,666],{"title":14,"path":15,"stem":16,"description":667,"children":-1},"This guide will get you all set up and ready to use the Vatly API. We’ll cover how to set up an API client and how to make your first API request.",1794495704751]