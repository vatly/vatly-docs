233,"path":234,"stem":235,"children":236,"page":57},"Fluent Js","\u002Fpackages\u002Ffluent-js","3.packages\u002F4.fluent-js",[237],{"title":124,"path":238,"stem":239},"\u002Fpackages\u002Ffluent-js\u002Freadme","3.packages\u002F4.fluent-js\u002F0.readme",{"title":241,"path":242,"stem":243},"Integrations","\u002Fintegrations","4.integrations",{"id":245,"title":5,"body":246,"description":396,"extension":397,"links":398,"meta":399,"navigation":400,"path":6,"seo":401,"stem":7,"__hash__":402},"docs\u002F0.introduction.md",{"type":247,"value":248,"toc":389},"minimark",[249,253,283,288,322,326,329,352,356],[250,251,252],"p",{},"Vatly is the Merchant of Record for European software and digital products. It becomes the legal seller on every sale and handles payments, tax and compliance, so you just ship. Sell subscriptions and one-off products through a single API.",[254,255,256,264,270,277],"card-group",{},[257,258,261],"card",{"icon":259,"title":260,"to":77},"i-heroicons:shopping-cart","Hosted Checkouts",[250,262,263],{},"Create hosted checkout sessions with one API call. Support for one-off products and subscription plans with automatic tax calculation.",[257,265,267],{"icon":266,"title":84,"to":85},"i-heroicons:arrow-path",[250,268,269],{},"Full subscription lifecycle management. Handle upgrades, downgrades, proration, trials, and cancellations.",[257,271,274],{"icon":272,"title":273,"to":93},"i-heroicons:document-text","Orders & Invoices",[250,275,276],{},"Every payment generates an order with automatic tax calculation and invoicing. Vatly handles EU VAT, US sales tax, and reporting as your Merchant of Record.",[257,278,280],{"icon":279,"title":46,"to":47},"i-heroicons:bell-alert",[250,281,282],{},"Real-time event notifications for checkouts, orders, subscriptions, refunds, and chargebacks.",[284,285,287],"h2",{"id":286},"get-started-in-minutes","Get started in minutes",[289,290,291,303,310,313,316],"ol",{},[292,293,294,295,302],"li",{},"Create a new account at ",[296,297,301],"a",{"href":298,"rel":299},"https:\u002F\u002Fmy.vatly.com",[300],"nofollow","vatly.com",".",[292,304,305,306,302],{},"Grab your API keys from ",[307,308,309],"strong",{},"Developers » API keys",[292,311,312],{},"Connect your Mollie account.",[292,314,315],{},"Set up your products.",[292,317,318,319,302],{},"Integrate Vatly using one of our ",[296,320,321],{"href":113},"packages",[284,323,325],{"id":324},"going-live","Going live",[250,327,328],{},"Test mode works from the start, so you can build and test your integration right away. Your live keys work once Vatly has approved you and Mollie has verified your business.",[330,331,332,338,344],"ul",{},[292,333,334,337],{},[307,335,336],{},"Product review."," Vatly is the seller on every sale, so it reviews every product before it goes on sale. A review typically takes one to two business days, and you get an email whether or not the product is approved.",[292,339,340,343],{},[307,341,342],{},"Mollie verification."," Mollie verifies your business on your own connected Mollie account. Connect the account you already have, or open one in the same flow.",[292,345,346,349,350,302],{},[307,347,348],{},"Payouts."," Your earnings go to your own Mollie account after a 7-day hold that covers refunds and disputes. See ",[296,351,18],{"href":19},[284,353,355],{"id":354},"next-steps","Next steps",[330,357,358,364,369,375,381],{},[292,359,360,363],{},[296,361,362],{"href":15},"Quickstart guide",": make your first API call",[292,365,366,368],{},[296,367,34],{"href":35},": learn how API keys work",[292,370,371,374],{},[296,372,373],{"href":65},"API Reference",": explore all endpoints",[292,376,377,380],{},[296,378,379],{"href":125},"PHP SDK",": get the official PHP package",[292,382,383,388],{},[296,384,387],{"href":385,"rel":386},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[300],"Download OpenAPI spec"," for code generation and tooling",{"title":390,"searchDepth":391,"depth":391,"links":392},"",2,[393,394,395],{"id":286,"depth":391,"text":287},{"id":324,"depth":391,"text":325},{"id":354,"depth":391,"text":355},"Sell software and digital products worldwide. Vatly is the legal seller; payments, tax and compliance are handled.","md",null,{},true,{"title":5,"description":396},"m5111_xGOMbP9TF0sKtarx76sdtbV5BKnjFDmZ4AZ5Q",[398,404],{"title":14,"path":15,"stem":16,"description":405,"children":-1},"This guide will get you all set up and ready to use the Vatly API. We’ll cover how to set up an API client and how to make your first API request.",1794185861774]