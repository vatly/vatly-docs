cification. CI runs these checks on Python 3.10–3.14.",[485,558,560],{"id":559},"check-formatting-and-types","Check formatting and types",[494,562,564],{"className":496,"code":563,"language":498,"meta":499,"style":499},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[501,565,566,581,597],{"__ignoreMap":499},[504,567,568,570,572,575,578],{"class":506,"line":507},[504,569,527],{"class":510},[504,571,531],{"class":530},[504,573,574],{"class":530}," ruff",[504,576,577],{"class":530}," check",[504,579,580],{"class":530}," .\n",[504,582,583,585,587,589,592,595],{"class":506,"line":540},[504,584,527],{"class":510},[504,586,531],{"class":530},[504,588,574],{"class":530},[504,590,591],{"class":530}," format",[504,593,594],{"class":530}," --check",[504,596,580],{"class":530},[504,598,600,602,604],{"class":506,"line":599},3,[504,601,527],{"class":510},[504,603,531],{"class":530},[504,605,606],{"class":530}," mypy\n",[485,608,610],{"id":609},"build-and-check-the-package","Build and check the package",[494,612,614],{"className":496,"code":613,"language":498,"meta":499,"style":499},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[501,615,616,623,641],{"__ignoreMap":499},[504,617,618,620],{"class":506,"line":507},[504,619,527],{"class":510},[504,621,622],{"class":530}," build\n",[504,624,625,627,629,632,634,637],{"class":506,"line":540},[504,626,527],{"class":510},[504,628,531],{"class":530},[504,630,631],{"class":530}," twine",[504,633,577],{"class":530},[504,635,636],{"class":530}," dist\u002F",[504,638,640],{"class":639},"sTEyZ","*\n",[504,642,643,645,647,649],{"class":506,"line":599},[504,644,527],{"class":510},[504,646,531],{"class":530},[504,648,547],{"class":530},[504,650,651],{"class":530}," scripts\u002Fcheck_package.py\n",[490,653,654,655,658],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[501,656,657],{},"py.typed",". These commands build and validate; they do not publish.",[485,660,662],{"id":661},"update-the-api-specification","Update the API specification",[490,664,665,666,669,670,677],{},"Replace ",[501,667,668],{},"openapi.yaml"," deliberately from the ",[671,672,676],"a",{"href":673,"rel":674},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[675],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[494,679,681],{"className":496,"code":680,"language":498,"meta":499,"style":499},"uv run python scripts\u002Fgenerate.py\n",[501,682,683],{"__ignoreMap":499},[504,684,685,687,689,691],{"class":506,"line":507},[504,686,527],{"class":510},[504,688,531],{"class":530},[504,690,547],{"class":530},[504,692,693],{"class":530}," scripts\u002Fgenerate.py\n",[490,695,696,697,700],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[501,698,699],{},"docs\u002FAPI.md",".",[490,702,703,704,707,708,711,712,715,716,719],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[501,705,706],{},"[]"," becomes ",[501,709,710],{},"{}",", and\nresponse product types accept values such as ",[501,713,714],{},"digital_download",". Request validation\nstill follows the pinned schema. Invalid responses raise ",[501,717,718],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[721,722,724],"h3",{"id":723},"pinned-source","Pinned source",[726,727,728,741],"table",{},[729,730,731],"thead",{},[732,733,734,738],"tr",{},[735,736,737],"th",{},"Source",[735,739,740],{},"Revision",[742,743,744,757],"tbody",{},[732,745,746,750],{},[747,748,749],"td",{},"Production OpenAPI, retrieved 2026-11-13",[747,751,752],{},[671,753,756],{"href":754,"rel":755},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F66c8205ea886e4cb48e8e3b2e988de3839c6d4d8\u002Fpublic\u002Fopenapi.yaml",[675],"vatly-docs specification",[732,758,759,762],{},[747,760,761],{},"Original JS design reference",[747,763,764],{},[671,765,768],{"href":766,"rel":767},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[675],"SDK revision",[490,770,771],{},"The checked-in specification is byte-identical to that source and to the bundle\npublished by Vatly's production release. Its SHA-256 is:",[494,773,778],{"className":774,"code":776,"language":777,"meta":499},[775],"language-text","5e648169e101edc8b3e088dc0e28d0f0a293e8a0ed057014c7336057d986def9\n","text",[501,779,776],{"__ignoreMap":499},[490,781,782],{},"The specification's generated-at date is not its retrieval date.",[485,784,786],{"id":785},"documentation-sync","Documentation sync",[490,788,789,790,793,794,797],{},"Edit the flat Markdown guides in ",[501,791,792],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[501,795,796],{},"scripts\u002Fgenerate.py",", including its description.",[490,799,800,801,804,805,808,809,812,813,816],{},"Pushes to ",[501,802,803],{},"main"," affecting ",[501,806,807],{},"docs\u002F**"," notify ",[501,810,811],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[501,814,815],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses an explicit frontmatter description when present,\notherwise the page's introductory sentence.",[485,818,820],{"id":819},"prepare-a-release","Prepare a release",[490,822,823,824,829,830,833,834,837],{},"The published package is ",[671,825,828],{"href":826,"rel":827},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[675],"vatly-api-python",";\nthe import name is ",[501,831,832],{},"vatly",". Update the package version, ",[501,835,836],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[726,839,840,850],{},[729,841,842],{},[732,843,844,847],{},[735,845,846],{},"PyPI trusted publisher field",[735,848,849],{},"Value",[742,851,852,861,870,880],{},[732,853,854,857],{},[747,855,856],{},"Owner",[747,858,859],{},[501,860,832],{},[732,862,863,866],{},[747,864,865],{},"Repository",[747,867,868],{},[501,869,828],{},[732,871,872,875],{},[747,873,874],{},"Workflow",[747,876,877],{},[501,878,879],{},"release.yml",[732,881,882,885],{},[747,883,884],{},"Environment",[747,886,887],{},"Leave blank",[490,889,890,891,894],{},"Publication starts only from a published GitHub release whose tag matches ",[501,892,893],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[490,896,897,898,900],{},"Pushing ",[501,899,803],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[490,902,903,906,907],{},[671,904,905],{"href":337},"Resource guides"," · ",[671,908,909],{"href":373},"API inventory",[911,912,913],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);backgroun