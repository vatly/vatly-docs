",[491,563,564],{"class":517}," check",[491,566,567],{"class":517}," .\n",[491,569,570,572,574,576,579,582],{"class":493,"line":527},[491,571,514],{"class":497},[491,573,518],{"class":517},[491,575,561],{"class":517},[491,577,578],{"class":517}," format",[491,580,581],{"class":517}," --check",[491,583,567],{"class":517},[491,585,587,589,591],{"class":493,"line":586},3,[491,588,514],{"class":497},[491,590,518],{"class":517},[491,592,593],{"class":517}," mypy\n",[472,595,597],{"id":596},"build-and-check-the-package","Build and check the package",[481,599,601],{"className":483,"code":600,"language":485,"meta":486,"style":486},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[488,602,603,610,628],{"__ignoreMap":486},[491,604,605,607],{"class":493,"line":494},[491,606,514],{"class":497},[491,608,609],{"class":517}," build\n",[491,611,612,614,616,619,621,624],{"class":493,"line":527},[491,613,514],{"class":497},[491,615,518],{"class":517},[491,617,618],{"class":517}," twine",[491,620,564],{"class":517},[491,622,623],{"class":517}," dist\u002F",[491,625,627],{"class":626},"sTEyZ","*\n",[491,629,630,632,634,636],{"class":493,"line":586},[491,631,514],{"class":497},[491,633,518],{"class":517},[491,635,534],{"class":517},[491,637,638],{"class":517}," scripts\u002Fcheck_package.py\n",[477,640,641,642,645],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[488,643,644],{},"py.typed",". These commands build and validate; they do not publish.",[472,647,649],{"id":648},"update-the-api-specification","Update the API specification",[477,651,652,653,656,657,664],{},"Replace ",[488,654,655],{},"openapi.yaml"," deliberately from the ",[658,659,663],"a",{"href":660,"rel":661},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[662],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[481,666,668],{"className":483,"code":667,"language":485,"meta":486,"style":486},"uv run python scripts\u002Fgenerate.py\n",[488,669,670],{"__ignoreMap":486},[491,671,672,674,676,678],{"class":493,"line":494},[491,673,514],{"class":497},[491,675,518],{"class":517},[491,677,534],{"class":517},[491,679,680],{"class":517}," scripts\u002Fgenerate.py\n",[477,682,683,684,687],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[488,685,686],{},"docs\u002FAPI.md",".",[477,689,690,691,694,695,698,699,702,703,706],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[488,692,693],{},"[]"," becomes ",[488,696,697],{},"{}",", and\nresponse product types accept values such as ",[488,700,701],{},"digital_download",". Request validation\nstill follows the pinned schema. Invalid responses raise ",[488,704,705],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[708,709,711],"h3",{"id":710},"pinned-source","Pinned source",[713,714,715,728],"table",{},[716,717,718],"thead",{},[719,720,721,725],"tr",{},[722,723,724],"th",{},"Source",[722,726,727],{},"Revision",[729,730,731,744],"tbody",{},[719,732,733,737],{},[734,735,736],"td",{},"Production OpenAPI, retrieved 2026-11-13",[734,738,739],{},[658,740,743],{"href":741,"rel":742},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F66c8205ea886e4cb48e8e3b2e988de3839c6d4d8\u002Fpublic\u002Fopenapi.yaml",[662],"vatly-docs specification",[719,745,746,749],{},[734,747,748],{},"Original JS design reference",[734,750,751],{},[658,752,755],{"href":753,"rel":754},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[662],"SDK revision",[477,757,758],{},"The checked-in specification is byte-identical to that source and to the bundle\npublished by Vatly's production release. Its SHA-256 is:",[481,760,765],{"className":761,"code":763,"language":764,"meta":486},[762],"language-text","5e648169e101edc8b3e088dc0e28d0f0a293e8a0ed057014c7336057d986def9\n","text",[488,766,763],{"__ignoreMap":486},[477,768,769],{},"The specification's generated-at date is not its retrieval date.",[472,771,773],{"id":772},"documentation-sync","Documentation sync",[477,775,776,777,780,781,784],{},"Edit the flat Markdown guides in ",[488,778,779],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[488,782,783],{},"scripts\u002Fgenerate.py",", including its description.",[477,786,787,788,791,792,795,796,799,800,803],{},"Pushes to ",[488,789,790],{},"main"," affecting ",[488,793,794],{},"docs\u002F**"," notify ",[488,797,798],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[488,801,802],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses an explicit frontmatter description when present,\notherwise the page's introductory sentence.",[472,805,807],{"id":806},"prepare-a-release","Prepare a release",[477,809,810,811,816,817,820,821,824],{},"The published package is ",[658,812,815],{"href":813,"rel":814},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[662],"vatly-api-python",";\nthe import name is ",[488,818,819],{},"vatly",". Update the package version, ",[488,822,823],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[713,826,827,837],{},[716,828,829],{},[719,830,831,834],{},[722,832,833],{},"PyPI trusted publisher field",[722,835,836],{},"Value",[729,838,839,848,857,867],{},[719,840,841,844],{},[734,842,843],{},"Owner",[734,845,846],{},[488,847,819],{},[719,849,850,853],{},[734,851,852],{},"Repository",[734,854,855],{},[488,856,815],{},[719,858,859,862],{},[734,860,861],{},"Workflow",[734,863,864],{},[488,865,866],{},"release.yml",[719,868,869,872],{},[734,870,871],{},"Environment",[734,873,874],{},"Leave blank",[477,876,877,878,881],{},"Publication starts only from a published GitHub release whose tag matches ",[488,879,880],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[477,883,884,885,887],{},"Pushing ",[488,886,790],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[477,889,890,893,894],{},[658,891,892],{"href":324},"Resource guides"," · ",[658,895,896],{"href":360},"API inventory",[898,899,900],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":486,"searchDepth":527,"depth":527,"links":902},[903,904,905,906,907,910,911],{"id":474,"depth":527,"text":475},{"id":503,"depth":527,"text":504},{"id":546,"depth":527,"text":547},{"id":596,"depth":527,"text":597},{"id":648,"depth":527,"text":649,"children":908},[909],{"id":710,"depth":586,"text":711},{"id":772,"depth":527,"text":773},{"id":806,"depth":527,"text":807},"Maintain the SDK, update its API specification, sync documentation and prepare releases.","md",null,{},{"title":363},{"title":467,"description":912},"lECND_SCfjx2sD8zFAp_INUxn18q5zMJOCfxpx1WnqI",[920,922],{"title":280,"path":360,"stem":361,"description":921,"children":-1},"Look up SDK methods, HTTP endpoints and return types for synchronous and asynchronous clients.",{"title":128,"path":372,"stem":373,"description":923,"children":-1},"Build checkout, customer and subscription flows without tying billing to a web framework.",1794589787093]