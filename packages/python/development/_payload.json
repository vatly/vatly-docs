class":518}," ruff",[492,564,565],{"class":518}," check",[492,567,568],{"class":518}," .\n",[492,570,571,573,575,577,580,583],{"class":494,"line":528},[492,572,515],{"class":498},[492,574,519],{"class":518},[492,576,562],{"class":518},[492,578,579],{"class":518}," format",[492,581,582],{"class":518}," --check",[492,584,568],{"class":518},[492,586,588,590,592],{"class":494,"line":587},3,[492,589,515],{"class":498},[492,591,519],{"class":518},[492,593,594],{"class":518}," mypy\n",[473,596,598],{"id":597},"build-and-check-the-package","Build and check the package",[482,600,602],{"className":484,"code":601,"language":486,"meta":487,"style":487},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[489,603,604,611,629],{"__ignoreMap":487},[492,605,606,608],{"class":494,"line":495},[492,607,515],{"class":498},[492,609,610],{"class":518}," build\n",[492,612,613,615,617,620,622,625],{"class":494,"line":528},[492,614,515],{"class":498},[492,616,519],{"class":518},[492,618,619],{"class":518}," twine",[492,621,565],{"class":518},[492,623,624],{"class":518}," dist\u002F",[492,626,628],{"class":627},"sTEyZ","*\n",[492,630,631,633,635,637],{"class":494,"line":587},[492,632,515],{"class":498},[492,634,519],{"class":518},[492,636,535],{"class":518},[492,638,639],{"class":518}," scripts\u002Fcheck_package.py\n",[478,641,642,643,646],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[489,644,645],{},"py.typed",". These commands build and validate; they do not publish.",[473,648,650],{"id":649},"update-the-api-specification","Update the API specification",[478,652,653,654,657,658,665],{},"Replace ",[489,655,656],{},"openapi.yaml"," deliberately from the ",[659,660,664],"a",{"href":661,"rel":662},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[663],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[482,667,669],{"className":484,"code":668,"language":486,"meta":487,"style":487},"uv run python scripts\u002Fgenerate.py\n",[489,670,671],{"__ignoreMap":487},[492,672,673,675,677,679],{"class":494,"line":495},[492,674,515],{"class":498},[492,676,519],{"class":518},[492,678,535],{"class":518},[492,680,681],{"class":518}," scripts\u002Fgenerate.py\n",[478,683,684,685,688],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[489,686,687],{},"docs\u002FAPI.md",".",[478,690,691,692,695,696,699,700,703,704,707],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[489,693,694],{},"[]"," becomes ",[489,697,698],{},"{}",", and\nresponse product types accept values such as ",[489,701,702],{},"digital_download",". Request validation\nstill follows the pinned schema. Invalid responses raise ",[489,705,706],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[709,710,712],"h3",{"id":711},"pinned-source","Pinned source",[714,715,716,729],"table",{},[717,718,719],"thead",{},[720,721,722,726],"tr",{},[723,724,725],"th",{},"Source",[723,727,728],{},"Revision",[730,731,732,745],"tbody",{},[720,733,734,738],{},[735,736,737],"td",{},"Production OpenAPI, retrieved 2026-11-13",[735,739,740],{},[659,741,744],{"href":742,"rel":743},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F66c8205ea886e4cb48e8e3b2e988de3839c6d4d8\u002Fpublic\u002Fopenapi.yaml",[663],"vatly-docs specification",[720,746,747,750],{},[735,748,749],{},"Original JS design reference",[735,751,752],{},[659,753,756],{"href":754,"rel":755},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[663],"SDK revision",[478,758,759],{},"The checked-in specification is byte-identical to that source and to the bundle\npublished by Vatly's production release. Its SHA-256 is:",[482,761,766],{"className":762,"code":764,"language":765,"meta":487},[763],"language-text","5e648169e101edc8b3e088dc0e28d0f0a293e8a0ed057014c7336057d986def9\n","text",[489,767,764],{"__ignoreMap":487},[478,769,770],{},"The specification's generated-at date is not its retrieval date.",[473,772,774],{"id":773},"documentation-sync","Documentation sync",[478,776,777,778,781,782,785],{},"Edit the flat Markdown guides in ",[489,779,780],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[489,783,784],{},"scripts\u002Fgenerate.py",", including its description.",[478,787,788,789,792,793,796,797,800,801,804],{},"Pushes to ",[489,790,791],{},"main"," affecting ",[489,794,795],{},"docs\u002F**"," notify ",[489,798,799],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[489,802,803],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses an explicit frontmatter description when present,\notherwise the page's introductory sentence.",[473,806,808],{"id":807},"prepare-a-release","Prepare a release",[478,810,811,812,817,818,821,822,825],{},"The published package is ",[659,813,816],{"href":814,"rel":815},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[663],"vatly-api-python",";\nthe import name is ",[489,819,820],{},"vatly",". Update the package version, ",[489,823,824],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[714,827,828,838],{},[717,829,830],{},[720,831,832,835],{},[723,833,834],{},"PyPI trusted publisher field",[723,836,837],{},"Value",[730,839,840,849,858,868],{},[720,841,842,845],{},[735,843,844],{},"Owner",[735,846,847],{},[489,848,820],{},[720,850,851,854],{},[735,852,853],{},"Repository",[735,855,856],{},[489,857,816],{},[720,859,860,863],{},[735,861,862],{},"Workflow",[735,864,865],{},[489,866,867],{},"release.yml",[720,869,870,873],{},[735,871,872],{},"Environment",[735,874,875],{},"Leave blank",[478,877,878,879,882],{},"Publication starts only from a published GitHub release whose tag matches ",[489,880,881],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[478,884,885,886,888],{},"Pushing ",[489,887,791],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[478,890,891,894,895],{},[659,892,893],{"href":325},"Resource guides"," · ",[659,896,897],{"href":361},"API inventory",[899,900,901],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":487,"searchDepth":528,"depth":528,"links":903},[904,905,906,907,908,911,912],{"id":475,"depth":528,"text":476},{"id":504,"depth":528,"text":505},{"id":547,"depth":528,"text":548},{"id":597,"depth":528,"text":598},{"id":649,"depth":528,"text":650,"children":909},[910],{"id":711,"depth":587,"text":712},{"id":773,"depth":528,"text":774},{"id":807,"depth":528,"text":808},"Maintain the SDK, update its API specification, sync documentation and prepare releases.","md",null,{},{"title":364},{"title":468,"description":913},"lECND_SCfjx2sD8zFAp_INUxn18q5zMJOCfxpx1WnqI",[921,923],{"title":281,"path":361,"stem":362,"description":922,"children":-1},"Look up SDK methods, HTTP endpoints and return types for synchronous and asynchronous clients.",{"title":129,"path":373,"stem":374,"description":924,"children":-1},"Build checkout, customer and subscription flows without tying billing to a web framework.",1794934040671]