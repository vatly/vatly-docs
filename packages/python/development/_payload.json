lass":496,"line":497},[494,559,517],{"class":500},[494,561,521],{"class":520},[494,563,564],{"class":520}," ruff",[494,566,567],{"class":520}," check",[494,569,570],{"class":520}," .\n",[494,572,573,575,577,579,582,585],{"class":496,"line":530},[494,574,517],{"class":500},[494,576,521],{"class":520},[494,578,564],{"class":520},[494,580,581],{"class":520}," format",[494,583,584],{"class":520}," --check",[494,586,570],{"class":520},[494,588,590,592,594],{"class":496,"line":589},3,[494,591,517],{"class":500},[494,593,521],{"class":520},[494,595,596],{"class":520}," mypy\n",[476,598,600],{"id":599},"build-and-check-the-package","Build and check the package",[484,602,604],{"className":486,"code":603,"language":488,"meta":489,"style":489},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[491,605,606,613,631],{"__ignoreMap":489},[494,607,608,610],{"class":496,"line":497},[494,609,517],{"class":500},[494,611,612],{"class":520}," build\n",[494,614,615,617,619,622,624,627],{"class":496,"line":530},[494,616,517],{"class":500},[494,618,521],{"class":520},[494,620,621],{"class":520}," twine",[494,623,567],{"class":520},[494,625,626],{"class":520}," dist\u002F",[494,628,630],{"class":629},"sTEyZ","*\n",[494,632,633,635,637,639],{"class":496,"line":589},[494,634,517],{"class":500},[494,636,521],{"class":520},[494,638,537],{"class":520},[494,640,641],{"class":520}," scripts\u002Fcheck_package.py\n",[472,643,644,645,648],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[491,646,647],{},"py.typed",". These commands build and validate; they do not publish.",[476,650,652],{"id":651},"update-the-api-specification","Update the API specification",[472,654,655,656,659,660,667],{},"Replace ",[491,657,658],{},"openapi.yaml"," deliberately from the ",[661,662,666],"a",{"href":663,"rel":664},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[665],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[484,669,671],{"className":486,"code":670,"language":488,"meta":489,"style":489},"uv run python scripts\u002Fgenerate.py\n",[491,672,673],{"__ignoreMap":489},[494,674,675,677,679,681],{"class":496,"line":497},[494,676,517],{"class":500},[494,678,521],{"class":520},[494,680,537],{"class":520},[494,682,683],{"class":520}," scripts\u002Fgenerate.py\n",[472,685,686,687,690],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[491,688,689],{},"docs\u002FAPI.md",".",[472,692,693,694,697,698,701,702,705,706,709],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[491,695,696],{},"[]"," becomes ",[491,699,700],{},"{}",", and\nresponse product types accept values such as ",[491,703,704],{},"digital_download",". Request validation\nstill follows the pinned schema. Invalid responses raise ",[491,707,708],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[711,712,714],"h3",{"id":713},"pinned-source","Pinned source",[716,717,718,731],"table",{},[719,720,721],"thead",{},[722,723,724,728],"tr",{},[725,726,727],"th",{},"Source",[725,729,730],{},"Revision",[732,733,734,747],"tbody",{},[722,735,736,740],{},[737,738,739],"td",{},"Production OpenAPI, retrieved 2026-11-09",[737,741,742],{},[661,743,746],{"href":744,"rel":745},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F7e71ade32d311b10f79e10c15d0ac03ae32bde97\u002Fpublic\u002Fopenapi.yaml",[665],"vatly-docs specification",[722,748,749,752],{},[737,750,751],{},"Original JS design reference",[737,753,754],{},[661,755,758],{"href":756,"rel":757},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[665],"SDK revision",[472,760,761],{},"The checked-in specification is byte-identical to that source. Its SHA-256 is:",[484,763,768],{"className":764,"code":766,"language":767,"meta":489},[765],"language-text","69640ac82bbba8d101e6aa882facd5f13aa5cf67f38508e5cea18abef03c4940\n","text",[491,769,766],{"__ignoreMap":489},[472,771,772],{},"The specification's generated-at date is not its retrieval date.",[476,774,776],{"id":775},"documentation-sync","Documentation sync",[472,778,779,780,783,784,787],{},"Edit the flat Markdown guides in ",[491,781,782],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[491,785,786],{},"scripts\u002Fgenerate.py",", including its description.",[472,789,790,791,794,795,798,799,802,803,806],{},"Pushes to ",[491,792,793],{},"main"," affecting ",[491,796,797],{},"docs\u002F**"," notify ",[491,800,801],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[491,804,805],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses each page's introductory sentence as its description.",[476,808,810],{"id":809},"prepare-a-release","Prepare a release",[472,812,813,814,819,820,823,824,827],{},"The published package is ",[661,815,818],{"href":816,"rel":817},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[665],"vatly-api-python",";\nthe import name is ",[491,821,822],{},"vatly",". Update the package version, ",[491,825,826],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[716,829,830,840],{},[719,831,832],{},[722,833,834,837],{},[725,835,836],{},"PyPI trusted publisher field",[725,838,839],{},"Value",[732,841,842,851,860,870],{},[722,843,844,847],{},[737,845,846],{},"Owner",[737,848,849],{},[491,850,822],{},[722,852,853,856],{},[737,854,855],{},"Repository",[737,857,858],{},[491,859,818],{},[722,861,862,865],{},[737,863,864],{},"Workflow",[737,866,867],{},[491,868,869],{},"release.yml",[722,871,872,875],{},[737,873,874],{},"Environment",[737,876,877],{},"Leave blank",[472,879,880,881,884],{},"Publication starts only from a published GitHub release whose tag matches ",[491,882,883],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[472,886,887,888,890],{},"Pushing ",[491,889,793],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[472,892,893,896,897],{},[661,894,895],{"href":324},"Resource guides"," · ",[661,898,899],{"href":360},"API inventory",[901,902,903],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki