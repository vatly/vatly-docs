erate.py",[512,560,561],{"class":538}," --check\n",[498,563,564],{},"Tests use local HTTP and signed webhook fixtures, not a Vatly account. The second\ncommand checks that generated models, resources, clients and the API inventory\nmatch the pinned specification. CI runs these checks on Python 3.10–3.14.",[493,566,568],{"id":567},"check-formatting-and-types","Check formatting and types",[502,570,572],{"className":504,"code":571,"language":506,"meta":507,"style":507},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[509,573,574,589,605],{"__ignoreMap":507},[512,575,576,578,580,583,586],{"class":514,"line":515},[512,577,535],{"class":518},[512,579,539],{"class":538},[512,581,582],{"class":538}," ruff",[512,584,585],{"class":538}," check",[512,587,588],{"class":538}," .\n",[512,590,591,593,595,597,600,603],{"class":514,"line":548},[512,592,535],{"class":518},[512,594,539],{"class":538},[512,596,582],{"class":538},[512,598,599],{"class":538}," format",[512,601,602],{"class":538}," --check",[512,604,588],{"class":538},[512,606,608,610,612],{"class":514,"line":607},3,[512,609,535],{"class":518},[512,611,539],{"class":538},[512,613,614],{"class":538}," mypy\n",[493,616,618],{"id":617},"build-and-check-the-package","Build and check the package",[502,620,622],{"className":504,"code":621,"language":506,"meta":507,"style":507},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[509,623,624,631,649],{"__ignoreMap":507},[512,625,626,628],{"class":514,"line":515},[512,627,535],{"class":518},[512,629,630],{"class":538}," build\n",[512,632,633,635,637,640,642,645],{"class":514,"line":548},[512,634,535],{"class":518},[512,636,539],{"class":538},[512,638,639],{"class":538}," twine",[512,641,585],{"class":538},[512,643,644],{"class":538}," dist\u002F",[512,646,648],{"class":647},"sTEyZ","*\n",[512,650,651,653,655,657],{"class":514,"line":607},[512,652,535],{"class":518},[512,654,539],{"class":538},[512,656,555],{"class":538},[512,658,659],{"class":538}," scripts\u002Fcheck_package.py\n",[498,661,662,663,666],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[509,664,665],{},"py.typed",". These commands build and validate; they do not publish.",[493,668,670],{"id":669},"update-the-api-specification","Update the API specification",[498,672,673,674,677,678,685],{},"Replace ",[509,675,676],{},"openapi.yaml"," deliberately from the ",[679,680,684],"a",{"href":681,"rel":682},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[683],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[502,687,689],{"className":504,"code":688,"language":506,"meta":507,"style":507},"uv run python scripts\u002Fgenerate.py\n",[509,690,691],{"__ignoreMap":507},[512,692,693,695,697,699],{"class":514,"line":515},[512,694,535],{"class":518},[512,696,539],{"class":538},[512,698,555],{"class":538},[512,700,701],{"class":538}," scripts\u002Fgenerate.py\n",[498,703,704,705,708],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[509,706,707],{},"docs\u002FAPI.md",".",[498,710,711,712,715,716,719,720,723,724,727],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[509,713,714],{},"[]"," becomes ",[509,717,718],{},"{}",", and\nresponse product types stay open to catalogue values added before the next sync.\nRequest validation follows the pinned schema: dictionaries are validated through the\nrequest model, request metadata limits are checked, and only spec-defined fields are\nsent, with ",[509,721,722],{},"null"," only where the specification allows it. Invalid responses raise ",[509,725,726],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[729,730,732],"h3",{"id":731},"pinned-source","Pinned source",[734,735,736,749],"table",{},[737,738,739],"thead",{},[740,741,742,746],"tr",{},[743,744,745],"th",{},"Source",[743,747,748],{},"Revision",[750,751,752,765],"tbody",{},[740,753,754,758],{},[755,756,757],"td",{},"Production OpenAPI, retrieved 2026-11-24",[755,759,760],{},[679,761,764],{"href":762,"rel":763},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F7ec49a749e7b3df53cfce8e498160f03003e0dd9\u002Fpublic\u002Fopenapi.yaml",[683],"vatly-docs specification",[740,766,767,770],{},[755,768,769],{},"Original JS design reference",[755,771,772],{},[679,773,776],{"href":774,"rel":775},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[683],"SDK revision",[498,778,779],{},"The checked-in specification is byte-identical to that source and to the bundle\npublished by Vatly's production release. Its SHA-256 is:",[502,781,786],{"className":782,"code":784,"language":785,"meta":507},[783],"language-text","a8aff52f58ff58cda5b1de0f911849ba21109ea07d5df66d55747262eb21f29d\n","text",[509,787,784],{"__ignoreMap":507},[498,789,790],{},"The specification's generated-at date is not its retrieval date.",[493,792,794],{"id":793},"documentation-sync","Documentation sync",[498,796,797,798,801,802,805],{},"Edit the flat Markdown guides in ",[509,799,800],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[509,803,804],{},"scripts\u002Fgenerate.py",", including its description.",[498,807,808,809,812,813,816,817,820,821,824],{},"Pushes to ",[509,810,811],{},"main"," affecting ",[509,814,815],{},"docs\u002F**"," notify ",[509,818,819],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[509,822,823],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses an explicit frontmatter description when present,\notherwise the page's introductory sentence.",[493,826,828],{"id":827},"prepare-a-release","Prepare a release",[498,830,831,832,837,838,841,842,845],{},"The published package is ",[679,833,836],{"href":834,"rel":835},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[683],"vatly-api-python",";\nthe import name is ",[509,839,840],{},"vatly",". Update the package version, ",[509,843,844],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[734,847,848,858],{},[737,849,850],{},[740,851,852,855],{},[743,853,854],{},"PyPI trusted publisher field",[743,856,857],{},"Value",[750,859,860,869,878,888],{},[740,861,862,865],{},[755,863,864],{},"Owner",[755,866,867],{},[509,868,840],{},[740,870,871,874],{},[755,872,873],{},"Repository",[755,875,876],{},[509,877,836],{},[740,879,880,883],{},[755,881,882],{},"Workflow",[755,884,885],{},[509,886,887],{},"release.yml",[740,889,890,893],{},[755,891,892],{},"Environment",[755,894,895],{},"Leave blank",[498,897,898,899,902],{},"Publication starts only from a published GitHub release whose tag matches ",[509,900,901],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[498,904,905,906,908],{},"Pushing ",[509,907,811],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[498,910,911,914,915],{},[679,912,913],{"href":345},"Resource guides"," · ",[679,916,917],{"href":381},"API inventory",[919,920,921],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--