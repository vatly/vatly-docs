],{"class":518,"line":552},2,[516,554,539],{"class":522},[516,556,543],{"class":542},[516,558,559],{"class":542}," python",[516,561,562],{"class":542}," scripts\u002Fgenerate.py",[516,564,565],{"class":542}," --check\n",[502,567,568],{},"Tests use local HTTP and signed webhook fixtures, not a Vatly account. The second\ncommand checks that generated models, resources, clients and the API inventory\nmatch the pinned specification. CI runs these checks on Python 3.10–3.14.",[497,570,572],{"id":571},"check-formatting-and-types","Check formatting and types",[506,574,576],{"className":508,"code":575,"language":510,"meta":511,"style":511},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[513,577,578,593,609],{"__ignoreMap":511},[516,579,580,582,584,587,590],{"class":518,"line":519},[516,581,539],{"class":522},[516,583,543],{"class":542},[516,585,586],{"class":542}," ruff",[516,588,589],{"class":542}," check",[516,591,592],{"class":542}," .\n",[516,594,595,597,599,601,604,607],{"class":518,"line":552},[516,596,539],{"class":522},[516,598,543],{"class":542},[516,600,586],{"class":542},[516,602,603],{"class":542}," format",[516,605,606],{"class":542}," --check",[516,608,592],{"class":542},[516,610,612,614,616],{"class":518,"line":611},3,[516,613,539],{"class":522},[516,615,543],{"class":542},[516,617,618],{"class":542}," mypy\n",[497,620,622],{"id":621},"build-and-check-the-package","Build and check the package",[506,624,626],{"className":508,"code":625,"language":510,"meta":511,"style":511},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[513,627,628,635,653],{"__ignoreMap":511},[516,629,630,632],{"class":518,"line":519},[516,631,539],{"class":522},[516,633,634],{"class":542}," build\n",[516,636,637,639,641,644,646,649],{"class":518,"line":552},[516,638,539],{"class":522},[516,640,543],{"class":542},[516,642,643],{"class":542}," twine",[516,645,589],{"class":542},[516,647,648],{"class":542}," dist\u002F",[516,650,652],{"class":651},"sTEyZ","*\n",[516,654,655,657,659,661],{"class":518,"line":611},[516,656,539],{"class":522},[516,658,543],{"class":542},[516,660,559],{"class":542},[516,662,663],{"class":542}," scripts\u002Fcheck_package.py\n",[502,665,666,667,670],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[513,668,669],{},"py.typed",". These commands build and validate; they do not publish.",[497,672,674],{"id":673},"update-the-api-specification","Update the API specification",[502,676,677,678,681,682,689],{},"Replace ",[513,679,680],{},"openapi.yaml"," deliberately from the ",[683,684,688],"a",{"href":685,"rel":686},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[687],"nofollow","production specification",",\nupdate its provenance below, then regenerate:",[506,691,693],{"className":508,"code":692,"language":510,"meta":511,"style":511},"uv run python scripts\u002Fgenerate.py\n",[513,694,695],{"__ignoreMap":511},[516,696,697,699,701,703],{"class":518,"line":519},[516,698,539],{"class":522},[516,700,543],{"class":542},[516,702,559],{"class":542},[516,704,705],{"class":542}," scripts\u002Fgenerate.py\n",[502,707,708,709,712],{},"Review the generated diff and rerun the checks above. Do not hand-edit generated\nmodels, resources, clients or ",[513,710,711],{},"docs\u002FAPI.md",".",[502,714,715,716,719,720,723,724,727,728,731],{},"Output models preserve extra fields and keep URLs and emails as strings. The\ngenerator handles two observed API differences: metadata ",[513,717,718],{},"[]"," becomes ",[513,721,722],{},"{}",", and\nresponse product types stay open to catalogue values added before the next sync.\nRequest validation follows the pinned schema: dictionaries are validated through the\nrequest model, request metadata limits are checked, and only spec-defined fields are\nsent, with ",[513,725,726],{},"null"," only where the specification allows it. Invalid responses raise ",[513,729,730],{},"VatlyApiError","; avoid\nlogging response bodies that may contain personal data.",[733,734,736],"h3",{"id":735},"pinned-source","Pinned source",[738,739,740,753],"table",{},[741,742,743],"thead",{},[744,745,746,750],"tr",{},[747,748,749],"th",{},"Source",[747,751,752],{},"Revision",[754,755,756,769],"tbody",{},[744,757,758,762],{},[759,760,761],"td",{},"Production OpenAPI, retrieved 2026-11-24",[759,763,764],{},[683,765,768],{"href":766,"rel":767},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-docs\u002Fblob\u002F7ec49a749e7b3df53cfce8e498160f03003e0dd9\u002Fpublic\u002Fopenapi.yaml",[687],"vatly-docs specification",[744,770,771,774],{},[759,772,773],{},"Original JS design reference",[759,775,776],{},[683,777,780],{"href":778,"rel":779},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-js\u002Fcommit\u002F8b0b920c29f7e7b30bf71b9e379ec0a8a1a22028",[687],"SDK revision",[502,782,783],{},"The checked-in specification is byte-identical to that source and to the bundle\npublished by Vatly's production release. Its SHA-256 is:",[506,785,790],{"className":786,"code":788,"language":789,"meta":511},[787],"language-text","a8aff52f58ff58cda5b1de0f911849ba21109ea07d5df66d55747262eb21f29d\n","text",[513,791,788],{"__ignoreMap":511},[502,793,794],{},"The specification's generated-at date is not its retrieval date.",[497,796,798],{"id":797},"documentation-sync","Documentation sync",[502,800,801,802,805,806,809],{},"Edit the flat Markdown guides in ",[513,803,804],{},"docs\u002F","; keep relative links portable. The API\ninventory is generated from ",[513,807,808],{},"scripts\u002Fgenerate.py",", including its description.",[502,811,812,813,816,817,820,821,824,825,828],{},"Pushes to ",[513,814,815],{},"main"," affecting ",[513,818,819],{},"docs\u002F**"," notify ",[513,822,823],{},"vatly\u002Fvatly-docs",". The notifier needs\nthe Actions secret ",[513,826,827],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that\nrepository. The sync uses an explicit frontmatter description when present,\notherwise the page's introductory sentence.",[497,830,832],{"id":831},"prepare-a-release","Prepare a release",[502,834,835,836,841,842,845,846,849],{},"The published package is ",[683,837,840],{"href":838,"rel":839},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-api-python\u002F",[687],"vatly-api-python",";\nthe import name is ",[513,843,844],{},"vatly",". Update the package version, ",[513,847,848],{},"src\u002Fvatly\u002F_version.py","\nand changelog, then run all checks. Publish the SDK before matching Fluent and\nDjango versions, only after review and approval.",[738,851,852,862],{},[741,853,854],{},[744,855,856,859],{},[747,857,858],{},"PyPI trusted publisher field",[747,860,861],{},"Value",[754,863,864,873,882,892],{},[744,865,866,869],{},[759,867,868],{},"Owner",[759,870,871],{},[513,872,844],{},[744,874,875,878],{},[759,876,877],{},"Repository",[759,879,880],{},[513,881,840],{},[744,883,884,887],{},[759,885,886],{},"Workflow",[759,888,889],{},[513,890,891],{},"release.yml",[744,893,894,897],{},[759,895,896],{},"Environment",[759,898,899],{},"Leave blank",[502,901,902,903,906],{},"Publication starts only from a published GitHub release whose tag matches ",[513,904,905],{},"v","\nplus the package version. Mark alphas as pre-releases. Never reuse a published\nversion or move a release tag.",[502,908,909,910,912],{},"Pushing ",[513,911,815],{}," does not publish. Restrict release access: trusted publishing uses\nGitHub OIDC, with no environment approval gate or PyPI token. PyPI artifacts,\nincluding packaged source and docs, are public even if the GitHub repo is private.",[502,914,915,918,919],{},[683,916,917],{"href":349},"Resource guides"," · ",[683,920,921],{"href":385},"API inventory",[923,924,925],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-sty