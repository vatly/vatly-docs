(client)"," inside the ",[514,677,678],{},"with"," block. Replace example resource IDs with your\nown. Creation, updates, cancellations and refunds mutate the selected account.",[502,681,683],{"id":682},"async-applications","Async applications",[507,685,687],{"className":557,"code":686,"language":524,"meta":512,"style":512},"from vatly import AsyncVatlyClient\n\n\nasync def example():\n    async with AsyncVatlyClient() as client:\n        return [customer.id async for customer in client.customers.list_all({\"limit\": 25})]\n",[514,688,689,700,704,708,720,739],{"__ignoreMap":512},[517,690,691,693,695,697],{"class":519,"line":520},[517,692,566],{"class":565},[517,694,570],{"class":569},[517,696,573],{"class":565},[517,698,699],{"class":569}," AsyncVatlyClient\n",[517,701,702],{"class":519,"line":579},[517,703,583],{"emptyLinePlaceholder":582},[517,705,706],{"class":519,"line":586},[517,707,583],{"emptyLinePlaceholder":582},[517,709,710,713,716,718],{"class":519,"line":591},[517,711,712],{"class":594},"async",[517,714,715],{"class":594}," def",[517,717,599],{"class":598},[517,719,603],{"class":602},[517,721,722,725,728,731,733,735,737],{"class":519,"line":606},[517,723,724],{"class":565},"    async",[517,726,727],{"class":565}," with",[517,729,730],{"class":598}," AsyncVatlyClient",[517,732,615],{"class":602},[517,734,618],{"class":565},[517,736,621],{"class":569},[517,738,624],{"class":602},[517,740,741,743,746,749,751,754,757,760,763,766,768,770,772,774,777,779,781,783,785,787,790],{"class":519,"line":627},[517,742,630],{"class":565},[517,744,745],{"class":602}," [",[517,747,748],{"class":569},"customer",[517,750,635],{"class":602},[517,752,753],{"class":638},"id",[517,755,756],{"class":565}," async",[517,758,759],{"class":565}," for",[517,761,762],{"class":569}," customer ",[517,764,765],{"class":565},"in",[517,767,621],{"class":569},[517,769,635],{"class":602},[517,771,639],{"class":638},[517,773,635],{"class":602},[517,775,776],{"class":598},"list_all",[517,778,64