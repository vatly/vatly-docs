],{},"$subscription->model()"," if you need it directly.",[204,663,665],{"id":664},"subscription-state","Subscription state",[209,667,669],{"className":211,"code":668,"language":213,"meta":113,"style":113},"$subscription->active();       \u002F\u002F currently active (including grace period)\n$subscription->cancelled();    \u002F\u002F has been cancelled\n$subscription->onGracePeriod(); \u002F\u002F cancelled but still active until ends_at\n",[215,670,671,687,703],{"__ignoreMap":113},[218,672,673,675,677,679,682,684],{"class":220,"line":221},[218,674,225],{"class":224},[218,676,569],{"class":228},[218,678,241],{"class":224},[218,680,681],{"class":244},"active",[218,683,514],{"class":224},[218,685,686],{"class":342},"       \u002F\u002F currently active (including grace period)\n",[218,688,689,691,693,695,698,700],{"class":220,"line":251},[218,690,225],{"class":224},[218,692,569],{"class":228},[218,694,241],{"class":224},[218,696,697],{"class":244},"cancelled",[218,699,514],{"class":224},[218,701,702],{"class":342},"    \u002F\u002F has been cancelled\n",[218,704,705,707,709,711,714,716],{"class":220,"line":275},[218,706,225],{"class":224},[218,708,569],{"class":228},[218,710,241],{"class":224},[218,712,713],{"class":244},"onGracePeriod",[218,715,514],{"class":224},[218,717,718],{"class":342}," \u002F\u002F cancelled but still active until ends_at\n",[204,720,722],{"id":721},"swapping-plans","Swapping plans",[209,724,726],{"className":211,"code":725,"language":213,"meta":113,"style":113},"\u002F\u002F Swap to a new plan (takes effect at the end of the current period by default)\n$user->subscription()->swap('subscription_plan_annual');\n\n\u002F\u002F Swap and invoice immediately (applies now, charges the prorated delta now)\n$user->subscription()->swapAndInvoice('subscription_plan_annual');\n",[215,727,728,733,757,761,766],{"__ignoreMap":113},[218,729,730],{"class":220,"line":221},[218,731,732],{"class":342},"\u002F\u002F Swap to a new plan (takes effect at the end o