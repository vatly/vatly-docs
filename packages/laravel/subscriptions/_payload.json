":216,"line":398},[214,1420,1421],{"class":338},"    // $event->customerId\n",[214,1423,1424],{"class":216,"line":404},[214,1425,1426],{"class":338},"    // $event->endsAt\n",[214,1428,1429],{"class":216,"line":410},[214,1430,1431],{"class":338},"    // $event->cancellationReason === CancellationReason::PAYMENT_FAILURE\n",[214,1433,1434],{"class":216,"line":423},[214,1435,1436],{"class":338},"    // Trigger a win-back email, flag the account for re-collection, etc.\n",[214,1438,1439],{"class":216,"line":440},[214,1440,1441],{"class":220},"});\n",[196,1443,1444,1445,1448,1449,1452,1453,1456],{},"The reason is not stored on the local ",[211,1446,1447],{},"vatly_subscriptions"," row — read it from the event when a cancellation arrives, or from the live API resource (",[211,1450,1451],{},"Vatly\\API\\Resources\\Subscription::$cancellationReason",", fetched via ",[211,1454,1455],{},"Vatly::getSubscription()->execute($vatlyId)",").",[200,1458,1460],{"id":1459},"updating-billing-details","Updating billing details",[205,1462,1464],{"className":207,"code":1463,"language":209,"meta":109,"style":109},"// Create a signed URL where the customer can update their billing details\n// (address, VAT number, company name). Going through the hosted flow also\n// refreshes the Mollie mandate as a side effect.\n$url = $user->subscription()->updateBilling();\n\nreturn redirect($url);\n",[211,1465,1466,1471,1476,1481,1504,1508],{"__ignoreMap":109},[214,1467,1468],{"class":216,"line":217},[214,1469,1470],{"class":338},"// Create a signed URL where the customer can update their billing details\n",[214,1472,1473],{"class":216,"line":247},[214,1474,1475],{"class":338},"// (address, VAT number, company name). Going through the hosted flow also\n",[214,1477,1478],{"class":216,"line":271},[214,1479,1480],{"class":338},"// refreshes the Mollie mandate as a side effect.\n",[214,1482,1483,1485,1488,1490,1492,1494,1496,1498,1500,1502],{"class":216,"line":282},[214,1484,221],{"class":220},[214,1486,14