Set them on the builder, in whole days or by end date:",[205,330,332],{"className":207,"code":331,"language":209,"meta":109,"style":109},"// Whole days from checkout creation\n$user->subscribe()\n    ->toPlan('subscription_plan_annual')\n    ->withTrialDays(14)\n    ->create();\n\n// Or an end date — the remaining time is rounded *up* to whole days, so the\n// trial never ends earlier than requested (Vatly's trial input is day-granular)\n$user->subscribe()\n    ->toPlan('subscription_plan_annual')\n    ->withTrialEndsAt(now()->addMonth())\n    ->create();\n",[211,333,334,340,352,368,383,391,396,402,408,421,438,460],{"__ignoreMap":109},[214,335,336],{"class":216,"line":217},[214,337,339],{"class":338},"sHwdD","// Whole days from checkout creation\n",[214,341,342,344,346,348,350],{"class":216,"line":247},[214,343,221],{"class":220},[214,345,234],{"class":224},[214,347,237],{"class":220},[214,349,241],{"class":240},[214,351,244],{"class":220},[214,353,354,356,358,360,362,364,366],{"class":216,"line":271},[214,355,250],{"class":220},[214,357,253],{"class":240},[214,359,256],{"class":220},[214,361,259],{"class":220},[214,363,263],{"class":262},[214,365,259],{"class":220},[214,367,268],{"class":220},[214,369,370,372,375,377,381],{"class":216,"line":282},[214,371,250],{"class":220},[214,373,374],{"class":240},"withTrialDays",[214,376,256],{"class":220},[214,378,380],{"class":379},"sbssI","14",[214,382,268],{"class":220},[214,384,385,387,389],{"class":216,"line":289},[214,386,250],{"class":220},[214,388,276],{"class":240},[214,390,279],{"class":220},[214,392,394],{"class":216,"line":393},6,[214,395,286],{"emptyLinePlaceholder":285},[214,397,399],{"class":216,"line":398},7,[214,400,401],{"class":338},"// Or an end date — the remaining time is rounded *up* to whole days, so the\n",[214,403,405],{"class":216,"line":404},8,[214,406,407],{"class":338},"// trial never ends earlier than requested (Vatly's trial input is day-granular)\n",[214,409,411,413,415,417,419],{"class":216,"