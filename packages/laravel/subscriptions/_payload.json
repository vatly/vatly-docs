ubscribed\n",[214,498,499,501,503,505,508,511],{"class":216,"line":247},[214,500,221],{"class":220},[214,502,234],{"class":224},[214,504,237],{"class":220},[214,506,507],{"class":240},"subscribed",[214,509,510],{"class":220},"();",[214,512,513],{"class":338}," // bool\n",[214,515,516,518,520,522,524,526,528,531,533,536],{"class":216,"line":271},[214,517,221],{"class":220},[214,519,234],{"class":224},[214,521,237],{"class":220},[214,523,507],{"class":240},[214,525,256],{"class":220},[214,527,259],{"class":220},[214,529,530],{"class":262},"premium",[214,532,259],{"class":220},[214,534,535],{"class":220},");",[214,537,538],{"class":338}," // check a specific subscription type\n",[214,540,541],{"class":216,"line":282},[214,542,286],{"emptyLinePlaceholder":285},[214,544,545],{"class":216,"line":289},[214,546,547],{"class":338},"// Get the subscription as a fluent handle (operations live here)\n",[214,549,550,552,555,557,559,561,563,566,568],{"class":216,"line":393},[214,551,221],{"class":220},[214,553,554],{"class":224},"subscription ",[214,556,228],{"class":220},[214,558,231],{"class":220},[214,560,234],{"class":224},[214,562,237],{"class":220},[214,564,565],{"class":240},"subscription",[214,567,510],{"class":220},[214,569,570],{"class":338}," // default type, returns ?SubscriptionHandle\n",[214,572,573,575,577,579,581,583,585,587,589,591,593,595],{"class":216,"line":398},[214,574,221],{"class":220},[214,576,554],{"class":224},[214,578,228],{"class":220},[214,580,231],{"class":220},[214,582,234],{"class":224},[214,584,237],{"class":220},[214,586,565],{"class":240},[214,588,256],{"class":220},[214,590,259],{"class":220},[214,592,530],{"class":262},[214,594,259],{"class":220},[214,596,320],{"class":220},[214,598,599],{"class":216,"line":404},[214,600,286],{"emptyLinePlaceholder":285},[214,602,603],{"class":216,"line":410},[214,604,605],{"class":338},"// Get all subscriptions as Eloquent models (state-only)\n",[214,607,608,610,613,615,617,619,621,624,627],{"class":216,"line":423},[214,609,221],{"class":220},[214,611,612],{"class":224},"subscriptions ",[214,614,228],{"class":220},[214,616,231],{"class":220},[214,618,234],{"class":224},[214,620,237],{"class":220},[214,622,623],{"class":224},"subscriptions",[214,625,626],{"class":220},";",[214,628,629],{"class":338}," // Collection\u003CSubscription>\n",[196,631,632,635,636,639,640,643,644,643,647,643,650,653,654,657],{},[211,633,634],{},"$user->subscription('default')"," returns a ",[211,637,638],{},"Vatly\\Fluent\\SubscriptionHandle"," — a lightweight wrapper around the underlying Eloquent model that exposes API-driven operations (",[211,641,642],{},"swap",", ",[211,645,646],{},"cancel",[211,648,649],{},"sync",[211,651,652],{},"updateBilling","). Reach the Eloquent model via ",[211,655,656],{},"$subscription->model()"," if you need it directly.",[200,659,661],{"id":660},"subscription-state","Subscription state",[205,663,665],{"className":207,"code":664,"language":209,"meta":109,"style":109},"$subscription->active();       // currently active (including grace period)\n$subscription->cancelled();    // has been cancelled\n$subscription->onGracePeriod(); // cancelled but still active until ends_at\n",[211,666,667,683,699],{"__ignoreMap":109},[214,668,669,671,673,675,678,680],{"class":216,"line":217},[214,670,221],{"class":220},[214,672,565],{"class":224},[214,674,237],{"class":220},[214,676,677],{"class":240},"active",[214,679,510],{"class":220},[214,681,682],{"class":338},"       // currently active (including grace period)\n",[214,684,685,687,689,691,694,696],{"class":216,"line":247},[214,686,221],{"class":220},[214,688,565],{"class":224},[214,690,237],{"class":220},[214,692,693],{"class":240},"cancelled",[214,695,510],{"class":220},[214,697,698],{"class":338},"    // has been cancelled\n",[214,700,701,703,705,707,710,712],{"class":216,"line":271},[214,702,221],{"class":220},[214,704,565],{"class":224},[214,706,237],{"class":220},[214,708,709],{"class":240},"onGracePeriod",[214,711,510],{"class":220},[214,713,714],{"class":338}," // cancelled but still active until ends_at\n",[200,716,718],{"id":717},"swapping-plans","Swapping plans",[205,720,722],{"className":207,"code":721,"language":209,"meta":109,"style":109},"// Swap to a new plan (takes effect at the end of the current period by default)\n$user->subscription()->swap('subscription_plan_annual');\n\n// Swap and invoice immediately (applies now, charges the prorated delta now)\n$user->subscription()->swapAndInvoice('subscription_plan_annual');\n",[211,723,724,729,753,757,762],{"__ignoreMap":109},[214,725,726],{"class":216,"line":217},[214,727,728],{"class":338},"// Swap to a new plan (takes effect at the end of the current period by default)\n",[214,730,731,733,735,737,739,741,743,745,747,749,751],{"class":216,"line":247},[214,732,221],{"class":220},[214,734,234],{"class":224},[214,736,237],{"class":220},[214,738,565],{"class":240},[214,740,453],{"class":220},[214,742,642],{"class":240},[214,744,256],{"class":220},[214,746,259],{"class":220},[214,748,263],{"class":262},[214,750,259],{"class":220},[214,752,320],{"class":220},[214,754,755],{"class":216,"line":271},[214,756,286],{"emptyLinePlaceholder":285},[214,758,759],{"class":216,"line":282},[214,760,761],{"class":338},"// Swap and invoice immediately (applies now, charges the prorated delta now)\n",[214,763,764,766,768,770,772,774,777,779,781,783,785],{"class":216,"line":289},[214,765,221],{"class":220},[214,767,234],{"class":224},[214,769,237],{"class":220},[214,771,565],{"class":240},[214,773,453],{"class":220},[214,775,776],{"class":240},"swapAndInvoice",[214,778,256],{"class":220},[214,780,259],{"class":220},[214,782,263],{"class":262},[214,784,259],{"class":220},[214,786,320],{"class":220},[322,788,790],{"id":789},"proration-options","Proration options",[196,792,793,796,797,800],{},[211,794,795],{},"swap()"," takes an optional ",[211,798,799],{},"$options"," array that is passed straight through to the Vatly API. Three flags control how the change is timed and billed:",[802,803,804,820],"table",{},[805,806,807],"thead",{},[808,809,810,814,817],"tr",{},[811,812,813],"th",{},"Option",[811,815,816],{},"Default",[811,818,819],{},"Effect",[821,822,823,845,859],"tbody",{},[808,824,825,831,836],{},[826,827,828],"td",{},[211,829,830],{},"applyImmediately",[826,832,833],{},[211,834,835],{},"false",[826,837,838,841,842,844],{},[211,839,840],{},"true"," applies the change now; ",[211,843,835],{}," applies it when the current period ends",[808,846,847,852,856],{},[826,848,849],{},[211,850,851],{},"prorate",[826,853,854],{},[211,855,840],{},[826,857,858],{},"Credit unused time on the old plan and charge remaining time on the new plan",[808,860,861,866,870],{},[826,862,863],{},[211,864,865],{},"invoiceImmediately",[826,867,868],{},[211,869,835],{},[826,871,872,873,875,876,878,879,881,882,884,885,887,888],{},"Only applies when ",[211,874,830],{}," and ",[211,877,851],{}," are both ",[211,880,840],{},". ",[211,883,840],{}," raises a separate invoice for the proration delta right away; ",[211,886,835],{}," parks the delta on the current cycle and bills it as a line on the ",[889,890,891],"strong",{},"next renewal invoice",[205,893,895],{"className":207,"code":894,"language":209,"meta":109,"style":109},"// Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n$user->subscription()->swap('subscription_plan_annual', ['applyImmediately' => true]);\n\n// Apply now and charge the prorated delta on a separate invoice immediately\n$user->subscription()->swap('subscription_plan_annual', [\n    'applyImmediately' => true,\n    'invoiceImmediately' => true,\n]);\n",[211,896,897,902,942,946,951,978,992,1004],{"__ignoreMap":109},[214,898,899],{"class":216,"line":217},[214,900,901],{"class":338},"// Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n",[214,903,904,906,908,910,912,914,916,918,920,922,924,927,930,932,934,936,939],{"class":216,"line":247},[214,905,221],{"class":220},[214,907,234],{"class":224},[214,909,237],{"class":220},[214,911,565],{"class":240},[214,913,453],{"class":220},[214,915,642],{"class":240},[214,917,256],{"class":220},[214,919,259],{"class":220},[214,921,263],{"class":262},[214,923,259],{"class":220},[214,925,926],{"class":220},",",[214,928,929],{"class":220}," [",[214,931,259],{"class":220},[214,933,830],{"class":262},[214,935,259],{"class":220},[214,937,938],{"class":220}," =>",[214,940,941],{"class":220}," true]);\n",[214,943,944],{"class":216,"line":271},[214,945,286],{"emptyLinePlaceholder":285},[214,947,948],{"class":216,"line":282},[214,949,950],{"class":338},"// Apply now and charge the prorated delta on a separate invoice immediately\n",[214,952,953,955,957,959,961,963,965,967,969,971,973,975],{"class":216,"line":289},[214,954,221],{"class":220},[214,956,234],{"class":224},[214,958,237],{"class":220},[214,960,565],{"class":240},[214,962,453],{"class":220},[214,964,642],{"class":240},[214,966,256],{"class":220},[214,968,259],{"class":220},[214,970,263],{"class":262},[214,972,259],{"class":220},[214,974,926],{"class":220},[214,976,977],{"class":220}," [\n",[214,979,980,983,985,987,989],{"class":216,"line":393},[214,981,982],{"class":220},"    '",[214,984,830],{"class":262},[214,986,259],{"class":220},[214,988,938],{"class":220},[214,990,991],{"class":220}," true,\n",[214,993,994,996,998,1000,1002],{"class":216,"line":398},[214,995,982],{"class":220},[214,997,865],{"class":262},[214,999,259],{"class":220},[214,1001,938],{"class":220},[214,1003,991],{"class":220},[214,1005,1006],{"class":216,"line":404},[214,1007,1008],{"class":220},"]);\n",[196,1010,1011,1014,1015,1017,1018,875,1020,1022,1023,1025],{},[211,1012,1013],{},"swapAndInvoice()"," is exactly ",[211,1016,795],{}," with ",[211,1019,830],{},[211,1021,865],{}," both forced to ",[211,1024,840],{},".",[196,1027,1028,1031,1032,1035,1036,1039,1040,1047],{},[889,1029,1030],{},"When to charge immediately."," With the default ",[211,1033,1034],{},"invoiceImmediately: false",", the customer gets one invoice and one payment covering both the renewal and the parked delta — and if they cancel before that renewal, the parked amount is waived (a customer is never charged at the moment they cancel). That default suits ",[889,1037,1038],{},"monthly"," billing, where the delta is collected within weeks. ",[889,1041,1042,1043,1046],{},"Set ",[211,1044,1045],{},"invoiceImmediately: true"," on yearly and other long-interval plans:"," an upgrade in month 2 of a yearly plan would otherwise not be billed until month 12 (and is waived entirely if the customer cancels in between), so the longer the interval the more the deferral costs you.",[322,1049,1051],{"id":1050},"immediate-vs-scheduled-changes","Immediate vs. scheduled changes",[196,1053,1054,1055,1058,1059,1058,1062,1065],{},"However the swap is applied, Vatly confirms the outcome over webhooks, and the package keeps the local ",[211,1056,1057],{},"plan_id"," / ",[211,1060,1061],{},"name",[211,1063,1064],{},"quantity"," in step:",[1067,1068,1069,1089],"ul",{},[1070,1071,1072,1073,1076,1077,1080,1081,1084,1085,1088],"li",{},"An ",[889,1074,1075],{},"immediate"," change (",[211,1078,1079],{},"applyImmediately: true",") raises a ",[211,1082,1083],{},"subscription.updated"," webhook → the ",[211,1086,1087],{},"SubscriptionUpdated"," event; the local plan/name/quantity are refreshed.",[1070,1090,1091,1092,1095,1096,1080,1099,1084,1102,1105,1106,1109,1110,1113,1114,643,1117,643,1119,643,1122,643,1125,643,1127,643,1130,875,1133,1136,1137,1025],{},"A change ",[889,1093,1094],{},"scheduled for the next cycle"," (",[211,1097,1098],{},"applyImmediately: false",[211,1100,1101],{},"subscription.update_scheduled",[211,1103,1104],{},"SubscriptionUpdateScheduled"," event. Nothing changes locally yet; the target values ride in the event's ",[211,1107,1108],{},"scheduledUpdate"," (a typed ",[211,1111,1112],{},"Vatly\\API\\Types\\ScheduledSubscriptionUpdate"," exposing ",[211,1115,1116],{},"subscriptionPlanId",[211,1118,1061],{},[211,1120,1121],{},"description",[211,1123,1124],{},"basePrice",[211,1126,1064],{},[211,1128,1129],{},"interval",[211,1131,1132],{},"intervalCount",[211,1134,1135],{},"effectiveAt"," — the timestamp the change takes effect), and the eventual switch arrives as a later ",[211,1138,1083],{},[196,1140,1141,1142,1145],{},"See ",[1143,1144,38],"a",{"href":172}," for the full event list.",[200,1147,1149],{"id":1148},"canceling","Canceling",[205,1151,1153],{"className":207,"code":1152,"language":209,"meta":109,"style":109},"// Cancel the subscription at Vatly\n$user->subscription()->cancel();\n",[211,1154,1155,1160],{"__ignoreMap":109},[214,1156,1157],{"class":216,"line":217},[214,1158,1159],{"class":338},"// Cancel the subscription at Vatly\n",[214,1161,1162,1164,1166,1168,1170,1172,1174],{"class":216,"line":247},[214,1163,221],{"class":220},[214,1165,234],{"class":224},[214,1167,237],{"class":220},[214,1169,565],{"class":240},[214,1171,453],{"class":220},[214,1173,646],{"class":240},[214,1175,279],{"class":220},[196,1177,1178],{},"The actual cancellation is processed via webhooks. Depending on the Vatly configuration, the subscription may:",[1067,1180,1181,1188],{},[1070,1182,1183,1184,1187],{},"End immediately (",[211,1185,1186],{},"SubscriptionCanceledImmediately"," event)",[1070,1189,1190,1191,1187],{},"Enter a grace period (",[211,1192,1193],{},"SubscriptionCanceledWithGracePeriod",[196,1195,1196,1197,1200,1201,1204,1205,1095,1208,1211,1212,1215,1216,1219,1220,1222],{},"A subscription can also be canceled ",[889,1198,1199],{},"by Vatly",", not by your ",[211,1202,1203],{},"cancel()"," call: when payment recovery for a failed renewal is exhausted, Vatly hard-cancels it and sends ",[211,1206,1207],{},"subscription.canceled_for_nonpayment",[211,1209,1210],{},"SubscriptionCanceledForNonpayment","). The package ends the local subscription exactly as it does for an immediate cancellation — its ",[211,1213,1214],{},"ends_at"," is stamped, ",[211,1217,1218],{},"canceled()"," flips to ",[211,1221,840],{}," — so you don't need any special handling to keep local state correct.",[322,1224,1226],{"id":1225},"cancellation-reason","Cancellation reason",[196,1228,1229,1230,1095,1233,1236],{},"Vatly tags each cancellation with a reason, exposed on the dispatched event as ",[211,1231,1232],{},"$event->cancellationReason",[211,1234,1235],{},"Vatly\\API\\Types\\CancellationReason","):",[802,1238,1239,1249],{},[805,1240,1241],{},[808,1242,1243,1246],{},[811,1244,1245],{},"Value",[811,1247,1248],{},"Meaning",[821,1250,1251,1264,1274],{},[808,1252,1253,1258],{},[826,1254,1255],{},[211,1256,1257],{},"payment_failure",[826,1259,1260,1261,1263],{},"Payment recovery was exhausted after failed renewals (carried by ",[211,1262,1210],{},")",[808,1265,1266,1271],{},[826,1267,1268],{},[211,1269,1270],{},"merchant_request",[826,1272,1273],{},"The merchant canceled the subscription",[808,1275,1276,1281],{},[826,1277,1278],{},[211,1279,1280],{},"customer_request",[826,1282,1283],{},"The customer canceled from the self-service portal",[196,1285,1286],{},"Listen for the cancellation event to branch dunning / win-back flows off the reason:",[205,1288,1290],{"className":207,"code":1289,"language":209,"meta":109,"style":109},"use Illuminate\\Support\\Facades\\Event;\nuse Vatly\\API\\Types\\CancellationReason;\nuse Vatly\\API\\Webhooks\\Events\\SubscriptionCanceledForNonpayment;\n\nEvent::listen(SubscriptionCanceledForNonpayment::class, function (SubscriptionCanceledForNonpayment $event) {\n    // $event->subscriptionId\n    // $event->customerId\n    // $event->endsAt\n    // $event->cancellationReason === CancellationReason::PAYMENT_FAILURE\n    // Trigger a win-back email, flag the account for re-collection, etc.\n});\n",[211,1291,1292,1319,1343,1368,1372,1412,1417,1422,1427,1432,1437],{"__ignoreMap":109},[214,1293,1294,1297,1300,1303,1306,1308,1311,1313,1316],{"class":216,"lin