e on the new plan",[812,864,865,870,874],{},[830,866,867],{},[215,868,869],{},"invoiceImmediately",[830,871,872],{},[215,873,839],{},[830,875,876,877,879,880,882,883,885,886,888,889,891,892],{},"Only applies when ",[215,878,834],{}," and ",[215,881,855],{}," are both ",[215,884,844],{},". ",[215,887,844],{}," raises a separate invoice for the proration delta right away; ",[215,890,839],{}," parks the delta on the current cycle and bills it as a line on the ",[893,894,895],"strong",{},"next renewal invoice",[209,897,899],{"className":211,"code":898,"language":213,"meta":113,"style":113},"\u002F\u002F Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n$user->subscription()->swap('subscription_plan_annual', ['applyImmediately' => true]);\n\n\u002F\u002F Apply now and charge the prorated delta on a separate invoice immediately\n$user->subscription()->swap('subscription_plan_annual', [\n    'applyImmediately' => true,\n    'invoiceImmediately' => true,\n]);\n",[215,900,901,906,946,950,955,982,996,1008],{"__ignoreMap":113},[218,902,903],{"class":220,"line":221},[218,904,905],{"class":342},"\u002F\u002F Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n",[218,907,908,910,912,914,916,918,920,922,924,926,928,931,934,936,938,940,943],{"class":220,"line":251},[218,909,225],{"class":224},[218,911,238],{"class":228},[218,913,241],{"class":224},[218,915,569],{"class":244},[218,917,457],{"class":224},[218,919,646],{"class":244},[218,921,260],{"class":224},[218,923,263],{"class":224},[218,925,267],{"class":266},[218,927,263],{"class":224},[218,929,930],{"class":224},",",[218,932,933],{"class":224}," [",[218,935,263],{"class":224},[218,937,834],{"class":266},[218,939,263],{"class":224},[218,941,942],{"class":224}," =>",[218,944,945],{"class":224}," true]);\n",[218,947,948],{"class":220,"line":275},[218,949,290],{"emptyLinePlaceholder":289},[218,951,952],{"class":220,"line":286},[218,953,954],{"class":342},"\u002F\u002F Apply now and charge the prorated delta on a separate invoice immediately\n",[218,956,957,959,961,963,965,967,969,971,973,975,977,979],{"class":220,"line":293},[218,958,225],{"class":224},[218,960,238],{"class":228},[218,962,241],{"class":224},[218,964,569],{"class":244},[218,966,457],{"class":224},[218,968,646],{"class":244},[218,970,260],{"class":224},[218,972,263],{"class":224},[218,974,267],{"class":266},[218,976,263],{"class":224},[218,978,930],{"class":224},[218,980,981],{"class":224}," [\n",[218,983,984,987,989,991,993],{"class":220,"line":397},[218,985,986],{"class":224},"    '",[218,988,834],{"class":266},[218,990,263],{"class":224},[218,992,942],{"class":224},[218,994,995],{"class":224}," true,\n",[218,997,998,1000,1002,1004,1006],{"class":220,"line":402},[218,999,986],{"class":224},[218,1001,869],{"class":266},[218,1003,263],{"class":224},[218,1005,942],{"class":224},[218,1007,995],{"class":224},[218,1009,1010],{"class":220,"line":408},[218,1011,1012],{"class":224},"]);\n",[200,1014,1015,1018,1019,1021,1022,879,1024,1026,1027,1029],{},[215,1016,1017],{},"swapAndInvoice()"," is exactly ",[215,1020,799],{}," with ",[215,1023,834],{},[215,1025,869],{}," both forced to ",[215,1028,844],{},".",[200,1031,1032,1035,1036,1039,1040,1043,1044,1051],{},[893,1033,1034],{},"When to charge immediately."," With the default ",[215,1037,1038],{},"invoiceImmediately: false",", the customer gets one invoice and one payment covering both the renewal and the parked delta — and if they cancel before that renewal, the parked amount is waived (a customer is never charged at the moment they cancel). That default suits ",[893,1041,1042],{},"monthly"," billing, where the delta is collected within weeks. ",[893,1045,1046,1047,1050],{},"Set ",[215,1048,1049],{},"invoiceImmediately: true"," on yearly and other long-interval plans:"," an upgrade in month 2 of a yearly plan would otherwise not be billed until month 12 (and is waived entirely if the customer cancels in between), so the longer the interval the more the deferral costs you.",[326,1053,1055],{"id":1054},"immediate-vs-scheduled-changes","Immediate vs. scheduled changes",[200,1057,1058,1059,1062,1063,1062,1066,1069],{},"However the swap is applied, Vatly confirms the outcome over webhooks, and the package keeps the local ",[215,1060,1061],{},"plan_id"," \u002F ",[215,1064,1065],{},"name",[215,1067,1068],{},"quantity"," in step:",[1071,1072,1073,1093],"ul",{},[1074,1075,1076,1077,1080,1081,1084,1085,1088,1089,1092],"li",{},"An ",[893,1078,1079],{},"immediate"," change (",[215,1082,1083],{},"applyImmediately: true",") raises a ",[215,1086,1087],{},"subscription.updated"," webhook → the ",[215,1090,1091],{},"SubscriptionUpdated"," event; the local plan\u002Fname\u002Fquantity are refreshed.",[1074,1094,1095,1096,1099,1100,1084,1103,1088,1106,1109,1110,1113,1114,1117,1118,647,1121,647,1123,647,1126,647,1129,647,1131,647,1134,879,1137,1140,1141,1029],{},"A change ",[893,1097,1098],{},"scheduled for the next cycle"," (",[215,1101,1102],{},"applyImmediately: false",[215,1104,1105],{},"subscription.update_scheduled",[215,1107,1108],{},"SubscriptionUpdateScheduled"," event. Nothing changes locally yet; the target values ride in the event's ",[215,1111,1112],{},"scheduledUpdate"," (a typed ",[215,1115,1116],{},"Vatly\\API\\Types\\ScheduledSubscriptionUpdate"," exposing ",[215,1119,1120],{},"subscriptionPlanId",[215,1122,1065],{},[215,1124,1125],{},"description",[215,1127,1128],{},"basePrice",[215,1130,1068],{},[215,1132,1133],{},"interval",[215,1135,1136],{},"intervalCount",[215,1138,1139],{},"effectiveAt"," — the timestamp the change takes effect), and the eventual switch arrives as a later ",[215,1142,1087],{},[200,1144,1145,1146,1149],{},"See ",[1147,1148,42],"a",{"href":176}," for the full event list.",[204,1151,1153],{"id":1152},"canceling","Canceling",[209,1155,1157],{"className":211,"code":1156,"language":213,"meta":113,"style":113},"\u002F\u002F Cancel the subscription at Vatly\n$user->subscription()->cancel();\n",[215,1158,1159,1164],{"__ignoreMap":113},[218,1160,1161],{"class":220,"line":221},[218,1162,1163],{"class":342},"\u002F\u002F Cancel the subscription at Vatly\n",[218,1165,1166,1168,1170,1172,1174,1176,1178],{"class":220,"line":251},[218,1167,225],{"class":224},[218,1169,238],{"class":228},[218,1171,241],{"class":224},[218,1173,569],{"class":244},[218,1175,457],{"class":224},[218,1177,650],{"class":244},[218,1179,283],{"class":224},[200,1181,1182],{},"The actual cancellation is processed via webhooks. Depending on the Vatly configuration, the subscription may:",[1071,1184,1185,1192],{},[1074,1186,1187,1188,1191],{},"End immediately (",[215,1189,1190],{},"SubscriptionCanceledImmediately"," event)",[1074,1193,1194,1195,1191],{},"Enter a grace period (",[215,1196,1197],{},"SubscriptionCanceledWithGracePeriod",[200,1199,1200,1201,1204,1205,1208,1209,1099,1212,1215,1216,1219,1220,1223,1224,1226],{},"A subscription can also be canceled ",[893,1202,1203],{},"by Vatly",", not by your ",[215,1206,1207],{},"cancel()"," call: when payment recovery for a failed renewal is exhausted, Vatly hard-cancels it and sends ",[215,1210,1211],{},"subscription.canceled_for_nonpayment",[215,1213,1214],{},"SubscriptionCanceledForNonpayment","). The package ends the local subscription exactly as it does for an immediate cancellation — its ",[215,1217,1218],{},"ends_at"," is stamped, ",[215,1221,1222],{},"canceled()"," flips to ",[215,1225,844],{}," — so you don't need any special handling to keep local state correct.",[326,1228,1230],{"id":1229},"cancellation-reason","Cancellation reason",[200,1232,1233,1234,1237,1238,647,1241,647,1244,1246,1247,1250,1251,1254],{},"Vatly tags each cancellation with a reason. The package ",[893,1235,1236],{},"persists it locally",": on any cancellation webhook (",[215,1239,1240],{},"subscription.canceled_immediately",[215,1242,1243],{},"subscription.canceled_with_grace_period",[215,1245,1211],{},") the reason is written to the ",[215,1248,1249],{},"cancellation_reason"," column on the ",[215,1252,1253],{},"vatly_subscriptions"," row, so you can read it straight off the model:",[209,1256,1258],{"className":211,"code":1257,"language":213,"meta":113,"style":113},"$user->subscription()->model()->cancellation_reason;   \u002F\u002F e.g. \"payment_failure\", or null if not canceled\n",[215,1259,1260],{"__ignoreMap":113},[218,1261,1262,1264,1266,1268,1270,1272,1275,1277,1279,1281],{"class":220,"line":221},[218,1263,225],{"class":224},[218,1265,238],{"class":228},[218,1267,241],{"class":224},[218,1269,569],{"class":244},[218,1271,457],{"class":224},[218,1273,1274],{"class":244},"model",[218,1276,457],{"class":224},[218,1278,1249],{"class":228},[218,1280,630],{"class":224},[218,1282,1283],{"class":342},"   \u002F\u002F e.g. \"payment_failure\", or null if not canceled\n",[200,1285,1286,1287,1099,1290,1293],{},"The same value is on the dispatched event as ",[215,1288,1289],{},"$event->cancellationReason",[215,1291,1292],{},"Vatly\\API\\Types\\CancellationReason","):",[806,1295,1296,1306],{},[809,1297,1298],{},[812,1299,1300,1303],{},[815,1301,1302],{},"Value",[815,1304,1305],{},"Meaning",[825,1307,1308,1321,1331],{},[812,1309,1310,1315],{},[830,1311,1312],{},[215,1313,1314],{},"payment_failure",[830,1316,1317,1318,1320],{},"Payment recovery was exhausted after failed renewals (carried by ",[215,1319,1214],{},")",[812,1322,1323,1328],{},[830,1324,1325],{},[215,1326,1327],{},"merchant_request",[830,1329,1330],{},"The merchant canceled the subscription",[812,1332,1333,1338],{},[830,1334,1335],{},[215,1336,1337],{},"customer_request",[830,1339,1340],{},"The customer canceled from the self-service portal",[200,1342,1343],{},"Listen for the cancellation event to branch dunning \u002F win-back flows off the reason:",[209,1345,1347],{"className":211,"code":1346,"language":213,"meta":113,"style":113},"use Illuminate\\Support\\Facades\\Event;\nuse Vatly\\API\\Types\\Ca