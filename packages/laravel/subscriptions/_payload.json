wap",", ",[219,653,654],{},"cancel",[219,656,657],{},"sync",[219,659,660],{},"updateBilling","). Reach the Eloquent model via ",[219,663,664],{},"$subscription->model()"," if you need it directly.",[208,667,669],{"id":668},"subscription-state","Subscription state",[213,671,673],{"className":215,"code":672,"language":217,"meta":117,"style":117},"$subscription->active();       \u002F\u002F currently active (including grace period)\n$subscription->cancelled();    \u002F\u002F has been cancelled\n$subscription->onGracePeriod(); \u002F\u002F cancelled but still active until ends_at\n",[219,674,675,691,707],{"__ignoreMap":117},[222,676,677,679,681,683,686,688],{"class":224,"line":225},[222,678,229],{"class":228},[222,680,573],{"class":232},[222,682,245],{"class":228},[222,684,685],{"class":248},"active",[222,687,518],{"class":228},[222,689,690],{"class":346},"       \u002F\u002F currently active (including grace period)\n",[222,692,693,695,697,699,702,704],{"class":224,"line":255},[222,694,229],{"class":228},[222,696,573],{"class":232},[222,698,245],{"class":228},[222,700,701],{"class":248},"cancelled",[222,703,518],{"class":228},[222,705,706],{"class":346},"    \u002F\u002F has been cancelled\n",[222,708,709,711,713,715,718,720],{"class":224,"line":279},[222,710,229],{"class":228},[222,712,573],{"class":232},[222,714,245],{"class":228},[222,716,717],{"class":248},"onGracePeriod",[222,719,518],{"class":228},[222,721,722],{"class":346}," \u002F\u002F cancelled but still active until ends_at\n",[208,724,726],{"id":725},"swapping-plans","Swapping plans",[213,728,730],{"className":215,"code":729,"language":217,"meta":117,"style":117},"\u002F\u002F Swap to a new plan (takes effect at the end of the current period by default)\n$user->subscription()->swap('subscription_plan_annual');\n\n\u002F\u002F Swap and invoice immediately (applies now, charges the prorated delta now)\n$user->subscription()->swapAndInvoice('subscription_plan_annual');\n\n\u002F\u002F Swap now without charging for the change (the next renewal bills the new price)\n$user->subscription()->swapWithoutCharge('subscription_plan_premium');\n",[219,731,732,737,761,765,770,795,799,804],{"__ignoreMap":117},[222,733,734],{"class":224,"line":225},[222,735,736],{"class":346},"\u002F\u002F Swap to a new plan (takes effect at the end of the current period by default)\n",[222,738,739,741,743,745,747,749,751,753,755,757,759],{"class":224,"line":255},[222,740,229],{"class":228},[222,742,242],{"class":232},[222,744,245],{"class":228},[222,746,573],{"class":248},[222,748,461],{"class":228},[222,750,650],{"class":248},[222,752,264],{"class":228},[222,754,267],{"class":228},[222,756,271],{"class":270},[222,758,267],{"class":228},[222,760,328],{"class":228},[222,762,763],{"class":224,"line":279},[222,764,294],{"emptyLinePlaceholder":293},[222,766,767],{"class":224,"line":290},[222,768,769],{"class":346},"\u002F\u002F Swap and invoice immediately (applies now, charges the prorated delta now)\n",[222,771,772,774,776,778,780,782,785,787,789,791,793],{"class":224,"line":297},[222,773,229],{"class":228},[222,775,242],{"class":232},[222,777,245],{"class":228},[222,779,573],{"class":248},[222,781,461],{"class":228},[222,783,784],{"class":248},"swapAndInvoice",[222,786,264],{"class":228},[222,788,267],{"class":228},[222,790,271],{"class":270},[222,792,267],{"class":228},[222,794,328],{"class":228},[222,796,797],{"class":224,"line":401},[222,798,294],{"emptyLinePlaceholder":293},[222,800,801],{"class":224,"line":406},[222,802,803],{"class":346},"\u002F\u002F Swap now without charging for the change (the next renewal bills the new price)\n",[222,805,806,808,810,812,814,816,819,821,823,826,828],{"class":224,"line":412},[222,807,229],{"class":228},[222,809,242],{"class":232},[222,811,245],{"class":228},[222,813,573],{"class":248},[222,815,461],{"class":228},[222,817,818],{"class":248},"swapWithoutCharge",[222,820,264],{"class":228},[222,822,267],{"class":228},[222,824,825],{"class":270},"subscription_plan_premium",[222,827,267],{"class":228},[222,829,328],{"class":228},[330,831,833],{"id":832},"proration-options","Proration options",[204,835,836,839,840,843],{},[219,837,838],{},"swap()"," takes an optional ",[219,841,842],{},"$options"," array that is passed straight through to the Vatly API. Four flags control how the change is timed and billed:",[845,846,847,863],"table",{},[848,849,850],"thead",{},[851,852,853,857,860],"tr",{},[854,855,856],"th",{},"Option",[854,858,859],{},"Default",[854,861,862],{},"Effect",[864,865,866,888,918,934],"tbody",{},[851,867,868,874,879],{},[869,870,871],"td",{},[219,872,873],{},"applyImmediately",[869,875,876],{},[219,877,878],{},"false",[869,880,881,884,885,887],{},[219,882,883],{},"true"," applies the change now; ",[219,886,878],{}," applies it when the current period ends",[851,889,890,895,899],{},[869,891,892],{},[219,893,894],{},"prorate",[869,896,897],{},[219,898,883],{},[869,900,901,903,904,906,907,911,912,915,916],{},[219,902,883],{}," credits unused time on the old plan and charges remaining time on the new plan. ",[219,905,878],{}," charges the full new price for the current cycle on top of what was already paid: it does ",[908,909,910],"strong",{},"not"," skip the charge. Ignored when ",[219,913,914],{},"prorationCharge"," is ",[219,917,878],{},[851,919,920,924,928],{},[869,921,922],{},[219,923,914],{},[869,925,926],{},[219,927,883],{},[869,929,930,931,933],{},"Whether an immediate change is charged at all. ",[219,932,878],{}," applies the change now and charges nothing for it; the next renewal bills the new price, unless a change is already scheduled for that renewal: that change still applies",[851,935,936,941,945],{},[869,937,938],{},[219,939,940],{},"invoiceImmediately",[869,942,943],{},[219,944,878],{},[869,946,947,948,950,951,953,954,956,957,959,960,962,963],{},"Only applies when ",[219,949,873],{}," and ",[219,952,894],{}," are both ",[219,955,883],{},". ",[219,958,883],{}," raises a separate invoice for the proration delta right away; ",[219,961,878],{}," parks the delta on the current cycle and bills it as a line on the ",[908,964,965],{},"next renewal invoice",[213,967,969],{"className":215,"code":968,"language":217,"meta":117,"style":117},"\u002F\u002F Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n$user->subscription()->swap('subscription_plan_annual', ['applyImmediately' => true]);\n\n\u002F\u002F Apply now and charge the prorated delta on a separate invoice immediately\n$user->subscription()->swap('subscription_plan_annual', [\n    'applyImmediately' => true,\n    'invoiceImmediately' => true,\n]);\n\n\u002F\u002F Apply now without charging for the change (the plan must keep the same billing interval).\n\u002F\u002F The next renewal bills the new price\n$user->subscription()->swap('subscription_plan_premium', [\n    'applyImmediately' => true,\n    'prorationCharge' => false,\n]);\n",[219,970,971,976,1016,1020,1025,1052,1066,1078,1083,1087,1092,1097,1123,1136,1150],{"__ignoreMap":117},[222,972,973],{"class":224,"line":225},[222,974,975],{"class":346},"\u002F\u002F Apply the change now, but defer the prorated charge to the next renewal (the default proration behavior)\n",[222,977,978,980,982,984,986,988,990,992,994,996,998,1001,1004,1006,1008,1010,1013],{"class":224,"line":255},[222,979,229],{"class":228},[222,981,242],{"class":232},[222,983,245],{"class":228},[222,985,573],{"class":248},[222,987,461],{"class":228},[222,989,650],{"class":248},[222,991,264],{"class":228},[222,993,267],{"class":228},[222,995,271],{"class":270},[222,997,267],{"class":228},[222,999,1000],{"class":228},",",[222,1002,1003],{"class":228}," [",[222,1005,267],{"class":228},[222,1007,873],{"class":270},[222,1009,267],{"class":228},[222,1011,1012],{"class":228}," =>",[222,1014,1015],{"class":228}," true]);\n",[222,1017,1018],{"class":224,"line":279},[222,1019,294],{"emptyLinePlaceholder":293},[222,1021,1022],{"class":224,"line":290},[22