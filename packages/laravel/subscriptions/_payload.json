":205}," $",[199,218,219],{"class":209},"user",[199,221,222],{"class":205},"->",[199,224,226],{"class":225},"s2Zo4","subscribe",[199,228,229],{"class":205},"()\n",[199,231,233,236,239,242,245,249,251],{"class":201,"line":232},2,[199,234,235],{"class":205},"    ->",[199,237,238],{"class":225},"toPlan",[199,240,241],{"class":205},"(",[199,243,244],{"class":205},"'",[199,246,248],{"class":247},"sfazB","plan_premium",[199,250,244],{"class":205},[199,252,253],{"class":205},")\n",[199,255,257,259,262],{"class":201,"line":256},3,[199,258,235],{"class":205},[199,260,261],{"class":225},"create",[199,263,264],{"class":205},"();\n",[199,266,268],{"class":201,"line":267},4,[199,269,271],{"emptyLinePlaceholder":270},true,"\n",[199,273,275,279,282,285,288,290,293,295,298,300,303],{"class":201,"line":274},5,[199,276,278],{"class":277},"s7zQu","return",[199,280,281],{"class":225}," redirect",[199,283,284],{"class":205},"($",[199,286,287],{"class":209},"checkout",[199,289,222],{"class":205},[199,291,292],{"class":209},"links",[199,294,222],{"class":205},[199,296,297],{"class":209},"checkoutUrl",[199,299,222],{"class":205},[199,301,302],{"class":209},"href",[199,304,305],{"class":205},");\n",[307,308,310],"h3",{"id":309},"with-a-free-trial","With a free trial",[181,312,313],{},"Trials defer the first charge until the trial elapses. Set them on the builder, in whole days or by end date:",[190,315,317],{"className":192,"code":316,"language":194,"meta":105,"style":105},"// Whole days from checkout creation\n$user->subscribe()\n    ->toPlan('plan_premium')\n    ->withTrialDays(14)\n    ->create();\n\n// Or an end date — the remaining time is rounded *up* to whole days, so the\n// trial never ends earlier than requested (Vatly's trial input is day-granular)\n$user->subscribe()\n    ->toPlan('plan_premium')\n    ->withTrialEndsAt(now()->addMonth())\n    ->create();\n",[196,318,319,325,337,353,368,376,381,387,393,406,423,445],{"__ignoreMap":105},[199,320,321],{"class":201,"line":202},[199,3