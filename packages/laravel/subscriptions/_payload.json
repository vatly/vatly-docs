-theme-lighter material-theme material-theme-palenight","$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_annual')\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n","php",[208,209,210,242,266,277,284],"code",{"__ignoreMap":105},[211,212,215,219,223,226,229,232,235,239],"span",{"class":213,"line":214},"line",1,[211,216,218],{"class":217},"sMK4o","$",[211,220,222],{"class":221},"sTEyZ","checkout ",[211,224,225],{"class":217},"=",[211,227,228],{"class":217}," $",[211,230,231],{"class":221},"user",[211,233,234],{"class":217},"->",[211,236,238],{"class":237},"s2Zo4","subscribe",[211,240,241],{"class":217},"()\n",[211,243,245,248,251,254,257,261,263],{"class":213,"line":244},2,[211,246,247],{"class":217},"    ->",[211,249,250],{"class":237},"toPlan",[211,252,253],{"class":217},"(",[211,255,256],{"class":217},"'",[211,258,260],{"class":259},"sfazB","subscription_plan_annual",[211,262,256],{"class":217},[211,264,265],{"class":217},")\n",[211,267,269,271,274],{"class":213,"line":268},3,[211,270,247],{"class":217},[211,272,273],{"class":237},"create",[211,275,276],{"class":217},"();\n",[211,278,280],{"class":213,"line":279},4,[211,281,283],{"emptyLinePlaceholder":282},true,"\n",[211,285,287,291,294,297,300,302,305,307,310,312,315],{"class":213,"line":286},5,[211,288,290],{"class":289},"s7zQu","return",[211,292,293],{"class":237}," redirect",[211,295,296],{"class":217},"($",[211,298,299],{"class":221},"checkout",[211,301,234],{"class":217},[211,303,304],{"class":221},"links",[211,306,234],{"class":217},[211,308,309],{"class":221},"checkoutUrl",[211,311,234],{"class":217},[211,313,314],{"class":221},"href",[211,316,317],{"class":217},");\n",[319,320,322],"h3",{"id":321},"with-a-free-trial","With a free trial",[193,324,325],{},"Trials defer the first charge until the trial elapses. Set them on the builder, in whole days or by end date:",[202,327,329],{"className":204,"code":328,"language":206,"meta":105,"style":105},"// Whole days from c