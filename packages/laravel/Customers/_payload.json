,"stem":151},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to another billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Migrating to Vatly","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/99.migrating-to-vatly",{"title":184,"path":185,"stem":186},"Integrations","/integrations","4.integrations",{"id":188,"title":56,"body":189,"description":1081,"extension":1082,"links":1083,"meta":1084,"navigation":245,"path":153,"seo":1085,"stem":154,"__hash__":1086},"docs/3.packages/2.laravel/1.customers.md",{"type":190,"value":191,"toc":1070},"minimark",[192,196,201,337,341,393,397,428,432,443,463,476,480,483,489,493,513,516,559,568,582,588,718,723,825,836,870,878,888,898,929,948,958,966,969,1066],[193,194,195],"p",{},"Every billable model can be linked to a Vatly customer. Customers are created automatically by Vatly during checkout and synced to your application via webhooks. You can also create customers explicitly if needed.",[197,198,200],"h2",{"id":199},"creating-a-customer","Creating a customer",[202,203,207],"pre",{"className":204,"code":205,"language":206,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","// Create a Vatly customer for this user\n$user->createAsVatlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[208,209,210,219,240,247,253,267,294,331],"code",{"__ignoreMap":105},[211,212,215],"span",{"class":213,"line":214},"line",1,[211,216,218],{"class":217},"sHwdD","// Create a Vatly customer for this user\n",[211,220,222,226,230,233,237],{"class":213,"line":221},2,[211,223,225],{"class":224},"sMK4o","$",[211,227,229],{"class":228},"sTEyZ","user",[211,231,232],{"class":224},"->",[211,234,236],{"class":235},"s2Zo4","createAsVatlyCustomer",[211,238,239],{"class":224},"();\n",[211,241,243],{"class":213,"line":242},3,[211,244,246],{"emptyLinePlaceholder":245},true,"\n",[211,248,250],{"class":213,"line":249},4,[211,251,252],{"class":217},"// Create with extra data\n",[211,254,256,258,260,262,264],{"class":213,"line":255},5,[211,257,225],{"class":224},[211,259,229],{"class":228},[211,261,232],{"class":224},[211,263,236],{"class":235},[211,265,266],{"class":224},"([\n",[211,268,270,273,277,280,283,286,289,291],{"class":213,"line":269},6,[211,271,272],{"class":224},"    '",[211,274,276],{"class":275},"sfazB","locale",[211,278,279],{"class":224},"'",[211,281,282],{"class":224}," =>",[211,284,285],{"class":224}," '",[211,287,288],{"class":275},"nl_NL",[211,290,279],{"class":224},[211,292,293],{"class":224},",\n",[211,295,297,299,302,304,306,309,311,314,316,318,321,323,325,328],{"class":213,"line":296},7,[211,298,272],{"class":224},[211,300,301],{"class":275},"metadata",[211,303,279],{"class":224},[211,305,282],{"class":224},[211,307,308],{"class":224}," [",[211,310,279],{"class":224},[211,312,313],{"class":275},"internal_id",[211,315,279],{"class":224},[211,317,282],{"class":224},[211,319,320],{"class":224}," $",[211,322,229],{"class":228},[211,324,232],{"class":224},[211,326,327],{"class":228},"id",[211,329,330],{"class":224},"],\n",[211,332,334],{"class":213,"line":333},8,[211,335,336],{"class":224},"]);\n",[197,338,340],{"id":339},"checking-customer-status","Checking customer status",[202,342,344],{"className":204,"code":343,"language":206,"meta":105,"style":105},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[208,345,346,351,368,372,377],{"__ignoreMap":105},[211,347,348],{"class":213,"line":214},[211,349,350],{"class":217},"// Check if the user has a Vatly customer ID\n",[211,352,353,355,357,359,362,365],{"class":213,"line":221},[211,354,225],{"class":224},[211,356,229],{"class":228},[211,358,232],{"class":224},[211,360,361],{"class":235},"hasVatlyId",[211,363,364],{"class":224},"();",[211,366,367],{"class":217}," // bool\n",[211,369,370],{"class":213,"line":242},[211,371,246],{"emptyLinePlaceholder":245},[211,373,374],{"class":213,"line":249},[211,375,376],{"class":217},"// Get the Vatly customer ID\n",[211,378,379,381,383,385,388,390],{"class":213,"line":255},[211,380,225],{"class":224},[211,382,229],{"class":228},[211,384,232],{"class":224},[211,386,387],{"class":235},"getVatlyId",[211,389,364],{"class":224},[211,391,392],{"class":217}," // string|null\n",[197,394,396],{"id":395},"retrieving-customer-data","Retrieving customer data",[202,398,400],{"className":204,"code":399,"language":206,"meta":105,"style":105},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[208,401,402,407],{"__ignoreMap":105},[211,403,404],{"class":213,"line":214},[211,405,406],{"class":217},"// Get the full customer object from the Vatly API\n",[211,408,409,411,414,417,419,421,423,426],{"class":213,"line":221},[211,410,225],{"class":224},[211,412,413],{"class":228},"customer ",[211,415,416],{"class":224},"=",[211,418,320],{"class":224},[211,420,229],{"class":228},[211,422,232],{"class":224},[211,424,425],{"class":235},"asVatlyCustomer",[211,427,239],{"class":224},[197,429,431],{"id":430},"how-it-works","How it works",[193,433,434,435,438,439,442],{},"The ",[208,436,437],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[208,440,441],{},"createAsVatlyCustomer()",", it:",[444,445,446,454,460],"ol",{},[447,448,449,450,453],"li",{},"Sends a ",[208,451,452],{},"POST"," request to the Vatly API to create a customer",[447,455,456,457,459],{},"Stores the returned customer ID in the ",[208,458,437],{}," column",[447,461,462],{},"Returns the customer response",[193,464,465,466,468,469,471,472,475],{},"If the user already has a ",[208,467,437],{},", calling ",[208,470,441],{}," will throw a ",[208,473,474],{},"CustomerAlreadyBoundException",".",[197,477,479],{"id":478},"automatic-customer-creation","Automatic customer creation",[193,481,482],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[193,484,485,486,488],{},"This means you don't need to call ",[208,487,441],{}," before starting a checkout — just redirect the user directly.",[197,490,492],{"id":491},"anonymous-guest-checkouts","Anonymous / guest checkouts",[193,494,495,496,500,501,504,505,508,509,512],{},"A common flow: a visitor buys ",[497,498,499],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[208,502,503],{},"order.paid"," / ",[208,506,507],{},"subscription.started"," webhooks, and your app has no ",[208,510,511],{},"User"," row to attribute the purchase to yet.",[193,514,515],{},"The package handles this without losing data:",[517,518,519,552],"ul",{},[447,520,434,521,524,525,528,529,532,533,536,537,540,541,544,545,547,548,551],{},[208,522,523],{},"vatly_subscriptions"," and ",[208,526,527],{},"vatly_orders"," tables both have a nullable ",[208,530,531],{},"owner_id","/",[208,534,535],{},"owner_type"," plus a ",[208,538,539],{},"customer_id"," column. The webhook writes the row with ",[208,542,543],{},"owner_id = null"," but populates ",[208,546,539],{}," with the Vatly customer id (",[208,549,550],{},"cus_…",").",[447,553,554,555,558],{},"When the visitor returns on the checkout-success redirect, call ",[208,556,557],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[560,561,563,564,567],"h3",{"id":562},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[208,565,566],{},"{CHECKOUT_ID}"," placeholder",[193,569,570,571,574,575,577,578,581],{},"The one hard part of guest checkout is: ",[497,572,573],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[208,576,550],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[497,579,580],{},"isn't"," in the session).",[193,583,584,585,587],{},"Instead, put the literal ",[208,586,566],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[202,589,591],{"className":204,"code":590,"language":206,"meta":105,"style":105},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[208,592,593,613,659,692,713],{"__ignoreMap":105},[211,594,595,597,599,601,604,607,610],{"class":213,"line":214},[211,596,225],{"class":224},[211,598,229],{"class":228},[211,600,232],{"class":224},[211,602,603],{"class":235},"checkout",[211,605,606],{"class":224},"()->",[211,608,609],{"class":235},"create",[211,611,612],{"class":224},"(\n",[211,614,615,619,622,625,627,629,631,633,635,638,640,643,645,648,650,652,656],{"class":213,"line":221},[211,616,618],{"class":617},"sBMFI","    items",[211,620,621],{"class":224},":",[211,623,624],{"class":224}," [[",[211,626,279],{"class":224},[211,628,327],{"class":275},[211,630,279],{"class":224},[211,632,282],{"class":224},[211,634,285],{"class":224},[211,636,637],{"class":275},"product_abc123",[211,639,279],{"class":224},[211,641,642],{"class":224},",",[211,644,285],{"class":224},[211,646,647],{"class":275},"quantity",[211,649,279],{"class":224},[211,651,282],{"class":224},[211,653,655],{"class":654},"sbssI"," 1",[211,657,658],{"class":224},"]],\n",[211,660,661,664,666,669,672,674,677,679,682,685,688,690],{"class":213,"line":242},[211,662,663],{"class":617},"    redirectUrlSuccess",[211,665,621],{"class":224},[211,667,668],{"class":235}," route",[211,670,671],{"class":224},"(",[211,673,279],{"class":224},[211,675,676],{"class":275},"vatly.return",[211,678,279],{"class":224},[211,680,681],{"class":224},")",[211,683,684],{"class":224},".'",[211,686,687],{"class":275},"?checkout_id={CHECKOUT_ID}",[211,689,279],{"class":224},[211,691,293],{"class":224},[211,693,694,697,699,701,703,705,708,710],{"class":213,"line":249},[211,695,696],{"class":617},"    redirectUrlCanceled",[211,698,621],{"class":224},[211,700,668],{"class":235},[211,702,671],{"class":224},[211,704,279],{"class":224},[211,706,707],{"class":275},"billing",[211,709,279],{"class":224},[211,711,712],{"class":224},"),\n",[211,714,715],{"class":213,"line":255},[211,716,717],{"class":224},");\n",[193,719,720,721,621],{},"On the return route, hand the request to ",[208,722,557],{},[202,724,726],{"className":204,"code":725,"language":206,"meta":105,"style":105},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[208,727,728,753,758,763,768,791,795,820],{"__ignoreMap":105},[211,729,730,734,737,740,742,745,747,750],{"class":213,"line":214},[211,731,733],{"class":732},"spNyl","public",[211,735,736],{"class":732}," function",[211,738,739],{"class":235}," return",[211,741,671],{"class":224},[211,743,744],{"class":617},"Request",[211,746,320],{"class":224},[211,748,749],{"class":228},"request",[211,751,752],{"class":224},")\n",[211,754,755],{"class":213,"line":221},[211,756,757],{"class":224},"{\n",[211,759,760],{"class":213,"line":242},[211,761,762],{"class":217},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[211,764,765],{"class":213,"line":249},[211,766,767],{"class":217},"    // (if there is one) claims it for the authenticated user.\n",[211,769,770,773,775,777,779,781,784,787,789],{"class":213,"line":255},[211,771,772],{"class":224},"    $",[211,774,749],{"class":228},[211,776,232],{"class":224},[211,778,229],{"class":235},[211,780,606],{"class":224},[211,782,783],{"class":235},"claimVatlyCustomerFromReturn",[211,785,786],{"class":224},"($",[211,788,749],{"class":228},[211,790,717],{"class":224},[211,792,793],{"class":213,"line":269},[211,794,246],{"emptyLinePlaceholder":245},[211,796,797,801,804,806,809,811,813,816,818],{"class":213,"line":296},[211,798,800],{"class":799},"s7zQu","    return",[211,802,803],{"class":235}," redirect",[211,805,606],{"class":224},[211,807,808],{"class":235},"route",[211,810,671],{"class":224},[211,812,279],{"class":224},[211,814,815],{"class":275},"dashboard",[211,817,279],{"class":224},[211,819,717],{"class":224},[211,821,822],{"class":213,"line":333},[211,823,824],{"class":224},"}\n",[193,826,827,828,831,832,835],{},"It returns ",[208,829,830],{},"true"," when a claim happened and ",[208,833,834],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[202,837,839],{"className":204,"code":838,"language":206,"meta":105,"style":105},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[208,840,841],{"__ignoreMap":105},[211,842,843,845,847,849,851,853,855,857,859,862,864,867],{"class":213,"line":214},[211,844,225],{"class":224},[211,846,229],{"class":228},[211,848,232],{"class":224},[211,850,783],{"class":235},[211,852,786],{"class":224},[211,854,749],{"class":228},[211,856,642],{"class":224},[211,858,285],{"class":224},[211,860,861],{"class":275},"cid",[211,863,279],{"class":224},[211,865,866],{"class":224},");",[211,868,869],{"class":217}," // reads ?cid=…\n",[193,871,872,873,877],{},"This is ",[874,875,876],"strong",{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[879,880,881],"blockquote",{},[193,882,883,884,887],{},"The checkout id travels in the URL, so it may also appear in the ",[208,885,886],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[193,889,890,891,893,894,897],{},"Under the hood ",[208,892,557],{}," resolves the checkout's customer id via the Vatly API and then runs ",[208,895,896],{},"claimVatlyCustomer()",", which:",[444,899,900,910,913],{},[447,901,902,903,906,907,909],{},"Binds the Vatly customer id to this host entity via the configured ",[208,904,905],{},"CustomerBindingRepository"," (default impl: writes ",[208,908,437],{}," on the billable table).",[447,911,912],{},"Saves the model.",[447,914,915,916,504,918,920,921,524,923,925,926,928],{},"Backfills ",[208,917,535],{},[208,919,531],{}," on every ",[208,922,523],{},[208,924,527],{}," row that carries the same ",[208,927,539],{}," but had no owner yet.",[193,930,434,931,504,933,935,936,938,939,941,942,944,945,947],{},[208,932,503],{},[208,934,507],{}," webhook usually lands ",[497,937,499],{}," the buyer is redirected back, so those rows already exist (with ",[208,940,543],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[208,943,539],{}," finds the binding and writes ",[208,946,531],{}," directly. Either way the purchase ends up attributed.",[193,949,950,951,953,954,957],{},"If you already hold the ",[208,952,550],{}," by other means, you can still call ",[208,955,956],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[879,959,960],{},[193,961,962,965],{},[874,963,964],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[193,967,968],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[202,970,972],{"className":204,"code":971,"language":206,"meta":105,"style":105},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[208,973,974,1009,1020,1034,1038,1053],{"__ignoreMap":105},[211,975,976,978,980,982,985,988,991,994,997,999,1001,1004,1007],{"class":213,"line":214},[211,977,225],{"class":224},[211,979,413],{"class":228},[211,981,416],{"class":224},[211,983,984],{"class":235}," app",[211,986,987],{"class":224},"(\\",[211,989,990],{"class":228},"Vatly",[211,992,993],{"class":224},"\\",[211,995,996],{"class":228},"Fluent",[211,998,993],{"class":224},[211,1000,990],{"class":617},[211,1002,1003],{"class":224},"::",[211,1005,1006],{"class":654},"class",[211,1008,752],{"class":224},[211,1010,1011,1014,1017],{"class":213,"line":221},[211,1012,1013],{"class":224},"    ->",[211,1015,1016],{"class":235},"customers",[211,1018,1019],{"class":224},"()\n",[211,1021,1022,1024,1027,1029,1032],{"class":213,"line":242},[211,1023,1013],{"class":224},[211,1025,1026],{"class":235},"findByVatlyCustomerId",[211,1028,786],{"class":224},[211,1030,1031],{"class":228},"vatlyCustomerId",[211,1033,717],{"class":224},[211,1035,1036],{"class":213,"line":249},[211,1037,246],{"emptyLinePlaceholder":245},[211,1039,1040,1042,1045,1047,1050],{"class":213,"line":255},[211,1041,225],{"class":224},[211,1043,1044],{"class":228},"customer",[211,1046,232],{"class":224},[211,1048,1049],{"class":228},"email",[211,1051,1052],{"class":224},";\n",[211,1054,1055,1057,1059,1061,1064],{"class":213,"line":269},[211,1056,225],{"class":224},[211,1058,1044],{"class":228},[211,1060,232],{"class":224},[211,1062,1063],{"class":228},"name",[211,1065,1052],{"class":224},[1067,1068,1069],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-d