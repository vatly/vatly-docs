21],{"class":253},"'",[247,323,324],{"class":253},",\n",[247,326,328],{"class":249,"line":327},4,[247,329,330],{"class":253},"    ]);\n",[247,332,334],{"class":249,"line":333},5,[247,335,336],{"class":253},"})\n",[200,338,340],{"id":339},"events","Events",[196,342,343,344,347,348,351,352,355,356,359,360,363,364,238],{},"When a webhook is received, the driver's ",[215,345,346],{},"LaravelEventDispatcher"," forwards the typed domain events straight onto Laravel's event bus, so you listen for the DTO classes directly. The webhook event DTOs live in ",[215,349,350],{},"vatly-api-php"," under the ",[215,353,354],{},"Vatly\\API\\Webhooks\\Events\\"," namespace (so a payload change is a single api-php release); the exceptions are ",[215,357,358],{},"SubscriptionWasCreatedFromWebhook"," and ",[215,361,362],{},"OrderWasCreatedFromWebhook",", internal fluent signals under ",[215,365,366],{},"Vatly\\Fluent\\Events\\",[368,369,370,386],"table",{},[371,372,373],"thead",{},[374,375,376,383],"tr",{},[377,378,379,380,282],"th",{},"Event (",[215,381,382],{},"Vatly\\API\\Webhooks\\Events\\…",[377,384,385],{},"Dispatched when",[387,388,389,404,417,430,442,454,477,491,507,520,554,584,614,627,640,653,676,690,712],"tbody",{},[374,390,391,397],{},[392,393,394],"td",{},[215,395,396],{},"SubscriptionStarted",[392,398,399,400,403],{},"A ",[215,401,402],{},"subscription.started"," webhook is received",[374,405,406,411],{},[392,407,408],{},[215,409,410],{},"SubscriptionBillingUpdated",[392,412,399,413,416],{},[215,414,415],{},"subscription.billing_updated"," webhook is received — the stored mandate is refreshed",[374,418,419,424],{},[392,420,421],{},[215,422,423],{},"SubscriptionResumed",[392,425,399,426,429],{},[215,427,428],{},"subscription.resumed"," webhook is received — the stored end date is cleared",[374,431,432,437],{},[392,433,434],{},[215,435,436],{},"SubscriptionCanceledImmediately",[392,438,399,439,403],{},[215,440,441],{},"subscription.canceled_immediately",[374,443,444,449],{},[392,445,446],{},[215,447,448],{},"SubscriptionCanceledWithGracePeriod",[392,450,399,451,403],{},[215,452,453],{},"subscription.canceled_with_grace_period",[374,455,456,461],{},[392,457,458],{},[215,459,460],{},"SubscriptionCancellationGracePeriodCompleted",[392,462,399,463,466,467,470,471,470,474,282],{},[215,464,465],{},"subscription.cancellation_grace_period_completed"," webhook is received — the grace period stamped by the cancellation has now elapsed (carries ",[215,468,469],{},"customerId",", ",[215,472,473],{},"subscriptionId",[215,475,476],{},"endsAt",[374,478,479,484],{},[392,480,481],{},[215,482,483],{},"OrderPaid",[392,485,486,487,490],{},"An ",[215,488,489],{},"order.paid"," webhook is received (enriched with the full tax breakdown)",[374,492,493,498],{},[392,494,495],{},[215,496,497],{},"OrderCanceled",[392,499,486,500,503,504],{},[215,501,502],{},"order.canceled"," webhook is received — the local order status is mirrored to ",[215,505,506],{},"canceled",[374,508,509,514],{},[392,510,511],{},[215,512,513],{},"OrderPaymentFailed",[392,515,486,516,519],{},[215,517,518],{},"order.payment_failed"," webhook is received — typically the start of dunning (enriched with the full tax breakdown)",[374,521,522,531],{},[392,523,524,527,528],{},[215,525,526],{},"OrderChargebackReceived"," / ",[215,529,530],{},"OrderChargebackReversed",[392,532,486,533,527,536,539,540,542,543,546,547,550,551],{},[215,534,535],{},"order.chargeback_received",[215,537,538],{},"order.chargeback_reversed"," webhook is received — enriched with ",[215,541,469],{},", dispute ",[215,544,545],{},"status",", totals and ",[215,548,549],{},"taxSummary","; persisted to ",[215,552,553],{},"vatly_chargebacks",[374,555,556,567],{},[392,557,558,527,561,527,564],{},[215,559,560],{},"RefundCompleted",[215,562,563],{},"RefundFailed",[215,565,566],{},"RefundCanceled",[392,568,399,569,527,572,527,575,578,579,550,581],{},[215,570,571],{},"refund.completed",[215,573,574],{},"refund.failed",[215,576,577],{},"refund.canceled"," webhook is received — each carries the full ",[215,580,549],{},[215,582,583],{},"vatly_refunds",[374,585,586,591],{},[392,587,588],{},[215,589,590],{},"CheckoutPaid",[392,592,399,593,596,597,599,600,603,604,527,606,470,609,470,611,282],{},[215,594,595],{},"checkout.paid"," webhook is received — the hosted checkout was paid (fires before ",[215,598,489],{},"'s enrichment GET; carries ",[215,601,602],{},"checkoutId",", nullable ",[215,605,469],{},[215,607,608],{},"orderId",[215,610,545],{},[215,612,613],{},"metadata",[374,615,616,621],{},[392,617,618],{},[215,619,620],{},"CheckoutFailed",[392,622,399,623,626],{},[215,624,625],{},"checkout.failed"," webhook is received — the hosted checkout's payment failed (route into a retry flow)",[374,628,629,634],{},[392,630,631],{},[215,632,633],{},"CheckoutCanceled",[392,635,399,636,639],{},[215,637,638],{},"checkout.canceled"," webhook is received — the customer abandoned the hosted checkout (cart-abandonment hook)",[374,641,642,647],{},[392,643,644],{},[215,645,646],{},"CheckoutExpired",[392,648,399,649,652],{},[215,650,651],{},"checkout.expired"," webhook is received — the hosted checkout session timed out without completion",[374,654,655,660],{},[392,656,657],{},[215,658,659],{},"WebhookSetupReceived",[392,661,399,662,665,666,669,670,527,673,282],{},[215,663,664],{},"webhook.setup"," verification call is received — Vatly confirms a newly registered (or re-pointed) endpoint is reachable. There's no resource to enrich and no local row to touch; just acknowledge with a ",[215,667,668],{},"2xx",". Carries only the webhook envelope (",[215,671,672],{},"eventName",[215,674,675],{},"object",[374,677,678,683],{},[392,679,680],{},[215,681,682],{},"UnsupportedWebhookReceived",[392,684,685,686,527,688,282],{},"A webhook arrives that has no typed mapping (carries the raw ",[215,687,672],{},[215,689,675],{},[374,691,692,699],{},[392,693,694,696,697,282],{},[215,695,358],{}," (in ",[215,698,366],{},[392,700,701,702,705,706,708,709,282],{},"A new local ",[215,703,704],{},"Subscription"," row was just created from a ",[215,707,402],{}," webhook (application-level event; carries the stored ",[215,710,711],{},"$subscription",[374,713,714,720],{},[392,715,716,696,718,282],{},[215,717,362],{},[215,719,366],{},[392,721,722,723,725,726,729,730,732,733,736],{},"The order analogue of ",[215,724,358],{},": a new local ",[215,727,728],{},"Order"," row was just created from an ",[215,731,489],{}," webhook (fires once on a brand-new order; carries the stored ",[215,734,735],{},"$order","). A clean hook for receipts / fulfillment",[196,738,739,743,744,470,746,470,748,527,750,527,752,754,755,359,758,761,762,765,766,769,770,773,774,777,778,781,782,784,785,527,787,789,790,793,794,527,796,359,798,801,802,804],{},[740,741,742],"strong",{},"Money fields."," On the order and refund events (",[215,745,483],{},[215,747,513],{},[215,749,560],{},[215,751,563],{},[215,753,566],{},"), ",[215,756,757],{},"total",[215,759,760],{},"subtotal"," are non-null ",[215,763,764],{},"Vatly\\API\\Types\\Money"," value objects (a decimal-string ",[215,767,768],{},"value"," plus a ",[215,771,772],{},"currency","); read the currency via ",[215,775,776],{},"$event->total->currency"," and minor units via ",[215,779,780],{},"$event->total->toCents()",". These events no longer carry a standalone ",[215,783,772],{}," field. The chargeback events (",[215,786,526],{},[215,788,530],{},") carry nullable ",[215,791,792],{},"?Money"," ",[215,795,757],{},[215,797,760],{},[740,799,800],{},"keep"," their standalone ",[215,803,772],{}," field.",[196,806,807,808,810,811,359,813,815],{},"Exactly one of the webhook events above is dispatched per incoming webhook (",[215,809,682],{}," is the fallback for unmapped events). ",[215,812,358],{},[215,814,362],{}," fire additionally, from the subscription- and order-sync reactions, only when a brand-new local row is created.",[200,817,819],{"id":818},"built-in-reactions","Built-in reactions",[196,821,822,823,827,828,831,832,835,836,238],{},"Before the event is dispatched, the package keeps your local tables in sync automatically via fluent's standard webhook ",[824,825,826],"em",{},"reactions",". These are wired by ",[215,829,830],{},"WebhookProcessorFactory"," inside the ",[215,833,834],{},"Vatly"," composition root — no registration needed on your side. They live under ",[215,837,838],{},"Vatly\\Fluent\\Webhooks\\Reactions\\",[840,841,842,860,875,889,901],"ul",{},[843,844,845,850,851,853,854,856,857,859],"li",{},[740,846,847],{},[215,848,849],{},"SyncSubscriptionOnStarted"," -- On ",[215,852,396],{},", creates (or updates) the local ",[215,855,704],{}," row, then dispatches ",[215,858,358],{}," for newly-created rows.",[843,861,862,850,867,527,869,871,872,227],{},[740,863,864],{},[215,865,866],{},"CancelSubscriptionOnCanceled",[215,868,436],{},[215,870,448],{},", sets the local subscription's ",[215,873,874],{},"ends_at",[843,876,877,850,882,884,885,856,887,859],{},[740,878,879],{},[215,880,881],{},"StoreOrderOnPaid",[215,883,483],{},", stores (or updates) the local ",[215,886,728],{},[215,888,362],{},[843,890,891,850,896,884,898,900],{},[740,892,893],{},[215,894,895],{},"StoreOrderOnPaymentFailed",[215,897,513],{},[215,899,728],{}," row, mirroring the upstream order status verbatim.",[843,902,903,850,908,910,911,913,914,916,917,919,920,922],{},[740,904,905],{},[215,906,907],{},"EndSubscriptionOnGracePeriodCompleted",[215,909,460],{},", stamps the actual ",[215,912,874],{}," onto the local subscription. Usually an idempotent re-write of what ",[215,915,866],{}," already stored, but it self-heals a missed/out-of-order ",[215,918,453],{}," webhook (which would otherwise leave ",[215,921,874],{}," null and the subscription looking active forever) and corrects any drift between the scheduled and actual end.",[196,924,925,926,527,928,527,930,527,932,934,935,937],{},"The checkout events (",[215,927,590],{},[215,929,620],{},[215,931,633],{},[215,933,646],{},") ship no built-in reaction — they touch no local table. The checkout payloads carry the full Checkout resource (so they're dispatched without an enrichment GET), and there is no local checkout entity to keep in sync. Listen for them directly to drive receipt/retry/cart-abandonment UI or to flip your own application-level state. ",[215,936,460],{}," is likewise dispatched (on top of the reaction above) for consumers that want to flip their own application-level \"fully ended\" status.",[200,939,941],{"id":940},"custom-listeners","Custom listeners",[196,943,944,945,948,949,952],{},"Listen for the events in your ",[215,946,947],{},"EventServiceProvider"," or using the ",[215,950,951],{},"Event"," facade:",[208,954,956],{"className":241,"code":955,"language":243,"meta":109,"style":109},"use Illuminate\\Support\\Facades\\Event;\nuse Vatly\\API\\Webhooks\\Events\\SubscriptionStarted;\n\nEvent::listen(SubscriptionStarted::class, function (SubscriptionStarted $event) {\n    // $event->customerId\n    // $event->subscriptionId\n    // $event->planId\n    // $event->type\n    // $event->name\n    // $event->quantity\n\n    // Send welcome email, provision features, etc.\n});\n",[215,957,958,985,1011,1017,1055,1061,1067,1073,1079,1085,1091,1096,1102],{"__ignoreMap":109},[247,959,960,964,967,970,973,975,978,980,982],{"class":249,"line":250},[247,961,963],{"class":962},"sbssI","use",[247,965,966],{"class":278}," Illuminate",[247,968,969],{"class":253},"\\",[247,971,972],{"class":278},"Support",[247,974,969],{"class":253},[247,976,977],{"class":278},"Facades",[247,979,969],{"class":253},[247,981,951],{"class":278},[247,983,984],{"class":253},";\n",[247,986,987,989,992,994,997,999,1001,1003,1005,1007,1009],{"class":249,"line":288},[247,988,963],{"class":962},[247,990,991],{"class":278}," Vatly",[247,993,969],{"class":253},[247,995,996],{"class":278},"API",[247,998,969],{"class":253},[247,1000,38],{"class":278},[247,1002,969],{"class":253},[247,1004,340],{"class":278},[247,1006,969],{"cl