hook_calls"," table with:",[840,1295,1296,1302,1311,1319,1328,1334,1340,1346,1352],{},[843,1297,1298,1301],{},[215,1299,1300],{},"vatly_id"," -- The webhook event ID (unique; use this as your dedup key)",[843,1303,1304,1307,1308,282],{},[215,1305,1306],{},"resource"," -- The wrapper resource type (always ",[215,1309,1310],{},"webhook_event",[843,1312,1313,1316,1317,282],{},[215,1314,1315],{},"event_name"," -- The webhook event type (e.g., ",[215,1318,402],{},[843,1320,1321,1324,1325,282],{},[215,1322,1323],{},"entity_type"," -- The resource type the event relates to (e.g., ",[215,1326,1327],{},"subscription",[843,1329,1330,1333],{},[215,1331,1332],{},"entity_id"," -- The Vatly resource ID the event relates to",[843,1335,1336,1339],{},[215,1337,1338],{},"testmode"," -- Whether the event was raised against a testmode entity",[843,1341,1342,1345],{},[215,1343,1344],{},"vatly_created_at"," -- When the webhook event was created at Vatly",[843,1347,1348,1351],{},[215,1349,1350],{},"vatly_customer_id"," -- The associated customer ID, when present",[843,1353,1354,1356],{},[215,1355,675],{}," -- The full resource payload at the time of the event (JSON)",[200,1358,1360],{"id":1359},"pruning-stored-webhook-calls","Pruning stored webhook calls",[196,1362,1363,1365],{},[215,1364,1292],{}," is an append-only record of every webhook received, so it grows over time. The package never prunes it for you — schedule the cleanup yourself.",[196,1367,1368,1369,1371],{},"The ",[215,1370,834],{}," facade deletes rows older than the default retention window (7 days):",[208,1373,1375],{"className":241,"code":1374,"language":243,"meta":109,"style":109},"use Vatly\\Laravel\\Facades\\Vatly;\n\nVatly::cleanUp();   // delete webhook-call rows older than 7 days\n",[215,1376,1377,1397,1401],{"__ignoreMap":109},[247,1378,1379,1381,1383,1385,1387,1389,1391,1393,1395],{"class":249,"line":250},[247,1380,963],{"class":962},[247,1382,991],{"class":278},[247,1384,969],{"class":253},[247,1386,152],{"class":278},[247,1388,969],{"class":253},[247,1390,977],{"class":278},[247,1392,969],{"class":253},[247,1394,834],{"class":278},[247,1396,984],{"class":253},[247,1398,1399],{"class":249,"line":288},[247,1400,1016],{"emptyLinePlaceholder":1015},[247,1402,1403,1405,1407,1410,1413],{"class":249,"line":311},[247,1404,834],{"class":271},[247,1406,1023],{"class":253},[247,1408,1409],{"class":257},"cleanUp",[247,1411,1412],{"class":253},"();",[247,1414,1415],{"class":1059},"   // delete webhook-call rows older than 7 days\n",[196,1417,1418],{},"For a different window, call the model directly — it returns the number of rows deleted:",[208,1420,1422],{"className":241,"code":1421,"language":243,"meta":109,"style":109},"use Vatly\\Laravel\\Models\\VatlyWebhookCall;\n\n$deleted = VatlyWebhookCall::cleanUp(daysToRetain: 30);   // keep 30 days\n",[215,1423,1424,1446,1450],{"__ignoreMap":109},[247,1425,1426,1428,1430,1432,1434,1436,1439,1441,1444],{"class":249,"line":250},[247,1427,963],{"class":962},[247,1429,991],{"class":278},[247,1431,969],{"class":253},[247,1433,152],{"class":278},[247,1435,969],{"class":253},[247,1437,1438],{"class":278},"Models",[247,1440,969],{"class":253},[247,1442,1443],{"class":278},"VatlyWebhookCall",[247,1445,984],{"class":253},[247,1447,1448],{"class":249,"line":288},[247,1449,1016],{"emptyLinePlaceholder":1015},[247,1451,1452,1455,1458,1461,1464,1466,1468,1470,1473,1475,1478,1481],{"class":249,"line":311},[247,1453,1454],{"class":253},"$",[247,1456,1457],{"class":278},"deleted ",[247,1459,1460],{"class":253},"=",[247,1462,1463],{"class":271}," VatlyWebhookCall",[247,1465,1023],{"class":253},[247,1467,1409],{"class":257},[247,1469,261],{"class":253},[247,1471,1472],{"class":271},"daysToRetain",[247,1474,238],{"class":253},[247,1476,1477],{"class":962}," 30",[247,1479,1480],{"class":253},");",[247,1482,1483],{"class":1059},"   // keep 30 days\n",[196,1485,1486,1487,1490,1491,1493,1494,1497,1498,1501],{},"Rows are pruned by their local ",[215,1488,1489],{},"created_at"," (when the row was stored), not ",[215,1492,1344],{},". The window isn't a config value — it's the ",[215,1495,1496],{},"$daysToRetain"," argument (default ",[215,1499,1500],{},"VatlyWebhookCall::DEFAULT_DAYS_TO_RETAIN",", which is 7).",[196,1503,1504,1505,238],{},"Run it on a schedule — for example in ",[215,1506,1507],{},"routes/console.php",[208,1509,1511],{"className":241,"code":1510,"language":243,"meta":109,"style":109},"use Illuminate\\Support\\Facades\\Schedule;\nuse Vatly\\Laravel\\Facades\\Vatly;\n\nSchedule::call(fn () => Vatly::cleanUp())->daily();\n",[215,1512,1513,1534,1554,1558],{"__ignoreMap":109},[247,1514,1515,1517,1519,1521,1523,1525,1527,1529,1532],{"class":249,"line":250},[247,1516,963],{"class":962},[247,1518,966],{"class":278},[247,1520,969],{"class":253},[247,1522,972],{"class":278},[247,1524,969],{"class":253},[247,1526,977],{"class":278},[247,1528,969],{"class":253},[247,1530,1531],{"class":278},"Schedule",[247,1533,984],{"class":253},[247,1535,1536,1538,1540,1542,1544,1546,1548,1550,1552],{"class":249,"line":288},[247,1537,963],{"class":962},[247,1539,991],{"class":278},[247,1541,969],{"class":253},[247,1543,152],{"class":278},[247,1545,969],{"class":253},[247,1547,977],{"class":278},[247,1549,969],{"class":253},[247,1551,834],{"class":278},[247,1553,984],{"class":253},[247,1555,1556],{"class":249,"line":311},[247,1557,1016],{"emptyLinePlaceholder":1015},[247,1559,1560,1562,1564,1567,1569,1572,1575,1578,1580,1582,1584,1587,1590],{"class":249,"line":327},[247,1561,1531],{"class":271},[247,1563,1023],{"class":253},[247,1565,1566],{"class":257},"call",[247,1568,261],{"class":253},[247,1570,1571],{"class":264},"fn",[247,1573,1574],{"class":253}," ()",[247,1576,1577],{"class":253}," =>",[247,1579,991],{"class":271},[247,1581,1023],{"class":253},[247,1583,1409],{"class":257},[247,1585,1586],{"class":253},"())->",[247,1588,1589],{"class":257},"daily",[247,1591,1592],{"class":253},"();\n",[196,1594,1595,1596,1598],{},"The rows are an 