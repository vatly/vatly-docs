39],{},"Vatly\\API\\Webhooks\\Events\\"," namespace (so a payload change is a single api-php release); the one exception is ",[200,342,343],{},"SubscriptionWasCreatedFromWebhook",", an internal fluent signal under ",[200,346,347],{},"Vatly\\Fluent\\Events\\",[349,350,351,367],"table",{},[352,353,354],"thead",{},[355,356,357,364],"tr",{},[358,359,360,361,267],"th",{},"Event (",[200,362,363],{},"Vatly\\API\\Webhooks\\Events\\…",[358,365,366],{},"Dispatched when",[368,369,370,385,398,411,423,435,458,472,488,501,535,565,595,608,621,634,650],"tbody",{},[355,371,372,378],{},[373,374,375],"td",{},[200,376,377],{},"SubscriptionStarted",[373,379,380,381,384],{},"A ",[200,382,383],{},"subscription.started"," webhook is received",[355,386,387,392],{},[373,388,389],{},[200,390,391],{},"SubscriptionBillingUpdated",[373,393,380,394,397],{},[200,395,396],{},"subscription.billing_updated"," webhook is received — the stored mandate is refreshed",[355,399,400,405],{},[373,401,402],{},[200,403,404],{},"SubscriptionResumed",[373,406,380,407,410],{},[200,408,409],{},"subscription.resumed"," webhook is received — the stored end date is cleared",[355,412,413,418],{},[373,414,415],{},[200,416,417],{},"SubscriptionCanceledImmediately",[373,419,380,420,384],{},[200,421,422],{},"subscription.canceled_immediately",[355,424,425,430],{},[373,426,427],{},[200,428,429],{},"SubscriptionCanceledWithGracePeriod",[373,431,380,432,384],{},[200,433,434],{},"subscription.canceled_with_grace_period",[355,436,437,442],{},[373,438,439],{},[200,440,441],{},"SubscriptionCancellationGracePeriodCompleted",[373,443,380,444,447,448,451,452,451,455,267],{},[200,445,446],{},"subscription.cancellation_grace_period_completed"," webhook is received — the grace period stamped by the cancellation has now elapsed (carries ",[200,449,450],{},"customerId",", ",[200,453,454],{},"subscriptionId",[200,456,457],{},"endsAt",[355,459,460,465],{},[373,461,462],{},[200,463,464],{},"OrderPaid",[373,466,467,468,471],{},"An ",[200,469,470],{},"order.paid"," webhook is received (enriched with the full tax breakdown)",[355,473,474,479],{},[373,475,476],{},[200,477,478],{},"OrderCanceled",[373,480,467,481,484,485],{},[200,482,483],{},"order.canceled"," webhook is received — the local order status is mirrored to ",[200,486,487],{},"canceled",[355,489,490,495],{},[373,491,492],{},[200,493,494],{},"PaymentFailed",[373,496,380,497,500],{},[200,498,499],{},"payment.failed"," webhook is received — typically the start of dunning (enriched with the full tax breakdown)",[355,502,503,512],{},[373,504,505,508,509],{},[200,506,507],{},"OrderChargebackReceived"," / ",[200,510,511],{},"OrderChargebackReversed",[373,513,467,514,508,517,520,521,523,524,527,528,531,532],{},[200,515,516],{},"order.chargeback_received",[200,518,519],{},"order.chargeback_reversed"," webhook is received — enriched with ",[200,522,450],{},", dispute ",[200,525,526],{},"status",", totals and ",[200,529,530],{},"taxSummary","; persisted to ",[200,533,534],{},"vatly_chargebacks",[355,536,537,548],{},[373,538,539,508,542,508,545],{},[200,540,541],{},"RefundCompleted",[200,543,544],{},"RefundFailed",[200,546,547],{},"RefundCanceled",[373,549,380,550,508,553,508,556,559,560,531,562],{},[200,551,552],{},"refund.completed",[200,554,555],{},"refund.failed",[200,557,558],{},"refund.canceled"," webhook is received — each carries the full ",[200,561,530],{},[200,563,564],{},"vatly_refunds",[355,566,567,572],{},[373,568,569],{},[200,570,571],{},"CheckoutPaid",[373,573,380,574,577,578,580,581,584,585,508,587,451,590,451,592,267],{},[200,575,576],{},"checkout.paid"," webhook is received — the hosted checkout was paid (fires before ",[200,579,470],{},"'s enrichment GET; carries ",[200,582,583],{},"checkoutId",", nullable ",[200,586,450],{},[200,588,589],{},"orderId",[200,591,526],{},[200,593,594],{},"metadata",[355,596,597,602],{},[373,598,599],{},[200,600,601],{},"CheckoutFailed",[373,603,380,604,607],{},[200,605,606],{},"checkout.failed"," webhook is received — the hosted checkout's payment failed (route into a retry flow)",[355,609,610,615],{},[373,611,612],{},[200,613,614],{},"CheckoutCanceled",[373,616,380,617,620],{},[200,618,619],{},"checkout.canceled"," webhook is received — the customer abandoned the hosted checkout (cart-abandonment hook)",[355,622,623,628],{},[373,624,625],{},[200,626,627],{},"CheckoutExpired",[373,629,380,630,633],{},[200,631,632],{},"checkout.expired"," webhook is received — the hosted checkout session timed out without completion",[355,635,636,641],{},[373,637,638],{},[200,639,640],{},"UnsupportedWebhookReceived",[373,642,643,644,508,647,267],{},"A webhook arrives that has no typed mapping (carries the raw ",[200,645,646],{},"eventName",[200,648,649],{},"object",[355,651,652,659],{},[373,653,654,656,657,267],{},[200,655,343],{}," (in ",[200,658,347],{},[373,660,661,662,665,666,668,669,267],{},"A new local ",[200,663,664],{},"Subscription"," row was just created from a ",[200,667,383],{}," webhook (application-level event; carries the stored ",[200,670,671],{},"$subscription",[181,673,674,675,677,678,680],{},"Exactly one of the webhook events above is dispatched per incoming webhook (",[200,676,640],{}," is the fallback for unmapped events). ",[200,679,343],{}," fires additionally, from the subscription-sync reaction, only when a brand-new local row is created.",[185,682,684],{"id":683},"built-in-reactions","Built-in reactions",[181,686,687,688,692,693,696,697,700,701,223],{},"Before the event is dispatched, the package keeps your local tables in sync automatically via fluent's standard webhook ",[689,690,691],"em",{},"reactions",". These are wired by ",[200,694,695],{},"WebhookProcessorFactory"," inside the ",[200,698,699],{},"Vatly"," composition root — no registration needed on your side. They live under ",[200,702,703],{},"Vatly\\Fluent\\Webhooks\\Reactions\\",[705,706,707,726,741,755,767],"ul",{},[708,709,710,716,717,719,720,722,723,725],"li",{},[711,712,713],"strong",{},[200,714,715],{},"SyncSubscriptionOnStarted"," -- On ",[200,718,377],{},", creates (or updates) the local ",[200,721,664],{}," row, then dispatches ",[200,724,343],{}," for newly-created rows.",[708,727,728,716,733,508,735,737,738,212],{},[711,729,730],{},[200,731,732],{},"CancelSubscriptionOnCanceled",[200,734,417],{},[200,736,429],{},", sets the local subscription's ",[200,739,740],{},"ends_at",[708,742,743,716,748,750,751,754],{},[711,744,745],{},[200,746,747],{},"StoreOrderOnPaid",[200,749,464],{},", stores (or updates) the local ",[200,752,753],{},"Order"," row.",[708,756,757,716,762,750,764,766],{},[711,758,759],{},[200,760,761],{},"StoreOrderOnPaymentFailed",[200,763,494],{},[200,765,753],{}," row, mirroring the upstream order status verbatim.",[708,768,769,716,774,776,777,779,780,782,783,785,786,788],{},[711,770,771],{},[200,772,773],{},"EndSubscriptionOnGracePeriodCompleted",[200,775,441],{},", stamps the actual ",[200,778,740],{}," onto the local subscription. Usually an idempotent re-write of what ",[200,781,732],{}," already stored, but it self-heals a missed/out-of-order ",[200,784,434],{}," webhook (which would otherwise leave ",[200,787,740],{}," null and the subscription looking active forever) and corrects any drift between the scheduled and actual end.",[181,790,791,792,508,794,508,796,508,798,800,801,803],{},"The checkout events (",[200,793,571],{},[200,795,601],{},[200,797,614],{},[200,799,627],{},") ship no built-in reaction — they touch no local table. The checkout payloads carry the full Checkout resource (so they're dispatched without an enrichment GET), and there is no local checkout entity to keep in sync. Listen for them directly to drive receipt/retry/cart-abandonment UI or to flip your own application-level state. ",[200,802,441],{}," is likewise dispatched (on top of the reaction above) for consumers that want to flip their own application-level \"fully ended\" status.",[185,805,807],{"id":806},"custom-listeners","Custom listeners",[181,809,8