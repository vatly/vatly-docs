283],{"class":261},[255,1318,1319],{"class":286},"event",[255,1321,290],{"class":261},[255,1323,293],{"class":261},[255,1325,1326,1330],{"class":257,"line":341},[255,1327,1329],{"class":1328},"sHwdD","    \u002F\u002F $event->subscriptionPlanId",[255,1331,1332],{"class":1328},"              \u002F\u002F e.g. \"subscription_plan_7Hd9Kf2Lm\"\n",[255,1334,1336,1339],{"class":257,"line":1335},6,[255,1337,1338],{"class":1328},"    \u002F\u002F $event->subscriptionPlan->pendingUpdates",[255,1340,1341],{"class":1328}," \u002F\u002F null once approved\n",[255,1343,1345],{"class":257,"line":1344},7,[255,1346,1347],{"class":1328},"    \u002F\u002F Bust your local plan cache, re-pull your products, etc.\n",[255,1349,1351],{"class":257,"line":1350},8,[255,1352,1353],{"class":261},"});\n",[208,1355,1357],{"id":1356},"built-in-reactions","Built-in reactions",[204,1359,1360,1361,1365,1366,1369,1370,1373,1374,246],{},"Before the event is dispatched, the package keeps your local tables in sync automatically via fluent's standard webhook ",[1362,1363,1364],"em",{},"reactions",". These are wired by ",[223,1367,1368],{},"WebhookProcessorFactory"," inside the ",[223,1371,1372],{},"Vatly"," composition root — no registration needed on your side. They live under ",[223,1375,1376],{},"Vatly\\Fluent\\Webhooks\\Reactions\\",[1378,1379,1380,1398,1439,1453,1465],"ul",{},[1381,1382,1383,1388,1389,1391,1392,1394,1395,1397],"li",{},[509,1384,1385],{},[223,1386,1387],{},"SyncSubscriptionOnStarted"," -- On ",[223,1390,404],{},", creates (or updates) the local ",[223,1393,847],{}," row, then dispatches ",[223,1396,366],{}," for newly-created rows.",[1381,1399,1400,1388,1405,441,1407,441,1409,1411,1412,935,1414,1417,1418,276,1421,441,1424,441,1427,1430,1431,1434,1435,1438],{},[509,1401,1402],{},[223,1403,1404],{},"CancelSubscriptionOnCanceled",[223,1406,484],{},[223,1408,501],{},[223,1410,538],{},", sets the local subscription's ",[223,1413,493],{},[509,1415,1416],{},"and"," stores its ",[223,1419,1420],{},"cancellation_reason",[223,1422,1423],{},"merchant_request",[223,1425,1426],{},"payment_failure",[223,1428,1429],{},"customer_request","). The nonpayment case (a hard cancellation after payment recovery is exhausted) ends the subscription just like an immediate cancellation. Read the persisted reason off the model (",[223,1432,1433],{},"$subscription->cancellation_reason","), or ",[223,1436,1437],{},"$event->cancellationReason"," on the dispatched event, to branch your own dunning\u002Fwin-back UI off it.",[1381,1440,1441,1388,1446,1448,1449,1394,1451,1397],{},[509,1442,1443],{},[223,1444,1445],{},"StoreOrderOnPaid",[223,1447,569],{},", stores (or updates) the local ",[223,1450,871],{},[223,1452,370],{},[1381,1454,1455,1388,1460,1448,1462,1464],{},[509,1456,1457],{},[223,1458,1459],{},"StoreOrderOnPaymentFailed",[223,1461,599],{},[223,1463,871],{}," row, mirroring the upstream order status verbatim.",[1381,1466,1467,1388,1472,1474,1475,1477,1478,1480,1481,1483,1484,1486],{},[509,1468,1469],{},[223,1470,1471],{},"EndSubscriptionOnGracePeriodCompleted",[223,1473,550],{},", stamps the actual ",[223,1476,493],{}," onto the local subscription. Usually an idempotent re-write of what ",[223,1479,1404],{}," already stored, but it self-heals a missed\u002Fout-of-order ",[223,1482,543],{}," webhook (which would otherwise leave ",[223,1485,493],{}," null and the subscription looking active forever) and corrects any drift between the scheduled and actual end.",[204,1488,1489,1490,441,1492,441,1494,441,1496,1498,1499,1501],{},"The checkout events (",[223,1491,675],{},[223,1493,705],{},[223,1495,718],{},[223,1497,731],{},") ship no built-in reaction — they touch no local table. The checkout payloads carry the full Checkout resource (so they're dispatched without an enrichment GET), and there is no local checkout entity to keep in sync. Listen for them directly to drive receipt\u002Fretry\u002Fcart-abandonment UI or to flip your own application-level state. ",[223,1500,550]