tlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[204,205,206,215,236,243,249,263,290,327],"code",{"__ignoreMap":105},[207,208,211],"span",{"class":209,"line":210},"line",1,[207,212,214],{"class":213},"sHwdD","// Create a Vatly customer for this user\n",[207,216,218,222,226,229,233],{"class":209,"line":217},2,[207,219,221],{"class":220},"sMK4o","$",[207,223,225],{"class":224},"sTEyZ","user",[207,227,228],{"class":220},"->",[207,230,232],{"class":231},"s2Zo4","createAsVatlyCustomer",[207,234,235],{"class":220},"();\n",[207,237,239],{"class":209,"line":238},3,[207,240,242],{"emptyLinePlaceholder":241},true,"\n",[207,244,246],{"class":209,"line":245},4,[207,247,248],{"class":213},"// Create with extra data\n",[207,250,252,254,256,258,260],{"class":209,"line":251},5,[207,253,221],{"class":220},[207,255,225],{"class":224},[207,257,228],{"class":220},[207,259,232],{"class":231},[207,261,262],{"class":220},"([\n",[207,264,266,269,273,276,279,282,285,287],{"class":209,"line":265},6,[207,267,268],{"class":220},"    '",[207,270,272],{"class":271},"sfazB","locale",[207,274,275],{"class":220},"'",[207,277,278],{"class":220}," =>",[207,280,281],{"class":220}," '",[207,283,284],{"class":271},"nl_NL",[207,286,275],{"class":220},[207,288,289],{"class":220},",\n",[207,291,293,295,298,300,302,305,307,310,312,314,317,319,321,324],{"class":209,"line":292},7,[207,294,268],{"class":220},[207,296,297],{"class":271},"metadata",[207,299,275],{"class":220},[207,301,278],{"class":220},[207,303,304],{"class":220}," [",[207,306,275],{"class":220},[207,308,309],{"class":271},"internal_id",[207,311,275],{"class":220},[207,313,278],{"class":220},[207,315,316],{"class":220}," $",[207,318,225],{"class":224},[207,320,228],{"class":220},[207,322,323],{"class":224},"id",[207,325,326],{"class":220},"],\n",[207,328,330],{"class":209,"line":329},8,[207,331,332],{"class":220},"]);\n",[193,334,336],{"id":335},"checking-customer-status","Checking customer status",[198,338,340],{"className":200,"code":339,"language":202,"meta":105,"style":105},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[204,341,342,347,364,368,373],{"__ignoreMap":105},[207,343,344],{"class":209,"line":210},[207,345,346],{"class":213},"// Check if the user has a Vatly customer ID\n",[207,348,349,351,353,355,358,361],{"class":209,"line":217},[207,350,221],{"class":220},[207,352,225],{"class":224},[207,354,228],{"class":220},[207,356,357],{"class":231},"hasVatlyId",[207,359,360],{"class":220},"();",[207,362,363],{"class":213}," // bool\n",[207,365,366],{"class":209,"line":238},[207,367,242],{"emptyLinePlaceholder":241},[207,369,370],{"class":209,"line":245},[207,371,372],{"class":213},"// Get the Vatly customer ID\n",[207,374,375,377,379,381,384,386],{"class":209,"line":251},[207,376,221],{"class":220},[207,378,225],{"class":224},[207,380,228],{"class":220},[207,382,383],{"class":231},"getVatlyId",[207,385,360],{"class":220},[207,387,388],{"class":213}," // string|null\n",[193,390,392],{"id":391},"retrieving-customer-data","Retrieving customer data",[198,394,396],{"className":200,"code":395,"language":202,"meta":105,"style":105},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[204,397,398,403],{"__ignoreMap":105},[207,399,400],{"class":209,"line":210},[207,401,402],{"class":213},"// Get the full customer object from the Vatly API\n",[207,404,405,407,410,413,415,417,419,422],{"class":209,"line":217},[207,406,221],{"class":220},[207,408,409],{"class":224},"customer ",[207,411,412],{"class":220},"=",[207,414,316],{"class":220},[207,416,225],{"class":224},[207,418,228],{"class":220},[207,420,421],{"class":231},"asVatlyCustomer",[207,423,235],{"class":220},[193,425,427],{"id":426},"how-it-works","How it works",[189,429,430,431,434,435,438],{},"The ",[204,432,433],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[204,436,437],{},"createAsVatlyCustomer()",", it:",[440,441,442,450,456],"ol",{},[443,444,445,446,449],"li",{},"Sends a ",[204,447,448],{},"POST"," request to the Vatly API to create a customer",[443,451,452,453,455],{},"Stores the returned customer ID in the ",[204,454,433],{}," column",[443,457,458],{},"Returns the customer response",[189,460,461,462,464,465,467,468,471],{},"If the user already has a ",[204,463,433],{},", calling ",[204,466,437],{}," will throw a ",[204,469,470],{},"CustomerAlreadyBoundException",".",[193,473,475],{"id":474},"automatic-customer-creation","Automatic customer creation",[189,477,478],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[189,480,481,482,484],{},"This means you don't need to call ",[204,483,437],{}," before starting a checkout — just redirect the user directly.",[193,486,488],{"id":487},"anonymous-guest-checkouts","Anonymous / guest checkouts",[189,490,491,492,496,497,500,501,504,505,508],{},"A common flow: a visitor buys ",[493,494,495],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[204,498,499],{},"order.paid"," / ",[204,502,503],{},"subscription.started"," webhooks, and your app has no ",[204,506,507],{},"User"," row to attribute the purchase to yet.",[189,510,511],{},"The package handles this without losing data:",[513,514,515,548],"ul",{},[443,516,430,517,520,521,524,525,528,529,532,533,536,537,540,541,543,544,547],{},[204,518,519],{},"vatly_subscriptions"," and ",[204,522,523],{},"vatly_orders"," tables both have a nullable ",[204,526,527],{},"owner_id","/",[204,530,531],{},"owner_type"," plus a ",[204,534,535],{},"customer_id"," column. The webhook writes the row with ",[204,538,539],{},"owner_id = null"," but populates ",[204,542,535],{}," with the Vatly customer id (",[204,545,546],{},"cus_…",").",[443,549,550,551,554],{},"When the visitor returns on the checkout-success redirect, call ",[204,552,553],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[556,557,559,560,563],"h3",{"id":558},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[204,561,562],{},"{CHECKOUT_ID}"," placeholder",[189,565,566,567,570,571,573,574,577],{},"The one hard part of guest checkout is: ",[493,568,569],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[204,572,546],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[493,575,576],{},"isn't"," in the session).",[189,579,580,581,583],{},"Instead, put the literal ",[204,582,562],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[198,585,587],{"className":200,"code":586,"language":202,"meta":105,"style":105},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[204,588,589,609,655,688,709],{"__ignoreMap":105},[207,590,591,593,595,597,600,603,606],{"class":209,"line":210},[207,592,221],{"class":220},[207,594,225],{"class":224},[207,596,228],{"class":220},[207,598,599],{"class":231},"checkout",[207,601,602],{"class":220},"()->",[207,604,605],{"class":231},"create",[207,607,608],{"class":220},"(\n",[207,610,611,615,618,621,623,625,627,629,631,634,636,639,641,644,646,648,652],{"class":209,"line":217},[207,612,614],{"class":613},"sBMFI","    items",[207,616,617],{"class":220},":",[207,619,620],{"class":220}," [[",[207,622,275],{"class":220},[207,624,323],{"class":271},[207,626,275],{"class":220},[207,628,278],{"class":220},[207,630,281],{"class":220},[207,632,633],{"class":271},"product_abc123",[207,635,275],{"class":220},[207,637,638],{"class":220},",",[207,640,281],{"class":220},[207,642,643],{"class":271},"quantity",[207,645,275],{"class":220},[207,647,278],{"class":220},[207,649,651],{"class":650},"sbssI"," 1",[207,653,654],{"class":220},"]],\n",[207,656,657,660,662,665,668,670,673,675,678,681,684,686],{"class":209,"line":238},[207,658,659],{"class":613},"    redirectUrlSuccess",[207,661,617],{"class":220},[207,663,664],{"class":231}," route",[207,666,667],{"class":220},"(",[207,669,275],{"class":220},[207,671,672],{"class":271},"vatly.return",[207,674,275],{"class":220},[207,676,677],{"class":220},")",[207,679,680],{"class":220},".'",[207,682,683],{"class":271},"?checkout_id={CHECKOUT_ID}",[207,685,275],{"class":220},[207,687,289],{"class":220},[207,689,690,693,695,697,699,701,704,706],{"class":209,"line":245},[207,691,692],{"class":613},"    redirectUrlCanceled",[207,694,617],{"class":220},[207,696,664],{"class":231},[207,698,667],{"class":220},[207,700,275],{"class":220},[207,702,703],{"class":271},"billing",[207,705,275],{"class":220},[207,707,708],{"class":220},"),\n",[207,710,711],{"class":209,"line":251},[207,712,713],{"class":220},");\n",[189,715,716,717,617],{},"On the return route, hand the request to ",[204,718,553],{},[198,720,722],{"className":200,"code":721,"language":202,"meta":105,"style":105},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[204,723,724,749,754,759,764,787,791,816],{"__ignoreMap":105},[207,725,726,730,733,736,738,741,743,746],{"class":209,"line":210},[207,727,729],{"class":728},"spNyl","public",[207,731,732],{"class":728}," function",[207,734,735],{"class":231}," return",[207,737,667],{"class":220},[207,739,740],{"class":613},"Request",[207,742,316],{"class":220},[207,744,745],{"class":224},"request",[207,747,748],{"class":220},")\n",[207,750,751],{"class":209,"line":217},[207,752,753],{"class":220},"{\n",[207,755,756],{"class":209,"line":238},[207,757,758],{"class":213},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[207,760,761],{"class":209,"line":245},[207,762,763],{"class":213},"    // (if there is one) claims it for the authenticated user.\n",[207,765,766,769,771,773,775,777,780,783,785],{"class":209,"line":251},[207,767,768],{"class":220},"    $",[207,770,745],{"class":224},[207,772,228],{"class":220},[207,774,225],{"class":231},[207,776,602],{"class":220},[207,778,779],{"class":231},"claimVatlyCustomerFromReturn",[207,781,782],{"class":220},"($",[207,784,745],{"class":224},[207,786,713],{"class":220},[207,788,789],{"class":209,"line":265},[207,790,242],{"emptyLinePlaceholder":241},[207,792,793,797,800,802,805,807,809,812,814],{"class":209,"line":292},[207,794,796],{"class":795},"s7zQu","    return",[207,798,799],{"class":231}," redirect",[207,801,602],{"class":220},[207,803,804],{"class":231},"route",[207,806,667],{"class":220},[207,808,275],{"class":220},[207,810,811],{"class":271},"dashboard",[207,813,275],{"class":220},[207,815,713],{"class":220},[207,817,818],{"class":209,"line":329},[207,819,820],{"class":220},"}\n",[189,822,823,824,827,828,831],{},"It returns ",[204,825,826],{},"true"," when a claim happened and ",[204,829,830],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[198,833,835],{"className":200,"code":834,"language":202,"meta":105,"style":105},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[204,836,837],{"__ignoreMap":105},[207,838,839,841,843,845,847,849,851,853,855,858,860,863],{"class":209,"line":210},[207,840,221],{"class":220},[207,842,225],{"class":224},[207,844,228],{"class":220},[207,846,779],{"class":231},[207,848,782],{"class":220},[207,850,745],{"class":224},[207,852,638],{"class":220},[207,854,281],{"class":220},[207,856,857],{"class":271},"cid",[207,859,275],{"class":220},[207,861,862],{"class":220},");",[207,864,865],{"class":213}," // reads ?cid=…\n",[189,867,868,869,873],{},"This is ",[870,871,872],"strong",{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[875,876,877],"blockquote",{},[189,878,879,880,883],{},"The checkout id travels in the URL, so it may also appear in the ",[204,881,882],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[189,885,886,887,889,890,893],{},"Under the hood ",[204,888,553],{}," resolves the checkout's customer id via the Vatly API and then runs ",[204,891,892],{},"claimVatlyCustomer()",", which:",[440,895,896,906,909],{},[443,897,898,899,902,903,905],{},"Binds the Vatly customer id to this host entity via the configured ",[204,900,901],{},"CustomerBindingRepository"," (default impl: writes ",[204,904,433],{}," on the billable table).",[443,907,908],{},"Saves the model.",[443,910,911,912,500,914,916,917,520,919,921,922,924],{},"Backfills ",[204,913,531],{},[204,915,527],{}," on every ",[204,918,519],{},[204,920,523],{}," row that carries the same ",[204,923,535],{}," but had no owner yet.",[189,926,430,927,500,929,931,932,934,935,937,938,940,941,943],{},[204,928,499],{},[204,930,503],{}," webhook usually lands ",[493,933,495],{}," the buyer is redirected back, so those rows already exist (with ",[204,936,539],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[204,939,535],{}," finds the binding and writes ",[204,942,527],{}," directly. Either way the purchase ends up attributed.",[189,945,946,947,949,950,953],{},"If you already hold the ",[204,948,546],{}," by other means, you can still call ",[204,951,952],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[875,955,956],{},[189,957,958,961],{},[870,959,960],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[189,963,964],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[198,966,968],{"className":200,"code":967,"language":202,"meta":105,"style":105},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[204,969,970,1005,1016,1030,1034,1049],{"__ignoreMap":105},[207,971,972,974,976,978,981,984,987,990,993,995,997,1000,1003],{"class":209,"line":210},[207,973,221],{"class":220},[207,975,409],{"class":224},[207,977,412],{"class":220},[207,979,980],{"class":231}," app",[207,982,983],{"class":220},"(\\",[207,985,986],{"class":224},"Vatly",[207,988,989],{"class":220},"\\",[207,991,992],{"class":224},"Fluent",[207,994,989],{"class":220},[207,996,986],{"class":613},[207,998,999],{"class":220},"::",[207,1001,1002],{"class":650},"class",[207,1004,748],{"class":220},[207,1006,1007,1010,1013],{"class":209,"line":217},[207,1008,1009],{"class":220},"    ->",[207,1011,1012],{"class":231},"customers",[207,1014,1015],{"class":220},"()\n",[207,1017,1018,1020,1023,1025,1028],{"class":209,"line":238},[207,1019,1009],{"class":220},[207,1021,1022],{"class":231},"findByVatlyCustomerId",[207,1024,782],{"class":220},[207,1026,1027],{"class":224},"vatlyCustomerId",[207,1029,713],