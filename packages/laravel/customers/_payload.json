noreMap":105},[199,335,336],{"class":201,"line":202},[199,337,338],{"class":205},"// Check if the user has a Vatly customer ID\n",[199,340,341,343,345,347,350,353],{"class":201,"line":209},[199,342,213],{"class":212},[199,344,217],{"class":216},[199,346,220],{"class":212},[199,348,349],{"class":223},"hasVatlyId",[199,351,352],{"class":212},"();",[199,354,355],{"class":205}," // bool\n",[199,357,358],{"class":201,"line":230},[199,359,234],{"emptyLinePlaceholder":233},[199,361,362],{"class":201,"line":237},[199,363,364],{"class":205},"// Get the Vatly customer ID\n",[199,366,367,369,371,373,376,378],{"class":201,"line":243},[199,368,213],{"class":212},[199,370,217],{"class":216},[199,372,220],{"class":212},[199,374,375],{"class":223},"getVatlyId",[199,377,352],{"class":212},[199,379,380],{"class":205}," // string|null\n",[185,382,384],{"id":383},"retrieving-customer-data","Retrieving customer data",[190,386,388],{"className":192,"code":387,"language":194,"meta":105,"style":105},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[196,389,390,395],{"__ignoreMap":105},[199,391,392],{"class":201,"line":202},[199,393,394],{"class":205},"// Get the full customer object from the Vatly API\n",[199,396,397,399,402,405,407,409,411,414],{"class":201,"line":209},[199,398,213],{"class":212},[199,400,401],{"class":216},"customer ",[199,403,404],{"class":212},"=",[199,406,308],{"class":212},[199,408,217],{"class":216},[199,410,220],{"class":212},[199,412,413],{"class":223},"asVatlyCustomer",[199,415,227],{"class":212},[185,417,419],{"id":418},"how-it-works","How it works",[181,421,422,423,426,427,430],{},"The ",[196,424,425],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[196,428,429],{},"createAsVatlyCustomer()",", it:",[432,433,434,442,448],"ol",{},[435,436,437,438,441],"li",{},"Sends a ",[196,439,440],{},"POST"," request to the Vatly API to create a customer",[435,443,444,445,447],{},"Stores the returned customer ID in the ",[196,446,425],{}," column",[435,449,450],{},"Returns the customer response",[181,452,453,454,456,457,459,460,463],{},"If the user already has a ",[196,455,425],{},", calling ",[196,458,429],{}," will throw a ",[196,461,462],{},"CustomerAlreadyBoundException",".",[185,465,467],{"id":466},"automatic-customer-creation","Automatic customer creation",[181,469,470],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[181,472,473,474,476],{},"This means you don't need to call ",[196,475,429],{}," before starting a checkout — just redirect the user directly.",[185,478,480],{"id":479},"anonymous-guest-checkouts","Anonymous / guest checkouts",[181,482,483,484,488,489,492,493,496,497,500],{},"A common flow: a visitor buys ",[485,486,487],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[196,490,491],{},"order.paid"," / ",[196,494,495],{},"subscription.started"," webhooks, and your app has no ",[196,498,499],{},"User"," row to attribute the purchase to yet.",[181,502,503],{},"The package handles this without losing data:",[505,506,507,540],"ul",{},[435,508,422,509,512,513,516,517,520,521,524,525,528,529,532,533,535,536,539],{},[196,510,511],{},"vatly_subscriptions"," and ",[196,514,515],{},"vatly_orders"," tables both have a nullable ",[196,518,519],{},"owner_id","/",[196,522,523],{},"owner_type"," plus a ",[196,526,527],{},"customer_id"," column. The webhook writes the row with ",[196,530,531],{},"owner_id = null"," but populates ",[196,534,527],{}," with the Vatly customer id (",[196,537,538],{},"cus_…",").",[435,541,542,543,546,547,549],{},"When the visitor later signs up (or signs in for the first time), call ",[196,544,545],{},"claimVatlyCustomer($vatlyCustomerId)"," on the new ",[196,548,499],{}," to retroactively link the prior rows:",[190,551,553],{"className":192,"code":552,"language":194,"meta":105,"style":105},"// In your signup controller — $vatlyCustomerId typically comes from\n// a query param on the checkout-success URL, a session, or a cookie\n// set during the anonymous checkout flow.\n$user = User::create([...]);\n\n$claimed = $user->claimVatlyCustomer($vatlyCustomerId);\n// $claimed is the number of subscription + order rows that were\n// re-attributed to the user. Subsequent $user->orders / $user->subscriptions\n// return them as you'd expect.\n",[196,554,555,560,565,570,592,596,623,628,633],{"__ignoreMap":105},[199,556,557],{"class":201,"line":202},[199,558,559],{"class":205},"// In your signup controller — $vatlyCustomerId typically comes from\n",[199,561,562],{"class":201,"line":209},[199,563,564],{"class":205},"// a query param on the checkout-success URL, a session, or a cookie\n",[199,566,567],{"class":201,"line":230},[199,568,569],{"class":205},"// set during the anonymous checkout flow.\n",[199,571,572,574,577,579,583,586,589],{"class":201,"line":237},[199,573,213],{"class":212},[199,575,576],{"class":216},"user ",[199,578,404],{"class":212},[199,580,582],{"class":581},"sBMFI"," User",[199,584,585],{"class":212},"::",[199,587,588],{"class":223},"create",[199,590,591],{"class":212},"([...]);\n",[199,593,594],{"class":201,"line":243},[199,595,234],{"emptyLinePlaceholder":233},[199,597,598,600,603,605,607,609,611,614,617,620],{"class":201,"line":257},[199,599,213],{"class":212},[199,601,602],{"class":216},"claimed ",[199,604,404],{"class":212},[199,606,308],{"class":212},[199,608,217],{"class":216},[199,610,220],{"class":212},[199,612,613],{"class":223},"claimVatlyCustomer",[199,615,616],{"class":212},"($",[199,618,619],{"class":216},"vatlyCustomerId",[199,621,622],{"class":212},");\n",[199,624,625],{"class":201,"line":284},[199,626,627],{"class":205},"// $claimed is the number of subscription + order rows that were\n",[199,629,630],{"class":201,"line":321},[199,631,632],{"class":205},"// re-attributed to the user. Subsequent $user->orders / $user->subscriptions\n",[199,634,636],{"class":201,"line":635},9,[199,637,638],{"class":205},"// return them as you'd expect.\n",[181,640,641,644],{},[196,642,643],{},"claimVatlyCustomer()"," does three things:",[432,646,647,657,660],{},[435,648,649,650,653,654,656],{},"Binds the Vatly customer id to this host entity via the configured ",[196,651,652],{},"CustomerBindingRepository"," (default impl: writes ",[196,655,425],{}," on the billable table).",[435,658,659],{},"Saves the model.",[435,661,662,663,492,665,667,668,512,670,672,673,675],{},"Backfills ",[196,664,523],{},[196,666,519],{}," on every ",[196,669,511],{},[196,671,515],{}," row that carries the same ",[196,674,527],{}," but had no owner yet.",[181,677,678],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[190,680,682],{"className":192,"code":681,"language":194,"meta":105,"style":105},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[196,683,684,720,731,744,748,763],{"__ignoreMap":105},[199,685,686,688,690,692,695,698,701,704,707,709,711,713,717],{"class":201,"line":202},[199,687,213],{"class":212},[199,689,401],{"class":216},[199,691,404],{"class":212},[199,693,694],{"class":223}," app",[199,696,697],{"class":212},"(\\",[199,699,700],{"class":216},"Vatly",[199,702,703],{"class":212},"\\",[199,705,706],{"class":216},"Fluent",[199,708,703],{"class":212},[199,710,700],{"class":581},[199,712,585],{"class":212},[199,714,716],{"class":715},"sbssI","class",[199,718,719],{"class":212},")\n",[199,721,722,725,728],{"class":201,"line":209},[199,723,724],{"class":212},"    ->",[199,726,727],{"class":223},"customers",[199,729,730],{"class":212},"()\n",[199,732,733,735,738,740,742],{"class":201,"line":230},[199,734,724],{"class":212},[199,736,737],{"class":223},"findByVatl