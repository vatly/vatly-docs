,"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":172,"path":173,"stem":174},"Integrations","/integrations","4.integrations",{"id":176,"title":56,"body":177,"description":1069,"extension":1070,"links":1071,"meta":1072,"navigation":233,"path":153,"seo":1073,"stem":154,"__hash__":1074},"docs/3.packages/2.laravel/1.customers.md",{"type":178,"value":179,"toc":1058},"minimark",[180,184,189,325,329,381,385,416,420,431,451,464,468,471,477,481,501,504,547,556,570,576,706,711,813,824,858,866,876,886,917,936,946,954,957,1054],[181,182,183],"p",{},"Every billable model can be linked to a Vatly customer. Customers are created automatically by Vatly during checkout and synced to your application via webhooks. You can also create customers explicitly if needed.",[185,186,188],"h2",{"id":187},"creating-a-customer","Creating a customer",[190,191,195],"pre",{"className":192,"code":193,"language":194,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","// Create a Vatly customer for this user\n$user->createAsVatlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[196,197,198,207,228,235,241,255,282,319],"code",{"__ignoreMap":105},[199,200,203],"span",{"class":201,"line":202},"line",1,[199,204,206],{"class":205},"sHwdD","// Create a Vatly customer for this user\n",[199,208,210,214,218,221,225],{"class":201,"line":209},2,[199,211,213],{"class":212},"sMK4o","$",[199,215,217],{"class":216},"sTEyZ","user",[199,219,220],{"class":212},"->",[199,222,224],{"class":223},"s2Zo4","createAsVatlyCustomer",[199,226,227],{"class":212},"();\n",[199,229,231],{"class":201,"line":230},3,[199,232,234],{"emptyLinePlaceholder":233},true,"\n",[199,236,238],{"class":201,"line":237},4,[199,239,240],{"class":205},"// Create with extra data\n",[199,242,244,246,248,250,252],{"class":201,"line":243},5,[199,245,213],{"class":212},[199,247,217],{"class":216},[199,249,220],{"class":212},[199,251,224],{"class":223},[199,253,254],{"class":212},"([\n",[199,256,258,261,265,268,271,274,277,279],{"class":201,"line":257},6,[199,259,260],{"class":212},"    '",[199,262,264],{"class":263},"sfazB","locale",[199,266,267],{"class":212},"'",[199,269,270],{"class":212}," =>",[199,272,273],{"class":212}," '",[199,275,276],{"class":263},"nl_NL",[199,278,267],{"class":212},[199,280,281],{"class":212},",\n",[199,283,285,287,290,292,294,297,299,302,304,306,309,311,313,316],{"class":201,"line":284},7,[199,286,260],{"class":212},[199,288,289],{"class":263},"metadata",[199,291,267],{"class":212},[199,293,270],{"class":212},[199,295,296],{"class":212}," [",[199,298,267],{"class":212},[199,300,301],{"class":263},"internal_id",[199,303,267],{"class":212},[199,305,270],{"class":212},[199,307,308],{"class":212}," $",[199,310,217],{"class":216},[199,312,220],{"class":212},[199,314,315],{"class":216},"id",[199,317,318],{"class":212},"],\n",[199,320,322],{"class":201,"line":321},8,[199,323,324],{"class":212},"]);\n",[185,326,328],{"id":327},"checking-customer-status","Checking customer status",[190,330,332],{"className":192,"code":331,"language":194,"meta":105,"style":105},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[196,333,334,339,356,360,365],{"__ignoreMap":105},[199,335,336],{"class":201,"line":202},[199,337,338],{"class":205},"// Check if the user has a Vatly customer ID\n",[199,340,341,343,345,347,350,353],{"class":201,"line":209},[199,342,213],{"class":212},[199,344,217],{"class":216},[199,346,220],{"class":212},[199,348,349],{"class":223},"hasVatlyId",[199,351,352],{"class":212},"();",[199,354,355],{"class":205}," // bool\n",[199,357,358],{"class":201,"line":230},[199,359,234],{"emptyLinePlaceholder":233},[199,361,362],{"class":201,"line":237},[199,363,364],{"class":205},"// Get the Vatly customer ID\n",[199,366,367,369,371,373,376,378],{"class":201,"line":243},[199,368,213],{"class":212},[199,370,217],{"class":216},[199,372,220],{"class":212},[199,374,375],{"class":223},"getVatlyId",[199,377,352],{"class":212},[199,379,380],{"class":205}," // string|null\n",[185,382,384],{"id":383},"retrieving-customer-data","Retrieving customer data",[190,386,388],{"className":192,"code":387,"language":194,"meta":105,"style":105},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[196,389,390,395],{"__ignoreMap":105},[199,391,392],{"class":201,"line":202},[199,393,394],{"class":205},"// Get the full customer object from the Vatly API\n",[199,396,397,399,402,405,407,409,411,414],{"class":201,"line":209},[199,398,213],{"class":212},[199,400,401],{"class":216},"customer ",[199,403,404],{"class":212},"=",[199,406,308],{"class":212},[199,408,217],{"class":216},[199,410,220],{"class":212},[199,412,413],{"class":223},"asVatlyCustomer",[199,415,227],{"class":212},[185,417,419],{"id":418},"how-it-works","How it works",[181,421,422,423,426,427,430],{},"The ",[196,424,425],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[196,428,429],{},"createAsVatlyCustomer()",", it:",[432,433,434,442,448],"ol",{},[435,436,437,438,441],"li",{},"Sends a ",[196,439,440],{},"POST"," request to the Vatly API to create a customer",[435,443,444,445,447],{},"Stores the returned customer ID in the ",[196,446,425],{}," column",[435,449,450],{},"Returns the customer response",[181,452,453,454,456,457,459,460,463],{},"If the user already has a ",[196,455,425],{},", calling ",[196,458,429],{}," will throw a ",[196,461,462],{},"CustomerAlreadyBoundException",".",[185,465,467],{"id":466},"automatic-customer-creation","Automatic customer creation",[181,469,470],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[181,472,473,474,476],{},"This means you don't need to call ",[196,475,429],{}," before starting a checkout — just redirect the user directly.",[185,478,480],{"id":479},"anonymous-guest-checkouts","Anonymous / guest checkouts",[181,482,483,484,488,489,492,493,496,497,500],{},"A common flow: a visitor buys ",[485,486,487],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[196,490,491],{},"order.paid"," / ",[196,494,495],{},"subscription.started"," webhooks, and your app has no ",[196,498,499],{},"User"," row to attribute the purchase to yet.",[181,502,503],{},"The package handles this without losing data:",[505,506,507,540],"ul",{},[435,508,422,509,512,513,516,517,520,521,524,525,528,529,532,533,535,536,539],{},[196,510,511],{},"vatly_subscriptions"," and ",[196,514,515],{},"vatly_orders"," tables both have a nullable ",[196,518,519],{},"owner_id","/",[196,522,523],{},"owner_type"," plus a ",[196,526,527],{},"customer_id"," column. The webhook writes the row with ",[196,530,531],{},"owner_id = null"," but populates ",[196,534,527],{}," with the Vatly customer id (",[196,537,538],{},"cus_…",").",[435,541,542,543,546],{},"When the visitor returns on the checkout-success redirect, call ",[196,544,545],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[548,549,551,552,555],"h3",{"id":550},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[196,553,554],{},"{CHECKOUT_ID}"," placeholder",[181,557,558,559,562,563,565,566,569],{},"The one hard part of guest checkout is: ",[485,560,561],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[196,564,538],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[485,567,568],{},"isn't"," in the session).",[181,571,572,573,575],{},"Instead, put the literal ",[196,574,554],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[190,577,579],{"className":192,"code":578,"language":194,"meta":105,"style":105},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[196,580,581,601,647,680,701],{"__ignoreMap":105},[199,582,583,585,587,589,592,595,598],{"class":201,"line":202},[199,584,213],{"class":212},[199,586,217],{"class":216},[199,588,220],{"class":212},[199,590,591],{"class":223},"checkout",[199,593,594],{"class":212},"()->",[199,596,597],{"class":223},"create",[199,599,600],{"class":212},"(\n",[199,602,603,607,610,613,615,617,619,621,623,626,628,631,633,636,638,640,644],{"class":201,"line":209},[199,604,606],{"class":605},"sBMFI","    items",[199,608,609],{"class":212},":",[199,611,612],{"class":212}," [[",[199,614,267],{"class":212},[199,616,315],{"class":263},[199,618,267],{"class":212},[199,620,270],{"class":212},[199,622,273],{"class":212},[199,624,625],{"class":263},"product_abc123",[199,627,267],{"class":212},[199,629,630],{"class":212},",",[199,632,273],{"class":212},[199,634,635],{"class":263},"quantity",[199,637,267],{"class":212},[199,639,270],{"class":212},[199,641,643],{"class":642},"sbssI"," 1",[199,645,646],{"class":212},"]],\n",[199,648,649,652,654,657,660,662,665,667,670,673,676,678],{"class":201,"line":230},[199,650,651],{"class":605},"    redirectUrlSuccess",[199,653,609],{"class":212},[199,655,656],{"class":223}," route",[199,658,659],{"class":212},"(",[199,661,267],{"class":212},[199,663,664],{"class":263},"vatly.return",[199,666,267],{"class":212},[199,668,669],{"class":212},")",[199,671,672],{"class":212},".'",[199,674,675],{"class":263},"?checkout_id={CHECKOUT_ID}",[199,677,267],{"class":212},[199,679,281],{"class":212},[199,681,682,685,687,689,691,693,696,698],{"class":201,"line":237},[199,683,684],{"class":605},"    redirectUrlCanceled",[199,686,609],{"class":212},[199,688,656],{"class":223},[199,690,659],{"class":212},[199,692,267],{"class":212},[199,694,695],{"class":263},"billing",[199,697,267],{"class":212},[199,699,700],{"class":212},"),\n",[199,702,703],{"class":201,"line":243},[199,704,705],{"class":212},");\n",[181,707,708,709,609],{},"On the return route, hand the request to ",[196,710,545],{},[190,712,714],{"className":192,"code":713,"language":194,"meta":105,"style":105},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[196,715,716,741,746,751,756,779,783,808],{"__ignoreMap":105},[199,717,718,722,725,728,730,733,735,738],{"class":201,"line":202},[199,719,721],{"class":720},"spNyl","public",[199,723,724],{"class":720}," function",[199,726,727],{"class":223}," return",[199,729,659],{"class":212},[199,731,732],{"class":605},"Request",[199,734,308],{"class":212},[199,736,737],{"class":216},"request",[199,739,740],{"class":212},")\n",[199,742,743],{"class":201,"line":209},[199,744,745],{"class":212},"{\n",[199,747,748],{"class":201,"line":230},[199,749,750],{"class":205},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[199,752,753],{"class":201,"line":237},[199,754,755],{"class":205},"    // (if there is one) claims it for the authenticated user.\n",[199,757,758,761,763,765,767,769,772,775,777],{"class":201,"line":243},[199,759,760],{"class":212},"    $",[199,762,737],{"class":216},[199,764,220],{"class":212},[199,766,217],{"class":223},[199,768,594],{"class":212},[199,770,771],{"class":223},"claimVatlyCustomerFromReturn",[199,773,774],{"class":212},"($",[199,776,737],{"class":216},[199,778,705],{"class":212},[199,780,781],{"class":201,"line":257},[199,782,234],{"emptyLinePlaceholder":233},[199,784,785,789,792,794,797,799,801,804,806],{"class":201,"line":284},[199,786,788],{"class":787},"s7zQu","    return",[199,790,791],{"class":223}," redirect",[199,793,594],{"class":212},[199,795,796],{"class":223},"route",[199,798,659],{"class":212},[199,800,267],{"class":212},[199,802,803],{"class":263},"dashboard",[199,805,267],{"class":212},[199,807,705],{"class":212},[199,809,810],{"class":201,"line":321},[199,811,812],{"class":212},"}\n",[181,814,815,816,819,820,823],{},"It returns ",[196,817,818],{},"true"," when a claim happened and ",[196,821,822],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[190,825,827],{"className":192,"code":826,"language":194,"meta":105,"style":105},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[196,828,829],{"__ignoreMap":105},[199,830,831,833,835,837,839,841,843,845,847,850,852,855],{"class":201,"line":202},[199,832,213],{"class":212},[199,834,217],{"class":216},[199,836,220],{"class":212},[199,838,771],{"class":223},[199,840,774],{"class":212},[199,842,737],{"class":216},[199,844,630],{"class":212},[199,846,273],{"class":212},[199,848,849],{"class":263},"cid",[199,851,267],{"class":212},[199,853,854],{"class":212},");",[199,856,857],{"class":205}," // reads ?cid=…\n",[181,859,860,861,865],{},"This is ",[862,863,864],"strong",{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[867,868,869],"blockquote",{},[181,870,871,872,875],{},"The checkout id travels in the URL, so it may also appear in the ",[196,873,874],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[181,877,878,879,881,882,885],{},"Under the hood ",[196,880,545],{}," resolves the checkout's customer id via the Vatly API and then runs ",[196,883,884],{},"claimVatlyCustomer()",", which:",[432,887,888,898,901],{},[435,889,890,891,894,895,897],{},"Binds the Vatly customer id to this host entity via the configured ",[196,892,893],{},"CustomerBindingRepository"," (default impl: writes ",[196,896,425],{}," on the billable table).",[435,899,900],{},"Saves the model.",[435,902,903,904,492,906,908,909,512,911,913,914,916],{},"Backfills ",[196,905,523],{},[196,907,519],{}," on every ",[196,910,511],{},[196,912,515],{}," row that carries the same ",[196,915,527],{}," but had no owner yet.",[181,918,422,919,492,921,923,924,926,927,929,930,932,933,935],{},[196,920,491],{},[196,922,495],{}," webhook usually lands ",[485,925,487],{}," the buyer is redirected back, so those rows already exist (with ",[196,928,531],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[196,931,527],{}," finds the binding and writes ",[196,934,519],{}," directly. Either way the purchase ends up attributed.",[181,937,938,939,941,942,945],{},"If you already hold the ",[196,940,538],{}," by other means, you can still call ",[196,943,944],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[867,947,948],{},[181,949,950,953],{},[862,951,952],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[181,955,956],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[190,958,960],{"className":192,"code":959,"language":194,"meta":105,"style":105},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[196,961,962,997,1008,1022,1026,1041],{"__ignoreMap":105},[199,963,964,966,968,970,973,976,979,982,985,987,989,992,995],{"class":201,"line":202},[199,965,213],{"class":212},[199,967,401],{"class":216},[199,969,404],{"class":212},[199,971,972],{"class":223}," app",[199,974,975],{"class":212},"(\\",[199,977,978],{"class":216},"Vatly",[199,980,981],{"class":212},"\\",[199,983,984],{"class":216},"Fluent",[199,986,981],{"class":212},[199,988,978],{"class":605},[199,990,991],{"class":212},"::",[199,993,994],{"class":642},"class",[199,996,740],{"class":212},[199,998,999,1002,1005],{"class":201,"line":209},[199,1000,1001],{"class":212},"    ->",[199,1003,1004],{"class":223},"customers",[199,1006,1007],{"class":212},"()\n",[199,1009,1010,1012,1015,1017,1020],{"class":201,"line":230},[199,1011,1001],{"class":212},[199,1013,1014],{"class":223},"findByVatlyCustomerId",[199,1016,774],{"class":212},[199,1018,1019],{"class":216},"vatlyCustomerId",[199,1021,705],{"class":212},[199,1023,1024],{"class":201,"line":237},[199,1025,234],{"emptyLinePlaceholder":233},[199,1027,1028,1030,1033,1035,1038],{"class":201,"line":243},[199,1029,213],{"class":212},[199,1031,1032],{"class":216},"customer",[199,1034,220],{"class":212},[199,1036,1037],{"class":216},"email",[199,1039,1040],{"class":212},";\n",[199,1042,1043,1045,1047,1049,1052],{"class":201,"line":257},[199,1044,213],{"class":212},[199,1046,1032],{"class":216},[199,1048,220],{"class":212},[199,1050,1051],{"class":216},"name",[199,1053,1040],{"class":212},[1055,1056,1057],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-