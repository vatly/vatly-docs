,"creating-a-customer","Creating a customer",[205,206,210],"pre",{"className":207,"code":208,"language":209,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","// Create a Vatly customer for this user\n$user->createAsVatlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[211,212,213,222,243,250,256,270,297,334],"code",{"__ignoreMap":109},[214,215,218],"span",{"class":216,"line":217},"line",1,[214,219,221],{"class":220},"sHwdD","// Create a Vatly customer for this user\n",[214,223,225,229,233,236,240],{"class":216,"line":224},2,[214,226,228],{"class":227},"sMK4o","$",[214,230,232],{"class":231},"sTEyZ","user",[214,234,235],{"class":227},"->",[214,237,239],{"class":238},"s2Zo4","createAsVatlyCustomer",[214,241,242],{"class":227},"();\n",[214,244,246],{"class":216,"line":245},3,[214,247,249],{"emptyLinePlaceholder":248},true,"\n",[214,251,253],{"class":216,"line":252},4,[214,254,255],{"class":220},"// Create with extra data\n",[214,257,259,261,263,265,267],{"class":216,"line":258},5,[214,260,228],{"class":227},[214,262,232],{"class":231},[214,264,235],{"class":227},[214,266,239],{"class":238},[214,268,269],{"class":227},"([\n",[214,271,273,276,280,283,286,289,292,294],{"class":216,"line":272},6,[214,274,275],{"class":227},"    '",[214,277,279],{"class":278},"sfazB","locale",[214,281,282],{"class":227},"'",[214,284,285],{"class":227}," =>",[214,287,288],{"class":227}," '",[214,290,291],{"class":278},"nl_NL",[214,293,282],{"class":227},[214,295,296],{"class":227},",\n",[214,298,300,302,305,307,309,312,314,317,319,321,324,326,328,331],{"class":216,"line":299},7,[214,301,275],{"class":227},[214,303,304],{"class":278},"metadata",[214,306,282],{"class":227},[214,308,285],{"class":227},[214,310,311],{"class":227}," [",[214,313,282],{"class":227},[214,315,316],{"class":278},"internal_id",[214,318,282],{"class":227},[214,320,285],{"class":227},[214,322,323],{"class":227}," $",[214,325,232],{"class":231},[214,327,235],{"class":227},[214,329,330],{"class":231},"id",[214,332,333],{"class":227},"],\n",[214,335,337],{"class":216,"line":336},8,[214,338,339],{"class":227},"]);\n",[200,341,343],{"id":342},"checking-customer-status","Checking customer status",[205,345,347],{"className":207,"code":346,"language":209,"meta":109,"style":109},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[211,348,349,354,371,375,380],{"__ignoreMap":109},[214,350,351],{"class":216,"line":217},[214,352,353],{"class":220},"// Check if the user has a Vatly customer ID\n",[214,355,356,358,360,362,365,368],{"class":216,"line":224},[214,357,228],{"class":227},[214,359,232],{"class":231},[214,361,235],{"class":227},[214,363,364],{"class":238},"hasVatlyId",[214,366,367],{"class":227},"();",[214,369,370],{"class":220}," // bool\n",[214,372,373],{"class":216,"line":245},[214,374,249],{"emptyLinePlaceholder":248},[214,376,377],{"class":216,"line":252},[214,378,379],{"class":220},"// Get the Vatly customer ID\n",[214,381,382,384,386,388,391,393],{"class":216,"line":258},[214,383,228],{"class":227},[214,385,232],{"class":231},[214,387,235],{"class":227},[214,389,390],{"class":238},"getVatlyId",[214,392,367],{"class":227},[214,394,395],{"class":220}," // string|null\n",[200,397,399],{"id":398},"retrieving-customer-data","Retrieving customer data",[205,401,403],{"className":207,"code":402,"language":209,"meta":109,"style":109},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[211,404,405,410],{"__ignoreMap":109},[214,406,407],{"class":216,"line":217},[214,408,409],{"class":220},"// Get the full customer object from the Vatly API\n",[214,411,412,414,417,420,422,424,426,429],{"class":216,"line":224},[214,413,228],{"class":227},[214,415,416],{"class":231},"customer ",[214,418,419],{"class":227},"=",[214,421,323],{"class":227},[214,423,232],{"class":231},[214,425,235],{"class":227},[214,427,428],{"class":238},"asVatlyCustomer",[214,430,242],{"class":227},[200,432,434],{"id":433},"updating-customer-identity","Updating customer identity",[196,436,437,438,441,442,445,446,450],{},"Update the customer's ",[211,439,440],{},"name"," and/or ",[211,443,444],{},"email"," at Vatly (both optional — send\nwhichever changed). Billing-address details (company name, tax id, street, …)\nare ",[447,448,449],"strong",{},"not"," editable here; send the customer through the hosted billing-update\nflow for those.",[205,452,454],{"className":207,"code":453,"language":209,"meta":109,"style":109},"$customer = $user->updateVatlyCustomer([\n    'name' => 'Jane Doe',\n    'email' => 'jane@example.com',\n]);\n",[211,455,456,475,494,513],{"__ignoreMap":109},[214,457,458,460,462,464,466,468,470,473],{"class":216,"line":217},[214,459,228],{"class":227},[214,461,416],{"class":231},[214,463,419],{"class":227},[214,465,323],{"class":227},[214,467,232],{"class":231},[214,469,235],{"class":227},[214,471,472],{"class":238},"updateVatlyCustomer",[214,474,269],{"class":227},[214,476,477,479,481,483,485,487,490,492],{"class":216,"line":224},[214,478,275],{"class":227},[214,480,440],{"class":278},[214,482,282],{"class":227},[214,484,285],{"class":227},[214,486,288],{"class":227},[214,488,489],{"class":278},"Jane Doe",[214,491,282],{"class":227},[214,493,296],{"class":227},[214,495,496,498,500,502,504,506,509,511],{"class":216,"line":245},[214,497,275],{"class":227},[214,499,444],{"class":278},[214,501,282],{"class":227},[214,503,285],{"class":227},[214,505,288],{"class":227},[214,507,508],{"class":278},"jane@example.com",[214,510,282],{"class":227},[214,512,296],{"class":227},[214,514,515],{"class":216,"line":252},[214,516,339],{"class":227},[196,518,519,520,523],{},"Throws ",[211,521,522],{},"NoVatlyCustomerException"," if the user has no Vatly customer yet.",[200,525,527],{"id":526},"how-it-works","How it works",[196,529,530,531,534,535,538],{},"The ",[211,532,533],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[211,536,537],{},"createAsVatlyCustomer()",", it:",[540,541,542,550,556],"ol",{},[543,544,545,546,549],"li",{},"Sends a ",[211,547,548],{},"POST"," request to the Vatly API to create a customer",[543,551,552,553,555],{},"Stores the returned customer ID in the ",[211,554,533],{}," column",[543,557,558],{},"Returns the customer response",[196,560,561,562,564,565,567,568,571],{},"If the user already has a ",[211,563,533],{},", calling ",[211,566,537],{}," will throw a ",[211,569,570],{},"CustomerAlreadyBoundException",".",[200,573,575],{"id":574},"automatic-customer-creation","Automatic customer creation",[196,577,578],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[196,580,581,582,584],{},"This means you don't need to call ",[211,583,537],{}," before starting a checkout — just redirect the user directly.",[200,586,588],{"id":587},"anonymous-guest-checkouts","Anonymous / guest checkouts",[196,590,591,592,596,597,600,601,604,605,608],{},"A common flow: a visitor buys ",[593,594,595],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[211,598,599],{},"order.paid"," / ",[211,602,603],{},"subscription.started"," webhooks, and your app has no ",[211,606,607],{},"User"," row to attribute the purchase to yet.",[196,610,611],{},"The package handles this without losing data:",[613,614,615,648],"ul",{},[543,616,530,617,620,621,624,625,628,629,632,633,636,637,640,641,643,644,647],{},[211,618,619],{},"vatly_subscriptions"," and ",[211,622,623],{},"vatly_orders"," tables both have a nullable ",[211,626,627],{},"owner_id","/",[211,630,631],{},"owner_type"," plus a ",[211,634,635],{},"customer_id"," column. The webhook writes the row with ",[211,638,639],{},"owner_id = null"," but populates ",[211,642,635],{}," with the Vatly customer id (",[211,645,646],{},"cus_…",").",[543,649,650,651,654],{},"When the visitor returns on the checkout-success redirect, call ",[211,652,653],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[656,657,659,660,663],"h3",{"id":658},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[211,661,662],{},"{CHECKOUT_ID}"," placeholder",[196,665,666,667,670,671,673,674,677],{},"The one hard part of guest checkout is: ",[593,668,669],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[211,672,646],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[593,675,676],{},"isn't"," in the session).",[196,679,680,681,683],{},"Instead, put the literal ",[211,682,662],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[205,685,687],{"className":207,"code":686,"language":209,"meta":109,"style":109},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[211,688,689,709,755,788,809],{"__ignoreMap":109},[214,690,691,693,695,697,700,703,706],{"class":216,"line":217},[214,692,228],{"class":227},[214,694,232],{"class":231},[214,696,235],{"class":227},[214,698,699],{"class":238},"checkout",[214,701,702],{"class":227},"()->",[214,704,705],{"class":238},"create",[214,707,708],{"class":227},"(\n",[214,710,711,715,718,721,723,725,727,729,731,734,736,739,741,744,746,748,752],{"class":216,"line":224},[214,712,714],{"class":713},"sBMFI","    items",[214,716,717],{"class":227},":",[214,719,720],{"class":227}," [[",[214,722,282],{"class":227},[214,724,330],{"class":278},[214,726,282],{"class":227},[214,728,285],{"class":227},[214,730,288],{"class":227},[214,732,733],{"class":278},"product_abc123",[214,735,282],{"class":227},[214,737,738],{"class":227},",",[214,740,288],{"class":227},[214,742,743],{"class":278},"quantity",[214,745,282],{"class":227},[214,747,285],{"class":227},[214,749,751],{"class":750},"sbssI"," 1",[214,753,754],{"class":227},"]],\n",[214,756,757,760,762,765,768,770,773,775,778,781,784,786],{"class":216,"line":245},[214,758,759],{"class":713},"    redirectUrlSuccess",[214,761,717],{"class":227},[214,763,764],{"class":238}," route",[214,766,767],{"class":227},"(",[214,769,282],{"class":227},[214,771,772],{"class":278},"vatly.return",[214,774,282],{"class":227},[214,776,777],{"class":227},")",[214,779,780],{"class":227},".'",[214,782,783],{"class":278},"?checkout_id={CHECKOUT_ID}",[214,785,282],{"class":227},[214,787,296],{"class":227},[214,789,790,793,795,797,799,801,804,806],{"class":216,"line":252},[214,791,792],{"class":713},"    redirectUrlCanceled",[214,794,717],{"class":227},[214,796,764],{"class":238},[214,798,767],{"class":227},[214,800,282],{"class":227},[214,802,803],{"class":278},"billing",[214,805,282],{"class":227},[214,807,808],{"class":227},"),\n",[214,810,811],{"class":216,"line":258},[214,812,813],{"class":227},");\n",[196,815,816,817,717],{},"On the return route, hand the request to ",[211,818,653],{},[205,820,822],{"className":207,"code":821,"language":209,"meta":109,"style":109},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[211,823,824,849,854,859,864,887,891,916],{"__ignoreMap":109},[214,825,826,830,833,836,838,841,843,846],{"class":216,"line":217},[214,827,829],{"class":828},"spNyl","public",[214,831,832],{"class":828}," function",[214,834,835],{"class":238}," return",[214,837,767],{"class":227},[214,839,840],{"class":713},"Request",[214,842,323],{"class":227},[214,844,845],{"class":231},"request",[214,847,848],{"class":227},")\n",[214,850,851],{"class":216,"line":224},[214,852,853],{"class":227},"{\n",[214,855,856],{"class":216,"line":245},[214,857,858],{"class":220},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[214,860,861],{"class":216,"line":252},[214,862,863],{"class":220},"    // (if there is one) claims it for the authenticated user.\n",[214,865,866,869,871,873,875,877,880,883,885],{"class":216,"line":258},[214,867,868],{"class":227},"    $",[214,870,845],{"class":231},[214,872,235],{"class":227},[214,874,232],{"class":238},[214,876,702],{"class":227},[214,878,879],{"class":238},"claimVatlyCustomerFromReturn",[214,881,882],{"class":227},"($",[214,884,845],{"class":231},[214,886,813],{"class":227},[214,888,889],{"class":216,"line":272},[214,890,249],{"emptyLinePlaceholder":248},[214,892,893,897,900,902,905,907,909,912,914],{"class":216,"line":299},[214,894,896],{"class":895},"s7zQu","    return",[214,898,899],{"class":238}," redirect",[214,901,702],{"class":227},[214,903,904],{"class":238},"route",[214,906,767],{"class":227},[214,908,282],{"class":227},[214,910,911],{"class":278},"dashboard",[214,913,282],{"class":227},[214,915,813],{"class":227},[214,917,918],{"class":216,"line":336},[214,919,920],{"class":227},"}\n",[196,922,923,924,927,928,931],{},"It returns ",[211,925,926],{},"true"," when a claim happened and ",[211,929,930],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[205,933,935],{"className":207,"code":934,"language":209,"meta":109,"style":109},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[211,936,937],{"__ignoreMap":109},[214,938,939,941,943,945,947,949,951,953,955,958,960,963],{"class":216,"line":217},[214,940,228],{"class":227},[214,942,232],{"class":231},[214,944,235],{"class":227},[214,946,879],{"class":238},[214,948,882],{"class":227},[214,950,845],{"class":231},[214,952,738],{"class":227},[214,954,288],{"class":227},[214,956,957],{"class":278},"cid",[214,959,282],{"class":227},[214,961,962],{"class":227},");",[214,964,965],{"class":220}," // reads ?cid=…\n",[196,967,968,969,972],{},"This is ",[447,970,971],{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[974,975,976,977,980],"note",{},"The checkout id travels in the URL, so it may also appear in the ",[211,978,979],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[196,982,983,984,986,987,990],{},"Under the hood ",[211,985,653],{}," resolves the checkout's customer id via the Vatly API and then runs ",[211,988,989],{},"claimVatlyCustomer()",", which:",[540,992,993,1003,1006],{},[543,994,995,996,999,1000,1002],{},"Binds the Vatly customer id to this host entity via the configured ",[211,997,998],{},"CustomerBindingRepository"," (default impl: writes ",[211,1001,533],{}," on the billable table).",[543,1004,1005],{},"Saves the model.",[543,1007,1008,1009,600,1011,1013,1014,620,1016,1018,1019,1021],{},"Backfills ",[211,1010,631],{},[211,1012,627],{}," on every ",[211,1015,619],{},[211,1017,623],{}," row that carries the same ",[211,1020,635],{}," but had no owner yet.",[196,1023,530,1024,600,1026,1028,1029,1031,1032,1034,1035,1037,1038,1040],{},[211,1025,599],{},[211,1027,603],{}," webhook usually lands ",[593,1030,595],{}," the buyer is redirected back, so those rows already exist (with ",[211,1033,639],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[211,1036,635],{}," finds the binding and writes ",[211,1039,627],{}," directly. Either way the purchase ends up attributed.",[196,1042,1043,1044,1046,1047,1050],{},"If you already hold the ",[211,1045,646],{}," by other means, you can still call ",[211,1048,1049],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[974,1052,1053,1056],{},[447,1054,1055],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[196,1058,1059],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[205,1061,1063],{"className":207,"code":1062,"language":209,"meta":109,"style":109},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[211,1064,1065,1100,1111,1125,1129,1143],{"__ignoreMap":109},[214,1066,1067,1069,1071,1073,1076,1079,1082,1085,1088,1090,1092,1095,1098],{"class":216,"line":217},[214,1068,228],{"class":227},[214,1070,416],{"class":231},[214,1072,419],{"class":227},[214,1074,1075],{"class":238}," app",[214,1077,1078],{"class":227},"(\\",[214,1080,1081],{"class":231},"Vatly",[214,1083,1084],{"class":227},"\\",[214,1086,1087],{"class":231},"Fluent",[214,1089,1084],{"class":227},[214,1091,1081],{"class":713},[214,1093,1094],{"class":227},"::",[214,1096,1097],{"class":750},"class",[214,1099,848],{"class":227},[214,1101,1102,1105,1108],{"class":216,"line":224},[214,1103,1104],{"class":227},"    ->",[214,1106,1107],{"class":238},"customers",[214,1109,1110],{"class":227},"()\n",[214,1112,1113,1115,1118,1120,1123],{"class":216,"line":245},[214,1114,1104],{"class":227},[214,1116,1117