ly if needed.",[200,201,203],"h2",{"id":202},"creating-a-customer","Creating a customer",[205,206,210],"pre",{"className":207,"code":208,"language":209,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","// Create a Vatly customer for this user\n$user->createAsVatlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[211,212,213,222,243,250,256,270,297,334],"code",{"__ignoreMap":109},[214,215,218],"span",{"class":216,"line":217},"line",1,[214,219,221],{"class":220},"sHwdD","// Create a Vatly customer for this user\n",[214,223,225,229,233,236,240],{"class":216,"line":224},2,[214,226,228],{"class":227},"sMK4o","$",[214,230,232],{"class":231},"sTEyZ","user",[214,234,235],{"class":227},"->",[214,237,239],{"class":238},"s2Zo4","createAsVatlyCustomer",[214,241,242],{"class":227},"();\n",[214,244,246],{"class":216,"line":245},3,[214,247,249],{"emptyLinePlaceholder":248},true,"\n",[214,251,253],{"class":216,"line":252},4,[214,254,255],{"class":220},"// Create with extra data\n",[214,257,259,261,263,265,267],{"class":216,"line":258},5,[214,260,228],{"class":227},[214,262,232],{"class":231},[214,264,235],{"class":227},[214,266,239],{"class":238},[214,268,269],{"class":227},"([\n",[214,271,273,276,280,283,286,289,292,294],{"class":216,"line":272},6,[214,274,275],{"class":227},"    '",[214,277,279],{"class":278},"sfazB","locale",[214,281,282],{"class":227},"'",[214,284,285],{"class":227}," =>",[214,287,288],{"class":227}," '",[214,290,291],{"class":278},"nl_NL",[214,293,282],{"class":227},[214,295,296],{"class":227},",\n",[214,298,300,302,305,307,309,312,314,317,319,321,324,326,328,331],{"class":216,"line":299},7,[214,301,275],{"class":227},[214,303,304],{"class":278},"metadata",[214,306,282],{"class":227},[214,308,285],{"class":227},[214,310,311],{"class":227}," [",[214,313,282],{"class":227},[214,315,316],{"class":278},"internal_id",[214,318,282],{"class":227},[214,320,285],{"class":227},[214,322,323],{"class":227}," $",[214,325,232],{"class":231},[214,327,235],{"class":227},[214,329,330],{"class":231},"id",[214,332,333],{"class":227},"],\n",[214,335,337],{"class":216,"line":336},8,[214,338,339],{"class":227},"]);\n",[200,341,343],{"id":342},"checking-customer-status","Checking customer status",[205,345,347],{"className":207,"code":346,"language":209,"meta":109,"style":109},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[211,348,349,354,371,375,380],{"__ignoreMap":109},[214,350,351],{"class":216,"line":217},[214,352,353],{"class":220},"// Check if the user has a Vatly customer ID\n",[214,355,356,358,360,362,365,368],{"class":216,"line":224},[214,357,228],{"class":227},[214,359,232],{"class":231},[214,361,235],{"class":227},[214,363,364],{"class":238},"hasVatlyId",[214,366,367],{"class":227},"();",[214,369,370],{"class":220}," // bool\n",[214,372,373],{"class":216,"line":245},[214,374,249],{"emptyLinePlaceholder":248},[214,376,377],{"class":216,"line":252},[214,378,379],{"class":220},"// Get the Vatly customer ID\n",[214,381,382,384,386,388,391,393],{"class":216,"line":258},[214,383,228],{"class":227},[214,385,232],{"class":231},[214,387,235],{"class":227},[214,389,390],{"class":238},"getVatlyId",[214,392,367],{"class":227},[214,394,395],{"class":220}," // string|null\n",[200,397,399],{"id":398},"retrieving-customer-data","Retrieving customer data",[205,401,403],{"className":207,"code":402,"language":209,"meta":109,"style":109},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[211,404,405,410],{"__ignoreMap":109},[214,406,407],{"class":216,"line":217},[214,408,409],{"class":220},"// Get the full customer object from the Vatly API\n",[214,411,412,414,417,420,422,424,426,429],{"class":216,"line":224},[214,413,228],{"class":227},[214,415,416],{"class":231},"customer ",[214,418,419],{"class":227},"=",[214,421,323],{"class":227},[214,423,232],{"class":231},[214,425,235],{"class":227},[214,427,428],{"class":238},"asVatlyCustomer",[214,430,242],{"class":227},[200,432,434],{"id":433},"updating-customer-identity","Updating customer identity",[196,436,437,438,441,442,445,446,450],{},"Update the customer's ",[211,439,440],{},"name"," and/or ",[211,443,444],{},"email"," at Vatly (both optional — send\nwhichever changed). Billing-address details (company name, tax id, street, …)\nare ",[447,448,449],"strong",{},"not"," editable here; send the customer through the hosted billing-update\nflow for those.",[205,452,454],{"className":207,"code":453,"language":209,"meta":109,"style":109},"$customer = $user->updateVatlyCustomer([\n    'name' => 'Jane Doe',\n    'email' => 'jane@example.com',\n]);\n",[211,455,456,475,494,513],{"__ignoreMap":109},[214,457,458,460,462,464,466,468,470,473],{"class":216,"line":217},[214,459,228],{"class":227},[214,461,416],{"class":231},[214,463,419],{"class":227},[214,465,323],{"class":227},[214,467,232],{"class":231},[214,469,235],{"class":227},[214,471,472],{"class":238},"updateVatlyCustomer",[214,474,269],{"class":227},[214,476,477,479,481,483,485,487,490,492],{"class":216,"line":224},[214,478,275],{"class":227},[214,480,440],{"class":278},[214,482,282],{"class":227},[214,484,285],{"class":227},[214,486,288],{"class":227},[214,488,489],{"class":278},"Jane Doe",[214,491,282],{"class":227},[214,493,296],{"class":227},[214,495,496,498,500,502,504,506,509,511],{"class":216,"line":245},[214,497,275],{"class":227},[214,499,444],{"class":278},[214,501,282],{"class":227},[214,503,285],{"class":227},[214,505,288],{"class":227},[214,507,508],{"class":278},"jane@example.com",[214,510,282],{"class":227},[214,512,296],{"class":227},[214,514,515],{"class":216,"line":252},[214,516,339],{"class":227},[196,518,519,520,523],{},"Throws ",[211,521,522],{},"NoVatlyCustomerException"," if the user has no Vatly customer yet.",[200,525,527],{"id":526},"customer-portal","Customer portal",[196,529,530],{},"Vatly hosts a self-service customer portal where a customer manages their own billing — payment method, invoices, subscription self-service. Generate a single-use entry link for the current user and redirect to it:",[205,532,534],{"className":207,"code":533,"language":209,"meta":109,"style":109},"// The one-liner: redirect to the hosted portal\nreturn redirect($user->vatlyPortalUrl());\n\n// Render a \"back to your app\" link inside the portal\nreturn redirect($user->vatlyPortalUrl(returnUrl: route('billing')));\n",[211,535,536,541,563,567,572],{"__ignoreMap":109},[214,537,538],{"class":216,"line":217},[214,539,540],{"class":220},"// The one-liner: redirect to the hosted portal\n",[214,542,543,547,550,553,555,557,560],{"class":216,"line":224},[214,544,546],{"class":545},"s7zQu","return",[214,548,549],{"class":238}," redirect",[214,551,552],{"class":227},"($",[214,554,232],{"class":231},[214,556,235],{"class":227},[214,558,559],{"class":238},"vatlyPortalUrl",[214,561,562],{"class":227},"());\n",[214,564,565],{"class":216,"line":245},[214,566,249],{"emptyLinePlaceholder":248},[214,568,569],{"class":216,"line":252},[214,570,571],{"class":220},"// Render a \"back to your app\" link inside the portal\n",[214,573,574,576,578,580,582,584,586,589,593,596,599,601,603,606,608],{"class":216,"line":258},[214,575,546],{"class":545},[214,577,549],{"class":238},[214,579,552],{"class":227},[214,581,232],{"class":231},[214,583,235],{"class":227},[214,585,559],{"class":238},[214,587,588],{"class":227},"(",[214,590,592],{"class":591},"sBMFI","returnUrl",[214,594,595],{"class":227},":",[214,597,598],{"class":238}," route",[214,600,588],{"class":227},[214,602,282],{"class":227},[214,604,605],{"class":278},"billing",[214,607,282],{"class":227},[214,609,610],{"class":227},")));\n",[196,612,613,614,595],{},"Need the expiry as well as the URL, call ",[211,615,616],{},"vatlyPortalSession()",[205,618,620],{"className":207,"code":619,"language":209,"meta":109,"style":109},"$session = $user->vatlyPortalSession(returnUrl: route('billing'));\n\n$session->url;        // single-use HTTPS entry link\n$session->expiresAt;  // ISO 8601 — the link expires after ~15 minutes\n",[211,621,622,659,663,681],{"__ignoreMap":109},[214,623,624,626,629,631,633,635,637,640,642,644,646,648,650,652,654,656],{"class":216,"line":217},[214,625,228],{"class":227},[214,627,628],{"class":231},"session ",[214,630,419],{"class":227},[214,632,323],{"class":227},[214,634,232],{"class":231},[214,636,235],{"class":227},[214,638,639],{"class":238},"vatlyPortalSession",[214,641,588],{"class":227},[214,643,592],{"class":591},[214,645,595],{"class":227},[214,647,598],{"class":238},[214,649,588],{"class":227},[214,651,282],{"class":227},[214,653,605],{"class":278},[214,655,282],{"class":227},[214,657,658],{"class":227},"));\n",[214,660,661],{"class":216,"line":224},[214,662,249],{"emptyLinePlaceholder":248},[214,664,665,667,670,672,675,678],{"class":216,"line":245},[214,666,228],{"class":227},[214,668,669],{"class":231},"session",[214,671,235],{"class":227},[214,673,674],{"class":231},"url",[214,676,677],{"class":227},";",[214,679,680],{"class":220},"        // single-use HTTPS entry link\n",[214,682,683,685,687,689,692,694],{"class":216,"line":252},[214,684,228],{"class":227},[214,686,669],{"class":231},[214,688,235],{"class":227},[214,690,691],{"class":231},"expiresAt",[214,693,677],{"class":227},[214,695,696],{"class":220},"  // ISO 8601 — the link expires after ~15 minutes\n",[196,698,699,700,703,704,523],{},"The link is locked to this customer, expires after roughly 15 minutes, and can be used once. It is credential-bearing, so ",[447,701,702],{},"never cache or log it"," — generate a fresh one each time you send the customer to the portal. Both helpers throw ",[211,705,522],{},[196,707,708,709,712,713,716],{},"Both are available under the same names on the coexistence-friendly ",[211,710,711],{},"VatlyBillable"," trait (they already carry the ",[211,714,715],{},"vatly"," prefix, so there's no collision with another Cashier-style biller).",[196,718,719],{},"Under the hood these delegate to the framework-agnostic customer handle, which you can also reach directly for a customer id you already hold:",[205,721,723],{"className":207,"code":722,"language":209,"meta":109,"style":109},"use Vatly\\Laravel\\Facades\\Vatly;\n\n$session = Vatly::customer($vatlyCustomerId)->portalSession(['returnUrl' => route('billing')]);\n",[211,724,725,752,756],{"__ignoreMap":109},[214,726,727,731,734,737,739,741,744,746,749],{"class":216,"line":217},[214,728,730],{"class":729},"sbssI","use",[214,732,733],{"class":231}," Vatly",[214,735,736],{"class":227},"\\",[214,738,152],{"class":231},[214,740,736],{"class":227},[214,742,743],{"class":231},"Facades",[214,745,736],{"class":227},[214,747,748],{"class":231},"Vatly",[214,750,751],{"class":227},";\n",[214,753,754],{"class":216,"line":224},[214,755,249],{"emptyLinePlaceholder":248},[214,757,758,760,762,764,766,769,772,774,777,780,783,786,788,790,792,794,796,798,800,802,804],{"class":216,"line":245},[214,759,228],{"class":227},[214,761,628],{"class":231},[214,763,419],{"class":227},[214,765,733],{"class":591},[214,767,768],{"class":227},"::",[214,770,771],{"class":238},"customer",[214,773,552],{"class":227},[214,775,776],{"class":231},"vatlyCustomerId",[214,778,779],{"class":227},")->",[214,781,782],{"class":238},"portalSession",[214,784,785],{"class":227},"([",[214,787,282],{"class":227},[214,789,592],{"class":278},[214,791,282],{"class":227},[214,793,285],{"class":227},[214,795,598],{"class":238},[214,797,588],{"class":227},[214,799,282],{"class":227},[214,801,605],{"class":278},[214,803,282],{"class":227},[214,805,806],{"class":227},")]);\n",[200,808,810],{"id":809},"how-it-works","How it works",[196,812,813,814,817,818,821],{},"The ",[211,815,816],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[211,819,820],{},"createAsVatlyCustomer()",", it:",[823,824,825,833,839],"ol",{},[826,827,828,829,832],"li",{},"Sends a ",[211,830,831],{},"POST"," request to the Vatly API to create a customer",[826,834,835,836,838],{},"Stores the returned customer ID in the ",[211,837,816],{}," column",[826,840,841],{},"Returns the customer response",[196,843,844,845,847,848,850,851,854],{},"If the user already has a ",[211,846,816],{},", calling ",[211,849,820],{}," will throw a ",[211,852,853],{},"CustomerAlreadyBoundException",".",[200,856,858],{"id":857},"automatic-customer-creation","Automatic customer creation",[196,860,861],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[196,863,864,865,867],{},"This means you don't need to call ",[211,866,820],{}," before starting a checkout — just redirect the user directly.",[200,869,871],{"id":870},"anonymous-guest-checkouts","Anonymous / guest checkouts",[196,873,874,875,879,880,883,884,887,888,891],{},"A common flow: a visitor buys ",[876,877,878],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[211,881,882],{},"order.paid"," / ",[211,885,886],{},"subscription.started"," webhooks, and your app has no ",[211,889,890],{},"User"," row to attribute the purchase to yet.",[196,893,894],{},"The package handles this without losing data:",[896,897,898,931],"ul",{},[826,899,813,900,903,904,907,908,911,912,915,916,919,920,923,924,926,927,930],{},[211,901,902],{},"vatly_subscriptions"," and ",[211,905,906],{},"vatly_orders"," tables both have a nullable ",[211,909,910],{},"owner_id","/",[211,913,914],{},"owner_type"," plus a ",[211,917,918],{},"customer_id"," column. The webhook writes the row with ",[211,921,922],{},"owner_id = null"," but populates ",[211,925,918],{}," with the Vatly customer id (",[211,928,929],{},"cus_…",").",[826,932,933,934,937],{},"When the visitor returns on the checkout-success redirect, call ",[211,935,936],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[939,940,942,943,946],"h3",{"id":941},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[211,944,945],{},"{CHECKOUT_ID}"," placeholder",[196,948,949,950,953,954,956,957,960],{},"The one hard part of guest checkout is: ",[876,951,952],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[211,955,929],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[876,958,959],{},"isn't"," in the session).",[196,962,963,964,966],{},"Instead, put the literal ",[211,965,945],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[205,968,970],{"className":207,"code":969,"language":209,"meta":109,"style":109},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[211,971,972,992,1035,1066,1086],{"__ignoreMap":109},[214,973,974,976,978,980,983,986,989],{"class":216,"line":217},[214,975,228],{"class":227},[214,977,232],{"class":231},[214,979,235],{"class":227},[214,981,982],{"class":238},"checkout",[214,984,985],{"class":227},"()->",[214,987,988],{"class":238},"create",[214,990,991],{"class":227},"(\n",[214,993,994,997,999,1002,1004,1006,1008,1010,1012,1015,1017,1020,1022,1025,1027,1029,1032],{"class":216,"line":224},[214,995,996],{"class":591},"    items",[214,998,595],{"class":227},[214,1000,1001],{"class":227}," [[",[214,1003,282],{"class":227},[214,1005,330],{"class":278},[214,1007,282],{"class":227},[214,1009,285],{"class":227},[214,1011,288],{"class":227},[214,1013,1014],{"class":278},"product_abc123",[214,1016,282],{"class":227},[214,1018,1019],{"class":227},",",[214,1021,288],{"class":227},[214,1023,1024],{"class":278},"quantity",[214,1026,282],{"class":227},[214,1028,285],{"class":227},[214,1030,1031],{"class":729}," 1",[214,1033,1034],{"class":227},"]],\n",[214,1036,1037,1040,1042,1044,1046,1048,1051,1053,1056,1059,1062,1064],{"class":216,"line":245},[214,1038,1039],{"class":591},"    redirectUrlSuccess",[214,1041,595],{"class":227},[214,1043,598],{"class":238},[214,1045,588],{"class":227},[214,1047,282],{"class":227},[214,1049,1050],{"class":278},"vatly.return",[214,1052,282],{"class":227},[214,1054,1055],{"class":227},")",[214,1057,1058],{"class":227},".'",[214,1060,1061],{"class":278},"?checkout_id={CHECKOUT_ID}",[214,1063,282],{"class":227},[214,1065,296],{"class":227},[214,1067,1068,1071,1073,1075,1077,1079,1081,1083],{"class":216,"line":252},[214,1069,1070],{"class":591},"    redirectUrlCanceled",[214,1072,595],{"class":227},[214,1074,598],{"class":238},[214,1076,588],{"class":227},[214,1078,282],{"class":227},[214,1080,605],{"class":278},[214,1082,282],{"class":227},[214,1084,1085],{"class":227},"),\n",[214,1087,1088],{"class":216,"line":258},[214,1089,1090],{"class":227},");\n",[196,1092,1093,1094,595],{},"On the return route, hand the request to ",[211,1095,936],{},[205,1097,1099],{"className":207,"code":1098,"language":209,"meta":109,"style":109},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[211,1100,1101,1126,1131,1136,1141,1163,1167,1190],{"__ignoreMap":109},[214,1102,1103,1107,1110,1113,1115,1118,1120,1123],{"class":216,"line":217},[214,1104,1106],{"class":1105},"spNyl","public",[214,1108,1109],{"class":1105}," function",[214,1111,1112],{"class":238}," return",[214,1114,588],{"class":227},[214,1116,1117],{"class":591},"Request",[214,1119,323],{"class":227},[214,1121,1122],{"class":231},"request",[214,1124,1125],{"class":227},")\n",[214,1127,1128],{"class":216,"line":224},[214,1129,1130],{"class":227},"{\n",[214,1132,1133],{"class":216,"line":245},[214,1134,1135],{"class":220},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[214,1137,1138],{"class":216,"line":252},[214,1139,1140],{"class":220},"    // (if there is one) claims it for the authenticated user.\n",[214,1142,1143,1146,1148,1150,1152,1154,1157,1159,1161],{"class":216,"line":258},[214,1144,1145],{"class":227},"    $",[214,1147,1122],{"class":231},[214,1149,235],{"class":227},[214,1151,232],{"class":238},[214,1153,985],{"class":227},[214,1155,1156],{"class":238},"claimVatlyCustomerFromReturn",[214,1158,552],{"class":227},[214,1160,1122],{"class":231},[214,1162,1090],{"class":227},[214,1164,1165],{"class":216,"line":272},[214,1166,249],{"emptyLinePlaceholder":248},[214,1168,1169,1172,1174,1176,1179,1181,1183,1186,1188],{"class":216,"line":299},[214,1170,1171],{"class":545},"    return",[214,1173,549],{"class":238},[214,1175,985],{"class":227},[214,1177,1178],{"class":238},"route",[214,1180,588],{"class":227},[214,1182,282],{"class":227},[214,1184,1185],{"class":278},"dashboard",[214,1187,282],{"class":227},[214,1189,1090],{"class":227},[214,1191,1192],{"class":216,"line":336},[214,1193,1194],{"class":227},"}\n",[196,1196,1197,1198,1201,1202,1205],{},"It returns ",[211,1199,1200],{},"true"," when a claim happened and ",[211,1203,1204],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[205,1207,1209],{"className":207,"code":1208,"language":209,"meta":109,"style":109},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[211,1210,1211],{"__ignoreMap":109},[214,1212,1213,1215,1217,1219,1221,1223,1225,1227,1229,1232,1234,1237],{"class":216,"line":217},[214,1214,228],{"class":227},[214,1216,232],{"class":231},[214,1218,235],{"class":227},[214,1220,1156],{"class":238},[214,1222,552],{"class":227},[214,1224,1122],{"class":231},[214,1226,1019],{"class":227},[214,1228,288],{"class":227},[214,1230,1231],{"class":278},"cid",[214,1233,282],{"class":227},[214,1235,1236],{"class":227},");",[214,1238,1239],{"class":220}," // reads ?cid=…\n",[196,1241,1242,1243,1246],{},"This is ",[447,1244,1245],{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[1248,1249,1250,1251,1254],"note",{},"The checkout id travels in the URL, so it may also appear in the ",[211,1252,1253],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[196,1256,1257,1258,1260,1261,1264],{},"Under the hood ",[211,1259,936],{}," resolves the checkout's customer id via the Vatly API and then runs ",[211,1262,1263],{},"claimVatlyCustomer()",", which:",[823,1266,1267,1277,1280],{},[826,1268,1269,1270,1273,1274,1276],{},"Binds the Vatly customer id to this host entity via the configured ",[211,1271,1272],{},"CustomerBindingRepository"," (default impl: writes ",[211,1275,816],{}," on the billable table).",[826,1278,1279],{},"Saves the model.",[826,1281,1282,1283,883,1285,1287,1288,903,1290,1292,1293,1295],{},"Backfills ",[211,1284,914],{},[211,1286,910],{}," on every ",[211,1289,902],{},[211,1291,906],{}," row that carries the same ",[211,1294,918],{}," but had no owner yet.",[196,1297,813,1298,883,1300,1302,1303,1305,1306,1308,1309,1311,1312,1314],{},[211,1299,882],{},[211,1301,886],{}," webhook usually lands ",[876,1304,878],{}," the buyer is redirected back, so those rows already exist (with ",[211,1307,922],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[211,1310,918],{}," finds the binding and writes ",[211,1313,910],{}," directly. Either way the purchase ends up attributed.",[196,1316,1317,1318,1320,1321,1324],{},"If you already hold the ",[211,1319,929],{}," by other means, you can still call ",[211,1322,1323],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[1248,1326,1327,1330],{},[447,1328,1329],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[196,1332,1333],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[205,1335,1337],{"className":207,"code":1336,"language":209,"meta":109,"style":109},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[211,1338,1339,1371,1382,1395,1399,1411],{"__ignoreMap":109},[214,1340,1341,1343,1345,1347,1350,1353,1355,1357,1360,1362,1364,1366,1369],{"class":216,"line":217},[214,1342,228],{"class":227},[214,1344,416],{"class":231},[214,1346,419],{"class":227},[214,1348,1349],{"class":238}," app",[214,1351,1352],{"class":227},"(\\",[214,1354,748],{"class":231},[214,1356,736],{"class":227},[214,1358,1359],{"class":231},"Fluent",[214,1361,736],{"class":227},[214,1363,748],{"class":591},[214,1365,768],{"class":227},[214,1367,1368],{"class":729},"class",[214,1370,1125],{"class":227},[214,1372,1373,1376,1379],{"class":216,"line":224},[214,1374,1375],{"class":227},"    ->",[214,1377,1378],{"class":238},"customers",[214,1380,1381],{"class":227},"()\n",[214,1383,1384,1386,1389,1391,1393],{"class":216,"line":245},[214,1385,1375],{"class":227},[214,1387,1388],{"class":238},"findByVatlyCustomerId",[214,1390,552],{"class":227},[214,1392,776],{"class":231},[214,1394,1090],{"class":227},[214,1396,1397],{"class":216,"line":252},[214,1398,249],{"emptyLinePlaceholder":248},[214,1400,1401,1403,1405,1407,1409],{"class":216,"line":258},[214,1402,228],{"class":227},[214,1404,771],{"class":231},[214,1406,235],{"class":227},[214,1408,444],{"class":231},[214,1410,751],{"class":227},[214,1412,1413,1415,1417,1419,1421],{"class":216,"line":272},[214,1414,228],{"class":227},[214,1416,771],{"class":231},[214,1418,235],{"class":227},[214,1420,440],{"class":231},[214,1422,751],{"class":227},[1424,1425,1426],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decorat