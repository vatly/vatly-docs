ct from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[444,637,638,643],{"__ignoreMap":442},[447,639,640],{"class":449,"line":450},[447,641,642],{"class":453},"\u002F\u002F Get the full customer object from the Vatly API\n",[447,644,645,647,650,653,655,657,659,662],{"class":449,"line":457},[447,646,461],{"class":460},[447,648,649],{"class":464},"customer ",[447,651,652],{"class":460},"=",[447,654,556],{"class":460},[447,656,465],{"class":464},[447,658,468],{"class":460},[447,660,661],{"class":471},"asVatlyCustomer",[447,663,475],{"class":460},[432,665,667],{"id":666},"updating-customer-identity","Updating customer identity",[428,669,670,671,674,675,678,679,683],{},"Update the customer's ",[444,672,673],{},"name"," and\u002For ",[444,676,677],{},"email"," at Vatly (both optional — send\nwhichever changed). Billing-address details (company name, tax id, street, …)\nare ",[680,681,682],"strong",{},"not"," editable here; send the customer through the hosted billing-update\nflow for those.",[437,685,687],{"className":439,"code":686,"language":441,"meta":442,"style":442},"$customer = $user->updateVatlyCustomer([\n    'name' => 'Jane Doe',\n    'email' => 'jane@example.com',\n]);\n",[444,688,689,708,727,746],{"__ignoreMap":442},[447,690,691,693,695,697,699,701,703,706],{"class":449,"line":450},[447,692,461],{"class":460},[447,694,649],{"class":464},[447,696,652],{"class":460},[447,698,556],{"class":460},[447,700,465],{"class":464},[447,702,468],{"class":460},[447,704,705],{"class":471},"updateVatlyCustomer",[447,707,502],{"class":460},[447,709,710,712,714,716,718,720,723,725],{"class":449,"line":457},[447,711,508],{"class":460},[447,713,673],{"class":511},[447,715,515],{"class":460},[447,717,518],{"class":460},[447,719,521],{"class":460},[447,721,722],{"class":511},"Jane Doe",[447,724,515],{"class":460},[447,726,529],{"class":460},[447,728,729,731,733,735,737,739,742,744],{"class":449,"line":478},[447,730,508],{"class":460},[447,732,677],{"class":511},[447,734,515],{"class":460},[447,736,518],{"class":460},[447,738,521],{"class":460},[447,740,741],{"class":511},"jane@example.com",[447,743,515],{"class":460},[447,745,529],{"class":460},[447,747,748],{"class":449,"line":485},[447,749,572],{"class":460},[428,751,752,753,756],{},"Throws ",[444,754,755],{},"NoVatlyCustomerException"," if the user has no Vatly customer yet.",[432,758,288],{"id":759},"customer-portal",[428,761,762],{},"Vatly hosts a self-service customer portal where a customer manages their own billing — payment method, invoices, subscription self-service. Generate a single-use entry link for the current user and redirect to it:",[437,764,766],{"className":439,"code":765,"language":441,"meta":442,"style":442},"\u002F\u002F The one-liner: redirect to the hosted portal\nreturn redirect($user->vatlyPortalUrl());\n\n\u002F\u002F Render a \"back to your app\" link inside the portal\nreturn redirect($user->vatlyPortalUrl(returnUrl: route('billing')));\n",[444,767,768,773,795,799,804],{"__ignoreMap":442},[447,769,770],{"class":449,"line":450},[447,771,772],{"class":453},"\u002F\u002F The one-liner: redirect to the hosted portal\n",[447,774,775,779,782,785,787,789,792],{"class":449,"line":457},[447,776,778],{"class":777},"s7zQu","return",[447,780,781],{"class":471}," redirect",[447,783,784],{"class":460},"($",[447,786,465],{"class":464},[447,788,468],{"class":460},[447,790,791],{"class":471},"vatlyPortalUrl",[447,793,794],{"class":460},"());\n",[447,796,797],{"class":449,"line":478},[447,798,482],{"emptyLinePlaceholder":481},[447,800,801],{"class":449,"line":485},[447,802,803],{"class":453},"\u002F\u002F Render a \"back to your app\" link inside the portal\n",[447,805,806,808,810,812,814,816,818,821,825,828,831,833,835,838,840],{"class":449,"line":491},[447,807,778],{"class":777},[447,809,781],{"class":471},[447,811,784],{"class":460},[447,813,465],{"class":464},[447,815,468],{"class":460},[447,817,791],{"class":471},[447,819,820],{"class":460},"(",[447,822,824],{"class":823},"sBMFI","returnUrl",[447,826,827],{"class":460},":",[447,829,830],{"class":471}," route",[447,832,820],{"class":460},[447,834,515],{"class":460},[447,836,837],{"class":511},"billing",[447,839,515],{"class":460},[447,841,842],{"class":460},")));\n",[428,844,845,846,827],{},"Need the expiry as well as the URL, call ",[444,847,848],{},"vatlyPortalSession()",[437,850,852],{"className":439,"code":851,"language":441,"meta":442,"style":442},"$session = $user->vatlyPortalSession(returnUrl: route('billing'));\n\n$session->url;        \u002F\u002F single-use HTTPS entry link\n$session->expiresAt;  \u002F\u002F ISO 8601 — the link expires after ~15 minutes\n",[444,853,854,891,895,913],{"__ignoreMap":442},[447,855,856,858,861,863,865,867,869,872,874,876,878,880,882,884,886,888],{"class":449,"line":450},[447,857,461],{"class":460},[447,859,860],{"class":464},"session ",[447,862,652],{"class":460},[447,864,556],{"class":460},[447,866,465],{"class":464},[447,868,468],{"class":460},[447,870,871],{"class":471},"vatlyPortalSession",[447,873,820],{"class":460},[447,875,824],{"class":823},[447,877,827],{"class":460},[447,879,830],{"class":471},[447,881,820],{"class":460},[447,883,515],{"class":460},[447,885,837],{"class":511},[447,887,515],{"class":460},[447,889,890],{"class":460},"));\n",[447,892,893],{"class":449,"line":457},[447,894,482],{"emptyLinePlaceholder":481},[447,896,897,899,902,904,907,910],{"class":449,"line":478},[447,898,461],{"class":460},[447,900,901],{"class":464},"session",[447,903,468],{"class":460},[447,905,906],{"class":464},"url",[447,908,909],{"class":460},";",[447,911,912],{"class":453},"        \u002F\u002F single-use HTTPS entry link\n",[447,914,915,917,919,921,924,926],{"class":449,"line":485},[447,916,461],{"class":460},[447,918,901],{"class":464},[447,920,468],{"class":460},[447,922,923],{"class":464},"expiresAt",[447,925,909],{"class":460},[447,927,928],{"class":453},"  \u002F\u002F ISO 8601 — the link expires after ~15 minutes\n",[428,930,931,932,935,936,939,940,756],{},"The link is locked to this customer ",[680,933,934],{},"and to the storefront your configured Vatly API token is issued for"," — the customer lands directly in that one storefront's portal, never a storefront picker or any other store. (If your Vatly account has multiple storefronts, each API token mints portal links for its own store.) It expires after roughly 15 minutes and can be used once. It is credential-bearing, so ",[680,937,938],{},"never cache or log it"," — generate a fresh one each time you send the customer to the portal. Both helpers throw ",[444,941,755],{},[428,943,944,945,948,949,952],{},"Both are available under the same names on the coexistence-friendly ",[444,946,947],{},"VatlyBillable"," trait (they already carry the ",[444,950,951],{},"vatly"," prefix, so there's no collision with another Cashier-style biller).",[428,954,955],{},"Under the hood these delegate to the framework-agnostic customer handle, which you can also reach directly for a customer id you already hold:",[437,957,959],{"className":439,"code":958,"language":441,"meta":442,"style":442},"use Vatly\\Laravel\\Facades\\Vatly;\n\n$session = Vatly::customer($vatlyCustomerId)->portalSession(['returnUrl' => route('billing')]);\n",[444,960,961,988,992],{"__ignoreMap":442},[447,962,963,967,970,973,975,977,980,982,985],{"class":449,"line":450},[447,964,966],{"class":965},"sbssI","use",[447,968,969],{"class":464}," Vatly",[447,971,972],{"class":460},"\\",[447,974,181],{"class":464},[447,976,972],{"class":460},[447,978,979],{"class":464},"Facades",[447,981,972],{"class":460},[447,983,984],{"class":464},"Vatly",[447,986,987],{"class":460},";\n",[447,989,990],{"class":449,"line":457},[447,991,482],{"emptyLinePlaceholder":481},[447,993,994,996,998,1000,1002,1005,1008,1010,1013,1016,1019,1022,1024,1026,1028,1030,1032,1034,1036,1038,1040],{"class":449,"line":478},[447,995,461],{"class":460},[447,997,860],{"class":464},[447,999,652],{"class":460},[447,1001,969],{"class":823},[447,1003,1004],{"class":460},"::",[447,1006,1007],{"class":471},"customer",[447,1009,784],{"class":460},[447,1011,1012],{"class":464},"vatlyCustomerId",[447,1014,1015],{"class":460},")->",[447,1017,1018],{"class":471},"portalSession",[447,1020,1021],{"class":460},"([",[447,1023,515],{"class":460},[447,1025,824],{"class":511},[447,1027,515],{"class":460},[447,1029,518],{"class":460},[447,1031,830],{"class":471},[447,1033,820],{"class":460},[447,1035,515],{"class":460},[447,1037,837],{"class":511},[447,1039,515],{"class":460},[447,1041,1042],{"class":460},")]);\n",[432,1044,1046],{"id":1045},"how-it-works","How it works",[428,1048,1049,1050,1053,1054,1057],{},"The ",[444,1051,1052],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[444,1055,1056],{},"createAsVatlyCustomer()",", it:",[1059,1060,1061,1069,1075],"ol",{},[1062,1063,1064,1065,1068],"li",{},"Sends a ",[444,1066,1067],{},"POST"," request to the Vatly API to create a customer",[1062,1070,1071,1072,1074],{},"Stores the returned customer ID in the ",[444,1073,1052],{}," column",[1062,1076,1077],{},"Returns the customer response",[428,1079,1080,1081,1083,1084,1086,1087,1090],{},"If the user already has a ",[444,1082,1052],{},", calling ",[444,1085,1056],{}," will throw a ",[444,1088,1089],{},"CustomerAlreadyBoundException",".",[432,1092,1094],{"id":1093},"automatic-customer-creation","Automatic customer creation",[428,1096,1097],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[428,1099,1100,1101,1103],{},"This means you don't need to call ",[444,1102,1056],{}," before starting a checkout — just redirect the user directly.",[432,1105,1107],{"id":1106},"anonymous-guest-checkouts","Anonymous \u002F guest checkouts",[428,1109,1110,1111,1115,1116,1119,1120,1123,1124,1127],{},"A common flow: a visitor buys ",[1112,1113,1114],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[444,1117,1118],{},"order.paid"," \u002F ",[444,1121,1122],{},"subscription.started"," webhooks, and your app has no ",[444,1125,1126],{},"User"," row to attribute the purchase to yet.",[428,1129,1130],{},"The package handles this without losing data:",[1132,1133,1134,1167],"ul",{},[1062,1135,1049,1136,1139,1140,1143,1144,1147,1148,1151,1152,1155,1156,1159,1160,1162,1163,1166],{},[444,1137,1138],{},"vatly_subscriptions"," and ",[444,1141,1142],{},"vatly_orders"," tables both have a nullable ",[444,1145,1146],{},"owner_id","\u002F",[444,1149,1150],{},"owner_type"," plus a ",[444,1153,1154],{},"customer_id"," column. The webhook writes the row with ",[444,1157,1158],{},"owner_id = null"," but populates ",[444,1161,1154],{}," with the Vatly customer id (",[444,1164,1165],{},"cus_…",").",[1062,1168,1169,1170,1173],{},"When the visitor returns on the checkout-success redirect, call ",[444,1171,1172],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[1175,1176,1178,1179,1182],"h3",{"id":1177},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[444,1180,1181],{},"{CHECKOUT_ID}"," placeholder",[428,1184,1185,1186,1189,1190,1192,1193,1196],{},"The one hard part of guest checkout is: ",[1112,1187,1188],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[444,1191,1165],{}," through a session or cookie yourself (that approach breaks under multi-tab \u002F double-click — the last write wins, and the buyer may finish the checkout that ",[1112,1194,1195],{},"isn't"," in the session).",[428,1198,1199,1200,1202],{},"Instead, put the literal ",[444,1201,1181],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[437,1204,1206],{"className":439,"code":1205,"language":441,"meta":442,"style":442},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[444,1207,1208,1228,1271,1302,1322],{"__ignoreMap":442},[447,1209,1210,1212,1214,1216,1219,1222,1225],{"class":449,"line":450},[447,1211,461],{"class":460},[447,1213,465],{"class":464},[447,1215,468],{"class":460},[447,1217,1218],{"class":471},"checkout",[447,1220,1221],{"class":460},"()->",[447,1223,1224],{"class":471},"create",[447,1226,1227],{"class":460},"(\n",[447,1229,1230,1233,1235,1238,1240,1242,1244,1246,1248,1251,1253,1256,1258,1261,1263,1265,1268],{"class":449,"line":457},[447,1231,1232],{"class":823},"    items",[447,1234,827],{"class":460},[447,1236,1237],{"class":460}," [[",[447,1239,515],{"class":460},[447,1241,563],{"class":511},[447,1243,515],{"class":460},[447,1245,518],{"class":460},[447,1247,521],{"class":460},[447,1249,1250],{"class":511},"product_abc123",[447,1252,515],{"class":460},[447,1254,1255],{"class":460},",",[447,1257,521],{"class":460},[447,1259,1260],{"class":511},"quantity",[447,1262,515],{"class":460},[447,1264,518],{"class":460},[447,1266,1267],{"class":965}," 1",[447,1269,1270],{"class":460},"]],\n",[447,1272,1273,1276,1278,1280,1282,1284,1287,1289,1292,1295,1298,1300],{"class":449,"line":478},[447,1274,1275],{"class":823},"    redirectUrlSuccess",[447,1277,827],{"class":460},[447,1279,830],{"class":471},[447,1281,820],{"class":460},[447,1283,515],{"class":460},[447,1285,1286],{"class":511},"vatly.return",[447,1288,515],{"class":460},[447,1290,1291],{"class":460},")",[447,1293,1294],{"class":460},".'",[447,1296,1297],{"class":511},"?checkout_id={CHECKOUT_ID}",[447,1299,515],{"class":460},[447,1301,529],{"class":460},[447,1303,1304,1307,1309,1311,1313,1315,1317,1319],{"class":449,"line":485},[447,1305,1306],{"class":823},"    redirectUrlCanceled",[447,1308,827],{"class":460},[447,1310,830],{"class":471},[447,1312,820],{"class":460},[447,1314,515],{"class":460},[447,1316,837],{"class":511},[447,1318,515],{"class":460},[447,1320,1321],{"class":460},"),\n",[447,1323,1324],{"class":449,"line":491},[447,1325,1326],{"class":460},");\n",[428,1328,1329,1330,827],{},"On the return route, hand the request to ",[444,1331,1172],{},[437,1333,1335],{"className":439,"code":1334,"language":441,"meta":442,"style":442},"public function return(Request $request)\n{\n    \u002F\u002F Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    \u002F\u002F (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[444,1336,1337,1362,1367,1372,1377,1399,1403,1426],{"__ignoreMap":442},[447,1338,1339,1343,1346,1349,1351,1354,1356,1359],{"class":449,"line":450},[447,1340,1342],{"class":1341},"spNyl","public",[447,1344,1345],{"class":1341}," function",[447,1347,1348],{"class":471}," return",[447,1350,820],{"class":460},[447,1352,1353],{"class":823},"Request",[447,1355,556],{"class":460},[447,1357,1358],{"class":464},"request",[447,1360,1361],{"class":460},")\n",[447,1363,1364],{"class":449,"line":457},[447,1365,1366],{"class":460},"{\n",[447,1368,1369],{"class":449,"line":478},[447,1370,1371],{"class":453},"    \u002F\u002F Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[447,1373,1374],{"class":449,"line":485},[447,1375,1376],{"class":453},"    \u002F\u002F (if there is one) claims it for the authenticated user.\n",[447,1378,1379,1382,1384,1386,1388,1390,1393,1395,1397],{"class":449,"line":491},[447,1380,1381],{"class":460},"    $",[447,1383,1358],{"class":464},[447,1385,468],{"class":460},[447,1387,465],{"class":471},[447,1389,1221],{"class":460},[447,1391,1392],{"class":471},"claimVatlyCustomerFromReturn",[447,1394,784],{"class":460},[447,1396,1358],{"class":464},[447,1398,1326],{"class":460},[447,1400,1401],{"class":449,"line":505},[447,1402,482],{"emptyLinePlaceholder":481},[447,1404,1405,1408,1410,1412,1415,1417,1419,1422,1424],{"class":449,"line":532},[447,1406,1407],{"class":777},"    return",[447,1409,781],{"class":471},[447,1411,1221],{"class":460},[447,1413,1414],{"class":471},"route",[447,1416,820],{"class":460},[447,1418,515],{"class":460},[447,1420,1421],{"class":511},"dashboard",[447,1423,515],{"class":460},[447,1425,1326],{"class":460},[447,1427,1428],{"class":449,"line":569},[447,1429,1430],{"class":460},"}\n",[428,1432,1433,1434,1437,1438,1441],{},"It returns ",[444,1435,1436],{},"true"," when a claim happened and ",[444,1439,1440],{},"false"," for a missing \u002F unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[437,1443,1445],{"className":439,"code":1444,"language":441,"meta":442,"style":442},"$user->claimVatlyCustomerFromReturn($request, 'cid'); \u002F\u002F reads ?cid=…\n",[444,1446,1447],{"__ignoreMap":442},[447,1448,1449,1451,1453,1455,1457,1459,1461,1463,1465,1468,1470,1473],{"class":449,"line":450},[447,1450,461],{"class":460},[447,1452,465],{"class":464},[447,1454,468],{"class":460},[447,1456,1392],{"class":471},[447,1458,784],{"class":460},[447,1460,1358],{"class":464},[447,1462,1255],{"class":460},[447,1464,521],{"class":460},[447,1466,1467],{"class":511},"cid",[447,1469,515],{"class":460},[447,1471,1472],{"class":460},");",[447,1474,1475],{"class":453}," \u002F\u002F reads ?cid=…\n",[428,1477,1478,1479,1482],{},"This is ",[680,1480,1481],{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[1484,1485,1486,1487,1490],"note",{},"The checkout id travels in the URL, so it may also appear in the ",[444,1488,1489],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[428,1492,1493,1494,1496,1497,1500],{},"Under the hood ",[444,1495,1172],{}," resolves the checkout's customer id via the Vatly API and then runs ",[444,1498,1499],{},"claimVatlyCustomer()",", which:",[1059,1502,1503,1513,1516],{},[1062,1504,1505,1506,1509,1510,1512],{},"Binds the Vatly customer id to this host entity via the configured ",[444,1507,1508],{},"CustomerBindingRepository"," (default impl: writes ",[444,1511,1052],{}," on the billable table).",[1062,1514,1515],{},"Saves the model.",[1062,1517,1518,1519,1119,1521,1523,1524,1139,1526,1528,1529,1531],{},"Backfills ",[444,1520,1150],{},[444,1522,1146],{}," on every ",[444,1525,1138],{},[444,1527,1142],{}," row that carries the same ",[444,1530,1154],{}," but had no owner yet.",[428,1533,1049,1534,1119,1536,1538,1539,1541,1542,1544,1545,1547,1548,1550],{},[444,1535,1118],{},[444,1537,1122],{}," webhook usually lands ",[1112,1540,1114],{}," the buyer is redirected back, so those rows already exist (with ",[444,1543,1158],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[444,1546,1154],{}," finds the binding and writes ",[444,1549,1146],{}," directly. Either way the purchase ends up attributed.",[428,1552,1553,1554,1556,1557,1560],{},"If you already hold the ",[444,1555,1165],{}," by other means, you can still call ",[444,1558,1559],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[1484,1562,1563,1566],{},[680,1564,1565],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[428,1568,1569],{},"Need the email \u002F name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[437,1571,1573],{"cl