06],"span",{"class":204,"line":205},"line",1,[202,207,209],{"class":208},"sHwdD","// Create a Vatly customer for this user\n",[202,211,213,217,221,224,228],{"class":204,"line":212},2,[202,214,216],{"class":215},"sMK4o","$",[202,218,220],{"class":219},"sTEyZ","user",[202,222,223],{"class":215},"->",[202,225,227],{"class":226},"s2Zo4","createAsVatlyCustomer",[202,229,230],{"class":215},"();\n",[202,232,234],{"class":204,"line":233},3,[202,235,237],{"emptyLinePlaceholder":236},true,"\n",[202,239,241],{"class":204,"line":240},4,[202,242,243],{"class":208},"// Create with extra data\n",[202,245,247,249,251,253,255],{"class":204,"line":246},5,[202,248,216],{"class":215},[202,250,220],{"class":219},[202,252,223],{"class":215},[202,254,227],{"class":226},[202,256,257],{"class":215},"([\n",[202,259,261,264,268,271,274,277,280,282],{"class":204,"line":260},6,[202,262,263],{"class":215},"    '",[202,265,267],{"class":266},"sfazB","locale",[202,269,270],{"class":215},"'",[202,272,273],{"class":215}," =>",[202,275,276],{"class":215}," '",[202,278,279],{"class":266},"nl_NL",[202,281,270],{"class":215},[202,283,284],{"class":215},",\n",[202,286,288,290,293,295,297,300,302,305,307,309,312,314,316,319],{"class":204,"line":287},7,[202,289,263],{"class":215},[202,291,292],{"class":266},"metadata",[202,294,270],{"class":215},[202,296,273],{"class":215},[202,298,299],{"class":215}," [",[202,301,270],{"class":215},[202,303,304],{"class":266},"internal_id",[202,306,270],{"class":215},[202,308,273],{"class":215},[202,310,311],{"class":215}," $",[202,313,220],{"class":219},[202,315,223],{"class":215},[202,317,318],{"class":219},"id",[202,320,321],{"class":215},"],\n",[202,323,325],{"class":204,"line":324},8,[202,326,327],{"class":215},"]);\n",[188,329,331],{"id":330},"checking-customer-status","Checking customer status",[193,333,335],{"className":195,"code":334,"language":197,"meta":108,"style":108},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[199,336,337,342,359,363,368],{"__ignoreMap":108},[202,338,339],{"class":204,"line":205},[202,340,341],{"class":208},"// Check if the user has a Vatly customer ID\n",[202,343,344,346,348,350,353,356],{"class":204,"line":212},[202,345,216],{"class":215},[202,347,220],{"class":219},[202,349,223],{"class":215},[202,351,352],{"class":226},"hasVatlyId",[202,354,355],{"class":215},"();",[202,357,358],{"class":208}," // bool\n",[202,360,361],{"class":204,"line":233},[202,362,237],{"emptyLinePlaceholder":236},[202,364,365],{"class":204,"line":240},[202,366,367],{"class":208},"// Get the Vatly customer ID\n",[202,369,370,372,374,376,379,381],{"class":204,"line":246},[202,371,216],{"class":215},[202,373,220],{"class":219},[202,375,223],{"class":215},[202,377,378],{"class":226},"getVatlyId",[202,380,355],{"class":215},[202,382,383],{"class":208}," // string|null\n",[188,385,387],{"id":386},"retrieving-customer-data","Retrieving customer data",[193,389,391],{"className":195,"code":390,"language":197,"meta":108,"style":108},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[199,392,393,398],{"__ignoreMap":108},[202,394,395],{"class":204,"line":205},[202,396,397],{"class":208},"// Get the full customer object from the Vatly API\n",[202,399,400,402,405,408,410,412,414,417],{"class":204,"line":212},[202,401,216],{"class":215},[202,403,404],{"class":219},"customer ",[202,406,407],{"class":215},"=",[202,409,311],{"class":215},[202,411,220],{"class":219},[202,413,223],{"class":215},[202,415,416],{"class":226},"asVatlyCustomer",[202,418,230],{"class":215},[188,420,422],{"id":421},"how-it-works","How it works",[184,424,425,426,429,430,433],{},"The ",[199,427,428],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[199,431,432],{},"createAsVatlyCustomer()",", it:",[435,436,437,445,451],"ol",{},[438,439,440,441,444],"li",{},"Sends a ",[199,442,443],{},"POST"," request to the Vatly API to create a customer",[438,446,447,448,450],{},"Stores the returned customer ID in the ",[199,449,428],{}," column",[438,452,453],{},"Returns the customer response",[184,455,456,457,459,460,462,463,466],{},"If the user already has a ",[199,458,428],{},", calling ",[199,461,432],{}," will throw a ",[199,464,465],{},"CustomerAlreadyBoundException",".",[188,468,470],{"id":469},"automatic-customer-creation","Automatic customer creation",[184,472,473],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[184,475,476,477,479],{},"This means you don't need to call ",[199,478,432],{}," before starting a checkout — just redirect the user directly.",[188,481,483],{"id":482},"anonymous-guest-checkouts","Anonymous / guest checkouts",[184,485,486,487,491,492,495,496,499,500,503],{},"A common flow: a visitor buys ",[488,489,490],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[199,493,494],{},"order.paid"," / ",[199,497,498],{},"subscription.started"," webhooks, and your app has no ",[199,501,502],{},"User"," row to attribute the purchase to yet.",[184,505,506],{},"The package handles this without losing data:",[508,509,510,543],"ul",{},[438,511,425,512,515,516,519,520,523,524,527,528,531,532,535,536,538,539,542],{},[199,513,514],{},"vatly_subscriptions"," and ",[199,517,518],{},"vatly_orders"," tables both have a nullable ",[199,521,522],{},"owner_id","/",[199,525,526],{},"owner_type"," plus a ",[199,529,530],{},"customer_id"," column. The webhook writes the row with ",[199,533,534],{},"owner_id = null"," but populates ",[199,537,530],{}," with the Vatly customer id (",[199,540,541],{},"cus_…",").",[438,544,545,546,549,550,552],{},"When the visitor later signs up (or signs in for the first time), call ",[199,547,548],{},"claimVatlyCustomer($vatlyCustomerId)"," on the new ",[199,551,502],{}," to retroactively link the prior rows:",[193,554,556],{"className":195,"code":555,"language":197,"meta":108,"style":108},"// In your signup controller — $vatlyCustomerId typically comes from\n// a query param on the checkout-success URL, a session, or a cookie\n// set during the anonymous checkout flow.\n$user = User::create([...]);\n\n$claimed = $user->claimVatlyCustomer($vatlyCustomerId);\n// $claimed is the number of subscription + order rows that were\n// re-attributed to the user. Subsequent $user->orders / $user->subscriptions\n// return them as you'd expect.\n",[199,557,558,563,568,573,595,599,626,631,636],{"__ignoreMap":108},[202,559,560],{"class":204,"line":205},[202,561,562],{"class":208},"// In your signup controller — $vatlyCustomerId typically comes from\n",[202,564,565],{"class":204,"line":212},[202,566,567],{"class":208},"// a query param on the checkout-success URL, a session, or a cookie\n",[202,569,570],{"class":204,"line":233},[202,571,572],{"class":208},"// set during the anonymous checkout flow.\n",[202,574,575,577,580,582,586,589,592],{"class":204,"line":240},[202,576,216],{"class":215},[202,578,579],{"class":219},"user ",[202,581,407],{"class":215},[202,583,585],{"class":584},"sBMFI"," User",[202,587,588],{"class":215},"::",[202,590,591],{"class":226},"create",[202,593,594],{"class":215},"([...]);\n",[202,596,597],{"class":204,"line":246},[202,598,237],{"emptyLinePlaceholder":236},[202,600,601,603,606,608,610,612,614,617,620,623],{"class":204,"line":260},[202,602,216],{"class":215},[202,604,605],{"class":219},"claimed ",[202,607,407],{"class":215},[202,609,311],{"class":215},[202,611,220],{"class":219},[202,613,223],{"class":215},[202,615,616],{"class":226},"claimVatlyCustomer",[202,618,619],{"class":215},"($",[202,621,622],{"class":219},"vatlyCustomerId",[202,624,625],{"class":215},");\n",[202,627,628],{"class":204,"line":287},[202,629,630],{"class":208},"// $claimed is the number of subscription + order rows that were\n",[202,632,633],{"class":204,"line":324},[202,634,635],{"class":208},"// re-attributed to the user. Subsequent $user->orders / $user->subscriptions\n",[202,637,639],{"class":204,"line":638},9,[202,640,641],{"class":208},"// return them as you'd expect.\n",[184,643,644,647],{},[199,645,646],{},"claimVatlyCustomer()"," does three things:",[435,649,650,660,663],{},[438,651,652,653,656,657,659],{},"Binds the Vatly customer id to this host entity via the configured ",[199,654,655],{},"CustomerBindingRepository"," (default impl: writes ",[199,658,428],{}," on the billable table).",[438,661,662],{},"Saves the model.",[438,664,665,666,495,668,670,671,515,673,675,676,678],{},"Backfills ",[199,667,526],{},[199,669,522],{}," on every ",[199,672,514],{},[199,674,518],{}," row that carries the same ",[199,677,530],{}," but had no owner yet.",[184,680,681],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[193,683,685],{"className":195,"code":684,"language":197,"meta":108,"style":108},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[199,686,687,723,734,747,751,766],{"__ignoreMap":108},[202,688,689,691,693,695,698,701,704,707,710,712,714,716,720],{"class":204,"line":205},[202,690,216],{"class":215},[202,692,404],{"class":219},[202,694,407],{"class":215},[202,696,697],{"class":226}," app",[202,699,700],{"class":215},"(\\",[202,702,703],{"class":219},"Vatly",[202,705,706],{"class":215},"\\",[202,708,709],{"class":219},"Fluent",[202,711,706],{"class":215},[202,713,703],{"class":584},[202,715,588],{"class":215},[202,717,719],{"class":718},"sbssI","class",[202,721,722],{"class":215},")\n",[202,724,725,728,731],{"class":204,"line":212},[202,726,727],{"class":215},"    ->",[202,729,730],{"class":226},"customers",[202,732,733],{"class":215},"()\n",[202,735,736,738,741,743,745],