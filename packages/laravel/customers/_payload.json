","Creating a customer",[205,206,210],"pre",{"className":207,"code":208,"language":209,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","// Create a Vatly customer for this user\n$user->createAsVatlyCustomer();\n\n// Create with extra data\n$user->createAsVatlyCustomer([\n    'locale' => 'nl_NL',\n    'metadata' => ['internal_id' => $user->id],\n]);\n","php",[211,212,213,222,243,250,256,270,297,334],"code",{"__ignoreMap":109},[214,215,218],"span",{"class":216,"line":217},"line",1,[214,219,221],{"class":220},"sHwdD","// Create a Vatly customer for this user\n",[214,223,225,229,233,236,240],{"class":216,"line":224},2,[214,226,228],{"class":227},"sMK4o","$",[214,230,232],{"class":231},"sTEyZ","user",[214,234,235],{"class":227},"->",[214,237,239],{"class":238},"s2Zo4","createAsVatlyCustomer",[214,241,242],{"class":227},"();\n",[214,244,246],{"class":216,"line":245},3,[214,247,249],{"emptyLinePlaceholder":248},true,"\n",[214,251,253],{"class":216,"line":252},4,[214,254,255],{"class":220},"// Create with extra data\n",[214,257,259,261,263,265,267],{"class":216,"line":258},5,[214,260,228],{"class":227},[214,262,232],{"class":231},[214,264,235],{"class":227},[214,266,239],{"class":238},[214,268,269],{"class":227},"([\n",[214,271,273,276,280,283,286,289,292,294],{"class":216,"line":272},6,[214,274,275],{"class":227},"    '",[214,277,279],{"class":278},"sfazB","locale",[214,281,282],{"class":227},"'",[214,284,285],{"class":227}," =>",[214,287,288],{"class":227}," '",[214,290,291],{"class":278},"nl_NL",[214,293,282],{"class":227},[214,295,296],{"class":227},",\n",[214,298,300,302,305,307,309,312,314,317,319,321,324,326,328,331],{"class":216,"line":299},7,[214,301,275],{"class":227},[214,303,304],{"class":278},"metadata",[214,306,282],{"class":227},[214,308,285],{"class":227},[214,310,311],{"class":227}," [",[214,313,282],{"class":227},[214,315,316],{"class":278},"internal_id",[214,318,282],{"class":227},[214,320,285],{"class":227},[214,322,323],{"class":227}," $",[214,325,232],{"class":231},[214,327,235],{"class":227},[214,329,330],{"class":231},"id",[214,332,333],{"class":227},"],\n",[214,335,337],{"class":216,"line":336},8,[214,338,339],{"class":227},"]);\n",[200,341,343],{"id":342},"checking-customer-status","Checking customer status",[205,345,347],{"className":207,"code":346,"language":209,"meta":109,"style":109},"// Check if the user has a Vatly customer ID\n$user->hasVatlyId(); // bool\n\n// Get the Vatly customer ID\n$user->getVatlyId(); // string|null\n",[211,348,349,354,371,375,380],{"__ignoreMap":109},[214,350,351],{"class":216,"line":217},[214,352,353],{"class":220},"// Check if the user has a Vatly customer ID\n",[214,355,356,358,360,362,365,368],{"class":216,"line":224},[214,357,228],{"class":227},[214,359,232],{"class":231},[214,361,235],{"class":227},[214,363,364],{"class":238},"hasVatlyId",[214,366,367],{"class":227},"();",[214,369,370],{"class":220}," // bool\n",[214,372,373],{"class":216,"line":245},[214,374,249],{"emptyLinePlaceholder":248},[214,376,377],{"class":216,"line":252},[214,378,379],{"class":220},"// Get the Vatly customer ID\n",[214,381,382,384,386,388,391,393],{"class":216,"line":258},[214,383,228],{"class":227},[214,385,232],{"class":231},[214,387,235],{"class":227},[214,389,390],{"class":238},"getVatlyId",[214,392,367],{"class":227},[214,394,395],{"class":220}," // string|null\n",[200,397,399],{"id":398},"retrieving-customer-data","Retrieving customer data",[205,401,403],{"className":207,"code":402,"language":209,"meta":109,"style":109},"// Get the full customer object from the Vatly API\n$customer = $user->asVatlyCustomer();\n",[211,404,405,410],{"__ignoreMap":109},[214,406,407],{"class":216,"line":217},[214,408,409],{"class":220},"// Get the full customer object from the Vatly API\n",[214,411,412,414,417,420,422,424,426,429],{"class":216,"line":224},[214,413,228],{"class":227},[214,415,416],{"class":231},"customer ",[214,418,419],{"class":227},"=",[214,421,323],{"class":227},[214,423,232],{"class":231},[214,425,235],{"class":227},[214,427,428],{"class":238},"asVatlyCustomer",[214,430,242],{"class":227},[200,432,434],{"id":433},"how-it-works","How it works",[196,436,437,438,441,442,445],{},"The ",[211,439,440],{},"vatly_id"," column on your billable model stores the Vatly customer identifier. When you call ",[211,443,444],{},"createAsVatlyCustomer()",", it:",[447,448,449,457,463],"ol",{},[450,451,452,453,456],"li",{},"Sends a ",[211,454,455],{},"POST"," request to the Vatly API to create a customer",[450,458,459,460,462],{},"Stores the returned customer ID in the ",[211,461,440],{}," column",[450,464,465],{},"Returns the customer response",[196,467,468,469,471,472,474,475,478],{},"If the user already has a ",[211,470,440],{},", calling ",[211,473,444],{}," will throw a ",[211,476,477],{},"CustomerAlreadyBoundException",".",[200,480,482],{"id":481},"automatic-customer-creation","Automatic customer creation",[196,484,485],{},"When a user starts a checkout without an existing Vatly customer ID, Vatly creates the customer automatically during the checkout flow. The customer ID is synced back to your application via webhooks.",[196,487,488,489,491],{},"This means you don't need to call ",[211,490,444],{}," before starting a checkout — just redirect the user directly.",[200,493,495],{"id":494},"anonymous-guest-checkouts","Anonymous / guest checkouts",[196,497,498,499,503,504,507,508,511,512,515],{},"A common flow: a visitor buys ",[500,501,502],"em",{},"before"," they sign up — checkout completes, Vatly fires ",[211,505,506],{},"order.paid"," / ",[211,509,510],{},"subscription.started"," webhooks, and your app has no ",[211,513,514],{},"User"," row to attribute the purchase to yet.",[196,517,518],{},"The package handles this without losing data:",[520,521,522,555],"ul",{},[450,523,437,524,527,528,531,532,535,536,539,540,543,544,547,548,550,551,554],{},[211,525,526],{},"vatly_subscriptions"," and ",[211,529,530],{},"vatly_orders"," tables both have a nullable ",[211,533,534],{},"owner_id","/",[211,537,538],{},"owner_type"," plus a ",[211,541,542],{},"customer_id"," column. The webhook writes the row with ",[211,545,546],{},"owner_id = null"," but populates ",[211,549,542],{}," with the Vatly customer id (",[211,552,553],{},"cus_…",").",[450,556,557,558,561],{},"When the visitor returns on the checkout-success redirect, call ",[211,559,560],{},"claimVatlyCustomerFromReturn()"," to link those rows to the now-known user.",[563,564,566,567,570],"h3",{"id":565},"learning-the-checkout-on-the-redirect-back-the-checkout_id-placeholder","Learning the checkout on the redirect back: the ",[211,568,569],{},"{CHECKOUT_ID}"," placeholder",[196,572,573,574,577,578,580,581,584],{},"The one hard part of guest checkout is: ",[500,575,576],{},"how does your app know which Vatly customer to claim when the buyer lands back on your site?"," You don't have to plumb the ",[211,579,553],{}," through a session or cookie yourself (that approach breaks under multi-tab / double-click — the last write wins, and the buyer may finish the checkout that ",[500,582,583],{},"isn't"," in the session).",[196,586,587,588,590],{},"Instead, put the literal ",[211,589,569],{}," placeholder in your return URL. Vatly substitutes it with the checkout's id at creation:",[205,592,594],{"className":207,"code":593,"language":209,"meta":109,"style":109},"$user->checkout()->create(\n    items: [['id' => 'product_abc123', 'quantity' => 1]],\n    redirectUrlSuccess: route('vatly.return').'?checkout_id={CHECKOUT_ID}',\n    redirectUrlCanceled: route('billing'),\n);\n",[211,595,596,616,662,695,716],{"__ignoreMap":109},[214,597,598,600,602,604,607,610,613],{"class":216,"line":217},[214,599,228],{"class":227},[214,601,232],{"class":231},[214,603,235],{"class":227},[214,605,606],{"class":238},"checkout",[214,608,609],{"class":227},"()->",[214,611,612],{"class":238},"create",[214,614,615],{"class":227},"(\n",[214,617,618,622,625,628,630,632,634,636,638,641,643,646,648,651,653,655,659],{"class":216,"line":224},[214,619,621],{"class":620},"sBMFI","    items",[214,623,624],{"class":227},":",[214,626,627],{"class":227}," [[",[214,629,282],{"class":227},[214,631,330],{"class":278},[214,633,282],{"class":227},[214,635,285],{"class":227},[214,637,288],{"class":227},[214,639,640],{"class":278},"product_abc123",[214,642,282],{"class":227},[214,644,645],{"class":227},",",[214,647,288],{"class":227},[214,649,650],{"class":278},"quantity",[214,652,282],{"class":227},[214,654,285],{"class":227},[214,656,658],{"class":657},"sbssI"," 1",[214,660,661],{"class":227},"]],\n",[214,663,664,667,669,672,675,677,680,682,685,688,691,693],{"class":216,"line":245},[214,665,666],{"class":620},"    redirectUrlSuccess",[214,668,624],{"class":227},[214,670,671],{"class":238}," route",[214,673,674],{"class":227},"(",[214,676,282],{"class":227},[214,678,679],{"class":278},"vatly.return",[214,681,282],{"class":227},[214,683,684],{"class":227},")",[214,686,687],{"class":227},".'",[214,689,690],{"class":278},"?checkout_id={CHECKOUT_ID}",[214,692,282],{"class":227},[214,694,296],{"class":227},[214,696,697,700,702,704,706,708,711,713],{"class":216,"line":252},[214,698,699],{"class":620},"    redirectUrlCanceled",[214,701,624],{"class":227},[214,703,671],{"class":238},[214,705,674],{"class":227},[214,707,282],{"class":227},[214,709,710],{"class":278},"billing",[214,712,282],{"class":227},[214,714,715],{"class":227},"),\n",[214,717,718],{"class":216,"line":258},[214,719,720],{"class":227},");\n",[196,722,723,724,624],{},"On the return route, hand the request to ",[211,725,560],{},[205,727,729],{"className":207,"code":728,"language":209,"meta":109,"style":109},"public function return(Request $request)\n{\n    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n    // (if there is one) claims it for the authenticated user.\n    $request->user()->claimVatlyCustomerFromReturn($request);\n\n    return redirect()->route('dashboard');\n}\n",[211,730,731,756,761,766,771,794,798,823],{"__ignoreMap":109},[214,732,733,737,740,743,745,748,750,753],{"class":216,"line":217},[214,734,736],{"class":735},"spNyl","public",[214,738,739],{"class":735}," function",[214,741,742],{"class":238}," return",[214,744,674],{"class":227},[214,746,747],{"class":620},"Request",[214,749,323],{"class":227},[214,751,752],{"class":231},"request",[214,754,755],{"class":227},")\n",[214,757,758],{"class":216,"line":224},[214,759,760],{"class":227},"{\n",[214,762,763],{"class":216,"line":245},[214,764,765],{"class":220},"    // Reads ?checkout_id=…, resolves that checkout's Vatly customer, and\n",[214,767,768],{"class":216,"line":252},[214,769,770],{"class":220},"    // (if there is one) claims it for the authenticated user.\n",[214,772,773,776,778,780,782,784,787,790,792],{"class":216,"line":258},[214,774,775],{"class":227},"    $",[214,777,752],{"class":231},[214,779,235],{"class":227},[214,781,232],{"class":238},[214,783,609],{"class":227},[214,785,786],{"class":238},"claimVatlyCustomerFromReturn",[214,788,789],{"class":227},"($",[214,791,752],{"class":231},[214,793,720],{"class":227},[214,795,796],{"class":216,"line":272},[214,797,249],{"emptyLinePlaceholder":248},[214,799,800,804,807,809,812,814,816,819,821],{"class":216,"line":299},[214,801,803],{"class":802},"s7zQu","    return",[214,805,806],{"class":238}," redirect",[214,808,609],{"class":227},[214,810,811],{"class":238},"route",[214,813,674],{"class":227},[214,815,282],{"class":227},[214,817,818],{"class":278},"dashboard",[214,820,282],{"class":227},[214,822,720],{"class":227},[214,824,825],{"class":216,"line":336},[214,826,827],{"class":227},"}\n",[196,829,830,831,834,835,838],{},"It returns ",[211,832,833],{},"true"," when a claim happened and ",[211,836,837],{},"false"," for a missing / unknown checkout id or a checkout with no customer yet — so it's safe to call unconditionally. Pass a second argument to read a different query key:",[205,840,842],{"className":207,"code":841,"language":209,"meta":109,"style":109},"$user->claimVatlyCustomerFromReturn($request, 'cid'); // reads ?cid=…\n",[211,843,844],{"__ignoreMap":109},[214,845,846,848,850,852,854,856,858,860,862,865,867,870],{"class":216,"line":217},[214,847,228],{"class":227},[214,849,232],{"class":231},[214,851,235],{"class":227},[214,853,786],{"class":238},[214,855,789],{"class":227},[214,857,752],{"class":231},[214,859,645],{"class":227},[214,861,288],{"class":227},[214,863,864],{"class":278},"cid",[214,866,282],{"class":227},[214,868,869],{"class":227},");",[214,871,872],{"class":220}," // reads ?cid=…\n",[196,874,875,876,880],{},"This is ",[877,878,879],"strong",{},"multi-tab safe by construction",": each tab carries its own checkout id in its own redirect URL, so two checkouts in flight resolve independently — there is no shared carrier whose last write wins.",[882,883,884],"blockquote",{},[196,885,886,887,890],{},"The checkout id travels in the URL, so it may also appear in the ",[211,888,889],{},"Referer"," header and your server logs. It is low-sensitivity — it only names a checkout the buyer just completed — but treat it like any URL parameter.",[196,892,893,894,896,897,900],{},"Under the hood ",[211,895,560],{}," resolves the checkout's customer id via the Vatly API and then runs ",[211,898,899],{},"claimVatlyCustomer()",", which:",[447,902,903,913,916],{},[450,904,905,906,909,910,912],{},"Binds the Vatly customer id to this host entity via the configured ",[211,907,908],{},"CustomerBindingRepository"," (default impl: writes ",[211,911,440],{}," on the billable table).",[450,914,915],{},"Saves the model.",[450,917,918,919,507,921,923,924,527,926,928,929,931],{},"Backfills ",[211,920,538],{},[211,922,534],{}," on every ",[211,925,526],{},[211,927,530],{}," row that carries the same ",[211,930,542],{}," but had no owner yet.",[196,933,437,934,507,936,938,939,941,942,944,945,947,948,950],{},[211,935,506],{},[211,937,510],{}," webhook usually lands ",[500,940,502],{}," the buyer is redirected back, so those rows already exist (with ",[211,943,546],{},") by the time you claim — step 3 simply backfills them. The reverse order works too: if the claim runs first, it binds the customer, and a later webhook for the same ",[211,946,542],{}," finds the binding and writes ",[211,949,534],{}," directly. Either way the purchase ends up attributed.",[196,952,953,954,956,957,960],{},"If you already hold the ",[211,955,553],{}," by other means, you can still call ",[211,958,959],{},"claimVatlyCustomer($vatlyCustomerId)"," directly; it returns the number of rows re-attributed.",[882,962,963],{},[196,964,965,968],{},[877,966,967],{},"Out of scope:"," buyers who never come back via the redirect link (closed the tab, switched device). Recovering those is the email-based recovery story — a separate concern this helper does not cover.",[196,970,971],{},"Need the email / name on the customer to surface a \"would you like to claim purchase X?\" prompt at signup? Fetch the customer via the Vatly API:",[205,973,975],{"className":207,"code":974,"language":209,"meta":109,"style":109},"$customer = app(\\Vatly\\Fluent\\Vatly::class)\n    ->customers()\n    ->findByVatlyCustomerId($vatlyCustomerId);\n\n$customer->email;\n$customer->name;\n",[211,976,977,1012,1023,1037,1041,1056],{"__ignoreMap":109},[214,978,979,981,983,985,988,991,994,997,1000,1002,1004,1007,1010],{"class":216,"line":217},[214,980,228],{"class":227},[214,982,416],{"class":231},[214,984,419],{"class":227},[214,986,987],{"class":238}," app",[214,989,990],{"class":227},"(\\",[214,992,993],{"class":231},"Vatly",[214,995,996],{"class":227},"\\",[214,998,999],{"class":231},"Fluent",[214,1001,996],{"class":227},[214,1003,993],{"class":620},[214,1005,1006],{"class":227},"::",[214,1008,1009],{"class":657},"class",[214,1011,755],{"class":227},[214,1013,1014,1017,1020],{"class":216,"line":224},[214,1015,1016],{"class":227},"    ->",[214,1018,1019],{"class":238},"customers",[214,1021,1022],{"class":227},"()\n",[214,1024,1025,1027,1030,1032,1035],{"class":216,"line":245},[214,1026,1016],{"class":227},[214,1028,1029],{"class":238},"findByVatlyCustomerId",[214,1031,789],{"class":227},[214,1033,1034],{"class":231},"vatlyCustomerId",[214,1036,720],{"class":227},[214,1038,1039],{"class":216,"line":252},[214,1040,249],{"emptyLinePlaceholder":248},[214,1042,1043,1045,1048,1050,1053],{"class":216,"line":258},[214,1044,228],{"class":227},[214,1046,1047],{"class":231},"customer",[214,1049,235],{"class":227},[214,1051,1052],{"class":231},"email",[214,1054,1055],{"class":227},";\n",[214,1057,1058,1060,1062,1064,1067],{"class":216,"line":272},[214,1059,228],{"class":227},[214,1061,1047],{"class":231},[214,1063,235],{"class":227},[214,1065,1066],{"class":231},"name",[214,1068,1055],{"class":227},[1070,1071,1072],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default