7,388,389,392,393,396,397,400],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[302,390,391],{},"order.canceled"," webhook the package stores it in the ",[302,394,395],{},"cancellation_reason"," column on the ",[302,398,399],{},"vatly_orders"," row:",[295,402,404],{"className":297,"code":403,"language":299,"meta":300,"style":300},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[302,405,406,424],{"__ignoreMap":300},[305,407,408,410,413,415,418,421],{"class":307,"line":308},[305,409,319],{"class":318},[305,411,412],{"class":322},"order",[305,414,335],{"class":318},[305,416,417],{"class":322},"status",[305,419,420],{"class":318},";",[305,422,423],{"class":311},"              \u002F\u002F \"canceled\"\n",[305,425,426,428,430,432,434,436],{"class":307,"line":315},[305,427,319],{"class":318},[305,429,412],{"class":322},[305,431,335],{"class":318},[305,433,395],{"class":322},[305,435,420],{"class":318},[305,437,438],{"class":311}," \u002F\u002F \"payment_failure\", or null for any other order\n",[286,440,441,442,445,446,449,450,453],{},"The same value is on the dispatched ",[302,443,444],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[302,447,448],{},"$event->cancellationReason",". Compare it against ",[302,451,452],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[286,455,456,457,460,461,464,465,453],{},"Existing installations need the new column. Publish the migrations again with ",[302,458,459],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[302,462,463],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[302,466,467],{},"php artisan migrate",[290,469,471],{"id":470},"how-it-works","How it works",[286,473,474,475,478],{},"Orders are synced from Vatly via webhooks. The ",[302,476,477],{},"orders()