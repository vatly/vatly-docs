w:",[481,588,590],{"className":483,"code":589,"language":485,"meta":486,"style":486},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[488,591,592,610],{"__ignoreMap":486},[491,593,594,596,599,601,604,607],{"class":493,"line":494},[491,595,505],{"class":504},[491,597,598],{"class":508},"order",[491,600,521],{"class":504},[491,602,603],{"class":508},"status",[491,605,606],{"class":504},";",[491,608,609],{"class":497},"              \u002F\u002F \"canceled\"\n",[491,611,612,614,616,618,620,622],{"class":493,"line":501},[491,613,505],{"class":504},[491,615,598],{"class":508},[491,617,521],{"class":504},[491,619,581],{"class":508},[491,621,606],{"class":504},[491,623,624],{"class":497}," \u002F\u002F \"payment_failure\", or null for any other order\n",[472,626,627,628,631,632,635,636,639],{},"The same value is on the dispatched ",[488,629,630],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[488,633,634],{},"$event->cancellationReason",". Compare it against ",[488,637,638],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[472,641,642,643,646,647,650,651,639],{},"Existing installations need the new column. Publish the migrations again with ",[488,644,645],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[488,648,649],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[488,652,653],{},"php artisan migrate",[476,655,657],{"id":656},"a-subscriptions-order-lines","A subscription's order lines",[472,659,660,661,664,665,668,669,672,673,676,677,680],{},"Each line stored from an ",[488,662,663],{},"order.paid"," webhook records the subscription it belongs to in the ",[488,666,667],{},"subscription_id"," column on ",[488,670,671],{},"vatly_order_lines",", including the initial signup line, which references the plan (",[488,674,675],{},"product_type"," is ",[488,678,679],{},"subscription_plan","). List every line of a subscription, initial order included, through the order-line repository:",[481,682,684],{"className":483,"code":683,"language":485,"meta":486,"style":486},"use Vatly\\Fluent\\Contracts\\OrderLineRepositoryInterface;\n\n$lines = app(OrderLineRepositoryInterface::class)->listForSubscription($subscription->vatly_id);\n$orderIds = array_unique(array_map(fn ($line) => $line->getOrderId(), $lines));\n",[488,685,686,713,717,761],{"__ignoreMap":486},[491,687,688,692,695,698,701,703,706,708,711],{"class":493,"line":494},[491,689,691],{"class":690},"sbssI","use",[491,693,694],{"class":508}," Vatly",[491,696,697],{"class":504},"\\",[491,699,700],{"class":508},"Fluent",[491,702,697],{"class":504},[491,704,705],{"class":508},"Contracts",[491,707,697],{"class":504},[491,709,710],{"class":508},"OrderLineRepositoryInterface",[491,712,527],{"class":504},[491,714,715],{"class":493,"line":501},[491,716,534],{"emptyLinePlaceholder":533},[491,718,719,721,724,726,729,732,735,738,741,744,747,750,753,755,758],{"class":493,"line":530},[491,720,505],{"class":504},[491,722,723],{"class":508},"lines ",[491,725,512],{"class":504},[491,727,728],{"class":563}," app",[491,730,731],{"class":504},"(",[491,733,710],{"class":734},"sBMFI",[491,736,737],{"class":504},"::",[491,739,740],{"class":690},"class",[491,742,743],{"class":504},")->",[491,745,746],{"class":563},"listForSubscription",[491,748,749],{"class":504},"($",[491,751,752],{"class":508},"subscription",[491,754,521],{"class":504},[491,756,757],{"class":508},"vatly_id",[491,759,760],{"class":504},");\n",[491,762,763,765,768,770,773,775,778,780,784,787,789,792,795,797,799,801,804,807,809,812],{"class":493,"line":537},[491,764,505],{"class":504},[491,766,767],{"class":508},"orderIds ",[491,769,512],{"class":504},[491,771,772],{"class":563}," array_unique",[491,774,731],{"class":504},[491,776,777],{"class":563},"array_map",[491,779,731],{"class":504},[491,781,783],{"class":782},"spNyl","fn",[491,785,786],{"class":504}," ($",[491,788,493],{"class":508},[491,790,791],{"class":504},")",[491,793,794],{"class":504}," =>",[491,796,515],{"class":504},[491,798,493],{"class":508},[491,800,521],{"class":504},[491,802,803],{"class":563},"getOrderId",[491,805,806],{"class":504},"(),",[491,808,515],{"class":504},[491,810,811],{"class":508},"lines",[491,813,814],{"class":504},"));\n",[472,816,817,819,820,823,824,676,826,828,829,832],{},[488,818,667],{}," is null on one-off lines, on lines Vatly created before it carried the link, and on a signup line whose subscription was not yet available when the order was paid. Lines are written once, so such a line stays unlinked. ",[488,821,822],{},"listForSubscription()"," also returns renewal lines whose ",[488,825,675],{},[488,827,752],{}," and ",[488,830,831],{},"product_id"," is the subscription id, so renewals stored without the link still appear.",[472,834,642,835,646,837,650,840,639],{},[488,836,645],{},[488,838,839],{},"add_subscription_id_to_vatly_order_lines_table",[488,841,653],{},[476,843,845],{"id":844},"how-it-works","How it works",[472,847,848,849,852],{},"Orders are synced from Vatly via webhooks. The ",[488,850,851],{},"orders()"," relationship returns all orders associated with the billable model through a polymorphic relationship.",[854,855,856],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-styl