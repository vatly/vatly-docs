ser\n$orders = $user->orders;\n\n\u002F\u002F Orders are sorted by most recent first\n$latestOrder = $user->orders->first();\n","php","",[439,440,441,450,479,486,492],"code",{"__ignoreMap":437},[442,443,446],"span",{"class":444,"line":445},"line",1,[442,447,449],{"class":448},"sHwdD","\u002F\u002F Get all orders for a user\n",[442,451,453,457,461,464,467,470,473,476],{"class":444,"line":452},2,[442,454,456],{"class":455},"sMK4o","$",[442,458,460],{"class":459},"sTEyZ","orders ",[442,462,463],{"class":455},"=",[442,465,466],{"class":455}," $",[442,468,469],{"class":459},"user",[442,471,472],{"class":455},"->",[442,474,475],{"class":459},"orders",[442,477,478],{"class":455},";\n",[442,480,482],{"class":444,"line":481},3,[442,483,485],{"emptyLinePlaceholder":484},true,"\n",[442,487,489],{"class":444,"line":488},4,[442,490,491],{"class":448},"\u002F\u002F Orders are sorted by most recent first\n",[442,493,495,497,500,502,504,506,508,510,512,516],{"class":444,"line":494},5,[442,496,456],{"class":455},[442,498,499],{"class":459},"latestOrder ",[442,501,463],{"class":455},[442,503,466],{"class":455},[442,505,469],{"class":459},[442,507,472],{"class":455},[442,509,475],{"class":459},[442,511,472],{"class":455},[442,513,515],{"class":514},"s2Zo4","first",[442,517,518],{"class":455},"();\n",[427,520,522],{"id":521},"why-an-order-was-canceled","Why an order was canceled",[423,524,525,526,529,530,533,534,537],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[439,527,528],{},"order.canceled"," webhook the package stores it in the ",[439,531,532],{},"cancellation_reason"," column on the ",[439,535,536],{},"vatly_orders"," row:",[432,539,541],{"className":434,"code":540,"language":436,"meta":437,"style":437},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[439,542,543,561],{"__ignoreMap":437},[442,544,545,547,550,552,555,558],{"class":444,"line":445},[442,546,456],{"class":455},[442,548,549],{"class":459},"order",[442,551,472],{"class":455},[442,553,554],{"class":459},"status",[442,556,557],{"class":455},";",[442,559,560],{"class":448},"              \u002F\u002F \"canceled\"\n",[442,562,563,565,567,569,571,573],{"class":444,"line":452},[442,564,456],{"class":455},[442,566,549],{"class":459},[442,568,472],{"class":455},[442,570,532],{"class":459},[442,572,557],{"class":455},[442,574,575],{"class":448}," \u002F\u002F \"payment_failure\", or null for any other order\n",[423,577,578,579,582,583,586,587,590],{},"The same value is on the dispatched ",[439,580,581],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[439,584,585],{},"$event->cancellationReason",". Compare it against ",[439,588,589],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[423,592,593,594,597,598,601,602,590],{},"Existing installations need the new column. Publish the migrations again with ",[439,595,596],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[439,599,600],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[439,603,604],{},"php artisan migrate",[427,606,608],{"id":607},"how-it-works","How it works",[423,610,611,612,615],{},"Orders are synced from Vatly via webhooks. The ",[439,613,614],{},"orders()"," relationship returns all orders associated with the billable model through a polymorphic relationship.",[617,618,619],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo