61},4,[515,563,564],{"class":521},"\u002F\u002F Orders are sorted by most recent first\n",[515,566,568,570,573,575,577,579,581,583,585,589],{"class":517,"line":567},5,[515,569,529],{"class":528},[515,571,572],{"class":532},"latestOrder ",[515,574,536],{"class":528},[515,576,539],{"class":528},[515,578,542],{"class":532},[515,580,545],{"class":528},[515,582,548],{"class":532},[515,584,545],{"class":528},[515,586,588],{"class":587},"s2Zo4","first",[515,590,591],{"class":528},"();\n",[500,593,595],{"id":594},"why-an-order-was-canceled","Why an order was canceled",[496,597,598,599,602,603,606,607,610],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[512,600,601],{},"order.canceled"," webhook the package stores it in the ",[512,604,605],{},"cancellation_reason"," column on the ",[512,608,609],{},"vatly_orders"," row:",[505,612,614],{"className":507,"code":613,"language":509,"meta":510,"style":510},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[512,615,616,634],{"__ignoreMap":510},[515,617,618,620,623,625,628,631],{"class":517,"line":518},[515,619,529],{"class":528},[515,621,622],{"class":532},"order",[515,624,545],{"class":528},[515,626,627],{"class":532},"status",[515,629,630],{"class":528},";",[515,632,633],{"class":521},"              \u002F\u002F \"canceled\"\n",[515,635,636,638,640,642,644,646],{"class":517,"line":525},[515,637,529],{"class":528},[515,639,622],{"class":532},[515,641,545],{"class":528},[515,643,605],{"class":532},[515,645,630],{"class":528},[515,647,648],{"class":521}," \u002F\u002F \"payment_failure\", or null for any other order\n",[496,650,651,652,655,656,659,660,663],{},"The same value is on the dispatched ",[512,653,654],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[512,657,658],{},"$event->cancellationReason",". Compare it against ",[512,661,662],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[496,665,666,667,670,671,674,675,663],{},"Existing installations need the new column. Publish the migrations again with ",[512,668,669],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[512,672,673],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[512,676,677],{},"php artisan migrate",[500,679,681],{"id":680},"a-subscriptions-order-lines","A subscription's order lines",[496,683,684,685,688,689,692,693,696,697,700,701,704],{},"Each line stored from an ",[512,686,687],{},"order.paid"," webhook records the subscription it belongs to in the ",[512,690,691],{},"subscription_id"," column on ",[512,694,695],{},"vatly_order_lines",", including the initial signup line, which references the plan (",[512,698,699],{},"product_type"," is ",[512,702,703],{},"subscription_plan","). List every line of a subscription, initial order included, through the order-line repository:",[505,706,708],{"className":507,"code":707,"language":509,"meta":510,"style":510},"use Vatly\\Fluent\\Contracts\\OrderLineRepositoryInterface;\n\n$lines = app(OrderLineRepositoryInterface::class)->listForSubscription($subscription->vatly_id);\n$orderIds = array_unique(array_map(fn ($line) => $line->getOrderId(), $lines));\n",[512,709,710,737,741,785],{"__ignoreMap":510},[515,711,712,716,719,722,725,727,730,732,735],{"class":517,"line":518},[515,713,715],{"class":714},"sbssI","use",[515,717,718],{"class":532}," Vatly",[515,720,721],{"class":528},"\\",[515,723,724],{"class":532},"Fluent",[515,726,721],{"class":528},[515,728,729],{"class":532},"Contracts",[515,731,721],{"class":528},[515,733,734],{"class":532},"OrderLineRepositoryInterface",[515,736,551],{"class":528},[515,738,739],{"class":517,"line":525},[515,740,558],{"emptyLinePlaceholder":557},[515,742,743,745,748,750,753,756,759,762,765,768,771,774,777,779,782],{"class":517,"line":554},[515,744,529],{"class":528},[515,746,747],{"class":532},"lines ",[515,749,536],{"class":528},[515,751,752],{"class":587}," app",[515,754,755],{"class":528},"(",[515,757,734],{"class":758},"sBMFI",[515,760,761],{"class":528},"::",[515,763,764],{"class":714},"class",[515,766,767],{"class":528},")->",[515,769,770],{"class":587},"listForSubscription",[515,772,773],{"class":528},"($",[515,775,776],{"class":532},"subscription",[515,778,545],{"class":528},[515,780,781],{"class":532},"vatly_id",[515,783,784],{"class":528},");\n",[515,786,787,789,792,794,797,799,802,804,808,811,813,816,819,821,823,825,828,831,833,836],{"class":517,"line":561},[515,788,529],{"class":528},[515,790,791],{"class":532},"orderIds ",[515,793,536],{"class":528},[515,795,796],{"class":587}," array_unique",[515,798,755],{"class":528},[515,800,801],{"class":587},"array_map",[515,803,755],{"class":528},[515,805,807],{"class":806},"spNyl","fn",[515,809,810],{"class":528}," ($",[515,812,517],{"class":532},[515,814,815],{"class":528},")",[515,817,818],{"class":528}," =>",[515,820,539],{"class":528},[515,822,517],{"class":532},[515,824,545],{"class":528},[515,826,827],{"class":587},"getOrderId",[515,829,830],{"class":528},"(),",[515,832,539],{"class":528},[515,834,835],{"class":532},"lines",[515,837,838],{"class":528},"));\n",[496,840,841,843,844,847,848,700,850,852,853,856],{},[512,842,691],{}," is null on one-off lines, on lines Vatly created before it carried the link, and on a signup line whose subscription was not yet available when the order was paid. Lines are written once, so such a line stays unlinked. ",[512,845,846],{},"listForSubscription()"," also returns renewal lines whose ",[512,849,699],{},[512,851,776],{}," and ",[512,854,855],{},"product_id"," is the subscription id, so renewals stored without the link still appear.",[496,858,666,859,670,861,674,864,663],{},[512,860,669],{},[512,862,863],{},"add_subscription_id_to_vatly_order_lines_table",[512,865,677],{},[500,867,869],{"id":868},"how-it-works","How it works",[496,871,872,873,876]