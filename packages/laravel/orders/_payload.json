cent first\n",[269,320,322,324,327,329,331,333,335,337,339,343],{"class":271,"line":321},5,[269,323,283],{"class":282},[269,325,326],{"class":286},"latestOrder ",[269,328,290],{"class":282},[269,330,293],{"class":282},[269,332,296],{"class":286},[269,334,299],{"class":282},[269,336,302],{"class":286},[269,338,299],{"class":282},[269,340,342],{"class":341},"s2Zo4","first",[269,344,345],{"class":282},"();\n",[255,347,349],{"id":348},"why-an-order-was-canceled","Why an order was canceled",[251,351,352,353,356,357,360,361,364],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[266,354,355],{},"order.canceled"," webhook the package stores it in the ",[266,358,359],{},"cancellation_reason"," column on the ",[266,362,363],{},"vatly_orders"," row:",[260,366,368],{"className":262,"code":367,"language":264,"meta":117,"style":117},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[266,369,370,388],{"__ignoreMap":117},[269,371,372,374,377,379,382,385],{"class":271,"line":272},[269,373,283],{"class":282},[269,375,376],{"class":286},"order",[269,378,299],{"class":282},[269,380,381],{"class":286},"status",[269,383,384],{"class":282},";",[269,386,387],{"class":275},"              \u002F\u002F \"canceled\"\n",[269,389,390,392,394,396,398,400],{"class":271,"line":279},[269,391,283],{"class":282},[269,393,376],{"class":286},[269,395,299],{"class":282},[269,397,359],{"class":286},[269,399,384],{"class":282},[269,401,402],{"class":275}," \u002F\u002F \"payment_failure\", or null for any other order\n",[251,404,405,406,409,410,413,414,417],{},"The same value is on the dispatched ",[266,407,408],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[266,411,412],{},"$event->cancellationReason",". Compare it against ",[266,415,416],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[251,419,420,421,424,425,428,429,41