class":575},"s2Zo4","first",[503,578,579],{"class":516},"();\n",[488,581,583],{"id":582},"why-an-order-was-canceled","Why an order was canceled",[484,585,586,587,590,591,594,595,598],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[500,588,589],{},"order.canceled"," webhook the package stores it in the ",[500,592,593],{},"cancellation_reason"," column on the ",[500,596,597],{},"vatly_orders"," row:",[493,600,602],{"className":495,"code":601,"language":497,"meta":498,"style":498},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[500,603,604,622],{"__ignoreMap":498},[503,605,606,608,611,613,616,619],{"class":505,"line":506},[503,607,517],{"class":516},[503,609,610],{"class":520},"order",[503,612,533],{"class":516},[503,614,615],{"class":520},"status",[503,617,618],{"class":516},";",[503,620,621],{"class":509},"              \u002F\u002F \"canceled\"\n",[503,623,624,626,628,630,632,634],{"class":505,"line":513},[503,625,517],{"class":516},[503,627,610],{"class":520},[503,629,533],{"class":516},[503,631,593],{"class":520},[503,633,618],{"class":516},[503,635,636],{"class":509}," \u002F\u002F \"payment_failure\", or null for any other order\n",[484,638,639,640,643,644,647,648,651],{},"The same value is on the dispatched ",[500,641,642],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[500,645,646],{},"$event->cancellationReason",". Compare it against ",[500,649,650],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[484,653,654,655,658,659,662,663,651],{},"Existing installations need the new column. Publish the migrations again with ",[500,656,657],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[500,660,661],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[500,664,665],{},"php artisan migrate",[488,667,669],{"id":668},"a-subscriptions-order-lines","A subscription's order lines",[484,671,672,673,676,677,680,681,684,685,688,689,692],{},"Each line stored from an ",[500,674,675],{},"order.paid"," webhook records the subscription it belongs to in the ",[500,678,679],{},"subscription_id"," column on ",[500,682,683],{},"vatly_order_lines",", including the initial signup line, which references the plan (",[500,686,687],{},"product_type"," is ",[500,690,691],{},"subscription_plan","). List every line of a subscription, initial order included, through the order-line repository:",[493,694,696],{"className":495,"code":695,"language":497,"meta":498,"style":498},"use Vatly\\Fluent\\Contracts\\OrderLineRepositoryInterface;\n\n$lines = app(OrderLineRepositoryInterface::class)->listForSubscription($subscription->vatly_id);\n$orderIds = array_unique(array_map(fn ($line) => $line->getOrderId(), $lines));\n",[500,697,698,725,729,773],{"__ignoreMap":498},[503,699,700,704,707,710,713,715,718,720,723],{"class":505,"line":506},[503,701,703],{"class":702},"sbssI","use",[503,705,706],{"class":520}," Vatly",[503,708,709],{"class":516},"\\",[503,711,712],{"class":520},"Fluent",[503,714,709],{"class":516},[503,716,717],{"class":520},"Contracts",[503,719,709],{"class":516},[503,721,722],{"class":520},"OrderLineRepositoryInterface",[503,724,539],{"class":516},[503,726,727],{"class":505,"line":513},[503,728,546],{"emptyLinePlaceholder":545},[503,730,731,733,736,738,741,744,747,750,753,756,759,762,765,767,770],{"class":505,"line":542},[503,732,517],{"class":516},[503,734,735],{"class":520},"lines ",[503,737,524],{"class":516},[503,739,740],{"class":575}," app",[503,742,743],{"class":516},"(",[503,745,722],{"class":746},"sBMFI",[503,748,749],{"class":516},"::",[503,751,752],{"class":702},"class",[503,754,755],{"class":516},")->",[503,757,758],{"class":575},"listForSubscription",[503,760,761],{"class":516},"($",[503,763,764],{"class":520},"subscription",[503,766,533],{"class":516},[503,768,769],{"class":520},"vatly_id",[503,771,772],{"class":516},");\n",[503,774,775,777,780,782,785,787,790,792,796,799,801,804,807,809,811,813,816,819,821,824],{"class":505,"line":549},[503,776,517],{"class":516},[503,778,779],{"class":520},"orderIds ",[503,781,524],{"class":516},[503,783,784],{"class":575}," array_unique",[503,786,743],{"class":516},[503,788,789],{"class":575},"array_map",[503,791,743],{"class":516},[503,793,795],{"class":794},"spNyl","fn",[503,797,798],{"class":516}," ($",[503,800,505],{"class":520},[503,802,803],{"class":516},")",[503,805,806],{"class":516}," =>",[503,808,527],{"class":516},[503,810,505],{"class":520},[503,812,533],{"class":516},[503,814,815],{"class":575},"getOrderId",[503,817,818],{"class":516},"(),",[503,820,527],{"class":516},[503,822,823],{"class":520},"lines",[503,825,826],{"class":516},"));\n",[484,828,829,831,832,835,836,688,838,840,841,844],{},[500,830,679],{}," is null on one-off lines, on lines Vatly created before it carried the link, and on a signup line whose subscription was not yet available when the order was paid. Lines are written once, so such a line stays unlinked. ",[500,833,834],{},"listForSubscription()"," also returns renewal lines whose ",[500,837,687],{},[500,839,764],{}," and ",[500,842,843],{},"product_id"," is the subscription id, so renewals stored without the link still appear.",[484,846,654,847,658,849,662,852,651],{},[500,848,657],{},[500,850,851],{},"add_subscription_id_to_vatly_order_lines_table",[500,853,665],{},[488,855,857],{"id":856},"how-it-works","How it works",[484,859,860,861,864],{},"Orders are synced from Vatly via webhooks. The ",[500,862,863],{},"orders()"," relationship returns all orders associated with the billable model through a polymorphic relationship.",[866,867,868],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style: