"payment_failure\", or null for any other order\n",[484,587,588,606],{"__ignoreMap":482},[487,589,590,592,595,597,600,603],{"class":489,"line":490},[487,591,501],{"class":500},[487,593,594],{"class":504},"order",[487,596,517],{"class":500},[487,598,599],{"class":504},"status",[487,601,602],{"class":500},";",[487,604,605],{"class":493},"              \u002F\u002F \"canceled\"\n",[487,607,608,610,612,614,616,618],{"class":489,"line":497},[487,609,501],{"class":500},[487,611,594],{"class":504},[487,613,517],{"class":500},[487,615,577],{"class":504},[487,617,602],{"class":500},[487,619,620],{"class":493}," \u002F\u002F \"payment_failure\", or null for any other order\n",[468,622,623,624,627,628,631,632,635],{},"The same value is on the dispatched ",[484,625,626],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[484,629,630],{},"$event->cancellationReason",". Compare it against ",[484,633,634],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[468,637,638,639,642,643,646,647,635],{},"Existing installations need the new column. Publish the migrations again with ",[484,640,641],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[484,644,645],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[484,648,649],{},"php artisan migrate",[472,651,653],{"id":652},"how-it-works","How it works",[468,655,656,657,660],{},"Orders are synced from Vatly via webhooks. The ",[484,658,659],{},"orders()"," relationship returns all orders associated with the billable model through a polymorphic relationship.",[662,663,664],"style",{},"html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .