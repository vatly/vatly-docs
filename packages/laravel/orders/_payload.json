1,565,525],{"class":524},[511,567,568],{"class":528},"latestOrder ",[511,570,532],{"class":524},[511,572,535],{"class":524},[511,574,538],{"class":528},[511,576,541],{"class":524},[511,578,544],{"class":528},[511,580,541],{"class":524},[511,582,584],{"class":583},"s2Zo4","first",[511,586,587],{"class":524},"();\n",[496,589,591],{"id":590},"why-an-order-was-canceled","Why an order was canceled",[492,593,594,595,598,599,602,603,606],{},"Vatly tags an order with a reason when payment recovery for the unpaid order is exhausted. On the ",[508,596,597],{},"order.canceled"," webhook the package stores it in the ",[508,600,601],{},"cancellation_reason"," column on the ",[508,604,605],{},"vatly_orders"," row:",[501,608,610],{"className":503,"code":609,"language":505,"meta":506,"style":506},"$order->status;              \u002F\u002F \"canceled\"\n$order->cancellation_reason; \u002F\u002F \"payment_failure\", or null for any other order\n",[508,611,612,630],{"__ignoreMap":506},[511,613,614,616,619,621,624,627],{"class":513,"line":514},[511,615,525],{"class":524},[511,617,618],{"class":528},"order",[511,620,541],{"class":524},[511,622,623],{"class":528},"status",[511,625,626],{"class":524},";",[511,628,629],{"class":517},"              \u002F\u002F \"canceled\"\n",[511,631,632,634,636,638,640,642],{"class":513,"line":521},[511,633,525],{"class":524},[511,635,618],{"class":528},[511,637,541],{"class":524},[511,639,601],{"class":528},[511,641,626],{"class":524},[511,643,644],{"class":517}," \u002F\u002F \"payment_failure\", or null for any other order\n",[492,646,647,648,651,652,655,656,659],{},"The same value is on the dispatched ",[508,649,650],{},"Vatly\\API\\Webhooks\\Events\\OrderCanceled"," event as ",[508,653,654],{},"$event->cancellationReason",". Compare it against ",[508,657,658],{},"Vatly\\API\\Types\\CancellationReason::PAYMENT_FAILURE",".",[492,661,662,663,666,667,670,671,659],{},"Existing installations need the new column. Publish the migrations again with ",[508,664,665],{},"php artisan vendor:publish --tag=vatly-migrations",", keep the new ",[508,668,669],{},"add_cancellation_reason_to_vatly_orders_table"," migration, delete the other newly published copies, and run ",[508,672,673],{},"php artisan migrate",[496,675,677],{"id":676},"a-subscriptions-order-lines","A subscription's order lines",[492,679,680,681,684,685,688,689,692,693,696,697,700],{},"Each line stored from an ",[508,682,683],{},"order.paid"," webhook records the subscription it belongs to in the ",[508,686,687],{},"subscription_id"," column on ",[508,690,691],{},"vatly_order_lines",", including the initial signup line, which references the plan (",[508,694,695],{},"product_type"," is ",[508,698,699],{},"subscription_plan","). List every line of a subscription, initial order included, through the order-line repository:",[501,702,704],{"className":503,"code":703,"language":505,"meta":506,"style":506},"use Vatly\\Fluent\\Contracts\\OrderLineRepositoryInterface;\n\n$lines = app(OrderLineRepositoryInterface::class)->listForSubscription($subscription->vatly_id);\n$orderIds = array_unique(array_map(fn ($line) => $line->getOrderId(), $lines));\n",[508,705,706,733,737,781],{"__ignoreMap":506},[511,707,708,712,715,718,721,723,726,728,731],{"class":513,"line":514},[511,709,711],{"class":710},"sbssI","use",[511,713,714],{"class":528}," Vatly",[511,716,717],{"class":524},"\\",[511,719,720],{"class":528},"Fluent",[511,722,717],{"class":524},[511,724,725],{"class":528},"Contracts",[511,727,717],{"class":524},[511,729,730],{"class":528},"OrderLineRepositoryInterface",[511,732,547],{"class":524},[511,734,735],{"class":513,"line":521},[511,736,554],{"emptyLinePlaceholder":553},[511,738,739,741,744,746,749,752,755,758,761,764,767,770,773,775,778],{"class":513,"line":550},[511,740,525],{"class":524},[511,742,743],{"class":528},"lines ",[511,745,532],{"class":524},[511,747,748],{"class":583}," app",[511,750,751],{"class":524},"(",[511,753,730],{"class":754},"sBMFI",[511,756,757],{"class":524},"::",[511,759,760],{"class":710},"class",[511,762,763],{"class":524},")->",[511,765,766],{"class":583},"listForSubscription",[511,768,769],{"class":524},"($",[511,771,772],{"class":528},"subscription",[511,774,541],{"class":524},[511,776,777],{"class":528},"vatly_id",[511,779,780],{"class":524},");\n",[511,782,783,785,788,790,793,795,798,800,804,807,809,812,815,817,819,821,824,827,829,832],{"class":513,"line":557},[511,784,525],{"class":524},[511,786,787],{"class":528},"orderIds ",[511,789,532],{"class":524},[511,791,792],{"class":583}," array_unique",[511,794,751],{"class":524},[511,796,797],{"class":583},"array_map",[511,799,751],{"class":524},[511,801,803],{"class":802},"spNyl","fn",[511,805,806],{"class":524}," ($",[511,808,513],{"class":528},[511,810,811],{"class":524},")",[511,813,814],{"class":524}," =>",[511,816,535],{"class":524},[511,818,513],{"class":528},[511,820,541],{"class":524},[511,822,823],{"class":583},"getOrderId",[511,825,826],{"class":524},"(),",[511,828,535],{"class":524},[511,830,831],{"class":528},"lines",[511,833,834],{"class":524},"));\n",[492,836,837,839,840,843,844,696,846,848,849,852],{},[508,838,687],{}," is null on one-off lines, on lines Vatly created before it carried the link, and on a signup line whose subscription was not yet available when the order was paid. Lines are written once, so such a line stays unlinked. ",[508,841,842],{},"listForSubscription()"," also returns renewal lines whose ",[508,845,695],{},[508,847,772],{}," and ",[508,850,851],{},"product_id"," is the subscription id, so renewals stored without the link still appear.",[492,854,662,855,666,857,670,860,659],{},[508,856,665],{},[508,858,859],{},"add_subscription_id_to_vatly_order_lines_table",[508,861,673],{},[496,863,865],{"id":864},"how-it-works","How it works",[492,867,868,869,872],{},"Orders are synced from Vatly via webhooks. The ",[508,870,871],{},"orders()"," relationship returns all orders associated with the billable model through a polymorph