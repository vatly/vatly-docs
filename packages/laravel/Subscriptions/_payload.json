;\n\nreturn redirect($checkout->links->checkoutUrl->href);\n","php",[204,205,206,238,262,273,280],"code",{"__ignoreMap":105},[207,208,211,215,219,222,225,228,231,235],"span",{"class":209,"line":210},"line",1,[207,212,214],{"class":213},"sMK4o","$",[207,216,218],{"class":217},"sTEyZ","checkout ",[207,220,221],{"class":213},"=",[207,223,224],{"class":213}," $",[207,226,227],{"class":217},"user",[207,229,230],{"class":213},"->",[207,232,234],{"class":233},"s2Zo4","subscribe",[207,236,237],{"class":213},"()\n",[207,239,241,244,247,250,253,257,259],{"class":209,"line":240},2,[207,242,243],{"class":213},"    ->",[207,245,246],{"class":233},"toPlan",[207,248,249],{"class":213},"(",[207,251,252],{"class":213},"'",[207,254,256],{"class":255},"sfazB","subscription_plan_annual",[207,258,252],{"class":213},[207,260,261],{"class":213},")\n",[207,263,265,267,270],{"class":209,"line":264},3,[207,266,243],{"class":213},[207,268,269],{"class":233},"create",[207,271,272],{"class":213},"();\n",[207,274,276],{"class":209,"line":275},4,[207,277,279],{"emptyLinePlaceholder":278},true,"\n",[207,281,283,287,290,293,296,298,301,303,306,308,311],{"class":209,"line":282},5,[207,284,286],{"class":285},"s7zQu","return",[207,288,289],{"class":233}," redirect",[207,291,292],{"class":213},"($",[207,294,295],{"class":217},"checkout",[207,297,230],{"class":213},[207,299,300],{"class":217},"links",[207,302,230],{"class":213},[207,304,305],{"class":217},"checkoutUrl",[207,307,230],{"class":213},[207,309,310],{"class":217},"href",[207,312,313],{"class":213},");\n",[315,316,318],"h3",{"id":317},"with-a-free-trial","With a free trial",[189,320,321],{},"Trials defer the first charge until the trial elapses. Set them on the builder, in whole days or by end date:",[198,323,325],{"className":200,"code":324,"language":202,"meta":105,"style":105},"// Whole days from checkout creation\n$user->subscribe()\n    ->toPlan('subscription_plan_annual')\n    ->withTrialDays(14)\n    ->create();\n\n// Or an end date — t