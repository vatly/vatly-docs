_annual');\n\n// Swap and invoice immediately (prorated)\n$user->subscription()->swapAndInvoice('subscription_plan_annual');\n",[204,716,717,722,746,750,755],{"__ignoreMap":105},[207,718,719],{"class":209,"line":210},[207,720,721],{"class":331},"// Swap to a new plan\n",[207,723,724,726,728,730,732,734,736,738,740,742,744],{"class":209,"line":240},[207,725,214],{"class":213},[207,727,227],{"class":217},[207,729,230],{"class":213},[207,731,558],{"class":233},[207,733,446],{"class":213},[207,735,635],{"class":233},[207,737,249],{"class":213},[207,739,252],{"class":213},[207,741,256],{"class":255},[207,743,252],{"class":213},[207,745,313],{"class":213},[207,747,748],{"class":209,"line":264},[207,749,279],{"emptyLinePlaceholder":278},[207,751,752],{"class":209,"line":275},[207,753,754],{"class":331},"// Swap and invoice immediately (prorated)\n",[207,756,757,759,761,763,765,767,770,772,774,776,778],{"class":209,"line":282},[207,758,214],{"class":213},[207,760,227],{"class":217},[207,762,230],{"class":213},[207,764,558],{"class":233},[207,766,446],{"class":213},[207,768,769],{"class":233},"swapAndInvoice",[207,771,249],{"class":213},[207,773,252],{"class":213},[207,775,256],{"class":255},[207,777,252],{"class":213},[207,779,313],{"class":213},[193,781,783],{"id":782},"canceling","Canceling",[198,785,787],{"className":200,"code":786,"language":202,"meta":105,"style":105},"// Cancel the subscription at Vatly\n$user->subscription()->cancel();\n",[204,788,789,794],{"__ignoreMap":105},[207,790,791],{"class":209,"line":210},[207,792,793],{"class":331},"// Cancel the subscription at Vatly\n",[207,795,796,798,800,802,804,806,808],{"class":209,"line":240},[207,797,214],{"class":213},[207,799,227],{"class":217},[207,801,230],{"class":213},[207,803,558],{"class":233},[207,805,446],{"class":213},[207,807,639],{"class":233},[207,809,272],{"class":213},[189,811,812],{},"The actual cancellation is processed via webhooks. Depending on the Vatly configuration, the subscription may:",[814