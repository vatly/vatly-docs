cript\u002F9.webhooks",{"title":233,"path":234,"stem":235,"children":236,"page":57},"Fluent Js","\u002Fpackages\u002Ffluent-js","3.packages\u002F4.fluent-js",[237],{"title":124,"path":238,"stem":239},"\u002Fpackages\u002Ffluent-js\u002Freadme","3.packages\u002F4.fluent-js\u002F0.readme",{"title":241,"path":242,"stem":243},"Integrations","\u002Fintegrations","4.integrations",{"id":245,"title":182,"body":246,"description":1427,"extension":1428,"links":1429,"meta":1430,"navigation":712,"path":183,"seo":1431,"stem":184,"__hash__":1432},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":247,"value":248,"toc":1420},"minimark",[249,280,306,316,319,324,628,631,660,662,666,672,754,1184,1193,1195,1199,1202,1313,1316,1318,1322,1329,1350,1358,1360,1364,1402,1416],[250,251,252,253,257,258,261,262,265,266,270,271,275,276,279],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[254,255,256],"code",{},"Billable"," trait, ",[254,259,260],{},"subscribed()",",\n",[254,263,264],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[267,268,269],"em",{},"behind","\nthe API: Vatly is a ",[272,273,274],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[272,277,278],{},"Europe-first",", operating under EU\njurisdiction.",[250,281,282,283,286,287,261,294,299,300,305],{},"This page is an honest, side-by-side look at how ",[254,284,285],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[288,289,293],"a",{"href":290,"rel":291},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[292],"nofollow","Laravel Cashier (Stripe)",[288,295,298],{"href":296,"rel":297},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[292],"Laravel Cashier (Paddle)",", and\n",[288,301,304],{"href":302,"rel":303},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[292],"Lemon Squeezy for Laravel"," — gaps included.",[307,308,309,312,313,315],"note",{},[272,310,311],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[288,314,186],{"href":187}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[317,318],"hr",{},[320,321,323],"h2",{"id":322},"at-a-glance","At a glance",[325,326,327,350],"table",{},[328,329,330],"thead",{},[331,332,333,336,339,342,345],"tr",{},[334,335],"th",{},[334,337,338],{},"Cashier (Stripe Billing)",[334,340,341],{},"Cashier (Paddle)",[334,343,344],{},"Lemon Squeezy",[334,346,347],{},[272,348,349],{},"Vatly",[351,352,353,379,404,424,453,476,513,537,562,579,595,613],"tbody",{},[331,354,355,359,364,369,374],{},[356,357,358],"td",{},"Composer package",[356,360,361],{},[254,362,363],{},"laravel\u002Fcashier",[356,365,366],{},[254,367,368],{},"laravel\u002Fcashier-paddle",[356,370,371],{},[254,372,373],{},"lemonsqueezy\u002Flaravel",[356,375,376],{},[254,377,378],{},"vatly\u002Fvatly-laravel",[331,380,381,384,389,394,399],{},[356,382,383],{},"Billable trait",[356,385,386],{},[254,387,388],{},"Laravel\\Cashier\\Billable",[356,390,391],{},[254,392,393],{},"Laravel\\Paddle\\Billable",[356,395,396],{},[254,397,398],{},"LemonSqueezy\\Laravel\\Billable",[356,400,401],{},[254,402,403],{},"Vatly\\Laravel\\Billable",[331,405,406,408,414,417,419],{},[356,407,274],{},[356,409,410,413],{},[272,411,412],{},"No"," — you are the seller",[356,415,416],{},"Yes",[356,418,416],{},[356,420,421],{},[272,422,423],{},"Yes (full)",[331,425,426,429,435,441,448],{},[356,427,428],{},"Entity \u002F jurisdiction",[356,430,431,434],{},[267,432,433],{},"You"," (wherever you're registered)",[356,436,437,438],{},"Paddle, ",[272,439,440],{},"UK",[356,442,443,444,447],{},"Lemon Squeezy, ",[272,445,446],{},"US"," (Stripe-owned)",[356,449,450],{},[272,451,452],{},"EEA \u002F EU jurisdiction",[331,454,455,458,467,470,472],{},[356,456,457],{},"Who remits VAT\u002Fsales tax",[356,459,460,462,463,466],{},[272,461,433],{}," (Stripe Tax only ",[267,464,465],{},"calculates",")",[356,468,469],{},"Provider",[356,471,469],{},[356,473,474],{},[272,475,469],{},[331,477,478,481,488,497,503],{},[356,479,480],{},"Customer stored as",[356,482,483,484,487],{},"columns on the billable model (",[254,485,486],{},"stripe_id",", …)",[356,489,490,493,494,466],{},[254,491,492],{},"customers"," table (",[254,495,496],{},"paddle_id",[356,498,499,502],{},[254,500,501],{},"lemon_squeezy_customers"," table",[356,504,505,508,509,512],{},[254,506,507],{},"vatly_id"," column on the billable model + ",[254,510,511],{},"vatly_*"," tables",[331,514,515,518,521,528,531],{},[356,516,517],{},"Checkout",[356,519,520],{},"Stripe Checkout (hosted) \u002F Elements",[356,522,523,524,527],{},"Paddle.js ",[272,525,526],{},"overlay \u002F inline"," (client-side JS)",[356,529,530],{},"Lemon.js overlay \u002F hosted URL",[356,532,533,536],{},[272,534,535],{},"Vatly-hosted redirect"," (+ guest claim)",[331,538,539,542,547,552,557],{},[356,540,541],{},"Webhook route",[356,543,544],{},[254,545,546],{},"\u002Fstripe\u002Fwebhook",[356,548,549],{},[254,550,551],{},"\u002Fpaddle\u002Fwebhook",[356,553,554],{},[254,555,556],{},"\u002Flemon-squeezy\u002Fwebhook",[356,558,559],{},[254,560,561],{},"\u002Fwebhooks\u002Fvatly",[331,563,564,567,569,571,573],{},[356,565,566],{},"Coupons \u002F promo codes",[356,568,416],{},[356,570,416],{},[356,572,416],{},[356,574,575,578],{},[272,576,577],{},"On the roadmap"," (workaround below)",[331,580,581,584,586,588,590],{},[356,582,583],{},"License keys",[356,585,412],{},[356,587,412],{},[356,589,416],{},[356,591,592,594],{},[272,593,577],{}," (rarely needed for SaaS)",[331,596,597,600,603,606,608],{},[356,598,599],{},"Refunds & chargebacks",[356,601,602],{},"wire it yourself",[356,604,605],{},"events",[356,607,605],{},[356,609,610],{},[272,611,612],{},"first-class models + events",[331,614,615,618,620,622,624],{},[356,616,617],{},"Trials, swap, grace\u002Fresume",[356,619,416],{},[356,621,416],{},[356,623,416],{},[356,625,626],{},[272,627,416],{},[250,629,630],{},"Two takeaways:",[632,633,634,654],"ol",{},[635,636,637,647,648,653],"li",{},[272,638,639,640,642,643,646],{},"With ",[254,641,363],{},", ",[267,644,645],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[288,649,652],{"href":650,"rel":651},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[292],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[635,655,656,659],{},[272,657,658],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[317,661],{},[320,663,665],{"id":664},"the-developer-experience","The developer experience",[250,667,668,669,671],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[254,670,256],{}," trait, and\nthe code reads like Cashier:",[673,674,679],"pre",{"className":675,"code":676,"language":677,"meta":678,"style":678},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[254,680,681,707,714,731,737,748],{"__ignoreMap":678},[682,683,686,690,694,698,700,702,704],"span",{"class":684,"line":685},"line",1,[682,687,689],{"class":688},"sbssI","use",[682,691,693],{"class":692},"sTEyZ"," Vatly",[682,695,697],{"class":696},"sMK4o","\\",[682,699,159],{"class":692},[682,701,697],{"class":696},[682,703,256],{"class":692},[682,705,706],{"class":696},";\n",[682,708,710],{"class":684,"line":709},2,[682,711,713],{"emptyLinePlaceholder":712},true,"\n",[682,715,717,721,725,728],{"class":684,"line":716},3,[682,718,720],{"class":719},"spNyl","class",[682,722,724],{"class":723},"sBMFI"," User",[682,726,727],{"class":719}," extends",[682,729,730],{"class":723}," Authenticatable\n",[682,732,734],{"class":684,"line":733},4,[682,735,736],{"class":696},"{\n",[682,738,740,743,746],{"class":684,"line":739},5,[682,741,742],{"class":688},"    use",[682,744,745],{"class":692}," Billable",[682,747,706],{"class":696},[682,749,751],{"class":684,"line":750},6,[682,752,753],{"class":696},"}\n",[673,755,757],{"className":675,"code":756,"language":677,"meta":678,"style":678},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[254,758,759,765,792,815,829,839,843,877,882,888,910,916,921,926,955,977,998,1003,1009,1027,1075,1098,1119,1124,1129,1135,1162,1179],{"__ignoreMap":678},[682,760,761],{"class":684,"line":685},[682,762,764],{"class":763},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[682,76