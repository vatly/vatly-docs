stem":151},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Side-by-side billing","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Comparison","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Integrations","/integrations","4.integrations",{"id":184,"title":172,"body":185,"description":1418,"extension":1419,"links":1420,"meta":1421,"navigation":703,"path":173,"seo":1422,"stem":174,"__hash__":1423},"docs/3.packages/2.laravel/99.comparison.md",{"type":186,"value":187,"toc":1411},"minimark",[188,219,245,259,262,267,571,574,652,654,658,664,745,1175,1184,1186,1190,1193,1303,1306,1308,1312,1319,1340,1347,1349,1353,1393,1407],[189,190,191,192,196,197,200,201,204,205,209,210,214,215,218],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[193,194,195],"code",{},"Billable"," trait, ",[193,198,199],{},"subscribed()",",\n",[193,202,203],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[206,207,208],"em",{},"behind","\nthe API: Vatly is a ",[211,212,213],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[211,216,217],{},"Europe-first",", operating under EU\njurisdiction.",[189,220,221,222,225,226,200,233,238,239,244],{},"This page is an honest, side-by-side look at how ",[193,223,224],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[227,228,232],"a",{"href":229,"rel":230},"https://laravel.com/docs/12.x/billing",[231],"nofollow","Laravel Cashier (Stripe)",[227,234,237],{"href":235,"rel":236},"https://laravel.com/docs/12.x/cashier-paddle",[231],"Laravel Cashier (Paddle)",", and\n",[227,240,243],{"href":241,"rel":242},"https://github.com/lmsqueezy/laravel",[231],"Lemon Squeezy for Laravel"," — gaps included.",[246,247,248],"blockquote",{},[189,249,250,253,254,258],{},[211,251,252],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[227,255,257],{"href":256},"Coexisting-with-Cashier","Running alongside another provider"," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[260,261],"hr",{},[263,264,266],"h2",{"id":265},"at-a-glance","At a glance",[268,269,270,293],"table",{},[271,272,273],"thead",{},[274,275,276,279,282,285,288],"tr",{},[277,278],"th",{},[277,280,281],{},"Cashier (Stripe Billing)",[277,283,284],{},"Cashier (Paddle)",[277,286,287],{},"Lemon Squeezy",[277,289,290],{},[211,291,292],{},"Vatly",[294,295,296,322,347,367,396,419,456,480,505,522,538,556],"tbody",{},[274,297,298,302,307,312,317],{},[299,300,301],"td",{},"Composer package",[299,303,304],{},[193,305,306],{},"laravel/cashier",[299,308,309],{},[193,310,311],{},"laravel/cashier-paddle",[299,313,314],{},[193,315,316],{},"lemonsqueezy/laravel",[299,318,319],{},[193,320,321],{},"vatly/vatly-laravel",[274,323,324,327,332,337,342],{},[299,325,326],{},"Billable trait",[299,328,329],{},[193,330,331],{},"Laravel\\Cashier\\Billable",[299,333,334],{},[193,335,336],{},"Laravel\\Paddle\\Billable",[299,338,339],{},[193,340,341],{},"LemonSqueezy\\Laravel\\Billable",[299,343,344],{},[193,345,346],{},"Vatly\\Laravel\\Billable",[274,348,349,351,357,360,362],{},[299,350,213],{},[299,352,353,356],{},[211,354,355],{},"No"," — you are the seller",[299,358,359],{},"Yes",[299,361,359],{},[299,363,364],{},[211,365,366],{},"Yes (full)",[274,368,369,372,378,384,391],{},[299,370,371],{},"Entity / jurisdiction",[299,373,374,377],{},[206,375,376],{},"You"," (wherever you're registered)",[299,379,380,381],{},"Paddle, ",[211,382,383],{},"UK",[299,385,386,387,390],{},"Lemon Squeezy, ",[211,388,389],{},"US"," (Stripe-owned)",[299,392,393],{},[211,394,395],{},"EEA / EU jurisdiction",[274,397,398,401,410,413,415],{},[299,399,400],{},"Who remits VAT/sales tax",[299,402,403,405,406,409],{},[211,404,376],{}," (Stripe Tax only ",[206,407,408],{},"calculates",")",[299,411,412],{},"Provider",[299,414,412],{},[299,416,417],{},[211,418,412],{},[274,420,421,424,431,440,446],{},[299,422,423],{},"Customer stored as",[299,425,426,427,430],{},"columns on the billable model (",[193,428,429],{},"stripe_id",", …)",[299,432,433,436,437,409],{},[193,434,435],{},"customers"," table (",[193,438,439],{},"paddle_id",[299,441,442,445],{},[193,443,444],{},"lemon_squeezy_customers"," table",[299,447,448,451,452,455],{},[193,449,450],{},"vatly_id"," column on the billable model + ",[193,453,454],{},"vatly_*"," tables",[274,457,458,461,464,471,474],{},[299,459,460],{},"Checkout",[299,462,463],{},"Stripe Checkout (hosted) / Elements",[299,465,466,467,470],{},"Paddle.js ",[211,468,469],{},"overlay / inline"," (client-side JS)",[299,472,473],{},"Lemon.js overlay / hosted URL",[299,475,476,479],{},[211,477,478],{},"Vatly-hosted redirect"," (+ guest claim)",[274,481,482,485,490,495,500],{},[299,483,484],{},"Webhook route",[299,486,487],{},[193,488,489],{},"/stripe/webhook",[299,491,492],{},[193,493,494],{},"/paddle/webhook",[299,496,497],{},[193,498,499],{},"/lemon-squeezy/webhook",[299,501,502],{},[193,503,504],{},"/webhooks/vatly",[274,506,507,510,512,514,516],{},[299,508,509],{},"Coupons / promo codes",[299,511,359],{},[299,513,359],{},[299,515,359],{},[299,517,518,521],{},[211,519,520],{},"On the roadmap"," (workaround below)",[274,523,524,527,529,531,533],{},[299,525,526],{},"License keys",[299,528,355],{},[299,530,355],{},[299,532,359],{},[299,534,535,537],{},[211,536,520],{}," (rarely needed for SaaS)",[274,539,540,543,546,549,551],{},[299,541,542],{},"Refunds & chargebacks",[299,544,545],{},"wire it yourself",[299,547,548],{},"events",[299,550,548],{},[299,552,553],{},[211,554,555],{},"first-class models + events",[274,557,558,561,563,565,567],{},[299,559,560],{},"Trials, swap, grace/resume",[299,562,359],{},[299,564,359],{},[299,566,359],{},[299,568,569],{},[211,570,359],{},[189,572,573],{},"Three things to take from this table:",[575,576,577,605,646],"ol",{},[578,579,580,583,584,586,587,590,591,594,595,600,601,604],"li",{},[211,581,582],{},"The Laravel Cashier (Stripe) package is not a Merchant-of-Record path."," ",[193,585,306],{},"\ndrives ",[206,588,589],{},"classic Stripe Billing",", where ",[211,592,593],{},"you"," are the seller of record: you register for\nVAT/sales tax wherever you cross a threshold, you file, you remit, you issue compliant\ninvoices. ",[227,596,599],{"href":597,"rel":598},"https://stripe.com/tax",[231],"Stripe Tax"," (",[193,602,603],{},"Cashier::calculateTaxes()",") computes the\nrate; the legal and operational burden stays with you. Paddle, Lemon Squeezy and Vatly are\nthe seller instead.",[578,606,607,620,621,624,625,628,629,632,633,636,637,639,640,645],{},[211,608,609,610,613,614,619],{},"Stripe ",[206,611,612],{},"the company"," does now offer an MoR — ",[227,615,618],{"href":616,"rel":617},"https://stripe.com/managed-payments",[231],"Stripe Managed Payments"," —\nbut it's a different product, not the Cashier you're running."," It withholds VAT/GST/sales tax\nacross 80+ countries and takes on fraud, disputes and transaction support. Three things to know\nbefore you lean on it: you reach it through ",[206,622,623],{},"Stripe Checkout / Payment Links"," with\n",[193,626,627],{},"managed_payments"," enabled, ",[211,630,631],{},"not"," through Cashier's subscription API today; Stripe itself\ndescribes it as not yet a ",[206,634,635],{},"complete"," MoR (you stay responsible in unsupported territories and\nfor parts of dispute/refund handling); and it's a ",[211,638,389],{}," company's offering — it's also where\n",[227,641,644],{"href":642,"rel":643},"https://www.lemonsqueezy.com/blog/2026-update",[231],"Lemon Squeezy is being folded in",".",[578,647,648,651],{},[211,649,650],{},"Among the MoRs, the deciding difference is where the entity sits."," Paddle is UK-based;\nLemon Squeezy and Stripe Managed Payments are US. Vatly is EEA-based, under EU jurisdiction —\nyour customer data and your seller-of-record relationship stay in Europe. That, not the API,\nis the reason to choose one over another.",[260,653],{},[263,655,657],{"id":656},"the-developer-experience","The developer experience",[189,659,660,661,663],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[193,662,195],{}," trait, and\nthe code reads like Cashier:",[665,666,670],"pre",{"className":667,"code":668,"language":669,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[193,671,672,698,705,722,728,739],{"__ignoreMap":105},[673,674,677,681,685,689,691,693,695],"span",{"class":675,"line":676},"line",1,[673,678,680],{"class":679},"sbssI","use",[673,682,684],{"class":683},"sTEyZ"," Vatly",[673,686,688],{"class":687},"sMK4o","\\",[673,690,145],{"class":683},[673,692,688],{"class":687},[673,694,195],{"class":683},[673,696,697],{"class":687},";\n",[673,699,701],{"class":675,"line":700},2,[673,702,704],{"emptyLinePlaceholder":703},true,"\n",[673,706,708,712,716,719],{"class":675,"line":707},3,[673,709,711],{"class":710},"spNyl","class",[673,713,715],{"class":714},"sBMFI"," User",[673,717,718],{"class":710}," extends",[673,720,721],{"class":714}," Authenticatable\n",[673,723,725],{"class":675,"line":724},4,[673,726,727],{"class":687},"{\n",[673,729,731,734,737],{"class":675,"line":730},5,[673,732,733],{"class":679},"    use",[673,735,736],{"class":683}," Billable",[673,738,697],{"class":687},[673,740,742],{"class":675,"line":741},6,[673,743,744],{"class":687},"}\n",[665,746,748],{"className":667,"code":747,"language":669,"meta":105,"style":105},"// Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n// Gate features on subscription state\nif ($user->subscribed()) {\n    // …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      // Vatly decides immediate vs. grace\n$user->subscription()->resume();      // while on the grace period\n\n// One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n// Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[193,749,750,756,783,806,820,830,834,868,873,879,901,907,912,917,946,968,989,994,1000,1018,1066,1089,1110,1115,1120,1126,1153,1170],{"__ignoreMap":105},[673,751,752],{"class":675,"line":676},[673,753,755],{"class":754},"sHwdD","// Start a subscription — redirect to Vatly's hosted checkout\n",[673,757,758,761,764,767,770,773,776,780],{"class":675,"line":700},[673,759,760],{"class":687},"$",[673,762,763],{"class":683},"checkout ",[673,765,766],{"class":687},"=",[673,768,769],{"class":687}," $",[673,771,772],{"class":683},"user",[673,774,775],{"class"