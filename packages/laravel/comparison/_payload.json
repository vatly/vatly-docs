75,479,480,483,484,487,488,492,493,497,498,501],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[476,477,478],"code",{},"Billable"," trait, ",[476,481,482],{},"subscribed()",",\n",[476,485,486],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[489,490,491],"em",{},"behind","\nthe API: Vatly is a ",[494,495,496],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[494,499,500],{},"Europe-first",", operating under EU\njurisdiction.",[472,503,504,505,508,509,483,516,521,522,527],{},"This page is an honest, side-by-side look at how ",[476,506,507],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[510,511,515],"a",{"href":512,"rel":513},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[514],"nofollow","Laravel Cashier (Stripe)",[510,517,520],{"href":518,"rel":519},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[514],"Laravel Cashier (Paddle)",", and\n",[510,523,526],{"href":524,"rel":525},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[514],"Lemon Squeezy for Laravel"," — gaps included.",[529,530,531,534,535,537],"note",{},[494,532,533],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[510,536,241],{"href":242}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[539,540],"hr",{},[542,543,545],"h2",{"id":544},"at-a-glance","At a glance",[547,548,549,572],"table",{},[550,551,552],"thead",{},[553,554,555,558,561,564,567],"tr",{},[556,557],"th",{},[556,559,560],{},"Cashier (Stripe Billing)",[556,562,563],{},"Cashier (Paddle)",[556,565,566],{},"Lemon Squeezy",[556,568,569],{},[494,570,571],{},"Vatly",[573,574,575,601,626,646,675,698,735,758,783,800,816,834],"tbody",{},[553,576,577,581,586,591,596],{},[578,579,580],"td",{},"Composer package",[578,582,583],{},[476,584,585],{},"laravel\u002Fcashier",[578,587,588],{},[476,589,590],{},"laravel\u002Fcashier-paddle",[578,592,593],{},[476,594,595],{},"lemonsqueezy\u002Flaravel",[578,597,598],{},[476,599,600],{},"vatly\u002Fvatly-laravel",[553,602,603,606,611,616,621],{},[578,604,605],{},"Billable trait",[578,607,608],{},[476,609,610],{},"Laravel\\Cashier\\Billable",[578,612,613],{},[476,614,615],{},"Laravel\\Paddle\\Billable",[578,617,618],{},[476,619,620],{},"LemonSqueezy\\Laravel\\Billable",[578,622,623],{},[476,624,625],{},"Vatly\\Laravel\\Billable",[553,627,628,630,636,639,641],{},[578,629,496],{},[578,631,632,635],{},[494,633,634],{},"No"," — you are the seller",[578,637,638],{},"Yes",[578,640,638],{},[578,642,643],{},[494,644,645],{},"Yes (full)",[553,647,648,651,657,663,670],{},[578,649,650],{},"Entity \u002F jurisdiction",[578,652,653,656],{},[489,654,655],{},"You"," (wherever you're registered)",[578,658,659,660],{},"Paddle, ",[494,661,662],{},"UK",[578,664,665,666,669],{},"Lemon Squeezy, ",[494,667,668],{},"US"," (Stripe-owned)",[578,671,672],{},[494,673,674],{},"EEA \u002F EU jurisdiction",[553,676,677,680,689,692,694],{},[578,678,679],{},"Who remits VAT\u002Fsales tax",[578,681,682,684,685,688],{},[494,683,655],{}," (Stripe Tax only ",[489,686,687],{},"calculates",")",[578,690,691],{},"Provider",[578,693,691],{},[578,695,696],{},[494,697,691],{},[553,699,700,703,710,719,725],{},[578,701,702],{},"Customer stored as",[578,704,705,706,709],{},"columns on the billable model (",[476,707,708],{},"stripe_id",", …)",[578,711,712,715,716,688],{},[476,713,714],{},"customers"," table (",[476,717,718],{},"paddle_id",[578,720,721,724],{},[476,722,723],{},"lemon_squeezy_customers"," table",[578,726,727,730,731,734],{},[476,728,729],{},"vatly_id"," column on the billable model + ",[476,732,733],{},"vatly_*"," tables",[553,736,737,739,742,749,752],{},[578,738,428],{},[578,740,741],{},"Stripe Checkout (hosted) \u002F Elements",[578,743,744,745,748],{},"Paddle.js ",[494,746,747],{},"overlay \u002F inline"," (client-side JS)",[578,750,751],{},"Lemon.js overlay \u002F hosted URL",[578,753,754,757],{},[494,755,756],{},"Vatly-hosted redirect"," (+ guest claim)",[553,759,760,763,768,773,778],{},[578,761,762],{},"Webhook route",[578,764,765],{},[476,766,767],{},"\u002Fstripe\u002Fwebhook",[578,769,770],{},[476,771,772],{},"\u002Fpaddle\u002Fwebhook",[578,774,775],{},[476,776,777],{},"\u002Flemon-squeezy\u002Fwebhook",[578,779,780],{},[476,781,782],{},"\u002Fwebhooks\u002Fvatly",[553,784,785,788,790,792,794],{},[578,786,787],{},"Coupons \u002F promo codes",[578,789,638],{},[578,791,638],{},[578,793,638],{},[578,795,796,799],{},[494,797,798],{},"On the roadmap"," (workaround below)",[553,801,802,805,807,809,811],{},[578,803,804],{},"License keys",[578,806,634],{},[578,808,634],{},[578,810,638],{},[578,812,813,815],{},[494,814,798],{}," (rarely needed for SaaS)",[553,817,818,821,824,827,829],{},[578,819,820],{},"Refunds & chargebacks",[578,822,823],{},"wire it yourself",[578,825,826],{},"events",[578,828,826],{},[578,830,831],{},[494,832,833],{},"first-class models + events",[553,835,836,839,841,843,845],{},[578,837,838],{},"Trials, swap, grace\u002Fresume",[578,840,638],{},[578,842,638],{},[578,844,638],{},[578,846,847],{},[494,848,638],{},[472,850,851],{},"Two takeaways:",[853,854,855,875],"ol",{},[856,857,858,868,869,874],"li",{},[494,859,860,861,863,864,867],{},"With ",[476,862,585],{},", ",[489,865,866],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[510,870,873],{"href":871,"rel":872},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[514],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[856,876,877,880],{},[494,878,879],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[539,882],{},[542,884,886],{"id":885},"the-developer-experience","The developer experience",[472,888,889,890,892],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[476,891,478],{}," trait, and\nthe code reads like Cashier:",[894,895,900],"pre",{"className":896,"code":897,"language":898,"meta":899,"style":899},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[476,901,902,928,935,952,958,969],{"__ignoreMap":899},[903,904,907,911,915,919,921,923,925],"span",{"class":905,"line":906},"line",1,[903,908,910],{"class":909},"sbssI","use",[903,912,914],{"class":913},"sTEyZ"," Vatly",[903,916,918],{"class":917},"sMK4o","\\",[903,920,211],{"class":913},[903,922,918],{"class":917},[903,924,478],{"class":913},[903,926,927],{"class":917},";\n",[903,929,931],{"class":905,"line":930},2,[903,932,934],{"emptyLinePlaceholder":933},true,"\n",[903,936,938,942,946,949],{"class":905,"line":937},3,[903,939,941],{"class":940},"spNyl","class",[903,943,945],{"class":944},"sBMFI"," User",[903,947,948],{"class":940}," extends",[903,950,951],{"class":944}," Authenticatable\n",[903,953,955],{"class":905,"line":954},4,[903,956,957],{"class":917},"{\n",[903,959,961,964,967],{"class":905,"line":960},5,[903,962,963],{"class":909},"    use",[903,965,966],{"class":913}," Billable",[903,968,927],{"class":917},[903,970,972],{"class":905,"line":971},6,[903,973,974],{"class":917},"}\n",[894,976,978],{"className":896,"code":977,"language":898,"meta":899,"style":899},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[476,979,980,986,1013,1036,1050,1060,1064,1098,1103,1109,1131,1137,1142,1147,1176,1198,1219,1224,1230,1248,1296,1319,1340,1345,1350,1356,1383,1400],{"__ignoreMap":899},[903,981,982],{"class":905,"line":906},[903,983,985],{"class":984},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[903,987,988,991,994,997,1000,1003,1006,1010],{"class":905,"line":930},[903,989,990],{"class":917},"$",[903,992,993],{"class":913},"checkout ",[903,995,996],{"class":917},"=",[903,998,999],{"class":917}," $",[903,1001,1002],{"class":913},"user",[903,1004,1005],{"class":917},"->",[903,1007,1009],{"class":1008},"s2Zo4","subscribe",[903,1011,1012],{"class":917},"()\n",[903,1014,1015,1018,1021,1024,1027,1031,1033],{"class":905,"line":937},[903,1016,1017],{"class":917},"    ->",[903,1019,1020],{"class":1008},"toPlan",[903,1022,1023],{"class":917},"(",[903,1025,1026],{"class":917},"'",[903,1028,1030],{"class":1029},"sfazB","subscription_plan_7Hd9Kf2Lm",[903,1032,1026],{"class":917},[903,1034,1035],{"class":917},")\n",[903,1037,1038,1040,1043,1045,1048],{"class":905,"line":954},[903,1039,101