n":152,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[153,156,159,162,165,168,171,175,179],{"title":117,"path":154,"stem":155},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":157,"stem":158},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":160,"stem":161},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":163,"stem":164},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":166,"stem":167},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":169,"stem":170},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":176,"path":177,"stem":178},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":180,"path":181,"stem":182},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":184,"path":185,"stem":186},"Integrations","/integrations","4.integrations",{"id":188,"title":172,"body":189,"description":1369,"extension":1370,"links":1371,"meta":1372,"navigation":655,"path":173,"seo":1373,"stem":174,"__hash__":1374},"docs/3.packages/2.laravel/6.comparison.md",{"type":190,"value":191,"toc":1362},"minimark",[192,223,249,261,264,269,573,576,604,606,610,616,697,1127,1136,1138,1142,1145,1256,1259,1261,1265,1272,1293,1300,1302,1306,1344,1358],[193,194,195,196,200,201,204,205,208,209,213,214,218,219,222],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[197,198,199],"code",{},"Billable"," trait, ",[197,202,203],{},"subscribed()",",\n",[197,206,207],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[210,211,212],"em",{},"behind","\nthe API: Vatly is a ",[215,216,217],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[215,220,221],{},"Europe-first",", operating under EU\njurisdiction.",[193,224,225,226,229,230,204,237,242,243,248],{},"This page is an honest, side-by-side look at how ",[197,227,228],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[231,232,236],"a",{"href":233,"rel":234},"https://laravel.com/docs/12.x/billing",[235],"nofollow","Laravel Cashier (Stripe)",[231,238,241],{"href":239,"rel":240},"https://laravel.com/docs/12.x/cashier-paddle",[235],"Laravel Cashier (Paddle)",", and\n",[231,244,247],{"href":245,"rel":246},"https://github.com/lmsqueezy/laravel",[235],"Lemon Squeezy for Laravel"," — gaps included.",[250,251,252],"blockquote",{},[193,253,254,257,258,260],{},[215,255,256],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[231,259,176],{"href":177}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[262,263],"hr",{},[265,266,268],"h2",{"id":267},"at-a-glance","At a glance",[270,271,272,295],"table",{},[273,274,275],"thead",{},[276,277,278,281,284,287,290],"tr",{},[279,280],"th",{},[279,282,283],{},"Cashier (Stripe Billing)",[279,285,286],{},"Cashier (Paddle)",[279,288,289],{},"Lemon Squeezy",[279,291,292],{},[215,293,294],{},"Vatly",[296,297,298,324,349,369,398,421,458,482,507,524,540,558],"tbody",{},[276,299,300,304,309,314,319],{},[301,302,303],"td",{},"Composer package",[301,305,306],{},[197,307,308],{},"laravel/cashier",[301,310,311],{},[197,312,313],{},"laravel/cashier-paddle",[301,315,316],{},[197,317,318],{},"lemonsqueezy/laravel",[301,320,321],{},[197,322,323],{},"vatly/vatly-laravel",[276,325,326,329,334,339,344],{},[301,327,328],{},"Billable trait",[301,330,331],{},[197,332,333],{},"Laravel\\Cashier\\Billable",[301,335,336],{},[197,337,338],{},"Laravel\\Paddle\\Billable",[301,340,341],{},[197,342,343],{},"LemonSqueezy\\Laravel\\Billable",[301,345,346],{},[197,347,348],{},"Vatly\\Laravel\\Billable",[276,350,351,353,359,362,364],{},[301,352,217],{},[301,354,355,358],{},[215,356,357],{},"No"," — you are the seller",[301,360,361],{},"Yes",[301,363,361],{},[301,365,366],{},[215,367,368],{},"Yes (full)",[276,370,371,374,380,386,393],{},[301,372,373],{},"Entity / jurisdiction",[301,375,376,379],{},[210,377,378],{},"You"," (wherever you're registered)",[301,381,382,383],{},"Paddle, ",[215,384,385],{},"UK",[301,387,388,389,392],{},"Lemon Squeezy, ",[215,390,391],{},"US"," (Stripe-owned)",[301,394,395],{},[215,396,397],{},"EEA / EU jurisdiction",[276,399,400,403,412,415,417],{},[301,401,402],{},"Who remits VAT/sales tax",[301,404,405,407,408,411],{},[215,406,378],{}," (Stripe Tax only ",[210,409,410],{},"calculates",")",[301,413,414],{},"Provider",[301,416,414],{},[301,418,419],{},[215,420,414],{},[276,422,423,426,433,442,448],{},[301,424,425],{},"Customer stored as",[301,427,428,429,432],{},"columns on the billable model (",[197,430,431],{},"stripe_id",", …)",[301,434,435,438,439,411],{},[197,436,437],{},"customers"," table (",[197,440,441],{},"paddle_id",[301,443,444,447],{},[197,445,446],{},"lemon_squeezy_customers"," table",[301,449,450,453,454,457],{},[197,451,452],{},"vatly_id"," column on the billable model + ",[197,455,456],{},"vatly_*"," tables",[276,459,460,463,466,473,476],{},[301,461,462],{},"Checkout",[301,464,465],{},"Stripe Checkout (hosted) / Elements",[301,467,468,469,472],{},"Paddle.js ",[215,470,471],{},"overlay / inline"," (client-side JS)",[301,474,475],{},"Lemon.js overlay / hosted URL",[301,477,478,481],{},[215,479,480],{},"Vatly-hosted redirect"," (+ guest claim)",[276,483,484,487,492,497,502],{},[301,485,486],{},"Webhook route",[301,488,489],{},[197,490,491],{},"/stripe/webhook",[301,493,494],{},[197,495,496],{},"/paddle/webhook",[301,498,499],{},[197,500,501],{},"/lemon-squeezy/webhook",[301,503,504],{},[197,505,506],{},"/webhooks/vatly",[276,508,509,512,514,516,518],{},[301,510,511],{},"Coupons / promo codes",[301,513,361],{},[301,515,361],{},[301,517,361],{},[301,519,520,523],{},[215,521,522],{},"On the roadmap"," (workaround below)",[276,525,526,529,531,533,535],{},[301,527,528],{},"License keys",[301,530,357],{},[301,532,357],{},[301,534,361],{},[301,536,537,539],{},[215,538,522],{}," (rarely needed for SaaS)",[276,541,542,545,548,551,553],{},[301,543,544],{},"Refunds & chargebacks",[301,546,547],{},"wire it yourself",[301,549,550],{},"events",[301,552,550],{},[301,554,555],{},[215,556,557],{},"first-class models + events",[276,559,560,563,565,567,569],{},[301,561,562],{},"Trials, swap, grace/resume",[301,564,361],{},[301,566,361],{},[301,568,361],{},[301,570,571],{},[215,572,361],{},[193,574,575],{},"Two takeaways:",[577,578,579,598],"ol",{},[580,581,582,591,592,597],"li",{},[215,583,584,586,587,590],{},[197,585,308],{}," runs on classic Stripe Billing, where ",[210,588,589],{},"you're"," the seller of record"," and\nown VAT registration, filing and remittance. Stripe has a real MoR too\n(",[231,593,596],{"href":594,"rel":595},"https://stripe.com/managed-payments",[235],"Managed Payments","), and Cashier — actively maintained —\nwill likely support it before long. Being an MoR is table stakes now, not a Vatly-only edge.",[580,599,600,603],{},[215,601,602],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[262,605],{},[265,607,609],{"id":608},"the-developer-experience","The developer experience",[193,611,612,613,615],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[197,614,199],{}," trait, and\nthe code reads like Cashier:",[617,618,622],"pre",{"className":619,"code":620,"language":621,"me