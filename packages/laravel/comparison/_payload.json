th":285,"stem":286},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":288,"path":289,"stem":290},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":292,"title":182,"body":293,"description":1474,"extension":1475,"links":1476,"meta":1477,"navigation":759,"path":183,"seo":1478,"stem":184,"__hash__":1479},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":294,"value":295,"toc":1467},"minimark",[296,327,353,363,366,371,675,678,707,709,713,719,801,1231,1240,1242,1246,1249,1360,1363,1365,1369,1376,1397,1405,1407,1411,1449,1463],[297,298,299,300,304,305,308,309,312,313,317,318,322,323,326],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[301,302,303],"code",{},"Billable"," trait, ",[301,306,307],{},"subscribed()",",\n",[301,310,311],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[314,315,316],"em",{},"behind","\nthe API: Vatly is a ",[319,320,321],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[319,324,325],{},"Europe-first",", operating under EU\njurisdiction.",[297,328,329,330,333,334,308,341,346,347,352],{},"This page is an honest, side-by-side look at how ",[301,331,332],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[335,336,340],"a",{"href":337,"rel":338},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[339],"nofollow","Laravel Cashier (Stripe)",[335,342,345],{"href":343,"rel":344},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[339],"Laravel Cashier (Paddle)",", and\n",[335,348,351],{"href":349,"rel":350},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[339],"Lemon Squeezy for Laravel"," — gaps included.",[354,355,356,359,360,362],"note",{},[319,357,358],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[335,361,186],{"href":187}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[364,365],"hr",{},[367,368,370],"h2",{"id":369},"at-a-glance","At a glance",[372,373,374,397],"table",{},[375,376,377],"thead",{},[378,379,380,383,386,389,392],"tr",{},[381,382],"th",{},[381,384,385],{},"Cashier (Stripe Billing)",[381,387,388],{},"Cashier (Paddle)",[381,390,391],{},"Lemon Squeezy",[381,393,394],{},[319,395,396],{},"Vatly",[398,399,400,426,451,471,500,523,560,584,609,626,642,660],"tbody",{},[378,401,402,406,411,416,421],{},[403,404,405],"td",{},"Composer package",[403,407,408],{},[301,409,410],{},"laravel\u002Fcashier",[403,412,413],{},[301,414,415],{},"laravel\u002Fcashier-paddle",[403,417,418],{},[301,419,420],{},"lemonsqueezy\u002Flaravel",[403,422,423],{},[301,424,425],{},"vatly\u002Fvatly-laravel",[378,427,428,431,436,441,446],{},[403,429,430],{},"Billable trait",[403,432,433],{},[301,434,435],{},"Laravel\\Cashier\\Billable",[403,437,438],{},[301,439,440],{},"Laravel\\Paddle\\Billable",[403,442,443],{},[301,444,445],{},"LemonSqueezy\\Laravel\\Billable",[403,447,448],{},[301,449,450],{},"Vatly\\Laravel\\Billable",[378,452,453,455,461,464,466],{},[403,454,321],{},[403,456,457,460],{},[319,458,459],{},"No"," — you are the seller",[403,462,463],{},"Yes",[403,465,463],{},[403,467,468],{},[319,469,470],{},"Yes (full)",[378,472,473,476,482,488,495],{},[403,474,475],{},"Entity \u002F jurisdiction",[403,477,478,481],{},[314,479,480],{},"You"," (wherever you're registered)",[403,483,484,485],{},"Paddle, ",[319,486,487],{},"UK",[403,489,490,491,494],{},"Lemon Squeezy, ",[319,492,493],{},"US"," (Stripe-owned)",[403,496,497],{},[319,498,499],{},"EEA \u002F EU jurisdiction",[378,501,502,505,514,517,519],{},[403,503,504],{},"Who remits VAT\u002Fsales tax",[403,506,507,509,510,513],{},[319,508,480],{}," (Stripe Tax only ",[314,511,512],{},"calculates",")",[403,515,516],{},"Provider",[403,518,516],{},[403,520,521],{},[319,522,516],{},[378,524,525,528,535,544,550],{},[403,526,527],{},"Customer stored as",[403,529,530,531,534],{},"columns on the billable model (",[301,532,533],{},"stripe_id",", …)",[403,536,537,540,541,513],{},[301,538,539],{},"customers"," table (",[301,542,543],{},"paddle_id",[403,545,546,549],{},[301,547,548],{},"lemon_squeezy_customers"," table",[403,551,552,555,556,559],{},[301,553,554],{},"vatly_id"," column on the billable model + ",[301,557,558],{},"vatly_*"," tables",[378,561,562,565,568,575,578],{},[403,563,564],{},"Checkout",[403,566,567],{},"Stripe Checkout (hosted) \u002F Elements",[403,569,570,571,574],{},"Paddle.js ",[319,572,573],{},"overlay \u002F inline"," (client-side JS)",[403,576,577],{},"Lemon.js overlay \u002F hosted URL",[403,579,580,583],{},[319,581,582],{},"Vatly-hosted redirect"," (+ guest claim)",[378,585,586,589,594,599,604],{},[403,587,588],{},"Webhook route",[403,590,591],{},[301,592,593],{},"\u002Fstripe\u002Fwebhook",[403,595,596],{},[301,597,598],{},"\u002Fpaddle\u002Fwebhook",[403,600,601],{},[301,602,603],{},"\u002Flemon-squeezy\u002Fwebhook",[403,605,606],{},[301,607,608],{},"\u002Fwebhooks\u002Fvatly",[378,610,611,614,616,618,620],{},[403,612,613],{},"Coupons \u002F promo codes",[403,615,463],{},[403,617,463],{},[403,619,463],{},[403,621,622,625],{},[319,623,624],{},"On the roadmap"," (workaround below)",[378,627,628,631,633,635,637],{},[403,629,630],{},"License keys",[403,632,459],{},[403,634,459],{},[403,636,463],{},[403,638,639,641],{},[319,640,624],{}," (rarely needed for SaaS)",[378,643,644,647,650,653,655],{},[403,645,646],{},"Refunds & chargebacks",[403,648,649],{},"wire it yourself",[403,651,652],{},"events",[403,654,652],{},[403,656,657],{},[319,658,659],{},"first-class models + events",[378,661,662,665,667,669,671],{},[403,663,664],{},"Trials, swap, grace\u002Fresume",[403,666,463],{},[403,668,463],{},[403,670,463],{},[403,672,673],{},[319,674,463],{},[297,676,677],{},"Two takeaways:",[679,680,681,701],"ol",{},[682,683,684,694,695,700],"li",{},[319,685,686,687,689,690,693],{},"With ",[301,688,410],{},", ",[314,691,692],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[335,696,699],{"href":697,"rel":698},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[339],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[682,702,703,706],{},[319,704,705],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[364,708],{},[367,710,712],{"id":711},"the-developer-experience","The developer experience",[297,714,715,716,718],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[301,717,303],{}," trait, and\nthe code reads like Cashier:",[720,721,726],"pre",{"className":722,"code":723,"language":724,"meta":725,"style":725},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[301,727,728,754,761,778,784,795],{"__ignoreMap":725},[729,730,733,737,741,745,747,749,751],"span",{"class":731,"line":732},"line",1,[729,734,736],{"class":735},"sbssI","use",[729,738,740],{"class":739},"sTEyZ"," Vatly",[729,742,744],{"class":743},"sMK4o","\\",[729,746,159],{"class":739},[729,748,744],{"class":743},[729,750,303],{"class":739},[729,752,753],{"class":743},";\n",[729,755,757],{"class":731,"line":756},2,[729,758,760],{"emptyLinePlaceholder":759},true,"\n",[729,762,764,768,772,775],{"class":731,"line":763},3,[729,765,767],{"class":766},"spNyl","class",[729,769,771],{"class":770},"sBMFI"," User",[729,773,774],{"class":766}," extends",[729,776,777],{"class":770}," Authenticatable\n",[729,779,781],{"class":731,"line":780},4,[729,782,783],{"class":743},"{\n",[729,785,787,790,793],{"class":731,"line":786},5,[729,788,789],{"class":735},"    use",[729,791,792],{"class":739}," Billable",[729,794,753],{"class":743},[729,796,798],{"class":731,"line":797},6,[729,799,800],{"class":743},"}\n",[720,802,804],{"className":722,"code":803,"language":724,"meta":725,"style":725},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[301,805,806,812,839,862,876,886,890,924,929,935,957,963,968,973,1002,1024,1045,1050,1056,1074,1122,1145,1166,1171,1176,1182,1209,1226],{"__ignoreMap":725},[729,807,808],{"class":731,"line":732},[729,809,811],{"class":810},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[729,813,814,817,820,823,826,829,832,836],{"class":731,"line":756},[729,815,816],{"class":743},"$",[729,818,819],{"class":739},"checkout ",[72