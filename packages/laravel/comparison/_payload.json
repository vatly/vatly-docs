tly\nnext to your current biller and migrate customers over gradually.",[552,553],"hr",{},[555,556,558],"h2",{"id":557},"at-a-glance","At a glance",[560,561,562,585],"table",{},[563,564,565],"thead",{},[566,567,568,571,574,577,580],"tr",{},[569,570],"th",{},[569,572,573],{},"Cashier (Stripe Billing)",[569,575,576],{},"Cashier (Paddle)",[569,578,579],{},"Lemon Squeezy",[569,581,582],{},[507,583,584],{},"Vatly",[586,587,588,614,639,659,688,711,748,771,796,813,829,847],"tbody",{},[566,589,590,594,599,604,609],{},[591,592,593],"td",{},"Composer package",[591,595,596],{},[489,597,598],{},"laravel\u002Fcashier",[591,600,601],{},[489,602,603],{},"laravel\u002Fcashier-paddle",[591,605,606],{},[489,607,608],{},"lemonsqueezy\u002Flaravel",[591,610,611],{},[489,612,613],{},"vatly\u002Fvatly-laravel",[566,615,616,619,624,629,634],{},[591,617,618],{},"Billable trait",[591,620,621],{},[489,622,623],{},"Laravel\\Cashier\\Billable",[591,625,626],{},[489,627,628],{},"Laravel\\Paddle\\Billable",[591,630,631],{},[489,632,633],{},"LemonSqueezy\\Laravel\\Billable",[591,635,636],{},[489,637,638],{},"Vatly\\Laravel\\Billable",[566,640,641,643,649,652,654],{},[591,642,509],{},[591,644,645,648],{},[507,646,647],{},"No"," — you are the seller",[591,650,651],{},"Yes",[591,653,651],{},[591,655,656],{},[507,657,658],{},"Yes (full)",[566,660,661,664,670,676,683],{},[591,662,663],{},"Entity \u002F jurisdiction",[591,665,666,669],{},[502,667,668],{},"You"," (wherever you're registered)",[591,671,672,673],{},"Paddle, ",[507,674,675],{},"UK",[591,677,678,679,682],{},"Lemon Squeezy, ",[507,680,681],{},"US"," (Stripe-owned)",[591,684,685],{},[507,686,687],{},"EEA \u002F EU jurisdiction",[566,689,690,693,702,705,707],{},[591,691,692],{},"Who remits VAT\u002Fsales tax",[591,694,695,697,698,701],{},[507,696,668],{}," (Stripe Tax only ",[502,699,700],{},"calculates",")",[591,703,704],{},"Provider",[591,706,704],{},[591,708,709],{},[507,710,704],{},[566,712,713,716,723,732,738],{},[591,714,715],{},"Customer stored as",[591,717,718,719,722],{},"columns on the billable model (",[489,720,721],{},"stripe_id",", …)",[591,724,725,728,729,701],{},[489,726,727],{},"customers"," table (",[489,730,731],{},"paddle_id",[591,733,734,737],{},[489,735,736],{},"lemon_squeezy_customers"," table",[591,739,740,743,744,747],{},[489,741,742],{},"vatly_id"," column on the billable model + ",[489,745,746],{},"vatly_*"," tables",[566,749,750,752,755,762,765],{},[591,751,441],{},[591,753,754],{},"Stripe Checkout (hosted) \u002F Elements",[591,756,757,758,761],{},"Paddle.js ",[507,759,760],{},"overlay \u002F inline"," (client-side JS)",[591,763,764],{},"Lemon.js overlay \u002F hosted URL",[591,766,767,770],{},[507,768,769],{},"Vatly-hosted redirect"," (+ guest claim)",[566,772,773,776,781,786,791],{},[591,774,775],{},"Webhook route",[591,777,778],{},[489,779,780],{},"\u002Fstripe\u002Fwebhook",[591,782,783],{},[489,784,785],{},"\u002Fpaddle\u002Fwebhook",[591,787,788],{},[489,789,790],{},"\u002Flemon-squeezy\u002Fwebhook",[591,792,793],{},[489,794,795],{},"\u002Fwebhooks\u002Fvatly",[566,797,798,801,803,805,807],{},[591,799,800],{},"Coupons \u002F promo codes",[591,802,651],{},[591,804,651],{},[591,806,651],{},[591,808,809,812],{},[507,810,811],{},"On the roadmap"," (workaround below)",[566,814,815,818,820,822,824],{},[591,816,817],{},"License keys",[591,819,647],{},[591,821,647],{},[591,823,651],{},[591,825,826,828],{},[507,827,811],{}," (rarely needed for SaaS)",[566,830,831,834,837,840,842],{},[591,832,833],{},"Refunds & chargebacks",[591,835,836],{},"wire it yourself",[591,838,839],{},"events",[591,841,839],{},[591,843,844],{},[507,845,846],{},"first-class models + events",[566,848,849,852,854,856,858],{},[591,850,851],{},"Trials, swap, grace\u002Fresume",[591,853,651],{},[591,855,651],{},[591,857,651],{},[591,859,860],{},[507,861,651],{},[485,863,864],{},"Two takeaways:",[866,867,868,888],"ol",{},[869,870,871,881,882,887],"li",{},[507,872,873,874,876,877,880],{},"With ",[489,875,598],{},", ",[502,878,879],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[523,883,886],{"href":884,"rel":885},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[527],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[869,889,890,893],{},[507,891,892],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[552,895],{},[555,897,899],{"id":898},"the-developer-experience","The developer experience",[485,901,902,903,905],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[489,904,491],{}," trait, and\nthe code reads like Cashier:",[907,908,913],"pre",{"className":909,"code":910,"language":911,"meta":912,"style":912},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[489,914,915,941,948,965,971,982],{"__ignoreMap":912},[916,917,920,924,928,932,934,936,938],"span",{"class":918,"line":919},"line",1,[916,921,923],{"class":922},"sbssI","use",[916,925,927],{"class":926},"sTEyZ"," Vatly",[916,929,931],{"class":930},"sMK4o","\\",[916,933,224],{"class":926},[916,935,931],{"class":930},[916,937,491],{"class":926},[916,939,940],{"class":930},";\n",[916,942,944],{"class":918,"line":943},2,[916,945,947],{"emptyLinePlaceholder":946},true,"\n",[916,949,951,955,959,962],{"class":918,"line":950},3,[916,952,954],{"class":953},"spNyl","class",[916,956,958],{"class":957},"sBMFI"," User",[916,960,961],{"class":953}," extends",[916,963,964],{"clas