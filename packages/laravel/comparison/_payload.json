},11,[729,961,962],{"class":810},"    \u002F\u002F …\n",[729,964,966],{"class":731,"line":965},12,[729,967,800],{"class":743},[729,969,971],{"class":731,"line":970},13,[729,972,760],{"emptyLinePlaceholder":759},[729,974,976,978,980,982,985,988,991,993,995,998,1000],{"class":731,"line":975},14,[729,977,816],{"class":743},[729,979,828],{"class":739},[729,981,831],{"class":743},[729,983,984],{"class":834},"subscription",[729,986,987],{"class":743},"()->",[729,989,990],{"class":834},"swap",[729,992,849],{"class":743},[729,994,852],{"class":743},[729,996,997],{"class":855},"subscription_plan_other",[729,999,852],{"class":743},[729,1001,923],{"class":743},[729,1003,1005,1007,1009,1011,1013,1015,1018,1021],{"class":731,"line":1004},15,[729,1006,816],{"class":743},[729,1008,828],{"class":739},[729,1010,831],{"class":743},[729,1012,984],{"class":834},[729,1014,987],{"class":743},[729,1016,1017],{"class":834},"cancel",[729,1019,1020],{"class":743},"();",[729,1022,1023],{"class":810},"      \u002F\u002F Vatly decides immediate vs. grace\n",[729,1025,1027,1029,1031,1033,1035,1037,1040,1042],{"class":731,"line":1026},16,[729,1028,816],{"class":743},[729,1030,828],{"class":739},[729,1032,831],{"class":743},[729,1034,984],{"class":834},[729,1036,987],{"class":743},[729,1038,1039],{"class":834},"resume",[729,1041,1020],{"class":743},[729,1043,1044],{"class":810},"      \u002F\u002F while on the grace period\n",[729,1046,1048],{"class":731,"line":1047},17,[729,1049,760],{"emptyLinePlaceholder":759},[729,1051,1053],{"class":731,"line":1052},18,[729,1054,1055],{"class":810},"\u002F\u002F One-off purchase\n",[729,1057,1059,1061,1063,1065,1067,1069,1071],{"class":731,"line":1058},19,[729,1060,816],{"class":743},[729,1062,828],{"class":739},[729,1064,831],{"class":743},[729,1066,905],{"class":834},[729,1068,987],{"class":743},[729,1070,882],{"class":834},[729,1072,1073],{"class":743},"(\n",[729,1075,1077,1080,1083,1086,1088,1091,1093,1096,1099,1102,1104,1107,1109,1112,1114,1116,1119],{"class":731,"line":1076},20,[729,1078,1079],{"class":770},"    items",[729,1081,1082],{"class":743},":",[729,1084,1085],{"class":743}," [[",[729,1087,852],{"class":743},[729,1089,1090],{"class":855},"id",[729,1092,852],{"class":743},[729,1094,1095],{"class":743}," =>",[729,1097,1098],{"class":743}," '",[729,1100,1101],{"class":855},"one_off_product_3Qb8Wz1Yt",[729,1103,852],{"class":743},[729,1105,1106],{"class":743},",",[729,1108,1098],{"class":743},[729,1110,1111],{"class":855},"quantity",[729,1113,852],{"class":743},[729,1115,1095],{"class":743},[729,1117,1118],{"class":735}," 1",[729,1120,1121],{"class":743},"]],\n",[729,1123,1125,1128,1130,1133,1135,1137,1140,1142],{"class":731,"line":1124},21,[729,1126,1127],{"class":770},"    redirectUrlSuccess",[729,1129,1082],{"class":743},[729,1131,1132],{"class":834}," route",[729,1134,849],{"class":743},[729,1136,852],{"class":743},[729,1138,1139],{"class":855},"billing.success",[729,1141,852],{"class":743},[729,1143,1144],{"class":743},"),\n",[729,1146,1148,1151,1153,1155,1157,1159,1162,1164],{"class":731,"line":1147},22,[729,1149,1150],{"class":770},"    redirectUrlCanceled",[729,1152,1082],{"class":743},[729,1154,1132],{"class":834},[729,1156,849],{"class":743},[729,1158,852],{"class":743},[729,1160,1161],{"class":855},"billing",[729,1163,852],{"class":743},[729,1165,1144],{"class":743},[729,1167,1169],{"class":731,"line":1168},23,[729,1170,923],{"class":743},[729,1172,1174],{"class":731,"line":1173},24,[729,1175,760],{"emptyLinePlaceholder":759},[729,1177,1179],{"class":731,"line":1178},25,[729,1180,1181],{"class":810},"\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\n",[729,1183,1185,1188,1190,1192,1194,1197,1200,1202,1205,1207],{"class":731,"line":1184},26,[729,1186,1187],{"class":895},"foreach",[729,1189,943],{"class":743},[729,1191,828],{"class":739},[729,1193,831],{"class":743},[729,1195,1196],{"class":739},"orders ",[729,1198,1199],{"class":743},"as",[729,1201,825],{"class":743},[729,1203,1204],{"class":739},"order",[729,1206,513],{"class":743},[729,1208,956],{"class":743},[729,1210,1212,1215,1217,1219,1221,1224],{"class":731,"line":1211},27,[729,1213,1214],{"class":834},"    echo",[729,1216,825],{"class":743},[729,1218,1204],{"class":739},[729,1220,831],{"class":743},[729,1222,1223],{"class":834},"invoiceUrl",[729,1225,885],{"class":743},[729,1227,1229],{"class":731,"line":1228},28,[729,1230,800],{"class":743},[297,1232,1233,1234,1236,1237,1239],{},"No VAT logic, no tax tables, no invoice templates, no client-side checkout widget to embed —\nthe checkout is a server-side redirect, like Stripe Checkout. See ",[335,1235,84],{"href":173},"\nand ",[335,1238,76],{"href":170}," for the full surface.",[364,1241],{},[367,1243,1245],{"id":1244},"feature-parity-and-whats-still-on-the-roadmap","Feature parity, and what's still on the roadmap",[297,1247,1248],{},"Vatly covers what a SaaS needs to start selling: subscriptions with trials, plan swaps,\ncancellation with grace and resume, one-off purchases, hosted checkout, refunds and chargebacks,\nand — because it's a Merchant of Record — VAT, invoicing and tax compliance handled for you. A\nfew capabilities you may use elsewhere aren't in the box yet. Here's the honest picture, and how\nto bridge it.",[372,1250,1251,1264],{},[375,1252,1253],{},[378,1254,1255,1258,1261],{},[381,1256,1257],{},"Capability",[381,1259,1260],{},"Vatly today",[381,1262,1263],{},"Notes",[398,1265,1266,1277,1289,1303,1312,1326,1342],{},[378,1267,1268,1271,1274],{},[403,1269,1270],{},"Subscriptions, trials, swap, grace, resume",[403,1272,1273],{},"✅",[403,1275,1276],{},"Full lifecycle, Cashier-shaped API",[378,1278,1279,1282,1284],{},[403,1280,1281],{},"One-off \u002F multi-item checkout",[403,1283,1273],{},[403,1285,1286],{},[301,1287,1288],{},"checkout()->create(items: …)",[378,1290,1291,1294,1296],{},[403,1292,1293],{},"VAT, invoicing, tax remittance",[403,1295,1273],{},[403,1297,1298,1299,1302],{},"Handled — it's the point of a MoR. With Cashier (classic Stripe Billing) this is ",[314,1300,1301],{},"your"," job.",[378,1304,1305,1307,1309],{},[403,1306,646],{},[403,1308,1273],{},[403,1310,1311],{},"First-class models + events (more than most provide)",[378,1313,1314,1317,1319],{},[403,1315,1316],{},"Test \u002F live segregation",[403,1318,1273],{},[403,1320,1321,1322,1325],{},"Every record carries ",[301,1323,1324],{},"testmode","; key prefix selects the mode",[378,1327,1328,1332,1335],{},[403,1329,1330],{},[319,1331,613],{},[403,1333,1334],{},"🔜 Roadmap",[403,1336,1337,1338,1341],{},"Until native codes land, model a promo as a dedicated ",[301,1339,1340],{},"subscription_plan_…"," at the discounted price and point that cohort at it. A couple of extra plans in the dashboard — not a blocker for launching offers.",[378,1343,1344,1348,1350],{},[403,1345,1346],{},[319,1347,630],{},[403,1349,1334],{},[403,1351,1352,1353,1355,1356,1359],{},"Vatly is built for SaaS, where entitlement follows subscription state — ",[301,1354,307],{}," ",[314,1357,1358],{},"is"," your license check. Per-seat keys for downloadable\u002Foffline software (Lemon Squeezy's signature feature) aren't here yet. If you ship license-activated desktop binaries, that's the one workflow to keep elsewhere for now.",[297,1361,1362],{},"The shape of the trade is deliberate: Vatly does the compliance-heavy core that's genuinely\nhard to build — being the seller of record, VAT across the EU, invoicing, disputes — and is\nfilling in the conveniences (coupons next) in the open. For a subscription SaaS selling into\nEurope and the world, there's enough here to launch today.",[364,1364],{},[367,1366,1368],{"id":1367},"why-teams-choose-vatly","Why teams choose Vatly",[297,1370,1371,1372,1375],{},"A Merchant of Record makes the tax burden disappear — it becomes the legal seller, so VAT,\ninvoicing and remittance stop being your problem. The real question is ",[314,1373,1374],{},"whose"," entity you hand that\nto, and that's where Vatly stands apart:",[1377,1378,1379,1385,1391],"ul",{},[682,1380,1381,1384],{},[319,1382,1383],{},"Europe-first, by design."," EEA-based, EU jurisdiction, customer data kept in Europe. The other\nMoRs sit in the UK (Paddle) or the US (Lemon Squeezy, Stripe Managed Payments) — jurisdiction is\nthe one axis that genuinely separates them, and the reason Vatly exists.",[682,1386,1387,1390],{},[319,1388,1389],{},"No exposure to US policy."," Your seller-of-record relationship and your customers' data stay\nunder EU law — a clean answer when an enterprise buyer, or your own board, asks where they sit.",[682,1392,1393,1396],{},[319,1394,1395],{},"One familiar API."," The Cashier-shaped surface means there's little to learn and little to\nrewrite.",[1398,1399,1400],"blockquote",{},[297,1401,1402],{},[319,1403,1404],{},"You Just Ship.",[364,1406],{},[367,1408,1410],{"id":1409},"next-steps","Next steps",[1377,1412,1413,1423,1431],{},[682,1414,1415,1418,1419,1422],{},[319,1416,1417],{},"Starting fresh"," → ",[335,1420,1421],{"href":164},"Getting started"," wires up the trait, config, migrations and\nwebhook in a few minutes.",[682,1424,1425,1418,1428,1430],{},[319,1426,1427],{},"Already running another provider",[335,1429,186],{"href":187},"\nshows how to add Vatly beside your current biller and migrate customers over gradually.",[682,1432,1433,1418,1436,1438,1439,1438,1441,1438,1443,1438,1445,1438,1447],{},[319,1434,1435],{},"Reference",[335,1437,190],{"href":191}," · ",[335,1440,64],{"href":167},[335,1442,76],{"href":170},[335,1444,84],{"href":173},[335,1446,92],{"href":176},[335,1448,46],{"href":179},[297,1450,1451,1452,1455,1456,1455,1459,1462],{},"Compared against, at time of writing:\n",[335,1453,340],{"href":337,"rel":1454},[339]," ·\n",[335,1457,345],{"href":343,"rel":1458},[339],[335,1460,351],{"href":349,"rel":1461},[339],".\nTheir method names and table layouts follow those packages' current releases — verify against\nthe version you have pinned before relying on a specific signature.",[14