xt to your current biller and migrate customers over gradually.",[560,561],"hr",{},[563,564,566],"h2",{"id":565},"at-a-glance","At a glance",[568,569,570,593],"table",{},[571,572,573],"thead",{},[574,575,576,579,582,585,588],"tr",{},[577,578],"th",{},[577,580,581],{},"Cashier (Stripe Billing)",[577,583,584],{},"Cashier (Paddle)",[577,586,587],{},"Lemon Squeezy",[577,589,590],{},[515,591,592],{},"Vatly",[594,595,596,622,647,667,696,719,756,780,805,822,838,856],"tbody",{},[574,597,598,602,607,612,617],{},[599,600,601],"td",{},"Composer package",[599,603,604],{},[497,605,606],{},"laravel\u002Fcashier",[599,608,609],{},[497,610,611],{},"laravel\u002Fcashier-paddle",[599,613,614],{},[497,615,616],{},"lemonsqueezy\u002Flaravel",[599,618,619],{},[497,620,621],{},"vatly\u002Fvatly-laravel",[574,623,624,627,632,637,642],{},[599,625,626],{},"Billable trait",[599,628,629],{},[497,630,631],{},"Laravel\\Cashier\\Billable",[599,633,634],{},[497,635,636],{},"Laravel\\Paddle\\Billable",[599,638,639],{},[497,640,641],{},"LemonSqueezy\\Laravel\\Billable",[599,643,644],{},[497,645,646],{},"Vatly\\Laravel\\Billable",[574,648,649,651,657,660,662],{},[599,650,517],{},[599,652,653,656],{},[515,654,655],{},"No"," — you are the seller",[599,658,659],{},"Yes",[599,661,659],{},[599,663,664],{},[515,665,666],{},"Yes (full)",[574,668,669,672,678,684,691],{},[599,670,671],{},"Entity \u002F jurisdiction",[599,673,674,677],{},[510,675,676],{},"You"," (wherever you're registered)",[599,679,680,681],{},"Paddle, ",[515,682,683],{},"UK",[599,685,686,687,690],{},"Lemon Squeezy, ",[515,688,689],{},"US"," (Stripe-owned)",[599,692,693],{},[515,694,695],{},"EEA \u002F EU jurisdiction",[574,697,698,701,710,713,715],{},[599,699,700],{},"Who remits VAT\u002Fsales tax",[599,702,703,705,706,709],{},[515,704,676],{}," (Stripe Tax only ",[510,707,708],{},"calculates",")",[599,711,712],{},"Provider",[599,714,712],{},[599,716,717],{},[515,718,712],{},[574,720,721,724,731,740,746],{},[599,722,723],{},"Customer stored as",[599,725,726,727,730],{},"columns on the billable model (",[497,728,729],{},"stripe_id",", …)",[599,732,733,736,737,709],{},[497,734,735],{},"customers"," table (",[497,738,739],{},"paddle_id",[599,741,742,745],{},[497,743,744],{},"lemon_squeezy_customers"," table",[599,747,748,751,752,755],{},[497,749,750],{},"vatly_id"," column on the billable model + ",[497,753,754],{},"vatly_*"," tables",[574,757,758,761,764,771,774],{},[599,759,760],{},"Checkout",[599,762,763],{},"Stripe Checkout (hosted) \u002F Elements",[599,765,766,767,770],{},"Paddle.js ",[515,768,769],{},"overlay \u002F inline"," (client-side JS)",[599,772,773],{},"Lemon.js overlay \u002F hosted URL",[599,775,776,779],{},[515,777,778],{},"Vatly-hosted redirect"," (+ guest claim)",[574,781,782,785,790,795,800],{},[599,783,784],{},"Webhook route",[599,786,787],{},[497,788,789],{},"\u002Fstripe\u002Fwebhook",[599,791,792],{},[497,793,794],{},"\u002Fpaddle\u002Fwebhook",[599,796,797],{},[497,798,799],{},"\u002Flemon-squeezy\u002Fwebhook",[599,801,802],{},[497,803,804],{},"\u002Fwebhooks\u002Fvatly",[574,806,807,810,812,814,816],{},[599,808,809],{},"Coupons \u002F promo codes",[599,811,659],{},[599,813,659],{},[599,815,659],{},[599,817,818,821],{},[515,819,820],{},"On the roadmap"," (workaround below)",[574,823,824,827,829,831,833],{},[599,825,826],{},"License keys",[599,828,655],{},[599,830,655],{},[599,832,659],{},[599,834,835,837],{},[515,836,820],{}," (rarely needed for SaaS)",[574,839,840,843,846,849,851],{},[599,841,842],{},"Refunds & chargebacks",[599,844,845],{},"wire it yourself",[599,847,848],{},"events",[599,850,848],{},[599,852,853],{},[515,854,855],{},"first-class models + events",[574,857,858,861,863,865,867],{},[599,859,860],{},"Trials, swap, grace\u002Fresume",[599,862,659],{},[599,864,659],{},[599,866,659],{},[599,868,869],{},[515,870,659],{},[493,872,873],{},"Two takeaways:",[875,876,877,897],"ol",{},[878,879,880,890,891,896],"li",{},[515,881,882,883,885,886,889],{},"With ",[497,884,606],{},", ",[510,887,888],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[531,892,895],{"href":893,"rel":894},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[535],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[878,898,899,902],{},[515,900,901],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[560,904],{},[563,906,908],{"id":907},"the-developer-experience","The developer experience",[493,910,911,912,914],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[497,913,499],{}," trait, and\nthe code reads like Cashier:",[916,917,922],"pre",{"className":918,"code":919,"language":920,"meta":921,"style":921},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[497,923,924,950,957,974,980,991],{"__ignoreMap":921},[925,926,929,933,937,941,943,945,947],"span",{"class":927,"line":928},"line",1,[925,930,932],{"class":931},"sbssI","use",[925,934,936],{"class":935},"sTEyZ"," Vatly",[925,938,940],{"class":939},"sMK4o","\\",[925,942,210],{"class":935},[925,944,940],{"class":939},[925,946,499],{"class":935},[925,948,949],{"class":939},";\n",[925,951,953],{"class":927,"line":952},2,[925,954,956],{"emptyLinePlaceholder":955},true,"\n",[925,958,960,964,968,971],{"class":927,"line":959},3,[925,961,963],{"class":962},"spNyl","class",[925,965,967],{"class":966},"sBMFI"," User",[925,969,970],{"class":962}," extends",[925,972,973],{"