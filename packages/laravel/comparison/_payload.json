02F12.x\u002Fcashier-paddle",[539],"Laravel Cashier (Paddle)",", and\n",[535,548,551],{"href":549,"rel":550},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[539],"Lemon Squeezy for Laravel"," — gaps included.",[554,555,556,559,560,562],"note",{},[519,557,558],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[535,561,266],{"href":267}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[564,565],"hr",{},[567,568,570],"h2",{"id":569},"at-a-glance","At a glance",[572,573,574,597],"table",{},[575,576,577],"thead",{},[578,579,580,583,586,589,592],"tr",{},[581,582],"th",{},[581,584,585],{},"Cashier (Stripe Billing)",[581,587,588],{},"Cashier (Paddle)",[581,590,591],{},"Lemon Squeezy",[581,593,594],{},[519,595,596],{},"Vatly",[598,599,600,626,651,671,700,723,760,783,808,825,841,859],"tbody",{},[578,601,602,606,611,616,621],{},[603,604,605],"td",{},"Composer package",[603,607,608],{},[501,609,610],{},"laravel\u002Fcashier",[603,612,613],{},[501,614,615],{},"laravel\u002Fcashier-paddle",[603,617,618],{},[501,619,620],{},"lemonsqueezy\u002Flaravel",[603,622,623],{},[501,624,625],{},"vatly\u002Fvatly-laravel",[578,627,628,631,636,641,646],{},[603,629,630],{},"Billable trait",[603,632,633],{},[501,634,635],{},"Laravel\\Cashier\\Billable",[603,637,638],{},[501,639,640],{},"Laravel\\Paddle\\Billable",[603,642,643],{},[501,644,645],{},"LemonSqueezy\\Laravel\\Billable",[603,647,648],{},[501,649,650],{},"Vatly\\Laravel\\Billable",[578,652,653,655,661,664,666],{},[603,654,521],{},[603,656,657,660],{},[519,658,659],{},"No"," — you are the seller",[603,662,663],{},"Yes",[603,665,663],{},[603,667,668],{},[519,669,670],{},"Yes (full)",[578,672,673,676,682,688,695],{},[603,674,675],{},"Entity \u002F jurisdiction",[603,677,678,681],{},[514,679,680],{},"You"," (wherever you're registered)",[603,683,684,685],{},"Paddle, ",[519,686,687],{},"UK",[603,689,690,691,694],{},"Lemon Squeezy, ",[519,692,693],{},"US"," (Stripe-owned)",[603,696,697],{},[519,698,699],{},"EEA \u002F EU jurisdiction",[578,701,702,705,714,717,719],{},[603,703,704],{},"Who remits VAT\u002Fsales tax",[603,706,707,709,710,713],{},[519,708,680],{}," (Stripe Tax only ",[514,711,712],{},"calculates",")",[603,715,716],{},"Provider",[603,718,716],{},[603,720,721],{},[519,722,716],{},[578,724,725,728,735,744,750],{},[603,726,727],{},"Customer stored as",[603,729,730,731,734],{},"columns on the billable model (",[501,732,733],{},"stripe_id",", …)",[603,736,737,740,741,713],{},[501,738,739],{},"customers"," table (",[501,742,743],{},"paddle_id",[603,745,746,749],{},[501,747,748],{},"lemon_squeezy_customers"," table",[603,751,752,755,756,759],{},[501,753,754],{},"vatly_id"," column on the billable model + ",[501,757,758],{},"vatly_*"," tables",[578,761,762,764,767,774,777],{},[603,763,453],{},[603,765,766],{},"Stripe Checkout (hosted) \u002F Elements",[603,768,769,770,773],{},"Paddle.js ",[519,771,772],{},"overlay \u002F inline"," (client-side JS)",[603,775,776],{},"Lemon.js overlay \u002F hosted URL",[603,778,779,782],{},[519,780,781],{},"Vatly-hosted redirect"," (+ guest claim)",[578,784,785,788,793,798,803],{},[603,786,787],{},"Webhook route",[603,789,790],{},[501,791,792],{},"\u002Fstripe\u002Fwebhook",[603,794,795],{},[501,796,797],{},"\u002Fpaddle\u002Fwebhook",[603,799,800],{},[501,801,802],{},"\u002Flemon-squeezy\u002Fwebhook",[603,804,805],{},[501,806,807],{},"\u002Fwebhooks\u002Fvatly",[578,809,810,813,815,817,819],{},[603,811,812],{},"Coupons \u002F promo codes",[603,814,663],{},[603,816,663],{},[603,818,663],{},[603,820,821,824],{},[519,822,823],{},"On the roadmap"," (workaround below)",[578,826,827,830,832,834,836],{},[603,828,829],{},"License keys",[603,831,659],{},[603,833,659],{},[603,835,663],{},[603,837,838,840],{},[519,839,823],{}," (rarely needed for SaaS)",[578,842,843,846,849,852,854],{},[603,844,845],{},"Refunds & chargebacks",[603,847,848],{},"wire it yourself",[603,850,851],{},"events",[603,853,851],{},[603,855,856],{},[519,857,858],{},"first-class models + events",[578,860,861,864,866,868,870],{},[603,862,863],{},"Trials, swap, grace\u002Fresume",[603,865,663],{},[603,867,663],{},[603,869,663],{},[603,871,872],{},[519,873,663],{},[497,875,876],{},"Two takeaways:",[878,879,880,900],"ol",{},[881,882,883,893,894,899],"li",{},[519,884,885,886,888,889,892],{},"With ",[501,887,610],{},", ",[514,890,891],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[535,895,898],{"href":896,"rel":897},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[539],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[881,901,902,905],{},[519,903,904],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[564,907],{},[567,909,911],{"id":910},"the-developer-experience","The developer experience",[497,913,914,915,917],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[501,916,503],{}," trait, and\nthe code reads like Cashier:",[919,920,925],"pre",{"className":921,"code":922,"language":923,"meta":924,"style":924},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[501,926,927,953,960,977,983,994],{"__ignoreMap":924},[928,929,932,936,940,944,946,948,950],"span",{"class":930,"line":931},"line",1,[928,933,935],{"class":934},"sbssI","use",[928,937,939],{"class":938},"sTEyZ"," Vatly",[928,941,943],{"class":942},"sMK4o","\\",[928,945,236],{"class":938},[928,947,943],{"class":942},[928,949,503],{"class":938},[928,951,952],{"class":942},";\n",[928,954,956],{"class":930,"line":955},2,[928,957,959],{"emptyLinePlaceholder":958},true,"\n",[928,961,963,967,971,974],{"class":930,"line":962},3,[928,964,966],{"class":965},"spNyl","class",[928,968,970],{"class":969},"sBMFI"," User",[928,972,973],{"class":965}," extends",[928,975,976],{"class":969}," Authenticatable\n",[928,978,980],{"class":930,"line":979},4,[928,981,982],{"class":942},"{\n",[928,984,986,989,992],{"class":930,"line":985},5,[928,987,988],{"class":934},"    use",[928,990,991],{"class":938}," Billable",[928,993,952],{"class":942},[928,995,997],{"class":930,"line":996},6,[928,998,999],{"class":942},"}\n",[919,1001,1003],{"className":921,"code":1002,"language":923,"meta":924,"style":924},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[501,1004,1005,1011,1038,1061,1075,1085,1089,1123,1128,1134,1156,1162,1167,1172,1201,1223,1244,1249,1255,1273,1321,1344,1365,1370,1375,1381,1408,1425],{"__ignoreMap":924},[928,1006,1007],{"class":930,"line":931},[928