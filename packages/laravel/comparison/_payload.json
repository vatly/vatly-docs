35],"Lemon Squeezy for Laravel"," — gaps included.",[550,551,552,555,556,558],"note",{},[515,553,554],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[531,557,262],{"href":263}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[560,561],"hr",{},[563,564,566],"h2",{"id":565},"at-a-glance","At a glance",[568,569,570,593],"table",{},[571,572,573],"thead",{},[574,575,576,579,582,585,588],"tr",{},[577,578],"th",{},[577,580,581],{},"Cashier (Stripe Billing)",[577,583,584],{},"Cashier (Paddle)",[577,586,587],{},"Lemon Squeezy",[577,589,590],{},[515,591,592],{},"Vatly",[594,595,596,622,647,667,696,719,756,779,804,821,837,855],"tbody",{},[574,597,598,602,607,612,617],{},[599,600,601],"td",{},"Composer package",[599,603,604],{},[497,605,606],{},"laravel\u002Fcashier",[599,608,609],{},[497,610,611],{},"laravel\u002Fcashier-paddle",[599,613,614],{},[497,615,616],{},"lemonsqueezy\u002Flaravel",[599,618,619],{},[497,620,621],{},"vatly\u002Fvatly-laravel",[574,623,624,627,632,637,642],{},[599,625,626],{},"Billable trait",[599,628,629],{},[497,630,631],{},"Laravel\\Cashier\\Billable",[599,633,634],{},[497,635,636],{},"Laravel\\Paddle\\Billable",[599,638,639],{},[497,640,641],{},"LemonSqueezy\\Laravel\\Billable",[599,643,644],{},[497,645,646],{},"Vatly\\Laravel\\Billable",[574,648,649,651,657,660,662],{},[599,650,517],{},[599,652,653,656],{},[515,654,655],{},"No"," — you are the seller",[599,658,659],{},"Yes",[599,661,659],{},[599,663,664],{},[515,665,666],{},"Yes (full)",[574,668,669,672,678,684,691],{},[599,670,671],{},"Entity \u002F jurisdiction",[599,673,674,677],{},[510,675,676],{},"You"," (wherever you're registered)",[599,679,680,681],{},"Paddle, ",[515,682,683],{},"UK",[599,685,686,687,690],{},"Lemon Squeezy, ",[515,688,689],{},"US"," (Stripe-owned)",[599,692,693],{},[515,694,695],{},"EEA \u002F EU jurisdiction",[574,697,698,701,710,713,715],{},[599,699,700],{},"Who remits VAT\u002Fsales tax",[599,702,703,705,706,709],{},[515,704,676],{}," (Stripe Tax only ",[510,707,708],{},"calculates",")",[599,711,712],{},"Provider",[599,714,712],{},[599,716,717],{},[515,718,712],{},[574,720,721,724,731,740,746],{},[599,722,723],{},"Customer stored as",[599,725,726,727,730],{},"columns on the billable model (",[497,728,729],{},"stripe_id",", …)",[599,732,733,736,737,709],{},[497,734,735],{},"customers"," table (",[497,738,739],{},"paddle_id",[599,741,742,745],{},[497,743,744],{},"lemon_squeezy_customers"," table",[599,747,748,751,752,755],{},[497,749,750],{},"vatly_id"," column on the billable model + ",[497,753,754],{},"vatly_*"," tables",[574,757,758,760,763,770,773],{},[599,759,449],{},[599,761,762],{},"Stripe Checkout (hosted) \u002F Elements",[599,764,765,766,769],{},"Paddle.js ",[515,767,768],{},"overlay \u002F inline"," (client-side JS)",[599,771,772],{},"Lemon.js overlay \u002F hosted URL",[599,774,775,778],{},[515,776,777],{},"Vatly-hosted redirect"," (+ guest claim)",[574,780,781,784,789,794,799],{},[599,782,783],{},"Webhook route",[599,785,786],{},[497,787,788],{},"\u002Fstripe\u002Fwebhook",[599,790,791],{},[497,792,793],{},"\u002Fpaddle\u002Fwebhook",[599,795,796],{},[497,797,798],{},"\u002Flemon-squeezy\u002Fwebhook",[599,800,801],{},[497,802,803],{},"\u002Fwebhooks\u002Fvatly",[574,805,806,809,811,813,815],{},[599,807,808],{},"Coupons \u002F promo codes",[599,810,659],{},[599,812,659],{},[599,814,659],{},[599,816,817,820],{},[515,818,819],{},"On the roadmap"," (workaround below)",[574,822,823,826,828,830,832],{},[599,824,825],{},"License keys",[599,827,655],{},[599,829,655],{},[599,831,659],{},[599,833,834,836],{},[515,835,819],{}," (rarely needed for SaaS)",[574,838,839,842,845,848,850],{},[599,840,841],{},"Refunds & chargebacks",[599,843,844],{},"wire it yourself",[599,846,847],{},"events",[599,849,847],{},[599,851,852],{},[515,853,854],{},"first-class models + events",[574,856,857,860,862,864,866],{},[599,858,859],{},"Trials, swap, grace\u002Fresume",[599,861,659],{},[599,863,659],{},[599,865,659],{},[599,867,868],{},[515,869,659],{},[493,871,872],{},"Two takeaways:",[874,875,876,896],"ol",{},[877,878,879,889,890,895],"li",{},[515,880,881,882,884,885,888],{},"With ",[497,883,606],{},", ",[510,886,887],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[531,891,894],{"href":892,"rel":893},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[535],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[877,897,898,901],{},[515,899,900],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[560,903],{},[563,905,907],{"id":906},"the-developer-experience","The developer experience",[493,909,910,911,913],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[497,912,499],{}," trait, and\nthe code reads like Cashier:",[915,916,921],"pre",{"className":917,"code":918,"language":919,"meta":920,"style":920},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[497,922,923,949,956,973,979,990],{"__ignoreMap":920},[924,925,928,932,936,940,942,944,946],"span",{"class":926,"line":927},"line",1,[924,929,931],{"class":930},"sbssI","use",[924,933,935],{"class":934},"sTEyZ"," Vatly",[924,937,939],{"class":938},"sMK4o","\\",[924,941,232],{"class":934},[924,943,939],{"class":938},[924,945,499],{"class":934},[924,947,948],{"class":938},";\n",[924,950,952],{"class":926,"line":951},2,[924,953,955],{"emptyLinePlaceholder":954},true,"\n",[924,957,959,963,967,970],{"class":926,"line":958},3,[924,960,962],{"class":961},"spNyl","class",[924,964,966],{"class":965},"sBMFI"," User",[924,968,969],{"class":961}," extends",[924,971,972],{"class":965}," Authenticatable\n",[924,974,976],{"class":926,"line":975},4,[924,977,978],{"class":938},"{\n",[924,980,982,985,988],{"class":926,"line":981},5,[924,983,984],{"class":930},"    use",[924,986,987],{"class":934}," Billable",[924,989,948],{"class":938},[924,991,993],{"class":926,"line":992},6,[924,994,995],{"class":938},"}\n",[915,997,999],{"className":917,"code":998,"language":919,"meta":920,"style":920},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[497,1000,1001,1007,1034,1057,1071,1081,1085,1119,1124,1130,1152,1158,1163,1168,1197,1219,1240,1245,1251,1269,1317,1340,1361,1366,1371,1377,1404,1421],{"__ignoreMap":920},[924,1002,1003],{"class":926,"line":927},[924,1004,1006],{"class":1005},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[924,1008,1009,1012,1015,1018,1021,1024,1027,1031],{"class":92