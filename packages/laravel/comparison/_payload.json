ckages/php/webhookendpoints","3.packages/1.php/99.webhookendpoints",{"title":152,"path":153,"stem":154,"children":155,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[156,159,162,165,168,171,174,178,182],{"title":117,"path":157,"stem":158},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":160,"stem":161},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":163,"stem":164},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":166,"stem":167},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":169,"stem":170},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":172,"stem":173},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":175,"path":176,"stem":177},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":179,"path":180,"stem":181},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":183,"path":184,"stem":185},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":187,"path":188,"stem":189},"Integrations","/integrations","4.integrations",{"id":191,"title":175,"body":192,"description":1372,"extension":1373,"links":1374,"meta":1375,"navigation":658,"path":176,"seo":1376,"stem":177,"__hash__":1377},"docs/3.packages/2.laravel/6.comparison.md",{"type":193,"value":194,"toc":1365},"minimark",[195,226,252,264,267,272,576,579,607,609,613,619,700,1130,1139,1141,1145,1148,1259,1262,1264,1268,1275,1296,1303,1305,1309,1347,1361],[196,197,198,199,203,204,207,208,211,212,216,217,221,222,225],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[200,201,202],"code",{},"Billable"," trait, ",[200,205,206],{},"subscribed()",",\n",[200,209,210],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[213,214,215],"em",{},"behind","\nthe API: Vatly is a ",[218,219,220],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[218,223,224],{},"Europe-first",", operating under EU\njurisdiction.",[196,227,228,229,232,233,207,240,245,246,251],{},"This page is an honest, side-by-side look at how ",[200,230,231],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[234,235,239],"a",{"href":236,"rel":237},"https://laravel.com/docs/12.x/billing",[238],"nofollow","Laravel Cashier (Stripe)",[234,241,244],{"href":242,"rel":243},"https://laravel.com/docs/12.x/cashier-paddle",[238],"Laravel Cashier (Paddle)",", and\n",[234,247,250],{"href":248,"rel":249},"https://github.com/lmsqueezy/laravel",[238],"Lemon Squeezy for Laravel"," — gaps included.",[253,254,255],"blockquote",{},[196,256,257,260,261,263],{},[218,258,259],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[234,262,179],{"href":180}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[265,266],"hr",{},[268,269,271],"h2",{"id":270},"at-a-glance","At a glance",[273,274,275,298],"table",{},[276,277,278],"thead",{},[279,280,281,284,287,290,293],"tr",{},[282,283],"th",{},[282,285,286],{},"Cashier (Stripe Billing)",[282,288,289],{},"Cashier (Paddle)",[282,291,292],{},"Lemon Squeezy",[282,294,295],{},[218,296,297],{},"Vatly",[299,300,301,327,352,372,401,424,461,485,510,527,543,561],"tbody",{},[279,302,303,307,312,317,322],{},[304,305,306],"td",{},"Composer package",[304,308,309],{},[200,310,311],{},"laravel/cashier",[304,313,314],{},[200,315,316],{},"laravel/cashier-paddle",[304,318,319],{},[200,320,321],{},"lemonsqueezy/laravel",[304,323,324],{},[200,325,326],{},"vatly/vatly-laravel",[279,328,329,332,337,342,347],{},[304,330,331],{},"Billable trait",[304,333,334],{},[200,335,336],{},"Laravel\\Cashier\\Billable",[304,338,339],{},[200,340,341],{},"Laravel\\Paddle\\Billable",[304,343,344],{},[200,345,346],{},"LemonSqueezy\\Laravel\\Billable",[304,348,349],{},[200,350,351],{},"Vatly\\Laravel\\Billable",[279,353,354,356,362,365,367],{},[304,355,220],{},[304,357,358,361],{},[218,359,360],{},"No"," — you are the seller",[304,363,364],{},"Yes",[304,366,364],{},[304,368,369],{},[218,370,371],{},"Yes (full)",[279,373,374,377,383,389,396],{},[304,375,376],{},"Entity / jurisdiction",[304,378,379,382],{},[213,380,381],{},"You"," (wherever you're registered)",[304,384,385,386],{},"Paddle, ",[218,387,388],{},"UK",[304,390,391,392,395],{},"Lemon Squeezy, ",[218,393,394],{},"US"," (Stripe-owned)",[304,397,398],{},[218,399,400],{},"EEA / EU jurisdiction",[279,402,403,406,415,418,420],{},[304,404,405],{},"Who remits VAT/sales tax",[304,407,408,410,411,414],{},[218,409,381],{}," (Stripe Tax only ",[213,412,413],{},"calculates",")",[304,416,417],{},"Provider",[304,419,417],{},[304,421,422],{},[218,423,417],{},[279,425,426,429,436,445,451],{},[304,427,428],{},"Customer stored as",[304,430,431,432,435],{},"columns on the billable model (",[200,433,434],{},"stripe_id",", …)",[304,437,438,441,442,414],{},[200,439,440],{},"customers"," table (",[200,443,444],{},"paddle_id",[304,446,447,450],{},[200,448,449],{},"lemon_squeezy_customers"," table",[304,452,453,456,457,460],{},[200,454,455],{},"vatly_id"," column on the billable model + ",[200,458,459],{},"vatly_*"," tables",[279,462,463,466,469,476,479],{},[304,464,465],{},"Checkout",[304,467,468],{},"Stripe Checkout (hosted) / Elements",[304,470,471,472,475],{},"Paddle.js ",[218,473,474],{},"overlay / inline"," (client-side JS)",[304,477,478],{},"Lemon.js overlay / hosted URL",[304,480,481,484],{},[218,482,483],{},"Vatly-hosted redirect"," (+ guest claim)",[279,486,487,490,495,500,505],{},[304,488,489],{},"Webhook route",[304,491,492],{},[200,493,494],{},"/stripe/webhook",[304,496,497],{},[200,498,499],{},"/paddle/webhook",[304,501,502],{},[200,503,504],{},"/lemon-squeezy/webhook",[304,506,507],{},[200,508,509],{},"/webhooks/vatly",[279,511,512,515,517,519,521],{},[304,513,514],{},"Coupons / promo codes",[304,516,364],{},[304,518,364],{},[304,520,364],{},[304,522,523,526],{},[218,524,525],{},"On the roadmap"," (workaround below)",[279,528,529,532,534,536,538],{},[304,530,531],{},"License keys",[304,533,360],{},[304,535,360],{},[304,537,364],{},[304,539,540,542],{},[218,541,525],{}," (rarely needed for SaaS)",[279,544,545,548,551,554,556],{},[304,546,547],{},"Refunds & chargebacks",[304,549,550],{},"wire it yourself",[304,552,553],{},"events",[304,555,553],{},[304,557,558],{},[218,559,560],{},"first-class models + events",[279,562,563,566,568,570,572],{},[304,564,565],{},"Trials, swap, grace/resume",[304,567,364],{},[304,569,364],{},[304,571,364],{},[304,573,574],{},[218,575,364],{},[196,577,578],{},"Two takeaways:",[580,581,582,601],"ol",{},[583,584,585,594,595,600],"li",{},[218,586,587,589,590,593],{},[200,588,311],{}," runs on classic Stripe Billing, where ",[213,591,592],{},"you're"," the seller of record"," and\nown VAT registration, filing and remittance. Stripe has a real MoR too\n(",[234,596,599],{"href":597,"rel":598},"https://stripe.com/managed-payments",[238],"Managed Payments","), and Cashier — actively maintained —\nwill likely support it before long. Being an MoR is table stakes now, not a Vatly-only edge.",[583,602,603,606],{},[218,604,605],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[265,608],{},[268,610,612],{"id":611},"the-developer-experience","The developer experience",[196,614,615,616,618],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[200,617,202],{}