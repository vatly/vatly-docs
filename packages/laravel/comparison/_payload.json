 html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}",{"title":899,"searchDepth":930,"depth":930,"links":1641},[1642,1643,1644,1645,1646],{"id":544,"depth":930,"text":545},{"id":885,"depth":930,"text":886},{"id":1418,"depth":930,"text":1419},{"id":1541,"depth":930,"text":1542},{"id":1583,"depth":930,"text":1584},"Picking the billing layer for a new Laravel app?","md",null,{},{"title":237},{"title":467,"description":1647},"EPTmnvy0ysnci0_cwoxShY4EnKX64jiK_l9mmy4meCE",[1655,1657],{"title":50,"path":234,"stem":235,"description":1656,"children":-1},"Vatly sends webhooks to notify your application of events like subscription starts, cancellations, and payment updates.",{"title":241,"path":242,"stem":243,"description":1658,"children":-1},"You don't swap a Merchant of Record overnight.",1794589781569]