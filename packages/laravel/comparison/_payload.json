002F2.laravel\u002F6.comparison",{"title":187,"path":188,"stem":189},"Migrating from Cashier","\u002Fpackages\u002Flaravel\u002Fmigrating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":191,"path":192,"stem":193},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":195,"path":196,"stem":197},"Integrations","\u002Fintegrations","4.integrations",{"id":199,"title":183,"body":200,"description":1380,"extension":1381,"links":1382,"meta":1383,"navigation":665,"path":184,"seo":1384,"stem":185,"__hash__":1385},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":201,"value":202,"toc":1373},"minimark",[203,234,260,270,273,278,582,585,614,616,620,626,707,1137,1146,1148,1152,1155,1266,1269,1271,1275,1282,1303,1311,1313,1317,1355,1369],[204,205,206,207,211,212,215,216,219,220,224,225,229,230,233],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[208,209,210],"code",{},"Billable"," trait, ",[208,213,214],{},"subscribed()",",\n",[208,217,218],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[221,222,223],"em",{},"behind","\nthe API: Vatly is a ",[226,227,228],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[226,231,232],{},"Europe-first",", operating under EU\njurisdiction.",[204,235,236,237,240,241,215,248,253,254,259],{},"This page is an honest, side-by-side look at how ",[208,238,239],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[242,243,247],"a",{"href":244,"rel":245},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[246],"nofollow","Laravel Cashier (Stripe)",[242,249,252],{"href":250,"rel":251},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[246],"Laravel Cashier (Paddle)",", and\n",[242,255,258],{"href":256,"rel":257},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[246],"Lemon Squeezy for Laravel"," — gaps included.",[261,262,263,266,267,269],"note",{},[226,264,265],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[242,268,187],{"href":188}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[271,272],"hr",{},[274,275,277],"h2",{"id":276},"at-a-glance","At a glance",[279,280,281,304],"table",{},[282,283,284],"thead",{},[285,286,287,290,293,296,299],"tr",{},[288,289],"th",{},[288,291,292],{},"Cashier (Stripe Billing)",[288,294,295],{},"Cashier (Paddle)",[288,297,298],{},"Lemon Squeezy",[288,300,301],{},[226,302,303],{},"Vatly",[305,306,307,333,358,378,407,430,467,491,516,533,549,567],"tbody",{},[285,308,309,313,318,323,328],{},[310,311,312],"td",{},"Composer package",[310,314,315],{},[208,316,317],{},"laravel\u002Fcashier",[310,319,320],{},[208,321,322],{},"laravel\u002Fcashier-paddle",[310,324,325],{},[208,326,327],{},"lemonsqueezy\u002Flaravel",[310,329,330],{},[208,331,332],{},"vatly\u002Fvatly-laravel",[285,334,335,338,343,348,353],{},[310,336,337],{},"Billable trait",[310,339,340],{},[208,341,342],{},"Laravel\\Cashier\\Billable",[310,344,345],{},[208,346,347],{},"Laravel\\Paddle\\Billable",[310,349,350],{},[208,351,352],{},"LemonSqueezy\\Laravel\\Billable",[310,354,355],{},[208,356,357],{},"Vatly\\Laravel\\Billable",[285,359,360,362,368,371,373],{},[310,361,228],{},[310,363,364,367],{},[226,365,366],{},"No"," — you are the seller",[310,369,370],{},"Yes",[310,372,370],{},[310,374,375],{},[226,376,377],{},"Yes (full)",[285,379,380,383,389,395,402],{},[310,381,382],{},"Entity \u002F jurisdiction",[310,384,385,388],{},[221,386,387],{},"You"," (wherever you're registered)",[310,390,391,392],{},"Paddle, ",[226,393,394],{},"UK",[310,396,397,398,401],{},"Lemon Squeezy, ",[226,399,400],{},"US"," (Stripe-owned)",[310,403,404],{},[226,405,406],{},"EEA \u002F EU jurisdiction",[285,408,409,412,421,424,426],{},[310,410,411],{},"Who remits VAT\u002Fsales tax",[310,413,414,416,417,420],{},[226,415,387],{}," (Stripe Tax only ",[221,418,419],{},"calculates",")",[310,422,423],{},"Provider",[310,425,423],{},[310,427,428],{},[226,429,423],{},[285,431,432,435,442,451,457],{},[310,433,434],{},"Customer stored as",[310,436,437,438,441],{},"columns on the billable model (",[208,439,440],{},"stripe_id",", …)",[310,443,444,447,448,420],{},[208,445,446],{},"customers"," table (",[208,449,450],{},"paddle_id",[310,452,453,456],{},[208,454,455],{},"lemon_squeezy_customers"," table",[310,458,459,462,463,466],{},[208,460,461],{},"vatly_id"," column on the billable model + ",[208,464,465],{},"vatly_*"," tables",[285,468,469,472,475,482,485],{},[310,470,471],{},"Checkout",[310,473,474],{},"Stripe Checkout (hosted) \u002F Elements",[310,476,477,478,481],{},"Paddle.js ",[226,479,480],{},"overlay \u002F inline"," (client-side JS)",[310,483,484],{},"Lemon.js overlay \u002F hosted URL",[310,486,487,490],{},[226,488,489],{},"Vatly-hosted redirect"," (+ guest claim)",[285,492,493,496,501,506,511],{},[310,494,495],{},"Webhook route",[310,497,498],{},[208,499,500],{},"\u002Fstripe\u002Fwebhook",[310,502,503],{},[208,504,505],{},"\u002Fpaddle\u002Fwebhook",[310,507,508],{},[208,509,510],{},"\u002Flemon-squeezy\u002Fwebhook",[310,512,513],{},[208,514,515],{},"\u002Fwebhooks\u002Fvatly",[285,517,518,521,523,525,527],{},[310,519,520],{},"Coupons \u002F promo codes",[310,522,370],{},[310,524,370],{},[310,526,370],{},[310,528,529,532],{},[226,530,531],{},"On the roadmap"," (workaround below)",[285,534,535,538,540,542,544],{},[310,536,537],{},"License keys",[310,539,366],{},[310,541,366],{},[310,543,370],{},[310,545,546,548],{},[226,547,531],{}," (rarely needed for SaaS)",[285,550,551,554,557,560,562],{},[310,552,553],{},"Refunds & chargebacks",[310,555,556],{},"wire it yourself",[310,558,559],{},"events",[310,561,559],{},[310,563,564],{},[226,565,566],{},"first-class models + events",[285,568,569,572,574,576,578],{},[310,570,571],{},"Trials, swap, grace\u002Fresume",[310,573,370],{},[310,575,370],{},[310,577,370],{},[310,579,580],{},[226,581,370],{},[204,583,584],{},"Two takeaways:",[586,587,588,608],"ol",{},[589,590,591,601,602,607],"li",{},[226,592,593,594,596,597,600],{},"With ",[208,595,317],{},", ",[221,598,599],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[242,603,606],{"href":604,"rel":605},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[246],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[589,609,610,613],{},[226,611,612],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[271,615],{},[274,617,619],{"id":618},"the-developer-experience","The developer experience",[204,621,622,623,625],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[208,624,210],{}," trait, and\nthe code reads like Cashier:",[627,628,632],"pre",{"className":629,"code":630,"language":631,"meta":117,"style":117},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[208,633,634,660,667,684,690,701],{"__ignoreMap":117},[635,636,639,643,647,651,653,655,657],"span",{"class":637,"line":638},"line",1,[635,640,642],{"class":641},"sbssI","use",[635,644,646],{"class":645},"sTEyZ"," Vatly",[635,648,650],{"class":649},"sMK4o","\\",[635,652,160],{"class":645},[635,654,650],{"class":649},[635,656,210],{"class":645},[635,658,659],{"class":649},";\n",[635,661,663],{"class":637,"line":662},2,[635,664,666],{"emptyLinePlaceholder":665},true,"\n",[635,668,670,674,678,681],{"class":637,"line":669},3,[635,671,673],{"class":672},"spNyl","class",[635,675,677],{"class":676},"sBMFI"," User",[635,679,680],{"class":672}," extends",[635,682,683],{"class":676}," Authenticatable\n",[635,685,687],{"class":637,"line":686},4,[635,688,689],{"class":649},"{\n",[635,691,693,696,699],{"class":637,"line":692},5,[635,694,695],{"class":641},"    use",[635,697,698],{"class":645}," Billable",[635,700,659],{"class":649},[635,702,704],{"class":637,"line":703},6,[635,705,706],{"class":649},"}\n",[627,708,710],{"className":629,"code":709,"language":631,"meta":117,"style":117},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[208,711,712,718,745,768,782,792,796,830,835,841,863,869,874,879,908,930,951,956,962,980,1028,1051,1072,1077,1082,1088,1115,1132],{"__ignoreMap":117},[635,713,714],{"class":637,"line":638},[635,715,717],{"class":716},"sHwdD","\u002F\u002F Start a su