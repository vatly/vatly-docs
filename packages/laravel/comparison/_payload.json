vascript\u002F9.webhooks",{"title":234,"path":235,"stem":236,"children":237,"page":57},"Fluent Js","\u002Fpackages\u002Ffluent-js","3.packages\u002F4.fluent-js",[238],{"title":125,"path":239,"stem":240},"\u002Fpackages\u002Ffluent-js\u002Freadme","3.packages\u002F4.fluent-js\u002F0.readme",{"title":242,"path":243,"stem":244},"Integrations","\u002Fintegrations","4.integrations",{"id":246,"title":183,"body":247,"description":1427,"extension":1428,"links":1429,"meta":1430,"navigation":712,"path":184,"seo":1431,"stem":185,"__hash__":1432},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":248,"value":249,"toc":1420},"minimark",[250,281,307,317,320,325,629,632,661,663,667,673,754,1184,1193,1195,1199,1202,1313,1316,1318,1322,1329,1350,1358,1360,1364,1402,1416],[251,252,253,254,258,259,262,263,266,267,271,272,276,277,280],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[255,256,257],"code",{},"Billable"," trait, ",[255,260,261],{},"subscribed()",",\n",[255,264,265],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[268,269,270],"em",{},"behind","\nthe API: Vatly is a ",[273,274,275],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[273,278,279],{},"Europe-first",", operating under EU\njurisdiction.",[251,282,283,284,287,288,262,295,300,301,306],{},"This page is an honest, side-by-side look at how ",[255,285,286],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[289,290,294],"a",{"href":291,"rel":292},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[293],"nofollow","Laravel Cashier (Stripe)",[289,296,299],{"href":297,"rel":298},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[293],"Laravel Cashier (Paddle)",", and\n",[289,302,305],{"href":303,"rel":304},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[293],"Lemon Squeezy for Laravel"," — gaps included.",[308,309,310,313,314,316],"note",{},[273,311,312],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[289,315,187],{"href":188}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[318,319],"hr",{},[321,322,324],"h2",{"id":323},"at-a-glance","At a glance",[326,327,328,351],"table",{},[329,330,331],"thead",{},[332,333,334,337,340,343,346],"tr",{},[335,336],"th",{},[335,338,339],{},"Cashier (Stripe Billing)",[335,341,342],{},"Cashier (Paddle)",[335,344,345],{},"Lemon Squeezy",[335,347,348],{},[273,349,350],{},"Vatly",[352,353,354,380,405,425,454,477,514,538,563,580,596,614],"tbody",{},[332,355,356,360,365,370,375],{},[357,358,359],"td",{},"Composer package",[357,361,362],{},[255,363,364],{},"laravel\u002Fcashier",[357,366,367],{},[255,368,369],{},"laravel\u002Fcashier-paddle",[357,371,372],{},[255,373,374],{},"lemonsqueezy\u002Flaravel",[357,376,377],{},[255,378,379],{},"vatly\u002Fvatly-laravel",[332,381,382,385,390,395,400],{},[357,383,384],{},"Billable trait",[357,386,387],{},[255,388,389],{},"Laravel\\Cashier\\Billable",[357,391,392],{},[255,393,394],{},"Laravel\\Paddle\\Billable",[357,396,397],{},[255,398,399],{},"LemonSqueezy\\Laravel\\Billable",[357,401,402],{},[255,403,404],{},"Vatly\\Laravel\\Billable",[332,406,407,409,415,418,420],{},[357,408,275],{},[357,410,411,414],{},[273,412,413],{},"No"," — you are the seller",[357,416,417],{},"Yes",[357,419,417],{},[357,421,422],{},[273,423,424],{},"Yes (full)",[332,426,427,430,436,442,449],{},[357,428,429],{},"Entity \u002F jurisdiction",[357,431,432,435],{},[268,433,434],{},"You"," (wherever you're registered)",[357,437,438,439],{},"Paddle, ",[273,440,441],{},"UK",[357,443,444,445,448],{},"Lemon Squeezy, ",[273,446,447],{},"US"," (Stripe-owned)",[357,450,451],{},[273,452,453],{},"EEA \u002F EU jurisdiction",[332,455,456,459,468,471,473],{},[357,457,458],{},"Who remits VAT\u002Fsales tax",[357,460,461,463,464,467],{},[273,462,434],{}," (Stripe Tax only ",[268,465,466],{},"calculates",")",[357,469,470],{},"Provider",[357,472,470],{},[357,474,475],{},[273,476,470],{},[332,478,479,482,489,498,504],{},[357,480,481],{},"Customer stored as",[357,483,484,485,488],{},"columns on the billable model (",[255,486,487],{},"stripe_id",", …)",[357,490,491,494,495,467],{},[255,492,493],{},"customers"," table (",[255,496,497],{},"paddle_id",[357,499,500,503],{},[255,501,502],{},"lemon_squeezy_customers"," table",[357,505,506,509,510,513],{},[255,507,508],{},"vatly_id"," column on the billable model + ",[255,511,512],{},"vatly_*"," tables",[332,515,516,519,522,529,532],{},[357,517,518],{},"Checkout",[357,520,521],{},"Stripe Checkout (hosted) \u002F Elements",[357,523,524,525,528],{},"Paddle.js ",[273,526,527],{},"overlay \u002F inline"," (client-side JS)",[357,530,531],{},"Lemon.js overlay \u002F hosted URL",[357,533,534,537],{},[273,535,536],{},"Vatly-hosted redirect"," (+ guest claim)",[332,539,540,543,548,553,558],{},[357,541,542],{},"Webhook route",[357,544,545],{},[255,546,547],{},"\u002Fstripe\u002Fwebhook",[357,549,550],{},[255,551,552],{},"\u002Fpaddle\u002Fwebhook",[357,554,555],{},[255,556,557],{},"\u002Flemon-squeezy\u002Fwebhook",[357,559,560],{},[255,561,562],{},"\u002Fwebhooks\u002Fvatly",[332,564,565,568,570,572,574],{},[357,566,567],{},"Coupons \u002F promo codes",[357,569,417],{},[357,571,417],{},[357,573,417],{},[357,575,576,579],{},[273,577,578],{},"On the roadmap"," (workaround below)",[332,581,582,585,587,589,591],{},[357,583,584],{},"License keys",[357,586,413],{},[357,588,413],{},[357,590,417],{},[357,592,593,595],{},[273,594,578],{}," (rarely needed for SaaS)",[332,597,598,601,604,607,609],{},[357,599,600],{},"Refunds & chargebacks",[357,602,603],{},"wire it yourself",[357,605,606],{},"events",[357,608,606],{},[357,610,611],{},[273,612,613],{},"first-class models + events",[332,615,616,619,621,623,625],{},[357,617,618],{},"Trials, swap, grace\u002Fresume",[357,620,417],{},[357,622,417],{},[357,624,417],{},[357,626,627],{},[273,628,417],{},[251,630,631],{},"Two takeaways:",[633,634,635,655],"ol",{},[636,637,638,648,649,654],"li",{},[273,639,640,641,643,644,647],{},"With ",[255,642,364],{},", ",[268,645,646],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[289,650,653],{"href":651,"rel":652},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[293],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[636,656,657,660],{},[273,658,659],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[318,662],{},[321,664,666],{"id":665},"the-developer-experience","The developer experience",[251,668,669,670,672],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[255,671,257],{}," trait, and\nthe code reads like Cashier:",[674,675,679],"pre",{"className":676,"code":677,"language":678,"meta":117,"style":117},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[255,680,681,707,714,731,737,748],{"__ignoreMap":117},[682,683,686,690,694,698,700,702,704],"span",{"class":684,"line":685},"line",1,[682,687,689],{"class":688},"sbssI","use",[682,691,693],{"class":692},"sTEyZ"," Vatly",[682,695,697],{"class":696},"sMK4o","\\",[682,699,160],{"class":692},[682,701,697],{"class":696},[682,703,257],{"class":692},[682,705,706],{"class":696},";\n",[682,708,710],{"class":684,"line":709},2,[682,711,713],{"emptyLinePlaceholder":712},true,"\n",[682,715,717,721,725,728],{"class":684,"line":716},3,[682,718,720],{"class":719},"spNyl","class",[682,722,724],{"class":723},"sBMFI"," User",[682,726,727],{"class":719}," extends",[682,729,730],{"class":723}," Authenticatable\n",[682,732,734],{"class":684,"line":733},4,[682,735,736],{"class":696},"{\n",[682,738,740,743,746],{"class":684,"line":739},5,[682,741,742],{"class":688},"    use",[682,744,745],{"class":692}," Billable",[682,747,706],{"class":696},[682,749,751],{"class":684,"line":750},6,[682,752,753],{"class":696},"}\n",[674,755,757],{"className":676,"code":756,"language":678,"meta":117,"style":117},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[255,758,759,765,792,815,829,839,843,877,882,888,910,916,921,926,955,977,998,1003,1009,1027,1075,1098,1119,1124,1129,1135,1162,1179],{"__ignoreMap":117},[682,760,761],{"class":684,"line":685},[682,762,764],{"class":763},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[682,76