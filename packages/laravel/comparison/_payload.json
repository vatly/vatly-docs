},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":288,"title":182,"body":289,"description":1470,"extension":1471,"links":1472,"meta":1473,"navigation":755,"path":183,"seo":1474,"stem":184,"__hash__":1475},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":290,"value":291,"toc":1463},"minimark",[292,323,349,359,362,367,671,674,703,705,709,715,797,1227,1236,1238,1242,1245,1356,1359,1361,1365,1372,1393,1401,1403,1407,1445,1459],[293,294,295,296,300,301,304,305,308,309,313,314,318,319,322],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[297,298,299],"code",{},"Billable"," trait, ",[297,302,303],{},"subscribed()",",\n",[297,306,307],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[310,311,312],"em",{},"behind","\nthe API: Vatly is a ",[315,316,317],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[315,320,321],{},"Europe-first",", operating under EU\njurisdiction.",[293,324,325,326,329,330,304,337,342,343,348],{},"This page is an honest, side-by-side look at how ",[297,327,328],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[331,332,336],"a",{"href":333,"rel":334},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[335],"nofollow","Laravel Cashier (Stripe)",[331,338,341],{"href":339,"rel":340},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[335],"Laravel Cashier (Paddle)",", and\n",[331,344,347],{"href":345,"rel":346},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[335],"Lemon Squeezy for Laravel"," — gaps included.",[350,351,352,355,356,358],"note",{},[315,353,354],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[331,357,186],{"href":187}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[360,361],"hr",{},[363,364,366],"h2",{"id":365},"at-a-glance","At a glance",[368,369,370,393],"table",{},[371,372,373],"thead",{},[374,375,376,379,382,385,388],"tr",{},[377,378],"th",{},[377,380,381],{},"Cashier (Stripe Billing)",[377,383,384],{},"Cashier (Paddle)",[377,386,387],{},"Lemon Squeezy",[377,389,390],{},[315,391,392],{},"Vatly",[394,395,396,422,447,467,496,519,556,580,605,622,638,656],"tbody",{},[374,397,398,402,407,412,417],{},[399,400,401],"td",{},"Composer package",[399,403,404],{},[297,405,406],{},"laravel\u002Fcashier",[399,408,409],{},[297,410,411],{},"laravel\u002Fcashier-paddle",[399,413,414],{},[297,415,416],{},"lemonsqueezy\u002Flaravel",[399,418,419],{},[297,420,421],{},"vatly\u002Fvatly-laravel",[374,423,424,427,432,437,442],{},[399,425,426],{},"Billable trait",[399,428,429],{},[297,430,431],{},"Laravel\\Cashier\\Billable",[399,433,434],{},[297,435,436],{},"Laravel\\Paddle\\Billable",[399,438,439],{},[297,440,441],{},"LemonSqueezy\\Laravel\\Billable",[399,443,444],{},[297,445,446],{},"Vatly\\Laravel\\Billable",[374,448,449,451,457,460,462],{},[399,450,317],{},[399,452,453,456],{},[315,454,455],{},"No"," — you are the seller",[399,458,459],{},"Yes",[399,461,459],{},[399,463,464],{},[315,465,466],{},"Yes (full)",[374,468,469,472,478,484,491],{},[399,470,471],{},"Entity \u002F jurisdiction",[399,473,474,477],{},[310,475,476],{},"You"," (wherever you're registered)",[399,479,480,481],{},"Paddle, ",[315,482,483],{},"UK",[399,485,486,487,490],{},"Lemon Squeezy, ",[315,488,489],{},"US"," (Stripe-owned)",[399,492,493],{},[315,494,495],{},"EEA \u002F EU jurisdiction",[374,497,498,501,510,513,515],{},[399,499,500],{},"Who remits VAT\u002Fsales tax",[399,502,503,505,506,509],{},[315,504,476],{}," (Stripe Tax only ",[310,507,508],{},"calculates",")",[399,511,512],{},"Provider",[399,514,512],{},[399,516,517],{},[315,518,512],{},[374,520,521,524,531,540,546],{},[399,522,523],{},"Customer stored as",[399,525,526,527,530],{},"columns on the billable model (",[297,528,529],{},"stripe_id",", …)",[399,532,533,536,537,509],{},[297,534,535],{},"customers"," table (",[297,538,539],{},"paddle_id",[399,541,542,545],{},[297,543,544],{},"lemon_squeezy_customers"," table",[399,547,548,551,552,555],{},[297,549,550],{},"vatly_id"," column on the billable model + ",[297,553,554],{},"vatly_*"," tables",[374,557,558,561,564,571,574],{},[399,559,560],{},"Checkout",[399,562,563],{},"Stripe Checkout (hosted) \u002F Elements",[399,565,566,567,570],{},"Paddle.js ",[315,568,569],{},"overlay \u002F inline"," (client-side JS)",[399,572,573],{},"Lemon.js overlay \u002F hosted URL",[399,575,576,579],{},[315,577,578],{},"Vatly-hosted redirect"," (+ guest claim)",[374,581,582,585,590,595,600],{},[399,583,584],{},"Webhook route",[399,586,587],{},[297,588,589],{},"\u002Fstripe\u002Fwebhook",[399,591,592],{},[297,593,594],{},"\u002Fpaddle\u002Fwebhook",[399,596,597],{},[297,598,599],{},"\u002Flemon-squeezy\u002Fwebhook",[399,601,602],{},[297,603,604],{},"\u002Fwebhooks\u002Fvatly",[374,606,607,610,612,614,616],{},[399,608,609],{},"Coupons \u002F promo codes",[399,611,459],{},[399,613,459],{},[399,615,459],{},[399,617,618,621],{},[315,619,620],{},"On the roadmap"," (workaround below)",[374,623,624,627,629,631,633],{},[399,625,626],{},"License keys",[399,628,455],{},[399,630,455],{},[399,632,459],{},[399,634,635,637],{},[315,636,620],{}," (rarely needed for SaaS)",[374,639,640,643,646,649,651],{},[399,641,642],{},"Refunds & chargebacks",[399,644,645],{},"wire it yourself",[399,647,648],{},"events",[399,650,648],{},[399,652,653],{},[315,654,655],{},"first-class models + events",[374,657,658,661,663,665,667],{},[399,659,660],{},"Trials, swap, grace\u002Fresume",[399,662,459],{},[399,664,459],{},[399,666,459],{},[399,668,669],{},[315,670,459],{},[293,672,673],{},"Two takeaways:",[675,676,677,697],"ol",{},[678,679,680,690,691,696],"li",{},[315,681,682,683,685,686,689],{},"With ",[297,684,406],{},", ",[310,687,688],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[331,692,695],{"href":693,"rel":694},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[335],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[678,698,699,702],{},[315,700,701],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[360,704],{},[363,706,708],{"id":707},"the-developer-experience","The developer experience",[293,710,711,712,714],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[297,713,299],{}," trait, and\nthe code reads like Cashier:",[716,717,722],"pre",{"className":718,"code":719,"language":720,"meta":721,"style":721},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[297,723,724,750,757,774,780,791],{"__ignoreMap":721},[725,726,729,733,737,741,743,745,747],"span",{"class":727,"line":728},"line",1,[725,730,732],{"class":731},"sbssI","use",[725,734,736],{"class":735},"sTEyZ"," Vatly",[725,738,740],{"class":739},"sMK4o","\\",[725,742,159],{"class":735},[725,744,740],{"class":739},[725,746,299],{"class":735},[725,748,749],{"class":739},";\n",[725,751,753],{"class":727,"line":752},2,[725,754,756],{"emptyLinePlaceholder":755},true,"\n",[725,758,760,764,768,771],{"class":727,"line":759},3,[725,761,763],{"class":762},"spNyl","class",[725,765,767],{"class":766},"sBMFI"," User",[725,769,770],{"class":762}," extends",[725,772,773],{"class":766}," Authenticatable\n",[725,775,777],{"class":727,"line":776},4,[725,778,779],{"class":739},"{\n",[725,781,783,786,789],{"class":727,"line":782},5,[725,784,785],{"class":731},"    use",[725,787,788],{"class":735}," Billable",[725,790,749],{"class":739},[725,792,794],{"class":727,"line":793},6,[725,795,796],{"class":739},"}\n",[716,798,800],{"className":718,"code":799,"language":720,"meta":721,"style":721},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[297,801,802,808,835,858,872,882,886,920,925,931,953,959,964,969,998,1020,1041,1046,1052,1070,1118,1141,1162,1167,1172,1178,1205,1222],{"__ignoreMap":721},[725,803,804],{"class":727,"line":728},[725,805,807],{"class":806},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[725,809,810,813,816,819,822,825,828,832],{"class":727,"line":752},[725,811,812],{"class":739},"$",[725,814,815],{"class":735},"checkout ",[725,817,818],{"class":739},"=",[725,820,821],{"class":739}," $",[725,823,824],{"class":735},"user",[725,826,827],{"class":739},"->",[725,829,831],{"class":830},"s2Zo4","subscribe",[725,833,834],{"class":739},"()\n",[725,836,837,840,843,846,849,853,855],{"class":727,"line":759},[725,838,839],{"class":739},"    ->",[725,841,842],{"class":830},"toPlan",[725,844,845],{"class":739},"(",[725,847,848],{"class":739},"'",[725,850,852],{"class":851},"sfazB","subscription_plan_7Hd9Kf2Lm",[725,854,848],{"class":739},[725,856,857],{"class":739},")\n",[725,859,860,862,865,867,870],{"class":727,"line":776},[725,861,839],{"class":739},[725,863,864],{"class":830},"withTrialDays",[725,866,845],{"class":739},[725,868,869],{"class":731},"14",[725,871,857],{"class":739},[725,873,874,876,879],{"class":727,"line":782},[725,875,839],{"class":739},[725,877,878],{"class":830},"create",[725,880,881],{"class":739},"();\n",[725,883,884],{"class":727,"line":793},[725,885,756],{"emptyLinePlaceholder":755},[725,887,889,893,896,899,902,904,907,909,912,914,917],{"class":727,"line":888},7,[725,890,892],{"class":891},"s7zQu","return",[725,894,895],{"class":830}," redirect",[725,897,898],{"class":739},"($",[725,900,901],{"class":735},"checkout",[725,903,827],{"class":739},[725,905,906],{"class":735},"links",[725,908,827],{"class":739},[725,910,911],{"class":735},"checkoutUrl",[725,913,827],{"class":739},[725,915,916],{"class":735},"href",[725,918,919],{"class":739},");\n",[725,921,923],{"class":727,"line":922},8,[725,924,756],{"emptyLinePlaceholder":755},[725,926,928],{"class":727,"line":927},9,[725,929,930],{"class":806},"\u002F\u002F Gate features on subscription state\n",[725,932,934,937,940,942,944,947,950],{"class":727,"line":933},10,[725,935,936],{"class":891},"if",[725,938,939],{"class":739}," ($",[725,941,824],{"class":735},[725,943,827],{"class":739},[725,945,946],{"class":830},"subscribed",[725,948,949],{"class":739},"())",[725,951,952],{"class":739}," {\n",[725,954,956],{"class":727,"line":955},11,[725,957,958],{"class":806},"    \u002F\u002F …\n",[725,960,962],{"class":727,"line":961},12,[725,963,796],{"class":739},[725,965,967],{"class":72