stem":151},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to another billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Integrations","/integrations","4.integrations",{"id":184,"title":172,"body":185,"description":1369,"extension":1370,"links":1371,"meta":1372,"navigation":653,"path":173,"seo":1373,"stem":174,"__hash__":1374},"docs/3.packages/2.laravel/99.comparison.md",{"type":186,"value":187,"toc":1362},"minimark",[188,219,245,259,262,267,571,574,602,604,608,614,695,1125,1134,1136,1140,1143,1254,1257,1259,1263,1270,1291,1298,1300,1304,1344,1358],[189,190,191,192,196,197,200,201,204,205,209,210,214,215,218],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[193,194,195],"code",{},"Billable"," trait, ",[193,198,199],{},"subscribed()",",\n",[193,202,203],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[206,207,208],"em",{},"behind","\nthe API: Vatly is a ",[211,212,213],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[211,216,217],{},"Europe-first",", operating under EU\njurisdiction.",[189,220,221,222,225,226,200,233,238,239,244],{},"This page is an honest, side-by-side look at how ",[193,223,224],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[227,228,232],"a",{"href":229,"rel":230},"https://laravel.com/docs/12.x/billing",[231],"nofollow","Laravel Cashier (Stripe)",[227,234,237],{"href":235,"rel":236},"https://laravel.com/docs/12.x/cashier-paddle",[231],"Laravel Cashier (Paddle)",", and\n",[227,240,243],{"href":241,"rel":242},"https://github.com/lmsqueezy/laravel",[231],"Lemon Squeezy for Laravel"," — gaps included.",[246,247,248],"blockquote",{},[189,249,250,253,254,258],{},[211,251,252],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[227,255,257],{"href":256},"Coexisting-with-Cashier","Running alongside another provider"," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[260,261],"hr",{},[263,264,266],"h2",{"id":265},"at-a-glance","At a glance",[268,269,270,293],"table",{},[271,272,273],"thead",{},[274,275,276,279,282,285,288],"tr",{},[277,278],"th",{},[277,280,281],{},"Cashier (Stripe Billing)",[277,283,284],{},"Cashier (Paddle)",[277,286,287],{},"Lemon Squeezy",[277,289,290],{},[211,291,292],{},"Vatly",[294,295,296,322,347,367,396,419,456,480,505,522,538,556],"tbody",{},[274,297,298,302,307,312,317],{},[299,300,301],"td",{},"Composer package",[299,303,304],{},[193,305,306],{},"laravel/cashier",[299,308,309],{},[193,310,311],{},"laravel/cashier-paddle",[299,313,314],{},[193,315,316],{},"lemonsqueezy/laravel",[299,318,319],{},[193,320,321],{},"vatly/vatly-laravel",[274,323,324,327,332,337,342],{},[299,325,326],{},"Billable trait",[299,328,329],{},[193,330,331],{},"Laravel\\Cashier\\Billable",[299,333,334],{},[193,335,336],{},"Laravel\\Paddle\\Billable",[299,338,339],{},[193,340,341],{},"LemonSqueezy\\Laravel\\Billable",[299,343,344],{},[193,345,346],{},"Vatly\\Laravel\\Billable",[274,348,349,351,357,360,362],{},[299,350,213],{},[299,352,353,356],{},[211,354,355],{},"No"," — you are the seller",[299,358,359],{},"Yes",[299,361,359],{},[299,363,364],{},[211,365,366],{},"Yes (full)",[274,368,369,372,378,384,391],{},[299,370,371],{},"Entity / jurisdiction",[299,373,374,377],{},[206,375,376],{},"You"," (wherever you're registered)",[299,379,380,381],{},"Paddle, ",[211,382,383],{},"UK",[299,385,386,387,390],{},"Lemon Squeezy, ",[211,388,389],{},"US"," (Stripe-owned)",[299,392,393],{},[211,394,395],{},"EEA / EU jurisdiction",[274,397,398,401,410,413,415],{},[299,399,400],{},"Who remits VAT/sales tax",[299,402,403,405,406,409],{},[211,404,376],{}," (Stripe Tax only ",[206,407,408],{},"calculates",")",[299,411,412],{},"Provider",[299,414,412],{},[299,416,417],{},[211,418,412],{},[274,420,421,424,431,440,446],{},[299,422,423],{},"Customer stored as",[299,425,426,427,430],{},"columns on the billable model (",[193,428,429],{},"stripe_id",", …)",[299,432,433,436,437,409],{},[193,434,435],{},"customers"," table (",[193,438,439],{},"paddle_id",[299,441,442,445],{},[193,443,444],{},"lemon_squeezy_customers"," table",[299,447,448,451,452,455],{},[193,449,450],{},"vatly_id"," column on the billable model + ",[193,453,454],{},"vatly_*"," tables",[274,457,458,461,464,471,474],{},[299,459,460],{},"Checkout",[299,462,463],{},"Stripe Checkout (hosted) / Elements",[299,465,466,467,470],{},"Paddle.js ",[211,468,469],{},"overlay / inline"," (client-side JS)",[299,472,473],{},"Lemon.js overlay / hosted URL",[299,475,476,479],{},[211,477,478],{},"Vatly-hosted redirect"," (+ guest claim)",[274,481,482,485,490,495,500],{},[299,483,484],{},"Webhook route",[299,486,487],{},[193,488,489],{},"/stripe/webhook",[299,491,492],{},[193,493,494],{},"/paddle/webhook",[299,496,497],{},[193,498,499],{},"/lemon-squeezy/webhook",[299,501,502],{},[193,503,504],{},"/webhooks/vatly",[274,506,507,510,512,514,516],{},[299,508,509],{},"Coupons / promo codes",[299,511,359],{},[299,513,359],{},[299,515,359],{},[299,517,518,521],{},[211,519,520],{},"On the roadmap"," (workaround below)",[274,523,524,527,529,531,533],{},[299,525,526],{},"License keys",[299,528,355],{},[299,530,355],{},[299,532,359],{},[299,534,535,537],{},[211,536,520],{}," (rarely needed for SaaS)",[274,539,540,543,546,549,551],{},[299,541,542],{},"Refunds & chargebacks",[299,544,545],{},"wire it yourself",[299,547,548],{},"events",[299,550,548],{},[299,552,553],{},[211,554,555],{},"first-class models + events",[274,557,558,561,563,565,567],{},[299,559,560],{},"Trials, swap, grace/resume",[299,562,359],{},[299,564,359],{},[299,566,359],{},[299,568,569],{},[211,570,359],{},[189,572,573],{},"Two takeaways:",[575,576,577,596],"ol",{},[578,579,580,589,590,595],"li",{},[211,581,582,584,585,588],{},[193,583,306],{}," runs on classic Stripe Billing, where ",[206,586,587],{},"you're"," the seller of record"," and\nown VAT registration, filing and remittance. Stripe has a real MoR too\n(",[227,591,594],{"href":592,"rel":593},"https://stripe.com/managed-payments",[231],"Managed Payments","), and Cashier — actively maintained —\nwill likely support it before long. Being an MoR is table stakes now, not a Vatly-only edge.",[578,597,598,601],{},[211,599,600],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[260,603],{},[263,605,607],{"id":606},"the-developer-experience","The developer experience",[189,609,610,611,613],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[193,612,195],{}," trait, and\nthe code reads like Cashier:",[615,616,620],"pre",{"className":617,"code":618,"language":619,"meta":105,"style":105},"language-php