94},{"id":1535,"depth":882,"text":1536},"Vatly Laravel Package - Vs Cashier (Stripe, Paddle) & Lemon Squeezy","md",null,{},{"title":199,"description":1599},"Uss4KdmRpvnluPRcK_3mTLfP5gAZbWSH3iCXZSyeF3Y",[1606,1608],{"title":50,"path":196,"stem":197,"description":1607,"children":-1},"Vatly Laravel Package - Webhooks",{"title":203,"path":204,"stem":205,"description":1609,"children":-1},"Vatly Laravel Package - Migrating from Cashier",1794488653773]