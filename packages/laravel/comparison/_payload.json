stem":151},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to your current billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"How Vatly for Laravel compares","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Integrations","/integrations","4.integrations",{"id":184,"title":172,"body":185,"description":1452,"extension":1453,"links":1454,"meta":1455,"navigation":740,"path":173,"seo":1456,"stem":174,"__hash__":1457},"docs/3.packages/2.laravel/99.comparison.md",{"type":186,"value":187,"toc":1444},"minimark",[188,196,226,252,266,269,274,578,581,659,661,665,668,677,686,689,691,695,701,782,1212,1221,1223,1227,1230,1340,1343,1345,1349,1352,1373,1380,1382,1386,1426,1440],[189,190,191],"p",{},[192,193],"img",{"alt":194,"src":195},"Vatly for Laravel","https://raw.githubusercontent.com/Vatly/vatly-laravel/main/art/banner.png",[189,197,198,199,203,204,207,208,211,212,216,217,221,222,225],{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[200,201,202],"code",{},"Billable"," trait, ",[200,205,206],{},"subscribed()",",\n",[200,209,210],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[213,214,215],"em",{},"behind","\nthe API: Vatly is a ",[218,219,220],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[218,223,224],{},"Europe-first",", operating under EU\njurisdiction.",[189,227,228,229,232,233,207,240,245,246,251],{},"This page is an honest, side-by-side look at how ",[200,230,231],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[234,235,239],"a",{"href":236,"rel":237},"https://laravel.com/docs/12.x/billing",[238],"nofollow","Laravel Cashier (Stripe)",[234,241,244],{"href":242,"rel":243},"https://laravel.com/docs/12.x/cashier-paddle",[238],"Laravel Cashier (Paddle)",", and\n",[234,247,250],{"href":248,"rel":249},"https://github.com/lmsqueezy/laravel",[238],"Lemon Squeezy for Laravel"," — gaps included.",[253,254,255],"blockquote",{},[189,256,257,260,261,265],{},[218,258,259],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[234,262,264],{"href":263},"Coexisting-with-Cashier","Running alongside another provider"," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[267,268],"hr",{},[270,271,273],"h2",{"id":272},"at-a-glance","At a glance",[275,276,277,300],"table",{},[278,279,280],"thead",{},[281,282,283,286,289,292,295],"tr",{},[284,285],"th",{},[284,287,288],{},"Cashier (Stripe Billing)",[284,290,291],{},"Cashier (Paddle)",[284,293,294],{},"Lemon Squeezy",[284,296,297],{},[218,298,299],{},"Vatly",[301,302,303,329,354,374,403,426,463,487,512,529,545,563],"tbody",{},[281,304,305,309,314,319,324],{},[306,307,308],"td",{},"Composer package",[306,310,311],{},[200,312,313],{},"laravel/cashier",[306,315,316],{},[200,317,318],{},"laravel/cashier-paddle",[306,320,321],{},[200,322,323],{},"lemonsqueezy/laravel",[306,325,326],{},[200,327,328],{},"vatly/vatly-laravel",[281,330,331,334,339,344,349],{},[306,332,333],{},"Billable trait",[306,335,336],{},[200,337,338],{},"Laravel\\Cashier\\Billable",[306,340,341],{},[200,342,343],{},"Laravel\\Paddle\\Billable",[306,345,346],{},[200,347,348],{},"LemonSqueezy\\Laravel\\Billable",[306,350,351],{},[200,352,353],{},"Vatly\\Laravel\\Billable",[281,355,356,358,364,367,369],{},[306,357,220],{},[306,359,360,363],{},[218,361,362],{},"No"," — you are the seller",[306,365,366],{},"Yes",[306,368,366],{},[306,370,371],{},[218,372,373],{},"Yes (full)",[281,375,376,379,385,391,398],{},[306,377,378],{},"Entity / jurisdiction",[306,380,381,384],{},[213,382,383],{},"You"," (wherever you're registered)",[306,386,387,388],{},"Paddle, ",[218,389,390],{},"UK",[306,392,393,394,397],{},"Lemon Squeezy, ",[218,395,396],{},"US"," (Stripe-owned)",[306,399,400],{},[218,401,402],{},"EEA / EU jurisdiction",[281,404,405,408,417,420,422],{},[306,406,407],{},"Who remits VAT/sales tax",[306,409,410,412,413,416],{},[218,411,383],{}," (Stripe Tax only ",[213,414,415],{},"calculates",")",[306,418,419],{},"Provider",[306,421,419],{},[306,423,424],{},[218,425,419],{},[281,427,428,431,438,447,453],{},[306,429,430],{},"Customer stored as",[306,432,433,434,437],{},"columns on the billable model (",[200,435,436],{},"stripe_id",", …)",[306,439,440,443,444,416],{},[200,441,442],{},"customers"," table (",[200,445,446],{},"paddle_id",[306,448,449,452],{},[200,450,451],{},"lemon_squeezy_customers"," table",[306,454,455,458,459,462],{},[200,456,457],{},"vatly_id"," column on the billable model + ",[200,460,461],{},"vatly_*"," tables",[281,464,465,468,471,478,481],{},[306,466,467],{},"Checkout",[306,469,470],{},"Stripe Checkout (hosted) / Elements",[306,472,473,474,477],{},"Paddle.js ",[218,475,476],{},"overlay / inline"," (client-side JS)",[306,479,480],{},"Lemon.js overlay / hosted URL",[306,482,483,486],{},[218,484,485],{},"Vatly-hosted redirect"," (+ guest claim)",[281,488,489,492,497,502,507],{},[306,490,491],{},"Webhook route",[306,493,494],{},[200,495,496],{},"/stripe/webhook",[306,498,499],{},[200,500,501],{},"/paddle/webhook",[306,503,504],{},[200,505,506],{},"/lemon-squeezy/webhook",[306,508,509],{},[200,510,511],{},"/webhooks/vatly",[281,513,514,517,519,521,523],{},[306,515,516],{},"Coupons / promo codes",[306,518,366],{},[306,520,366],{},[306,522,366],{},[306,524,525,528],{},[218,526,527],{},"On the roadmap"," (workaround below)",[281,530,531,534,536,538,540],{},[306,532,533],{},"License keys",[306,535,362],{},[306,537,362],{},[306,539,366],{},[306,541,542,544],{},[218,543,527],{}," (rarely needed for SaaS)",[281,546,547,550,553,556,558],{},[306,548,549],{},"Refunds & chargebacks",[306,551,552],{},"wire it yourself",[306,554,555],{},"events",[306,557,555],{},[306,559,560],{},[218,561,562],{},"first-class models + events",[281,564,565,568,570,572,574],{},[306,566,567],{},"Trials, swap, grace/resume",[306,569,366],{},[306,571,366],{},[306,573,366],{},[306,575,576],{},[218,577,366],{},[189,579,580],{},"Three things to take from this table:",[582,583,584,612,653],"ol",{},[585,586,587,590,591,593,594,597,598,601,602,607,608,611],"li",{},[218,588,589],{},"The Laravel Cashier (Stripe) package is not a Merchant-of-Record path."," ",[200,592,313],{},"\ndrives ",[213,595,596],{},"classic Stripe Billing",", where ",[218,599,600],{},"you"," are the seller of record: you register for\nVAT/sales tax wherever you cross a threshold, you file, you remit, you issue compliant\ninvoices. ",[234,603,606],{"href":604,"rel":605},"https://stripe.com/tax",[238],"Stripe Tax"," (",[200,609,610],{},"Cashier::calculateTaxes()",") computes the\nrate; the legal and operational burden stays with you. Paddle, Lemon Squeezy and Vatly are\nthe seller instead.",[585,613,614,627,628,631,632,635,636,639,640,643,644,646,647,652],{},[218,615,616,617,620,621,626],{},"Stripe ",[213,618,619],{},"the company"," does now offer an MoR — ",[234,622,625],{"href":623,"rel":624},"https://stripe.com/managed-payments",[238],"Stripe Managed Payments"," —\nbut it's a different product, not the Cashier you're running."," It withholds VAT/GST/sales tax\nacross 80+ countries and takes on fraud, disputes and transaction support. Three things to know\nbefore you lean on it: you reach it through ",[213,629,630],{},"Stripe Checkout / Payment Links"," with\n",[200,633,634],{},"managed_payments"," enabled, ",[218,637,638],{},"not"," through Cashier's subscription API today; Stripe itself\ndescribes it as not yet a ",[213,641,642],{},"complete"," MoR (you stay responsible in unsupported territories and\nfor parts of dispute/refund handling); and it's a ",[218,645,396],{}," company's offering — it's also where\n",[234,648,651],{"href":649,"rel":650},"https://www.lemonsqueezy.com/blog/2026-update",[238],"Lemon Squeezy is being folded in",".",[585,654,655,658],{},[218,656,657],{},"Among the MoRs, the deciding difference is where the entity sits."," Paddle is UK-based;\nLemon Squeezy and Stripe Managed Payments are US. Vatly is EEA-based, under EU jurisdiction —\nyour customer data and your seller-of-record relationship stay in Europe. That, not the API,\nis the reason to choose one over another.",[267,660],{},[270,662,664],{"id":663},"what-a-merchant-of-record-actually-changes-for-you","What a Merchant of Record actually changes for you",[189,666,667],{},"The Laravel surfaces are nearly identical; the operational reality is not.",[189,669,670,673,674,676],{},[218,671,672],{},"Without an MoR"," (Cashier on classic Stripe Billing), ",[213,675,600],{}," are the seller. You own VAT and\nsales-tax registration across every jurisdiction you cross a threshold in, the threshold\nmonitoring itself, filing and remittance, compliant invoice generation, and the liability when\nit's wrong. Stripe Tax computes the right rate; everything around it is yours to build and run.",[189,678,679,682,683,685],{},[218,680,681],{},"With Vatly"," (a full MoR), the platform is the legal seller of record: it charges the\ncustomer, applies the correct tax, issues the invoice, remits to the authorities, and carries\nthe compliance. You integrate subscriptions and gate features on ",[200,684,206],{}," — that's the\nextent of what your app owns.",[189,687,688],{},"For a new product selling into the EU and worldwide, that's the difference between launching\nnow and standing up a tax-and-compliance function first.",[267,690],{},[270,692,694],{"id":693},"the-developer-experience","The developer experience",[189,696,697,698,700],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[200,699,202],{}," trait, and\nthe code reads like Cashier:",[702,703,707],"pre",{"className":704,"code":705,"language":706,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[200,708,709,735,742,759,765,776],{"__ignoreMap":105},[710,711,714,718,722,726,728,730,732],"span",{"class":712,"line":713},"line",1,[710,715,717],{"class":716},"sbssI","use",[710,719,721],{"class":720},"sTEyZ"," Vatly",[710,723,725],{"class":724},"sMK4o","\\",[710,727,145],{"class":720},[710,729,725],{"class":724},[710,731,202],{"class":720},[710,733,734],{"class":724},";\n",[710,736,738],{"class":712,"line":737},2,[710,739,741],{"emptyLinePlaceholder":740},true,"\n",[710,743,745,749,753,756],{"class":712,"line":744},3,[710,746,748],{"class":747},"spNyl","class",[710,750,752],{"class":751},"sBMFI"," User",[710,754,755],{"class":747}," extends",[710,757,758],{"class":751}," Authenticatable\n",[710,760,762],{"class":712,"line":761},4,[710,763,764],{"class":724},"{\n",[710,766,768,771,774],{"class":712,"line":767},5,[710,769,770],{"class":716},"    use",[710,772,773],{"class":720}," Billable",[710,775,734],{"class":724},[710,777,779],{"class":712,"line":778},6,[710,780,781],{"class":724},"}\n",[702,783,785],{"className":704,"code":784,"language":706,"meta":105,"style":105},"// Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n// Gate features on subscription state\nif ($user->subscribed()) {\n    // …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      // Vatly decides immediate vs. grace\n$user->subscription()->resume();      // while on the grace period\n\n// One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n// Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[200,786,787,793,820,843,857,867,871,905,910,916,938,944,949,954,983,1005,1026,1031,1037,1055,1103,1126,1147,1152,1157,1163,1190,1207],{"__ignoreMap":105},[710,788,789],{"class":712,"line":713},[710,790,792],{"class":791},"sHwdD","// Start a subscription — redirect to Vatly's hosted checkout\n",[710,794,795,798,801,804,807,810,813,817],{"class":712,"line":737},[710,796,797],{"class":724},"$",[710,799,800],{"class":720},"checkout ",[710,802,803],{"class":724},"=",[710,805,806],{"class":724}," $",[710,808,809],{"class":720},"user",[710,811,812],{"class":724},"->",[710,814,816],{"class":815},"s2Zo4","subscribe",[710,818,819],{"class":724},"()\n",[710,821,822,825,828,831,834,838,840],{"class":712,"line":744},[710,823,824],{"class":724},"    ->",[710,826,827],{"class":815},"toPlan",[710,829,830],{"class":724},"(",[710,832,833],{"class":724},"'",[710,835,837],{"class":836},"sfazB","subscription_plan_7Hd9Kf2Lm",[710,839,833],{"class":724},[710,841,842],{"class":724},")\n",[710,844,845,847,850,852,855],{"class":712,"line":761},[710,846,824],{"class":724},[710,848,849],{"class":815},"withTrialDays",[710,851,