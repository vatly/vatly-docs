37],[473,474,475,476,480,481,484,485,488,489,493,494,498,499,502],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[477,478,479],"code",{},"Billable"," trait, ",[477,482,483],{},"subscribed()",",\n",[477,486,487],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[490,491,492],"em",{},"behind","\nthe API: Vatly is a ",[495,496,497],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[495,500,501],{},"Europe-first",", operating under EU\njurisdiction.",[473,504,505,506,509,510,484,517,522,523,528],{},"This page is an honest, side-by-side look at how ",[477,507,508],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[511,512,516],"a",{"href":513,"rel":514},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[515],"nofollow","Laravel Cashier (Stripe)",[511,518,521],{"href":519,"rel":520},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[515],"Laravel Cashier (Paddle)",", and\n",[511,524,527],{"href":525,"rel":526},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[515],"Lemon Squeezy for Laravel"," — gaps included.",[530,531,532,535,536,538],"note",{},[495,533,534],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[511,537,242],{"href":243}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[540,541],"hr",{},[543,544,546],"h2",{"id":545},"at-a-glance","At a glance",[548,549,550,573],"table",{},[551,552,553],"thead",{},[554,555,556,559,562,565,568],"tr",{},[557,558],"th",{},[557,560,561],{},"Cashier (Stripe Billing)",[557,563,564],{},"Cashier (Paddle)",[557,566,567],{},"Lemon Squeezy",[557,569,570],{},[495,571,572],{},"Vatly",[574,575,576,602,627,647,676,699,736,759,784,801,817,835],"tbody",{},[554,577,578,582,587,592,597],{},[579,580,581],"td",{},"Composer package",[579,583,584],{},[477,585,586],{},"laravel\u002Fcashier",[579,588,589],{},[477,590,591],{},"laravel\u002Fcashier-paddle",[579,593,594],{},[477,595,596],{},"lemonsqueezy\u002Flaravel",[579,598,599],{},[477,600,601],{},"vatly\u002Fvatly-laravel",[554,603,604,607,612,617,622],{},[579,605,606],{},"Billable trait",[579,608,609],{},[477,610,611],{},"Laravel\\Cashier\\Billable",[579,613,614],{},[477,615,616],{},"Laravel\\Paddle\\Billable",[579,618,619],{},[477,620,621],{},"LemonSqueezy\\Laravel\\Billable",[579,623,624],{},[477,625,626],{},"Vatly\\Laravel\\Billable",[554,628,629,631,637,640,642],{},[579,630,497],{},[579,632,633,636],{},[495,634,635],{},"No"," — you are the seller",[579,638,639],{},"Yes",[579,641,639],{},[579,643,644],{},[495,645,646],{},"Yes (full)",[554,648,649,652,658,664,671],{},[579,650,651],{},"Entity \u002F jurisdiction",[579,653,654,657],{},[490,655,656],{},"You"," (wherever you're registered)",[579,659,660,661],{},"Paddle, ",[495,662,663],{},"UK",[579,665,666,667,670],{},"Lemon Squeezy, ",[495,668,669],{},"US"," (Stripe-owned)",[579,672,673],{},[495,674,675],{},"EEA \u002F EU jurisdiction",[554,677,678,681,690,693,695],{},[579,679,680],{},"Who remits VAT\u002Fsales tax",[579,682,683,685,686,689],{},[495,684,656],{}," (Stripe Tax only ",[490,687,688],{},"calculates",")",[579,691,692],{},"Provider",[579,694,692],{},[579,696,697],{},[495,698,692],{},[554,700,701,704,711,720,726],{},[579,702,703],{},"Customer stored as",[579,705,706,707,710],{},"columns on the billable model (",[477,708,709],{},"stripe_id",", …)",[579,712,713,716,717,689],{},[477,714,715],{},"customers"," table (",[477,718,719],{},"paddle_id",[579,721,722,725],{},[477,723,724],{},"lemon_squeezy_customers"," table",[579,727,728,731,732,735],{},[477,729,730],{},"vatly_id"," column on the billable model + ",[477,733,734],{},"vatly_*"," tables",[554,737,738,740,743,750,753],{},[579,739,429],{},[579,741,742],{},"Stripe Checkout (hosted) \u002F Elements",[579,744,745,746,749],{},"Paddle.js ",[495,747,748],{},"overlay \u002F inline"," (client-side JS)",[579,751,752],{},"Lemon.js overlay \u002F hosted URL",[579,754,755,758],{},[495,756,757],{},"Vatly-hosted redirect"," (+ guest claim)",[554,760,761,764,769,774,779],{},[579,762,763],{},"Webhook route",[579,765,766],{},[477,767,768],{},"\u002Fstripe\u002Fwebhook",[579,770,771],{},[477,772,773],{},"\u002Fpaddle\u002Fwebhook",[579,775,776],{},[477,777,778],{},"\u002Flemon-squeezy\u002Fwebhook",[579,780,781],{},[477,782,783],{},"\u002Fwebhooks\u002Fvatly",[554,785,786,789,791,793,795],{},[579,787,788],{},"Coupons \u002F promo codes",[579,790,639],{},[579,792,639],{},[579,794,639],{},[579,796,797,800],{},[495,798,799],{},"On the roadmap"," (workaround below)",[554,802,803,806,808,810,812],{},[579,804,805],{},"License keys",[579,807,635],{},[579,809,635],{},[579,811,639],{},[579,813,814,816],{},[495,815,799],{}," (rarely needed for SaaS)",[554,818,819,822,825,828,830],{},[579,820,821],{},"Refunds & chargebacks",[579,823,824],{},"wire it yourself",[579,826,827],{},"events",[579,829,827],{},[579,831,832],{},[495,833,834],{},"first-class models + events",[554,836,837,840,842,844,846],{},[579,838,839],{},"Trials, swap, grace\u002Fresume",[579,841,639],{},[579,843,639],{},[579,845,639],{},[579,847,848],{},[495,849,639],{},[473,851,852],{},"Two takeaways:",[854,855,856,876],"ol",{},[857,858,859,869,870,875],"li",{},[495,860,861,862,864,865,868],{},"With ",[477,863,586],{},", ",[490,866,867],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[511,871,874],{"href":872,"rel":873},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[515],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[857,877,878,881],{},[495,879,880],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[540,883],{},[543,885,887],{"id":886},"the-developer-experience","The developer experience",[473,889,890,891,893],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[477,892,479],{}," trait, and\nthe code reads like Cashier:",[895,896,901],"pre",{"className":897,"code":898,"language":899,"meta":900,"style":900},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[477,902,903,929,936,953,959,970],{"__ignoreMap":900},[904,905,908,912,916,920,922,924,926],"span",{"class":906,"line":907},"line",1,[904,909,911],{"class":910},"sbssI","use",[904,913,915],{"class":914},"sTEyZ"," Vatly",[904,917,919],{"class":918},"sMK4o","\\",[904,921,212],{"class":914},[904,923,919],{"class":918},[904,925,479],{"class":914},[904,927,928],{"class":918},";\n",[904,930,932],{"class":906,"line":931},2,[904,933,935],{"emptyLinePlaceholder":934},true,"\n",[904,937,939,943,947,950],{"class":906,"line":938},3,[904,940,942],{"class":941},"spNyl","class",[904,944,946],{"class":945},"sBMFI"," User",[904,948,949],{"class":941}," extends",[904,951,952],{"class":945}," Authenticatable\n",[904,954,956],{"class":906,"line":955},4,[904,957,958],{"class":918},"{\n",[904,960,962,965,968],{"class":906,"line":961},5,[904,963,964],{"class":910},"    use",[904,966,967],{"class":914}," Billable",[904,969,928],{"class":918},[904,971,973],{"class":906,"line":972},6,[904,974,975],{"class":918},"}\n",[895,977,979],{"className":897,"code":978,"language":899,"meta":900,"style":900},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[477,980,981,987,1014,1037,1051,1061,1065,1099,1104,1110,1132,1138,1143,1148,1177,1199,1220,1225,1231,1249,1297,1320,1341,1346,1351,1357,1384,1401],{"__ignoreMap":900},[904,982,983],{"class":906,"line":907},[904,984,986],{"class":985},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[904,988,989,992,995,998,1001,1004,1007,1011],{"class":906,"line":931},[904,990,991],{"class":918},"$",[904,993,994],{"class":914},"checkout ",[904,996,997],{"class":918},"=",[904,999,1000],{"class":918}," $",[904,1002,1003],{"class":914},"user",[904,1005,1006],{"class":918},"->",[904,1008,1010],{"class":1009},"s2Zo4","subscribe",[904,1012,1013],{"class":918},"()\n",[904,1015,1016,1019,1022,1025,1028,1032,1034],{"class":906,"line":938},[904,1017,1018],{"class":918},"    ->",[904,1020,1021],{"class":1009},"toPlan",[904,1023,1024],{"class":918},"(",[904,1026,1027],{"class":918},"'",[904,1029,1031],{"class":1030},"sfazB","subscription_plan_7Hd9Kf2Lm",[904,1033,1027],{"class":918},[904,1035,1036],{"class":918},")\n",[904,1038,1039,1041,1044,1046,1049],{"class":906,"line"