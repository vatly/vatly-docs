50,"stem":151},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to another billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Migrating to Vatly","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/99.migrating-to-vatly",{"title":184,"path":185,"stem":186},"Integrations","/integrations","4.integrations",{"id":188,"title":172,"body":189,"description":1372,"extension":1373,"links":1374,"meta":1375,"navigation":656,"path":173,"seo":1376,"stem":174,"__hash__":1377},"docs/3.packages/2.laravel/99.comparison.md",{"type":190,"value":191,"toc":1365},"minimark",[192,223,249,262,265,270,574,577,605,607,611,617,698,1128,1137,1139,1143,1146,1257,1260,1262,1266,1273,1294,1301,1303,1307,1347,1361],[193,194,195,196,200,201,204,205,208,209,213,214,218,219,222],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[197,198,199],"code",{},"Billable"," trait, ",[197,202,203],{},"subscribed()",",\n",[197,206,207],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[210,211,212],"em",{},"behind","\nthe API: Vatly is a ",[215,216,217],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[215,220,221],{},"Europe-first",", operating under EU\njurisdiction.",[193,224,225,226,229,230,204,237,242,243,248],{},"This page is an honest, side-by-side look at how ",[197,227,228],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[231,232,236],"a",{"href":233,"rel":234},"https://laravel.com/docs/12.x/billing",[235],"nofollow","Laravel Cashier (Stripe)",[231,238,241],{"href":239,"rel":240},"https://laravel.com/docs/12.x/cashier-paddle",[235],"Laravel Cashier (Paddle)",", and\n",[231,244,247],{"href":245,"rel":246},"https://github.com/lmsqueezy/laravel",[235],"Lemon Squeezy for Laravel"," — gaps included.",[250,251,252],"blockquote",{},[193,253,254,257,258,261],{},[215,255,256],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[231,259,180],{"href":260},"Migrating-to-Vatly"," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[263,264],"hr",{},[266,267,269],"h2",{"id":268},"at-a-glance","At a glance",[271,272,273,296],"table",{},[274,275,276],"thead",{},[277,278,279,282,285,288,291],"tr",{},[280,281],"th",{},[280,283,284],{},"Cashier (Stripe Billing)",[280,286,287],{},"Cashier (Paddle)",[280,289,290],{},"Lemon Squeezy",[280,292,293],{},[215,294,295],{},"Vatly",[297,298,299,325,350,370,399,422,459,483,508,525,541,559],"tbody",{},[277,300,301,305,310,315,320],{},[302,303,304],"td",{},"Composer package",[302,306,307],{},[197,308,309],{},"laravel/cashier",[302,311,312],{},[197,313,314],{},"laravel/cashier-paddle",[302,316,317],{},[197,318,319],{},"lemonsqueezy/laravel",[302,321,322],{},[197,323,324],{},"vatly/vatly-laravel",[277,326,327,330,335,340,345],{},[302,328,329],{},"Billable trait",[302,331,332],{},[197,333,334],{},"Laravel\\Cashier\\Billable",[302,336,337],{},[197,338,339],{},"Laravel\\Paddle\\Billable",[302,341,342],{},[197,343,344],{},"LemonSqueezy\\Laravel\\Billable",[302,346,347],{},[197,348,349],{},"Vatly\\Laravel\\Billable",[277,351,352,354,360,363,365],{},[302,353,217],{},[302,355,356,359],{},[215,357,358],{},"No"," — you are the seller",[302,361,362],{},"Yes",[302,364,362],{},[302,366,367],{},[215,368,369],{},"Yes (full)",[277,371,372,375,381,387,394],{},[302,373,374],{},"Entity / jurisdiction",[302,376,377,380],{},[210,378,379],{},"You"," (wherever you're registered)",[302,382,383,384],{},"Paddle, ",[215,385,386],{},"UK",[302,388,389,390,393],{},"Lemon Squeezy, ",[215,391,392],{},"US"," (Stripe-owned)",[302,395,396],{},[215,397,398],{},"EEA / EU jurisdiction",[277,400,401,404,413,416,418],{},[302,402,403],{},"Who remits VAT/sales tax",[302,405,406,408,409,412],{},[215,407,379],{}," (Stripe Tax only ",[210,410,411],{},"calculates",")",[302,414,415],{},"Provider",[302,417,415],{},[302,419,420],{},[215,421,415],{},[277,423,424,427,434,443,449],{},[302,425,426],{},"Customer stored as",[302,428,429,430,433],{},"columns on the billable model (",[197,431,432],{},"stripe_id",", …)",[302,435,436,439,440,412],{},[197,437,438],{},"customers"," table (",[197,441,442],{},"paddle_id",[302,444,445,448],{},[197,446,447],{},"lemon_squeezy_customers"," table",[302,450,451,454,455,458],{},[197,452,453],{},"vatly_id"," column on the billable model + ",[197,456,457],{},"vatly_*"," tables",[277,460,461,464,467,474,477],{},[302,462,463],{},"Checkout",[302,465,466],{},"Stripe Checkout (hosted) / Elements",[302,468,469,470,473],{},"Paddle.js ",[215,471,472],{},"overlay / inline"," (client-side JS)",[302,475,476],{},"Lemon.js overlay / hosted URL",[302,478,479,482],{},[215,480,481],{},"Vatly-hosted redirect"," (+ guest claim)",[277,484,485,488,493,498,503],{},[302,486,487],{},"Webhook route",[302,489,490],{},[197,491,492],{},"/stripe/webhook",[302,494,495],{},[197,496,497],{},"/paddle/webhook",[302,499,500],{},[197,501,502],{},"/lemon-squeezy/webhook",[302,504,505],{},[197,506,507],{},"/webhooks/vatly",[277,509,510,513,515,517,519],{},[302,511,512],{},"Coupons / promo codes",[302,514,362],{},[302,516,362],{},[302,518,362],{},[302,520,521,524],{},[215,522,523],{},"On the roadmap"," (workaround below)",[277,526,527,530,532,534,536],{},[302,528,529],{},"License keys",[302,531,358],{},[302,533,358],{},[302,535,362],{},[302,537,538,540],{},[215,539,523],{}," (rarely needed for SaaS)",[277,542,543,546,549,552,554],{},[302,544,545],{},"Refunds & chargebacks",[302,547,548],{},"wire it yourself",[302,550,551],{},"events",[302,553,551],{},[302,555,556],{},[215,557,558],{},"first-class models + events",[277,560,561,564,566,568,570],{},[302,562,563],{},"Trials, swap, grace/resume",[302,565,362],{},[302,567,362],{},[302,569,362],{},[302,571,572],{},[215,573,362],{},[193,575,576],{},"Two takeaways:",[578,579,580,599],"ol",{},[581,582,583,592,593,598],"li",{},[215,584,585,587,588,591],{},[197,586,309],{}," runs on classic Stripe Billing, where ",[210,589,590],{},"you're"," the seller of record"," and\nown VAT registration, filing and remittance. Stripe has a real MoR too\n(",[231,594,597],{"href":595,"rel":596},"https://stripe.com/managed-payments",[235],"Managed Payments","), and Cashier — actively maintained —\nwill likely support it before long. Being an MoR is table stakes now, not a Vatly-only edge.",[581,600,601,604],{},[215,602,603],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[263,606],{},[266,608,610],{"id":609},"the-developer-experience","The developer experience",[193,612,613,614,616],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[197,615,199],{}," trait, and\nthe code reads like Cashier:",[618,619,623],"pre",{"className":620,"code":621,"language":622,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[197,624,625,651,658,675,681,692],{"__ignoreMap":105},[626,627,630,634,638,642,644,646,648],"span",{"class":628,"line":629},"line",1,[626,631,633],{"class":632},"sbssI","use",[626,635,637],{"class":636},"sTEyZ"," Vatly",[626,639,641],{"class":640},"sMK4o","\\",[626,643,145],{"class":636},[626,645,641],{"class":640},[626,647,199],{"class":636},[626,649,650],{"class":640},";\n",[626,652,654],{"class":628,"line":653},2,[626,655,657],{"emptyLinePlaceholder":656},true,"\n",[626,659,661,665,669,672],{"class":628,"line":660},3,[626,662,664],{"class":663},"spNyl","class",[626,666,668],{"class":667},"sBMFI"," User",[626,670,671],{"class":663}," extends",[626,673,674],{"class":667}," Authenticatable\n",[626,676,678],{"class":628,"line":677},4,[626,679,680],{"class":640},"{\n",[626,682,684,687,690],{"class":628,"line":683},5,[626,685,686],{"class":632},"    use",[626,688,689],{"class":636}," Billable",[626,691,650],{"class":640},[626,693,695],{"class":628,"line":694},6,[626,696,697],{"class":640},"}\n",[618,699,701],{"className":620,"code":700,"language":622,"meta":105,"style":105},"// Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n// Gate features on subscription state\nif ($user->subscribed()) {\n    // …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      // Vatly decides immediate vs. grace\n$user->subscription()->resume();      // while on the grace period\n\n// One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1