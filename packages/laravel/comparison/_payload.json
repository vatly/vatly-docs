ore, Vatly will feel immediately familiar — a ",[473,474,475],"code",{},"Billable"," trait, ",[473,478,479],{},"subscribed()",",\n",[473,482,483],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[486,487,488],"em",{},"behind","\nthe API: Vatly is a ",[491,492,493],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[491,496,497],{},"Europe-first",", operating under EU\njurisdiction.",[469,500,501,502,505,506,480,513,518,519,524],{},"This page is an honest, side-by-side look at how ",[473,503,504],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[507,508,512],"a",{"href":509,"rel":510},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[511],"nofollow","Laravel Cashier (Stripe)",[507,514,517],{"href":515,"rel":516},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[511],"Laravel Cashier (Paddle)",", and\n",[507,520,523],{"href":521,"rel":522},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[511],"Lemon Squeezy for Laravel"," — gaps included.",[526,527,528,531,532,534],"note",{},[491,529,530],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[507,533,241],{"href":242}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[536,537],"hr",{},[539,540,542],"h2",{"id":541},"at-a-glance","At a glance",[544,545,546,569],"table",{},[547,548,549],"thead",{},[550,551,552,555,558,561,564],"tr",{},[553,554],"th",{},[553,556,557],{},"Cashier (Stripe Billing)",[553,559,560],{},"Cashier (Paddle)",[553,562,563],{},"Lemon Squeezy",[553,565,566],{},[491,567,568],{},"Vatly",[570,571,572,598,623,643,672,695,732,755,780,797,813,831],"tbody",{},[550,573,574,578,583,588,593],{},[575,576,577],"td",{},"Composer package",[575,579,580],{},[473,581,582],{},"laravel\u002Fcashier",[575,584,585],{},[473,586,587],{},"laravel\u002Fcashier-paddle",[575,589,590],{},[473,591,592],{},"lemonsqueezy\u002Flaravel",[575,594,595],{},[473,596,597],{},"vatly\u002Fvatly-laravel",[550,599,600,603,608,613,618],{},[575,601,602],{},"Billable trait",[575,604,605],{},[473,606,607],{},"Laravel\\Cashier\\Billable",[575,609,610],{},[473,611,612],{},"Laravel\\Paddle\\Billable",[575,614,615],{},[473,616,617],{},"LemonSqueezy\\Laravel\\Billable",[575,619,620],{},[473,621,622],{},"Vatly\\Laravel\\Billable",[550,624,625,627,633,636,638],{},[575,626,493],{},[575,628,629,632],{},[491,630,631],{},"No"," — you are the seller",[575,634,635],{},"Yes",[575,637,635],{},[575,639,640],{},[491,641,642],{},"Yes (full)",[550,644,645,648,654,660,667],{},[575,646,647],{},"Entity \u002F jurisdiction",[575,649,650,653],{},[486,651,652],{},"You"," (wherever you're registered)",[575,655,656,657],{},"Paddle, ",[491,658,659],{},"UK",[575,661,662,663,666],{},"Lemon Squeezy, ",[491,664,665],{},"US"," (Stripe-owned)",[575,668,669],{},[491,670,671],{},"EEA \u002F EU jurisdiction",[550,673,674,677,686,689,691],{},[575,675,676],{},"Who remits VAT\u002Fsales tax",[575,678,679,681,682,685],{},[491,680,652],{}," (Stripe Tax only ",[486,683,684],{},"calculates",")",[575,687,688],{},"Provider",[575,690,688],{},[575,692,693],{},[491,694,688],{},[550,696,697,700,707,716,722],{},[575,698,699],{},"Customer stored as",[575,701,702,703,706],{},"columns on the billable model (",[473,704,705],{},"stripe_id",", …)",[575,708,709,712,713,685],{},[473,710,711],{},"customers"," table (",[473,714,715],{},"paddle_id",[575,717,718,721],{},[473,719,720],{},"lemon_squeezy_customers"," table",[575,723,724,727,728,731],{},[473,725,726],{},"vatly_id"," column on the billable model + ",[473,729,730],{},"vatly_*"," tables",[550,733,734,736,739,746,749],{},[575,735,425],{},[575,737,738],{},"Stripe Checkout (hosted) \u002F Elements",[575,740,741,742,745],{},"Paddle.js ",[491,743,744],{},"overlay \u002F inline"," (client-side JS)",[575,747,748],{},"Lemon.js overlay \u002F hosted URL",[575,750,751,754],{},[491,752,753],{},"Vatly-hosted redirect"," (+ guest claim)",[550,756,757,760,765,770,775],{},[575,758,759],{},"Webhook route",[575,761,762],{},[473,763,764],{},"\u002Fstripe\u002Fwebhook",[575,766,767],{},[473,768,769],{},"\u002Fpaddle\u002Fwebhook",[575,771,772],{},[473,773,774],{},"\u002Flemon-squeezy\u002Fwebhook",[575,776,777],{},[473,778,779],{},"\u002Fwebhooks\u002Fvatly",[550,781,782,785,787,789,791],{},[575,783,784],{},"Coupons \u002F promo codes",[575,786,635],{},[575,788,635],{},[575,790,635],{},[575,792,793,796],{},[491,794,795],{},"On the roadmap"," (workaround below)",[550,798,799,802,804,806,808],{},[575,800,801],{},"License keys",[575,803,631],{},[575,805,631],{},[575,807,635],{},[575,809,810,812],{},[491,811,795],{}," (rarely needed for SaaS)",[550,814,815,818,821,824,826],{},[575,816,817],{},"Refunds & chargebacks",[575,819,820],{},"wire it yourself",[575,822,823],{},"events",[575,825,823],{},[575,827,828],{},[491,829,830],{},"first-class models + events",[550,832,833,836,838,840,842],{},[575,834,835],{},"Trials, swap, grace\u002Fresume",[575,837,635],{},[575,839,635],{},[575,841,635],{},[575,843,844],{},[491,845,635],{},[469,847,848],{},"Two takeaways:",[850,851,852,872],"ol",{},[853,854,855,865,866,871],"li",{},[491,856,857,858,860,861,864],{},"With ",[473,859,582],{},", ",[486,862,863],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[507,867,870],{"href":868,"rel":869},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[511],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[853,873,874,877],{},[491,875,876],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[536,879],{},[539,881,883],{"id":882},"the-developer-experience","The developer experience",[469,885,886,887,889],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[473,888,475],{}," trait, and\nthe code reads like Cashier:",[891,892,897],"pre",{"className":893,"code":894,"language":895,"meta":896,"style":896},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[473,898,899,925,932,949,955,966],{"__ignoreMap":896},[900,901,904,908,912,916,918,920,922],"span",{"class":902,"line":903},"line",1,[900,905,907],{"class":906},"sbssI","use",[900,909,911],{"class":910},"sTEyZ"," Vatly",[900,913,915],{"class":914},"sMK4o","\\",[900,917,211],{"class":910},[900,919,915],{"class":914},[900,921,475],{"class":910},[900,923,924],{"class":914},";\n",[900,926,928],{"class":902,"line":927},2,[900,929,931],{"emptyLinePlaceholder":930},true,"\n",[900,933,935,939,943,946],{"class":902,"line":934},3,[900,936,938],{"class":937},"spNyl","class",[900,940,942],{"class":941},"sBMFI"," User",[900,944,945],{"class":937}," extends",[900,947,948],{"class":941}," Authenticatable\n",[900,950,952],{"class":902,"line":951},4,[900,953,954],{"class":914},"{\n",[900,956,958,961,964],{"class":902,"line":957},5,[900,959,960],{"class":906},"    use",[900,962,963],{"class":910}," Billable",[900,965,924],{"class":914},[900,967,969],{"class":902,"line":968},6,[900,970,971],{"class":914},"}\n",[891,973,975],{"className":893,"code":974,"language":895,"meta":896,"style":896},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[473,976,977,983,1010,1033,1047,1057,1061,1095,1100,1106,1128,1134,1139,1144,1173,1195,1216,1221,1227,1245,1293,1316,1337,1342,1347,1353,1380,1397],{"__ignoreMap":896},[900,978,979],{"class":902,"line":903},[900,980,982],{"class":981},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[900,984,985,988,991,994,997,1000,1003,1007],{"class":902,"line":927},[900,986,987],{"class":914},"$",[900,989,990],{"class":910},"checkout ",[900,992,993],{"class":914},"=",[900,995,996],{"class":914}," $",[900,998,999],{"class":910},"user",[900,1001,1002],{"class":914},"->",[900,1004,1006],{"class":1005},"s2Zo4","subscribe",[900,1008,1009],{"class":914},"()\n",[900,1011,1012,1015,1018,1021,1024,1028,1030],{"class":902,"line":934},[900,1013,1014],{"class":914},"    ->",[900,1016,1017],{"class":1005},"toPlan",[900,1019,1020],{"class":914},"(",[900,1022,1023],{"class":914},"'",[900,1025,1027],{"class":1026},"sfazB","subscription_plan_7Hd9Kf2Lm",[900,1029,1023],{"class":914},[900,1031,1032],{"class":914},")\n",[900,1034,1035,1037,1040,1042,1045],{"class":902,"line":951},[900,1036,1014],{"class":914},[900,1038,1039],{"class":1005},"withTrialDays",[900,1041,1020],{"class":914},[900,1043,1044],{"class":906},"14",[900,1046,1032],{"cla