ckages/php/webhookendpoints","3.packages/1.php/99.webhookendpoints",{"title":152,"path":153,"stem":154,"children":155,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[156,159,162,165,168,171,174,178,182],{"title":117,"path":157,"stem":158},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":160,"stem":161},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":163,"stem":164},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":166,"stem":167},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":169,"stem":170},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":172,"stem":173},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":175,"path":176,"stem":177},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":179,"path":180,"stem":181},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":183,"path":184,"stem":185},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":187,"path":188,"stem":189},"Integrations","/integrations","4.integrations",{"id":191,"title":175,"body":192,"description":1372,"extension":1373,"links":1374,"meta":1375,"navigation":657,"path":176,"seo":1376,"stem":177,"__hash__":1377},"docs/3.packages/2.laravel/6.comparison.md",{"type":193,"value":194,"toc":1365},"minimark",[195,226,252,262,265,270,574,577,606,608,612,618,699,1129,1138,1140,1144,1147,1258,1261,1263,1267,1274,1295,1303,1305,1309,1347,1361],[196,197,198,199,203,204,207,208,211,212,216,217,221,222,225],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[200,201,202],"code",{},"Billable"," trait, ",[200,205,206],{},"subscribed()",",\n",[200,209,210],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[213,214,215],"em",{},"behind","\nthe API: Vatly is a ",[218,219,220],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[218,223,224],{},"Europe-first",", operating under EU\njurisdiction.",[196,227,228,229,232,233,207,240,245,246,251],{},"This page is an honest, side-by-side look at how ",[200,230,231],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[234,235,239],"a",{"href":236,"rel":237},"https://laravel.com/docs/12.x/billing",[238],"nofollow","Laravel Cashier (Stripe)",[234,241,244],{"href":242,"rel":243},"https://laravel.com/docs/12.x/cashier-paddle",[238],"Laravel Cashier (Paddle)",", and\n",[234,247,250],{"href":248,"rel":249},"https://github.com/lmsqueezy/laravel",[238],"Lemon Squeezy for Laravel"," — gaps included.",[253,254,255,258,259,261],"note",{},[218,256,257],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[234,260,179],{"href":180}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[263,264],"hr",{},[266,267,269],"h2",{"id":268},"at-a-glance","At a glance",[271,272,273,296],"table",{},[274,275,276],"thead",{},[277,278,279,282,285,288,291],"tr",{},[280,281],"th",{},[280,283,284],{},"Cashier (Stripe Billing)",[280,286,287],{},"Cashier (Paddle)",[280,289,290],{},"Lemon Squeezy",[280,292,293],{},[218,294,295],{},"Vatly",[297,298,299,325,350,370,399,422,459,483,508,525,541,559],"tbody",{},[277,300,301,305,310,315,320],{},[302,303,304],"td",{},"Composer package",[302,306,307],{},[200,308,309],{},"laravel/cashier",[302,311,312],{},[200,313,314],{},"laravel/cashier-paddle",[302,316,317],{},[200,318,319],{},"lemonsqueezy/laravel",[302,321,322],{},[200,323,324],{},"vatly/vatly-laravel",[277,326,327,330,335,340,345],{},[302,328,329],{},"Billable trait",[302,331,332],{},[200,333,334],{},"Laravel\\Cashier\\Billable",[302,336,337],{},[200,338,339],{},"Laravel\\Paddle\\Billable",[302,341,342],{},[200,343,344],{},"LemonSqueezy\\Laravel\\Billable",[302,346,347],{},[200,348,349],{},"Vatly\\Laravel\\Billable",[277,351,352,354,360,363,365],{},[302,353,220],{},[302,355,356,359],{},[218,357,358],{},"No"," — you are the seller",[302,361,362],{},"Yes",[302,364,362],{},[302,366,367],{},[218,368,369],{},"Yes (full)",[277,371,372,375,381,387,394],{},[302,373,374],{},"Entity / jurisdiction",[302,376,377,380],{},[213,378,379],{},"You"," (wherever you're registered)",[302,382,383,384],{},"Paddle, ",[218,385,386],{},"UK",[302,388,389,390,393],{},"Lemon Squeezy, ",[218,391,392],{},"US"," (Stripe-owned)",[302,395,396],{},[218,397,398],{},"EEA / EU jurisdiction",[277,400,401,404,413,416,418],{},[302,402,403],{},"Who remits VAT/sales tax",[302,405,406,408,409,412],{},[218,407,379],{}," (Stripe Tax only ",[213,410,411],{},"calculates",")",[302,414,415],{},"Provider",[302,417,415],{},[302,419,420],{},[218,421,415],{},[277,423,424,427,434,443,449],{},[302,425,426],{},"Customer stored as",[302,428,429,430,433],{},"columns on the billable model (",[200,431,432],{},"stripe_id",", …)",[302,435,436,439,440,412],{},[200,437,438],{},"customers"," table (",[200,441,442],{},"paddle_id",[302,444,445,448],{},[200,446,447],{},"lemon_squeezy_customers"," table",[302,450,451,454,455,458],{},[200,452,453],{},"vatly_id"," column on the billable model + ",[200,456,457],{},"vatly_*"," tables",[277,460,461,464,467,474,477],{},[302,462,463],{},"Checkout",[302,465,466],{},"Stripe Checkout (hosted) / Elements",[302,468,469,470,473],{},"Paddle.js ",[218,471,472],{},"overlay / inline"," (client-side JS)",[302,475,476],{},"Lemon.js overlay / hosted URL",[302,478,479,482],{},[218,480,481],{},"Vatly-hosted redirect"," (+ guest claim)",[277,484,485,488,493,498,503],{},[302,486,487],{},"Webhook route",[302,489,490],{},[200,491,492],{},"/stripe/webhook",[302,494,495],{},[200,496,497],{},"/paddle/webhook",[302,499,500],{},[200,501,502],{},"/lemon-squeezy/webhook",[302,504,505],{},[200,506,507],{},"/webhooks/vatly",[277,509,510,513,515,517,519],{},[302,511,512],{},"Coupons / promo codes",[302,514,362],{},[302,516,362],{},[302,518,362],{},[302,520,521,524],{},[218,522,523],{},"On the roadmap"," (workaround below)",[277,526,527,530,532,534,536],{},[302,528,529],{},"License keys",[302,531,358],{},[302,533,358],{},[302,535,362],{},[302,537,538,540],{},[218,539,523],{}," (rarely needed for SaaS)",[277,542,543,546,549,552,554],{},[302,544,545],{},"Refunds & chargebacks",[302,547,548],{},"wire it yourself",[302,550,551],{},"events",[302,553,551],{},[302,555,556],{},[218,557,558],{},"first-class models + events",[277,560,561,564,566,568,570],{},[302,562,563],{},"Trials, swap, grace/resume",[302,565,362],{},[302,567,362],{},[302,569,362],{},[302,571,572],{},[218,573,362],{},[196,575,576],{},"Two takeaways:",[578,579,580,600],"ol",{},[581,582,583,593,594,599],"li",{},[218,584,585,586,588,589,592],{},"With ",[200,587,309],{},", ",[213,590,591],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[234,595,598],{"href":596,"rel":597},"https://stripe.com/managed-payments",[238],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[581,601,602,605],{},[218,603,604],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[263,607],{},[266,609,611],{"id":610},"the-developer-experience","The developer experience",[196,613,614,615,617],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[200,616,202],{}," trait, and\nthe code reads like Cashier:",[619,620,624],"pre",{"className":621,"code":622,"language":623,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[200,625,626,652,659,676,682,693],{"__ignoreMap":109},[627,628,631,635,639,643,645,647,649],"span",{"class":629,"line":630},"line",1,[627,632,634],{"class":633},"sbssI","use",[627,636,638],{"class":637},"sTEyZ"," Vatly",[627,640,642],{"class":641},"sMK4o","\\",[627,644,152],{"class":637},[627,646,642],{"class":641},[627,648,202],{"class":637},[627,650,651],{"class":641},";\n",[627,653,655],{"class":629,"line":654},2,[627,656,658],{"emptyLinePlaceholder":657},true,"\n",[627,660,662,666,670,673],{"class":629,"line":661},3,[627,663,665],{"class":664},"spNyl","class",[627,667,669],{"class":668},"sBMFI"," User",[627,671,672],{"class":664}," extends",[627,674,675],{"class":668}," Authenticatable\n",[627,677,679],{"class":629,"line":678},4,[627,680,681],{"class":641},"{\n",[627,683,685,688,691],{"class":629,"line":684},5,[627,686,687],{"class":633},"    use",[627,689,690],{"class":637}," Billable",[627,692,651],{"class":641},[627,694,696],{"class":629,"line":695},6,[627,697,698],{"class":641},"}\n",[619,700,702],{"className":621,"code":701,"language":623,"meta":109,"style":109},"// Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n// Gate features on subscription state\nif ($user->subscribed()) {\n    // …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      // Vatly decides immediate vs. grace\n$user->subscription()->resume();      // while on the grace period\n\n// One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n// Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[200,703,704,710,737,760,774,784,788,822,827,833,855,861,866,871,900,922,943,948,954,972,1020,1043,1064,1069,1074,1080,1107,1124],{"__ignoreMap":109},[627,705,706],{"class":629,"line":630},[627,707,709],{"class":708},"sHwdD","// Start a subscription — redirect to Vatly's hosted checkout\n",[627,711,712,715,718,721,724,727,730,734],{"class":629,"line":654},[627,713,714],{"class":641},"$",[627,716,717],{"class":637},"checkout ",[627,719,720],{"class":641},"=",[627,722,723],{"class":641}," $",[627,725,726],{"class":637},"user",[627,728,729],{"class":641},"->",[627,731,733],{"class":732},"s2Zo4","subscribe",[627,735,736],{"class":641},"()\n",[627,738,739,742,745,748,751,755,757],{"class":629,"line":661},[627,740,741],{"class":641},"    ->",[627,743,744],{"class":732},"toPlan",[627,746,747],{"class":641},"(",[627,749,750],{"class":641},"'",[627,752,754],{"class":753},"sfazB","subscription_plan_7Hd9Kf2Lm",[627,756,750],{"class":641},[627,758,759],{"class":641},")\n",[627,761,762,764,767,769,772],{"class":629,"line":678},[627,763,741],{"class":641},[627,765,766],{"class":732},"withTrialDays",[627,768,747],{"class":641},[627,770,771],{"class":633},"14",[627,773,759],{"class":641},[627,775,776,778,781],{"class":629,"line":684},[627,777,741],{"class":641},[627,779,780],{"class":732},"create",[627,782,783],{"class":641},"();\n",[627,785,786],{"class":629,"line":695},[627,787,658],{"emptyLinePlaceholder":657},[627,789,791,795,798,801,804,806,809,811,814,816,819],{"class":629,"line":790},7,[627,792,794],{"class":793},"s7zQu","return",[627,796,797],{"class":732}," redirect",[627,799,800],{"class":641},"($",[627,802,803],{"class":