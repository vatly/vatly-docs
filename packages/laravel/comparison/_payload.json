,"seo":1467,"stem":184,"__hash__":1468},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":283,"value":284,"toc":1456},"minimark",[285,316,342,352,355,360,664,667,696,698,702,708,790,1220,1229,1231,1235,1238,1349,1352,1354,1358,1365,1386,1394,1396,1400,1438,1452],[286,287,288,289,293,294,297,298,301,302,306,307,311,312,315],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[290,291,292],"code",{},"Billable"," trait, ",[290,295,296],{},"subscribed()",",\n",[290,299,300],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[303,304,305],"em",{},"behind","\nthe API: Vatly is a ",[308,309,310],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[308,313,314],{},"Europe-first",", operating under EU\njurisdiction.",[286,317,318,319,322,323,297,330,335,336,341],{},"This page is an honest, side-by-side look at how ",[290,320,321],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[324,325,329],"a",{"href":326,"rel":327},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[328],"nofollow","Laravel Cashier (Stripe)",[324,331,334],{"href":332,"rel":333},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[328],"Laravel Cashier (Paddle)",", and\n",[324,337,340],{"href":338,"rel":339},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[328],"Lemon Squeezy for Laravel"," — gaps included.",[343,344,345,348,349,351],"note",{},[308,346,347],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[324,350,186],{"href":187}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[353,354],"hr",{},[356,357,359],"h2",{"id":358},"at-a-glance","At a glance",[361,362,363,386],"table",{},[364,365,366],"thead",{},[367,368,369,372,375,378,381],"tr",{},[370,371],"th",{},[370,373,374],{},"Cashier (Stripe Billing)",[370,376,377],{},"Cashier (Paddle)",[370,379,380],{},"Lemon Squeezy",[370,382,383],{},[308,384,385],{},"Vatly",[387,388,389,415,440,460,489,512,549,573,598,615,631,649],"tbody",{},[367,390,391,395,400,405,410],{},[392,393,394],"td",{},"Composer package",[392,396,397],{},[290,398,399],{},"laravel\u002Fcashier",[392,401,402],{},[290,403,404],{},"laravel\u002Fcashier-paddle",[392,406,407],{},[290,408,409],{},"lemonsqueezy\u002Flaravel",[392,411,412],{},[290,413,414],{},"vatly\u002Fvatly-laravel",[367,416,417,420,425,430,435],{},[392,418,419],{},"Billable trait",[392,421,422],{},[290,423,424],{},"Laravel\\Cashier\\Billable",[392,426,427],{},[290,428,429],{},"Laravel\\Paddle\\Billable",[392,431,432],{},[290,433,434],{},"LemonSqueezy\\Laravel\\Billable",[392,436,437],{},[290,438,439],{},"Vatly\\Laravel\\Billable",[367,441,442,444,450,453,455],{},[392,443,310],{},[392,445,446,449],{},[308,447,448],{},"No"," — you are the seller",[392,451,452],{},"Yes",[392,454,452],{},[392,456,457],{},[308,458,459],{},"Yes (full)",[367,461,462,465,471,477,484],{},[392,463,464],{},"Entity \u002F jurisdiction",[392,466,467,470],{},[303,468,469],{},"You"," (wherever you're registered)",[392,472,473,474],{},"Paddle, ",[308,475,476],{},"UK",[392,478,479,480,483],{},"Lemon Squeezy, ",[308,481,482],{},"US"," (Stripe-owned)",[392,485,486],{},[308,487,488],{},"EEA \u002F EU jurisdiction",[367,490,491,494,503,506,508],{},[392,492,493],{},"Who remits VAT\u002Fsales tax",[392,495,496,498,499,502],{},[308,497,469],{}," (Stripe Tax only ",[303,500,501],{},"calculates",")",[392,504,505],{},"Provider",[392,507,505],{},[392,509,510],{},[308,511,505],{},[367,513,514,517,524,533,539],{},[392,515,516],{},"Customer stored as",[392,518,519,520,523],{},"columns on the billable model (",[290,521,522],{},"stripe_id",", …)",[392,525,526,529,530,502],{},[290,527,528],{},"customers"," table (",[290,531,532],{},"paddle_id",[392,534,535,538],{},[290,536,537],{},"lemon_squeezy_customers"," table",[392,540,541,544,545,548],{},[290,542,543],{},"vatly_id"," column on the billable model + ",[290,546,547],{},"vatly_*"," tables",[367,550,551,554,557,564,567],{},[392,552,553],{},"Checkout",[392,555,556],{},"Stripe Checkout (hosted) \u002F Elements",[392,558,559,560,563],{},"Paddle.js ",[308,561,562],{},"overlay \u002F inline"," (client-side JS)",[392,565,566],{},"Lemon.js overlay \u002F hosted URL",[392,568,569,572],{},[308,570,571],{},"Vatly-hosted redirect"," (+ guest claim)",[367,574,575,578,583,588,593],{},[392,576,577],{},"Webhook route",[392,579,580],{},[290,581,582],{},"\u002Fstripe\u002Fwebhook",[392,584,585],{},[290,586,587],{},"\u002Fpaddle\u002Fwebhook",[392,589,590],{},[290,591,592],{},"\u002Flemon-squeezy\u002Fwebhook",[392,594,595],{},[290,596,597],{},"\u002Fwebhooks\u002Fvatly",[367,599,600,603,605,607,609],{},[392,601,602],{},"Coupons \u002F promo codes",[392,604,452],{},[392,606,452],{},[392,608,452],{},[392,610,611,614],{},[308,612,613],{},"On the roadmap"," (workaround below)",[367,616,617,620,622,624,626],{},[392,618,619],{},"License keys",[392,621,448],{},[392,623,448],{},[392,625,452],{},[392,627,628,630],{},[308,629,613],{}," (rarely needed for SaaS)",[367,632,633,636,639,642,644],{},[392,634,635],{},"Refunds & chargebacks",[392,637,638],{},"wire it yourself",[392,640,641],{},"events",[392,643,641],{},[392,645,646],{},[308,647,648],{},"first-class models + events",[367,650,651,654,656,658,660],{},[392,652,653],{},"Trials, swap, grace\u002Fresume",[392,655,452],{},[392,657,452],{},[392,659,452],{},[392,661,662],{},[308,663,452],{},[286,665,666],{},"Two takeaways:",[668,669,670,690],"ol",{},[671,672,673,683,684,689],"li",{},[308,674,675,676,678,679,682],{},"With ",[290,677,399],{},", ",[303,680,681],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[324,685,688],{"href":686,"rel":687},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[328],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[671,691,692,695],{},[308,693,694],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[353,697],{},[356,699,701],{"id":700},"the-developer-experience","The developer experience",[286,703,704,705,707],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[290,706,292],{}," trait, and\nthe code reads like Cashier:",[709,710,715],"pre",{"className":711,"code":712,"language":713,"meta":714,"style":714},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php","",[290,716,717,743,750,767,773,784],{"__ignoreMap":714},[718,719,722,726,730,734,736,738,740],"span",{"class":720,"line":721},"line",1,[718,723,725],{"class":724},"sbssI","use",[718,727,729],{"class":728},"sTEyZ"," Vatly",[718,731,733],{"class":732},"sMK4o","\\",[718,735,159],{"class":728},[718,737,733],{"class":732},[718,739,292],{"class":728},[718,741,742],{"class":732},";\n",[718,744,746],{"class":720,"line":745},2,[718,747,749],{"emptyLinePlaceholder":748},true,"\n",[718,751,753,757,761,764],{"class":720,"line":752},3,[718,754,756],{"class":755},"spNyl","class",[718,758,760],{"class":759},"sBMFI"," User",[718,762,763],{"class":755}," extends",[718,765,766],{"class":759}," Authenticatable\n",[718,768,770],{"class":720,"line":769},4,[718,771,772],{"class":732},"{\n",[718,774,776,779,782],{"class":720,"line":775},5,[718,777,778],{"class":724},"    use",[718,780,781],{"class":728}," Billable",[718,783,742],{"class":732},[718,785,787],{"class":720,"line":786},6,[718,788,789],{"class":732},"}\n",[709,791,793],{"className":711,"code":792,"language":713,"meta":714,"style":714},"\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n$checkout = $user->subscribe()\n    ->toPlan('subscription_plan_7Hd9Kf2Lm')\n    ->withTrialDays(14)\n    ->create();\n\nreturn redirect($checkout->links->checkoutUrl->href);\n\n\u002F\u002F Gate features on subscription state\nif ($user->subscribed()) {\n    \u002F\u002F …\n}\n\n$user->subscription()->swap('subscription_plan_other');\n$user->subscription()->cancel();      \u002F\u002F Vatly decides immediate vs. grace\n$user->subscription()->resume();      \u002F\u002F while on the grace period\n\n\u002F\u002F One-off purchase\n$user->checkout()->create(\n    items: [['id' => 'one_off_product_3Qb8Wz1Yt', 'quantity' => 1]],\n    redirectUrlSuccess: route('billing.success'),\n    redirectUrlCanceled: route('billing'),\n);\n\n\u002F\u002F Receipts — hosted invoice URLs, no PDF plumbing\nforeach ($user->orders as $order) {\n    echo $order->invoiceUrl();\n}\n",[290,794,795,801,828,851,865,875,879,913,918,924,946,952,957,962,991,1013,1034,1039,1045,1063,1111,1134,1155,1160,1165,1171,1198,1215],{"__ignoreMap":714},[718,796,797],{"class":720,"line":721},[718,798,800],{"class":799},"sHwdD","\u002F\u002F Start a subscription — redirect to Vatly's hosted checkout\n",[718,802,803,806,809,812,815,818,821,825],{"class":720,"line":745},[718,804,805],{"class":732},"$",[718,807,808],{"class":728},"checkout ",[718,810,811],{"class":732},"=",[718,813,814],{"class":732}," $",[718,816,817],{"class":728},"user",[718,819,820],{"class":732},"->",[718,822,824],{"class":823},"s2Zo4","subscribe",[718,826,827],{"class":732},"()\n",[718,829,830,833,836,839,842,846,848],{"class":720,"line":752},[718,831,832],{"class":732},"    ->",[718,834,835],{"class":823},"toPlan",[718,837,83