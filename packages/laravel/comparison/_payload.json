;--shiki-dark-font-style:italic}",{"title":896,"searchDepth":927,"depth":927,"links":1638},[1639,1640,1641,1642,1643],{"id":541,"depth":927,"text":542},{"id":882,"depth":927,"text":883},{"id":1415,"depth":927,"text":1416},{"id":1538,"depth":927,"text":1539},{"id":1580,"depth":927,"text":1581},"Picking the billing layer for a new Laravel app?","md",null,{},{"title":237},{"title":464,"description":1644},"EPTmnvy0ysnci0_cwoxShY4EnKX64jiK_l9mmy4meCE",[1652,1654],{"title":50,"path":234,"stem":235,"description":1653,"children":-1},"Vatly sends webhooks to notify your application of events like subscription starts, cancellations, and payment updates.",{"title":241,"path":242,"stem":243,"description":1655,"children":-1},"You don't swap a Merchant of Record overnight.",1794496560473]