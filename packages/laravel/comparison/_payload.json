grating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":187,"path":188,"stem":189},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":191,"path":192,"stem":193},"Integrations","\u002Fintegrations","4.integrations",{"id":195,"title":179,"body":196,"description":1376,"extension":1377,"links":1378,"meta":1379,"navigation":661,"path":180,"seo":1380,"stem":181,"__hash__":1381},"docs\u002F3.packages\u002F2.laravel\u002F6.comparison.md",{"type":197,"value":198,"toc":1369},"minimark",[199,230,256,266,269,274,578,581,610,612,616,622,703,1133,1142,1144,1148,1151,1262,1265,1267,1271,1278,1299,1307,1309,1313,1351,1365],[200,201,202,203,207,208,211,212,215,216,220,221,225,226,229],"p",{},"Picking the billing layer for a new Laravel app? If you've reached for Laravel Cashier\nbefore, Vatly will feel immediately familiar — a ",[204,205,206],"code",{},"Billable"," trait, ",[204,209,210],{},"subscribed()",",\n",[204,213,214],{},"subscription()->swap()",", a wired-up webhook endpoint. The difference is what sits ",[217,218,219],"em",{},"behind","\nthe API: Vatly is a ",[222,223,224],"strong",{},"Merchant of Record",", so it is the legal seller and handles VAT,\ninvoicing, and payment compliance for you — and it's ",[222,227,228],{},"Europe-first",", operating under EU\njurisdiction.",[200,231,232,233,236,237,211,244,249,250,255],{},"This page is an honest, side-by-side look at how ",[204,234,235],{},"vatly-laravel"," stacks up against the\nCashier-style packages you might otherwise reach for —\n",[238,239,243],"a",{"href":240,"rel":241},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fbilling",[242],"nofollow","Laravel Cashier (Stripe)",[238,245,248],{"href":246,"rel":247},"https:\u002F\u002Flaravel.com\u002Fdocs\u002F12.x\u002Fcashier-paddle",[242],"Laravel Cashier (Paddle)",", and\n",[238,251,254],{"href":252,"rel":253},"https:\u002F\u002Fgithub.com\u002Flmsqueezy\u002Flaravel",[242],"Lemon Squeezy for Laravel"," — gaps included.",[257,258,259,262,263,265],"note",{},[222,260,261],{},"Already running one of these in an existing app?"," This page helps you choose. Once you\nhave, ",[238,264,183],{"href":184}," shows how to add Vatly\nnext to your current biller and migrate customers over gradually.",[267,268],"hr",{},[270,271,273],"h2",{"id":272},"at-a-glance","At a glance",[275,276,277,300],"table",{},[278,279,280],"thead",{},[281,282,283,286,289,292,295],"tr",{},[284,285],"th",{},[284,287,288],{},"Cashier (Stripe Billing)",[284,290,291],{},"Cashier (Paddle)",[284,293,294],{},"Lemon Squeezy",[284,296,297],{},[222,298,299],{},"Vatly",[301,302,303,329,354,374,403,426,463,487,512,529,545,563],"tbody",{},[281,304,305,309,314,319,324],{},[306,307,308],"td",{},"Composer package",[306,310,311],{},[204,312,313],{},"laravel\u002Fcashier",[306,315,316],{},[204,317,318],{},"laravel\u002Fcashier-paddle",[306,320,321],{},[204,322,323],{},"lemonsqueezy\u002Flaravel",[306,325,326],{},[204,327,328],{},"vatly\u002Fvatly-laravel",[281,330,331,334,339,344,349],{},[306,332,333],{},"Billable trait",[306,335,336],{},[204,337,338],{},"Laravel\\Cashier\\Billable",[306,340,341],{},[204,342,343],{},"Laravel\\Paddle\\Billable",[306,345,346],{},[204,347,348],{},"LemonSqueezy\\Laravel\\Billable",[306,350,351],{},[204,352,353],{},"Vatly\\Laravel\\Billable",[281,355,356,358,364,367,369],{},[306,357,224],{},[306,359,360,363],{},[222,361,362],{},"No"," — you are the seller",[306,365,366],{},"Yes",[306,368,366],{},[306,370,371],{},[222,372,373],{},"Yes (full)",[281,375,376,379,385,391,398],{},[306,377,378],{},"Entity \u002F jurisdiction",[306,380,381,384],{},[217,382,383],{},"You"," (wherever you're registered)",[306,386,387,388],{},"Paddle, ",[222,389,390],{},"UK",[306,392,393,394,397],{},"Lemon Squeezy, ",[222,395,396],{},"US"," (Stripe-owned)",[306,399,400],{},[222,401,402],{},"EEA \u002F EU jurisdiction",[281,404,405,408,417,420,422],{},[306,406,407],{},"Who remits VAT\u002Fsales tax",[306,409,410,412,413,416],{},[222,411,383],{}," (Stripe Tax only ",[217,414,415],{},"calculates",")",[306,418,419],{},"Provider",[306,421,419],{},[306,423,424],{},[222,425,419],{},[281,427,428,431,438,447,453],{},[306,429,430],{},"Customer stored as",[306,432,433,434,437],{},"columns on the billable model (",[204,435,436],{},"stripe_id",", …)",[306,439,440,443,444,416],{},[204,441,442],{},"customers"," table (",[204,445,446],{},"paddle_id",[306,448,449,452],{},[204,450,451],{},"lemon_squeezy_customers"," table",[306,454,455,458,459,462],{},[204,456,457],{},"vatly_id"," column on the billable model + ",[204,460,461],{},"vatly_*"," tables",[281,464,465,468,471,478,481],{},[306,466,467],{},"Checkout",[306,469,470],{},"Stripe Checkout (hosted) \u002F Elements",[306,472,473,474,477],{},"Paddle.js ",[222,475,476],{},"overlay \u002F inline"," (client-side JS)",[306,479,480],{},"Lemon.js overlay \u002F hosted URL",[306,482,483,486],{},[222,484,485],{},"Vatly-hosted redirect"," (+ guest claim)",[281,488,489,492,497,502,507],{},[306,490,491],{},"Webhook route",[306,493,494],{},[204,495,496],{},"\u002Fstripe\u002Fwebhook",[306,498,499],{},[204,500,501],{},"\u002Fpaddle\u002Fwebhook",[306,503,504],{},[204,505,506],{},"\u002Flemon-squeezy\u002Fwebhook",[306,508,509],{},[204,510,511],{},"\u002Fwebhooks\u002Fvatly",[281,513,514,517,519,521,523],{},[306,515,516],{},"Coupons \u002F promo codes",[306,518,366],{},[306,520,366],{},[306,522,366],{},[306,524,525,528],{},[222,526,527],{},"On the roadmap"," (workaround below)",[281,530,531,534,536,538,540],{},[306,532,533],{},"License keys",[306,535,362],{},[306,537,362],{},[306,539,366],{},[306,541,542,544],{},[222,543,527],{}," (rarely needed for SaaS)",[281,546,547,550,553,556,558],{},[306,548,549],{},"Refunds & chargebacks",[306,551,552],{},"wire it yourself",[306,554,555],{},"events",[306,557,555],{},[306,559,560],{},[222,561,562],{},"first-class models + events",[281,564,565,568,570,572,574],{},[306,566,567],{},"Trials, swap, grace\u002Fresume",[306,569,366],{},[306,571,366],{},[306,573,366],{},[306,575,576],{},[222,577,366],{},[200,579,580],{},"Two takeaways:",[582,583,584,604],"ol",{},[585,586,587,597,598,603],"li",{},[222,588,589,590,592,593,596],{},"With ",[204,591,313],{},", ",[217,594,595],{},"you're"," the seller of record."," It runs on classic Stripe Billing, so\nyou register for VAT, file, and remit in every market you sell into — the compliance and the\nliability sit with your company. (Stripe's own Merchant-of-Record product,\n",[238,599,602],{"href":600,"rel":601},"https:\u002F\u002Fstripe.com\u002Fmanaged-payments",[242],"Managed Payments",", is a separate, US-based service you'd\nintegrate instead — not the Cashier subscriptions you're building on.)",[585,605,606,609],{},[222,607,608],{},"So the real difference between MoRs is jurisdiction."," Paddle is UK, Lemon Squeezy and Stripe\nare US, Vatly is EEA — your seller-of-record entity and customer data stay under EU law. That,\nnot the API, is the reason to choose one over another.",[267,611],{},[270,613,615],{"id":614},"the-developer-experience","The developer experience",[200,617,618,619,621],{},"For a greenfield app, Vatly is your only biller — so you use the plain ",[204,620,206],{}," trait, and\nthe code reads like Cashier:",[623,624,628],"pre",{"className":625,"code":626,"language":627,"meta":113,"style":113},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Laravel\\Billable;\n\nclass User extends Authenticatable\n{\n    use Billable;\n}\n","php",[204,629,630,656,663,680,686,697],{"__ignoreMap":113},[631,632,635,639,643,647,649,651,653],"span",{"class":633,"line":634},"line",1,[631,636,638],{"class":637},"sbssI","use",[631,640,642],{"class":641},"sTEyZ"," Vatly",[631,644,646],{"class":645},"sMK4o","\\",[631,648,156],{"class":641},[631,650,646],{"class":645},[631,652,206],{"class":641},[631,654,655],{"class":645},";\n",[631,657,659],{"class":633,"line