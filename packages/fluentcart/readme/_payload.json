76,"path":477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":170,"body":492,"description":963,"extension":964,"links":965,"meta":966,"navigation":967,"path":175,"seo":968,"stem":176,"__hash__":969},"docs\u002F3.packages\u002F10.fluentcart\u002F00.readme.md",{"type":493,"value":494,"toc":953},"minimark",[495,499,507,512,546,550,576,579,598,610,621,625,718,722,728,768,779,785,788,791,811,822,825,829,832,870,873,876,941,949],[496,497,498],"p",{},"Accept payments through Vatly in FluentCart, the WordPress e-commerce plugin.\nVatly is the European Merchant of Record for AI, software and digital products.\nThis plugin registers Vatly as a FluentCart payment gateway and builds on PHP Fluent and the PHP SDK.",[500,501,502,506],"warning",{},[503,504,505],"strong",{},"Alpha."," The plugin works end to end with Vatly test mode on FluentCart 2.3, but it\ncan still change in ways that need you to update your setup. Try it in Vatly test mode\nbefore you take live payments with it.",[508,509,511],"h2",{"id":510},"what-it-does","What it does",[513,514,515,522,528,534,540],"ul",{},[516,517,518,521],"li",{},[503,519,520],{},"Merchant-of-Record checkout"," for one-off products and subscriptions, including free trials carried over from FluentCart.",[516,523,524,527],{},[503,525,526],{},"Official Vatly invoices"," on the FluentCart receipt and as shortcodes. FluentCart's own competing receipt email is suppressed for Vatly orders, so customers never receive two invoices for one purchase.",[516,529,530,533],{},[503,531,532],{},"Refunds routed through Vatly",", so Vatly issues the credit note and its VAT, and the result is recorded on the FluentCart order.",[516,535,536,539],{},[503,537,538],{},"FluentCart's own events"," for every payment and subscription change, including renewals, failed payments, refunds, cancellations and chargebacks, so other plugins that listen to FluentCart keep working.",[516,541,542,545],{},[503,543,544],{},"Per-record test and live mode",", frozen at checkout, so refunds always use the API key that matches the original order.",[508,547,549],{"id":548},"requirements","Requirements",[513,551,552,555,558,567],{},[516,553,554],{},"WordPress 6.2 or newer",[516,556,557],{},"PHP 8.1 or newer",[516,559,560,566],{},[561,562,170],"a",{"href":563,"rel":564},"https:\u002F\u002Ffluentcart.com",[565],"nofollow"," 2.3 or newer, installed and active",[516,568,569,570,575],{},"A ",[561,571,574],{"href":572,"rel":573},"https:\u002F\u002Fvatly.com",[565],"Vatly"," account with test-mode API credentials",[508,577,442],{"id":578},"installation",[580,581,582,591],"ol",{},[516,583,584,585,590],{},"Download the zip from the ",[561,586,589],{"href":587,"rel":588},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp\u002Freleases\u002Flatest",[565],"latest alpha release",". It includes the plugin's dependencies, so you don't need Composer.",[516,592,593,594,597],{},"In WordPress, go to ",[503,595,596],{},"Plugins → Add New → Upload Plugin",", choose the zip, and activate it.",[496,599,600,601,605,606,609],{},"To build the zip yourself, run ",[602,603,604],"code",{},"bin\u002Fbuild-release.sh"," in a clone of the repository. It produces ",[602,607,608],{},"build\u002Fvatly-for-fluentcart.zip"," with a namespace-scoped copy of the dependencies, and needs PHP, Composer, curl and zip.",[496,611,612,613,616,617,620],{},"For development, run ",[602,614,615],{},"composer install"," in the clone instead, then place or symlink the directory in ",[602,618,619],{},"wp-content\u002Fplugins\u002F",".",[508,622,624],{"id":623},"setup","Setup",[580,626,627,653,680],{},[516,628,629,632,633,636,637,640,641,644,645,648,649,652],{},[503,630,631],{},"Add your API credentials."," Go to ",[503,634,635],{},"FluentCart → Settings → Payment Methods → Vatly",", choose ",[503,638,639],{},"Test"," mode, and paste the test ",[503,642,643],{},"API key"," and ",[503,646,647],{},"Webhook secret"," from the ",[503,650,651],{},"Developers"," section of your Vatly dashboard.",[516,654,655,658,659,661,662,672,675,676,679],{},[503,656,657],{},"Register the webhook in Vatly."," Under ",[503,660,651],{}," in the Vatly dashboard, add a webhook endpoint pointing at:",[663,664,670],"pre",{"className":665,"code":667,"language":668,"meta":669},[666],"language-text","https:\u002F\u002Fyour-site.com\u002Fwp-admin\u002Fadmin-ajax.php?action=fluent_cart_vatly_webhook\n","text","",[602,671,667],{"__ignoreMap":669},[673,674],"br",{},"Use the webhook secret you entered above. Vatly's ",[602,677,678],{},"order.paid"," webhook stamps the official invoice onto each order.",[516,681,682,685,686,689,690,693,694,715,717],{},[503,683,684],{},"Map your products to Vatly."," Edit a FluentCart product and fill in the ",[503,687,688],{},"Vatly mapping"," box with the IDs from ",[503,691,692],{},"Manage Products"," in your Vatly dashboard:",[513,695,696,706],{},[516,697,698,701,702,705],{},[503,699,700],{},"Vatly product ID",": the ",[602,703,704],{},"one_off_product_…"," ID, for one-time products.",[516,707,708,701,711,714],{},[503,709,710],{},"Vatly plan ID",[602,712,713],{},"subscription_plan_…"," ID, for subscription products.",[673,716],{},"A checkout fails with a clear error when the product it sells has no matching Vatly ID.",[508,719,721],{"id":720},"invoices","Invoices",[496,723,724,725,727],{},"Vatly issues the legally valid VAT invoice and, for refunds, the credit note. When a Vatly ",[602,726,678],{}," webhook arrives, the plugin stores the Vatly invoice URL on the FluentCart order and the credit-note URL on refunds. Show the invoice anywhere FluentCart accepts shortcodes:",[729,730,731,744],"table",{},[732,733,734],"thead",{},[735,736,737,741],"tr",{},[738,739,740],"th",{},"Shortcode",[738,742,743],{},"Output",[745,746,747,758],"tbody",{},[735,748,749,755],{},[750,751,752],"td",{},[602,753,754],{},"[vatly_invoice_link]",[750,756,757],{},"A plain \"Download official Vatly invoice\" link.",[735,759,760,765],{},[750,761,762],{},[602,763,764],{},"[vatly_invoice_button]",[750,766,767],{},"The same link, styled as a button.",[496,769,770,771,774,775,778],{},"Both accept an optional ",[602,772,773],{},"order_id",", for example ",[602,776,777],{},"[vatly_invoice_link order_id=\"123\"]","; otherwise they use FluentCart's current order. They render nothing for orders without a Vatly invoice, so they are safe in templates shared with other gateways. The invoice button also appears automatically on the FluentCart receipt page.",[496,780,781,782,620],{},"For the FluentCart hooks the invoicing relies on, see ",[561,783,784],{"href":179},"Merchant-of-Record invoicing",[508,786,108],{"id":787},"refunds",[496,789,790],{},"Refunds issued from the FluentCart admin go through Vatly, then are recorded on the FluentCart transaction.",[513,792,793,799,805],{},[516,794,795,798],{},[503,796,797],{},"Full refunds"," are supported.",[516,800,801,804],{},[503,802,803],{},"Partial refunds on single-item orders"," are refunded against the order's line.",[516,806,807,810],{},[503,808,809],{},"Partial refunds on multi-item orders"," are not supported from FluentCart. Issue a full refund, or refund a specific line from the Vatly dashboard.",[496,812,813,814,817,818,821],{},"Vatly refunds are asynchronous: the FluentCart refund starts with Vatly's initial status, usually ",[602,815,816],{},"pending",", and moves to ",[602,819,820],{},"refunded"," once Vatly confirms it.",[496,823,824],{},"Each FluentCart transaction keeps the mode (test or live) it had at checkout. Refunds use the API key for that record's mode, not the gateway's current setting.",[508,826,828],{"id":827},"data-the-plugin-stores","Data the plugin stores",[496,830,831],{},"For your records of processing and for access and deletion requests:",[513,833,834,840,850],{},[516,835,836,839],{},[503,837,838],{},"Settings:"," your Vatly API keys and webhook secrets, encrypted, in FluentCart's settings.",[516,841,842,845,846,849],{},[503,843,844],{},"Customer links:"," the table ",[602,847,848],{},"{prefix}vatly_customer_bindings"," maps each Vatly customer ID to its FluentCart customer ID. It holds no names or contact details.",[516,851,852,845,855,858,859,862,863,866,867,620],{},[503,853,854],{},"Webhook log:",[602,856,857],{},"{prefix}vatly_webhook_calls"," keeps each webhook Vatly sends, for debugging. Personal fields (customer name, email, address, tax ID, payment method details) are redacted before it is stored, so they read ",[602,860,861],{},"[redacted]","; the event's IDs, statuses, amounts, tax and order lines are kept. Entries are deleted after 30 days. Change that with the ",[602,864,865],{},"vatly_fluentcart_webhook_log_retention_days"," filter, for example ",[602,868,869],{},"add_filter('vatly_fluentcart_webhook_log_retention_days', fn () => 7);",[496,871,872],{},"Orders, subscriptions and transactions are FluentCart's own records. Deleting the plugin removes both tables, its settings and its scheduled jobs, and leaves those records in place.",[508,874,388],{"id":875},"development",[663,877,881],{"className":878,"code":879,"language":880,"meta":669,"style":669},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","composer install\ncomposer test:unit          # PHPUnit unit suite\ncomposer test:integration   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\ncomposer analyse            # PHPStan\ncomposer phpcs              # WordPress coding standards\n","bash",[602,882,883,896,908,919,930],{"__ignoreMap":669},[884,885,888,892],"span",{"class":886,"line":887},"line",1,[884,889,891],{"class":890},"sBMFI","composer",[884,893,895],{"class":894},"sfazB"," install\n",[884,897,899,901,904],{"class":886,"line":898},2,[884,900,891],{"class":890},[884,902,903],{"class":894}," test:unit",[884,905,907],{"class":906},"sHwdD","          # PHPUnit unit suite\n",[884,909,911,913,916],{"class":886,"line":910},3,[884,912,891],{"class":890},[884,914,915],{"class":894}," test:integration",[884,917,918],{"class":906},"   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\n",[884,920,922,924,927],{"class":886,"line":921},4,[884,923,891],{"class":890},[884,925,926],{"class":894}," analyse",[884,928,929],{"class":906},"            # PHPStan\n",[884,931,933,935,938],{"class":886,"line":932},5,[884,934,891],{"class":890},[884,936,937],{"class":894}," phpcs",[884,939,940],{"class":906},"              # WordPress coding standards\n",[496,942,943,944,620],{},"The source and issue tracker are on ",[561,945,948],{"href":946,"rel":947},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp",[565],"GitHub",[950,951,952],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":669,"searchDepth":898,"depth":898,"links":954},[955,956,957,958,959,960,961,962],{"id":510,"depth":898,"text":511},{"id":548,"depth":898,"text":549},{"id":578,"depth":898,"text":442},{"id":623,"depth":898,"text":624},{"id":720,"depth":898,"text":721},{"id":787,"depth":898,"text":108},{"id":827,"depth":898,"text":828},{"id":875,"depth":898,"text":388},"Accept payments through Vatly in FluentCart, the WordPress e-commerce plugin.","md",null,{},{"title":133},{"title":170,"description":963},"LMarBs34DOQsWWqhRVkp7ZwuYp2uUq2TwMXRpcy8DZ4",[971,973],{"title":166,"path":167,"stem":168,"description":972,"children":-1},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered from code (or infrastructure-as-code) rather than the dashboard.",{"title":178,"path":179,"stem":180,"description":974,"children":-1},"How the plugin makes Vatly the single source of truth for invoices on FluentCart orders, and the FluentCart integration points it relies on.",1795622417497]