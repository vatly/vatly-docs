ldren":425,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[426,429,433,436,440,444,447,450,453,457,460],{"title":129,"path":427,"stem":428},"\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F00.readme",{"title":430,"path":431,"stem":432},"Installation","\u002Fpackages\u002Fdjango\u002Finstallation","3.packages\u002F8.django\u002F01.installation",{"title":186,"path":434,"stem":435},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F02.configuration",{"title":437,"path":438,"stem":439},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":441,"path":442,"stem":443},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":445,"stem":446},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":206,"path":448,"stem":449},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":451,"stem":452},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":454,"path":455,"stem":456},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":458,"stem":459},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":376,"path":461,"stem":462},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":464,"path":465,"stem":466,"children":467},"Integrations","\u002Fintegrations","4.integrations",[468,470,474],{"title":464,"path":465,"stem":469},"4.integrations\u002Findex",{"title":471,"path":472,"stem":473},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":475,"path":476,"stem":477},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":479,"title":166,"body":480,"description":911,"extension":912,"links":913,"meta":914,"navigation":915,"path":171,"seo":916,"stem":172,"__hash__":917},"docs\u002F3.packages\u002F10.fluentcart\u002F00.readme.md",{"type":481,"value":482,"toc":902},"minimark",[483,487,495,500,528,532,558,561,564,606,617,628,632,724,728,734,774,785,791,794,797,817,828,831,834,890,898],[484,485,486],"p",{},"Accept payments through Vatly in FluentCart, the WordPress e-commerce plugin.\nVatly is the European Merchant of Record for AI, software and digital products.\nThis plugin registers Vatly as a FluentCart payment gateway and builds on PHP Fluent and the PHP SDK.",[488,489,490,494],"warning",{},[491,492,493],"strong",{},"Unreleased."," No release of this plugin has been published yet, and its payment\nconfirmation flow has not been verified against current FluentCart versions.\nUse it only in Vatly test mode, and do not take live payments with it yet.\nExpect breaking changes before the first alpha release.",[496,497,499],"h2",{"id":498},"what-it-does","What it does",[501,502,503,510,516,522],"ul",{},[504,505,506,509],"li",{},[491,507,508],{},"Merchant-of-Record checkout"," for one-off products and subscriptions, including free trials carried over from FluentCart.",[504,511,512,515],{},[491,513,514],{},"Official Vatly invoices"," on the FluentCart receipt and as shortcodes. FluentCart's own competing receipt email is suppressed for Vatly orders, so customers never receive two invoices for one purchase.",[504,517,518,521],{},[491,519,520],{},"Refunds routed through Vatly",", so Vatly issues the credit note and its VAT, and the result is recorded on the FluentCart order.",[504,523,524,527],{},[491,525,526],{},"Per-record test and live mode",", frozen at checkout, so refunds always use the API key that matches the original order.",[496,529,531],{"id":530},"requirements","Requirements",[501,533,534,537,540,549],{},[504,535,536],{},"WordPress 6.2 or newer",[504,538,539],{},"PHP 8.1 or newer",[504,541,542,548],{},[543,544,166],"a",{"href":545,"rel":546},"https:\u002F\u002Ffluentcart.com",[547],"nofollow"," installed and active",[504,550,551,552,557],{},"A ",[543,553,556],{"href":554,"rel":555},"https:\u002F\u002Fvatly.com",[547],"Vatly"," account with test-mode API credentials",[496,559,430],{"id":560},"installation",[484,562,563],{},"There is no release zip yet. Build the plugin from source:",[565,566,571],"pre",{"className":567,"code":568,"language":569,"meta":570,"style":570},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","git clone https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp.git\ncd vatly-fluentcart-wp\nbin\u002Fbuild-release.sh\n","bash","",[572,573,574,590,600],"code",{"__ignoreMap":570},[575,576,579,583,587],"span",{"class":577,"line":578},"line",1,[575,580,582],{"class":581},"sBMFI","git",[575,584,586],{"class":585},"sfazB"," clone",[575,588,589],{"class":585}," https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp.git\n",[575,591,593,597],{"class":577,"line":592},2,[575,594,596],{"class":595},"s2Zo4","cd",[575,598,599],{"class":585}," vatly-fluentcart-wp\n",[575,601,603],{"class":577,"line":602},3,[575,604,605],{"class":581},"bin\u002Fbuild-release.sh\n",[484,607,608,609,612,613,616],{},"The script produces ",[572,610,611],{},"build\u002Fvatly-for-fluentcart.zip"," with a namespace-scoped copy of its dependencies (it needs PHP, Composer, curl and zip).\nIn WordPress, go to ",[491,614,615],{},"Plugins → Add New → Upload Plugin",", choose the zip, and activate it.",[484,618,619,620,623,624,627],{},"For development, run ",[572,621,622],{},"composer install"," in the clone instead, then place or symlink the directory in ",[572,625,626],{},"wp-content\u002Fplugins\u002F",".",[496,629,631],{"id":630},"setup","Setup",[633,634,635,661,686],"ol",{},[504,636,637,640,641,644,645,648,649,652,653,656,657,660],{},[491,638,639],{},"Add your API credentials."," Go to ",[491,642,643],{},"FluentCart → Settings → Payment Methods → Vatly",", choose ",[491,646,647],{},"Test"," mode, and paste the test ",[491,650,651],{},"API key"," and ",[491,654,655],{},"Webhook secret"," from the ",[491,658,659],{},"Developers"," section of your Vatly dashboard.",[504,662,663,666,667,669,670,678,681,682,685],{},[491,664,665],{},"Register the webhook in Vatly."," Under ",[491,668,659],{}," in the Vatly dashboard, add a webhook endpoint pointing at:",[565,671,676],{"className":672,"code":674,"language":675,"meta":570},[673],"language-text","https:\u002F\u002Fyour-site.com\u002Fwp-admin\u002Fadmin-ajax.php?action=fluent_cart_vatly_webhook\n","text",[572,677,674],{"__ignoreMap":570},[679,680],"br",{},"Use the webhook secret you entered above. Vatly's ",[572,683,684],{},"order.paid"," webhook stamps the official invoice onto each order.",[504,687,688,691,692,695,696,699,700,721,723],{},[491,689,690],{},"Map your products to Vatly."," Edit a FluentCart product and fill in the ",[491,693,694],{},"Vatly mapping"," box with the IDs from ",[491,697,698],{},"Manage Products"," in your Vatly dashboard:",[501,701,702,712],{},[504,703,704,707,708,711],{},[491,705,706],{},"Vatly product ID",": the ",[572,709,710],{},"one_off_product_…"," ID, for one-time products.",[504,713,714,707,717,720],{},[491,715,716],{},"Vatly plan ID",[572,718,719],{},"subscription_plan_…"," ID, for subscription products.",[679,722],{},"A checkout fails with a clear error when the product it sells has no matching Vatly ID.",[496,725,727],{"id":726},"invoices","Invoices",[484,729,730,731,733],{},"Vatly issues the legally valid VAT invoice and, for refunds, the credit note. When a Vatly ",[572,732,684],{}," webhook arrives, the plugin stores the Vatly invoice URL on the FluentCart order and the credit-note URL on refunds. Show the invoice anywhere FluentCart accepts shortcodes:",[735,736,737,750],"table",{},[738,739,740],"thead",{},[741,742,743,747],"tr",{},[744,745,746],"th",{},"Shortcode",[744,748,749],{},"Output",[751,752,753,764],"tbody",{},[741,754,755,761],{},[756,757,758],"td",{},[572,759,760],{},"[vatly_invoice_link]",[756,762,763],{},"A plain \"Download official Vatly invoice\" link.",[741,765,766,771],{},[756,767,768],{},[572,769,770],{},"[vatly_invoice_button]",[756,772,773],{},"The same link, styled as a button.",[484,775,776,777,780,781,784],{},"Both accept an optional ",[572,778,779],{},"order_id",", for example ",[572,782,783],{},"[vatly_invoice_link order_id=\"123\"]","; otherwise they use FluentCart's current order. They render nothing for orders without a Vatly invoice, so they are safe in templates shared with other gateways. The invoice button also appears automatically on the FluentCart receipt page.",[484,786,787,788,627],{},"For the FluentCart hooks the invoicing relies on, see ",[543,789,790],{"href":175},"Merchant-of-Record invoicing",[496,792,104],{"id":793},"refunds",[484,795,796],{},"Refunds issued from the FluentCart admin go through Vatly, then are recorded on the FluentCart transaction.",[501,798,799,805,811],{},[504,800,801,804],{},[491,802,803],{},"Full refunds"," are supported.",[504,806,807,810],{},[491,808,809],{},"Partial refunds on single-item orders"," are refunded against the order's line.",[504,812,813,816],{},[491,814,815],{},"Partial refunds on multi-item orders"," are not supported from FluentCart. Issue a full refund, or refund a specific line from the Vatly dashboard.",[484,818,819,820,823,824,827],{},"Vatly refunds are asynchronous: the FluentCart refund starts with Vatly's initial status, usually ",[572,821,822],{},"pending",", and moves to ",[572,825,826],{},"refunded"," once Vatly confirms it.",[484,829,830],{},"Each FluentCart transaction keeps the mode (test or live) it had at checkout. Refunds use the API key for that record's mode, not the gateway's current setting.",[496,832,376],{"id":833},"development",[565,835,837],{"className":567,"code":836,"language":569,"meta":570,"style":570},"composer install\ncomposer test:unit          # PHPUnit unit suite\ncomposer test:integration   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\ncomposer analyse            # PHPStan\ncomposer phpcs              # WordPress coding standards\n",[572,838,839,847,858,868,879],{"__ignoreMap":570},[575,840,841,844],{"class":577,"line":578},[575,842,843],{"class":581},"composer",[575,845,846],{"class":585}," install\n",[575,848,849,851,854],{"class":577,"line":592},[575,850,843],{"class":581},[575,852,853],{"class":585}," test:unit",[575,855,857],{"class":856},"sHwdD","          # PHPUnit unit suite\n",[575,859,860,862,865],{"class":577,"line":602},[575,861,843],{"class":581},[575,863,864],{"class":585}," test:integration",[575,866,867],{"class":856},"   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\n",[575,869,871,873,876],{"class":577,"line":870},4,[575,872,843],{"class":581},[575,874,875],{"class":585}," analyse",[575,877,878],{"class":856},"            # PHPStan\n",[575,880,882,884,887],{"class":577,"line":881},5,[575,883,843],{"class":581},[575,885,886],{"class":585}," phpcs",[575,888,889],{"class":856},"              # WordPress coding standards\n",[484,891,892,893,627],{},"The source and issue tracker are on ",[543,894,897],{"href":895,"rel":896},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp",[547],"GitHub",[899,900,901],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decora