:476,"path":477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":170,"body":492,"description":1048,"extension":1049,"links":1050,"meta":1051,"navigation":1052,"path":175,"seo":1053,"stem":176,"__hash__":1054},"docs\u002F3.packages\u002F10.fluentcart\u002F00.readme.md",{"type":493,"value":494,"toc":1033},"minimark",[495,506,514,519,553,557,580,584,589,602,610,663,670,674,732,736,747,768,771,775,782,786,792,832,843,850,853,856,876,887,890,894,897,935,938,942,953,963,966,1021,1029],[496,497,498,499,505],"p",{},"Sell from your FluentCart store with Vatly as the Merchant of Record, so you don't have to handle VAT yourself.\nVatly is the European Merchant of Record for AI, software and digital products: it is the legal seller on every sale, charges the right VAT or sales tax for each customer's country, issues the invoice and credit notes, and carries the compliance burden.\nThis plugin adds Vatly as a payment gateway to ",[500,501,170],"a",{"href":502,"rel":503},"https:\u002F\u002Ffluentcart.com",[504],"nofollow",", the WordPress e-commerce plugin.",[507,508,509,513],"warning",{},[510,511,512],"strong",{},"Alpha."," The plugin works end to end with Vatly test mode on FluentCart 2.3, but it\ncan still change in ways that need you to update your setup. Try it in Vatly test mode\nbefore you take live payments with it.",[515,516,518],"h2",{"id":517},"what-you-get","What you get",[520,521,522,529,535,541,547],"ul",{},[523,524,525,528],"li",{},[510,526,527],{},"Checkout for one-off products and subscriptions",", including free trials carried over from FluentCart, so the first charge lands after the trial.",[523,530,531,534],{},[510,532,533],{},"One official invoice per purchase."," Vatly's invoice is shown on the FluentCart receipt and available as shortcodes. FluentCart's own competing receipt email is suppressed for Vatly orders, so customers never receive two invoices for one purchase.",[523,536,537,540],{},[510,538,539],{},"Refunds routed through Vatly",", so Vatly issues the credit note and its VAT, and the result is recorded on the FluentCart order.",[523,542,543,546],{},[510,544,545],{},"FluentCart keeps working as before."," The plugin fires FluentCart's own events for every payment and subscription change, including renewals, failed payments, refunds, cancellations and chargebacks, so other plugins that listen to FluentCart keep working.",[523,548,549,552],{},[510,550,551],{},"Test and live mode per record."," Each order keeps the mode it had at checkout, so a refund always uses the API key that matches the original order.",[515,554,556],{"id":555},"requirements","Requirements",[520,558,559,562,565,571],{},[523,560,561],{},"WordPress 6.2 or newer",[523,563,564],{},"PHP 8.1 or newer",[523,566,567,570],{},[500,568,170],{"href":502,"rel":569},[504]," 2.3 or newer, installed and active",[523,572,573,574,579],{},"A ",[500,575,578],{"href":576,"rel":577},"https:\u002F\u002Fvatly.com",[504],"Vatly"," account with API credentials",[515,581,583],{"id":582},"quick-start","Quick start",[585,586,588],"h3",{"id":587},"_1-install-the-plugin","1. Install the plugin",[496,590,591,592,597,598,601],{},"Download the zip from the ",[500,593,596],{"href":594,"rel":595},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp\u002Freleases\u002Flatest",[504],"latest release",", then in WordPress go to ",[510,599,600],{},"Plugins → Add New → Upload Plugin",", choose the zip, and activate it. The zip includes the plugin's dependencies, so you don't need Composer.",[496,603,604,605,609],{},"If your site manages its plugins with Composer, such as a Bedrock site with ",[606,607,608],"code",{},"composer\u002Finstallers",", require the plugin from Packagist instead. Its dependencies are alpha releases, so allow alpha packages first:",[611,612,617],"pre",{"className":613,"code":614,"language":615,"meta":616,"style":616},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","composer config minimum-stability alpha\ncomposer config prefer-stable true\ncomposer require vatly\u002Fvatly-fluentcart\n","bash","",[606,618,619,638,652],{"__ignoreMap":616},[620,621,624,628,632,635],"span",{"class":622,"line":623},"line",1,[620,625,627],{"class":626},"sBMFI","composer",[620,629,631],{"class":630},"sfazB"," config",[620,633,634],{"class":630}," minimum-stability",[620,636,637],{"class":630}," alpha\n",[620,639,641,643,645,648],{"class":622,"line":640},2,[620,642,627],{"class":626},[620,644,631],{"class":630},[620,646,647],{"class":630}," prefer-stable",[620,649,651],{"class":650},"sMK4o"," true\n",[620,653,655,657,660],{"class":622,"line":654},3,[620,656,627],{"class":626},[620,658,659],{"class":630}," require",[620,661,662],{"class":630}," vatly\u002Fvatly-fluentcart\n",[496,664,665,666,669],{},"The plugin installs as ",[606,667,668],{},"vatly-for-fluentcart"," in your plugins directory, the same name the zip uses. Its dependencies load through your site's Composer autoloader, which Bedrock includes. Then activate the plugin in WordPress.",[585,671,673],{"id":672},"_2-connect-vatly","2. Connect Vatly",[675,676,677,703],"ol",{},[523,678,679,682,683,686,687,690,691,694,695,698,699,702],{},[510,680,681],{},"Add your API credentials."," Go to ",[510,684,685],{},"FluentCart → Settings → Payment Methods → Vatly",", choose ",[510,688,689],{},"Test"," mode, and paste the test ",[510,692,693],{},"API key"," and ",[510,696,697],{},"Webhook secret"," from the ",[510,700,701],{},"Developers"," section of your Vatly dashboard.",[523,704,705,708,709,711,712,720,723,724,727,728,731],{},[510,706,707],{},"Register the webhook in Vatly."," Under ",[510,710,701],{}," in the Vatly dashboard, add a webhook endpoint pointing at:",[611,713,718],{"className":714,"code":716,"language":717,"meta":616},[715],"language-text","https:\u002F\u002Fyour-site.com\u002Fwp-admin\u002Fadmin-ajax.php?action=fluent_cart_vatly_webhook\n","text",[606,719,716],{"__ignoreMap":616},[721,722],"br",{},"Use the webhook secret you entered above. Vatly's ",[606,725,726],{},"order.paid"," webhook stamps the official invoice onto each order. Until a webhook secret is saved for the current mode, the endpoint answers ",[606,729,730],{},"503"," and processes nothing; Vatly retries the delivery once it is saved.",[585,733,735],{"id":734},"_3-map-your-products","3. Map your products",[496,737,738,739,742,743,746],{},"Edit a FluentCart product and fill in the ",[510,740,741],{},"Vatly mapping"," box with the IDs from ",[510,744,745],{},"Manage Products"," in your Vatly dashboard:",[520,748,749,759],{},[523,750,751,754,755,758],{},[510,752,753],{},"Vatly product ID",": the ",[606,756,757],{},"one_off_product_…"," ID, for one-time products.",[523,760,761,754,764,767],{},[510,762,763],{},"Vatly plan ID",[606,765,766],{},"subscription_plan_…"," ID, for subscription products.",[496,769,770],{},"A checkout fails with a clear error when the product it sells has no matching Vatly ID.",[585,772,774],{"id":773},"_4-test-then-go-live","4. Test, then go live",[496,776,777,778,781],{},"Place a test order in Vatly test mode and check that the Vatly invoice appears on the receipt. When it works, switch the gateway to ",[510,779,780],{},"Live"," and enter your live API key and webhook secret.",[515,783,785],{"id":784},"invoices","Invoices",[496,787,788,789,791],{},"Vatly issues the legally valid VAT invoice and, for refunds, the credit note. When a Vatly ",[606,790,726],{}," webhook arrives, the plugin stores the Vatly invoice URL on the FluentCart order and the credit-note URL on refunds. Show the invoice anywhere FluentCart accepts shortcodes:",[793,794,795,808],"table",{},[796,797,798],"thead",{},[799,800,801,805],"tr",{},[802,803,804],"th",{},"Shortcode",[802,806,807],{},"Output",[809,810,811,822],"tbody",{},[799,812,813,819],{},[814,815,816],"td",{},[606,817,818],{},"[vatly_invoice_link]",[814,820,821],{},"A plain \"Download official Vatly invoice\" link.",[799,823,824,829],{},[814,825,826],{},[606,827,828],{},"[vatly_invoice_button]",[814,830,831],{},"The same link, styled as a button.",[496,833,834,835,838,839,842],{},"Both accept an optional ",[606,836,837],{},"order_id",", for example ",[606,840,841],{},"[vatly_invoice_link order_id=\"123\"]","; otherwise they use FluentCart's current order. They render nothing for orders without a Vatly invoice, so they are safe in templates shared with other gateways. The invoice button also appears automatically on the FluentCart receipt page.",[496,844,845,846,849],{},"For the FluentCart hooks the invoicing relies on, see ",[500,847,848],{"href":179},"Merchant-of-Record invoicing",".",[515,851,108],{"id":852},"refunds",[496,854,855],{},"Refunds issued from the FluentCart admin go through Vatly, then are recorded on the FluentCart transaction.",[520,857,858,864,870],{},[523,859,860,863],{},[510,861,862],{},"Full refunds"," are supported.",[523,865,866,869],{},[510,867,868],{},"Partial refunds on single-item orders"," are refunded against the order's line.",[523,871,872,875],{},[510,873,874],{},"Partial refunds on multi-item orders"," are not supported from FluentCart. Issue a full refund, or refund a specific line from the Vatly dashboard.",[496,877,878,879,882,883,886],{},"Vatly refunds are asynchronous: the FluentCart refund starts with Vatly's initial status, usually ",[606,880,881],{},"pending",", and moves to ",[606,884,885],{},"refunded"," once Vatly confirms it.",[496,888,889],{},"Each FluentCart transaction keeps the mode (test or live) it had at checkout. Refunds use the API key for that record's mode, not the gateway's current setting.",[515,891,893],{"id":892},"data-the-plugin-stores","Data the plugin stores",[496,895,896],{},"For your records of processing and for access and deletion requests:",[520,898,899,905,915],{},[523,900,901,904],{},[510,902,903],{},"Settings:"," your Vatly API keys and webhook secrets, encrypted, in FluentCart's settings.",[523,906,907,910,911,914],{},[510,908,909],{},"Customer links:"," the table ",[606,912,913],{},"{prefix}vatly_customer_bindings"," maps each Vatly customer ID to its FluentCart customer ID. It holds no names or contact details.",[523,916,917,910,920,923,924,927,928,931,932,849],{},[510,918,919],{},"Webhook log:",[606,921,922],{},"{prefix}vatly_webhook_calls"," keeps each webhook Vatly sends, for debugging. Personal fields (customer name, email, address, tax ID, payment method details) are redacted before it is stored, so they read ",[606,925,926],{},"[redacted]","; the event's IDs, statuses, amounts, tax and order lines are kept. Entries are deleted after 30 days. Change that with the ",[606,929,930],{},"vatly_fluentcart_webhook_log_retention_days"," filter, for example ",[606,933,934],{},"add_filter('vatly_fluentcart_webhook_log_retention_days', fn () => 7);",[496,936,937],{},"Orders, subscriptions and transactions are FluentCart's own records. Deleting the plugin removes both tables, its settings and its scheduled jobs, and leaves those records in place.",[515,939,941],{"id":940},"building-from-source","Building from source",[496,943,944,945,948,949,952],{},"To build the zip yourself, run ",[606,946,947],{},"bin\u002Fbuild-release.sh"," in a clone of the repository. It produces ",[606,950,951],{},"build\u002Fvatly-for-fluentcart.zip"," with a namespace-scoped copy of the dependencies, and needs PHP, Composer, curl and zip.",[496,954,955,956,959,960,849],{},"For development, run ",[606,957,958],{},"composer install"," in the clone instead, then place or symlink the directory in ",[606,961,962],{},"wp-content\u002Fplugins\u002F",[515,964,388],{"id":965},"development",[611,967,969],{"className":613,"code":968,"language":615,"meta":616,"style":616},"composer install\ncomposer test:unit          # PHPUnit unit suite\ncomposer test:integration   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\ncomposer analyse            # PHPStan\ncomposer phpcs              # WordPress coding standards\n",[606,970,971,978,989,999,1010],{"__ignoreMap":616},[620,972,973,975],{"class":622,"line":623},[620,974,627],{"class":626},[620,976,977],{"class":630}," install\n",[620,979,980,982,985],{"class":622,"line":640},[620,981,627],{"class":626},[620,983,984],{"class":630}," test:unit",[620,986,988],{"class":987},"sHwdD","          # PHPUnit unit suite\n",[620,990,991,993,996],{"class":622,"line":654},[620,992,627],{"class":626},[620,994,995],{"class":630}," test:integration",[620,997,998],{"class":987},"   # integration suite (see docker\u002F for a WordPress + FluentCart environment)\n",[620,1000,1002,1004,1007],{"class":622,"line":1001},4,[620,1003,627],{"class":626},[620,1005,1006],{"class":630}," analyse",[620,1008,1009],{"class":987},"            # PHPStan\n",[620,1011,1013,1015,1018],{"class":622,"line":1012},5,[620,1014,627],{"class":626},[620,1016,1017],{"class":630}," phpcs",[620,1019,1020],{"class":987},"              # WordPress coding standards\n",[496,1022,1023,1024,849],{},"The source and issue tracker are on ",[500,1025,1028],{"href":1026,"rel":1027},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp",[504],"GitHub",[1030,1031,1032],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-