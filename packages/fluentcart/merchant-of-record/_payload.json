ath":423,"stem":424,"children":425,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[426,429,433,436,440,444,447,450,453,457,460],{"title":129,"path":427,"stem":428},"\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F00.readme",{"title":430,"path":431,"stem":432},"Installation","\u002Fpackages\u002Fdjango\u002Finstallation","3.packages\u002F8.django\u002F01.installation",{"title":186,"path":434,"stem":435},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F02.configuration",{"title":437,"path":438,"stem":439},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":441,"path":442,"stem":443},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":445,"stem":446},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":206,"path":448,"stem":449},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":451,"stem":452},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":454,"path":455,"stem":456},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":458,"stem":459},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":376,"path":461,"stem":462},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":464,"path":465,"stem":466,"children":467},"Integrations","\u002Fintegrations","4.integrations",[468,470,474],{"title":464,"path":465,"stem":469},"4.integrations\u002Findex",{"title":471,"path":472,"stem":473},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":475,"path":476,"stem":477},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":479,"title":480,"body":481,"description":713,"extension":714,"links":715,"meta":716,"navigation":717,"path":175,"seo":718,"stem":176,"__hash__":719},"docs\u002F3.packages\u002F10.fluentcart\u002F01.merchant-of-record.md","Merchant-of-Record invoicing: implementation notes",{"type":482,"value":483,"toc":706},"minimark",[484,496,501,513,524,528,553,564,639,643,690,701],[485,486,487,488,495],"p",{},"How the plugin makes Vatly the single source of truth for invoices on FluentCart\norders, and the FluentCart integration points it relies on. This is reference\nmaterial for maintainers; end users only need the ",[489,490,494],"a",{"href":491,"rel":492},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp\u002Fblob\u002Fmain\u002FREADME.md",[493],"nofollow","README",".",[497,498,500],"h2",{"id":499},"the-problem","The problem",[485,502,503,504,508,509,512],{},"Vatly is the Merchant of Record, so the legally valid VAT invoice (and, for\nrefunds, the credit note) is the one ",[505,506,507],"strong",{},"Vatly"," issues. FluentCart also generates\nits own receipt\u002Finvoice. Left alone, a customer paying via Vatly would receive\n",[505,510,511],{},"two competing invoices"," for one purchase.",[485,514,515,516,520,521,495],{},"The plugin therefore (a) surfaces Vatly's invoice and (b) suppresses\nFluentCart's own invoicing, but only for orders paid via the Vatly gateway\n(",[517,518,519],"code",{},"payment_method === 'vatly'","). Every guard callback is a strict no-op for\nnon-Vatly orders. The guard lives in ",[517,522,523],{},"src\u002FSupport\u002FMoRInvoiceGuard.php",[497,525,527],{"id":526},"hooks-used","Hooks used",[529,530,531],"blockquote",{},[485,532,533,536,537,540,541,544,545,548,549,552],{},[505,534,535],{},"FluentCart version note."," The gateway integration (registration, checkout,\nrefunds, and the ",[517,538,539],{},"order.paid"," confirmation + Vatly-invoice stamping) has been\nported to and verified against ",[505,542,543],{},"FluentCart free 2.2.0",". The two\nMerchant-of-Record email\u002Freceipt guard hooks in the table below still carry\ntheir original ",[517,546,547],{},"\u002F\u002F verified: FluentCart free 1.3.28"," file:line references and\nhave ",[505,550,551],{},"not"," yet been re-verified against 2.2.0: the hook names and line\nnumbers may have moved, so re-confirm they still exist and fire before relying\non the email-suppression guard on 2.2.0.",[485,554,555,556,559,560,563],{},"The guard wires only hooks confirmed to exist ",[505,557,558],{},"and fire",". Each wired hook\ncarries a ",[517,561,562],{},"\u002F\u002F verified: …"," file:line comment in the source.",[565,566,567,583],"table",{},[568,569,570],"thead",{},[571,572,573,577,580],"tr",{},[574,575,576],"th",{},"Intent",[574,578,579],{},"FluentCart hook",[574,581,582],{},"Notes",[584,585,586,622],"tbody",{},[571,587,588,592,602],{},[589,590,591],"td",{},"Suppress FluentCart's competing customer receipt\u002Finvoice email (and its PDF attachment)",[589,593,594,597,598,601],{},[517,595,596],{},"fluent_cart\u002Fshould_send_email_notification"," (filter, ",[517,599,600],{},"EmailNotificationMailer::mailEmailsOfEvent",")",[589,603,604,605,608,609,612,613,616,617,621],{},"Returns ",[517,606,607],{},"false"," for the ",[517,610,611],{},"order_paid_customer"," notification (event ",[517,614,615],{},"order_paid",", subject \"Purchase Receipt #",[618,619],"binding",{"value":620},"order.invoice_no","\") on Vatly orders: the only customer mail that doubles as FluentCart's invoice and the only one that can attach FluentCart's PDF receipt. No email ⇒ no competing invoice and no attached PDF (covers Pro too). All other notifications (refunds, shipping, subscription, and every admin copy) pass through untouched.",[571,623,624,627,636],{},[589,625,626],{},"Surface the Vatly invoice link on the customer receipt page",[589,628,629,632,633,601],{},[517,630,631],{},"fluent_cart\u002Freceipt\u002Fthank_you\u002Fafter_order_items"," (action, ",[517,634,635],{},"ThankYouRender",[589,637,638],{},"Auto-renders the Vatly invoice button (reusing the shortcode renderer) beneath the order items for Vatly orders.",[497,640,642],{"id":641},"why-some-surfaces-arent-hooked","Why some surfaces aren't hooked",[644,645,646,670,676],"ul",{},[647,648,649,652,653,656,657,660,661,664,665,669],"li",{},[505,650,651],{},"FluentCart Pro PDF receipt"," (",[517,654,655],{},"fluent_cart\u002Fpdf\u002Fgenerate_receipt",") only fires\nunder Pro + FluentPDF (",[517,658,659],{},"OrderService::canGenerateReceiptPdf()"," +\n",[517,662,663],{},"defined('FLUENT_PDF')","), so it never runs on free. Suppressing the receipt\n",[666,667,668],"em",{},"email"," already drops its PDF attachment on Pro, so no separate handler is\nneeded.",[647,671,672,675],{},[505,673,674],{},"Refund PDF \u002F refund URL",": FluentCart free exposes no hook to redirect a\nrefund PDF, and there is no free refund-PDF surface to gate.",[647,677,678,681,682,685,686,689],{},[505,679,680],{},"Admin billing-detail edits",": FluentCart free fires no action or filter\naround ",[517,683,684],{},"CustomerAddressResource::update"," or the admin\n",[517,687,688],{},"CustomerController::updateAddress",", so an admin edit of an order's\u002Fcustomer's\nbilling address cannot be blocked or mirrored.",[485,691,692,693,696,697,700],{},"These FluentCart-side artifacts remain FluentCart-local and ",[505,694,695],{},"non-authoritative",";\nVatly's invoice and credit note are the legal record of account. For\nsubscriptions, point staff to the Vatly customer portal\n(",[517,698,699],{},"SubscriptionService::updateBillingUrl()",") when billing details must change; a\nFluentCart-local edit never reaches Vatly's already-issued invoice.",[529,702,703],{},[485,704,705],{},"Earlier revisions referenced several FluentCart hook names that don't exist in\ncore; those have been removed. If you extend the guard, confirm any new hook\nactually fires in the FluentCart version you target before relying on it.",{"title":707,"searchDepth":708,"depth":708,"links":709},"",2,[710,711,712],{"id":499,"depth":708,"text":500},{"id":526,"depth":708,"text":527},{"id":641,"depth":708,"text":642},"How the plugin makes Vatly the single source of truth for invoices on FluentCart orders, and the FluentCart integration points it relies on.","md",null,{},{"title":174},{"title":480,"description":713},"LwbqdKGrcXNEQxeKK_AviU2IcEG96_DGkpWVL1kXE4Y",[721,723],{"title":129,"path":171,"stem":172,"description":722,"children":-1},"Accept payments through Vatly in FluentCart, the WordPress e-commerce plugin.",{"title":129,"path":183,"stem":184,"description":724,"children":-1},"Sell a download, start a subscription, and keep your app's billing records in step with Vatly.",1795437007103]