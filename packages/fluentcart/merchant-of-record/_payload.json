h":424,"stem":425},"\u002Fpackages\u002Ffluent-python\u002Ftesting","3.packages\u002F7.fluent-python\u002F11.testing",{"title":427,"path":428,"stem":429},"Porting","\u002Fpackages\u002Ffluent-python\u002Fporting","3.packages\u002F7.fluent-python\u002F12.porting",{"title":388,"path":431,"stem":432},"\u002Fpackages\u002Ffluent-python\u002Fdevelopment","3.packages\u002F7.fluent-python\u002F13.development",{"title":434,"path":435,"stem":436,"children":437,"page":65},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[438,441,445,448,452,456,459,462,465,469,472],{"title":133,"path":439,"stem":440},"\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F00.readme",{"title":442,"path":443,"stem":444},"Installation","\u002Fpackages\u002Fdjango\u002Finstallation","3.packages\u002F8.django\u002F01.installation",{"title":198,"path":446,"stem":447},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F02.configuration",{"title":449,"path":450,"stem":451},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":453,"path":454,"stem":455},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":92,"path":457,"stem":458},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":218,"path":460,"stem":461},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":54,"path":463,"stem":464},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":466,"path":467,"stem":468},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":62,"path":470,"stem":471},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":388,"path":473,"stem":474},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":476,"path":477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":492,"body":493,"description":725,"extension":726,"links":727,"meta":728,"navigation":729,"path":179,"seo":730,"stem":180,"__hash__":731},"docs\u002F3.packages\u002F10.fluentcart\u002F01.merchant-of-record.md","Merchant-of-Record invoicing: implementation notes",{"type":494,"value":495,"toc":718},"minimark",[496,508,513,525,536,540,565,576,651,655,702,713],[497,498,499,500,507],"p",{},"How the plugin makes Vatly the single source of truth for invoices on FluentCart\norders, and the FluentCart integration points it relies on. This is reference\nmaterial for maintainers; end users only need the ",[501,502,506],"a",{"href":503,"rel":504},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluentcart-wp\u002Fblob\u002Fmain\u002FREADME.md",[505],"nofollow","README",".",[509,510,512],"h2",{"id":511},"the-problem","The problem",[497,514,515,516,520,521,524],{},"Vatly is the Merchant of Record, so the legally valid VAT invoice (and, for\nrefunds, the credit note) is the one ",[517,518,519],"strong",{},"Vatly"," issues. FluentCart also generates\nits own receipt\u002Finvoice. Left alone, a customer paying via Vatly would receive\n",[517,522,523],{},"two competing invoices"," for one purchase.",[497,526,527,528,532,533,507],{},"The plugin therefore (a) surfaces Vatly's invoice and (b) suppresses\nFluentCart's own invoicing, but only for orders paid via the Vatly gateway\n(",[529,530,531],"code",{},"payment_method === 'vatly'","). Every guard callback is a strict no-op for\nnon-Vatly orders. The guard lives in ",[529,534,535],{},"src\u002FSupport\u002FMoRInvoiceGuard.php",[509,537,539],{"id":538},"hooks-used","Hooks used",[541,542,543],"blockquote",{},[497,544,545,548,549,552,553,556,557,560,561,564],{},[517,546,547],{},"FluentCart version note."," The gateway integration (registration, checkout,\nrefunds, and the ",[529,550,551],{},"order.paid"," confirmation + Vatly-invoice stamping) has been\nported to and verified against ",[517,554,555],{},"FluentCart free 2.2.0",". The two\nMerchant-of-Record email\u002Freceipt guard hooks in the table below still carry\ntheir original ",[529,558,559],{},"\u002F\u002F verified: FluentCart free 1.3.28"," file:line references and\nhave ",[517,562,563],{},"not"," yet been re-verified against 2.2.0: the hook names and line\nnumbers may have moved, so re-confirm they still exist and fire before relying\non the email-suppression guard on 2.2.0.",[497,566,567,568,571,572,575],{},"The guard wires only hooks confirmed to exist ",[517,569,570],{},"and fire",". Each wired hook\ncarries a ",[529,573,574],{},"\u002F\u002F verified: …"," file:line comment in the source.",[577,578,579,595],"table",{},[580,581,582],"thead",{},[583,584,585,589,592],"tr",{},[586,587,588],"th",{},"Intent",[586,590,591],{},"FluentCart hook",[586,593,594],{},"Notes",[596,597,598,634],"tbody",{},[583,599,600,604,614],{},[601,602,603],"td",{},"Suppress FluentCart's competing customer receipt\u002Finvoice email (and its PDF attachment)",[601,605,606,609,610,613],{},[529,607,608],{},"fluent_cart\u002Fshould_send_email_notification"," (filter, ",[529,611,612],{},"EmailNotificationMailer::mailEmailsOfEvent",")",[601,615,616,617,620,621,624,625,628,629,633],{},"Returns ",[529,618,619],{},"false"," for the ",[529,622,623],{},"order_paid_customer"," notification (event ",[529,626,627],{},"order_paid",", subject \"Purchase Receipt #",[630,631],"binding",{"value":632},"order.invoice_no","\") on Vatly orders: the only customer mail that doubles as FluentCart's invoice and the only one that can attach FluentCart's PDF receipt. No email ⇒ no competing invoice and no attached PDF (covers Pro too). All other notifications (refunds, shipping, subscription, and every admin copy) pass through untouched.",[583,635,636,639,648],{},[601,637,638],{},"Surface the Vatly invoice link on the customer receipt page",[601,640,641,644,645,613],{},[529,642,643],{},"fluent_cart\u002Freceipt\u002Fthank_you\u002Fafter_order_items"," (action, ",[529,646,647],{},"ThankYouRender",[601,649,650],{},"Auto-renders the Vatly invoice button (reusing the shortcode renderer) beneath the order items for Vatly orders.",[509,652,654],{"id":653},"why-some-surfaces-arent-hooked","Why some surfaces aren't hooked",[656,657,658,682,688],"ul",{},[659,660,661,664,665,668,669,672,673,676,677,681],"li",{},[517,662,663],{},"FluentCart Pro PDF receipt"," (",[529,666,667],{},"fluent_cart\u002Fpdf\u002Fgenerate_receipt",") only fires\nunder Pro + FluentPDF (",[529,670,671],{},"OrderService::canGenerateReceiptPdf()"," +\n",[529,674,675],{},"defined('FLUENT_PDF')","), so it never runs on free. Suppressing the receipt\n",[678,679,680],"em",{},"email"," already drops its PDF attachment on Pro, so no separate handler is\nneeded.",[659,683,684,687],{},[517,685,686],{},"Refund PDF \u002F refund URL",": FluentCart free exposes no hook to redirect a\nrefund PDF, and there is no free refund-PDF surface to gate.",[659,689,690,693,694,697,698,701],{},[517,691,692],{},"Admin billing-detail edits",": FluentCart free fires no action or filter\naround ",[529,695,696],{},"CustomerAddressResource::update"," or the admin\n",[529,699,700],{},"CustomerController::updateAddress",", so an admin edit of an order's\u002Fcustomer's\nbilling address cannot be blocked or mirrored.",[497,703,704,705,708,709,712],{},"These FluentCart-side artifacts remain FluentCart-local and ",[517,706,707],{},"non-authoritative",";\nVatly's invoice and credit note are the legal record of account. For\nsubscriptions, point staff to the Vatly customer portal\n(",[529,710,711],{},"SubscriptionService::updateBillingUrl()",") when billing details must change; a\nFluentCart-local edit never reaches Vatly's already-issued invoice.",[541,714,715],{},[497,716,717],{},"Earlier revisions referenced several FluentCart hook names that don't exist in\ncore; those have been removed. If you extend the guard, confirm any new hook\nactually fires in the FluentCart version you target before relying on it.",{"title":719,"searchDepth":720,"depth":720,"links":721},"",2,[722,723,724],{"id":511,"depth":720,"text":512},{"id":538,"depth":720,"text":539},{"id":653,"depth":720,"text":654},"How the plugin makes Vatly the single source of truth for invoices on FluentCart orders, and the FluentCart integration points it relies on.","md",null,{},{"title":178},{"title":492,"description":725},"LwbqdKGrcXNEQxeKK_AviU2IcEG96_DGkpWVL1kXE4Y",[733,735],{"title":133,"path":175,"stem":176,"description":734,"children":-1},"Sell from your FluentCart store with Vatly as the Merchant of Record, so you don't have to handle VAT yourself.",{"title":133,"path":187,"stem":188,"description":736,"children":-1},"Sell Paid Memberships Pro (PMPro) memberships with Vatly as the Merchant of Record, so you don't have to handle VAT yourself.",1795701363860]