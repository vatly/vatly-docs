ass":742},[736,1546,753],{"class":742},[736,1548,756],{"class":746},[736,1550,759],{"class":742},[736,1552,762],{"class":746},[736,1554,759],{"class":742},[736,1556,768],{"class":767},[736,1558,1559],{"class":742},"([",[736,1561,783],{"class":742},[736,1563,555],{"class":780},[736,1565,783],{"class":742},[736,1567,786],{"class":742},[736,1569,789],{"class":742},[736,1571,792],{"class":780},[736,1573,783],{"class":742},[736,1575,865],{"class":742},[736,1577,1578],{"class":738,"line":774},[736,1579,872],{"emptyLinePlaceholder":871},[736,1581,1582,1584,1586,1588,1590,1592,1594],{"class":738,"line":800},[736,1583,878],{"class":767},[736,1585,753],{"class":742},[736,1587,547],{"class":746},[736,1589,759],{"class":742},[736,1591,518],{"class":746},[736,1593,889],{"class":742},[736,1595,1596],{"class":892}," \u002F\u002F the existing customer id, if the email was already known\n",[638,1598],{},[476,1600,1602],{"id":1601},"create-a-customer-portal-session","Create a customer portal session",[472,1604,1605],{},[516,1606,1607],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[472,1609,1610],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[472,1612,1613,1614,1617],{},"Redirect the customer's browser to the returned ",[516,1615,1616],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[484,1619,686],{"id":1620},"optional-attributes-3",[489,1622,1623,1633],{},[492,1624,1625],{},[495,1626,1627,1629,1631],{},[498,1628,500],{},[498,1630,503],{},[498,1632,506],{},[508,1634,1635],{},[495,1636,1637,1642,1646],{},[513,1638,1639],{},[516,1640,1641],{},"returnUrl",[513,1643,1644],{},[516,1645,523],{},[513,1647,1648],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[472,1650,1651,1652,1655],{},"The returned ",[516,1653,1654],{},"PortalSession"," has three properties:",[489,1657,1658,1668],{},[492,1659,1660],{},[495,1661,1662,1664,1666],{},[498,1663,500],{},[498,1665,503],{},[498,1667,506],{},[508,1669,1670,1683,1697],{},[495,1671,1672,1676,1680],{},[513,1673,1674],{},[516,1675,1616],{},[513,1677,1678],{},[516,1679,523],{},[513,1681,1682],{},"Single-use HTTPS URL to redirect the customer to.",[495,1684,1685,1690,1694],{},[513,1686,1687],{},[516,1688,1689],{},"expiresAt",[513,1691,1692],{},[516,1693,523],{},[513,1695,1696],{},"Expiry of the one-time entry link (ISO 8601).",[495,1698,1699,1703,1707],{},[513,1700,1701],{},[516,1702,1641],{},[513,1704,1705],{},[516,1706,574],{},[513,1708,1709,1710,548],{},"The validated return URL you supplied, or ",[516,1711,1037],{},[727,1713,1715],{"className":729,"code":1714,"language":731,"meta":732,"style":732},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[516,1716,1717,1751,1770,1774,1778,1783],{"__ignoreMap":732},[736,1718,1719,1721,1724,1726,1728,1730,1732,1734,1736,1739,1741,1743,1745,1747,1749],{"class":738,"line":739},[736,1720,743],{"class":742},[736,1722,1723],{"class":746},"session ",[736,1725,750],{"class":742},[736,1727,753],{"class":742},[736,1729,756],{"class":746},[736,1731,759],{"class":742},[736,1733,762],{"class":746},[736,1735,759],{"class":742},[736,1737,1738],{"class":767},"createPortalSession",[736,1740,936],{"class":742},[736,1742,783],{"class":742},[736,1744,941],{"class":780},[736,1746,783],{"class":742},[736,1748,1087],{"class":742},[736,1750,831],{"class":742},[736,1752,1753,1755,1757,1759,1761,1763,1766,1768],{"class":738,"line":774},[736,1754,777],{"class":742},[736,1756,1641],{"class":780},[736,1758,783],{"class":742},[736,1760,786],{"class":742},[736,1762,789],{"class":742},[736,1764,1765],{"class":780},"https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling",[736,1767,783],{"class":742},[736,1769,797],{"class":742},[736,1771,1772],{"class":738,"line":800},[736,1773,865],{"class":742},[736,1775,1776],{"class":738,"line":820},[736,1777,872],{"emptyLinePlaceholder":871},[736,1779,1780],{"class":738,"line":834},[736,1781,1782],{"class":892},"\u002F\u002F Redirect the customer's browser to the hosted portal.\n",[736,1784,1785,1788,1790,1792,1795,1797,1800,1802,1805,1807,1809],{"class":738,"line":856},[736,1786,1787],{"class":767},"header",[736,1789,936],{"class":742},[736,1791,783],{"class":742},[736,1793,1794],{"class":780},"Location: ",[736,1796,783],{"class":742},[736,1798,1799],{"class":742}," .",[736,1801,753],{"class":742},[736,1803,1804],{"class":746},"session",[736,1806,759],{"class":742},[736,1808,1616],{"class":746},[736,1810,946],{"class":742},[472,1812,1813],{},"The body is optional — omit it to create a session without a return link:",[727,1815,1817],{"className":729,"code":1816,"language":731,"meta":732,"style":732},"$session = $vatly->customers->createPortalSession('customer_abc123');\n",[516,1818,1819],{"__ignoreMap":732},[736,1820,1821,1823,1825,1827,1829,1831,1833,1835,1837,1839,1841,1843,1845,1847],{"class":738,"line":739},[736,1822,743],{"class":742},[736,1824,1723],{"class":746},[736,1826,750],{"class":742},[736,1828,753],{"class":742},[736,1830,756],{"class":746},[736,1832,759],{"class":742},[736,1834,762],{"class":746},[736,1836,759],{"class":742},[736,1838,1738],{"class":767},[736,1840,936],{"class":742},[736,1842,783],{"class":742},[736,1