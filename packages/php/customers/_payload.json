687,1520,740],{"class":693},[687,1522,743],{"class":731},[687,1524,734],{"class":693},[687,1526,816],{"class":693},[687,1528,1529],{"class":689,"line":725},[687,1530,823],{"emptyLinePlaceholder":822},[687,1532,1533,1535,1537,1539,1541,1543,1545],{"class":689,"line":751},[687,1534,829],{"class":718},[687,1536,704],{"class":693},[687,1538,498],{"class":697},[687,1540,710],{"class":693},[687,1542,469],{"class":697},[687,1544,840],{"class":693},[687,1546,1547],{"class":843}," \u002F\u002F the existing customer id, if the email was already known\n",[589,1549],{},[427,1551,1553],{"id":1552},"create-a-customer-portal-session","Create a customer portal session",[423,1555,1556],{},[467,1557,1558],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[423,1560,1561],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[423,1563,1564,1565,1568],{},"Redirect the customer's browser to the returned ",[467,1566,1567],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[435,1570,637],{"id":1571},"optional-attributes-3",[440,1573,1574,1584],{},[443,1575,1576],{},[446,1577,1578,1580,1582],{},[449,1579,451],{},[449,1581,454],{},[449,1583,457],{},[459,1585,1586],{},[446,1587,1588,1593,1597],{},[464,1589,1590],{},[467,1591,1592],{},"returnUrl",[464,1594,1595],{},[467,1596,474],{},[464,1598,1599],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[423,1601,1602,1603,1606],{},"The returned ",[467,1604,1605],{},"PortalSession"," has three properties:",[440,1608,1609,1619],{},[443,1610,1611],{},[446,1612,1613,1615,1617],{},[449,1614,451],{},[449,1616,454],{},[449,1618,457],{},[459,1620,1621,1634,1648],{},[446,1622,1623,1627,1631],{},[464,1624,1625],{},[467,1626,1567],{},[464,1628,1629],{},[467,1630,474],{},[464,1632,1633],{},"Single-use HTTPS URL to redirect the customer to.",[446,1635,1636,1641,1645],{},[464,1637,1638],{},[467,1639,1640],{},"expiresAt",[464,1642,1643],{},[467,1644,474],{},[464,1646,1647],{},"Expiry of the one-time entry link (ISO 8601).",[446,1649,1650,1654,1658],{},[464,1651,1652],{},[467,1653,1592],{},[464,1655,1656],{},[467,1657,525],{},[464,1659,1660,1661,499],{},"The validated return URL you supplied, or ",[467,1662,988],{},[678,1664,1666],{"className":680,"code":1665,"language":682,"meta":683,"style":683},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[467,1667,1668,1702,1721,1725,1729,1734],{"__ignoreMap":683},[687,1669,1670,1672,1675,1677,1679,1681,1683,1685,1687,1690,1692,1694,1696,1698,1700],{"class":689,"line":690},[687,1671,694],{"class":693},[687,1673,1674],{"class":697},"session ",[687,1676,701],{"class":693},[687,1678,704],{"class":693},[687,1680,707],{"class":697},[687,1682,710],{"class":693},[687,1684,713],{"class":697},[687,1686,710],{"class":693},[687,1688,1689],{"class":718},"createPortalSession",[687,1691,887],{"class":693},[687,1693,734],{"class":693},[687,1695,892],{"class":731},[687,1697,734],{"class":693},[687,1699,1038],{"class":693},[687,1701,782],{"class":693},[687,1703,1704,1706,1708,1710,1712,1714,1717,1719],{"class":689,"line":725},[687,1705,728],{"class":693},[687,1707,1592],{"class":731},[687,1709,734],{"class":693},[687,1711,737],{"class":693},[687,1713,740],{"class":693},[687,1715,1716],{"class":731},"https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling",[687,1718,734],{"class":693},[687,1720,748],{"class":693},[687,1722,1723],{"class":689,"line":751},[687,1724,816],{"class":693},[687,1726,1727],{"class":689,"line":771},[687,1728,823],{"emptyLinePlaceholder":822},[687,1730,1731],{"class":689,"line":785},[687,1732,1733],{"class":843},"\u002F\u002F Redirect the customer's browser to the hosted portal.\n",[687,1735,1736,1739,1741,1743,1746,1748,1751,1753,1756,1758,1760],{"class":689,"line":807},[687,1737,1738],{"class":718},"header",[687,1740,887],{"class":693},[687,1742,734],{"class":693},[687,1744,1745],{"class":731},"Location: ",[687,1747,734],{"class":693},[687,1749,1750],{"class":693}," .",[687,1752,704],{"class":693},[687,1754,1755],{"class":697},"session",[687,1757,710],{"class":693},[687,1759,1567],{"class":697},[687,1761,897],{"class":693},[423,1763,1764],{},"The body is optional — omit it to create a session without a return link:",[678,1766,1768],{"className":680,"code":1767,"language":682,"meta":683,"style":683},"$session = $vatly->customers->createPortalSession('customer_abc123');\n",[467,1769,1770],{"__ignoreMap":683},[687,1771,1772,1774,1776,1778,1780,1782,1784,1786,1788,1790,1792,1794,1796,1798],{"class":689,"line":690},[687,1773,694],{"class":693},[687,1775,1674],{"class":697},[687,1777,701],{"class":693},[687,1779,704],{"class":693},[687,1781,707],{"class":697},[687,1783,710],{"class":693},[687,1785,713],{"class":697},[687,1787,710],{"class":693},[687,1789,1689],{"class":718},[687,1791,887],{"class":693},[687,1793,734],{"class":693},[687,1795,892],{"class":731},[687,1797,734],{"class":693},[687,1799,897],{"class":693},[1801,1802,1803],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark