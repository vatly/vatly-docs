52,1453],{},"Look up customers by email address — the way back to a customer id you no longer\nhave (after a re-sync or reset). The address is canonicalized before matching,\nexactly as on write. An address can be held by more than one customer, so this\nalways returns a (possibly empty) collection.",[757,1455,1457],{"className":759,"code":1456,"language":761,"meta":762,"style":762},"$customers = $vatly->customers->listByEmail('john@example.com');\n\nif (count($customers) > 0) {\n    echo $customers[0]->id; \u002F\u002F customer_abc123\n}\n",[536,1458,1459,1490,1494,1522,1546],{"__ignoreMap":762},[766,1460,1461,1463,1465,1467,1469,1471,1473,1475,1477,1480,1482,1484,1486,1488],{"class":768,"line":769},[766,1462,773],{"class":772},[766,1464,1324],{"class":776},[766,1466,780],{"class":772},[766,1468,783],{"class":772},[766,1470,786],{"class":776},[766,1472,789],{"class":772},[766,1474,792],{"class":776},[766,1476,789],{"class":772},[766,1478,1479],{"class":797},"listByEmail",[766,1481,966],{"class":772},[766,1483,813],{"class":772},[766,1485,822],{"class":810},[766,1487,813],{"class":772},[766,1489,976],{"class":772},[766,1491,1492],{"class":768,"line":804},[766,1493,902],{"emptyLinePlaceholder":901},[766,1495,1496,1499,1502,1505,1508,1510,1512,1515,1518,1520],{"class":768,"line":830},[766,1497,1498],{"class":1351},"if",[766,1500,1501],{"class":772}," (",[766,1503,1504],{"class":797},"count",[766,1506,1507],{"class":772},"($",[766,1509,792],{"class":776},[766,1511,1367],{"class":772},[766,1513,1514],{"class":772}," >",[766,1516,1517],{"class":1436}," 0",[766,1519,1367],{"class":772},[766,1521,1370],{"class":772},[766,1523,1524,1526,1528,1530,1533,1536,1539,1541,1543],{"class":768,"line":850},[766,1525,1375],{"class":797},[766,1527,783],{"class":772},[766,1529,792],{"class":776},[766,1531,1532],{"class":772},"[",[766,1534,1535],{"class":1436},"0",[766,1537,1538],{"class":772},"]->",[766,1540,538],{"class":776},[766,1542,919],{"class":772},[766,1544,1545],{"class":922}," \u002F\u002F customer_abc123\n",[766,1547,1548],{"class":768,"line":864},[766,1549,1390],{"class":772},[492,1551,1552,1553,1556,1557,1560],{},"You can also recover in a single call by creating the customer again: create is\nget-or-create on the email, so posting a known address returns the existing\ncustomer (",[536,1554,1555],{},"200",") rather than a validation error, while a genuinely new address is\ncreated (",[536,1558,1559],{},"201","). Either way you get the customer back:",[757,1562,1564],{"className":759,"code":1563,"language":761,"meta":762,"style":762},"$customer = $vatly->customers->create(['email' => 'john@example.com']);\n\necho $customer->id; \u002F\u002F the existing customer id, if the email was already known\n",[536,1565,1566,1605,1609],{"__ignoreMap":762},[766,1567,1568,1570,1572,1574,1576,1578,1580,1582,1584,1586,1589,1591,1593,1595,1597,1599,1601,1603],{"class":768,"line":769},[766,1569,773],{"class":772},[766,1571,777],{"class":776},[766,1573,780],{"class":772},[766,1575,783],{"class":772},[766,1577,786],{"class":776},[766,1579,789],{"class":772},[766,1581,792],{"class":776},[766,1583,789],{"class":772},[766,1585,798],{"class":797},[766,1587,1588],{"class":772},"([",[766,1590,813],{"class":772},[766,1592,575],{"class":810},[766,1594,813],{"class":772},[766,1596,816],{"class":772},[766,1598,819],{"class":772},[766,1600,822],{"class":810},[766,1602,813],{"class":772},[766,1604,895],{"class":772},[766,1606,1607],{"class":768,"line":804},[766,1608,902],{"emptyLinePlaceholder":901},[766,1610,1611,1613,1615,1617,1619,1621,1623],{"class":768,"line":830},[766,1612,908],{"class":797},[766,1614,783],{"class":772},[766,1616,567],{"class":776},[766,1618,789],{"class":772},[766,1620,538],{"class":776},[766,1622,919],{"class":772},[766,1624,1625],{"class":922}," \u002F\u002F the existing customer id, if the email was already known\n",[658,1627],{},[496,1629,1631],{"id":1630},"create-a-customer-portal-session","Create a customer portal session",[492,1633,1634],{},[536,1635,1636],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[492,1638,1639],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[492,1641,1642,1643,1646],{},"Redirect the customer's browser to the returned ",[536,1644,1645],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[504,1648,706],{"id":1649},"optional-attributes-3",[509,1651,1652,1662],{},[512,1653,1654],{},[515,1655,1656,1658,1660],{},[518,1657,520],{},[518,1659,523],{},[518,1661,526],{},[528,1663,1664],{},[515,1665,1666,1671,1675],{},[533,1667,1668],{},[536,1669,1670],{},"returnUrl",[533,1672,1673],{},[536,1674,543],{},[533,1676,1677],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[492,1679,1680,1681,1684],{},"The returned ",[536,1682,1683],{},"PortalSession"," has three properties:",[509,1686,1687,1697],{},[512,1688,1689],{},[515,1690,1691,1693,1695],{},[518,1692,520],{},[518,1694,523],{},[518,1696,526],{},[528,1698,1699,1712,1726],{},[515,1700,1701,1705,1709],{},[533,1702,1703],{},[536,1704,1645],{},[533,1706,1707],{},[536,1708,543],{},[533,1710,1711],{},"Single-use HTTPS URL to redirect the customer to.",[515,1713,1714,1719,1723],{},[533,1715,1716],{},[536,1717,1718],{},"expiresAt",[533,1720,1721],{},[536,1722,543],{},[533,1724,1725],{},"Expiry of the one-time entry link (ISO 8601).",[515,1727,1728,1732,1736],{},[533,1729,1730],{},[536,1731,1670],{},[533,1733,1734],{},[536,1735,594],{},[533,1737,1738,1739,568],{},"The validated return URL you supplied, or ",[536,1740,754],{},[757,1742,1744],{"className":759,"code":1743,"language":761,"meta":762,"style":762},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[536,1745,1746,1780,1799,1803,1807,1812],{"__ignoreMap":762},[766,1747,1748,1750,1753,1755,1757,1759,1761,1763,1765,1768,1770,1772,1774,1776,1778],{"class":768,"line":769},[766,1749,773],{"class":772},[766,1751,1752],{"class":776},"session ",[766,1754,780],{"class":772},[766,1756,783],{"class":772},[766,1758,786],{"class":776},[766,1760,789],{"class":772},[766,1762,792],{"class":776},[766,1764,789],{"class":772},[766,1766,1767],{"class":797},"createPortalSession",[766,1769,966],{"class":772},[766,1771,813],{"class":772},[766,1773,971],{"class":810},[766,1775,813],{"class":772},[766,1777,1116],{"class":772},[766,1779,861],{"class":772},[766,1781,1782,1784,1786,1788,1790,1792,1795,1797],{"class":768,"line":804},[766,1783,807],{"class":772},[766,1785,1670],{"class":810},[766,1787,813],{"class":772},[766,1789,816],{"class":772},[766,1791,819],{"class":772},[766,1793,1794],{"class":810},"https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling",[766,1796,813],{"class":772},[766,1798,827],{"class":772},[766,1800,1801],{"class":768,"line":830},[766,1802,895],{"class":772},[766,1804,1805],{"class":768,"line":850},[766,1806,902],{"emptyLinePlaceholder":901},[766,1808,1809],{"class":768,"line":864},[766,1810,1811],{"class":922},"\u002F\u002F Redirect the customer's browser to the hosted portal.\n",[766,1813,1814,1817,1819,1821,1824,1826,1829,1831,1834,1836,1838],{"class":768,"line":886},[766,1815,1816],{"class":797},"header",[766,1818,966],{"class":772},[766,1820,813],{"class":772