returns a (possibly empty) collection.",[747,1446,1448],{"className":749,"code":1447,"language":751,"meta":752,"style":752},"$customers = $vatly->customers->listByEmail('john@example.com');\n\nif (count($customers) > 0) {\n    echo $customers[0]->id; \u002F\u002F customer_abc123\n}\n",[536,1449,1450,1481,1485,1513,1537],{"__ignoreMap":752},[756,1451,1452,1454,1456,1458,1460,1462,1464,1466,1468,1471,1473,1475,1477,1479],{"class":758,"line":759},[756,1453,763],{"class":762},[756,1455,1315],{"class":766},[756,1457,770],{"class":762},[756,1459,773],{"class":762},[756,1461,776],{"class":766},[756,1463,779],{"class":762},[756,1465,782],{"class":766},[756,1467,779],{"class":762},[756,1469,1470],{"class":787},"listByEmail",[756,1472,956],{"class":762},[756,1474,803],{"class":762},[756,1476,812],{"class":800},[756,1478,803],{"class":762},[756,1480,966],{"class":762},[756,1482,1483],{"class":758,"line":794},[756,1484,892],{"emptyLinePlaceholder":891},[756,1486,1487,1490,1493,1496,1499,1501,1503,1506,1509,1511],{"class":758,"line":820},[756,1488,1489],{"class":1342},"if",[756,1491,1492],{"class":762}," (",[756,1494,1495],{"class":787},"count",[756,1497,1498],{"class":762},"($",[756,1500,782],{"class":766},[756,1502,1358],{"class":762},[756,1504,1505],{"class":762}," >",[756,1507,1508],{"class":1427}," 0",[756,1510,1358],{"class":762},[756,1512,1361],{"class":762},[756,1514,1515,1517,1519,1521,1524,1527,1530,1532,1534],{"class":758,"line":840},[756,1516,1366],{"class":787},[756,1518,773],{"class":762},[756,1520,782],{"class":766},[756,1522,1523],{"class":762},"[",[756,1525,1526],{"class":1427},"0",[756,1528,1529],{"class":762},"]->",[756,1531,538],{"class":766},[756,1533,909],{"class":762},[756,1535,1536],{"class":912}," \u002F\u002F customer_abc123\n",[756,1538,1539],{"class":758,"line":854},[756,1540,1381],{"class":762},[492,1542,1543,1544,1547,1548,1551],{},"You can also recover in a single call by creating the customer again: create is\nget-or-create on the email, so posting a known address returns the existing\ncustomer (",[536,1545,1546],{},"200",") rather than a validation error, while a genuinely new address is\ncreated (",[536,1549,1550],{},"201","). Either way you get the customer back:",[747,1553,1555],{"className":749,"code":1554,"language":751,"meta":752,"style":752},"$customer = $vatly->customers->create(['email' => 'john@example.com']);\n\necho $customer->id; \u002F\u002F the existing customer id, if the email was already known\n",[536,1556,1557,1596,1600],{"__ignoreMap":752},[756,1558,1559,1561,1563,1565,1567,1569,1571,1573,1575,1577,1580,1582,1584,1586,1588,1590,1592,1594],{"class":758,"line":759},[756,1560,763],{"class":762},[756,1562,767],{"class":766},[756,1564,770],{"class":762},[756,1566,773],{"class":762},[756,1568,776],{"class":766},[756,1570,779],{"class":762},[756,1572,782],{"class":766},[756,1574,779],{"class":762},[756,1576,788],{"class":787},[756,1578,1579],{"class":762},"([",[756,1581,803],{"class":762},[756,1583,575],{"class":800},[756,1585,803],{"class":762},[756,1587,806],{"class":762},[756,1589,809],{"class":762},[756,1591,812],{"class":800},[756,1593,803],{"class":762},[756,1595,885],{"class":762},[756,1597,1598],{"class":758,"line":794},[756,1599,892],{"emptyLinePlaceholder":891},[756,1601,1602,1604,1606,1608,1610,1612,1614],{"class":758,"line":820},[756,1603,898],{"class":787},[756,1605,773],{"class":762},[756,1607,567],{"class":766},[756,1609,779],{"class":762},[756,1611,538],{"class":766},[756,1613,909],{"class":762},[756,1615,1616],{"class":912}," \u002F\u002F the existing customer id, if the email was already known\n",[658,1618],{},[496,1620,1622],{"id":1621},"create-a-customer-portal-session","Create a customer portal session",[492,1624,1625],{},[536,1626,1627],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[492,1629,1630],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[492,1632,1633,1634,1637],{},"Redirect the customer's browser to the returned ",[536,1635,1636],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[504,1639,706],{"id":1640},"optional-attributes-3",[509,1642,1643,1653],{},[512,1644,1645],{},[515,1646,1647,1649,1651],{},[518,1648,520],{},[518,1650,523],{},[518,1652,526],{},[528,1654,1655],{},[515,1656,1657,1662,1666],{},[533,1658,1659],{},[536,1660,1661],{},"returnUrl",[533,1663,1664],{},[536,1665,543],{},[533,1667,1668],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[492,1670,1671,1672,1675],{},"The returned ",[536,1673,1674],{},"PortalSession"," has three properties:",[509,1677,1678,1688],{},[512,1679,1680],{},[515,1681,1682,1684,1686],{},[518,1683,520],{},[518,1685,523],{},[518,1687,526],{},[528,1689,1690,1703,1717],{},[515,1691,1692,1696,1700],{},[533,1693,1694],{},[536,1695,1636],{},[533,1697,1698],{},[536,1699,543],{},[533,1701,1702],{},"Single-use HTTPS URL to redirect the customer to.",[515,1704,1705,1710,1714],{},[533,1706,1707],{},[536,1708,1709],{},"expiresAt",[533,1711,1712],{},[536,1713,543],{},[533,1715,1716],{},"Expiry of the one-time entry link (ISO 8601).",[515,1718,1719,1723,1727],{},[533,1720,1721],{},[536,1722,1661],{},[533,1724,1725],{},[536,1726,594],{},[533,1728,1729,1730,568],{},"The validated return URL you supplied, or ",[536,1731,1057],{},[747,1733,1735],{"className":749,"code":1734,"language":751,"meta":752,"style":752},"$session = $vatly->cus