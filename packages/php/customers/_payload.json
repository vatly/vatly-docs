{"class":702},[692,1506,715],{"class":698},[692,1508,718],{"class":702},[692,1510,715],{"class":698},[692,1512,724],{"class":723},[692,1514,1515],{"class":698},"([",[692,1517,739],{"class":698},[692,1519,511],{"class":736},[692,1521,739],{"class":698},[692,1523,742],{"class":698},[692,1525,745],{"class":698},[692,1527,748],{"class":736},[692,1529,739],{"class":698},[692,1531,821],{"class":698},[692,1533,1534],{"class":694,"line":730},[692,1535,828],{"emptyLinePlaceholder":827},[692,1537,1538,1540,1542,1544,1546,1548,1550],{"class":694,"line":756},[692,1539,834],{"class":723},[692,1541,709],{"class":698},[692,1543,503],{"class":702},[692,1545,715],{"class":698},[692,1547,474],{"class":702},[692,1549,845],{"class":698},[692,1551,1552],{"class":848}," \u002F\u002F the existing customer id, if the email was already known\n",[594,1554],{},[432,1556,1558],{"id":1557},"create-a-customer-portal-session","Create a customer portal session",[428,1560,1561],{},[472,1562,1563],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[428,1565,1566],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[428,1568,1569,1570,1573],{},"Redirect the customer's browser to the returned ",[472,1571,1572],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[440,1575,642],{"id":1576},"optional-attributes-3",[445,1578,1579,1589],{},[448,1580,1581],{},[451,1582,1583,1585,1587],{},[454,1584,456],{},[454,1586,459],{},[454,1588,462],{},[464,1590,1591],{},[451,1592,1593,1598,1602],{},[469,1594,1595],{},[472,1596,1597],{},"returnUrl",[469,1599,1600],{},[472,1601,479],{},[469,1603,1604],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[428,1606,1607,1608,1611],{},"The returned ",[472,1609,1610],{},"PortalSession"," has three properties:",[445,1613,1614,1624],{},[448,1615,1616],{},[451,1617,1618,1620,1622],{},[454,1619,456],{},[454,1621,459],{},[454,1623,462],{},[464,1625,1626,1639,1653],{},[451,1627,1628,1632,1636],{},[469,1629,1630],{},[472,1631,1572],{},[469,1633,1634],{},[472,1635,479],{},[469,1637,1638],{},"Single-use HTTPS URL to redirect the customer to.",[451,1640,1641,1646,1650],{},[469,1642,1643],{},[472,1644,1645],{},"expiresAt",[469,1647,1648],{},[472,1649,479],{},[469,1651,1652],{},"Expiry of the one-time entry link (ISO 8601).",[451,1654,1655,1659,1663],{},[469,1656,1657],{},[472,1658,1597],{},[469,1660,1661],{},[472,1662,530],{},[469,1664,1665,1666,504],{},"The validated return URL you supplied, or ",[472,1667,993],{},[683,1669,1671],{"className":685,"code":1670,"language":687,"meta":688,"style":688},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[472,1672,1673,1707,1726,1730,1734,1739],{"__ignoreMap":688},[692,1674,1675,1677,1680,1682,1684,1686,1688,1690,1692,1695,1697,1699,1701,1703,1705],{"class":694,"line":695},[692,1676,699],{"class":698},[692,1678,1679],{"class":702},"session ",[692,1681,706],{"class":698},[692,1683,709],{"class":698},[692,1685,712],{"class":702},[692,1687,715],{"class":698},[692,1689,718],{"class":702},[692,1691,715],{"class":698},[692,1693,1694],{"class":723},"createPortalSession",[692,1696,892],{"class":698},[692,1698,739],{"class":698},[692,1700,897],{"class":736},[692,1702,739],{"class":698},[692,1704,1043],{"class":698},[692,1706,787],{"class":698},[692,1708,1709,1711,1713,1715,1717,1719,1722,1724],{"class":694,"line":730},[692,1710,733],{"class":698},[692,1712,1597],{"class":736},[692,1714,739],{"class":698},[692,1716,742],{"class":698},[692,1718,745],{"class":698},[692,1720,1721],{"class":736},"https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling",[692,1723,739],{"class":698},[692,1725,753],{"class":698},[692,1727,1728],{"class":694,"line":756},[692,1729,821],{"class":698},[692,1731,1732],{"class":694,"line":776},[692,1733,828],{"emptyLinePlaceholder":827},[692,1735,1736],{"class":694,"line":790},[692,1737,1738],{"class":848},"\u002F\u002F Redirect the customer's browser to the hosted portal.\n",[692,1740,1741,1744,1746,1748,1751,1753,1756,1758,1761,1763,1765],{"class":694,"line":812},[692,1742,1743],{"class":723},"header",[692,1745,892],{"class":698},[692,1747,739],{"class":698},[692,1749,1750],{"class":736},"Location: ",[692,1752,739],{"class":698},[692,1754,1755],{"class":698}," .",[692,1757,709],{"class":698},[692,1759,1760],{"class":702},"session",[692,1762,715],{"class":698},[692,1764,1572],{"class":702},[692,1766,902],{"class":698},[428,1768,1769],{},"The body is optional — omit it to create a session without a return link:",[683,1771,1773],{"className":685,"code":1772,"language":687,"meta":688,"style":688},"$session = $vatly->customers->createPortalSession('customer_abc123');\n",[472,1774,1775],{"__ignoreMap":688},[692,1776,1777,1779,1781,1783,1785,1787,1789,1791,1793,1795,1797,1799,1801,1803],{"class":694,"line":695},[692,1778,699],{"class":698},[692,1780,1679],{"class":702},[692,1782,706],{"class":698},[692,1784,709],{"class":698},[692,1786,712],{"class":702},[692,1788,715],{"class":698},[692,1790,718],{"class":702},[692,1792,715],{"class":698},[692,1794,1694],{"class":723},[692,1796,892],{"class":698},[692,1798,739],{"class":698},[692,1800,897],{"class":736},[692,1802,739],{"class":698},[69