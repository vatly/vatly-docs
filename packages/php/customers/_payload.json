,1378,1380,1382,1384,1386,1388],{"class":552,"line":553},[550,1354,557],{"class":556},[550,1356,561],{"class":560},[550,1358,564],{"class":556},[550,1360,567],{"class":556},[550,1362,570],{"class":560},[550,1364,573],{"class":556},[550,1366,576],{"class":560},[550,1368,573],{"class":556},[550,1370,582],{"class":581},[550,1372,1373],{"class":556},"([",[550,1375,597],{"class":556},[550,1377,369],{"class":594},[550,1379,597],{"class":556},[550,1381,600],{"class":556},[550,1383,603],{"class":556},[550,1385,606],{"class":594},[550,1387,597],{"class":556},[550,1389,679],{"class":556},[550,1391,1392],{"class":552,"line":588},[550,1393,686],{"emptyLinePlaceholder":685},[550,1395,1396,1398,1400,1402,1404,1406,1408],{"class":552,"line":614},[550,1397,692],{"class":581},[550,1399,567],{"class":556},[550,1401,361],{"class":560},[550,1403,573],{"class":556},[550,1405,332],{"class":560},[550,1407,703],{"class":556},[550,1409,1410],{"class":706}," \u002F\u002F the existing customer id, if the email was already known\n",[452,1412],{},[290,1414,1416],{"id":1415},"create-a-customer-portal-session","Create a customer portal session",[286,1418,1419],{},[330,1420,1421],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[286,1423,1424],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[286,1426,1427,1428,1431],{},"Redirect the customer's browser to the returned ",[330,1429,1430],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[298,1433,500],{"id":1434},"optional-attributes-3",[303,1436,1437,1447],{},[306,1438,1439],{},[309,1440,1441,1443,1445],{},[312,1442,314],{},[312,1444,317],{},[312,1446,320],{},[322,1448,1449],{},[309,1450,1451,1456,1460],{},[327,1452,1453],{},[330,1454,1455],{},"returnUrl",[327,1457,1458],{},[330,1459,337],{},[327,1461,1462],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[286,1464,1465,1466,1469],{},"The returned ",[330,1467,1468],{},"PortalSession"," has three properties:",[303,1471,1472,1482],{},[306,1473,1474],{},[309,1475,1476,1478,1480],{},[312,1477,314],{},[312,1479,317],{},[312,1481,320],{},[322,1483,1484,1497,1511],{},[309,1485,1486,1490,1494],{},[327,1487,1488],{},[330,1489,1430],{},[327,1491,1492],{},[330,1493,337],{},[327,1495,1496],{},"Single-use HTTPS URL to redirect the customer to.",[309,1498,1499,1504,1508],{},[327,1500,1501],{},[330,1502,1503],{},"expiresAt",[327,1505,1506],{},[330,1507,337],{},[327,1509,1510],{},"Expiry of the one-time entry link (ISO 8601).",[309,1512,1513,1517,1521],{},[327,1514,1515],{},[330,1516,1455],{},[327,1518,1519],{},[330,1520,388],{},[327,1522,1523,1524,362],{},"The validated return URL you supplied, or ",[330,1525,851],{},[541,1527,1529],{"className":543,"code":1528,"language":545,"meta":546,"style":546},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[330,1530,1531,1565,1584,1588,1592,1597],{"__ignoreMap":546},[550,1532,1533,1535,1538,1540,1542,1544,1546,1548,1550,1553,1555,1557,1559,1561,1563],{"class":552,"line":553},[550,1534,557],{"class":556},[550,1536,1537],{"class":560},"session ",[550,1539,564],{"class":556},[550,1541,567],{"class":556},[550,1543,570],{"class":560},[550,1545,573],{"cla