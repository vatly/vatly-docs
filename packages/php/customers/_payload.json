34,"line":770},[732,1460,868],{"emptyLinePlaceholder":867},[732,1462,1463,1466,1469,1472,1475,1477,1479,1482,1485,1487],{"class":734,"line":796},[732,1464,1465],{"class":1318},"if",[732,1467,1468],{"class":738}," (",[732,1470,1471],{"class":763},"count",[732,1473,1474],{"class":738},"($",[732,1476,758],{"class":742},[732,1478,1334],{"class":738},[732,1480,1481],{"class":738}," >",[732,1483,1484],{"class":1403}," 0",[732,1486,1334],{"class":738},[732,1488,1337],{"class":738},[732,1490,1491,1493,1495,1497,1500,1503,1506,1508,1510],{"class":734,"line":816},[732,1492,1342],{"class":763},[732,1494,749],{"class":738},[732,1496,758],{"class":742},[732,1498,1499],{"class":738},"[",[732,1501,1502],{"class":1403},"0",[732,1504,1505],{"class":738},"]->",[732,1507,514],{"class":742},[732,1509,885],{"class":738},[732,1511,1512],{"class":888}," \u002F\u002F customer_abc123\n",[732,1514,1515],{"class":734,"line":830},[732,1516,1357],{"class":738},[468,1518,1519,1520,1523,1524,1527],{},"You can also recover in a single call by creating the customer again: create is\nget-or-create on the email, so posting a known address returns the existing\ncustomer (",[512,1521,1522],{},"200",") rather than a validation error, while a genuinely new address is\ncreated (",[512,1525,1526],{},"201","). Either way you get the customer back:",[723,1529,1531],{"className":725,"code":1530,"language":727,"meta":728,"style":728},"$customer = $vatly->customers->create(['email' => 'john@example.com']);\n\necho $customer->id; \u002F\u002F the existing customer id, if the email was already known\n",[512,1532,1533,1572,1576],{"__ignoreMap":728},[732,1534,1535,1537,1539,1541,1543,1545,1547,1549,1551,1553,1556,1558,1560,1562,1564,1566,1568,1570],{"class":734,"line":735},[732,1536,739],{"class":738},[732,1538,743],{"class":742},[732,1540,746],{"class":738},[732,1542,749],{"class":738},[732,1544,752],{"class":742},[732,1546,755],{"class":738},[732,1548,758],{"class":742},[732,1550,755],{"class":738},[732,1552,764],{"class":763},[732,1554,1555],{"class":738},"([",[732,1557,779],{"class":738},[732,1559,551],{"class":776},[732,1561,779],{"class":738},[732,1563,782],{"class":738},[732,1565,785],{"class":738},[732,1567,788],{"class":776},[732,1569,779],{"class":738},[732,1571,861],{"class":738},[732,1573,1574],{"class":734,"line":770},[732,1575,868],{"emptyLinePlaceholder":867},[732,1577,1578,1580,1582,1584,1586,1588,1590],{"class":734,"line":796},[732,1579,874],{"class":763},[732,1581,749],{"class":738},[732,1583,543],{"class":742},[732,1585,755],{"class":738},[732,1587,514],{"class":742},[732,1589,885],{"class":738},[732,1591,1592],{"class":888}," \u002F\u002F the existing customer id, if the email was already known\n",[634,1594],{},[472,1596,1598],{"id":1597},"create-a-customer-portal-session","Create a customer portal session",[468,1600,1601],{},[512,1602,1603],{},"POST \u002Fv1\u002Fcustomers\u002F:id\u002Fportal-sessions",[468,1605,1606],{},"Create a short-lived, single-use link that sends an authenticated customer\nstraight to your storefront in Vatly's hosted portal (where they can manage\ntheir subscriptions, billing details, and invoices). The session is locked to\nthe customer, storefront, merchant, and live\u002Ftest mode of the API token: the\ncustomer lands directly in that one storefront's portal — never a storefront\npicker or any other store. If your account has multiple storefronts, each API\ntoken mints portal links for its own store.",[468,1608,1609,1610,1613],{},"Redirect the customer's browser to the returned ",[512,1611,1612],{},"url",". It expires after roughly\n15 minutes and can be consumed once, so create a fresh one per visit. The link\nis credential-bearing — do not cache or log it.",[480,1615,682],{"id":1616},"optional-attributes-3",[485,1618,1619,1629],{},[488,1620,1621],{},[491,1622,1623,1625,1627],{},[494,1624,496],{},[494,1626,499],{},[494,1628,502],{},[504,1630,1631],{},[491,1632,1633,1638,1642],{},[509,1634,1635],{},[512,1636,1637],{},"returnUrl",[509,1639,1640],{},[512,1641,519],{},[509,1643,1644],{},"Absolute HTTPS URL (max 2048 bytes) rendered as a return link in the portal. Vatly never fetches or auto-redirects to it.",[468,1646,1647,1648,1651],{},"The returned ",[512,1649,1650],{},"PortalSession"," has three properties:",[485,1653,1654,1664],{},[488,1655,1656],{},[491,1657,1658,1660,1662],{},[494,1659,496],{},[494,1661,499],{},[494,1663,502],{},[504,1665,1666,1679,1693],{},[491,1667,1668,1672,1676],{},[509,1669,1670],{},[512,1671,1612],{},[509,1673,1674],{},[512,1675,519],{},[509,1677,1678],{},"Single-use HTTPS URL to redirect the customer to.",[491,1680,1681,1686,1690],{},[509,1682,1683],{},[512,1684,1685],{},"expiresAt",[509,1687,1688],{},[512,1689,519],{},[509,1691,1692],{},"Expiry of the one-time entry link (ISO 8601).",[491,1694,1695,1699,1703],{},[509,1696,1697],{},[512,1698,1637],{},[509,1700,1701],{},[512,1702,570],{},[509,1704,1705,1706,544],{},"The validated return URL you supplied, or ",[512,1707,1033],{},[723,1709,1711],{"className":725,"code":1710,"language":727,"meta":728,"style":728},"$session = $vatly->customers->createPortalSession('customer_abc123', [\n    'returnUrl' => 'https:\u002F\u002Fyourapp.com\u002Faccount\u002Fbilling',\n]);\n\n\u002F\u002F Redirect the customer's browser to the hosted portal.\nheader('Location: ' . $session->url);\n",[512,1712,1713,1747,1766,1770,1774,1779],{"__ignoreMap":728},[732,1714,1715,1717,1720,1722,1724,1726,1728,1730,1732,1735,1737,1739,1741,1743,1745],{"class":734,"line":735},[732,1716,739],{"class":738},[732,1718,1719],{"class":742},"session ",[732,1721,746],{"class":738},[732,1723,749],{"class":738},[732,1725,752],{"class":742},[732,1727,755],{"class":738},[732,1729,758],{"class":742},[732,1731,755],{"class":738},[732,1733,1734],{"class":763},"createPortalSession",[732,1736,932],{"class":738},[732,1738,779],{"class":738},[732,1740,937],{"class":776},[732,1742,779],{"class":738},[732,1744,1083],{"class":738},[732,1746,827],{"class":738},[732,174