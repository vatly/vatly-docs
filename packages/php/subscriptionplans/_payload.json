97,592],{}," object — read ",[537,600,601],{},"->value"," (decimal string) and ",[537,604,605],{},"->currency"," (ISO 4217 code).",[516,608,609,614,618],{},[534,610,611],{},[537,612,613],{},"taxBehavior",[534,615,616],{},[537,617,544],{},[534,619,620,621,623,624,627,628,631,632,635],{},"Whether ",[537,622,587],{}," is tax-",[537,625,626],{},"exclusive"," (B2B) or tax-",[537,629,630],{},"inclusive"," (B2C). Immutable after creation. See ",[537,633,634],{},"Vatly\\API\\Types\\TaxBehavior",".",[516,637,638,643,647],{},[534,639,640],{},[537,641,642],{},"interval",[534,644,645],{},[537,646,544],{},[534,648,649,650,653,654,653,657,660,661,635],{},"Billing interval: ",[537,651,652],{},"day",", ",[537,655,656],{},"week",[537,658,659],{},"month",", or ",[537,662,663],{},"year",[516,665,666,671,676],{},[534,667,668],{},[537,669,670],{},"intervalCount",[534,672,673],{},[537,674,675],{},"integer",[534,677,678],{},"Number of intervals between billings.",[516,680,681,686,690],{},[534,682,683],{},[537,684,685],{},"productType",[534,687,688],{},[537,689,544],{},[534,691,692,693,696],{},"Tax classification. Always ",[537,694,695],{},"saas"," for plans.",[516,698,699,704,709],{},[534,700,701],{},[537,702,703],{},"testmode",[534,705,706],{},[537,707,708],{},"bool",[534,710,711],{},"Whether this is a test plan.",[516,713,714,719,723],{},[534,715,716],{},[537,717,718],{},"status",[534,720,721],{},[537,722,544],{},[534,724,725,726,729,730,733,734,635],{},"The status: ",[537,727,728],{},"active"," (subscribable), ",[537,731,732],{},"pending"," (awaiting approval), or ",[537,735,736],{},"rejected",[516,738,739,744,748],{},[534,740,741],{},[537,742,743],{},"archivedAt",[534,745,746],{},[537,747,577],{},[534,749,750,751,754,755,758],{},"When the plan was archived (ISO 8601), or ",[537,752,753],{},"null"," while it is open to new business. Use ",[537,756,757],{},"$plan->isArchived()"," for a boolean.",[516,760,761,766,771],{},[534,762,763],{},[537,764,765],{},"pendingUpdates",[534,767,768],{}