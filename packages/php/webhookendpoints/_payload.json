7,1432,1435,1486],[472,473,474,475,479,480,484],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[476,477,478],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[481,482,483],"code",{},"422",".",[472,486,487,488,491,492,501,502,505],{},"Each endpoint has its own ",[481,489,490],{},"enabledEvents"," set — the public event names it receives\n(see ",[493,494,498],"a",{"href":495,"rel":496},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[497],"nofollow",[481,499,500],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[481,503,504],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[472,507,508,509,512,513,516,517,520,521,523],{},"The signing ",[481,510,511],{},"secret"," is ",[476,514,515],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[481,518,519],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[493,522,50],{"href":159},").",[525,526,528],"h2",{"id":527},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[472,530,531],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[533,534,536],"h3",{"id":535},"properties","Properties",[538,539,540,556],"table",{},[541,542,543],"thead",{},[544,545,546,550,553],"tr",{},[547,548,549],"th",{},"Name",[547,551,552],{},"Type",[547,554,555],{},"Description",[557,558,559,578,595,610,624,641,655],"tbody",{},[544,560,561,567,572],{},[562,563,564],"td",{},[481,565,566],{},"id",[562,568,569],{},[481,570,571],{},"string",[562,573,574,575,523],{},"Unique identifier for the endpoint (",[481,576,577],{},"webhook_...",[544,579,580,585,589],{},[562,581,582],{},[481,583,584],{},"resource",[562,586,587],{},[481,588,571],{},[562,590,591,592,484],{},"Resource type, always ",[481,593,594],{},"webhook_endpoint",[544,596,597,602,607],{},[562,598,599],{},[481,600,601],{},"testmode",[562,603,604],{},[481,605,606],{},"bool",[562,608,609],{},"Whether this endpoint receives test-mode events.",[544,611,612,617,621],{},[562,613,614],{},[481,615,616],{},"url",[562,618,619],{},[481,620,571],{},[562,622,623],{},"The HTTPS URL deliveries are POSTed to.",[544,625,626,630,635],{},[562,627,628],{},[481,629,490],{},[562,631,632],{},[481,633,634],{},"string[]",[562,636,637,638,640],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[481,639,504],{}," is still sent.",[544,642,643,648,652],{},[562,644,645],{},[481,646,647],{},"createdAt",[562,649,650],{},[481,651,571],{},[562,653,654],{},"Creation timestamp (ISO 8601).",[544,656,657,662,667],{},[562,658,659],{},[481,660,661],{},"links",[562,663,664],{},[481,665,666],{},"WebhookEndpointLinks",[562,668,669,670,523],{},"HATEOAS links (",[481,671,672],{},"self",[674,675],"hr",{},[525,677,679],{"id":678},"register-a-webhook-endpoint","Register a webhook endpoint",[472,681,682],{},[481,683,684],{},"POST \u002Fv1\u002Fwebhook-endpoints",[472,686,687,688,690,691,484],{},"Register an endpoint for the token's mode. Vatly sends a ",[481,689,504],{},"\nverification ping and validates the URL's SSL certificate; if either fails,\nregistration is rejected with ",[481,692,483],{},[533,694,696],{"id":695},"required-attributes","Required attributes",[538,698,699,709],{},[541,700,701],{},[544,702,703,705,707],{},[547,704,549],{},[547,706,552],{},[547,708,555],{},[557,710,711,728],{},[544,712,713,717,721],{},[562,714,715],{},[481,716,616],{},[562,718,719],{},[481,720,571],{},[562,722,723,724,727],{},"Publicly reachable HTTPS URL with a valid SSL certificate. ",[481,725,726],{},"localhost","\u002Floopb