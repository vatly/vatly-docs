est and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[432,433,434],"code",{},"422",".",[423,437,438,439,442,443,452,453,456],{},"Each endpoint has its own ",[432,440,441],{},"enabledEvents"," set — the public event names it receives\n(see ",[444,445,449],"a",{"href":446,"rel":447},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[448],"nofollow",[432,450,451],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[432,454,455],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[423,458,459,460,463,464,467,468,471,472,474],{},"The signing ",[432,461,462],{},"secret"," is ",[427,465,466],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[432,469,470],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[444,473,50],{"href":157},").",[476,477,479],"h2",{"id":478},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[423,481,482],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[484,485,487],"h3",{"id":486},"properties","Properties",[489,490,491,507],"table",{},[492,493,494],"thead",{},[495,496,497,501,504],"tr",{},[498,499,500],"th",{},"Name",[498,502,503],{},"Type",[498,505,506],{},"Description",[508,509,510,529,546,561,575,592,606],"tbody",{},[495,511,512,518,523],{},[513,514,515],"td",{},[432,516,517],{},"id",[513,519,520],{},[432,521,522],{},"string",[513,524,525,526,474],{},"Unique identifier for the endpoint (",[432,527,528],{},"webhook_...",[495,530,531,536,540],{},[513,532,533],{},[432,534,535],{},"resource",[513,537,538],{},[432,539,522],{},[513,541,542,543,435],{},"Resource type, always ",[432,544,545],{},"webhook_endpoint",[495,547,548,553,558],{},[513,549,550],{},[432,551,552],{},"testmode",[513,55