e, never returned.\nStore the value you send — you use it to verify the ",[260,297,298],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[272,301,46],{"href":154},").",[304,305,307],"h2",{"id":306},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[251,309,310],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[312,313,315],"h3",{"id":314},"properties","Properties",[317,318,319,335],"table",{},[320,321,322],"thead",{},[323,324,325,329,332],"tr",{},[326,327,328],"th",{},"Name",[326,330,331],{},"Type",[326,333,334],{},"Description",[336,337,338,357,374,389,403,420,434],"tbody",{},[323,339,340,346,351],{},[341,342,343],"td",{},[260,344,345],{},"id",[341,347,348],{},[260,349,350],{},"string",[341,352,353,354,302],{},"Unique identifier for the endpoint (",[260,355,356],{},"webhook_...",[323,358,359,364,368],{},[341,360,361],{},[260,362,363],{},"resource",[341,365,366],{},[260,367,350],{},[341,369,370,371,263],{},"Resource type, always ",[260,372,373],{},"webhook_endpoint",[323,375,376,381,386],{},[341,377,378],{},[260,379,380],{},"testmode",[341,382,383],{},[260,384,385],{},"bool",[341,387,388],{},"Whether this endpoint receives test-mode events.",[323,390,391,396,400],{},[341,392,393],{},[260,394,395],{},"url",[341,397,398],{},[260,399,350],{},[341,401,402],{},"The HTTPS URL deliveries are POSTed to.",[323,404,405,409,414],{},[341,406,407],{},[260,408,269],{},[341,410,411],{},[260,412,413],{},"string[]",[341,415,416,417,419],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[260,418,283],{}," is still sent.",[323,421,422,427,431],{},[341,423,424],{},[260,425,426],{},"createdAt",[341,428,429],{},[260,430,350],{},[341,432,433],{},"Creation timestamp (ISO 8601).",[323,435,436,441,446],{},[341,437,438],{},[260,439,440],{},"links",[341,442,443],{},[260,444,445],{},"WebhookEndpointLinks",[341,447,448,449,302],{},"HATEOAS links (",[260,450,451],{},"self",[453,454],"hr",{},[304,456,458