nature"," HMAC on\ndeliveries (see ",[513,542,50],{"href":159},").",[545,546,548],"h2",{"id":547},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[492,550,551],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[553,554,556],"h3",{"id":555},"properties","Properties",[558,559,560,576],"table",{},[561,562,563],"thead",{},[564,565,566,570,573],"tr",{},[567,568,569],"th",{},"Name",[567,571,572],{},"Type",[567,574,575],{},"Description",[577,578,579,598,615,630,644,661,675],"tbody",{},[564,580,581,587,592],{},[582,583,584],"td",{},[501,585,586],{},"id",[582,588,589],{},[501,590,591],{},"string",[582,593,594,595,543],{},"Unique identifier for the endpoint (",[501,596,597],{},"webhook_...",[564,599,600,605,609],{},[582,601,602],{},[501,603,604],{},"resource",[582,606,607],{},[501,608,591],{},[582,610,611,612,504],{},"Resource type, always ",[501,613,614],{},"webhook_endpoint",[564,616,617,622,627],{},[582,618,619],{},[501,620,621],{},"testmode",[582,623,624],{},[501,625,626],{},"bool",[582,628,629],{},"Whether this endpoint receives test-mode events.",[564,631,632,637,641],{},[582,633,634],{},[501,635,636],{},"url",[582,638,639],{},[501,640,591],{},[582,642,643],{},"The HTTPS URL deliveries are POSTed to.",[564,645,646,650,655],{},[582,647,648],{},[501,649,510],{},[582,651,652],{},[501,653,654],{},"string[]",[582,656,657,658,660],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[501,659,524],{}," is still sent.",[564,662,663,668,672],{},[582,664,665],{},[501,666,667],{},"createdAt",[582,669,670],{},[501,671,591],{},[582,673,674],{},"Creation timestamp (ISO 8601).",[564,676,677,682,687],{},[582,678,679],{},[501,680,681],{},"links",[582,683,684],{},[501,685,686],{},"WebhookEndpointLinks",[582,688,689,690,543],{},"HATEOAS links (",[501,691,692],{},"self",[694,695],"hr",{},[545,697,699],{"id":698},"register-a-webhook-endpoint","Register a webhook endpoint",[492,701,702],{},[501,703,70