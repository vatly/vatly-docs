\u002F2.bolt",{"id":479,"title":72,"body":480,"description":1517,"extension":1518,"links":1519,"meta":1520,"navigation":1521,"path":163,"seo":1522,"stem":164,"__hash__":1523},"docs\u002F3.packages\u002F1.php\u002F11.webhookendpoints.md",{"type":481,"value":482,"toc":1502},"minimark",[483,497,518,536,541,544,549,685,688,692,697,705,709,753,757,794,1008,1010,1014,1019,1022,1078,1080,1084,1089,1092,1170,1172,1176,1181,1193,1196,1259,1382,1389,1433,1435,1439,1444,1447,1498],[484,485,486,487,491,492,496],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[488,489,490],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[493,494,495],"code",{},"422",".",[484,498,499,500,503,504,513,514,517],{},"Each endpoint has its own ",[493,501,502],{},"enabledEvents"," set — the public event names it receives\n(see ",[505,506,510],"a",{"href":507,"rel":508},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[509],"nofollow",[493,511,512],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[493,515,516],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[484,519,520,521,524,525,528,529,532,533,535],{},"The signing ",[493,522,523],{},"secret"," is ",[488,526,527],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[493,530,531],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[505,534,50],{"href":159},").",[537,538,540],"h2",{"id":539},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[484,542,543],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",