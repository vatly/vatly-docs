es\u002F2.laravel\u002F6.comparison",{"title":187,"path":188,"stem":189},"Migrating from Cashier","\u002Fpackages\u002Flaravel\u002Fmigrating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":191,"path":192,"stem":193},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":195,"path":196,"stem":197},"Integrations","\u002Fintegrations","4.integrations",{"id":199,"title":68,"body":200,"description":1236,"extension":1237,"links":1238,"meta":1239,"navigation":559,"path":157,"seo":1240,"stem":158,"__hash__":1241},"docs\u002F3.packages\u002F1.php\u002F99.webhookendpoints.md",{"type":201,"value":202,"toc":1221},"minimark",[203,217,238,256,261,264,269,405,408,412,417,425,429,473,477,514,727,729,733,738,741,797,799,803,808,811,889,891,895,900,912,915,978,1101,1108,1152,1154,1158,1163,1166,1217],[204,205,206,207,211,212,216],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[208,209,210],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[213,214,215],"code",{},"422",".",[204,218,219,220,223,224,233,234,237],{},"Each endpoint has its own ",[213,221,222],{},"enabledEvents"," set — the public event names it receives\n(see ",[225,226,230],"a",{"href":227,"rel":228},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[229],"nofollow",[213,231,232],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[213,235,236],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[204,239,240,241,244,245,248,249,252,253,255],{},"The signing ",[213,242,243],{},"secret"," is ",[208,246,247],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[213,250,251],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[225,254,46],{"href":154},").",[257,258,260],"h2",{"id":259},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[204,262,263],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[265,266,268],"h3",{"id":267},"properties","Properties",[270,271,272,288],"table",{},[273,274,275],"thead",{},[276,277,278,282,285],"tr",{},[279,280,281],"th",{},"Name",[279,283,284],{},"Type",[279,286,287],{},"Description",[289,290,291,310,327,342,356,373,387],"tbody",{},[276,292,293,299,304],{},[294,295,296],"td",{},[213,297,298],{},"id",[294,300,301],{},[213,302,303],{},"string",[294,305,306,307,255],{},"Unique identifier for the endpoint (",[213,308,309],{},"webhook_...",[276,311,312,317,321],{},[294,313,314],{},[213,315,316],{},"resource",[294,318,319],{},[213,320,303],{},[294,322,323,324,216],{},"Resource type, always ",[213,325,326],{},"webhook_endpoint",[276,328,329,334,339],{},[294,330,331],{},[213,332,333],{},"testmode",[294,335,336],{},[213,337,338],{},"bool",[294,340,341],{},"Whether this endpoint receives test-mode events.",[276,343,344,349,353],{},[294,345,346],{},[213,347,348],{},"url",[294,350,351],{},[213,352,303],{},[294,354,355],{},"The HTTPS URL deliveries are POSTed to.",[276,357,358,362,367],{},[294,359,360],{},[213,361,222],{},[294,363,364],{},[213,365,366],{},"string[]",[294,368,369,370,372],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[213,371,236],{}," is still sent.",[276,374,375,380,384],{},[294,376,377],{},[213,378,379],{},"createdAt",[294,381,382],{},[213,383,303],{},[294,385,386],{},"Creation timestamp (ISO 8601).",[276,388,389,394,399],{},[294,390,391],{},[213,392,393],{},"links",[294,395,396],{},[213,397,398],{},"WebhookEndpointLinks",[294,400,401,402,255],{},"HATEOAS li