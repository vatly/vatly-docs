[471,472,473,474,478,479,483],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[475,476,477],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[480,481,482],"code",{},"422",".",[471,485,486,487,490,491,500,501,504],{},"Each endpoint has its own ",[480,488,489],{},"enabledEvents"," set — the public event names it receives\n(see ",[492,493,497],"a",{"href":494,"rel":495},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[496],"nofollow",[480,498,499],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[480,502,503],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[471,506,507,508,511,512,515,516,519,520,522],{},"The signing ",[480,509,510],{},"secret"," is ",[475,513,514],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[480,517,518],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[492,521,50],{"href":158},").",[524,525,527],"h2",{"id":526},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[471,529,530],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[532,533,535],"h3",{"id":534},"properties","Properties",[537,538,539,555],"table",{},[540,541,542],"thead",{},[543,544,545,549,552],"tr",{},[546,547,548],"th",{},"Name",[546,550,551],{},"Type",[546,553,554],{},"Description",[556,557,558,577,594,609,623,640,654],"tbody",{},[543,559,560,566,571],{},[561,562,563],"td",{},[480,564,565],{},"id",[561,567,568],{},[480,569,570],{},"string",[561,572,573,574,522],{},"Unique identifier for the endpoint (",[480,575,576],{},"webhook_...",[543,578,579,584,588],{},[561,580,581],{},[480,582,583],{},"resource",[561,585,586],{},[480,587,570],{},[561,589,590,591,483],{},"Resource type, always ",[480,592,593],{},"webhook_endpoint",[543,595,596,601,606],{},[561,597,598],{},[480,599,600],{},"testmode",[561,602,603],{},[480,604,605],{},"bool",[561,607,608],{},"Whether this endpoint receives test-mode events.",[543,610,611,616,620],{},[561,612,613],{},[480,614,615],{},"url",[561,617,618],{},[480,619,570],{},[561,621,622],{},"The HTTPS URL deliveries are POSTed to.",[543,624,625,629,634],{},[561,626,627],{},[480,628,489],{},[561,630,631],{},[480,632,633],{},"string[]",[561,635,636,637,639],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[480,638,503],{}," is still sent.",[543,641,642,647,651],{},[561,643,644],{},[480,645,646],{},"createdAt",[561,648,649],{},[480,650,570],{},[561,652,653],{},"Creation timestamp (ISO 8601).",[543,655,656,661,666],{},[561,657,658],{},[480,659,660],{},"links",[561,662,663],{},[480,664,665],{},"WebhookEndpointLinks",[561,667,668,669,522],{},"HATEOAS links (",[480,670,671],{},"self",[673,674],"hr",{},[524,676,678],{"id":677},"register-a-webhook-endpoint","Register a webhook endpoint",[471,680,681],{},[480,682,683],{},"POST \u002Fv1\u002Fwebhook-endpoints",[471,685,686,687,689,690,483],{},"Register an endpoint for the token's mode. Vatly sends a ",[480,688,503],{},"\nverification ping and validates the URL's SSL certificate; if either fails,\nregistration is rejected with ",[480,691,482],{},[532,693,695],{"id":694},"required-attributes","Required attributes",[537,697,698,708],{},[540,699,700],{},[543,701,702,704,706],{},[546,703,548],{},[546,705,551],{},[546,707,554],{},[556,709,710,727],{},[543,711,712,716,720],{},[561,713,714],{},[480,715,615],{},[561,717,718],{},[480,719,570],{},[561,721,722,723,726],{},"Publicly reachable HTTPS URL with a valid SSL certificate. ",[480,724,725],{},"localhost","\u002Floopback addresses are 