442],[428,429,430,431,435,436,440],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[432,433,434],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[437,438,439],"code",{},"422",".",[428,442,443,444,447,448,457,458,461],{},"Each endpoint has its own ",[437,445,446],{},"enabledEvents"," set — the public event names it receives\n(see ",[449,450,454],"a",{"href":451,"rel":452},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[453],"nofollow",[437,455,456],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[437,459,460],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[428,463,464,465,468,469,472,473,476,477,479],{},"The signing ",[437,466,467],{},"secret"," is ",[432,470,471],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[437,474,475],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[449,478,50],{"href":157},").",[481,482,484],"h2",{"id":483},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[428,486,487],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[489,490,492],"h3",{"id":491},"properties","Properties",[494,495,496,512],"table",{},[497,498,499],"thead",{},[500,501,502,506,509],"tr",{},[503,504,505],"th",{},"Name",[503,507,508],{},"Type",[503,510,511],{},"Description",[513,514,515,534,551,566,580,597,611],"tbody",{},[500,516,517,523,528],{},[518,519,520],"td",{},[437,521,522],{},"id",[518,524,525],{},[437,526,527],{},"string",[518,529,530,531,479],{},"Unique identifier for the endpoint (",[437,532,533],{},"webhook_...",[500,535,536,541,545],{},[518,537,538],{},[437,539,540],{},"resource",[518,542,543],{},[437,544,527],{},[518,546,547,548,440],{},"Resource type, always ",[437,549,550],{},"webhook_endpoint",[500,552,553,558,563],{},[518,554,555],{},[437,556,557],{},"testmode",[518,559,560],{},[437,561,562],{},"bool",[518,564,565],{},"Whether this endpoint receives test-mode events.",[500,567,568,573,577],{},[518,569,570],{},[437,571,572],{},"url",[518,574,575],{},[437,576,527],{},[518,578,579],{},"The HTTPS URL deliveries are POSTed to.",[500,581,582,586,591],{},[518,583,584],{},[437,585,446],{},[518,587,588],{},[437,589,590],{},"string[]",[518,592,593,594,596],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[437,595,460],{}," is still sent.",[500,598,599,604,608],{},[518,600,601],{},[437,602,603],{},"createdAt",[518,605,606],{},[437,607,527],{},[518,609,610],{},"Creation timestamp (ISO 8601).",[500,612,613,618,623],{},[518,614,615],{},[437,616,617],{},"links",[518,619,620],{},[437,621,622],{},"WebhookEndpointLinks",[518,624,625,626,479],{},"HATEOAS links (",[437,627,628],{},"self",[630,631],"hr",{},[481,633,635],{"id":634},"register-a-webhook-endpoint","Register a webhook endpoint",[428,637,638],{},[437,639,640],{},"POST \u002Fv1\u002Fwebhook-endpoints",[428,642,643,644,646,647,440],{},"Register an endpoint for the token's mode. Vatly sends a ",[437,645,460],{},"\nverification ping and validates the URL's SSL certificate; if either fails,\nregistration is rejected with ",[437,648,439],{},[489,650,652],{"id":651},"required-attributes","Required attributes",[494,654,655,665],{},[497,656,657],{},[500,658,659,661,663],{},[503,660,505],{},[503,662,508],{},[503,664,511],{},[513,666,667,684],{},[500,668,669,673,677],{},[518,670,671],{},[437,672,572],{},[518,674,675],{},[437,676,527],{},[518,678,679,680,683],{},"Publicly reachable HTTPS URL with a valid SSL certificate. ",[437,681,682],{},"localhost","\u002Floopback addresses