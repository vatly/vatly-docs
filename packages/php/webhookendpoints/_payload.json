he ",[209,246,247],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[221,250,42],{"href":150},").",[253,254,256],"h2",{"id":255},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[200,258,259],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[261,262,264],"h3",{"id":263},"properties","Properties",[266,267,268,284],"table",{},[269,270,271],"thead",{},[272,273,274,278,281],"tr",{},[275,276,277],"th",{},"Name",[275,279,280],{},"Type",[275,282,283],{},"Description",[285,286,287,306,323,338,352,369,383],"tbody",{},[272,288,289,295,300],{},[290,291,292],"td",{},[209,293,294],{},"id",[290,296,297],{},[209,298,299],{},"string",[290,301,302,303,251],{},"Unique identifier for the endpoint (",[209,304,305],{},"webhook_...",[272,307,308,313,317],{},[290,309,310],{},[209,311,312],{},"resource",[290,314,315],{},[209,316,299],{},[290,318,319,320,212],{},"Resource type, always ",[209,321,322],{},"webhook_endpoint",[272,324,325,330,335],{},[290,326,327],{},[209,328,329],{},"testmode",[290,331,332],{},[209,333,334],{},"bool",[290,336,337],{},"Whether this endpoint receives test-mode events.",[272,339,340,345,349],{},[290,341,342],{},[209,343,344],{},"url",[290,346,347],{},[209,348,299],{},[290,350,351],{},"The HTTPS URL deliveries are POSTed to.",[272,353,354,358,363],{},[290,355,356],{},[209,357,218],{},[290,359,360],{},[209,361,362],{},"string[]",[290,364,365,366,368],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[209,367,232],{}," is still sent.",[272,370,371,376,380],{},[290,372,373],{},[209,374,375],{},"createdAt",[290,377,378],{},[209,379,299],{},[290,381,382],{},"Creation timestamp (ISO 8601).",[272,384,385,390,395],{},[290,386,387],{},[209,388,389],{},"links",[290,391,392],{},[209,393,394],{},"WebhookEndpointLinks",[290,396,397,398,251],{},"HATEOAS links (",[209,399,400],{},"self",[402,403],"hr",{},[253,405,407],{"id":406},"register-a-webhook-endpoint","Register a webhook endpoi