uration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":187,"path":188,"stem":189},"Integrations","\u002Fintegrations","4.integrations",{"id":191,"title":60,"body":192,"description":1228,"extension":1229,"links":1230,"meta":1231,"navigation":551,"path":149,"seo":1232,"stem":150,"__hash__":1233},"docs\u002F3.packages\u002F1.php\u002F99.webhookendpoints.md",{"type":193,"value":194,"toc":1213},"minimark",[195,209,230,248,253,256,261,397,400,404,409,417,421,465,469,506,719,721,725,730,733,789,791,795,800,803,881,883,887,892,904,907,970,1093,1100,1144,1146,1150,1155,1158,1209],[196,197,198,199,203,204,208],"p",{},"A webhook endpoint is the HTTPS URL Vatly POSTs event deliveries to — registered\nfrom code (or infrastructure-as-code) rather than the dashboard. A storefront can\nhave ",[200,201,202],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[205,206,207],"code",{},"422",".",[196,210,211,212,215,216,225,226,229],{},"Each endpoint has its own ",[205,213,214],{},"enabledEvents"," set — the public event names it receives\n(see ",[217,218,222],"a",{"href":219,"rel":220},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[221],"nofollow",[205,223,224],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[205,227,228],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[196,231,232,233,236,237,240,241,244,245,247],{},"The signing ",[205,234,235],{},"secret"," is ",[200,238,239],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[205,242,243],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[217,246,38],{"href":146},").",[249,250,252],"h2",