-as-code) rather than the dashboard. A storefront can\nhave ",[472,473,474],"strong",{},"up to five endpoints per mode"," (test and live are set by the API token),\neach with a URL unique within that storefront and mode. A duplicate URL or a sixth\nendpoint is rejected with ",[477,478,479],"code",{},"422",".",[468,482,483,484,487,488,497,498,501],{},"Each endpoint has its own ",[477,485,486],{},"enabledEvents"," set — the public event names it receives\n(see ",[489,490,494],"a",{"href":491,"rel":492},"https:\u002F\u002Fgithub.com\u002FVatly\u002Fvatly-api-php\u002Fblob\u002Fmain\u002Fsrc\u002FAPI\u002FTypes\u002FWebhookSubscriptionEventName.php",[493],"nofollow",[477,495,496],{},"WebhookSubscriptionEventName",").\nAn empty set makes it dormant; ",[477,499,500],{},"webhook.setup"," is never subscribable and is always\nsent when Vatly verifies the endpoint.",[468,503,504,505,508,509,512,513,516,517,519],{},"The signing ",[477,506,507],{},"secret"," is ",[472,510,511],{},"write-only",": sent on create\u002Fupdate, never returned.\nStore the value you send — you use it to verify the ",[477,514,515],{},"Vatly-Signature"," HMAC on\ndeliveries (see ",[489,518,50],{"href":158},").",[521,522,524],"h2",{"id":523},"the-webhookendpoint-resource","The WebhookEndpoint Resource",[468,526,527],{},"Below you'll find all properties for the Vatly WebhookEndpoint resource.",[529,530,532],"h3",{"id":531},"properties","Properties",[534,535,536,552],"table",{},[537,538,539],"thead",{},[540,541,542,546,549],"tr",{},[543,544,545],"th",{},"Name",[543,547,548],{},"Type",[543,550,551],{},"Description",[553,554,555,574,591,606,620,637,651],"tbody",{},[540,556,557,563,568],{},[558,559,560],"td",{},[477,561,562],{},"id",[558,564,565],{},[477,566,567],{},"string",[558,569,570,571,519],{},"Unique identifier for the endpoint (",[477,572,573],{},"webhook_...",[540,575,576,581,585],{},[558,577,578],{},[477,579,580],{},"resource",[558,582,583],{},[477,584,567],{},[558,586,587,588,480],{},"Resource type, always ",[477,589,590],{},"webhook_endpoint",[540,592,593,598,603],{},[558,594,595],{},[477,596,597],{},"testmode",[558,599,600],{},[477,601,602],{},"bool",[558,604,605],{},"Whether this endpoint receives test-mode events.",[540,607,608,613,617],{},[558,609,610],{},[477,611,612],{},"url",[558,614,615],{},[477,616,567],{},[558,618,619],{},"The HTTPS URL deliveries are POSTed to.",[540,621,622,626,631],{},[558,623,624],{},[477,625,486],{},[558,627,628],{},[477,629,630],{},"string[]",[558,632,633,634,636],{},"The event names this endpoint is subscribed to. An empty array means dormant (no domain events); ",[477,635,500],{}," is still sent.",[540,638,639,644,648],{},[558,640,641],{},[477,642,643],{},"createdAt",[558,645,646],{},[477,647,567],{},[558,649,650],{},"Creation timestamp (ISO 8601).",[540,652,653,658,663],{},[558,654,655],{},[477,656,657],{},"links",[558,659,660],{},[477,661,662],{},"WebhookEndpointLinks",[558,664,665,666,519],{},"HATEOAS links (",[477,667,668],{},"self",[670,671],"hr",{},[521,673,675],{"id":674},"register-a-webhook-endpoint","Register a webhook endpoint",[468,677,678],{},[477,679,680],{},"POST \u002Fv1\u002Fwebhook-endpoints",[468,682,683,684,686,687,480],{},"Register an endpoint for the token's mode. Vatly sends a ",[477,685,500],{},"\nverification ping and validates the URL's SSL certificate; if either fails,\nregistration is rejected with ",[477,688,479],{},[529,690,692],{"id":691},"required-attributes","Required attributes",[534,694,695,705],{},[537,696,697],{},[540,698,699,701,703],{},[543,700,545],{},[543,702,548],{},[543,704,551],{},[553,706,707,724],{},[540,708,709,713,717],{},[558,710,711],{},[477,712,612],{},[558,714,715],{},[477,716,567],{},[558,718,719,720,723],{},"Publicly reachable HTTPS URL with a valid SSL certificate. ",[477,721,722],{},"localhost","\u002Floopback addresses are not allowed.",[540,725,726,730,734],{},[558,727,728],{},[477,729,507],{},[558,731,732],{},[477,733,567],{},[558,735,736],{},"Signing secret (min 10 