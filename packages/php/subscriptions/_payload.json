1176],{},[248,1177,388],{},[245,1179,1180],{},[248,1181,393],{},[245,1183,1184,1185,1188],{},"The ",[1127,1186,1187],{},"new total"," quantity (e.g. number of seats). This sets the quantity to the given value — it is not added to the current quantity.",[227,1190,1191,1195,1200],{},[245,1192,1193],{},[248,1194,1136],{},[245,1196,1197],{},[248,1198,1199],{},"array",[245,1201,1202,1203,1206,1207,1210,1211,1213,1214,1216],{},"Override the recurring price: ",[248,1204,1205],{},"['value' => '99.99', 'currency' => 'EUR']",". The ",[248,1208,1209],{},"currency"," must match the subscription's currency. Provide ",[248,1212,1136],{}," alone to change the price in place, or combine it with ",[248,1215,301],{}," to switch plans at a custom price (overriding the new plan's default).",[227,1218,1219,1224,1228],{},[245,1220,1221],{},[248,1222,1223],{},"prorate",[245,1225,1226],{},[248,1227,320],{},[245,1229,1230,1231,1234,1235,1237,1238,1241,1242,1247,1248,1251,1252,1254,1255,280],{},"How an immediate change is priced (default ",[248,1232,1233],{},"true","). ",[248,1236,1233],{}," charges the new price for the time left on the cycle, minus a credit for the old price over that same time. ",[248,1239,1240],{},"false"," charges the full new price for the current cycle on top of what was already paid. ",[1127,1243,1244,1246],{},[248,1245,1240],{}," does not skip the charge:"," use ",[248,1249,1250],{},"prorationCharge"," for that. Ignored when ",[248,1253,1250],{}," is ",[248,1256,1240],{},[227,1258,1259,1263,1267],{},[245,1260,1261],{},[248,1262,1250],{},[245,1264,1265],{},[248,1266,320],{},[245,1268,1269,1270,1272,1273,1275,1276,414,1279,414,1282,414,1285,1287,1288,1290,1291,280],{},"Whether an immediate change is charged at all (default ",[248,1271,1233],{},"). With ",[248,1274,1240],{},", the change applies now and nothing is charged for it: a downgrade gets no credit. The next renewal bills the new price, unless a change is already scheduled for that renewal: that change still applies. During a trial, the trial keeps running and its end bills the new plan. Sending ",[248,1277,1278],{},"invoiceImmediately: true",[248,1280,1281],{},"anchor",[248,1283,1284],{},"resetAnchor",[248,1286,581],{}," or a plan with a different interval with ",[248,1289,1240],{}," returns ",[248,1292,1293],{},"422",[227,1295,1296,1301,1305],{},[245,1297,1298],{},[248,1299,1300],{},"applyImmediately",[245,1302,1303],{},[248,1304,320],{},[245,1306,1307,1308,1310,1311,1313],{},"Apply the change now (",[248,1309,1233],{},") or at the end of the current period (",[248,1312,1240],{},", default).",[227,1315,1316,1321,1325],{},[245,1317,1318],{},[248,1319,1320],{},"invoiceImmediately",[245,1322,1323],{},[248,1324,320],{},[245,1326,1327,1328,1330,1331,1333,1334,1336,1337,1339,1340,1346],{},"Generate and charge a proration invoice immediately. Only applies when ",[248,1329,1300],{}," and ",[248,1332,1223],{}," are both ",[248,1335,1233],{},". Defaults to ",[248,1338,1240],{},", which parks the proration delta on the current cycle and bills it as a line on the next renewal invoice (and waives it if the subscription is cancelled first). ",[1127,1341,1342,1343,1345],{},"Set this to ",[248,1344,1233],{}," on yearly and other long-interval plans",", where the deferral to the next renewal costs you the most.",[227,1348,1349,1353,1357],{},[245,1350,1351],{},[248,1352,1281],{},[245,1354,1355],{},[248,1356,469],{},[245,1358,1359,1360,1363,1364,280],{},"Set the billing anchor to a specific date (",[248,1361,1362],{},"YYYY-MM-DD",", UTC). Cannot be combined with ",[248,1365,1284],{},[227,1367,1368,1372,1376],{},[245,1369,1370],{},[248,1371,1284],{},[245,1373,1374],{},[248,1375,320],{},[245,1377,1378,1379,280],{},"Reset the billing anchor to now. Cannot be combined with ",[248,1380,1281],{},[227,1382,1383,1387,1391],{},[245,1384,1385],{},[248,1386,581],{},[245,1388,1389],{},[248,1390,469],{},[245,1392,1393,1394,280],{},"Extend or set a trial until this date (ISO 8601). Cannot be combined with ",[248,1395,1281],{},[702,1397,1399],{"className":704,"code":1398,"language":706,"meta":117,"style":117},"\u002F\u002F Change the quantity (new total) and pass a custom idempotency key.\n$subscription = $vatly->subscriptions->update('subscription_123', [\n    'quantity' => 2,\n], [\n    'idempotencyKey' => 'subscription-update-123',\n]);\n\n\u002F\u002F Switch plan at a custom price (currency must match the subscription).\n$subscription = $vatly->subscriptions->update('subscription_123', [\n    'subscriptionPlanId' => 'subscription_plan_Wt5mNvBxKw7YcZaEjLhR',\n    'price' => ['value' => '99.99', 'currency' => 'EUR'],\n    'applyImmediately' => true,\n]);\n\n\u002F\u002F Switch plan now without charging for the change. The next renewal bills the new price.\n$subscription = $vatly->subscriptions->update('subscription_123', [\n    'subscriptionPlanId' => 'subscription_plan_Wt5mNvBxKw7YcZaEjLhR',\n    'applyImmediately' => true,\n    'prorationCharge' => false,\n]);\n",[248,1400,1401,1406,1441,1459,1466,1486,1491,1495,1500,1532,1551,1600,1614,1619,1624,1630,1663,1682,1695,1709],{"__ignoreMap":117},[710,1402,1403],{"class":712,"line":713},[710,1404,1405],{"class":1024},"\u002F\u002F Change the quantity (new total) and pass a custom idempotency key.\n",[710,1407,1408,1410,1412,1414,1416,1418,1420,1422,1424,1427,1429,1431,1434,1436,1438],{"class":712,"line":760},[710,1409,717],{"class":716},[710,1411,721],{"class":720},[710,1413,724],{"class":716},[710,1415,727],{"class":716},[710,1417,730],{"class":720},[710,1419,733],{"class":716},[710,1421,736],{"class":720},[710,1423,733],{"class":716},[710,1425,1426],{"class":741},"update",[710,1428,745],{"class":716},[710,1430,748],{"class":716},[710,1432,1433],{"class":751},"subscription_123",[710,1435,748],{"class":716},[710,1437,1057],{"class":716},[710,1439,1440],{"class":716}," [\n",[710,1442,1443,1446,1448,1450,1453,1456],{"class":712,"line":767},[710,1444,1445],{"class":716},"    '",[710,1447,388],{"class":751},[710,1449,7