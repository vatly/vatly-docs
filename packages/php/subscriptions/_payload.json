6,1280,1281,1285,1290],{},[334,1282,1283],{},[337,1284,1226],{},[334,1286,1287],{},[337,1288,1289],{},"array",[334,1291,1292,1293,1296,1297,1300,1301,1303,1304,1306],{},"Override the recurring price: ",[337,1294,1295],{},"['value' => '99.99', 'currency' => 'EUR']",". The ",[337,1298,1299],{},"currency"," must match the subscription's currency. Provide ",[337,1302,1226],{}," alone to change the price in place, or combine it with ",[337,1305,390],{}," to switch plans at a custom price (overriding the new plan's default).",[316,1308,1309,1314,1318],{},[334,1310,1311],{},[337,1312,1313],{},"prorate",[334,1315,1316],{},[337,1317,409],{},[334,1319,1320,1321,1324,1325,1327,1328,1331,1332,1337,1338,1341,1342,1344,1345,369],{},"How an immediate change is priced (default ",[337,1322,1323],{},"true","). ",[337,1326,1323],{}," charges the new price for the time left on the cycle, minus a credit for the old price over that same time. ",[337,1329,1330],{},"false"," charges the full new price for the current cycle on top of what was already paid. ",[1217,1333,1334,1336],{},[337,1335,1330],{}," does not skip the charge:"," use ",[337,1339,1340],{},"prorationCharge"," for that. Ignored when ",[337,1343,1340],{}," is ",[337,1346,1330],{},[316,1348,1349,1353,1357],{},[334,1350,1351],{},[337,1352,1340],{},[334,1354,1355],{},[337,1356,409],{},[334,1358,1359,1360,1362,1363,1365,1366,503,1369,503,1372,503,1375,1377,1378,1380,1381,369],{},"Whether an immediate change is charged at all (default ",[337,1361,1323],{},"). With ",[337,1364,1330],{},", the change applies now and nothing is charged for it: a downgrade gets no credit. The next renewal bills the new price, unless a change is already scheduled for that renewal: that change still applies. During a trial, the trial keeps running and its end bills the new plan. Sending ",[337,1367,1368],{},"invoiceImmediately: true",[337,1370,1371],{},"anchor",[337,1373,1374],{},"resetAnchor",[337,1376,670],{}," or a plan with a different interval with ",[337,1379,1330],{}," returns ",[337,1382,1383],{},"422",[316,1385,1386,1391,1395],{},[334,1387,1388],{},[337,1389,1390],{},"applyImmediately",[334,1392,1393],{},[337,1394,409],{},[334,1396,1397,1398,1400,1401,1403],{},"Apply the change now (",[337,1399,1323],{},") or at the end of the current period (",[337,1402,1330],{},", default).",[316,1405,1406,1411,1415],{},[334,1407,1408],{},[337,1409,1410],{},"invoiceImmediately",[334,1412,1413],{},[337,1414,409],{},[334,1416,1417,1418,1420,1421,1423,1424,1426,1427,1429,1430,1436],{},"Generate and charge a proration invoice immediately. Only applies when ",[337,1419,1390],{}," and ",[337,1422,1313],{}," are both ",[337,1425,1323],{},". Defaults to ",[337,1428,1330],{},", which parks the proration delta on the current cycle and bills it as a line on the next renewal invoice (and waives it if the subscription is cancelled first). ",[1217,1431,1432,1433,1435],{},"Set this to ",[337,1434,1323],{}," on yearly and other long-interval plans",", where the deferral to the next renewal costs you the most.",[316,1438,1439,1443,1447],{},[334,1440,1441],{},[337,1442,1371],{},[334,1444,1445],{},[337,1446,558],{},[334,1448,1449,1450,1453,1454,369],{},"Set the billing anchor to a specific date (",[337,1451,1452],{},"YYYY-MM-DD",", UTC). Cannot be combined with ",[337,1455,1374],{},[316,1457,1458,1462,1466],{},[334,1459,1460],{},[337,1461,1374],{},[334,1463,1464],{},[337,1465,409],{},[334,1467,1468,1469,369],{},"Reset the billing anchor to now. Cannot be combined with ",[337,1470,1371],{},[316,1472,1473,1477,1481],{},[334,1474,1475],{},[337,1476,670],{},[334,1478,1479],{},[337,1480,558],{},[334,1482,1483,1484,369],{},"Extend or set a trial until this date (ISO 8601). Cannot be combined with ",[337,1485,1371],{},[791,1487,1489],{"className":793,"code":1488,"language":795,"meta":796,"style":796},"\u002F\u002F Change the quantity (new total) and pass a custom idempotency key.\n$subscription = $vatly->subscriptions->update('subscription_123',