},"The ",[1221,1280,1281],{},"new total"," quantity (e.g. number of seats). This sets the quantity to the given value — it is not added to the current quantity.",[320,1284,1285,1289,1294],{},[338,1286,1287],{},[341,1288,1230],{},[338,1290,1291],{},[341,1292,1293],{},"array",[338,1295,1296,1297,1300,1301,1304,1305,1307,1308,1310],{},"Override the recurring price: ",[341,1298,1299],{},"['value' => '99.99', 'currency' => 'EUR']",". The ",[341,1302,1303],{},"currency"," must match the subscription's currency. Provide ",[341,1306,1230],{}," alone to change the price in place, or combine it with ",[341,1309,394],{}," to switch plans at a custom price (overriding the new plan's default).",[320,1312,1313,1318,1322],{},[338,1314,1315],{},[341,1316,1317],{},"prorate",[338,1319,1320],{},[341,1321,413],{},[338,1323,1324,1325,1328,1329,1331,1332,1335,1336,1341,1342,1345,1346,1348,1349,373],{},"How an immediate change is priced (default ",[341,1326,1327],{},"true","). ",[341,1330,1327],{}," charges the new price for the time left on the cycle, minus a credit for the old price over that same time. ",[341,1333,1334],{},"false"," charges the full new price for the current cycle on top of what was already paid. ",[1221,1337,1338,1340],{},[341,1339,1334],{}," does not skip the charge:"," use ",[341,1343,1344],{},"prorationCharge"," for that. Ignored when ",[341,1347,1344],{}," is ",[341,1350,1334],{},[320,1352,1353,1357,1361],{},[338,1354,1355],{},[341,1356,1344],{},[338,1358,1359],{},[341,1360,413],{},[338,1362,1363,1364,1366,1367,1369,1370,507,1373,507,1376,507,1379,1381,1382,1384,1385,373],{},"Whether an immediate change is charged at all (default ",[341,1365,1327],{},"). With ",[341,1368,1334],{},", the change applies now and nothing is charged for it: a downgrade gets no credit. The next renewal bills the new price, unless a change is already scheduled for that renewal: that change still applies. During a trial, the trial keeps running and its end bills the new plan. Sending ",[341,1371,1372],{},"invoiceImmediately: true",[341,1374,1375],{},"anchor",[341,1377,1378],{},"resetAnchor",[341,1380,674],{}," or a plan with a different interval with ",[341,1383,1334],{}," returns ",[341,1386,1387],{},"422",[320,1389,1390,1395,1399],{},[338,1391,1392],{},[341,1393,1394],{},"applyImmediately",[338,1396,1397],{},[341,1398,413],{},[338,1400,1401,1402,1404,1405,1407],{},"Apply the change now (",[341,1403,1327],{},") or at the end of the current period (",[341,1406,1334],{},", default).",[320,1409,1410,1415,1419],{},[338,1411,1412],{},[341,1413,1414],{},"invoiceImmediately",[338,1416,1417],{},[341,1418,413],{},[338,1420,1421,1422,1424,1425,1427,1428,1430,1431,1433,1434,1440],{},"Generate and charge a proration invoice immediately. Only applies when ",[341,1423,1394],{}," and ",[341,1426,1317],{}," are both ",[341,1429,1327],{},". Defaults to ",[341,1432,1334],{},", which parks the proration delta on the current cycle and bills it as a line on the next renewal invoice (and waives it if the subscription is cancelled first). ",[1221,1435,1436,1437,1439],{},"Set this to ",[341,1438,1327],{}," on yearly and other long-interval plans",", where the deferral to the next renewal costs you the most.",[320,1442,1443,1447,1451],{},[338,1444,1445],{},[341,1446,1375],{},[338,1448,1449],{},[341,1450,562],{},[338,1452,1453,1454,1457,1458,373],{},"Set the billing anchor to a specific date (",[341,1455,1456],{},"YYYY-MM-DD",", UTC). Cannot be combined with ",[341,1459,1378],{},[320,1461,1462,1466,1470],{},[338,1463,1464],{},[341,1465,1378],{},[338,1467,1468],{},[341,1469,413],{},[338,1471,1472,1473,373],{},"Reset the billing anchor to now. Cannot be combined with ",[341,1474,1375],{},[320,1476,1477,1481,1485],{},[338,1478,1479],{},[341,1480,674],{},[338,1482,1483],{},[341,1484,562],{},[338,1486,1487,1488,373],{},"Extend or set a trial until this date (ISO 8601). Cannot be combined with ",[341,1489,1375],{},[795,1491,1493],{"className":797,"code":1492,"language":799,"meta"