02,2004],{"class":774,"line":1013},[772,1994,1295],{"class":778},[772,1996,1526],{"class":1244},[772,1998,1529],{"class":778},[772,2000,2001],{"class":1244},"lines",[772,2003,1912],{"class":778},[772,2005,2006],{"class":1494},"             // Vatly\\API\\Types\\OrderLineData[]\n",[772,2008,2009,2011,2013,2015,2017,2019],{"class":774,"line":1019},[772,2010,1295],{"class":778},[772,2012,1526],{"class":1244},[772,2014,1529],{"class":778},[772,2016,551],{"class":1244},[772,2018,1912],{"class":778},[772,2020,2021],{"class":1494},"          // bool — test (true) vs live (false), mirrored from the source record\n",[196,2023,2024,2025,2027,2028,2031,2032,2035],{},"Every business event (order/subscription/refund/chargeback/checkout) carries ",[208,2026,551],{},", sourced from the enriched resource (",[208,2029,2030],{},"$resource->testmode",") or the webhook envelope (",[208,2033,2034],{},"$webhook->testmode","). Persist it alongside the record so test and live data stay segregated and the matching API key can be selected per record.",[196,2037,2038,2039,2042,2043,2050,2051,2053,2054,2053,2056,2059,2060,2062],{},"These DTOs are the canonical, framework-agnostic event shapes that higher-level integrations (e.g. ",[208,2040,2041],{},"vatly-fluent-php",") build on. The line-item DTO lives at ",[213,2044,2047],{"href":2045,"rel":2046},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Types/OrderLineData.php",[217],[208,2048,2049],{},"Vatly\\API\\Types\\OrderLineData","; its ",[208,2052,415],{},"/",[208,2055,964],{},[208,2057,2058],{},"subtotal"," are ",[208,2061,1796],{}," too.",[196,2064,2065,2066,2071,2072,2075,2076,2078,2079,2082],{},"The full set of incoming webhook payloads is also described in the ",[213,2067,2070],{"href":2068,"rel":2069},"https://docs.vatly.com/openapi.yaml",[217],"webhooks OpenAPI spec"," under the top-level ",[208,2073,2074],{},"webhooks:"," section — one entry per ",[208,2077,1761],{},", each referencing the ",[208,2080,2081],{},"WebhookDelivery"," envelope.",[488,2084,2086],{"id":2085},"replay-window-tolerance","Replay-window tolerance",[196,2088,2089,2090,2093,2094,2097,2098,2105],{},"The signed timestamp (",[208,2091,2092],{},"t=...",") lets receivers reject stale deliveries. By default signatures more than ",[505,2095,2096],{},"300 seconds"," old are rejected. If you need a custom window — for example when replaying captured fixtures in a test suite — instantiate ",[213,2099,2102],{"href":2100,"rel":2101},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Webhooks/WebhookSignatureValidator.php",[217],[208,2103,2104],{},"WebhookSignatureValidator"," directly:",[764,2107,2109],{"className":1232,"code":2108,"language":1234,"meta":109,"style":109},"use Vatly\\API\\Webhooks\\WebhookSignatureValidator;\n\n$validator = new WebhookSignatureValidator($secret, toleranceSeconds: 60);\n$validator->verify($payload, $signature);\n",[208,2110,2111,2131,2135,2166],{"__ignoreMap":109},[772,2112,2113,2115,2117,2119,2121,2123,2125,2127,2129],{"class":774,"line":775},[772,2114,1241],{"class":976},[772,2116,1245],{"class":1244},[772,2118,1248],{"class":778},[772,2120,1251],{"class":1244},[772,2122,1248],{"class":778},[772,2124,38],{"class":1244},[772,2126,1248],{"class":778},[772,2128,2104],{"class":1244},[772,2130,566],{"class":778},[772,2132,2133],{"class":774,"line":782},[772,2134,1290],{"emptyLinePlaceholder":1289},[772,2136,2137,2139,2142,2144,2147,2150,2152,2154,2156,2159,2161,2164],{"class":774,"line":808},[772,2138,1295],{"class":778},[772,2140,2141],{"class":1244},"validator ",[772,2143,1301],{"class":778},[772,2145,2146],{"class":976}," new",[772,2148,2149],{"class":904}," WebhookSignatureValidator",[772,2151,1412],{"class":778},[772,2153,1429],{"class":1244},[772,2155,991],{"class":778},[772,2157,2158],{"class":904}," toleranceSeconds",[772,2160,794],{"class":778},[772,2162,2163],{"class":976}," 60",[772,2165,1319],{"class":778},[772,2167,2168,2170,2173,2175,2178,2180,2182,2184,2186,2188],{"class":774,"line":827},[772,2169,1295],{"class":778},[772,2171,2172],{"class":1244},"validator",[772,2174,1529],{"class":778},[772,2176,2177],{"class":1304},"verify",[772,2179,1412],{"class":778},[772,2181,1415],{"class":1244},[772,2183,991],{"class":778},[772,2185,1331],{"class":778},[772,2187,1422],{"class":1244},[772,2189,1319],{"class":778},[196,2191,2192],{},"Keep the default in production. A tighter window makes a leaked signature less useful; a much wider window weakens the replay-defense guarantee.",[488,2194,2196],{"id":2195},"lower-level-access","Lower-level access",[196,2198,2199,2200,2205,2206,406,2209,2212,2213,2216],{},"If you only need signature verification (e.g. handling the decoded body yourself, or operating on a non-standard payload shape), use ",[213,2201,2203],{"href":2100,"rel":2202},[217],[208,2204,2104],{}," directly. It exposes ",[208,2207,2208],{},"verify()",[208,2210,2211],{},"isValid()",", and ",[208,2214,2215],{},"calculateSignature()",", plus header-name constants:",[764,2218,2220],{"className":1232,"code":2219,"language":1234,"meta":109,"style":109},"WebhookSignatureValidator::SIGNATURE_HEADER_NAME; // 'Vatly-Signature'\nWebhookSignatureValidator::EVENT_ID_HEADER_NAME;  // 'Vatly-Event-Id'\n",[208,2221,2222,2236],{"__ignoreMap":109},[772,2223,2224,2226,2228,2231,2233],{"class":774,"line":775},[772,2225,2104],{"class":904},[772,2227,1406],{"class":778},[772,2229,2230],{"class":1244},"SIGNATURE_HEADER_NAME",[772,2232,1912],{"class":778},[772,2234,2235],{"class":1494}," // 'Vatly-Signature'\n",[772,2237,2238,2240,2242,2245,2247],{"class":774,"line":782},[772,2239,2104],{"class":904},[772,2241,1406],{"class":778},[772,2243,2244],{"class":1244},"EVENT_ID_HEADER_NAME",[772,2246,1912],{"class":778},[772,2248,2249],{"class":1494},"  // 'Vatly-Event-Id'\n",[571,2251],{},[200,2253,2255],{"id":2254},"best-practices","Best practices",[2257,2258,2259,2265,2271,2279,2285],"ol",{},[1749,2260,2261,2264],{},[505,2262,2263],{},"Always verify signatures"," before processing webhook payloads.",[1749,2266,2267,2270],{},[505,2268,2269],{},"Verify against the raw body",", not parsed-and-reserialised JSON.",[1749,2272,2273,2278],{},[505,2274,2275,2276],{},"Dedupe with ",[208,2277,502],{}," — retries reuse the same event id, while the signature deliberately rotates per attempt.",[1749,2280,2281,2284],{},[505,2282,2283],{},"Return 200 quickly"," to avoid timeout retries. Offload long-running work to a queue.",[1749,2286,2287,2290],{},[505,2288,2289],{},"Log webhook events"," for debugging and auditing.",[2292,2293,2294],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-defa