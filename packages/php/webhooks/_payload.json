,"These DTOs are the canonical, framework-agnostic event shapes that higher-level integrations (e.g. ",[201,1983,1984],{},"vatly-fluent-php",") build on. The line-item DTO lives at ",[206,1987,1990],{"href":1988,"rel":1989},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Types/OrderLineData.php",[210],[201,1991,1992],{},"Vatly\\API\\Types\\OrderLineData","; its ",[201,1995,1996],{},"basePrice","/",[201,1999,906],{},[201,2001,2002],{},"subtotal"," are ",[201,2005,1739],{}," too.",[189,2008,2009,2010,2015,2016,2019,2020,2022,2023,2026],{},"The full set of incoming webhook payloads is also described in the ",[206,2011,2014],{"href":2012,"rel":2013},"https://docs.vatly.com/openapi.yaml",[210],"webhooks OpenAPI spec"," under the top-level ",[201,2017,2018],{},"webhooks:"," section — one entry per ",[201,2021,1704],{},", each referencing the ",[201,2024,2025],{},"WebhookDelivery"," envelope.",[428,2028,2030],{"id":2029},"replay-window-tolerance","Replay-window tolerance",[189,2032,2033,2034,2037,2038,2041,2042,2049],{},"The signed timestamp (",[201,2035,2036],{},"t=...",") lets receivers reject stale deliveries. By default signatures more than ",[445,2039,2040],{},"300 seconds"," old are rejected. If you need a custom window — for example when replaying captured fixtures in a test suite — instantiate ",[206,2043,2046],{"href":2044,"rel":2045},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Webhooks/WebhookSignatureValidator.php",[210],[201,2047,2048],{},"WebhookSignatureValidator"," directly:",[706,2051,2053],{"className":1174,"code":2052,"language":1176,"meta":105,"style":105},"use Vatly\\API\\Webhooks\\WebhookSignatureValidator;\n\n$validator = new WebhookSignatureValidator($secret, toleranceSeconds: 60);\n$validator->verify($payload, $signature);\n",[201,2054,2055,2075,2079,2110],{"__ignoreMap":105},[714,2056,2057,2059,2061,2063,2065,2067,2069,2071,2073],{"class":716,"line":717},[714,2058,1183],{"class":918},[714,2060,1187],{"class":1186},[714,2062,1190],{"class":720},[714,2064,1193],{"class":1186},[714,2066,1190],{"class":720},[714,2068,38],{"class":1186},[714,2070,1190],{"class":720},[714,2072,2048],{"class":1186},[714,2074,507],{"class":720},[714,2076,2077],{"class":716,"line":724},[714,2078,1232],{"emptyLinePlaceholder":1231},[714,2080,2081,2083,2086,2088,2091,2094,2096,2098,2100,2103,2105,2108],{"class":716,"line":750},[714,2082,1237],{"class":720},[714,2084,2085],{"class":1186},"validator ",[714,2087,1243],{"class":720},[714,2089,2090],{"class":918}," new",[714,2092,2093],{"class":846}," WebhookSignatureValidator",[714,2095,1354],{"class":720},[714,2097,1371],{"class":1186},[714,2099,933],{"class":720},[714,2101,2102],{"class":846}," toleranceSeconds",[714,2104,736],{"class":720},[714,2106,2107],{"class":918}," 60",[714,2109,1261],{"class":720},[714,2111,2112,2114,2117,2119,2122,2124,2126,2128,2130,2132],{"class":716,"line":769},[714,2113,1237],{"class":720},[714,2115,2116],{"class":1186},"validator",[714,2118,1472],{"class":720},[714,2120,2121],{"class":1246},"verify",[714,2123,1354],{"class":720},[714,2125,1357],{"class":1186},[714,2127,933],{"class":720},[714,2129,1273],{"class":720},[714,2131,1364],{"class":1186},[714,2133,1261],{"class":720},[189,2135,2136],{},"Keep the default in production. A tighter window makes a leaked signature less useful; a much wider window weakens the replay-defense guarantee.",[428,2138,2140],{"id":2139},"lower-level-access","Lower-level access",[189,2142,2143,2144,2149,2150,479,2153,2156,2157,2160],{},"If you only need signature verification (e.g. handling the decoded body yourself, or operating on a non-standard payload shape), use ",[206,2145,2147],{"href":2044,"rel":2146},[210],[201,2148,2048],{}," directly. It exposes ",[201,2151,2152],{},"verify()",[201,2154,2155],{},"isValid()",", and ",[201,2158,2159],{},"calculateSignature()",", plus header-name constants:",[706,2162,2164],{"className":1174,"code":2163,"language":1176,"meta":105,"style":105},"WebhookSignatureValidator::SIGNATURE_HEADER_NAME; // 'Vatly-Signature'\nWebhookSignatureValidator::EVENT_ID_HEADER_NAME;  // 'Vatly-Event-Id'\n",[201,2165,2166,2180],{"__ignoreMap":105},[714,2167,2168,2170,2172,2175,2177],{"class":716,"line":717},[714,2169,2048],{"class":846},[714,2171,1348],{"class":720},[714,2173,2174],{"class":1186},"SIGNATURE_HEADER_NAME",[714,2176,1855],{"class":720},[714,2178,2179],{"class":1437}," // 'Vatly-Signature'\n",[714,2181,2182,2184,2186,2189,2191],{"class":716,"line":724},[714,2183,2048],{"class":846},[714,2185,1348],{"class":720},[714,2187,2188],{"class":1186},"EVENT_ID_HEADER_NAME",[714,2190,1855],{"class":720},[714,2192,2193],{"class":1437},"  // 'Vatly-Event-Id'\n",[512,2195],{},[193,2197,2199],{"id":2198},"best-practices","Best practices",[2201,2202,2203,2209,2215,2223,2229],"ol",{},[1692,2204,2205,2208],{},[445,2206,2207],{},"Always verify signatures"," before processing webhook payloads.",[1692,2210,2211,2214],{},[445,2212,2213],{},"Verify against the raw body",", not parsed-and-reserialised JSON.",[1692,2216,2217,2222],{},[445,2218,2219,2220],{},"Dedupe with ",[201,2221,442],{}," — retries reuse the same event id, while the signature deliberately rotates per attempt.",[1692,2224,2225,2228],{},[445,2226,2227],{},"Return 200 quickly"," to avoid timeout retries. Offload long-running work to a queue.",[1692,2230,2231,2234],{},[445,2232,2233],{},"Log webhook events"," for debugging and auditing.",[2236,2237,2238],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-ligh