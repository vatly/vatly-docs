,1896,1464],{"class":712},[706,1898,898],{"class":1178},[706,1900,1464],{"class":712},[706,1902,1903],{"class":1238},"toCents",[706,1905,1906],{"class":712},"();",[706,1908,1909],{"class":1429},"  // int cents, e.g. 4999\n",[706,1911,1912,1914,1916,1918,1921,1923],{"class":708,"line":893},[706,1913,1229],{"class":712},[706,1915,1461],{"class":1178},[706,1917,1464],{"class":712},[706,1919,1920],{"class":1178},"taxSummary",[706,1922,1847],{"class":712},[706,1924,1925],{"class":1429},"        // Vatly\\API\\Types\\TaxSummaryCollection\n",[706,1927,1928,1930,1932,1934,1937,1939],{"class":708,"line":947},[706,1929,1229],{"class":712},[706,1931,1461],{"class":1178},[706,1933,1464],{"class":712},[706,1935,1936],{"class":1178},"lines",[706,1938,1847],{"class":712},[706,1940,1941],{"class":1429},"             // Vatly\\API\\Types\\OrderLineData[]\n",[706,1943,1944,1946,1948,1950,1952,1954],{"class":708,"line":953},[706,1945,1229],{"class":712},[706,1947,1461],{"class":1178},[706,1949,1464],{"class":712},[706,1951,484],{"class":1178},[706,1953,1847],{"class":712},[706,1955,1956],{"class":1429},"          // bool — test (true) vs live (false), mirrored from the source record\n",[181,1958,1959,1960,1962,1963,1966,1967,1970],{},"Every business event (order/subscription/refund/chargeback/checkout) carries ",[193,1961,484],{},", sourced from the enriched resource (",[193,1964,1965],{},"$resource->testmode",") or the webhook envelope (",[193,1968,1969],{},"$webhook->testmode","). Persist it alongside the record so test and live data stay segregated and the matching API key can be selected per record.",[181,1972,1973,1974,1977,1978,1985,1986,1989,1990,1989,1992,1995,1996,1998],{},"These DTOs are the canonical, framework-agnostic event shapes that higher-level integrations (e.g. ",[193,1975,1976],{},"vatly-fluent-php",") build on. The line-item DTO lives at ",[198,1979,1982],{"href":1980,"rel":1981},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Types/OrderLineData.php",[202],[193,1983,1984],{},"Vatly\\API\\Types\\OrderLineData","; its ",[193,1987,1988],{},"basePrice","/",[193,1991,898],{},[193,1993,1994],{},"subtotal"," are ",[193,1997,1731],{}," too.",[181,2000,2001,2002,2007,2008,2011,2012,2014,2015,2018],{},"The full set of incoming webhook payloads is also described in the ",[198,2003,2006],{"href":2004,"rel":2005},"https://docs.vatly.com/openapi.yaml",[202],"webhooks OpenAPI spec"," under the top-level ",[193,2009,2010],{},"webhooks:"," section — one entry per ",[193,2013,1696],{},", each referencing the ",[193,2016,2017],{},"WebhookDelivery"," envelope.",[420,2020,2022],{"id":2021},"replay-window-tolerance","Replay-window tolerance",[181,2024,2025,2026,2029,2030,2033,2034,2041],{},"The signed timestamp (",[193,2027,2028],{},"t=...",") lets receivers reject stale deliveries. By default signatures more than ",[437,2031,2032],{},"300 seconds"," old are rejected. If you need a custom window — for example when replaying captured fixtures in a test suite — instantiate ",[198,2035,2038],{"href":2036,"rel":2037},"https://github.com/Vatly/vatly-api-php/blob/main/src/API/Webhooks/WebhookSignatureValidator.php",[202],[193,2039,2040],{},"WebhookSignatureValidator"," directly:",[698,2043,2045],{"className":1166,"code":2044,"language":1168,"meta":105,"style":105},"use Vatly\\API\\Webhooks\\WebhookSignatureValidator;\n\n$validator = new WebhookSignatureValidator($secret, toleranceSeconds: 60);\n$validator->verify($payload, $signature);\n",[193,2046,2047,2067,2071,2102],{"__ignoreMap":105},[706,2048,2049,2051,2053,2055,2057,2059,2061,2063,2065],{"class":708,"line":709},[706,2050,1175],{"class":910},[706,2052,1179],{"class":1178},[706,2054,1182],{"class":712},[706,2056,1185],{"class":1178},[706,2058,1182],{"class":712},[706,2060,38],{"class":1178},[706,2062,1182],{"class":712},[706,2064,2040],{"class":1178},[706,2066,499],{"class":712},[706,2068,2069],{"class":708,"line":716},[706,2070,1224],{"emptyLinePlaceholder":1223},[706,2072,2073,2075,2078,2080,2083,2086,2088,2090,2092,2095,2097,2100],{"class":708,"line":742},[706,2074,1229],{"class":712},[706,2076,2077],{"class":1178},"validator ",[706,2079,1235],{"class":712},[706,2081,2082],{"class":910}," new",[706,2084,2085],{"class":838}," WebhookSignatureValidator",[706,2087,1346],{"class":712},[706,2089,1363],{"class":1178},[706,2091,925],{"class":712},[706,2093,2094],{"class":838}," toleranceSeconds",[706,2096,728],{"class":712},[706,2098,2099],{"class":910}," 60",[706,2101,1253],{"class":712},[706,2103,2104,2106,2109,2111,2114,2116,2118,2120,2122,2124],{"class":708,"line":761},[706,2105,1229],{"class":712},[706,2107,2108],{"class":1178},"validator",[706,2110,1464],{"class":712},[706,2112,2113],{"class":1238},"verify",[706,2115,1346],{"class":712},[706,2117,1349],{"class":1178},[706,2119,925],{"class":712},[706,2121,1265],{"class":712},[706,2123,1356],{"class":1178},[706,2125,1253],{"class":712},[181,2127,2128],{},"Keep the default in production. A tighter window makes a leaked signature less useful; a much wider window weakens the replay-defense guarantee.",[420,2130,2132],{"id":2131},"lower-level-access","Lower-level access",[181,2134,2135,2136,2141,2142,471,2145,2148,2149,2152],{},"If you only need signature verification (e.g. handling the decoded body yourself, or operating on a non-standard payload shape), use ",[198,2137,2139],{"href":2036,"rel":2138},[202],[193,2140,2040],{}," directly. It exposes ",[193,2143,2144],{},"verify()",[193,2146,2147],{},"isValid()",", and ",[193,2150,2151],{},"calculateSignature()",", plus header-name constants:",[698,2154,2156],{"className":1166,"code":2155,"language":1168,"meta":105,"style":105},"WebhookSignatureValidator::SIGNATURE_HEADER_NAME; // 'Vatly-Signature'\nWebhookSignatureValidator::EVENT_ID_HEADER_NAME;  // 'Vatly-Event-Id'\n",[193,2157,2158,2172],{"__ignoreMap":105},[706,2159,2160,2162,2164,2167,2169],{"class":708,"line":709},[706,2161,2040],{"class":838},[706,2163,1340],{"class":712},[706,2165,2166],{"clas