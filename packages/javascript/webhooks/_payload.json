ludes ",[461,1388,1389],{},"KnownWebhookEvent",[461,1391,1392],{},"known: true",") and\n",[461,1395,1396],{},"UnsupportedWebhookEvent",[461,1398,1399],{},"known: false",", ",[461,1402,1403],{},"eventName: string",[461,1405,1406],{},"object: unknown",").\nThe SDK adds this discriminator to a shallow copy after verification, overwriting\nany wire-supplied flag. It classifies the event name, not the resource schema.\nBoth sides of ",[461,1409,1410],{},"if (event.known)"," narrow normally; no custom type guards are needed.\nUnknown event names can appear before an SDK upgrade. Keep them for triage and\ndecide acknowledgement policy explicitly; a successful HMAC is not a reason to\ndiscard an event you cannot yet process.",[1413,1414,1415],"blockquote",{},[428,1416,1417,1420],{},[860,1418,1419],{},"Always verify against the raw body bytes."," Re-serializing the JSON changes\nthe bytes (whitespace, key order, number formatting) and breaks the HMAC.",[453,1422,459,1424,992],{"id":1423},"the-webhooksetup-event",[461,1425,834],{},[428,1427,1428,1429,1431,1432,1435,1436,1439,1440,1442,1443,1447,1448,1451],{},"When you register a webhook endpoint (or change its URL), Vatly sends a signed\n",[461,1430,834],{}," call to confirm the endpoint is reachable. It's delivered as a\nnormal webhook — same envelope, same signature, same ",[461,1433,1434],{},"Vatly-Event-Id"," header —\nso there's nothing special to parse: verify it and return a ",[461,1437,1438],{},"2xx",". Its ",[461,1441,490],{},"\nis the (secret-free) ",[435,1444,1446],{"href":443,"rel":1445},[439],"webhook endpoint","\nconfig and ",[461,1449,1450],{},"links"," is omitted (it's not a persisted event).",[453,1453,1455],{"id":1454},"signature-scheme","Signature scheme",[884,1457,1462],{"className":1458,"code":1460,"language":1461},[1459],"language-text","Vatly-Signature: t=1700000000,v1=\u003Chex_hmac_sha256>\nVatly-Event-Id:  webhook_event_Qk8pRtSvWm2NjLhYcZaE\n","text",[461,1463,1460],{"__ignoreMap":889},[1465,1466,1467,1474,1484,1494],"ul",{},[1468,1469,1470,1473],"li",{},[461,1471,1472],{},"t"," is unix seconds, captured fresh on each delivery attempt.",[1468,1475,1476,1479,1480,1483],{},[461,1477,1478],{},"v1"," is ",[461,1481,1482],{},"HMAC-SHA256(\"{t}.{rawBody}\", webhookSecret)",", lowercase hex.",[1468,1485,1486,1487,1490,1491,472],{},"The SDK rejects signatures where ",[461,1488,1489],{},"|now − t| > 300"," seconds by default\n(5-minute clock-skew tolerance). Tune it with ",[461,1492,1493],{},"{ toleranceSeconds }",[1468,1495,1496,1497,1500],{},"Future algorithm rotation ships ",[461,1498,1499],{},"v1=…,v2=…"," simultaneously; the SDK verifies\nany version it recognizes and ignores the rest.",[453,1502,1504],{"id":1503},"deduplication-is-your-job","Deduplication is your job",[428,1506,1507,1508,1511,1512,1514],{},"The SDK is stateless — it can't remember which events it has verified. The\nclock-skew check bounds how long a leaked signature is replayable, but does not\nstop replays inside that window. For full replay defense, dedupe on the\nretry-stable, signed ",[461,1509,1510],{},"event.id"," in your own store after verification. The\n",[461,1513,1434],{}," header is not signed and is for correlation only:",[884,1516,1518],{"className":886,"code":1517,"language":888,"meta":889,"style":889},"const event = await constructWebhookEventFromRequest(request, secret);\nconst eventId = event.id;\nif (await store.has(eventId)) return new Response(\"ok\"); \u002F\u002F already processed\n",[461,1519,1520,1545,1563],{"__ignoreMap":889},[893,1521,1522,1525,1528,1531,1533,1535,1538,1540,1543],{"class":895,"line":896},[893,1523,1524],{"class":943},"const",[893,1526,1527],{"class":907}," event ",[893,1529,1530],{"class":903},"=",[893,1532,1014],{"class":899},[893,1534,908],{"class":950},[893,1536,1537],{"class":907},"(request",[893,1539,1024],{"class":903},[893,1541,1542],{"class":907}," secret)",[893,1544,927],{"class":903},[893,1546,1547,1549,1552,1554,1556,1558,1561],{"class":895,"line":930},[893,1548,1524],{"class":943},[893,1550,1551],{"class":907}," eventId ",[893,1553,1530],{"class":903},[893,1555,992],{"class":907},[893,1557,472],{"class":903},[893,1559,1560],{"class":907},"id",[893,1562,927],{"class":903},[893,1564,1565,1568,1570,1573,1576,1578,1581,1584,1587,1589,1591,1593,1595,1597,1599,1601,1603],{"class":895,"line":937},[893,1566,1567],{"class":899},"if",[893,1569,1116],{"class":907},[893,1571,1572],{"class":899},"await",[893,1574,1575],{"class":907}," store",[893,1577,472],{"class":903},[893,1579,1580],{"class":950},"has",[893,1582,1583],{"class":907},"(eventId)) ",[893,1585,1586],{"class":899},"return",[893,1588,1065],{"class":903},[893,1590,1068],{"class":950},[893,1592,954],{"class":907},[893,1594,924],{"class":903},[893,1596,1316],{"class":920},[893,1598,924],{"class":903},[893,1600,1043],{"class":907},[893,1602,1236],{"class":903},[893,1604,1605],{"class":1138}," \u002F\u002F already processed\n",[428,1607,1608],{},"Record successful processing and deduplication atomically; do not mark an event\ncomplete before its business effects succeed. Concurrent deliveries need a\nunique constraint or equivalent transactional claim in your store.",[453,1610,1612],{"id":1611},"manage-webhook-endpoints","Manage webhook endpoints",[884,1614,1616],{"className":886,"code":1615,"language":888,"meta":889,"style":889},"const endpoint = await vatly.webhookEndpoints.create({\n  url: \"https:\u002F\u002Fyourapp.com\u002Fapi\u002Fwebhooks\u002Fvatly\",\n  secret: process.env.VATLY_WEBHOOK_SECRET!,\n  enabledEvents: [\"order.paid\", \"subscription.updated\"],\n});\nawait vatly.webhookEndpoints.update(endpoint.id, { enabledEvents: [] }); \u002F\u002F dormant\nconst page = await vatly.webhookEndpoints.list();\nawait vatly.webhookEndpoints.delete(endpoint.id); \u002F\u002F 204\n",[461,1617,1618,1646,1663,1683,1712,1721,1764,1791],{"__ignoreMap":889},[893,1619,1620,1622,1625,1627,1629,1632,1634,1637,1639,1642,1644],{"class":895,"line":896},[893,1621,1524]