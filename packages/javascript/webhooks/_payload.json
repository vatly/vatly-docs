902},[888,1755,1231],{"class":898},[888,1757,1758],{"class":1133}," \u002F\u002F dormant\n",[888,1760,1761,1763,1766,1768,1770,1772,1774,1776,1778,1781,1784],{"class":890,"line":1043},[888,1762,1519],{"class":938},[888,1764,1765],{"class":902}," page ",[888,1767,1525],{"class":898},[888,1769,1009],{"class":894},[888,1771,1626],{"class":902},[888,1773,467],{"class":898},[888,1775,1631],{"class":902},[888,1777,467],{"class":898},[888,1779,1780],{"class":945},"list",[888,1782,1783],{"class":902},"()",[888,1785,922],{"class":898},[888,1787,1788,1790,1792,1794,1796,1798,1801,1803,1805,1808,1810],{"class":890,"line":1054},[888,1789,1567],{"class":894},[888,1791,1626],{"class":902},[888,1793,467],{"class":898},[888,1795,1631],{"class":902},[888,1797,467],{"class":898},[888,1799,1800],{"class":945},"delete",[888,1802,1733],{"class":902},[888,1804,467],{"class":898},[888,1806,1807],{"class":902},"id)",[888,1809,1231],{"class":898},[888,1811,1812],{"class":1133}," \u002F\u002F 204\n",[423,1814,1815,1816,1819],{},"Secrets are write-only: store the one you supplied. HTTPS URLs must be unique\nwithin the storefront\u002Fmode, with up to five endpoints per mode. New event names\nare not automatically subscribed; update ",[456,1817,1818],{},"enabledEvents"," explicitly.",[448,1821,1823],{"id":1822},"rotating-secrets","Rotating secrets",[423,1825,1826],{},"Every verification helper accepts a single secret or an array. During a\nrotation, pass both — the SDK accepts whichever signed the delivery:",[879,1828,1830],{"className":881,"code":1829,"language":883,"meta":884,"style":884},"const event = await constructWebhookEventFromRequest(request, [\n  process.env.VATLY_WEBHOOK_SECRET_OLD!,\n  process.env.VATLY_WEBHOOK_SECRET_NEW!,\n]);\n",[456,1831,1832,1851,1867,1882],{"__ignoreMap":884},[888,1833,1834,1836,1838,1840,1842,1844,1846,1848],{"class":890,"line":891},[888,1835,1519],{"class":938},[888,1837,1522],{"class":902},[888,1839,1525],{"class":898},[888,1841,1009],{"class":894},[888,1