ator to a shallow copy after verification, overwriting\nany wire-supplied flag. It classifies the event name, not the resource schema.\nBoth sides of ",[456,1404,1405],{},"if (event.known)"," narrow normally; no custom type guards are needed.\nUnknown event names can appear before an SDK upgrade. Keep them for triage and\ndecide acknowledgement policy explicitly; a successful HMAC is not a reason to\ndiscard an event you cannot yet process.",[1408,1409,1410],"blockquote",{},[423,1411,1412,1415],{},[855,1413,1414],{},"Always verify against the raw body bytes."," Re-serializing the JSON changes\nthe bytes (whitespace, key order, number formatting) and breaks the HMAC.",[448,1417,454,1419,987],{"id":1418},"the-webhooksetup-event",[456,1420,829],{},[423,1422,1423,1424,1426,1427,1430,1431,1434,1435,1437,1438,1442,1443,1446],{},"When you register a webhook endpoint (or change its URL), Vatly sends a signed\n",[456,1425,829],{}," call to confirm the endpoint is reachable. It's delivered as a\nnormal webhook — same envelope, same signature, same ",[456,1428,1429],{},"Vatly-Event-Id"," header —\nso there's nothing special to parse: verify it and return a ",[456,1432,1433],{},"2xx",". Its ",[456,1436,485],{},"\nis the (secret-free) ",[430,1439,1441],{"href":438,"rel":1440},[434],"webhook endpoint","\nconfig and ",[456,1444,1445],{},"links"," is omitted (it's not a persisted event).",[448,1448,1450],{"id":1449},"signature-scheme","Signature scheme",[879,1452,1457],{"className":1453,"code":1455,"language":1456},[1454],"language-text","Vatly-Signature: t=1700000000,v1=\u003Chex_hmac_sha256>\nVatly-Event-Id:  webhook_event_Qk8pRtSvWm2NjLhYcZaE\n","text",[456,1458,1455],{"__ignoreMap":884},[1460,1461,1462,1469,1479,1489],"ul",{},[1463,1464,1465,1468],"li",{},[456,1466,1467],{},"t"," is unix seconds, captured fresh on each delivery attempt.",[1463,1470,1471,1474,1475,1478],{},[456,1472,1473],{},"v1"," is ",[456,1476,1477],{},"HMAC-SHA256(\"{t}.{rawBody}\", webhookSecret)",", lowercase hex.",[1463,1480,1481,1482,1485,1486,467],{},"The SDK rejects signatures where ",[456,1483,1484],{},"|now − t| > 300"," seconds by default\n(5-minute clock-skew tolerance). Tune it with ",[456,1487,1488],{},"{ toleranceSeconds }",[1463,1490,1491,1492,1495],{},"Future algorithm rotation ships ",[456,1493,1494],{},"v1=…,v2=…"," simultaneously; the SDK verifies\nany version it recognizes and ignores the rest.",[448,1497,1499],{"id":1498},"deduplication-is-your-job","Deduplication is your job",[423,1501,1502,1503,1506,1507,1509],{},"The SDK is stateless — it can't remember which events it has verified. The\nclock-skew check bounds how long a leaked signature is replayable, but does not\nstop replays inside that window. For full replay defense, dedupe on the\nretry-stable, signed ",[456,1504,1505],{},"event.id"," in your own store after verification. The\n",[456,1508,1429],{}," header is not signed and is for correlation only:",[879,1511,1513],{"className":881,"code":1512,"language":883,"meta":884,"style":884},"const event = await constructWebhookEventFromRequest(request, secret);\nconst eventId = event.id;\nif (await store.has(eventId)) return new Response(\"ok\"); \u002F\u002F already processed\n",[456,1514,1515,1540,1558],{"__ignoreMap":884},[888,1516,1517,1520,1523,1526,1528,1530,1533,1535,1538],{"class":890,"line":891},[888,1518,1519],{"class":938},"const",[888,1521,1522],{"class":902}," event ",[888,1524,1525],{"class":898},"=",[888,1527,1009],{"class":894},[888,1529,903],{"class":945},[888,1531,1532],{"class":902},"(request",[888,1534,1019],{"class":898},[888,1536,1537],{"class":902}," secret)",[888,1539,922],{"class":898},[888,1541,1542,1544,1547,1549,1551,1553,1556],{"class":890,"line":925},[888,1543,1519],{"class":938},[888,1545,1546],{"class":902}," eventId ",[888,1548,1525],{"class":898},[888,1550,987],{"class":902},[888,1552,467],{"class":898},[888,1554,1555],{"class":902},"id",[888,1557,922],{"class":898},[888,1559,1560,1563,1565,1568,1571,1573,1576,1579,1582,1584,1586,1588,1590,1592,1594,1596,1598],{"class":890,"line":932},[888,1561,1562],{"class":894},"if",[888,1564,1111],{"class":902},[888,1566,1567],{"class":894},"await",[888,1569,1570],{"class":902}," store",[888,1572,467],{"class":898},[888,1574,1575],{"class":945},"has",[888,1577,1578],{"class":902},"(eventId)) ",[888,1580,1581],{"class":894},"return",[888,1583,1060],{"class":898},[888,1585,1063],{"class":945},[888,1587,949],{"class":902},[888,1589,919],{"class":898},[888,1591,1311],{"class":915},[888,1593,919],{"class":898},[888,1595,1038],{"class":902},[888,1597,1231],{"class":898},[888,1599,1600],{"class":1133}," \u002F\u002F already processed\n",[423,1602,1603],{},"Record successful processing and deduplication atomically; do not mark an event\ncomplete before its business effects succeed. Concurrent deliveries need a\nunique constraint or equivalent transactional claim in your store.",[448,1605,1607],{"id":1606},"manage-webhook-endpoints","Manage webhook endpoints",[879,1609,1611],{"className":881,"code":1610,"language":883,"meta":884,"style":884},"const endpoint = await vatly.webhookEndpoints.create({\n  url: \"https:\u002F\u002Fyourapp.com\u002Fapi\u002Fwebhooks\u002Fvatly\",\n  secret: process.env.VATLY_WEBHOOK_SECRET!,\n  enabledEvents: [\"order.paid\", \"subscription.updated\"],\n});\nawait vatly.webhookEndpoints.update(endpoint.id, { enabledEvents: [] }); \u002F\u002F dormant\nconst page = await vatly.webhookEndpoints.list();\nawait vatly.webhookEndpoints.delete(endpoint.id); \u002F\u002F 204\n",[456,1612,1613,1641,1658,1678,1707,1716,1759,1786],{"__ignoreMap":884},[888,1614,1615,1617,1620,1622,1624,1627,1629,1632,1634,1637,1639],{"class":890,"line":891},[888,1616,1519],{"class":938},[888,1618,1619],{"class":902}," endpoint ",[888,1621,1525],{"class":898},[888,1623,1009],{"class":894},[888,1625,1626],{"class":902}," vatly",[888,1628,467],{"class":898},[888,1630,1631],{"class":902},"webhookEndpoints",[888,1633,467],{"class":898},[888,1635,1636],{"