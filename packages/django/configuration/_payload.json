ved team\u002Fmodel.\nFor the default user case, the equivalent resolver is:",[511,931,933],{"className":513,"code":932,"language":515,"meta":516,"style":516},"from django.core.exceptions import PermissionDenied\n\n\ndef example(request):\n    if not request.user.is_authenticated:\n        raise PermissionDenied(\"Login required\")\n    return request.user\n",[497,934,935,958,962,966,986,1010,1030],{"__ignoreMap":516},[520,936,937,940,943,945,948,950,953,955],{"class":522,"line":523},[520,938,939],{"class":526},"from",[520,941,942],{"class":530}," django",[520,944,509],{"class":547},[520,946,947],{"class":530},"core",[520,949,509],{"class":547},[520,951,952],{"class":530},"exceptions ",[520,954,527],{"class":526},[520,956,957],{"class":530}," PermissionDenied\n",[520,959,960],{"class":522,"line":534},[520,961,538],{"emptyLinePlaceholder":537},[520,963,964],{"class":522,"line":541},[520,965,538],{"emptyLinePlaceholder":537},[520,967,968,972,976,979,983],{"class":522,"line":575},[520,969,971],{"class":970},"spNyl","def",[520,973,975],{"class":974},"s2Zo4"," example",[520,977,978],{"class":547},"(",[520,980,982],{"class":981},"sHdIc","request",[520,984,985],{"class":547},"):\n",[520,987,988,991,994,997,999,1002,1004,1007],{"class":522,"line":600},[520,989,990],{"class":526},"    if",[520,992,993],{"class":547}," not",[520,995,996],{"class":530}," request",[520,998,509],{"class":547},[520,1000,1001],{"class":556},"user",[520,1003,509],{"class":547},[520,1005,1006],{"class":556},"is_authenticated",[520,1008,1009],{"class":547},":\n",[520,1011,1012,1015,1018,1020,1022,1025,1027],{"class":522,"line":617},[520,1013,1014],{"class":526},"        raise",[520,1016,1017],{"class":974}," PermissionDenied",[520,1019,978],{"class":547},[520,1021,563],{"class":547},[520,1023,1024],{"class":566},"Login required",[520,1026,563],{"class":547},[520,1028,1029],{"class":547},")\n",[520,1031,1032,1035,1037,1039],{"class":522,"line":632},[520,1033,1034],{"class":526},"    return",[520,1036,996],{"class":530},[520,1038,509],{"class":547},[520,1040,1041],{"class":556},"user\n",[493,1043,1044],{},"Put your resolver in an importable module and set its dotted path in settings.\nNever trust a query-string tenant\u002Fcustomer ID as authorization. The facade uses\none API key\u002Fsecret configuration per deployment; scope resolvers alone do not\nswitch credentials. For a multi-credential registry, compose ORMDriver and Fluent\nexplicitly. Webhook routing must also select trusted credentials and scope.",[493,1046,1047,1049,1050],{},[506,1048,445],{"href":446}," · ",[506,1051,301],{"href":1052,"rel":1053},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[1054],"nofollow",[1056,1057,1058],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {