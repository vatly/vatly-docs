path":477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":492,"body":493,"description":1818,"extension":1819,"links":1820,"meta":1821,"navigation":1822,"path":470,"seo":1823,"stem":471,"__hash__":1824},"docs\u002F3.packages\u002F8.django\u002F09.testing.md","Test billing offline",{"type":494,"value":495,"toc":1814},"minimark",[496,505,510,1136,1139,1143,1792,1799,1810],[497,498,499,500,504],"p",{},"Use Django's test database and httpx fixtures. Do not use a real Vatly key in unit\ntests. The snippets below are helpers for your pytest-django tests. Call them from\na test marked ",[501,502,503],"code",{},"@pytest.mark.django_db(transaction=True)"," with your project configured.",[506,507,509],"h2",{"id":508},"read-a-customer-with-mocktransport","Read a customer with MockTransport",[511,512,517],"pre",{"className":513,"code":514,"language":515,"meta":516,"style":516},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import httpx\nfrom asgiref.sync import async_to_sync\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\ndef example():\n    def respond(request):\n        assert request.url.path == \"\u002Fv1\u002Fcustomers\u002Fcustomer_example\"\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"customer_example\",\n                \"resource\": \"customer\",\n                \"testmode\": True,\n                \"email\": \"buyer@example.com\",\n                \"name\": \"Alex\",\n                \"metadata\": {},\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcustomers\u002Fcustomer_example\",\n                        \"type\": \"application\u002Fjson\",\n                    }\n                },\n            },\n        )\n\n    async def read_customer():\n        async with AsyncVatlyClient(\n            \"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)\n        ) as api:\n            vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n            return await vatly.customer(\"customer_example\").email()\n\n    assert async_to_sync(read_customer)() == \"buyer@example.com\"\n","python","",[501,518,519,532,553,566,585,592,597,611,630,663,680,690,699,723,744,759,780,801,816,837,852,867,889,910,916,922,928,934,939,953,967,1018,1033,1074,1106,1111],{"__ignoreMap":516},[520,521,524,528],"span",{"class":522,"line":523},"line",1,[520,525,527],{"class":526},"s7zQu","import",[520,529,531],{"class":530},"sTEyZ"," httpx\n",[520,533,535,538,541,545,548,550],{"class":522,"line":534},2,[520,536,537],{"class":526},"from",[520,539,540],{"class":530}," asgiref",[520,542,544],{"class":543},"sMK4o",".",[520,546,547],{"class":530},"sync ",[520,549,527],{"class":526},[520,551,552],{"class":530}," async_to_sync\n",[520,554,556,558,561,563],{"class":522,"line":555},3,[520,557,537],{"class":526},[520,559,560],{"class":530}," vatly ",[520,562,527],{"class":526},[520,564,565],{"class":530}," AsyncVatlyClient\n",[520,567,569,571,574,576,579,582],{"class":522,"line":568},4,[520,570,537],{"class":526},[520,572,573],{"class":530}," vatly_fluent ",[520,575,527],{"class":526},[520,577,578],{"class":530}," Vatly",[520,580,581],{"class":543},",",[520,583,584],{"class":530}," Wiring\n",[520,586,588],{"class":522,"line":587},5,[520,589,591],{"emptyLinePlaceholder":590},true,"\n",[520,593,595],{"class":522,"line":594},6,[520,596,