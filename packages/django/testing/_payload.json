ns\u002Fbolt","4.integrations\u002F2.bolt",{"id":488,"title":469,"body":489,"description":1815,"extension":1816,"links":1817,"meta":1818,"navigation":586,"path":470,"seo":1819,"stem":471,"__hash__":1820},"docs\u002F3.packages\u002F8.django\u002F99.testing.md",{"type":490,"value":491,"toc":1811},"minimark",[492,501,506,1132,1135,1139,1788,1796,1807],[493,494,495,496,500],"p",{},"Use Django's test database and httpx fixtures. Do not use a real Vatly key in unit\ntests. The snippets below are helpers for your pytest-django tests. Call them from\na test marked ",[497,498,499],"code",{},"@pytest.mark.django_db(transaction=True)"," with your project configured.",[502,503,505],"h2",{"id":504},"read-a-customer-with-mocktransport","Read a customer with MockTransport",[507,508,513],"pre",{"className":509,"code":510,"language":511,"meta":512,"style":512},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import httpx\nfrom asgiref.sync import async_to_sync\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\ndef example():\n    def respond(request):\n        assert request.url.path == \"\u002Fv1\u002Fcustomers\u002Fcustomer_example\"\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"customer_example\",\n                \"resource\": \"customer\",\n                \"testmode\": True,\n                \"email\": \"buyer@example.com\",\n                \"name\": \"Alex\",\n                \"metadata\": {},\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcustomers\u002Fcustomer_example\",\n                        \"type\": \"application\u002Fjson\",\n                    }\n                },\n            },\n        )\n\n    async def read_customer():\n        async with AsyncVatlyClient(\n            \"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)\n        ) as api:\n            vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n            return await vatly.customer(\"customer_example\").email()\n\n    assert async_to_sync(read_customer)() == \"buyer@example.com\"\n","python","",[497,514,515,528,549,562,581,588,593,607,626,659,676,686,695,719,740,755,776,797,812,833,848,863,885,906,912,918,924,930,935,949,963,1014,1029,1070,1102,1107],{"__ignoreMap":512},[516,517,520,524],"span",{"class":518,"line":519},"line",1,[516,521,523],{"class":522},"s7zQu","import",[516,525,527],{"class":526},"sTEyZ"," httpx\n",[516,529,531,534,537,541,544,546],{"class":518,"line":530},2,[516,532,533],{"class":522},"from",[516,535,536],{"class":526}," asgiref",[516,538,540],{"class":539},"sMK4o",".",[516,542,543],{"class":526},"sync ",[516,545,523],{"class":522},[516,547,548],{"class":526}," async_to_sync\n",[516,550,552,554,557,559],{"class":518,"line":551},3,[516,553,533],{"class":522},[516,555,556],{"class":526}," vatly ",[516,558,523],{"class":522},[516,560,561],{"class":526}," AsyncVatlyClient\n",[516,563,565,567,570,572,575,578],{"class":518,"line":564},4,[516,566,533],{"class":522},[516,568,569],{"class":526}," vatly_fluent ",[516,571,523],{"class":522},[516,573,574],{"class":526}," Vatly",[516,576,577],{"class":539},",",[516,579,580],{"class":526}," Wiring\n",[516,582,584],{"class":518,"line":583},5,[516,585,587],{"emptyLinePlaceholder":586},true,"\n",[516,589,591],{"class":518,"line":590},6,[516,592,587],{"emptyLinePlaceholder":586},[516,594,596,600,604],{"class":518,"line":595},7,[516,597,599],{"class":598},"spNyl","def",[516,601,603],{"class":602},"s2Zo4"," example",[516,605,606],{"class":539},"():\n",[516,608,610,613,616,619,623],{"class":518,"line":609},8,[516,611,612],{"class":598},"    def",[516,614,615],{"class":602}," respond",[516,617,618],{"class":539},"(",[516,620,622],{"class":621},"s