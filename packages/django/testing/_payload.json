The snippets below are helpers for your pytest-django tests. Call them from\na test marked ",[477,478,479],"code",{},"@pytest.mark.django_db(transaction=True)"," with your project configured.",[482,483,485],"h2",{"id":484},"read-a-customer-with-mocktransport","Read a customer with MockTransport",[487,488,493],"pre",{"className":489,"code":490,"language":491,"meta":492,"style":492},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import httpx\nfrom asgiref.sync import async_to_sync\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\ndef example():\n    def respond(request):\n        assert request.url.path == \"\u002Fv1\u002Fcustomers\u002Fcustomer_example\"\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"customer_example\",\n                \"resource\": \"customer\",\n                \"testmode\": True,\n                \"email\": \"buyer@example.com\",\n                \"name\": \"Alex\",\n                \"metadata\": {},\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcustomers\u002Fcustomer_example\",\n                        \"type\": \"application\u002Fjson\",\n                    }\n                },\n            },\n        )\n\n    async def read_customer():\n        async with AsyncVatlyClient(\n            \"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)\n        ) as api:\n            vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n            return await vatly.customer(\"customer_example\").email()\n\n    assert async_to_sync(read_customer)() == \"buyer@example.com\"\n","python","",[477,494,495,508,529,542,561,568,573,587,606,639,656,666,675,699,720,735,756,777,792,813,828,843,865,886