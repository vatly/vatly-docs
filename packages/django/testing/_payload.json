",{"id":479,"title":480,"body":481,"description":1806,"extension":1807,"links":1808,"meta":1809,"navigation":1810,"path":458,"seo":1811,"stem":459,"__hash__":1812},"docs\u002F3.packages\u002F8.django\u002F09.testing.md","Test billing offline",{"type":482,"value":483,"toc":1802},"minimark",[484,493,498,1124,1127,1131,1780,1787,1798],[485,486,487,488,492],"p",{},"Use Django's test database and httpx fixtures. Do not use a real Vatly key in unit\ntests. The snippets below are helpers for your pytest-django tests. Call them from\na test marked ",[489,490,491],"code",{},"@pytest.mark.django_db(transaction=True)"," with your project configured.",[494,495,497],"h2",{"id":496},"read-a-customer-with-mocktransport","Read a customer with MockTransport",[499,500,505],"pre",{"className":501,"code":502,"language":503,"meta":504,"style":504},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import httpx\nfrom asgiref.sync import async_to_sync\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\ndef example():\n    def respond(request):\n        assert request.url.path == \"\u002Fv1\u002Fcustomers\u002Fcustomer_example\"\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"customer_example\",\n                \"resource\": \"customer\",\n                \"testmode\": True,\n                \"email\": \"buyer@example.com\",\n                \"name\": \"Alex\",\n                \"metadata\": {},\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcustomers\u002Fcustomer_example\",\n                        \"type\": \"application\u002Fjson\",\n                    }\n                },\n            },\n        )\n\n    async def read_customer():\n        async with AsyncVatlyClient(\n            \"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)\n        ) as api:\n            vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n            return await vatly.customer(\"customer_example\").email()\n\n    assert async_to_sync(read_customer)() == \"buyer@example.com\"\n","python","",[489,506,507,520,541,554,573,580,585,599,618,651,668,678,687,711,732,747,768,789,804,825,840,855,877,898,904,910,916,922,927,941,955,1006,1021,1062,1094,1099],{"__ignoreMap":504},[508,509,512,516],"span",{"class":510,"line":511},"line",1,[508,513,515],{"class":514},"s7zQu","import",[508,517,519],{"class":518},"sTEyZ"," httpx\n",[508,521,523,526,529,533,536,538],{"class":510,"line":522},2,[508,524,525],{"class":514},"from",[508,527,528],{"class":518}," asgiref",[508,530,532],{"class":531},"sMK4o",".",[508,534,535],{"class":518},"sync ",[508,537,515],{"class":514},[508,539,540],{"class":518}," async_to_sync\n",[508,542,544,546,549,551],{"class":510,"line":543},3,[508,545,525],{"class":514},[508,547,548],{"class":518}," vatly ",[508,550,515],{"class":514},[508,552,553],{"class":518}," AsyncVatlyClient\n",[508,555,557,559,562,564,567,570],{"class":510,"line":556},4,[508,558,525],{"class":514},[508,560,561],{"class":518}," vatly_fluent ",[508,563,515],{"class":514},[508,565,566],{"class":518}," Vatly",[508,568,569],{"class":531},",",[508,571,572],{"class":518}," Wiring\n",[508,574,576],{"class":510,"line":575},5,[508,577,579],{"emptyLinePlaceholder":578},true,"\n",[508,581,583],{"class":510,"line":582},6,[508,584,579],{"emptyLinePlaceholder":578},[508,586,588,592,596],{"class":510,"line":587},7,[508,589,591],{"class":590},"spNyl","def",[508,593,595],{"class":594},"s2Zo4"," example",[508,597,598],{"class":531},"():\n",[508,600,602,605,608,611,615],{"class":510,"line":601},8,[508,603,604],{"class":590},"    def",[508,606,607],{"class":594}," respond",[508,609,610],{"class":531},"(",[508,612,614],{"class":613},"sHdIc","request",[