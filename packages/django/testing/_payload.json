s, idempotency key, redirect and local Checkout record.",[502,1136,1138],{"id":1137},"send-the-same-signed-event-twice","Send the same signed event twice",[507,1140,1142],{"className":509,"code":1141,"language":511,"meta":512,"style":512},"import hashlib\nimport hmac\nimport json\nimport time\nfrom django.test import Client\nfrom django.test.utils import override_settings\n\n\ndef example():\n    stamp = int(time.time())\n    secret = \"offline-test-secret\"\n    raw = json.dumps(\n        {\n            \"id\": \"event_docs\",\n            \"resource\": \"webhook_event\",\n            \"eventName\": \"future.event\",\n            \"reason\": None,\n            \"entityType\": \"future\",\n            \"entityId\": \"future_1\",\n            \"object\": {\"id\": \"future_1\"},\n            \"createdAt\": \"2026-01-01T00:00:00Z\",\n            \"testmode\": True,\n        }\n    ).encode()\n    digest = hmac.new(secret.encode(), str(stamp).encode() + b\".\" + raw, hashlib.sha256).hexdigest()\n    signature = f\"t={stamp},v1={digest}\"\n    client = Client()\n    with override_settings(VATLY_WEBHOOK_SECRET=secret):\n        first = client.post(\n            \"\u002Fbilling\u002Fwebhook\u002F\",\n            raw,\n            content_type=\"application\u002Fjson\",\n            HTTP_VATLY_SIGNATURE=signature,\n        )\n        second = client.post(\n            \"\u002Fbilling\u002Fwebhook\u002F\",\n            raw,\n            content_type=\"application\u002Fjson\",\n            HTTP_VATLY_SIGNATURE=signature,\n        )\n    assert first.content == b\"processed\"\n    assert second.content == b\"duplicate\"\n",[497,1143,1144,1151,1158,1165,1172,1189,1210,1214,1218,1226,1249,1263,1280,1285,1304,1323,1343,1357,1377,1397,1428,1446,1458,1463,1473,1548,1581,1593,1612,1629,1640,1647,1662,1674,1678,1693,1703,1710,1725,1736,1741,1765],{"__ignoreMap":512},[516,1145,1146,1148],{"class":518,"line":519},[516,1147,523],{"class":522},[516,1149,1150],{"class":526}," hashlib\n",[