ect and local Checkout record.",[494,1128,1130],{"id":1129},"send-the-same-signed-event-twice","Send the same signed event twice",[499,1132,1134],{"className":501,"code":1133,"language":503,"meta":504,"style":504},"import hashlib\nimport hmac\nimport json\nimport time\nfrom django.test import Client\nfrom django.test.utils import override_settings\n\n\ndef example():\n    stamp = int(time.time())\n    secret = \"offline-test-secret\"\n    raw = json.dumps(\n        {\n            \"id\": \"event_docs\",\n            \"resource\": \"webhook_event\",\n            \"eventName\": \"future.event\",\n            \"reason\": None,\n            \"entityType\": \"future\",\n            \"entityId\": \"future_1\",\n            \"object\": {\"id\": \"future_1\"},\n            \"createdAt\": \"2026-01-01T00:00:00Z\",\n            \"testmode\": True,\n        }\n    ).encode()\n    digest = hmac.new(secret.encode(), str(stamp).encode() + b\".\" + raw, hashlib.sha256).hexdigest()\n    signature = f\"t={stamp},v1={digest}\"\n    client = Client()\n    with override_settings(VATLY_WEBHOOK_SECRET=secret):\n        first = client.post(\n            \"\u002Fbilling\u002Fwebhook\u002F\",\n            raw,\n            content_type=\"application\u002Fjson\",\n            HTTP_VATLY_SIGNATURE=signature,\n        )\n        second = client.post(\n            \"\u002Fbilling\u002Fwebhook\u002F\",\n            raw,\n            content_type=\"application\u002Fjson\",\n            HTTP_VATLY_SIGNATURE=signature,\n        )\n    assert first.content == b\"processed\"\n    assert second.content == b\"duplicate\"\n",[489,1135,1136,1143,1150,1157,1164,1181,1202,1206,1210,1218,1241,1255,1272,1277,1296,1315,1335,1349,1369,1389,1420,1438,1450,1455,1465,1540,1573,1585,1604,1621,1632,1639,1654,1666,1670,1685,1695,1702,1717,1728,1733,1757],{"__ignoreMap":504},[508,1137,1138,1140],{"class":510,"line":511},[508,1139,515],{"class":514},[508,1141,1142],{"class":518}," hashlib\n",[508,1144,1145,1147],{"cla