h your project configured.",[478,479,481],"h2",{"id":480},"read-a-customer-with-mocktransport","Read a customer with MockTransport",[483,484,489],"pre",{"className":485,"code":486,"language":487,"meta":488,"style":488},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import httpx\nfrom asgiref.sync import async_to_sync\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\ndef example():\n    def respond(request):\n        assert request.url.path == \"\u002Fv1\u002Fcustomers\u002Fcustomer_example\"\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"customer_example\",\n                \"resource\": \"customer\",\n                \"testmode\": True,\n                \"email\": \"buyer@example.com\",\n                \"name\": \"Alex\",\n                \"metadata\": {},\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcustomers\u002Fcustomer_example\",\n                        \"type\": \"application\u002Fjson\",\n                    }\n                },\n            },\n        )\n\n    async def read_customer():\n        async with AsyncVatlyClient(\n            \"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)\n        ) as api:\n            vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n            return await vatly.customer(\"customer_example\").email()\n\n    assert async_to_sync(read_customer)() == \"buyer@example.com\"\n","python","",[473,490,491,504,525,538,557,564,569,583,602,635,652,662,671,695,716,731,752,773,788,809,824,839,861,882,888,894,900,906,911,925,939,990,1005,1046,1078,1083],{"__ignoreMap":488},[492,493,496,500],"span",{"class":494,"line":495},"line",1,[492,497,499],{"class":498},"s7z