,546],{"class":542}," pytest",[516,548,549],{"class":542}," --cov\n",[516,551,553,555,557,560,563,566,569],{"class":518,"line":552},2,[516,554,539],{"class":522},[516,556,543],{"class":542},[516,558,559],{"class":542}," python",[516,561,562],{"class":542}," -m",[516,564,565],{"class":542}," django",[516,567,568],{"class":542}," makemigrations",[516,570,572],{"class":571},"sTEyZ"," \\\n",[516,574,576,579,582],{"class":518,"line":575},3,[516,577,578],{"class":542},"  --check",[516,580,581],{"class":542}," --dry-run",[516,583,584],{"class":542}," --settings=tests.settings\n",[502,586,587],{},"Tests apply real migrations to a temporary database and use local HTTP and signed\nwebhook fixtures. They check ownership, CSRF, duplicate delivery, rollback and\nsubscription state without changing a Vatly account.",[502,589,590],{},"SQLite is the default. The PostgreSQL-only concurrency test skips locally unless\nPostgreSQL is configured; CI runs it against PostgreSQL 17.",[497,592,594],{"id":593},"check-formatting-and-types","Check formatting and types",[506,596,598],{"className":508,"code":597,"language":510,"meta":511,"style":511},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[513,599,600,615,631],{"__ignoreMap":511},[516,601,602,604,606,609,612],{"class":518,"line":519},[516,603,539],{"class":522},[516,605,543],{"class":542},[516,607,608],{"class":542}," ruff",[516,610,611],{"class":542}," check",[516,613,614],{"class":542}," .\n",[516,616,617,619,621,623,626,629],{"class":518,"line":552},[516,618,539],{"class":522},[516,620,543],{"class":542},[516,622,608],{"class":542},[516,624,625],{"class":542}," format",[516,627,628],{"class":542}," --check",[516,630,614],{"class":542},[516,632,633,635,637],{"class":518,"line":575},[516,634,539],{"class":522},[516,636,543],{"class":542},[516,638,639],{"class":542}," mypy\n",[497,641,643],{"id":642},"build-and-check-the-package","Build and check the package",[506,645,647],{"className":508,"code":646,"language":510,"meta":511,"style":511},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[513,648,649,656,673],{"__ignoreMap":511},[516,650,651,653],{"class":518,"line":519},[516,652,539],{"class":522},[516,654,655],{"class":542}," build\n",[516,657,658,660,662,665,667,670],{"class":518,"line":552},[516,659,539],{"class":522},[516,661,543],{"class":542},[516,663,664],{"class":542}," twine",[516,666,611],{"class":542},[516,668,669],{"class":542}," dist\u002F",[516,671,672],{"class":571},"*\n",[516,674,675,677,679,681],{"class":518,"line":575},[516,676,539],{"class":522},[516,678,543],{"class":542},[516,680,559],{"class":542},[516,682,683],{"class":542}," scripts\u002Fcheck_package.py\n",[502,685,686,687,690],{},"The last command installs the built wheel in a fresh environment, migrates an\nempty database and checks imports and the ",[513,688,689],{},"py.typed"," marker. None of these\ncommands publishes a package.",[497,692,694],{"id":693},"supported-versions","Supported versions",[696,697,698,711],"table",{},[699,700,701],"thead",{},[702,703,704,708],"tr",{},[705,706,707],"th",{},"Component",[705,709,710],{},"Versions checked in CI",[712,713,714,723,730],"tbody",{},[702,715,716,720],{},[717,718,719],"td",{},"Python",[717,721,722],{},"3.10–3.14",[702,724,725,727],{},[717,726,434],{},[717,728,729],{},"5.2 LTS, 6.0 and 6.1 in compatible Python combinations",[702,731,732,735],{},[717,733,734],{},"PostgreSQL",[717,736,737],{},"17, including concurrent webhook delivery",[497,739,741],{"id":740},"pinned-dependencies","Pinned dependencies",[502,743,744,747,748,751,752,755,756,759,760,763],{},[513,745,746],{},"pyproject.toml"," pins one exact ",[513,749,750],{},"vatly-api-python"," and ",[513,753,754],{},"vatly-fluent-python","\nversion from PyPI; ",[513,757,758],{},"uv.lock"," records their hashes. To move to new versions, change\nthe pins, run ",[513,761,762],{},"uv lock",", and run the full checks. Use a new alpha version when\ndependency behavior changes.",[502,765,766,767,770,771,774,775,777,778,781,782,785,786,788],{},"Until ",[513,768,769],{},"add_version_string"," ships in released SDK and Fluent versions\n(vatly\u002Fvatly-api-python#5, vatly\u002Fvatly-fluent-python#5), ",[513,772,773],{},"[tool.uv.sources]"," points\n",[513,776,539],{}," at their merge commits on ",[513,779,780],{},"main"," for development and CI. Package metadata still\npins the ",[513,783,784],{},"0.1.0a4"," releases from PyPI, where the Django token is skipped. Once both\nare released, remove the sources, pin the releases, and run ",[513,787,762],{},".",[497,790,792],{"id":791},"prepare-a-release","Prepare a release",[502,794,795,796,803,804,807],{},"The published package is ",[797,798,802],"a",{"href":799,"rel":800},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-django\u002F",[801],"nofollow","vatly-django",";\nthe import name is ",[513,805,806],{},"vatly_django",". Release matching versions in SDK → Fluent →\nDjango order, only after review and approval.",[696,809,810,820],{},[699,811,812],{},[702,813,814,817],{},[705,815,816],{},"PyPI trusted publisher field",[705,818,819],{},"Value",[712,821,822,832,841,851],{},[702,823,824,827],{},[717,825,826],{},"Owner",[717,828,829],{},[513,830,831],{},"vatly",[702,833,834,837],{},[717,835,836],{},"Repository",[717,838,839],{},[513,840,802],{},[702,842,843,846],{},[717,844,845],{},"Workflow",[717,847,848],{},[513,849,850],{},"release.yml",[702,852,853,856],{},[717,854,855],{},"Environment",[717,857,858],{},"Leave blank",[502,860,861,862,865,866,868],{},"The workflow publishes only when a GitHub release is published with a tag matching\n",[513,863,864],{},"v"," plus the package version. Pushing ",[513,867,780],{}," or running a local build does not\npublish. Restrict release access: there is no environment approval gate or PyPI\ntoken, and all PyPI artifacts are public.",[502,870,871,874,875],{},[797,872,873],{"href":470},"Offline testing examples"," · ",[797,876,442],{"href":443},[878,8