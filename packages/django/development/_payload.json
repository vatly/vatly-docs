"line":563},3,[504,565,566],{"class":530},"  --check",[504,568,569],{"class":530}," --dry-run",[504,571,572],{"class":530}," --settings=tests.settings\n",[490,574,575],{},"Tests apply real migrations to a temporary database and use local HTTP and signed\nwebhook fixtures. They check ownership, CSRF, duplicate delivery, rollback and\nsubscription state without changing a Vatly account.",[490,577,578],{},"SQLite is the default. The PostgreSQL-only concurrency test skips locally unless\nPostgreSQL is configured; CI runs it against PostgreSQL 17.",[485,580,582],{"id":581},"check-formatting-and-types","Check formatting and types",[494,584,586],{"className":496,"code":585,"language":498,"meta":499,"style":499},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[501,587,588,603,619],{"__ignoreMap":499},[504,589,590,592,594,597,600],{"class":506,"line":507},[504,591,527],{"class":510},[504,593,531],{"class":530},[504,595,596],{"class":530}," ruff",[504,598,599],{"class":530}," check",[504,601,602],{"class":530}," .\n",[504,604,605,607,609,611,614,617],{"class":506,"line":540},[504,606,527],{"class":510},[504,608,531],{"class":530},[504,610,596],{"class":530},[504,612,613],{"class":530}," format",[504,615,616],{"class":530}," --check",[504,618,602],{"class":530},[504,620,621,623,625],{"class":506,"line":563},[504,622,527],{"class":510},[504,624,531],{"class":530},[504,626,627],{"class":530}," mypy\n",[485,629,631],{"id":630},"build-and-check-the-package","Build and check the package",[494,633,635],{"className":496,"code":634,"language":498,"meta":499,"style":499},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[501,636,637,644,661],{"__ignoreMap":499},[504,638,639,641],{"class":506,"line":507},[504,640,527],{"class":510},[504,642,643],{"class":530}," build\n",[504,645,646,648,650,653,655,658],{"class":506,"line":540},[504,647,527],{"class":510},[504,649,531],{"class":530},[504,651,652],{"class":530}," twine",[504,654,599],{"class":530},[504,656,657],{"class":530}," dist\u002F",[504,659,660],{"class":559},"*\n",[504,662,663,665,667,669],{"class":506,"line":563},[504,664,527],{"class":510},[504,666,531],{"class":530},[504,668,547],{"class":530},[504,670,671],{"class":530}," scripts\u002Fcheck_package.py\n",[490,673,674,675,678],{},"The last command installs the built wheel in a fresh environment, migrates an\nempty database and checks imports and the ",[501,676,677],{},"py.typed"," marker. None of these\ncommands publishes a package.",[485,680,682],{"id":681},"supported-versions","Supported versions",[684,685,686,699],"table",{},[687,688,689],"thead",{},[690,691,692,696],"tr",{},[693,694,695],"th",{},"Component",[693,697,698],{},"Versions checked in CI",[700,701,702,711,718],"tbody",{},[690,703,704,708],{},[705,706,707],"td",{},"Python",[705,709,710],{},"3.10–3.14",[690,712,713,715],{},[705,714,422],{},[705,716,717],{},"5.2 LTS, 6.0 and 6.1 in compatible Python combinations",[690,719,720,723],{},[705,721,722],{},"PostgreSQL",[705,724,725],{},"17, including concurrent webhook delivery",[485,727,729],{"id":728},"pinned-dependencies","Pinned dependencies",[490,731,732,735,736,739,740,743,744,747,748,751],{},[501,733,734],{},"pyproject.toml"," pins one exact ",[501,737,738],{},"vatly-api-python"," and ",[501,741,742],{},"vatly-fluent-python","\nversion from PyPI; ",[501,745,746],{},"uv.lock"," records their hashes. To move to new versions, change\nthe pins, run ",[501,749,750],{},"uv lock",", and run the full checks. Use a new alpha version when\ndependency behavior changes.",[485,753,755],{"id":754},"prepare-a-release","Prepare a release",[490,757,758,759,766,767,770],{},"The published package is ",[760,761,765],"a",{"href":762,"rel":763},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-django\u002F",[764],"nofollow","vatly-django",";\nthe import name is ",[501,768,769],{},"vatly_django",". Release matching versions in SDK → Fluent →\nDjango order, only after review and approval."