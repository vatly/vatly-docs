repository",[478,479,480],"p",{},"Run commands from the repository root. On Linux or in an Amp orb:",[482,483,488],"pre",{"className":484,"code":485,"language":486,"meta":487,"style":487},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight",".agents\u002Fsetup\n","bash","",[489,490,491],"code",{"__ignoreMap":487},[492,493,496],"span",{"class":494,"line":495},"line",1,[492,497,485],{"class":498},"sBMFI",[478,500,501],{},"Setup installs uv 0.12.9 and Python 3.12, restores locked dependencies and runs\nDjango's system checks. It needs no API credentials and makes no Vatly calls.\nIt does not migrate your application's database or create test data.",[473,503,505],{"id":504},"run-tests","Run tests",[482,507,509],{"className":484,"code":508,"language":486,"meta":487,"style":487},"uv run pytest --cov\nuv run python -m django makemigrations \\\n  --check --dry-run --settings=tests.settings\n",[489,510,511,526,549],{"__ignoreMap":487},[492,512,513,516,520,523],{"class":494,"line":495},[492,514,515],{"class":498},"uv",[492,517,519],{"class":518},"sfazB"," run",[492,521,522],{"class":518}," pytest",[492,524,525],{"class":518}," --cov\n",[492,527,529,531,533,536,539,542,545],{"class":494,"line":528},2,[492,530,515],{"class":498},[492,532,519],{"class":518},[492,534,535],{"class":518}," python",[492,537,538],{"class":518}," -m",[492,540,541],{"class":518}," django",[492,543,544],{"class":518}," makemigrations",[492,546,548],{"class":547},"sTEyZ"," \\\n",[492,550,552,555,558],{"class":494,"line":551},3,[492,553,554],{"class":518},"  --check",[492,556,557],{"class":518}," --dry-run",[492,559,560],{"class":518}," --settings=tests.settings\n",[478,562,563],{},"Tests apply real migrations to a temporary database and use local HTTP and signed\nwebhook fixtures. They check ownership, CSRF, duplicate delivery, rollback and\nsubscription state without changing a Vatly account.",[478,565,566],{},"SQLite is the default. The PostgreSQL-only concurrency test skips locally unless\nPostgreSQL is configured; CI runs it against PostgreSQL 17.",[473,568,570],{"id":569},"check-formatting-and-types","Check formatting and types",[482,572,574],{"className":484,"code":573,"language":486,"meta":487,"style":487},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[489,575,576,591,607],{"__ignoreMap":487},[492,577,578,580,582,585,588],{"class":494,"line":495},[492,579,515],{"class":498},[492,581,519],{"class":518},[492,583,584],{"class":518}," ruff",[492,586,587],{"class":518}," check",[492,589,590],{"class":518}," .\n",[492,592,593,595,597,599,602,605],{"class":494,"line":528},[492,594,515],{"class":498},[492,596,519],{"class":518},[492,598,584],{"class":518},[492,600,601],{"class":518}," format",[492,603,604],{"class":518}," --check",[492,606,590],{"class":518},[492,608,609,611,613],{"class":494,"line":551},[492,610,515],{"class":498},[492,612,519],{"class":518},[492,614,615],{"class":518}," mypy\n",[473,617,619],{"id":618},"build-and-check-the-package","Build and check the package",[482,621,623],{"className":484,"code":622,"language":486,"meta":487,"style":487},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[489,624,625,632,649],{"__ignoreMap":487},[492,626,627,629],{"class":494,"line":495},[492,628,515],{"class":498},[492,630,631],{"class":518}," build\n",[492,633,634,636,638,641,643,646],{"class":494,"line":528},[492,635,515],{"class":498},[492,637,519],{"class":518},[492,639,640],{"class":518}," twine",[492,642,587],{"class":518},[492,644,645],{"class":518}," dist\u002F",[492,647,648],{"class":547},"*\n",[492,650,651,653,655,657],{"class":494,"line":551},[492,652,515],{"class":498},[492,654,519],{"class":518},[492,656,535],{"class":518},[492,658,659],{"class":518}," scripts\u002Fcheck_package.py\n",[478,661,662,663,666],{},"The last command installs the built wheel in a fresh environment, migrates an\nempty database and checks imports and the ",[489,664,665],{},"py.typed"," marker. None of these\ncommands publishes a package.",[473,668,670],{"id":669},"supported-versions","Supported versions",[672,673,674,687],"table",{},[675,676,677],"thead",{},[678,679,680,684],"tr",{},[681,682,683],"th",{},"Component",[681,685,686],{},"Versions checked in CI",[688,689,690,699,706],"tbody",{},[678,691,692,696],{},[693,694,695],"td",{},"Python",[693,697,698],{},"3.10–3.14",[678,700,701,703],{},[693,702,410],{},[693,704,705],{},"5.2 LTS, 6.0 and 6.1 in compatible Python combinations",[678,707,708,711],{},[693,709,710],{},"PostgreSQL",[693,712,713],{},"17, including concurrent webhook delivery",[473,715,717],{"id":716},"pinned-dependencies","Pinned dependencies",[478,719,720,723,724,727,728,731,732,735,736,739],{},[489,721,722],{},"pyproject.toml"," pins one exact ",[489,725,726],{},"vatly-api-python"," and ",[489,729,730],{},"vatly-fluent-python","\nversion from PyPI; ",[489,733,734],{},"uv.lock"," records their hashes. To move to new versions, change\nthe pins, run ",[489,737,738],{},"uv lock",", and run the full checks. Use a new alpha version when\ndependency behavior changes.",[473,741,743],{"id":742},"prepare-a-release","Prepare a release",[478,745,746,747,754,755,758],{},"The published package is ",[748,749,753],"a",{"href":750,"rel":751},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-django\u002F",[752],"nofollow","vatly-django",";\nthe import name is ",[489,756,757],{},"vatly_django",". Release matching versions in SDK → Fluent →\nDjango order, only after review and approval.",[672,760,761,771],{},[675,762,763],{},[678,764,765,768],{},[681,766,767],{},"PyPI trusted publisher field",[681,769,770],{},"Value",[688,772,773,783,792,802],{},[678,774,775,778],{},[693,776,777],{},"Owner",[693,779,780],{},[489,781,782],{},"vatly",[678,784,785,788],{},[693,786,787],{},"Repository",[693,789,790],{},[489,791,753],{},[678,793,794,797],{},[693,795,796],{},"Workflow",[693,798,799],{},[489,800,801],{},"release.yml",[678,803,804,807],{},[6