9],{"class":538},[512,554,555],{"class":538}," python",[512,557,558],{"class":538}," -m",[512,560,561],{"class":538}," django",[512,563,564],{"class":538}," makemigrations",[512,566,568],{"class":567},"sTEyZ"," \\\n",[512,570,572,575,578],{"class":514,"line":571},3,[512,573,574],{"class":538},"  --check",[512,576,577],{"class":538}," --dry-run",[512,579,580],{"class":538}," --settings=tests.settings\n",[498,582,583],{},"Tests apply real migrations to a temporary database and use local HTTP and signed\nwebhook fixtures. They check ownership, CSRF, duplicate delivery, rollback and\nsubscription state without changing a Vatly account.",[498,585,586],{},"SQLite is the default. The PostgreSQL-only concurrency test skips locally unless\nPostgreSQL is configured; CI runs it against PostgreSQL 17.",[493,588,590],{"id":589},"check-formatting-and-types","Check formatting and types",[502,592,594],{"className":504,"code":593,"language":506,"meta":507,"style":507},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[509,595,596,611,627],{"__ignoreMap":507},[512,597,598,600,602,605,608],{"class":514,"line":515},[512,599,535],{"class":518},[512,601,539],{"class":538},[512,603,604],{"class":538}," ruff",[512,606,607],{"class":538}," check",[512,609,610],{"class":538}," .\n",[512,612,613,615,617,619,622,625],{"class":514,"line":548},[512,614,535],{"class":518},[512,616,539],{"class":538},[512,618,604],{"class":538},[512,620,621],{"class":538}," format",[512,623,624],{"class":538}," --check",[512,626,610],{"class":538},[512,628,629,631,633],{"class":514,"line":571},[512,630,535],{"class":518},[512,632,539],{"class":538},[512,634,635],{"class":538}," mypy\n",[493,637,639],{"id":638},"build-and-check-the-package","Build and check the package",[502,641,643],{"className":504,"code":642,"language":506,"meta":507,"style":507},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[509,644,645,652,669],{"__ignoreMap":507},[512,646,647,649],{