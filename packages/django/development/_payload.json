text":741},{"id":791,"depth":552,"text":792},"Set up the repository, run checks and build the Django package locally.","md",null,{},{"title":388},{"title":492,"description":890},"kBpSRGT2ThjZolgiNre5r21t_Bzz9k_NZWQZCegWuS4",[898,900],{"title":62,"path":470,"stem":471,"description":899,"children":-1},"Use Django's test database and httpx fixtures.",{"title":476,"path":477,"stem":481,"description":901,"children":-1},"Find platform-specific guides for using Vatly as merchant of record. Connect your Lovable or Bolt app and take the next step toward your first test purchase.",1795859601713]