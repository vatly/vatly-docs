ips locally unless\nPostgreSQL is configured; CI runs it against PostgreSQL 17.",[472,567,569],{"id":568},"check-formatting-and-types","Check formatting and types",[481,571,573],{"className":483,"code":572,"language":485,"meta":486,"style":486},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[488,574,575,590,606],{"__ignoreMap":486},[491,576,577,579,581,584,587],{"class":493,"line":494},[491,578,514],{"class":497},[491,580,518],{"class":517},[491,582,583],{"class":517}," ruff",[491,585,586],{"class":517}," check",[491,588,589],{"class":517}," .\n",[491,591,592,594,596,598,601,604],{"class":493,"line":527},[491,593,514],{"class":497},[491,595,518],{"class":517},[491,597,583],{"class":517},[491,599,600],{"class":517}," format",[491,602,603],{"class":517}," --check",[491,605,589],{"class":517},[491,607,608,610,612],{"class":493,"line":550},[491,609,514],{"class":497},[491,611,518],{"class":517},[491,613,614],{"class":517}," mypy\n",[472,616,618],{"id":617},"build-and-check-the-package","Build and check the package",[481,620,622],{"className":483,"code":621,"language":485,"meta":486,"style":486},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[488,623,624,631,648],{"__ignoreMap":486},[491,625,626,628],{"class":493,"line":494},[491,627,514],{"class":497},[491,629,630],{"class":517}," build\n",[491,632,633,635,637,640,642,645],{"class":493,"line":527},[491,634,514],{"class":497},[491,636,518],{"class":517},[491,638,639],{"class":517}," twine",[491,641,586],{"class":517},[491,643,644],{"class":517}," dist\u002F",[491,646,647],{"class":546},"*\n",[491,649,650,652,654,656],{"class":493,"line":550},[491,651,514],{"class":497},[491,653,518],{"class":517},[491,655,534],{"class":517},[491,657,658],{"class":517}," scripts\u002Fcheck_package.py\n",[477,660,661,662,665],{},"The last command installs the built wheel in a fresh environment, migrates an\nempty database and checks imports and the ",[488,663,664],{},"py.typed"," marker. None of these\ncommands publishes a package.",[472,667,669],{"id":668},"supported-versions","Supported versions",[671,672,673,686],"table",{},[674,675,676],"thead",{},[677,678,679,683],"tr",{},[680,681,682],"th",{},"Component",[680,684,685],{},"Versions checked in CI",[687,688,689,698,705],"tbody",{},[677,690,691,695],{},[692,693,694],"td",{},"Python",[692,696,697],{},"3.10–3.14",[677,699,700,702],{},[692,701,409],{},[692,703,704],{},"5.2 LTS, 6.0 and 6.1 in compatible Python combinations",[677,706,707,710],{},[692,708,709],{},"PostgreSQL",[692,711,712],{},"17, including concurrent webhook delivery",[472,714,716],{"id":715},"pinned-dependencies","Pinned dependencies",[477,718,719,720,723],{},"Development uses the SDK and Fluent wheels in ",[488,721,722],{},"vendor\u002F",". Normal PyPI installs\nresolve the exact published dependencies instead. Check the pinned files before\nrefreshing them:",[481,725,727],{"className":483,"code":726,"language":485,"meta":486,"style":486},"sha256sum --check vendor\u002FSHA256SUMS\n",[488,728,729],{"__ignoreMap":486},[491,730,731,734,736],{"class":493,"line":494},[491,732,733],{"class":497},"sha256sum",[491,735,603],{"class":517},[491,737,738],{"class":517}," vendor\u002FSHA256SUMS\n",[472,740,742],{"id":741},"prepare-a-release","Prepare a release",[477,744,745,746,753,754,757],{},"The published package is ",[747,748,752],"a",{"href":749,"rel":750},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-django\u002F",[751],"nofollow","vatly-django",";\nthe import name is ",[488,755,756],{},"vatly_django",". Release matching versions in SDK → Fluent →\nDjango order, only after review and approval.",[671,759,760,770],{},[674,761,762],{},[677,763,764,767],{},[680,765,766],{},"PyPI trusted publisher field",[680,768,769],{},"Value",[687,771,772,782,791,801],{},[677,773,774,777],{},[692,775,776],{},"Owner",[692,778,779],{},[488,780,781],{},"vatly",[677,783,784,787],{},[692,785,786],{},"Repository",[692,788,789],{},[488,790,752],{},[