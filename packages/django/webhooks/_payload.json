02,703,713],{},[633,704,705],{},[636,706,707,710],{},[639,708,709],{},"Model",[639,711,712],{},"Purpose",[646,714,715,725,735,748,758],{},[636,716,717,722],{},[651,718,719],{},[494,720,721],{},"BillingScope",[651,723,724],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[636,726,727,732],{},[651,728,729],{},[494,730,731],{},"WebhookCall",[651,733,734],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[636,736,737,745],{},[651,738,739,741,742],{},[494,740,441],{},", ",[494,743,744],{},"ResourceLink",[651,746,747],{},"Immutable host-owned checkout\u002Fresource links",[636,749,750,755],{},[651,751,752],{},[494,753,754],{},"BillingResource",[651,756,757],{},"Complete financial or subscription snapshot and optional owner",[636,759,760,765],{},[651,761,762],{},[494,763,764],{},"Outbox",[651,766,767],{},"Durable events for your background worker",[485,769,770],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[485,772,773],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[503,775,777],{"id":776},"deliver-your-outbox","Deliver your outbox",[511,779,781],{"className":513,"code":780,"language":515,"meta":516,"style":516},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[494,782,783,799,803,807,816,826,851,873,918],{"__ignoreMap":516},[520,784,785,787,789,791,794,