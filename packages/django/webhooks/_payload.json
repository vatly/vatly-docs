},"webhook",[504,596,554],{"class":518},[504,598,558],{"class":550},[504,600,568],{"class":518},[504,602,571],{"class":550},[504,604,605],{"class":518},")\n",[469,607,608,609,612],{},"Pass the unmodified request body and ",[478,610,611],{},"Vatly-Signature"," header. Do not reconstruct\nJSON or trust an unsigned Vatly-Event-Id header for deduplication.",[614,615,616,629],"table",{},[617,618,619],"thead",{},[620,621,622,626],"tr",{},[623,624,625],"th",{},"Response",[623,627,628],{},"Meaning",[630,631,632,644,654,662,670],"tbody",{},[620,633,634,641],{},[635,636,637,638],"td",{},"200 ",[478,639,640],{},"processed",[635,642,643],{},"Signature accepted and transaction committed",[620,645,646,651],{},[635,647,637,648],{},[478,649,650],{},"duplicate",[635,652,653],{},"Same signed ID was already committed",[620,655,656,659],{},[635,657,658],{},"400",[635,660,661],{},"Invalid signature, JSON or envelope",[620,663,664,667],{},[635,665,666],{},"405",[635,668,669],{},"Non-POST request",[620,671,672,675],{},[635,673,674],{},"500",[635,676,677],{},"Processing failure; all writes roll back for a safe delivery retry",[469,679,680],{},"Signature freshness defaults to ±300 seconds. Keep server clocks synchronized;\nconfigure a sequence of secrets for rotation. Only this webhook route is CSRF-exempt.",[487,682,684],{"id":683},"know-what-is-stored","Know what is stored",[614,686,687,697],{},[617,688,689],{},[620,690,691,694],{},[623,692,693],{},"Model",[623,695,696],{},"Purpose",[630,698,699,709,719,732,742],{},[620,700,701,706],{},[635,702,703],{},[478,704,705],{},"BillingScope",[635,707,708],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[620,710,711,716],{},[635,712,713],{},[478,714,715],{},"WebhookCall",[635,717,718],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[620,720,721,729],{},[635,722,723,725,726],{},[478,724,425],{},", ",[478,727,728],{},"ResourceLink",[635,730,731],{},"Immutable host-owned checkout\u002Fresource links",[620,733,734,739],{},[635,735,736],{},[478,737,738],{},"BillingResource",[635,740,741],{},"Complete financial or subscription snapshot and optional owner",[620,743,744,749],{},[635,745,746],{},[478,747,748],{},"Outbox",[635,750,751],{},"Durable events for your background worker",[469,753,754],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[469,756,757],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[487,759,761],{"id":760},"deliver-your-outbox","Deliver your outbox",[495,763,765],{"className":497,"code":764,"language":499,"meta":500,"style":500},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[478,766,767,783,787,791,800,810,835,857,902],{"__ignoreMap":500},[504,768,769,771,773,775,778,780],{"class":506,"line":507},[504,770,511],{"class":510},[504,772,515],{"class":514},[504,774,519],{"class":518},[504,776,777],{"class":514},"models ",[504,779,525],{"class":510},[504,781,782],{"class":514}," Outbox\n",[504,784,785],{"class":506,"line":531},[504,786,535],{"emptyLinePlaceholder":534},[504,788,789],{"class":506,"line":538},[504,790,535],{"emptyLinePlaceholder":534},[504,792,793,795,797],{"class":506,"line":543},[504,794,547],{"class":546},[504,796,551],{"class":550},[504,798,799],{"class":518},"():\n",[504,801,802,804,807],{"class":506,"line":582},[504,803,585],{"class":510},[504,805,806],{"class"