,704],{},"Signature freshness defaults to ±300 seconds. Keep server clocks synchronized;\nconfigure a sequence of secrets for rotation. Only this webhook route is CSRF-exempt.",[511,706,708],{"id":707},"know-what-is-stored","Know what is stored",[638,710,711,721],{},[641,712,713],{},[644,714,715,718],{},[647,716,717],{},"Model",[647,719,720],{},"Purpose",[654,722,723,733,743,756,766],{},[644,724,725,730],{},[659,726,727],{},[502,728,729],{},"BillingScope",[659,731,732],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[644,734,735,740],{},[659,736,737],{},[502,738,739],{},"WebhookCall",[659,741,742],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[644,744,745,753],{},[659,746,747,749,750],{},[502,748,449],{},", ",[502,751,752],{},"ResourceLink",[659,754,755],{},"Immutable host-owned checkout\u002Fresource links",[644,757,758,763],{},[659,759,760],{},[502,761,762],{},"BillingResource",[659,764,765],{},"Complete financial or subscription snapshot and optional owner",[644,767,768,773],{},[659,769,770],{},[502,771,772],{},"Outbox",[659,774,775],{},"Durable events for your background worker",[493,777,778],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[493,780,781],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[511,783,785],{"id":784},"deliver-your-outbox","Deliver your outbox",[519,787,789],{"className":521,"code":788,"language":523,"meta":524,"style":524},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list