EyZ"," vatly_django",[532,545,547],{"class":546},"sMK4o",".",[532,549,550],{"class":542},"billing ",[532,552,553],{"class":538},"import",[532,555,556],{"class":542}," Billing\n",[532,558,560],{"class":534,"line":559},2,[532,561,563],{"emptyLinePlaceholder":562},true,"\n",[532,565,567],{"class":534,"line":566},3,[532,568,563],{"emptyLinePlaceholder":562},[532,570,572,576,580,583,587,590,594,597,600,602,605],{"class":534,"line":571},4,[532,573,575],{"class":574},"spNyl","def",[532,577,579],{"class":578},"s2Zo4"," example",[532,581,582],{"class":546},"(",[532,584,586],{"class":585},"sHdIc","raw_body",[532,588,589],{"class":546},":",[532,591,593],{"class":592},"sBMFI"," bytes",[532,595,596],{"class":546},",",[532,598,599],{"class":585}," signature",[532,601,589],{"class":546},[532,603,604],{"class":592}," str",[532,606,607],{"class":546},"):\n",[532,609,611,614,617,620,623,625,627,629,631],{"class":534,"line":610},5,[532,612,613],{"class":538},"    return",[532,615,616],{"class":578}," Billing",[532,618,619],{"class":546},"().",[532,621,622],{"class":578},"webhook",[532,624,582],{"class":546},[532,626,586],{"class":578},[532,628,596],{"class":546},[532,630,599],{"class":578},[532,632,633],{"class":546},")\n",[497,635,636,637,640],{},"Pass the unmodified request body and ",[506,638,639],{},"Vatly-Signature"," header. Do not reconstruct\nJSON or trust an unsigned Vatly-Event-Id header for deduplication.",[642,643,644,657],"table",{},[645,646,647],"thead",{},[648,649,650,654],"tr",{},[651,652,653],"th",{},"Response",[651,655,656],{},"Meaning",[658,659,660,672,682,690,698],"tbody",{},[648,661,662,669],{},[663,664,665,666],"td",{},"200 ",[506,667,668],{},"processed",[663,670,671],{},"Signature accepted and transaction committed",[648,673,674,679],{},[663,675,665,676],{},[506,677,678],{},"duplicate",[663,680,681],{},"Same signed ID was already committed",[648,683,684,687],{},[663,685,686],{},"400",[663,688,689],{},"Invalid signature, JSON or envelope",[648,691,692,695],{},[663,693,694],{},"405",[663,696,697],{},"Non-POST request",[648,699,700,703],{},[663,701,702],{},"500",[663,704,705],{},"Processing failure; all writes roll back for a safe delivery retry",[497,707,708],{},"Signature freshness defaults to ±300 seconds. Keep server clocks synchronized;\nconfigure a sequence of secrets for rotation. Only this webhook route is CSRF-exempt.",[515,710,712],{"id":711},"know-what-is-stored","Know what is stored",[642,714,715,725],{},[645,716,717],{},[648,718,719,722],{},[651,720,721],{},"Model",[651,723,724],{},"Purpose",[658,726,727,737,747,760,770],{},[648,728,729,734],{},[663,730,731],{},[506,732,733],{},"BillingScope",[663,735,736],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[648,738,739,744],{},[663,740,741],{},[506,742,743],{},"WebhookCall",[663,745,746],{},"Signed event ID, name, entity and processed timestamp, unique per scope\u002Fevent",[648,748,749,757],{},[663,750,751,753,754],{},[506,752,453],{},", ",[506,755,756],{},"ResourceLink",[663,758,759],{},"Immutable host-owned checkout\u002Fresource links",[648,761,762,767],{},[663,763,764],{},[506,765,766],{},"BillingResource",[663,768,769],{},"Complete financial or subscription snapshot and optional owner",[648,771,772,777],{},[663,773,774],{},[506,775,776],{},"Outbox",[663,778,779],{},"Durable events for your background worker",[497,781,782],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[497,784,785],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[515,787,789],{"id":788},"deliver-your-outbox","Deliver your outbox",[523,791,793],{"className":525,"code":792,"language":527,"meta":528,"style":528},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[506,794,795,811,815,819,828,838,863,885,930],{"__ignoreMap":528},[532,796,797,799,801,803,806,808],{"class":534,"line":535},[532,798,539],{"class":538},[532,800,543],{"class":542},[532,802,547],{"class":546},[532,804,805],{"class":542},"models ",[532,807,553],{"class":538},[532,809,810],{"class":542}," Outbox\n",[532,812,813],{"class":534,"line":559},[532,814,563],{"emptyLinePlaceholder":562},[532,816,817],{"class":534,"line":566},[532,818,563],{"emptyLinePlaceholder":562},[532,820,821,823,825],{"class":534,"line":571},[532,822,575],{"class":574},[532,824,579],{"class":578},[532,826,827],{"class":546},"():\n",[532,829,830,832,835],{"class":534,"line":610},[532,831,613],{"class":538},[532,833,834],{"class":592}," list",[532,836,837],{"class":546},"(\n",[532,839,841,844,846,850,852,855,857,860],{"class":534,"line":840},6,[532,842,843],{"class":578},"        Outbox",[532,845,547],{"class":546},[532,847,849],{"class":848},"swJcz","objects",[532,851,547],{"class":546},[532,853,854],{"class":578},"filter",[532,856,582],{"class":546},[532,858,859],{"class":585},"delivered_at__isnull",[532,861,862],{"class":546},"=True)\n",[532,864,866,869,872,874,877,881,883],{"class":534,"line":865},7,[532,867,868],{"class":546},"        .",[532,870,871],{"class":578},"order_by",[532,873,582],{"class":546},[532,875,876],{"class":546},"\"",[532,878,880],{"class":879},"sfazB","pk",[532,882,876],{"class":546},[532,884,633],{"class":546},[532,886,888,890,893,895,897,899,901,903,906,909,911,913,915,918,920,923,927],{"class":534,"line":887},8,[532,889,868],{"class":546},[532,891,892],{"class":578},"values",[532,894,582],{"class":546},[532,896,876],{"class":546},[532,898,880],{"class":879},[532,900,876],{"class":546},[532,902,596],{"class":546},[532,904,905],{"class":546}," \"",[532,907,908],{"class":879},"event_name",[532,910,876],{"class":546},[532,912,596],{"class":546},[532,914,905],{"class":546},[532,916,917],{"class":879},"payload",[532,919,876],{"class":546},[532,921,922],{"class":546},")[:",[532,924,926],{"class":925},"sbssI","100",[532,928,929],{"class":546},"]\n",[532,931,933],{"class":534,"line":932},9,[532,934,935],{"class":546},"    )\n",[497,937,938],{},"This is an inspection query, not a safe concurrent worker. Your worker must claim\nrows with database locks, send using an idempotent key (scope + row primary key),\nand mark delivered_at after success. External delivery is at least once. Created\nevents can precede ownership linkage: read current ownership before side effects.\nNo email sender or entitlement side effect is enabled by default.",[515,940,942],{"id":941},"prune-old-rows","Prune old rows",[497,944,945,946,949],{},"Schedule ",[506,947,948],{},"vatly_prune"," daily, for example from cron:",[523,951,955],{"className":952,"code":953,"language":954,"meta":528,"style":528},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","python manage.py vatly_prune\n","bash",[506,956,957],{"__ignoreMap":528},[532,958,959,961,964],{"class":534,"line":535},[532,960,527],{"class":592},[532,962,963],{"class":879}," manage.py",[532,965,966],{"class":879}," vatly_prune\n",[497,968,969,970,973,974,977,978,981],{},"It deletes webhook calls processed and outbox rows delivered more than 30 days ago\nand keeps undelivered outbox rows. Set ",[506,971,972],{},"VATLY_RETENTION_DAYS"," (or pass ",[506,975,976],{},"--days",")\nto change the window; ",[506,979,980],{},"0"," deletes nothing. Webhook calls store only the event ID,\nname and entity, not the resource. The command also reduces envelopes stored by\nearlier versions to those IDs. Outbox payloads keep the full resource for your\nworker, so prune delivered rows.",[497,983,984,989,990],{},[501,985,305],{"href":986,"rel":987},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[988],"nofollow"," · ",[501,991,466],{"href":467},[993,994,995],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHdIc, html code.shiki .sHdIc{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#EEFFFF;--shiki-default-font-style:italic;--shiki-dark:#BABED8;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-defa