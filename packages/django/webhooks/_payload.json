585},5,[507,587,588],{"class":513},"    return",[507,590,591],{"class":553}," Billing",[507,593,594],{"class":521},"().",[507,596,597],{"class":553},"webhook",[507,599,557],{"class":521},[507,601,561],{"class":553},[507,603,571],{"class":521},[507,605,574],{"class":553},[507,607,608],{"class":521},")\n",[472,610,611,612,615],{},"Pass the unmodified request body and ",[481,613,614],{},"Vatly-Signature"," header. Do not reconstruct\nJSON or trust an unsigned Vatly-Event-Id header for deduplication.",[617,618,619,632],"table",{},[620,621,622],"thead",{},[623,624,625,629],"tr",{},[626,627,628],"th",{},"Response",[626,630,631],{},"Meaning",[633,634,635,647,657,665,673],"tbody",{},[623,636,637,644],{},[638,639,640,641],"td",{},"200 ",[481,642,643],{},"processed",[638,645,646],{},"Signature accepted and transaction committed",[623,648,649,654],{},[638,650,640,651],{},[481,652,653],{},"duplicate",[638,655,656],{},"Same signed ID was already committed",[623,658,659,662],{},[638,660,661],{},"400",[638,663,664],{},"Invalid signature, JSON or envelope",[623,666,667,670],{},[638,668,669],{},"405",[638,671,672],{},"Non-POST request",[623,674,675,678],{},[638,676,677],{},"500",[638,679,680],{},"Processing failure; all writes roll back for a safe delivery retry",[472,682,683],{},"Signature freshness defaults to ±300 seconds. Keep server clocks synchronized;\nconfigure a sequence of secrets for rotation. Only this webhook route is CSRF-exempt.",[490,685,687],{"id":686},"know-what-is-stored","Know what is stored",[617,689,690,700],{},[620,691,692],{},[623,693,694,697],{},[626,695,696],{},"Model",[626,698,699],{},"Purpose",[633,701,702,712,722,735,745],{},[623,703,704,709],{},[638,705,706],{},[481,707,708],{},"BillingScope",[638,710,711],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[623,713,714,719],{},[638,715,716],{},[481,717,718],{},"WebhookCall",[638,720,721],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[623,723,724,732],{},[638,725,726,728,729],{},[481,727,428],{},", ",[481,730,731],{},"ResourceLink",[638,733,734],{},"Immutable host-owned checkout\u002Fresource links",[623,736,737,742],{},[638,738,739],{},[481,740,741],{},"BillingResource",[638,743,744],{},"Complete financial or subscription snapshot and optional owner",[623,746,747,752],{},[638,748,749],{},[481,750,751],{},"Outbox",[638,753,754],{},"Durable events for your background worker",[472,756,757],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[472,759,760],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[490,762,764],{"id":763},"deliver-your-outbox","Deliver your outbox",[498,766,768],{"className":500,"code":767,"language":502,"meta":503,"style":503},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[481,769,770,786,790,794,803,813,838,860,905],{"__ignoreMap":503},[507,771,772,774,776,778,781,783],{"class":509,"line":510},[507,773,514],{"class":513},[507,775,518],{"class":517},[507,777,522],{"class":521},[507,779,780],{"class":517},"models ",[507,782,528],{"class":513},[507,784,785],{"class":517}," Outbox\n",[507,787,788],{"class":509,"line":534},[507,789,538],{"emptyLinePlaceholder":537},[507,791,792],{"class":509,"line":541},[507,793,538],{"emptyLinePlaceholder":537},[507,795,796,798,800],{"class":509,"line":546},[507,797,550],{"class":549},[507,799,554],