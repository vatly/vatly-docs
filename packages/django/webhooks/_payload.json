class":510,"line":586},5,[508,588,589],{"class":514},"    return",[508,591,592],{"class":554}," Billing",[508,594,595],{"class":522},"().",[508,597,598],{"class":554},"webhook",[508,600,558],{"class":522},[508,602,562],{"class":554},[508,604,572],{"class":522},[508,606,575],{"class":554},[508,608,609],{"class":522},")\n",[473,611,612,613,616],{},"Pass the unmodified request body and ",[482,614,615],{},"Vatly-Signature"," header. Do not reconstruct\nJSON or trust an unsigned Vatly-Event-Id header for deduplication.",[618,619,620,633],"table",{},[621,622,623],"thead",{},[624,625,626,630],"tr",{},[627,628,629],"th",{},"Response",[627,631,632],{},"Meaning",[634,635,636,648,658,666,674],"tbody",{},[624,637,638,645],{},[639,640,641,642],"td",{},"200 ",[482,643,644],{},"processed",[639,646,647],{},"Signature accepted and transaction committed",[624,649,650,655],{},[639,651,641,652],{},[482,653,654],{},"duplicate",[639,656,657],{},"Same signed ID was already committed",[624,659,660,663],{},[639,661,662],{},"400",[639,664,665],{},"Invalid signature, JSON or envelope",[624,667,668,671],{},[639,669,670],{},"405",[639,672,673],{},"Non-POST request",[624,675,676,679],{},[639,677,678],{},"500",[639,680,681],{},"Processing failure; all writes roll back for a safe delivery retry",[473,683,684],{},"Signature freshness defaults to ±300 seconds. Keep server clocks synchronized;\nconfigure a sequence of secrets for rotation. Only this webhook route is CSRF-exempt.",[491,686,688],{"id":687},"know-what-is-stored","Know what is stored",[618,690,691,701],{},[621,692,693],{},[624,694,695,698],{},[627,696,697],{},"Model",[627,699,700],{},"Purpose",[634,702,703,713,723,736,746],{},[624,704,705,710],{},[639,706,707],{},[482,708,709],{},"BillingScope",[639,711,712],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[624,714,715,720],{},[639,716,717],{},[482,718,719],{},"WebhookCall",[639,721,722],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[624,724,725,733],{},[639,726,727,729,730],{},[482,728,429],{},", ",[482,731,732],{},"ResourceLink",[639,734,735],{},"Immutable host-owned checkout\u002Fresource links",[624,737,738,743],{},[639,739,740],{},[482,741,742],{},"BillingResource",[639,744,745],{},"Complete financial or subscription snapshot and optional owner",[624,747,748,753],{},[639,749,750],{},[482,751,752],{},"Outbox",[639,754,755],{},"Durable events for your background worker",[473,757,758],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[473,760,761],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[491,763,765],{"id":764},"deliver-your-outbox","Deliver your outbox",[499,767,769],{"className":501,"code":768,"language":503,"meta":504,"style":504},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[482,770,771,787,791,795,804,814,839,861,906],{"__ignoreMap":504},[508,772,773,775,777,779,782,784],{"class":510,"line":511},[508,774,515],{"class":514},[508,776,519],{"class":518},[508,778,523],{"class":522},[508,780,781],{"class":518},"models ",[508,783,529],{"class":514},[508,785,786],{"class":518}," Outbox\n",[508,788,789],{"class":510,"line":535},[508,790,539],{"emptyLinePlaceholder":538},[508,792,793],{"class":510,"line":542},[508,794,539],{"emptyLinePlaceholder":538},[508,796,797,799,801],{"class":510,"line":547},[508,798,551],{"class":5