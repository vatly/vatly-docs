stored",[638,710,711,721],{},[641,712,713],{},[644,714,715,718],{},[647,716,717],{},"Model",[647,719,720],{},"Purpose",[654,722,723,733,743,757,767],{},[644,724,725,730],{},[659,726,727],{},[502,728,729],{},"BillingScope",[659,731,732],{},"Tenant\u002Fstorefront and mode; serializes callbacks with a database write lock",[644,734,735,740],{},[659,736,737],{},[502,738,739],{},"WebhookCall",[659,741,742],{},"Signed envelope and processed timestamp, unique per scope\u002Fevent",[644,744,745,754],{},[659,746,747,750,751],{},[502,748,749],{},"Checkout",", ",[502,752,753],{},"ResourceLink",[659,755,756],{},"Immutable host-owned checkout\u002Fresource links",[644,758,759,764],{},[659,760,761],{},[502,762,763],{},"BillingResource",[659,765,766],{},"Complete financial or subscription snapshot and optional owner",[644,768,769,774],{},[659,770,771],{},[502,772,773],{},"Outbox",[659,775,776],{},"Durable events for your background worker",[493,778,779],{},"Audit, dedup, links, snapshots and outbox commit in one transaction. The ORM driver\nuses thread-sensitive async adapters so all nested work stays on that connection.\nIt assumes Django's default database; custom routers need a purpose-built driver.\nPostgreSQL supports concurrent workers; SQLite delivery lock failures can be retried.",[493,781,782],{},"Built-ins make no implicit API reads. Unknown events remain audited\u002Fdispatched.\nCustomer bindings never fill missing ownership, and deduplication is not event\nordering. Reconcile delayed\u002Fconflicting snapshots explicitly.",[511,784,786],{"id":785},"deliver-your-outbox","Deliver your outbox",[519,788,790],{"className":521,"code":789,"language":523,"meta":524,"style":524},"from vatly_django.models import Outbox\n\n\ndef example():\n    return list(\n        Outbox.objects.filter(delivered_at__isnull=True)\n        .order_by(\"pk\")\n        .values(\"pk\", \"event_name\", \"payload\")[:100]\n    )\n",[502,791,792,808,812,816,825,835,860,882,927],{"__ignoreMap":524},[528,793,794,796,798,800,803,805],{"class":530,"line":531},[528,795,535],{"class":534},[528,797,539],{"class":538},[528,799,543],{"class":542},[528,801,802],{"class":538},"models ",[528,804,549],{"class":534},[528,806,807],{"class":538}," Outbox\n",[528,809,810],{"class":530,"line":555},[528,811,559],{"emptyLinePlaceholder":558},[528,813,814],{"class":530,"line":562},[528,815,559],{"emptyLinePlaceholder":558},[528,817,818,820,822],{"class":530,"line":567},[528,819,571],{"class":570},[528,821,575],{"class":574},[528,823,824],{"class":542},"():\n",[528,826,827,829,832],{"class":530,"line":606},[528,828,609],{"class":534},[528,830,831],{"class":588}," list",[528,833,834],{"class":542},"(\n",[528,836,838,841,843,847,849,852,854,857],{"class":530,"line":837},6,[528,839,840],{"class":574},"        Outbox",[528,842,543],{"class":542},[528,844,846],{"class":845},"swJcz","objects",[528,848,543],{"class":542},[528,850,851],{"class":574},"filter",[528,853,578],{"class":542},[528,855,856],{"class":581},"delivered_at__isnull",[528,858,859],{"class":542},"=True)\n",[528,861,863,866,869,871,874,878,880],{"class":530,"line":862},7,[528,864,865],{"class":542},"        .",[528,867,868],{"class":574},"order_by",[528,870,578],{"class":542},[528,872,873],{"class":542},"\"",[528,875,877],{"class":876},"sfazB","pk",[528,879,873],{"class":542},[528,881,629],{"class":542},[528,883,885,887,890,892,894,896,898,900,903,906,908,910,912,915,917,920,924],{"class":530,"line":884},8,[528,886,865],{"class":542},[528,888,889],{"class":574},"values",[528,891,578],{"class":542},[528,893,873],{"class":542},[528,895,877],{"class":876},[528,897,873],{"class":542},[528,899,592],{"class":542},[528,901,902],{"class":542}," \"",[528,904,905],{"class":876},"event_name",[528,907,873],{"class":542},[528,909,592],{"class":542},[528,911,902],{"class":542},[528,913,914],{"class":876},"payload",[528,916,873],{"class":542},[528,918,919],{"class":542},")[:",[528,921,923],{"class":922},"sbssI","100",[528,925,926],{"class":542},"]\n",[528,928,930],{"class":530,"line":929},9,[528,931,932],{"class":542},"    )\n",[493,934,935],{},"This is an inspection query, not a safe concurrent worker. Your worker must claim\nrows with database locks, send using an idempotent key (scope + row primary key),\nand mark delivered_at after success. External delivery is at least once. Created\nevents can precede ownership linkage: read current ownership before side effects.\nNo email sender or entitlement side effect is enabled by default.",[493,937,938,943,944],{},[497,939,334],{"href":940,"rel":941},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[942],"nofollow"," · ",[497,945,946],{"href":439},"Admin",[948,949,950],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHdIc, html code.shiki .sHdIc{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#EEFFFF;--shiki-default-font-style:italic;--shiki-dark:#BABED8;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);