s None. Use Fluent\u002FSDK RequestOptions directly\nwhen your mutation workflow needs an explicit stable idempotency key.",[497,945,947],{"id":946},"reconcile-a-known-checkout","Reconcile a known checkout",[502,949,951],{"className":504,"code":950,"language":506,"meta":507,"style":507},"from vatly_django.billing import Billing\n\n\ndef example(billable):\n    result = Billing().reconcile(billable, \"checkout_example\")\n    return result.pending_subscription_ids, result.legacy_plan_ids\n",[509,952,953,967,971,975,987,1018],{"__ignoreMap":507},[512,954,955,957,959,961,963,965],{"class":514,"line":515},[512,956,519],{"class":518},[512,958,523],{"class":522},[512,960,527],{"class":526},[512,962,530],{"class":522},[512,964,533],{"class":518},[512,966,536],{"class":522},[512,968,969],{"class":514,"line":539},[512,970,543],{"emptyLinePlaceholder":542},[512,972,973],{"class":514,"line":546},[512,974,543],{"emptyLinePlaceholder":542},[512,976,977,979,981,983,985],{"class":514,"line":551},[512,978,555],{"class":554},[512,980,559],{"class":558},[512,982,562],{"class":526},[512,984,566],{"class":565},[512,986,569],{"class":526},[512,988,989,992,995,998,1000,1003,1005,1007,1009,1011,1014,1016],{"class":514,"line":572},[512,990,991],{"class":522},"    result ",[512,993,994],{"class":526},"=",[512,996,997],{"class":558}," Billing",[512,999,591],{"class":526},[512,1001,1002],{"class":558},"reconcile",[512,1004,562],{"class":526},[512,1006,566],{"class":558},[512,1008,601],{"class":526},[512,1010,604],{"class":526},[512,1012,1013],{"class":607},"checkout_example",[512,1015,611],{"class":526},[512,1017,647],{"class":526},[512,1019,1020,1022,1025,1027,1031,1033,1035,1037],{"class":514,"line":585},[512,1021,575],{"class":518},[512,1023,1024],{"class":522}," result",[512,1026,527],{"class":526},[512,1028,1030],{"class":1029},"swJcz","pending_subscription_ids",[512,1032,601],{"class":526},[512,1034,1024],{"class":522},[512,1036,527],{"class":526},[512,1038,1039],{"class":1029},"legacy_