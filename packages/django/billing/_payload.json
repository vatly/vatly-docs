530},[516,1014,608],{"class":530},[516,1016,1017],{"class":611},"checkout_example",[516,1019,615],{"class":530},[516,1021,651],{"class":530},[516,1023,1024],{"class":518,"line":589},[516,1025,1027],{"class":1026},"sHwdD","    # Schedule a bounded later reconcile while either tuple is not empty.\n",[516,1029,1030,1032,1035,1037,1041,1043,1045,1047],{"class":518,"line":654},[516,1031,579],{"class":522},[516,1033,1034],{"class":526}," result",[516,1036,531],{"class":530},[516,1038,1040],{"class":1039},"swJcz","unresolved_line_ids",[516,1042,605],{"class":530},[516,1044,1034],{"class":526},[516,1046,531],{"class":530},[516,1048,1049],{"class":1039},"pending_subscription_ids\n",[497,1051,1052],{},"The facade checks the checkout's host record, performs bounded API reads and\npersists snapshots\u002Flinks transactionally. This may hold the scope lock during\nreads; run it in a worker for busy deployments. It emits no created outbox event.",[497,1054,1055,1056,1059],{},"Signup lines reference their plan and name their subscription in\n",[513,1057,1058],{},"relatedResources.subscriptionId","; renewal lines reference the subscription as\ntheir product. Both link the subscription to the checkout's billable.",[659,1061,1062,1074],{},[662,1063,1064],{},[665,1065,1066,1069,1071],{},[668,1067,1068],{},"Result field",[668,1070,673],{},[668,1072,1073],{},"What to do",[675,1075,1076,1089,1102,1118],{},[665,1077,1078,1083,1086],{},[680,1079,1080],{},[513,1081,1082],{},"subscriptions",[680,1084,1085],{},"Linked and stored subscriptions",[680,1087,1088],{},"Nothing",[665,1090,1091,1096,1099],{},[680,1092,1093],{},[513,1094,1095],{},"pending_subscription_ids",[680,1097,1098],{},"Referenced, but not readable yet",[680,1100,1101],{},"Reconcile again later",[665,1103,1104,1108,1115],{},[680,1105,1106],{},[513,1107,1040],{},[680,1109,1110,1111,1114],{},"Signup lines whose ",[513,1112,1113],{},"subscriptionId"," is still null",[680,1116,1117],{},"Reconcile again later; it may never resolve",[665,1119,1120,1125,1131],{},[680,1121,1122],{},[513,1123,1124],{},"legacy_plan_ids",[680,1126,1127,1128],{},"Plan lines on historical orders without ",[513,1129,1130],{},"relatedResources",[680,1132,1133],{},"Resolve manually",[497,1135,1136,1137,1140,1141,1143,1144,1146],{},"A signed ",[513,1138,1139],{},"order.paid"," snapshot is frozen when it is sent and can carry a null\n",[513,1142,1113],{},", so the first order may still need an explicit reconcile. Schedule\na bounded number of later reconciles while ",[513,1145,1040],{}," is not empty.\nNever guess by customer\u002Fplan\u002Fquantity. Missing subscription IDs remain pending,\nnot entitled. Trial flows may lack an order.paid event.",[497,1148,1149,1150,1153,1154,1161],{},"Grace expiry uses Fluent's shared mapper. ",[513,1151,1152],{},"canceledAt"," is the request time.\nMissing or ambiguous period deadlines raise and retain the prior committed state;\nmonitor and reconcile instead of inventing an expiry. Active snapshots clear stale\nends after resume. ",[1155,1156,1160],"a",{"href":1157,"rel":1158},"https:\u002F\u002Fdocs.vatly.com\u002Fpackages\u002Ffluent-python\u002Fsubscriptions",[1159],"nofollow","Fluent's guide","\ndescribes this policy and its limits.",[497,1163,1164],{},[1155,1165,1168],{"href":1166,"rel":1167},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference\u002Fsubscriptions",[1159],"Subscription API reference",[1170,1171,1172],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C7