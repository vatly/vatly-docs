ne":585},[512,1021,1023],{"class":1022},"sHwdD","    # Schedule a bounded later reconcile while either tuple is not empty.\n",[512,1025,1026,1028,1031,1033,1037,1039,1041,1043],{"class":514,"line":650},[512,1027,575],{"class":518},[512,1029,1030],{"class":522}," result",[512,1032,527],{"class":526},[512,1034,1036],{"class":1035},"swJcz","unresolved_line_ids",[512,1038,601],{"class":526},[512,1040,1030],{"class":522},[512,1042,527],{"class":526},[512,1044,1045],{"class":1035},"pending_subscription_ids\n",[493,1047,1048],{},"The facade checks the checkout's host record, performs bounded API reads and\npersists snapshots\u002Flinks transactionally. This may hold the scope lock during\nreads; run it in a worker for busy deployments. It emits no created outbox event.",[493,1050,1051,1052,1055],{},"Signup lines reference their plan and name their subscription in\n",[509,1053,1054],{},"relatedResources.subscriptionId","; renewal lines reference the subscription as\ntheir product. Both link the subscription to the checkout's billable.",[655,1057,1058,1070],{},[658,1059,1060],{},[661,1061,1062,1065,1067],{},[664,1063,1064],{},"Result field",[664,1066,669],{},[664,1068,1069],{},"What to do",[671,1071,1072,1085,1098,1114],{},[661,1073,1074,1079,1082],{},[676,1075,1076],{},[509,1077,1078],{},"subscriptions",[676,1080,1081],{},"Linked and stored subscriptions",[676,1083,1084],{},"Nothing",[661,1086,1087,1092,1095],{},[676,1088,1089],{},[509,1090,1091],{},"pending_subscription_ids",[676,1093,1094],{},"Referenced, but not readable yet",[676,1096,1097],{},"Reconcile again later",[661,1099,1100,1104,1111],{},[676,1101,1102],{},[509,1103,1036],{},[676,1105,1106,1107,1110],{},"Signup lines whose ",[509,1108,1109],{},"subscriptionId"," is still null",[676,1112,1113],{},"Reconcile again later; it may never resolve",[661,1115,1116,1121,1127],{},[676,1117,1118],{},[509,1119,1120],{},"legacy_plan_ids",[676,1122,1123,1124],{},"Plan lines on historical orders without ",[509,1125,1126],{},"relatedResources",[676,1128,1129],{},"Resolve manually",[493,1131,1132,1133,1136,1137,1139,1140,1142],{},"A signed ",[509,1134,1135],{},"order.paid"," snapshot is frozen when it is sent and can carry a null\n",[509,1138,1109],{},", so the first order may still need an explicit reconcile. Schedule\na bounded number of later reconciles while ",[509,1141,1036],{}," is not empty.\nNever guess by customer\u002Fplan\u002Fquantity. Missing subscription IDs remain pending,\nnot entitled. Trial flows may lack an order.paid event.",[493,1144,1145,1146,1149,1150,1157],{},"Grace expiry uses Fluent's shared mapper. ",[509,1147,1148],{},"canceledAt"," is the request time.\nMissing or ambiguous period deadlines raise and retain the prior committed state;\nmonitor and reconcile instead of inventing an expiry. Active snapshots clear stale\nends after resume. ",[1151,1152,1156],"a",{"href":1153,"rel":1154},"https:\u002F\u002Fdocs.vatly.com\u002Fpackages\u002Ffluent-python\u002Fsubscriptions",[1155],"nofollow","Fluent's guide","\ndescribes this policy and its limits.",[493,1159,1160],{},[1151,1161,1164],{"href":1162,"rel":1163},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference\u002Fsubscriptions",[1155],"Subscription API reference",[1166,1167,1168],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHdIc, html code.shiki .sHdIc