59,560,561,565],"tr",{},[562,563,564],"th",{},"Guide",[562,566,567],{},"Task",[569,570,571,581,590,599,608,617,626,635,644,653],"tbody",{},[559,572,573,578],{},[574,575,576],"td",{},[545,577,438],{"href":439},[574,579,580],{},"Install, connect URLs and run migrations",[559,582,583,587],{},[574,584,585],{},[545,586,194],{"href":442},[574,588,589],{},"Set credentials, offers and tenant scope",[559,591,592,596],{},[574,593,594],{},[545,595,445],{"href":446},[574,597,598],{},"Add billing helpers to your user or team model",[559,600,601,605],{},[574,602,603],{},[545,604,449],{"href":450},[574,606,607],{},"Start a purchase with a durable retry key",[559,609,610,614],{},[574,611,612],{},[545,613,214],{"href":456},[574,615,616],{},"Open hosted billing for an authorized customer",[559,618,619,623],{},[574,620,621],{},[545,622,88],{"href":453},[574,624,625],{},"Inspect, cancel, resume and reconcile owned subscriptions",[559,627,628,632],{},[574,629,630],{},[545,631,50],{"href":459},[574,633,634],{},"Verify, deduplicate and persist deliveries atomically",[559,636,637,641],{},[574,638,639],{},[545,640,462],{"href":463},[574,642,643],{},"Inspect billing records without editing them",[559,645,646,650],{},[574,647,648],{},[545,649,58],{"href":466},[574,651,652],{},"Exercise checkout and signed webhooks offline",[559,654,655,659],{},[574,656,657],{},[545,658,384],{"href":469},[574,660,661],{},"Run contributor checks and understand release tooling",[492,663,664,665,670],{},"Python 3.10+; Django 5.2 LTS, 6.0 and 6.1 within their supported Python ranges.\nCode samples are executed with the published packages and local fixtures.\nSee the ",[545,666,301],{"href":667,"rel":668},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[669],"nofollow"," for Vatly's fields.",[672,673,674],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--sh