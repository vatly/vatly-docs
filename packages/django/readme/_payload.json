You do not\nneed a custom user model: the ",[518,553,554],{},"Billing"," facade accepts any saved Django model.",[557,558,559,572],"table",{},[560,561,562],"thead",{},[563,564,565,569],"tr",{},[566,567,568],"th",{},"Guide",[566,570,571],{},"Task",[573,574,575,585,594,603,612,621,630,639,648,657],"tbody",{},[563,576,577,582],{},[578,579,580],"td",{},[549,581,442],{"href":443},[578,583,584],{},"Install, connect URLs and run migrations",[563,586,587,591],{},[578,588,589],{},[549,590,198],{"href":446},[578,592,593],{},"Set credentials, offers and tenant scope",[563,595,596,600],{},[578,597,598],{},[549,599,449],{"href":450},[578,601,602],{},"Add billing helpers to your user or team model",[563,604,605,609],{},[578,606,607],{},[549,608,453],{"href":454},[578,610,611],{},"Start a purchase with a durable retry key",[563,613,614,618],{},[578,615,616],{},[549,617,218],{"href":460},[578,619,620],{},"Open hosted billing for an authorized customer",[563,622,623,627],{},[578,624,625],{},[549,626,92],{"href":457},[578,628,629],{},"Inspect, cancel, resume and reconcile owned subscriptions",[563,631,632,636],{},[578,633,634],{},[549,635,54],{"href":463},[578,637,638],{},"Verify, deduplicate and persist deliveries atomically",[563,640,641,645],{},[578,642,643],{},[549,644,466],{"href":467},[578,646,647],{},"Inspect billing records without editing them",[563,649,650,654],{},[578,651,652],{},[549,653,62],{"href":470},[578,655,656],{},"Exercise checkout and signed webhooks offline",[563,658,659,663],{},[578,660,661],{},[549,662,388],{"href":473},[578,664,665],{},"Run contributor checks and understand release tooling",[496,667,668,669,674],{},"Python 3.10+; Django 5.2 LTS, 6.0 and 6.1 within their supported Python ranges.\nCode samples are executed with the published packages and local fixtures.\nSee the ",[549,670,305],{"href":671,"rel":672},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[673],"nofollow"," for Vatly's fields.",[676,677,678],"style",{},"html pre.shiki code .sBMFI