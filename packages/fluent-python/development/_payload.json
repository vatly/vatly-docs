fline examples"," for host tests.",[493,555,557],{"id":556},"check-formatting-and-types","Check formatting and types",[502,559,561],{"className":504,"code":560,"language":506,"meta":507,"style":507},"uv run ruff check .\nuv run ruff format --check .\nuv run mypy\n",[509,562,563,578,595],{"__ignoreMap":507},[512,564,565,567,569,572,575],{"class":514,"line":515},[512,566,535],{"class":518},[512,568,539],{"class":538},[512,570,571],{"class":538}," ruff",[512,573,574],{"class":538}," check",[512,576,577],{"class":538}," .\n",[512,579,581,583,585,587,590,593],{"class":514,"line":580},2,[512,582,535],{"class":518},[512,584,539],{"class":538},[512,586,571],{"class":538},[512,588,589],{"class":538}," format",[512,591,592],{"class":538}," --check",[512,594,577],{"class":538},[512,596,598,600,602],{"class":514,"line":597},3,[512,599,535],{"class":518},[512,601,539],{"class":538},[512,603,604],{"class":538}," mypy\n",[498,606,607],{},"CI runs tests and these checks on Python 3.10–3.14. Type checks also include the\nexample storage driver.",[493,609,611],{"id":610},"build-and-check-the-package","Build and check the package",[502,613,615],{"className":504,"code":614,"language":506,"meta":507,"style":507},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[509,616,617,624,642],{"__ignoreMap":507},[512,618,619,621],{"class":514,"line":515},[512,620,535],{"class":518},[512,622,623],{"class":538}," build\n",[512,625,626,628,630,633,635,638],{"class":514,"line":580},[512,627,535],{"class":518},[512,629,539],{"class":538},[512,631,632],{"class":538}," twine",[512,634,574],{"class":538},[512,636,637],{"class":538}," dist\u002F",[512,639,641],{"class":640},"sTEyZ","*\n",[512,643,644,646,648,651],{"class":514,"line":597},[512,645,535],{"class":518},[512,647,539],{"class":538},[512,649,650],{"class":538}," python",[512,652,653],{"class":538}," scripts\u002Fcheck_package.py\n",[498,655,656,657,660],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[509,658,659],{},"py.typed",". These commands do not publish anything.",[493,662,664],{"id":663},"pinned-sdk-dependency","Pinned SDK dependency",[498,666,667,668,671,672,675,676,679,680,683],{},"Fluent pins one exact ",[509,669,670],{},"vatly-api-python"," version from PyPI in ",[509,673,674],{},"pyproject.toml",";\n",[509,677,678],{},"uv.lock"," records its hashes. To move to a new SDK version, change the pin, run\n",[509,681,682],{},"uv lock",", and run the full checks. Use a new Fluent alpha version when dependency\nbehavior changes.",[493,685,687],{"id":686},"documentation-sync","Documentation sync",[498,689,690,691,694,695,698,699,702,703,706,707,710,711,714],{},"Keep guides directly under ",[509,692,693],{},"docs\u002F"," and link each page from ",[550,696,697],{"href":393},"the overview",".\nPushes to ",[509,700,701],{},"main"," affecting ",[509,704,705],{},"docs\u002F**"," notify ",[509,708,709],{},"vatly\u002Fvatly-docs",". The notifier needs\n",[509,712,713],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that repository.\nThe sync uses an explicit frontmatter description when present, otherwise the\npage's introductory sentence.",[493,716,718],{"id":717},"prepare-a-release","Prepare a release",[498,720,721,722,728,729,732],{},"The published package is ",[550,723,727],{"href":724,"rel":725},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-fluent-python\u002F",[726],"nofollow","vatly-fluent-python",";\nthe import name is ",[509,730,731],{},"vatly_fluent",". Publish the matching SDK version first, then\nFluent, then Django, only after review and approval.",[734,735,736,749],"table",{},[737,738,739],"thead",{},[740,741,742,746],"tr",{},[743,744,745],"th",{},"PyPI trusted publisher field",[743,747,748],{},"Value",[750,751,752,763,772,782],"tbody",{},[740,753,754,758],{},[755,756,757],"td",{},"Owner",[755,759,760],{},[509,761,762],{},"vatly",[740,764,765,768],{},[755,766,767],{},"Repository",[755,769,