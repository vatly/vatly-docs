t",[492,571,572],{"class":518}," --check",[492,574,557],{"class":518},[492,576,578,580,582],{"class":494,"line":577},3,[492,579,515],{"class":498},[492,581,519],{"class":518},[492,583,584],{"class":518}," mypy\n",[478,586,587],{},"CI runs tests and these checks on Python 3.10–3.14. Type checks also include the\nexample storage driver.",[473,589,591],{"id":590},"build-and-check-the-package","Build and check the package",[482,593,595],{"className":484,"code":594,"language":486,"meta":487,"style":487},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[489,596,597,604,622],{"__ignoreMap":487},[492,598,599,601],{"class":494,"line":495},[492,600,515],{"class":498},[492,602,603],{"class":518}," build\n",[492,605,606,608,610,613,615,618],{"class":494,"line":560},[492,607,515],{"class":498},[492,609,519],{"class":518},[492,611,612],{"class":518}," twine",[492,614,554],{"class":518},[492,616,617],{"class":518}," dist\u002F",[492,619,621],{"class":620},"sTEyZ","*\n",[492,623,624,626,628,631],{"class":494,"line":577},[492,625,515],{"class":498},[492,627,519],{"class":518},[492,629,630],{"class":518}," python",[492,632,633],{"class":518}," scripts\u002Fcheck_package.py\n",[478,635,636,637,640],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[489,638,639],{},"py.typed",". These commands do not publish anything.",[473,642,644],{"id":643},"pinned-sdk-dependency","Pinned SDK dependency",[478,646,647,648,651,652,655,656,659,660,663],{},"Fluent pins one exact ",[489,649,650],{},"vatly-api-python"," version from PyPI in ",[489,653,654],{},"pyproject.toml",";\n",[489,657,658],{},"uv.lock"," records its hashes. To move to a new SDK version, change the pin, run\n",[489,661,662],{},"uv lock",", and run the full checks. Use a new Fluent alpha version when dependency\nbehavior changes.",[473,665,667],{"id":666},"documentation-sync","Documentation sync",[478,669,670,671,674,675,678,679,682,683,686,687,690,691,694],{},"Keep guides directly under ",[489,672,673],{},"docs\u002F"," and link each page from ",[530,676,677],{"href":373},"the overview",".\nPushes to ",[489,680,681],{},"main"," affecting ",[489,684,685],{},"docs\u002F**"," notify ",[489,688,689],{},"vatly\u002Fvatly-docs",". The notifier needs\n",[489,692,693],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that repository.\nThe sync uses an explicit frontmatter description when present, otherwise the\npage's introductory sentence.",[473,696,698],{"id":697},"prepare-a-release","Prepare a release",[478,700,701,702,708,709,712],{},"The published package is ",[530,703,707],{"href":704,"rel":705},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-fluent-python\u002F",[706],"nofollow","vatly-fluent-python",";\nthe import name is ",[489,710,711],{},"vatly_fluent",". Publish the matching SDK version first, then\nFluent, then Django, only after review and approval.",[714,715,716,729],"table",{},[717,718,719],"thead",{},[720,721,722,726],"tr",{},[723,724,725],"th",{},"PyPI trusted publisher field",[723,727,728],{},"Value",[730,731,732,743,752,762],"tbody",{},[720,733,734,738],{},[735,736,737],"td",{},"Owner",[735,739,740],{},[489,741,742],{},"vatly",[720,744,745,748],{},[735,746,747],{},"Repository",[735,749,750],{},[489,751,707],{},[720,753,754,757],{},[735,755,756],{},"Workflow",[735,758,759],{},[489,760,761],{},"release.yml",[720,763,764,767],{},[735,765,766],{},"Environment",[735,768,769],{},"Leave blank",[478,771,772,773,776,777,779],{},"The workflow publishes only from a published GitHub release whose tag matches\n",[489,774,775],{},"v"," plus the package version. Mark alphas as pre-releases. Pushing ",[489,778,681],{}," does not\npublish. Restrict release access: trusted publishing needs no environment approval\nor PyPI token, and PyPI artifacts are public.",[478,781,782,785,786],{},[530,783,784],{"href":379},"Storage contracts"," · ",[530,787,788],{"href":404},"Porting notes",[790,791,792],"sty