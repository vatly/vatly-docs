ss":500},[494,566,521],{"class":520},[494,568,553],{"class":520},[494,570,571],{"class":520}," format",[494,573,574],{"class":520}," --check",[494,576,559],{"class":520},[494,578,580,582,584],{"class":496,"line":579},3,[494,581,517],{"class":500},[494,583,521],{"class":520},[494,585,586],{"class":520}," mypy\n",[472,588,589],{},"CI runs tests and these checks on Python 3.10–3.14. Type checks also include the\nexample storage driver.",[476,591,593],{"id":592},"build-and-check-the-package","Build and check the package",[484,595,597],{"className":486,"code":596,"language":488,"meta":489,"style":489},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[491,598,599,606,624],{"__ignoreMap":489},[494,600,601,603],{"class":496,"line":497},[494,602,517],{"class":500},[494,604,605],{"class":520}," build\n",[494,607,608,610,612,615,617,620],{"class":496,"line":562},[494,609,517],{"class":500},[494,611,521],{"class":520},[494,613,614],{"class":520}," twine",[494,616,556],{"class":520},[494,618,619],{"class":520}," dist\u002F",[494,621,623],{"class":622},"sTEyZ","*\n",[494,625,626,628,630,633],{"class":496,"line":579},[494,627,517],{"class":500},[494,629,521],{"class":520},[494,631,632],{"class":520}," python",[494,634,635],{"class":520}," scripts\u002Fcheck_package.py\n",[472,637,638,639,642],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[491,640,641],{},"py.typed",". These commands do not publish anything.",[476,644,646],{"id":645},"pinned-sdk-dependency","Pinned SDK dependency",[472,648,649,650,653],{},"Development uses the SDK wheel in ",[491,651,652],{},"vendor\u002F",". Published Fluent metadata declares\nthe normal, exact PyPI dependency instead. Verify the pinned file before updating:",[484,655,657],{"className":486,"code":656,"language":488,"meta":489,"style":489},"sha256sum --check vendor\u002FSHA256SUMS\n",[491,658,659],{"__ignoreMap":489},[494,660,661,664,666],{"class":496,"line":497},[494,662,663],{"class":500},"sha256sum",[494,665,574],{"class":520},[494,667,668],{"class":520}," vendor\u002FSHA256SUMS\n",[472,670,671],{},"Keep published wheels immutable. Use a new alpha version when dependency behavior\nchanges; do not silently replace a version's wheel.",[476,673,675],{"id":674},"documentation-sync","Documentation sync",[472,677,678,679,682,683,686,687,690,691,694,695,698,699,702],{},"Keep guides directly under ",[491,680,681],{},"docs\u002F"," and link each page from ",[532,684,685],{"href":372},"the overview",".\nPushes to ",[491,688,689],{},"main"," affecting ",[491,692,693],{},"docs\u002F**"," notify ",[491,696,697],{},"vatly\u002Fvatly-docs",". The notifier needs\n",[491,700,701],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that repository.\nEach page's introductory sentence supplies its synced description.",[476,704,706],{"id":705},"prepare-a-release","Prepare a release",[472,708,709,710,716,717,720],{},"The published package is ",[532,711,715],{"href":712,"rel":713},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-fluent-python\u002F",[714],"nofollow","vatly-fluent-python",";\nthe import name is ",[491,718,719],{},"vatly_fluent",". Publish the matching SDK version first, then\nFluent, then Django, only after review and approval.",[722,723,724,737],"table",{},[725,726,727],"thead",{},[728,729,730,734],"tr",{},[731,732,733],"th",{},"PyPI trusted publisher field",[731,735,736],{},"Value",[738,739,740,751,760,770],"tbody",{},[728,741,742,746],{},[743,744,745],"td",{},"Owner",[743,747,748],{},[491,749,750],{},"vatly",[728,752,753,756],{},[743,754,755],{},"Repository",[743,757,758],{},[491,759,715],{},[728,761,762,765],{},[743,763,764],{},"Workflow",[743,766,767],{},[491,768,769],{},"release.yml",[728,771,772,775],{},[743,773,774],{},"Environment",[743,776,777],{},"Leave blank",[472,779,780,781,784,785,787],{},"The workflow publishes only from a published GitHub release whose tag matches\n",[491,782,783],{},"v"," plu