v run mypy\n",[501,554,555,570,587],{"__ignoreMap":499},[504,556,557,559,561,564,567],{"class":506,"line":507},[504,558,527],{"class":510},[504,560,531],{"class":530},[504,562,563],{"class":530}," ruff",[504,565,566],{"class":530}," check",[504,568,569],{"class":530}," .\n",[504,571,573,575,577,579,582,585],{"class":506,"line":572},2,[504,574,527],{"class":510},[504,576,531],{"class":530},[504,578,563],{"class":530},[504,580,581],{"class":530}," format",[504,583,584],{"class":530}," --check",[504,586,569],{"class":530},[504,588,590,592,594],{"class":506,"line":589},3,[504,591,527],{"class":510},[504,593,531],{"class":530},[504,595,596],{"class":530}," mypy\n",[490,598,599],{},"CI runs tests and these checks on Python 3.10–3.14. Type checks also include the\nexample storage driver.",[485,601,603],{"id":602},"build-and-check-the-package","Build and check the package",[494,605,607],{"className":496,"code":606,"language":498,"meta":499,"style":499},"uv build\nuv run twine check dist\u002F*\nuv run python scripts\u002Fcheck_package.py\n",[501,608,609,616,634],{"__ignoreMap":499},[504,610,611,613],{"class":506,"line":507},[504,612,527],{"class":510},[504,614,615],{"class":530}," build\n",[504,617,618,620,622,625,627,630],{"class":506,"line":572},[504,619,527],{"class":510},[504,621,531],{"class":530},[504,623,624],{"class":530}," twine",[504,626,566],{"class":530},[504,628,629],{"class":530}," dist\u002F",[504,631,633],{"class":632},"sTEyZ","*\n",[504,635,636,638,640,643],{"class":506,"line":589},[504,637,527],{"class":510},[504,639,531],{"class":530},[504,641,642],{"class":530}," python",[504,644,645],{"class":530}," scripts\u002Fcheck_package.py\n",[490,647,648,649,652],{},"The last command installs the built wheel in a fresh environment and checks\nimports and ",[501,650,651],{},"py.typed",". These commands do not publish anything.",[485,654,656],{"id":655},"pinned-sdk-dependency","Pinned SDK dependency",[490,658,659,660,663,664,667,668,671,672,675],{},"Fluent pins one exact ",[501,661,662],{},"vatly-api-python"," version from PyPI in ",[501,665,666],{},"pyproject.toml",";\n",[501,669,670],{},"uv.lock"," records its hashes. To move to a new SDK version, change the pin, run\n",[501,673,674],{},"uv lock",", and run the full checks. Use a new Fluent alpha version when dependency\nbehavior changes.",[485,677,679],{"id":678},"documentation-sync","Documentation sync",[490,681,682,683,686,687,690,691,694,695,698,699,702,703,706],{},"Keep guides directly under ",[501,684,685],{},"docs\u002F"," and link each page from ",[542,688,689],{"href":385},"the overview",".\nPushes to ",[501,692,693],{},"main"," affecting ",[501,696,697],{},"docs\u002F**"," notify ",[501,700,701],{},"vatly\u002Fvatly-docs",". The notifier needs\n",[501,704,705],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to that repository.\nThe sync uses an explicit frontmatter description when present, otherwise the\npage's introductory sentence.",[485,708,710],{"id":709},"prepare-a-release","Prepare a release",[490,712,713,714,720,721,724],{},"The published package is ",[542,715,719],{"href":716,"rel":717},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-fluent-python\u002F",[718],"nofollow","vatly-fluent-python",";\nthe import name is ",[501,722,723],{},"vatly_fluent",". Publish the matching SDK version first, then\nFluent, then Django, only after review and approval.",[726,727,728,741],"table",{},[729,730,731],"thead",{},[732,733,734,738],"tr",{},[735,736,737],"th",{},"PyPI trusted publisher field",[735,739,740],{},"Value",[742,743,744,755,764,774],"tbody",{},[732,745,746,750],{},[747,748,749],"td",{},"Owner",[747,751,752],{},[501,753,754],{},"vatly",[732,756,757,760],{},[747,758,759],{},"Repository",[747,761,762],{},[501,763,719],{},[732,765,766,769],{},[747,767,768],{},"Workflow",[747,770,771],{},[501,772,773],{},"release.yml",[732,775,776,779],{},[747,777,778],{},"Environment",[747,780,781],{},"Leave blank",[490,783,784,785,788,789,791],{},"The workflow 