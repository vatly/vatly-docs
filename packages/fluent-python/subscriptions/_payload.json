1,"children":382,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[383,387,391,395,398],{"title":384,"path":385,"stem":386},"Vatly Django guides","\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F0.readme",{"title":388,"path":389,"stem":390},"Webhooks, storage and outbox","\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F9.webhooks",{"title":392,"path":393,"stem":394},"Billable operations","\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F99.billing",{"title":207,"path":396,"stem":397},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F99.configuration",{"title":399,"path":400,"stem":401},"Development, support and release","\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F99.development",{"title":403,"path":404,"stem":405,"children":406},"Integrations","\u002Fintegrations","4.integrations",[407,409,413],{"title":403,"path":404,"stem":408},"4.integrations\u002Findex",{"title":410,"path":411,"stem":412},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":414,"path":415,"stem":416},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":418,"title":88,"body":419,"description":568,"extension":569,"links":570,"meta":571,"navigation":572,"path":350,"seo":573,"stem":351,"__hash__":574},"docs\u002F3.packages\u002F7.fluent-python\u002F3.subscriptions.md",{"type":420,"value":421,"toc":563},"minimark",[422,447,510,529,534,545,560],[423,424,425,426,430,431,434,435,438,439,442,443,446],"p",{},"Authorize a ",[427,428,429],"code",{},"LocalSubscription"," from your repository, then call\n",[427,432,433],{},"vatly.subscription(local)",". ",[427,436,437],{},"swap(plan_id, body)"," defaults to scheduled changes;\n",[427,440,441],{},"swap_and_invoice"," forces immediate application\u002Finvoicing; ",[427,444,445],{},"swap_without_charge","\nforces immediate application and disables the proration charge. Local data follows\nthe API response, so a scheduled swap does not prematurely replace the active plan.",[423,448,449,452,453,456,457,460,461,464,465,468,469,472,473,476,477,479,480,483,484,486,487,489,490,493,494,497,498,501,502,505,506,509],{},[427,450,451],{},"cancel(immediately=True)"," sends the API mutation and waits for signed events to\nupdate local cancellation state. ",[427,454,455],{},"resume()"," clears local ",[427,458,459],{},"ends_at"," after API success.\n",[427,462,463],{},"sync()"," saves the complete snapshot and derives expiry through ",[427,466,467],{},"subscription_ends_at",".\nGrace expiry uses the next renewal, renewed-until or trial end (in that order),\nexcluding historical dates at\u002Fbefore cancellation, then a previously known valid\nexpiry. Conflicting usable trial and cycle deadlines raise ",[427,470,471],{},"FluentError"," rather\nthan guessing whether the subscription was on trial; the API omits that flag.\nEqual instants are not conflicting, even with different timezone offsets.\n",[427,474,475],{},"canceled_at"," is the request time, never a grace deadline. If no deadline\nis available, processing also raises ",[427,478,471],{}," and rolls back; monitor failures and\nreconcile instead of assuming a new expiry. The prior committed state remains\nuntil recovery, so hosts must apply their own stale-state entitlement policy.\nTerminal cancellation uses ",[427,481,482],{},"ended_at"," or ",[427,485,475],{},"; an active snapshot clears\nstale expiry after a missed resume. Webhooks and Django reconciliation use the same\nmapping. Core's internal ",[427,488,459],{}," is not currently exposed; ",[427,491,492],{},"next_renewal_at"," alone\nmust not be assumed universally present after cancellation.\n",[427,495,496],{},"scheduled_update",", ",[427,499,500],{},"has_scheduled_update",", and ",[427,503,504],{},"cancellation_reason"," read remotely.\n",[427,507,508],{},"update_billing(body)"," returns a hosted URL; both redirect defaults\u002Foverrides are required.",[423,511,512,515,516,519,520,523,524,528],{},[427,513,514],{},"model()"," is local. ",[427,517,518],{},"state()","\u002F",[427,521,522],{},"subscription_state(ends_at, now)"," implements PHP's\nendsAt predicates: active\u002Fvalid through grace period, recurring before cancellation,\nended at or beyond the end time. ",[525,526,527],"strong",{},"Check Vatly status separately before granting\naccess","; these convenience predicates do not account for paused\u002Funpaid states.",[530,531,533],"h2",{"id":532},"initial-subscription-linking","Initial subscription linking",[423,535,536,537,540,541,544],{},"This alpha's linkage code reports ",[427,538,539],{},"subscription_plan"," lines as ",[427,542,543],{},"legacy_plan_ids",".\nIt does not consume a related-resources subscription reference. Do not assume\nan API addition alone completes this integration; package support must be\nimplemented and tested separately.",[423,546,547,548,551,552,555,556,559],{},"For existing subscription-valued lines, ",[427,549,550],{},"await vatly.reconcile_checkout(checkout_id)"," follows\nhost records → checkout → order → distinct subscription IDs, retries each 404 up\nto three times (configurable 1–10), and returns ",[427,553,554],{},"CheckoutResolution"," with resolved\nresources, ",[427,557,558],{},"pending_subscription_ids",", and legacy IDs. Two lines for the same plan\ncan identify different subscriptions; quantity never multiplies IDs.",[423,561,562],{},"An unresolved subscription ID is not evidence of entitlement. Enqueue bounded\nrecovery and inspect ownership\u002Fstatus before granting access. The caller authorizes\nthe checkout and wraps local writes in its driver transaction. Built-in reactions\nmake no API reads. A future related-resources integration must preserve confirmed\nIDs across older null snapshots and refresh unresolved signup correlation via GET;\ncore does not promise historical inference or backfill. Trial AUTH_REQUEST flows\nmay have no merchant order.paid event; explicitly reconcile the paid checkout's orderId.",{"title":564,"searchDepth":565,"depth":565,"links":566},"",2,[567],{"id":532,"depth":565,"text":533},"Vatly Python Fluent - Subscriptions","md",null,{},true,{"title":88,"description":568},"y15VyDvzIlDVyCKuT3NBaNFF4kVBDoL_C5ub6Fc1gs8",[576,578],{"title":80,"path":347,"stem":348,"description":577,"children":-1},"Vatly Python Fluent - Checkouts",{"title":353,"path":354,"stem":355,"description":579,"children":-1},"Vatly Python Fluent - Orders and reversals",1794489078254]