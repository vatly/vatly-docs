n\u002F99.porting",{"title":58,"path":381,"stem":382},"\u002Fpackages\u002Ffluent-python\u002Ftesting","3.packages\u002F7.fluent-python\u002F99.testing",{"title":384,"path":385,"stem":386,"children":387,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[388,392,396,400,403],{"title":389,"path":390,"stem":391},"Vatly Django guides","\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F0.readme",{"title":393,"path":394,"stem":395},"Webhooks, storage and outbox","\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F9.webhooks",{"title":397,"path":398,"stem":399},"Billable operations","\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F99.billing",{"title":212,"path":401,"stem":402},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F99.configuration",{"title":404,"path":405,"stem":406},"Development, support and release","\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F99.development",{"title":408,"path":409,"stem":410,"children":411},"Integrations","\u002Fintegrations","4.integrations",[412,414,418],{"title":408,"path":409,"stem":413},"4.integrations\u002Findex",{"title":415,"path":416,"stem":417},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":419,"path":420,"stem":421},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":423,"title":362,"body":424,"description":562,"extension":563,"links":564,"meta":565,"navigation":566,"path":363,"seo":567,"stem":364,"__hash__":568},"docs\u002F3.packages\u002F7.fluent-python\u002F9.webhooks.md",{"type":425,"value":426,"toc":558},"minimark",[427,440,452,544,555],[428,429,430,431,435,436,439],"p",{},"Call ",[432,433,434],"code",{},"await vatly.webhook_processor().handle(raw_bytes, signature_header)"," in your\nframework route. Signature\u002FHMAC freshness checks happen before storage, using the\nSDK. Missing\u002Finvalid signatures raise ",[432,437,438],{},"VatlyInvalidSignatureError",". Keep the default\n300-second tolerance; arrays of secrets support rotation. Unknown signed events\nare retained and dispatched, not applied to known repositories.",[428,441,442,443,446,447,451],{},"Implement ",[432,444,445],{},"WebhookCalls.process(event, work)"," in ",[448,449,450],"strong",{},"one transaction"," shared by all\ndrivers. Lock\u002Fclaim the signed event.id, skip committed duplicates, retain the\nenvelope, await work, mark processed and commit. Roll back every write on failure\nso delivery retries can finish. Concurrency requires DB uniqueness\u002Flocking, not a\ncheck-then-insert in memory. Scope every key by tenant\u002Fstorefront\u002Fmode. An unsigned\nVatly-Event-Id header is not a dedup authority. Mode mismatches fail before storage.",[453,454,455,468],"table",{},[456,457,458],"thead",{},[459,460,461,465],"tr",{},[462,463,464],"th",{},"Event",[462,466,467],{},"Built-in behavior",[469,470,471,480,488,496,504,512,520,528,536],"tbody",{},[459,472,473,477],{},[474,475,476],"td",{},"subscription.started",[474,478,479],{},"Upsert; newly saved row emits local.subscription_created",[459,481,482,485],{},[474,483,484],{},"subscription.updated \u002F billing_updated",[474,486,487],{},"Update existing resource; null mandate preserves local value",[459,489,490,493],{},[474,491,492],{},"subscription.resumed",[474,494,495],{},"Update existing row; clear ends_at",[459,497,498,501],{},[474,499,500],{},"cancellation \u002F grace-period completion",[474,502,503],{},"Update existing row and ends_at",[459,505,506,509],{},[474,507,508],{},"order.paid \u002F payment_failed",[474,510,511],{},"Upsert signed snapshot; new paid row emits local.order_created",[459,513,514,517],{},[474,515,516],{},"order.canceled",[474,518,519],{},"Update existing snapshot only",[459,521,522,525],{},[474,523,524],{},"refund.* \u002F order.chargeback_*",[474,526,527],{},"Optional reversal upsert",[459,529,530,533],{},[474,531,532],{},"checkout.paid",[474,534,535],{},"Link own checkout record to order; link subscription IDs from an already stored order",[459,537,538,541],{},[474,539,540],{},"scheduled updates \u002F products \u002F setup \u002F unknown",[474,542,543],{},"Dispatch without built-in resource writes",[428,545,546,547,550,551,554],{},"Missing repositories skip persistence, not dispatch. Local-created events fire\nonly when a row is first saved, not on every payment status transition. Custom\n",[432,548,549],{},"additional_webhook_reactions"," run after built-ins and before final dispatch,\ninside the same transaction. Write transactional outbox rows in ",[432,552,553],{},"events.dispatch",",\nthen send external effects after commit. Throw on processing failure; respond 5xx,\nnot 2xx, so Vatly retries. A duplicate committed event may respond 200.",[428,556,557],{},"No implicit API reads occur. All six checkout\u002Forder\u002Fsubscription delivery orders\nare tested to converge using host records and stored snapshots. Missing snapshots,\nAUTH_REQUEST trials and legacy plan references need explicit reconciliation jobs.\nDelayed stale events can still overwrite newer snapshots: dedup is not ordering;\nreconcile conflicts with the API. Never infer ownership from customerId or metadata.",{"title":559,"searchDepth":560,"depth":560,"links":561},"",2,[],"Vatly Python Fluent - Transactional webhooks","md",null,{},true,{"title":362,"description":562},"y9pPQkncAaLwzUyLuJo0ll0QEBuECB2LzdWLpIAMMTM",[570,572],{"title":358,"path":359,"stem":360,"description":571,"children":-1},"Vatly Python Fluent - Orders and reversals",{"title":366,"path":367,"stem":368,"description":573,"children":-1},"Vatly Python Fluent - Configuration and lifecycle",1794487827114]