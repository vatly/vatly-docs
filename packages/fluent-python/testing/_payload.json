xample\",\n                        \"type\": \"application\u002Fjson\",\n                    },\n                    \"checkoutUrl\": {\n                        \"href\": \"https:\u002F\u002Fcheckout.example.com\u002Fexample\",\n                        \"type\": \"text\u002Fhtml\",\n                    },\n                },\n            },\n        )\n\n    async with AsyncVatlyClient(\"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)) as api:\n        vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 2},\n                ]\n            )\n            .create()\n        )\n        assert checkout.get_url() == \"https:\u002F\u002Fcheckout.example.com\u002Fexample\"\n        return checkout.id\n","python","",[496,497,498,511,519,533,553,560,565,582,601,630,656,697,738,744,761,770,779,800,821,836,857,872,886,907,928,942,957,971,992,1006,1021,1036,1058,1079,1085,1099,1119,1139,1144,1150,1156,1162,1167,1237,1276,1287,1304,1315,1321,1356,1362,1368,1378,1383,1407],"code",{"__ignoreMap":494},[499,500,503,507],"span",{"class":501,"line":502},"line",1,[499,504,506],{"class":505},"s7zQu","import",[499,508,510],{"class":509},"sTEyZ"," json\n",[499,512,514,516],{"class":501,"line":513},2,[499,515,506],{"class":505},[499,517,518],{"class":509}," httpx\n",[499,520,522,525,528,530],{"class":501,"line":521},3,[499,523,524],{"class":505},"from",[499,526,527],{"class":509}," vatly ",[499,529,506],{"class":505},[499,531,532],{"class":509}," AsyncVatlyClient\n",[499,534,536,538,541,543,546,550],{"class":501,"line":535},4,[499,537,524],{"class":505},[499,539,540],{"class":509}," vatly_fluent ",[499,542,506],{"class":505},[499,544,545],{"class":509}," Vatly",[499,547,549],{"class":548},"sMK4o",",",[499,551,552],{"class":509},