\u002Findex",{"title":479,"path":480,"stem":481},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":483,"path":484,"stem":485},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":487,"title":488,"body":489,"description":1513,"extension":1514,"links":1515,"meta":1516,"navigation":1517,"path":420,"seo":1518,"stem":421,"__hash__":1519},"docs\u002F3.packages\u002F7.fluent-python\u002F11.testing.md","Test without real payments",{"type":490,"value":491,"toc":1511},"minimark",[492,496,1427,1430,1487,1499,1507],[493,494,495],"p",{},"Use httpx's MockTransport with the real published SDK and Fluent. The following\nexample needs no API key or network connection and validates the outgoing cart.",[497,498,503],"pre",{"className":499,"code":500,"language":501,"meta":502,"style":502},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import json\nimport httpx\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\nasync def example():\n    def respond(request):\n        assert request.method == \"POST\"\n        assert request.url.path == \"\u002Fv1\u002Fcheckouts\"\n        assert json.loads(request.content)[\"products\"] == [\n            {\"id\": \"one_off_product_example\", \"quantity\": 2}\n        ]\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"checkout_example\",\n                \"resource\": \"checkout\",\n                \"testmode\": True,\n                \"status\": \"created\",\n                \"customerId\": None,\n                \"orderId\": None,\n                \"redirectUrlSuccess\": \"https:\u002F\u002Fapp.example.com\u002Fok\",\n                \"redirectUrlCanceled\": \"https:\u002F\u002Fapp.example.com\u002Fno\",\n                \"billingAddress\": None,\n                \"metadata\": {},\n                \"locale\": None,\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"expiresAt\": None,\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts\u002Fcheckout_example\",\n                        \"type\": \"application\u002Fjson\",\n                    },\n                    \"checkoutUrl\": {\n                        \"href\": \"https:\u002F\u002Fcheckout.example.com\u002Fexample\",\n                        \"type\": \"text\u002Fhtml\",\n                    },\n                },\n            },\n        )\n\n    async with AsyncVatlyClient(\"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)) as api:\n        vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 2},\n                ]\n            )\n            .create()\n        )\n        assert checkout.get_url() == \"https:\u002F\u002Fcheckout.example.com\u002Fexample\"\n        return checkout.id\n","python","",[504,505,506,519,527,541,561,568,573,590,609,638,664,705,746,752,769,778,787,808,829,844,865,880,894,915,936,950,965,979,1000,1014,1029,1044,1066,1087,1093,1107,1127,1147,1152,1158,1164,1170,1175,1245,1284,1295,1312,1323,1329,1364,1370,1376,1386,1391,1415],"code",{"__ignoreMap":502},[507,508,511,515],"span",{"class":509,"line":510},"line",1,[507,512,514],{"class":513},"s7zQu","import",[507,516,518],{"class":517},"sTEyZ"," json\n",[507,520,522,524],{"class":509,"line":521},2,[507,523,514],{"class":513},[507,525,526],{"class":517}," httpx\n",[507,528,530,533,536,538],{"class":509,"line":529},3,[507,531,532],{"class":513},"from",[507,534,535],{"class":517}," vatly ",[507,537,514],{"class":513},[507,539,540],{"class":517}," AsyncVatlyClient\n",[507,542,544,5