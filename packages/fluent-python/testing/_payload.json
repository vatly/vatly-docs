{"title":476,"path":477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":492,"body":493,"description":1517,"extension":1518,"links":1519,"meta":1520,"navigation":1521,"path":424,"seo":1522,"stem":425,"__hash__":1523},"docs\u002F3.packages\u002F7.fluent-python\u002F11.testing.md","Test without real payments",{"type":494,"value":495,"toc":1515},"minimark",[496,500,1431,1434,1491,1503,1511],[497,498,499],"p",{},"Use httpx's MockTransport with the real published SDK and Fluent. The following\nexample needs no API key or network connection and validates the outgoing cart.",[501,502,507],"pre",{"className":503,"code":504,"language":505,"meta":506,"style":506},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import json\nimport httpx\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\nasync def example():\n    def respond(request):\n        assert request.method == \"POST\"\n        assert request.url.path == \"\u002Fv1\u002Fcheckouts\"\n        assert json.loads(request.content)[\"products\"] == [\n            {\"id\": \"one_off_product_example\", \"quantity\": 2}\n        ]\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"checkout_example\",\n                \"resource\": \"checkout\",\n                \"testmode\": True,\n                \"status\": \"created\",\n                \"customerId\": None,\n                \"orderId\": None,\n                \"redirectUrlSuccess\": \"https:\u002F\u002Fapp.example.com\u002Fok\",\n                \"redirectUrlCanceled\": \"https:\u002F\u002Fapp.example.com\u002Fno\",\n                \"billingAddress\": None,\n                \"metadata\": {},\n                \"locale\": None,\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"expiresAt\": None,\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts\u002Fcheckout_example\",\n                        \"type\": \"application\u002Fjson\",\n                    },\n                    \"checkoutUrl\": {\n                        \"href\": \"https:\u002F\u002Fcheckout.example.com\u002Fexample\",\n                        \"type\": \"text\u002Fhtml\",\n                    },\n                },\n            },\n        )\n\n    async with AsyncVatlyClient(\"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)) as api:\n        vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 2},\n                ]\n            )\n            .create()\n        )\n        assert checkout.get_url() == \"https:\u002F\u002Fcheckout.example.com\u002Fexample\"\n        return checkout.id\n","python","",[508,509,510,523,531,545,565,572,577,594,613,642,668,709,750,756,773,782,791,812,833,848,869,884,898,919,940,954,969,983,1004,1018,1033,1048,1070,1091,1097,1111,1131,1151,1156,1162,1168,1174,1179,1249,1288,1299,1316,1327,1333,1368,1374,1380,1390,1395,1419],"code",{"__ignoreMap":506},[511,512,515,519],"span",{"class":513,"line":514},"line",1,[511,516,518],{"class":517},"s7zQu","import",[511,520,522],{"class":521},"sTEyZ"," json\n",[511,524,526,528],{"class":513,"line":525},2,[511,527,518],{"class":517},[511,529,530],{"class":521}," httpx\n",[511,532,534,537,540,542],{"class":513,"line":533