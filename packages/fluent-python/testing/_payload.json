PI key or network connection and validates the outgoing cart.",[476,477,482],"pre",{"className":478,"code":479,"language":480,"meta":481,"style":481},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import json\nimport httpx\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\nasync def example():\n    def respond(request):\n        assert request.method == \"POST\"\n        assert request.url.path == \"\u002Fv1\u002Fcheckouts\"\n        assert json.loads(request.content)[\"products\"] == [\n            {\"id\": \"one_off_product_example\", \"quantity\": 2}\n        ]\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"checkout_example\",\n                \"resource\": \"checkout\",\n                \"testmode\": True,\n                \"status\": \"created\",\n                \"customerId\": None,\n                \"orderId\": None,\n                \"redirectUrlSuccess\": \"https:\u002F\u002Fapp.example.com\u002Fok\",\n                \"redirectUrlCanceled\": \"https:\u002F\u002Fapp.example.com\u002Fno\",\n                \"billingAddress\": None,\n                \"metadata\": {},\n                \"locale\": None,\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"expiresAt\": None,\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts\u002Fcheckout_example\",\n                        \"type\": \"application\u002Fjson\",\n                    },\n                    \"checkoutUrl\": {\n                        \"href\": \"https:\u002F\u002Fcheckout.example.com\u002Fexample\",\n                        \"type\": \"text\u002Fhtml\",\n                    },\n                },\n            },\n        )\n\n    async with AsyncVatlyClient(\"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)) as api:\n        vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 2},\n                ]\n            )\n            .create()\n        )\n        assert checkout.get_url() == \"https:\u002F\u002Fcheckout.example.com\u002Fexample\"\n        return checkout.id\n","python","",[483,484,485,498,506,520,540,547,552,569,588,617,643,684,725,731,748,757,766,787,808,823,844,859,873,894,915,929,944,958,979,993,1008,1023,1045,1066,1072,1086,1106,1126,1131,1137,1143,1149,1154,1224,1263,1274,1291,1302,1308,1343,1349,1355,1365,1370,1394],"code",{"__ignoreMap":481},[486,487,490,494],"span",{"class":488,"line":489},"line",1,[486,491,493],{"class":492},"s7zQu","import",[486,495,497],{"class":496},"sTEyZ"," json\n",[486,499,501,503],{"class":488,"line":500},2,[486,502,493],{"class":492},[486,504,505],{"class":496}," httpx\n",[486,507,509,512,515,517],{"class":488,"line":508},3,[486,510,511],{"class":492},"from",[486,513,514],{"class":496}," vatly ",[486,516,493],{"class":492},[486,518,519],{"class":496}," AsyncVatlyClient\n",[486,521,523,525,528,530,533,537],{"class":488,"line":522},4,[486,524,511],{"class":492},[486,526,527],{"class":496}," vatly_fluent ",[486,529,493],{"class":492},[486,531,532],{"class":496}," Vatly",[486,534,536],{"class":535},"sMK4o",",",[486,538,539],{"class":496}," Wiring\n",[486,541,543],{"class":488,"line":542},5,[486,544,546],{"emptyLinePlaceholder":545},true,"\n",[486,548,550],{"class":488,"line":549},6,[486,551,546],{"emptyLinePlaceholder":545},[486,553,555,559,562,566],{"class":488,"line":554},7,[486,556,558],{"class":557},"spNyl","async",[486,560,561],{"class":557}," def",[486,563,565],{"class":564},"s2Zo4"," example",[486,567,568],{"class":535},"():\n",[486,570,572,575,578,581,585],{"class":488,"line":571},8,[486,573,574