ages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F02.configuration",{"title":425,"path":426,"stem":427},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":429,"path":430,"stem":431},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":433,"stem":434},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":194,"path":436,"stem":437},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":439,"stem":440},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":442,"path":443,"stem":444},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":446,"stem":447},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":364,"path":449,"stem":450},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":452,"path":453,"stem":454,"children":455},"Integrations","\u002Fintegrations","4.integrations",[456,458,462],{"title":452,"path":453,"stem":457},"4.integrations\u002Findex",{"title":459,"path":460,"stem":461},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":463,"path":464,"stem":465},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":467,"title":468,"body":469,"description":1493,"extension":1494,"links":1495,"meta":1496,"navigation":1497,"path":400,"seo":1498,"stem":401,"__hash__":1499},"docs\u002F3.packages\u002F7.fluent-python\u002F11.testing.md","Test without real payments",{"type":470,"value":471,"toc":1491},"minimark",[472,476,1407,1410,1467,1479,1487],[473,474,475],"p",{},"Use httpx's MockTransport with the real published SDK and Fluent. The following\nexample needs no API key or network connection and validates the outgoing cart.",[477,478,483],"pre",{"className":479,"code":480,"language":481,"meta":482,"style":482},"language-python shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import json\nimport httpx\nfrom vatly import AsyncVatlyClient\nfrom vatly_fluent import Vatly, Wiring\n\n\nasync def example():\n    def respond(request):\n        assert request.method == \"POST\"\n        assert request.url.path == \"\u002Fv1\u002Fcheckouts\"\n        assert json.loads(request.content)[\"products\"] == [\n            {\"id\": \"one_off_product_example\", \"quantity\": 2}\n        ]\n        return httpx.Response(\n            200,\n            json={\n                \"id\": \"checkout_example\",\n                \"resource\": \"checkout\",\n                \"testmode\": True,\n                \"status\": \"created\",\n                \"customerId\": None,\n                \"orderId\": None,\n                \"redirectUrlSuccess\": \"https:\u002F\u002Fapp.example.com\u002Fok\",\n                \"redirectUrlCanceled\": \"https:\u002F\u002Fapp.example.com\u002Fno\",\n                \"billingAddress\": None,\n                \"metadata\": {},\n                \"locale\": None,\n                \"createdAt\": \"2026-01-01T00:00:00Z\",\n                \"expiresAt\": None,\n                \"links\": {\n                    \"self\": {\n                        \"href\": \"https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts\u002Fcheckout_example\",\n                        \"type\": \"application\u002Fjson\",\n                    },\n                    \"checkoutUrl\": {\n                        \"href\": \"https:\u002F\u002Fcheckout.example.com\u002Fexample\",\n                        \"type\": \"text\u002Fhtml\",\n                    },\n                },\n            },\n        )\n\n    async with AsyncVatlyClient(\"test_\" + \"x\" * 20, transport=httpx.MockTransport(respond)) as api:\n        vatly = Vatly(Wiring(api, \"https:\u002F\u002Fapp.example.com\u002Fok\", \"https:\u002F\u002Fapp.example.com\u002Fno\"))\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 2},\n                ]\n            )\n            .create()\n        )\n        assert checkout.get_url() == \"https:\u002F\u002Fcheckout.example.com\u002Fexample\"\n        return checkout.id\n","python","",[484,485,486,499,507,521,541,548,553,570,589,618,644,685,726,732,749,758,767,788,809,824,845,860,874,895,916,930,945,959,980,994,1009,1024,1046,1067,1073,1087,1107,1127,1132,1138,1144,1150,1155,1225,1264,1275,1292,1303,1309,1344,1350,1356,1366,1371,1395],"code",{"__ignoreMap":482},[487,488,491,495],"span",{"class":489,"line":490},"line",1,[487,492,494],{"class":493},"s7zQu","import",[487,496,498],{"class":497},"sTEyZ"," json\n",[487,500,502,504],{"class":489,"line":501},2,[487,503,494],{"class":493},[487,505,506],{"class":497}," httpx\n",[487,508,510,513,516,518],{"class":489,"line":509},3,[487,511,512],{"class":493},"from",[487,514,515],{"class":497}," vatly ",[487,517,494],{"class":493},[487,519,520],{"class":497}," AsyncVatlyClient\n",[487,522,524,526,529,531,534,538],{"class":489,"line":523},4,[487,525,512],{"class":493},[487,527,528],{"class":497}," vatly_fluent ",[487,530,494],{"class":493},[487,532,533],{"class":497}," Vatly",[487,535,537],{"class":536},"sMK4o",",",[487,539,540],{"class":497}," Wiring\n",[487,542,544],{"class":489,"line":543},5,[487,545,547],{"emptyLinePlaceholder":546},true,"\n",[487,549,551],{"class":489,"line":550},6,[487,552,547],{"emptyLinePlaceholder":546},[487,554,556,560,563,567],{"class":489,"line":555},7,[487,557,559],{"class":558},"spNyl","async",[487,561,562],{"class":558}," def",[487,564,566],{"class":565},"s2Zo4"," example",[487,568,569],{"class":536},"():\n",[487,571,573,576,579,582,586],{"class":489,"line":5