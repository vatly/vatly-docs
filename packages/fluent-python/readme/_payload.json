):\n    async with AsyncVatlyClient() as api:\n        vatly = Vatly(\n            Wiring(\n                api=api,\n                redirect_url_success=\"https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fsuccess\",\n                redirect_url_canceled=\"https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled\",\n            )\n        )\n        checkout = (\n            await vatly.checkout_builder()\n            .with_items(\n                [\n                    {\"id\": \"one_off_product_example\", \"quantity\": 1},\n                ]\n            )\n            .create(options=RequestOptions(idempotency_key=\"purchase:42\"))\n        )\n        return checkout.get_url()\n",[515,555,556,579,597,604,609,626,649,663,671,686,704,721,727,733,744,762,773,779,821,827,832,868,873],{"__ignoreMap":513},[518,557,558,562,566,569,572,576],{"class":520,"line":521},[518,559,561],{"class":560},"s7zQu","from",[518,563,565],{"class":564},"sTEyZ"," vatly ",[518,567,568],{"class":560},"import",[518,570,571],{"class":564}," AsyncVatlyClient",[518,573,575],{"class":574},"sMK4o",",",[518,577,578],{"class":564}," RequestOptions\n",[518,580,582,584,587,589,592,594],{"class":520,"line":581},2,[518,583,561],{"class":560},[518,585,586],{"class":564}," vatly_fluent ",[518,588,568],{"class":560},[518,590,591],{"class":564}," Vatly",[518,593,575],{"class":574},[518,595,596],{"class":564}," Wiring\n",[518,598,600],{"class":520,"line":599},3,[518,601,603],{"emptyLinePlaceholder":602},true,"\n",[518,605,607],{"class":520,"line":606},4,[518,608,603],{"emptyLinePlaceholder":602},[518,610,612,616,619,623],{"class":520,"line":611},5,[518,613,615],{"class":614},"spNyl","async",[518,617,618],{"class":614}," def",[518,620,622],{"class":621},"s2Zo4"," example",[518,624,625],{"class":574},"():\n",[518,627,629,632,635,637,640,643,646],{"class":520,"line":628},6,[518,630,631],{"class":560},"    async",[518,633,634],{"class":560}," with",[518,636,571],{"class":621},[518,638,639],{"class":574},