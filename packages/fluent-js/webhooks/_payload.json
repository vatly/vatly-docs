plies the data. A missing optional repository skips that write, not dispatch.\nNull billing-event mandates do not clear an existing local mandate; explicit\nsubscription ",[303,928,929],{},"sync()"," reconciles an actual removal.",[290,932,934],{"id":933},"application-events-and-extensions","Application events and extensions",[308,936,938],{"className":310,"code":937,"language":312,"meta":313,"style":313},"import type { DomainEvent, EventDispatcher } from '@getvatly\u002Ffluent';\n\nexport function billingEvents(\n  enqueueInCurrentTransaction: (event: DomainEvent) => Promise\u003Cvoid>,\n): EventDispatcher {\n  return { dispatch: event => enqueueInCurrentTransaction(event) };\n}\n",[303,939,940,969,973,985,1016,1024,1052],{"__ignoreMap":313},[317,941,942,944,947,949,952,954,957,959,961,963,965,967],{"class":319,"line":320},[317,943,324],{"class":323},[317,945,946],{"class":323}," type",[317,948,328],{"class":327},[317,950,951],{"class":331}," DomainEvent",[317,953,611],{"class":327},[317,955,956],{"class":331}," EventDispatcher",[317,958,335],{"class":327},[317,960,338],{"class":323},[317,962,341],{"class":327},[317,964,370],{"class":344},[317,966,348],{"class":327},[317,968,351],{"class":327},[317,970,971],{"class":319,"line":354},[317,972,381],{"emptyLinePlaceholder":380},[317,974,975,977,979,982],{"class":319,"line":377},[317,976,387],{"class":323},[317,978,391],{"class":390},[317,980,981],{"class":394}," billingEvents",[317,983,984],{"class":327},"(\n",[317,986,987,990,992,994,997,999,1001,1003,1006,1008,1010,1013],{"class":319,"line":384},[317,988,989],{"class":394},"  enqueueInCurrentTransaction",[317,991,405],{"class":327},[317,993,561],{"class":327},[317,995,996],{"class":401},"event",[317,998,405],{"class":327},[317,1000,951],{"class":408},[317,1002,411],{"class":327},[317,1004,1005],{"class":390}," =>",[317,1007,444],{"class":408},[317,1009,447],{"class":327},[317,1011,1012],{"class":408},"void",[317,1014,1015],{"class":327},">,\n",[317,1017,1018,1020,102