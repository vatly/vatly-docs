,[488,1032,1033],{},"checkout.paid"," and ",[488,1036,1037],{},"order.paid"," deliveries.",[1007,1040,1041],{},"Check duplicate and failed deliveries. Delete or disable temporary endpoints\nbefore closing the tunnel; record any resources you create.",[484,1043,1044,1047,1048,1051,1052,647,1055,1051,1058,1051,1061,1064,1065,1068,1069,1072],{},[488,1045,1046],{},"vatly.testHelpers()"," exposes ",[488,1049,1050],{},"advanceRenewal",", ",[488,1053,1054],{},"forceRenewalPaid",[488,1056,1057],{},"forceRenewalFailed",[488,1059,1060],{},"forceOrderPaymentPaid",[488,1062,1063],{},"forceOrderPaymentFailed",", and the\nSDK-style ",[488,1066,1067],{},"fastForwardRenewal","\u002F",[488,1070,1071],{},"simulateOrderPayment",". These mutate account data.\nUse them only with permission and disposable test resources, not existing\nsubscriptions or orders just because the key is in test mode.",[977,1074,1076],{"id":1075},"test-your-edge-runtime","Test your edge runtime",[484,1078,1079],{},"For edge hosts, also run your app in the local edge runtime with its storage adapter.\nNode tests alone do not check edge compatibility.",[484,1081,1082,1083,1089,1090,721],{},"See the ",[985,1084,1088],{"href":1085,"rel":1086},"https:\u002F\u002Fdocs.vatly.com\u002Fguides\u002Ftesting",[1087],"nofollow","testing guide"," and\n",[985,1091,1094],{"href":1092,"rel":1093},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference\u002Ftest-helpers",[1087],"Test Helpers API reference",[1096,1097,1098],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--s