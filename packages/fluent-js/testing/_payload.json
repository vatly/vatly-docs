s\nbefore closing the tunnel; record any resources you create.",[286,845,846,849,850,853,854,449,857,853,860,853,863,866,867,870,871,874],{},[290,847,848],{},"vatly.testHelpers()"," exposes ",[290,851,852],{},"advanceRenewal",", ",[290,855,856],{},"forceRenewalPaid",[290,858,859],{},"forceRenewalFailed",[290,861,862],{},"forceOrderPaymentPaid",[290,864,865],{},"forceOrderPaymentFailed",", and the\nSDK-style ",[290,868,869],{},"fastForwardRenewal","\u002F",[290,872,873],{},"simulateOrderPayment",". These mutate account data.\nUse them only with permission and disposable test resources, not existing\nsubscriptions or orders just because the key is in test mode.",[779,876,878],{"id":877},"run-this-packages-checks","Run this package's checks",[295,880,884],{"className":881,"code":882,"language":883,"meta":300,"style":300},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","pnpm install --frozen-lockfile\npnpm check\n","sh",[290,885,886,898],{"__ignoreMap":300},[304,887,888,892,895],{"class":306,"line":307},[304,889,891],{"class":890},"sBMFI","pnpm",[304,893,894],{"class":331}," install",[304,896,897],{"class":331}," --frozen-lockfile\n",[304,899,900,902],{"class":306,"line":341},[304,901,891],{"class":890},[304,903,904],{"class":331}," check\n",[286,906,907],{},"For edge hosts, also run your app in the local edge runtime with its storage adapter.\nNode tests alone do not check edge compatibility.",[286,909,910,911,917,918,523],{},"See the ",[787,912,916],{"href":913,"rel":914},"https:\u002F\u002Fdocs.vatly.com\u002Fguides\u002Ftesting",[915],"nofollow","testing guide"," and\n",[787,919,922],{"href":920,"rel":921},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference\u002Ftest-helpers",[915],"Test Helpers API reference",[924,925,926],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;-