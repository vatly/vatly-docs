e public\nURL and save its signing secret as ",[496,1030,1031],{},"VATLY_WEBHOOK_SECRET",[1015,1033,1034,1035,1038,1039,1042,1043,1046],{},"Pay through a ",[993,1036,1037],{"href":322},"hosted checkout",". Save the checkout\u002Forder IDs and\nconfirm signed ",[496,1040,1041],{},"checkout.paid"," and ",[496,1044,1045],{},"order.paid"," deliveries.",[1015,1048,1049],{},"Check duplicate and failed deliveries. Delete or disable temporary endpoints\nbefore closing the tunnel; record any resources you create.",[492,1051,1052,1055,1056,1059,1060,655,1063,1059,1066,1059,1069,1072,1073,1076,1077,1080],{},[496,1053,1054],{},"vatly.testHelpers()"," exposes ",[496,1057,1058],{},"advanceRenewal",", ",[496,1061,1062],{},"forceRenewalPaid",[496,1064,1065],{},"forceRenewalFailed",[496,1067,1068],{},"forceOrderPaymentPaid",[496,1070,1071],{},"forceOrderPaymentFailed",", and the\nSDK-style ",[496,1074,1075],{},"fastForwardRenewal","\u002F",[496,1078,1079],{},"simulateOrderPayment",". These mutate account data.\nUse them only with permission and disposable test resources, not existing\nsubscriptions or orders just because the key is in test mode.",[985,1082,1084],{"id":1083},"test-your-edge-runtime","Test your edge runtime",[492,1086,1087],{},"For edge hosts, also run your app in the local edge runtime with its storage adapter.\nNode tests alone do not check edge compatibility.",[492,1089,1090,1091,1097,1098,729],{},"See the ",[993,1092,1096],{"href":1093,"rel":1094},"https:\u002F\u002Fdocs.vatly.com\u002Fguides\u002Ftesting",[1095],"nofollow","testing guide"," and\n",[993,1099,1102],{"href":1100,"rel":1101},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference\u002Ftest-helpers",[1095],"Test Helpers API reference",[1104,1105,1106],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, ht