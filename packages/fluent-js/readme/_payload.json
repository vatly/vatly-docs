002Ffluent"," on your server.\nVatly is the European merchant of record for AI, software and digital products.\nInstall the tested alpha pair:",[486,487,492],"pre",{"className":488,"code":489,"language":490,"meta":491,"style":491},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install --save-exact @getvatly\u002Fsdk@0.3.0-alpha.2 @getvatly\u002Ffluent@0.1.0-alpha.1\n","sh","",[481,493,494],{"__ignoreMap":491},[495,496,499,503,507,510,513],"span",{"class":497,"line":498},"line",1,[495,500,502],{"class":501},"sBMFI","npm",[495,504,506],{"class":505},"sfazB"," install",[495,508,509],{"class":505}," --save-exact",[495,511,512],{"class":505}," @getvatly\u002Fsdk@0.3.0-alpha.2",[495,514,515],{"class":505}," @getvatly\u002Ffluent@0.1.0-alpha.1\n",[517,518,520],"h2",{"id":519},"start-a-subscription","Start a subscription",[471,522,523],{},"Use a customer and plan from the key's storefront and mode. Check that the\nsigned-in user owns the customer before calling this function:",[486,525,529],{"className":526,"code":527,"language":528,"meta":491,"style":491},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { VatlyClient } from '@getvatly\u002Fsdk';\nimport { Vatly } from '@getvatly\u002Ffluent';\n\nexport async function startSubscription(apiKey: string, customerId: string, planId: string) {\n  const vatly = new Vatly({\n    api: new VatlyClient({ apiKey }),\n    redirectUrlSuccess: 'https:\u002F\u002Fapp.example.com\u002Fbilling\u002Freturn',\n    redirectUrlCanceled: 'https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled',\n  });\n  const checkout = await vatly.subscribe({ vatlyId: customerId })\n    .toPlan(planId)\n    .withQuantity(1)\n    .create();\n  return checkout.getUrl(); \u002F\u002F Redirect the customer's browser to this URL.\n}\n","ts",[481,530,531,563,585,592,647,670,697,714,731,741,778,794,810,823,845],{"__ignoreMap":491},[495,532,533,537,541,54