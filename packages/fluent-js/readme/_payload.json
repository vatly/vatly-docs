g changes. Pin exact versions during alpha.",[474,481,482,483,487],{},"Create checkouts and manage billing with ",[484,485,486],"code",{},"@getvatly\u002Ffluent"," on your server.\nVatly is the European merchant of record for AI, software and digital products.\nInstall the tested alpha pair:",[489,490,495],"pre",{"className":491,"code":492,"language":493,"meta":494,"style":494},"language-sh shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","npm install --save-exact @getvatly\u002Fsdk@0.3.0-alpha.2 @getvatly\u002Ffluent@0.1.0-alpha.1\n","sh","",[484,496,497],{"__ignoreMap":494},[498,499,502,506,510,513,516],"span",{"class":500,"line":501},"line",1,[498,503,505],{"class":504},"sBMFI","npm",[498,507,509],{"class":508},"sfazB"," install",[498,511,512],{"class":508}," --save-exact",[498,514,515],{"class":508}," @getvatly\u002Fsdk@0.3.0-alpha.2",[498,517,518],{"class":508}," @getvatly\u002Ffluent@0.1.0-alpha.1\n",[520,521,523],"h2",{"id":522},"start-a-subscription","Start a subscription",[474,525,526],{},"Use a customer and plan from the key's storefront and mode. Check that the\nsigned-in user owns the customer before calling this function:",[489,528,532],{"className":529,"code":530,"language":531,"meta":494,"style":494},"language-ts shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","import { VatlyClient } from '@getvatly\u002Fsdk';\nimport { Vatly } from '@getvatly\u002Ffluent';\n\nexport async function startSubscription(apiKey: string, customerId: string, planId: string) {\n  const vatly = new Vatly({\n    api: new VatlyClient({ apiKey }),\n    redirectUrlSuccess: 'https:\u002F\u002Fapp.example.com\u002Fbilling\u002Freturn',\n    redirectUrlCanceled: 'https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled',\n  });\n  const checkout = await vatly.subscribe({ vatlyId: customerId })\n    .toPlan(planId)\n    .withQuantity(1)\n    .create();\n  return checkout.getUrl(); \u002F\u002F Redirect the custom