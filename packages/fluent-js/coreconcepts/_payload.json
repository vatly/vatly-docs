859],{},[480,860,861],{},"bind(vatlyId, hostId)",[739,863,864],{},"Associate IDs atomically; enforce uniqueness on both sides.",[724,866,867,872],{},[739,868,869],{},[480,870,871],{},"record(vatlyId)",[739,873,874],{},"Record an unattributed customer without clearing an existing binding.",[724,876,877,882],{},[739,878,879],{},[480,880,881],{},"vatlyCustomerIdFor(hostId)",[739,883,884],{},"Return the Vatly ID or null.",[724,886,887,892],{},[739,888,889],{},[480,890,891],{},"hostCustomerIdFor(vatlyId)",[739,893,894],{},"Return the host ID or null.",[469,896,897,898,902],{},"Do not silently reassign bindings. Keep test and live data separate. See\n",[899,900,901],"a",{"href":298},"customers"," for creation and lookup examples.",[696,904,906],{"id":905},"webhook-storage","Webhook storage",[469,908,909,910,913,914,917,918,922],{},"Wire ",[480,911,912],{},"webhookCalls"," for deduplication and audit retention, and ",[480,915,916],{},"events"," for outbox\nwrites. They must share a transaction with repositories and bindings. Use your\ndatabase's transaction context or request-scoped drivers, not a global variable\nshared by concurrent requests. The ",[899,919,921],{"href":920},"\u002Fpackages\u002Ffluent-js\u002Fwebhooks#idempotency-and-one-transaction","webhook transaction steps","\ndefine what must commit or roll back together.",[469,924,925,926,716],{},"For remote resource fields, use the ",[899,927,280],{"href":928,"rel":929},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[930],"nofollow",[932,933,934],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html 