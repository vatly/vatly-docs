,692],"table",{},[680,681,682],"thead",{},[683,684,685,689],"tr",{},[686,687,688],"th",{},"Method",[686,690,691],{},"Return value",[693,694,695,706,716],"tbody",{},[683,696,697,703],{},[698,699,700],"td",{},[439,701,702],{},"findByVatlyId(id)",[698,704,705],{},"Record or null.",[683,707,708,713],{},[698,709,710],{},[439,711,712],{},"store(data)",[698,714,715],{},"Saved record, or null to decline storage and skip the local-created event.",[683,717,718,723],{},[698,719,720],{},[439,721,722],{},"update(id, partial)",[698,724,725,726,729],{},"Updated record. Omitted\u002F",[439,727,728],{},"undefined"," fields stay unchanged; null clears a nullable field.",[428,731,732,733,736],{},"Enforce unique Vatly IDs per tenant, storefront, and mode. Adapt existing tables\nrather than duplicating them. ",[439,734,735],{},"store"," can match a pending host record using\ncheckout metadata and attach its Vatly ID. Metadata helps match records; it does\nnot authorize access.",[428,738,739,742,743,746,747,750,751,754,755,758,759,762],{},[439,740,741],{},"refunds"," and ",[439,744,745],{},"chargebacks"," use ",[439,748,749],{},"ReversalRepository",", which adds ",[439,752,753],{},"listForOrder(id)","\nand ",[439,756,757],{},"listForCustomer(id)",". Contracts accept sync or async implementations, except\n",[439,760,761],{},"webhookCalls.process",", which returns a promise.",[655,764,766],{"id":765},"billables-and-bindings","Billables and bindings",[428,768,769,770,773,774,777,778,781,782,785,786,789,790,793,794,796],{},"Keep your user, team, or organization as the billable; there is no ",[439,771,772],{},"Billable"," mixin.\n",[439,775,776],{},"CustomerProfile"," carries ",[439,779,780],{},"vatlyId",", ",[439,783,784],{},"email",", and optional ",[439,787,788],{},"name",". Your application's\nID (",[439,791,792],{},"hostId",") is separate from Vatly's customer ID (",[439,795,780],{},"). Authorize both.",[677,798,799,812],{},[680,800,801],{},[683,802,803,809],{},[686,804,805,808],{},[439,806,807],{},"CustomerBindings"," method",[686,810,811],{},"Behavior",[693,813,814,824,834,844],{},[683,815,816,821],{},[698,817,818],{},[439,819,820],{},"bind(vatlyId, hostId)",[698,822,823],{},"Associate IDs atomically; enforce uniqueness on both sides.",[683,825,826,831],{},[698,827,828],{},[439,829,830],{},"record(vatlyId)",[698,832,833],{},"Record an unattributed customer without clearing an existing binding.",[683,835,836,841],{},[698,837,838],{},[439,839,840],{},"vatlyCustomerIdFor(hostId)",[698,842,843],{},"Return the Vatly ID or null.",[683,845,846,851],{},[698,847,848],{},[439,849,850],{},"hostCustomerIdFor(vatlyId)",[698,852,853],{},"Return the host ID or null.",[428,855,856,857,861],{},"Do not silently reassign bindings. Keep test and live data separate. See\n",[858,859,860],"a",{"href":264},"customers"," for creation and lookup examples.",[655,863,865],{"id":864},"webhook-storage","Webhook storage",[428,867,868,869,872,873,876,877,881],{},"Wire ",[439,870,871],{},"webhookCalls"," for deduplication and audit retention, and ",[439,874,875],{},"events"," for outbox\nwrites. They must share a transaction with repositories and bindings. Use your\ndatabase's transaction context or request-scoped drivers, not a global variable\nshared by concurrent requests. The ",[858,878,880],{"href":879},"\u002Fpackages\u002Ffluent-js\u002Fwebhooks#idempotency-and-one-transaction","webhook transaction steps","\ndefine what must commit or roll back together.",[428,883,884,885,675],{},"For remote resource fields, use the ",[858,886,307],{"href":887,"rel":888},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[889],"nofollow",[891,892,893],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89