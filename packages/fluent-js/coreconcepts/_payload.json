,559],{"class":520},[507,708,709],{"class":524}," orders",[507,711,712],{"class":520}," };\n",[507,714,716],{"class":509,"line":715},9,[507,717,718],{"class":520},"}\n",[720,721,723],"h2",{"id":722},"repository-behavior","Repository behavior",[493,725,726,729,730,733,734,736,737,740],{},[504,727,728],{},"Stored\u003CT>"," adds ",[504,731,732],{},"hostCustomerId"," to the SDK resource. It is null for an unattributed\ncustomer. ",[504,735,628],{}," also adds ",[504,738,739],{},"endsAt",".",[742,743,744,757],"table",{},[745,746,747],"thead",{},[748,749,750,754],"tr",{},[751,752,753],"th",{},"Method",[751,755,756],{},"Return value",[758,759,760,771,781],"tbody",{},[748,761,762,768],{},[763,764,765],"td",{},[504,766,767],{},"findByVatlyId(id)",[763,769,770],{},"Record or null.",[748,772,773,778],{},[763,774,775],{},[504,776,777],{},"store(data)",[763,779,780],{},"Saved record, or null to decline storage and skip the local-created event.",[748,782,783,788],{},[763,784,785],{},[504,786,787],{},"update(id, partial)",[763,789,790,791,794],{},"Updated record. Omitted\u002F",[504,792,793],{},"undefined"," fields stay unchanged; null clears a nullable field.",[493,796,797,798,801],{},"Enforce unique Vatly IDs per tenant, storefront, and mode. Adapt existing tables\nrather than duplicating them. ",[504,799,800],{},"store"," can match a pending host record using\ncheckout metadata and attach its Vatly ID. Metadata helps match records; it does\nnot authorize access.",[493,803,804,807,808,811,812,815,816,819,820,823,824,827],{},[504,805,806],{},"refunds"," and ",[504,809,810],{},"chargebacks"," use ",[504,813,814],{},"ReversalRepository",", which adds ",[504,817,818],{},"listForOrder(id)","\nand ",[504,821,822],{},"listForCustomer(id)",". Contracts accept sync or async implementations, except\n",[504,825,826],{},"webhookCalls.process",", which returns a promise.",[720,829,831],{"id":830},"billables-and-bindings","Billables and bindings",[493,833,834,835,838,839,842,843,846,847,850,851,854,855,858,859,861],{},"Keep your user, team, or organization as the billable; there is no ",[504,836,837],{},"Billable"," mixin.\n",[504,840,841],{},"CustomerProfile"," carries ",[504,844,845],{},"vatlyId",", ",[504,848,849],{},"email",", and optional ",[504,852,853],{},"name",". Your application's\nID (",[504,856,857],{},"hostId",") is separate from Vatly's customer ID (",[504,860,845],{},"). Authorize both.",[742,863,864,877],{},[745,865,866],{},[748,867,868,874],{},[751,869,870,873],{},[504,871,872],{},"CustomerBindings"," method",[751,875,876],{},"Behavior",[758,878,879,889,899,909],{},[748,880,881,886],{},[763,882,883],{},[504,884,885],{},"bind(vatlyId, hostId)",[763,887,888],{},"Associate IDs atomically; enforce uniqueness on both sides.",[748,890,891,896],{},[763,892,893],{},[504,894,895],{},"record(vatlyId)",[763,897,898],{},"Record an unattributed customer without clearing an existing binding.",[748,900,901,906],{},[763,902,903],{},[504,904,905],{},"vatlyCustomerIdFor(hostId)",[763,907,908],{},"Return the Vatly ID or null.",[748,910,911,916],{},[763,912,913],{},[504,914,915],{},"hostCustomerIdFor(vatlyId)",[763,917,918],{},"Return the host ID or null.",[493,920,921,922,926],{},"Do not silently reassign bindings. Keep test and live data separate. See\n",[923,924,925],"a",{"href":292},"customers"," for creation and lookup examples.",[720,928,930],{"id":929},"webhook-storage","Webhook storage",[493,932,933,934,937,938,941,942,946],{},"Wire ",[504,935,936],{},"webhookCalls"," for deduplication and audit retention, and ",[504,939,940],{},"events"," for outbox\nwrites. They must share a transaction with repositories and bindings. Use your\ndatabase's transaction context or request-scoped drivers, not a global variable\nshared by concurrent requests. The ",[923,943,945],{"href":944},"\u002Fpackages\u002Ffluent-js\u002Fwebhooks#idempotency-and-one-transaction","webhook transaction steps","\ndefine what must commit or roll back together.",[493,948,949,950,740]