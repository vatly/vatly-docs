 Checkout and customer\ncreation throw ",[508,807,808],{},"FluentError"," before sending anything outside those limits.",[497,811,812,815,816,819,820,823,824,827,828,831,832,835],{},[508,813,814],{},"refunds"," and ",[508,817,818],{},"chargebacks"," use ",[508,821,822],{},"ReversalRepository",", which adds ",[508,825,826],{},"listForOrder(id)","\nand ",[508,829,830],{},"listForCustomer(id)",". Contracts accept sync or async implementations, except\n",[508,833,834],{},"webhookCalls.process",", which returns a promise.",[724,837,839],{"id":838},"billables-and-bindings","Billables and bindings",[497,841,842,843,846,847,850,851,854,855,858,859,862,863,866,867,869],{},"Keep your user, team, or organization as the billable; there is no ",[508,844,845],{},"Billable"," mixin.\n",[508,848,849],{},"CustomerProfile"," carries ",[508,852,853],{},"vatlyId",", ",[508,856,857],{},"email",", and optional ",[508,860,861],{},"name",". Your application's\nID (",[508,864,865],{},"hostId",") is separate from Vatly's customer ID (",[508,868,853],{},"). Authorize both.",[746,871,872,885],{},[749,873,874],{},[752,875,876,882],{},[755,877,878,881],{},[508,879,880],{},"CustomerBindings"," method",[755,883,884],{},"Behavior",[762,886,887,897,907,917],{},[752,888,889,894],{},[767,890,891],{},[508,892,893],{},"bind(vatlyId, hostId)",[767,895,896],{},"Associate IDs atomically; enforce uniqueness on both sides.",[752,898,899,904],{},[767,900,901],{},[508,902,903],{},"record(vatlyId)",[767,905,906],{},"Record an unattributed customer without clearing an existing binding.",[752,908,909,914],{},[767,910,911],{},[508,912,913],{},"vatlyCustomerIdFor(hostId)",[767,915,916],{},"Return the Vatly ID or null.",[752,918,919,924],{},[767,920,921],{},[508,922,923],{},"hostCustomerIdFor(vatlyId)",[767,925,926],{},"Return the host ID or null.",[497,928,929,930,934],{},"Do not silently reassign bindings. Keep test and live data separate. See\n",[931,932,933],"a",{"href":323},"customers"," for creation and lookup examples.",[724,936,938],{"id":937},"webhook-storage","Webhook storage",[497,940,941,942,945,946,949,950,954],{},"Wire ",[508,943,944],{},"webhookCalls"," for deduplication and audit retention, and ",[508,947,948],{},"events"," for outbox\nwrites. They must share a transaction with repositories and bindings. Use your\ndatabase's transaction context or request-scoped drivers, not a global variable\nshared by concurrent requests. The ",[931,951,953],{"href":952},"\u002Fpackages\u002Ffluent-js\u002Fwebhooks#idempotency-and-one-transaction","webhook transaction steps","\ndefine what must commit or roll back together.",[497,956,957,958,744],{},"For remote resource fields, use the ",[931,959,305],{"href":960,"rel":961},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[962],"nofollow",[964,965,966],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sHdIc, html code.shiki .sHdIc{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#EEFFFF;--shiki-default-font-style:italic;--shiki-dark:#BABED8;--shiki-dark-font-style:italic}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shi