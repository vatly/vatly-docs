t",".",[721,722,723,736],"table",{},[724,725,726],"thead",{},[727,728,729,733],"tr",{},[730,731,732],"th",{},"Method",[730,734,735],{},"Return value",[737,738,739,750,760],"tbody",{},[727,740,741,747],{},[742,743,744],"td",{},[483,745,746],{},"findByVatlyId(id)",[742,748,749],{},"Record or null.",[727,751,752,757],{},[742,753,754],{},[483,755,756],{},"store(data)",[742,758,759],{},"Saved record, or null to decline storage and skip the local-created event.",[727,761,762,767],{},[742,763,764],{},[483,765,766],{},"update(id, partial)",[742,768,769,770,773],{},"Updated record. Omitted\u002F",[483,771,772],{},"undefined"," fields stay unchanged; null clears a nullable field.",[472,775,776,777,780],{},"Enforce unique Vatly IDs per tenant, storefront, and mode. Adapt existing tables\nrather than duplicating them. ",[483,778,779],{},"store"," can match a pending host record using\ncheckout metadata and attach its Vatly ID. Metadata helps match records; it does\nnot authorize access.",[472,782,783,786,787,790,791,794,795,798,799,802,803,806],{},[483,784,785],{},"refunds"," and ",[483,788,789],{},"chargebacks"," use ",[483,792,793],{},"ReversalRepository",", which adds ",[483,796,797],{},"listForOrder(id)","\nand ",[483,800,801],{},"listForCustomer(id)",". Contracts accept sync or async implementations, except\n",[483,804,805],{},"webhookCalls.process",", which returns a promise.",[699,808,810],{"id":809},"billables-and-bindings","Billables and bindings",[472,812,813,814,817,818,821,822,825,826,829,830,833,834,837,838,840],{},"Keep your user, team, or organization as the billable; there is no ",[483,815,816],{},"Billable"," mixin.\n",[483,819,820],{},"CustomerProfile"," carries ",[483,823,824],{},"vatlyId",", ",[483,827,828],{},"email",", and optional ",[483,831,832],{},"name",". Your application's\nID (",[483,835,836],{},"hostId",") is separate from Vatly's customer ID (",[483,839,824],{},"). Authorize both.",[721,842,843,856],{},[724,844,845],{},[727,846,847,853],{},[730,848,849,852],{},[483,850,851],{},"CustomerBindings"," method",[730,854,855],{},"Behavior",[737,857,858,868,878,888],{},[727,859,860,865],{},[742,861,862],{},[483,863,864],{},"bind(vatlyId, hostId)",[742,866,867],{},"Associate IDs atomically; enforce uniqueness on both sides.",[727,869,870,875],{},[742,871,872],{},[483,873,874],{},"record(vatlyId)",[742,876,877],{},"Record an unattributed customer without clearing an existing binding.",[727,879,880,885],{},[742,881,882],{},[483,883,884],{},"vatlyCustomerIdFor(hostId)",[742,886,887],{},"Return the Vatly ID or null.",[727,889,890,895],{},[742,891,892],{},[483,893,894],{},"hostCustomerIdFor(vatlyId)",[742,896,897],{},"Return the host ID or null.",[472,899,900,901,905],{},"Do not silently reassign bindings. Keep test and live data separate. See\n",[902,903,904],"a",{"href":298},"customers"," for creation and lookup examples.",[699,907,909],{"id":908},"webhook-storage","Webhook storage",[472,911,912,913,916,917,920,921,925],{},"Wire ",[483,914,915],{},"webhookCalls"," for deduplication and audit retention, and ",[483,918,919],{},"events"," for outbox\nwrites. They must share a transaction with repositories and bindings. Use your\ndatabase's transaction context or request-scoped drivers, not a global variable\nshared by concurrent requests. The ",[902,922,924],{"href":923},"\u002Fpackages\u002Ffluent-js\u002Fwebhooks#idempotency-and-one-transaction","webhook transaction steps","\ndefine what must commit or roll back together.",[472,927,928,929,719],{},"For remote resource fields, use the ",[902,930,280],{"href":931,"rel":932},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[933],"nofollow",[935,936,937],"style",{},"html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DD