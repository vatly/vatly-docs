,[515,705,676],{"class":632},[515,707,708],{"class":521}," 403",[515,710,546],{"class":529},[515,712,714],{"class":517,"line":713},11,[515,715,716],{"class":529},"    }\n",[515,718,720],{"class":517,"line":719},12,[515,721,722],{"class":529},"}\n",[493,724,725],{},"Use the returned integer as your HTTP response status. Other failures must produce a non-2xx response so Vatly can retry. Register your public HTTPS receiver in Vatly, set its signing secret in your configuration, and exempt only that route from browser CSRF checks. Never disable signature verification.",[727,728,730],"h2",{"id":729},"verify-the-exact-bytes","Verify the exact bytes",[493,732,733,734,737],{},"The header format is ",[497,735,736],{},"t=\u003Cunix_seconds>,v1=\u003Chex_hmac_sha256>",". The signed message is the timestamp, a dot, and the raw body. The SDK checks the signature and timestamp replay window, then validates the envelope. Do not decode and re-encode JSON before verification. Use the endpoint's signing secret, not your API key.",[493,739,740,741,743],{},"Valid deliveries are recorded, mapped to typed events, passed through built-in reactions, then dispatched to your event bus. The signed resource snapshot supplies the data; built-in reactions do not make enrichment API calls. See ",[502,742,206],{"href":207}," for the storage mapping.",[727,745,747],{"id":746},"make-retries-transactional","Make retries transactional",[493,749,750],{},"The simple receiver above does not guarantee idempotency. Fluent's audit repository is not a processed-event ledger, and listeners can run again on redelivery. Use a durable event claim in the same database transaction as the audit log, billing writes, and outbox writes.",[493,752,753],{},"Here is a complete SQLite transaction boundary. Create this table once in your application's migrations:",[506,755,759],{"className":756,"code":757,"language":758,"meta":511,"style":511},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE processed_vatly_events (\n    event_id TEXT PRIMARY KEY\n);\n","sql",[497,760,761,775,786],{"__ignoreMap":511},[515,762,763,766,769,772],{"class":517,"line":518},[515,764,765],{"class":521},"CREATE",[515,767,768],{"class":521}," TABLE",[515,770,771],{"class":581}," processed_vatly_events",[515,773,774],{"class":525}," (\n",[515,776,777,780,783],{"class":517,"line":549},[515,778,779],{"class":525},"    event_id ",[515,781,782],{"class":577},"TEXT",[515,784,785],{"class":577}," PRIMARY KEY\n",[515,787,788],{"class":517,"line":567},[515,789,670],{"class":525},[493,791,792,793,796,797,504],{},"Use a PDO connection in exception mode. Every repository and your outbox dispatcher must share this connection and must not commit independently. Supply the same ",[497,794,795],{},"$secret"," that is configured on ",[497,798,799],{},"$vatly",[506,801,803],{"className":508,"code":802,"language":510,"meta":511,"style":511},"use Vatly\\API\\Exceptions\\InvalidSignatureException;\nuse Vatly\\API\\Webhooks\\Webhook;\nuse Vatly\\Fluent\\Vatly;\n\nfunction receiveOnce(PDO $db, Vatly $vatly, string $body, string $signature, string $secret): int\n{\n    try {\n        $verified = Webhook::parse($body, $signature, $secret);\n    } catch (InvalidSignatureException | InvalidArgumentException) {\n        return 403;\n    }\n\n    $db->beginTransaction();\n    try {\n        $claim = $db->prepare('INSERT OR IGNORE INTO processed_vatly_events (event_id) VALUES (?)');\n        $claim->execute([$verified->id]);\n        if ($claim->rowCount() === 0) {\n            $db->commit();\n            return 201;\n        }\n\n        $vatly->webhookProcessor()->handle($body, $signature);\n        $db->commit();\n        return 201;\n    } catch (Throwable $error) {\n        $db->rollBack();\n        throw $error;\n    }\n}\n",[497,804,805,827,848,864,868,923,927,933,970,990,998,1002,1006,1022,1029,1079,1106,1135,1150,1160,1166,1171,1198,1211,1220,1241,1255,1267,1272],{"__ign