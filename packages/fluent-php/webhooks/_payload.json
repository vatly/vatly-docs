7,708,709,712],{},"The header format is ",[472,710,711],{},"t=\u003Cunix_seconds>,v1=\u003Chex_hmac_sha256>",". The signed message is the timestamp, a dot, and the raw body. The SDK checks the signature and timestamp replay window, then validates the envelope. Do not decode and re-encode JSON before verification. Use the endpoint's signing secret, not your API key.",[468,714,715,716,719],{},"Valid deliveries are recorded, mapped to typed events, passed through built-in reactions, then dispatched to your event bus. The signed resource snapshot supplies the data; built-in reactions do not make enrichment API calls. See ",[477,717,718],{"href":201},"Event flow"," for the storage mapping.",[702,721,723],{"id":722},"make-retries-transactional","Make retries transactional",[468,725,726],{},"The simple receiver above does not guarantee idempotency. Fluent's audit repository is not a processed-event ledger, and listeners can run again on redelivery. Use a durable event claim in the same database transaction as the audit log, billing writes, and outbox writes.",[468,728,729],{},"Here is a complete SQLite transaction boundary. Create this table once in your application's migrations:",[481,731,735],{"className":732,"code":733,"language":734,"meta":486,"style":486},"language-sql shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","CREATE TABLE processed_vatly_events (\n    event_id TEXT PRIMARY KEY\n);\n","sql",[472,736,737,751,762],{"__ignoreMap":486},[490,738,739,742,745,748],{"class":492,"line":493},[490,740,741],{"class":496},"CREATE",[490,743,744],{"class":496}," TABLE",[490,746,747],{"class":556}," processed_vatly_events",[490,749,750],{"class":500}," (\n",[490,752,753,756,759],{"class":492,"line":524},[490,754,755],{"class":500},"    event_id ",[490,757,758],{"class":552},"TEXT",[490,760,761],{"class":552}," PRIMARY KEY\n",[490,763,764],{"class":492,"line":542},[490,765,645],{"class":500},[468,767,768,769,772,773,479],{},"Use a PDO connection in exception mode. Every repository and your outbox dispatcher must share this connection and must not commit independently. Supply the same ",[472,770,771],{},"$secret"," that is configured on ",[472,774,775],{},"$vatly",[481,777,779],{"className":483,"code":778,"language":485,"meta":486,"style":486},"use Vatly\\API\\Exceptions\\InvalidSignatureException;\nuse Vatly\\API\\Webhooks\\Webhook;\nuse Vatly\\Fluent\\Vatly;\n\nfunction receiveOnce(PDO $db, Vatly $vatly, string $body, string $signature, string $secret): int\n{\n    try {\n        $verified = Webhook::parse($body, $signature, $secret);\n    } catch (InvalidSignatureException | InvalidArgumentException) {\n        return 403;\n    }\n\n    $db->beginTransaction();\n    try {\n        $claim = $db->prepare('INSERT OR IGNORE INTO processed_vatly_events (event_id) VALUES (?)');\n        $claim->execute([$verified->id]);\n        if ($claim->rowCount() === 0) {\n            $db->commit();\n            return 201;\n        }\n\n        $vatly->webhookProcessor()->handle($body, $signature);\n        $db->commit();\n        return 201;\n    } catch (Throwable $error) {\n        $db->rollBack();\n        throw $error;\n    }\n}\n",[472,780,781,803,824,840,844,899,903,909,946,966,974,978,982,998,1005,1055,1082,1111,1126,1136,1142,1147,1174,1187,1196,1217,1231,1243,1248],{"__ignoreMap":486},[490,782,783,785,787,789,792,794,796,798,801],{"class":492,"line":493},[490,784,497],{"class":496},[490,786,501],{"class":500},[490,788,505],{"class":504},[490,790,791],{"class":500},"API",[490,793,505],{"class":504},[490,795,513],{"class":500},[490,797,505],{"class":504},[490,799,800],{"class":500},"InvalidSignatureException",[490,802,521],{"class":504},[490,804,805,807,809,811,813,815,817,819,822],{"class":492,"line":524},[490,806,497],{"class":496},[490,808,501],{"class":500},[490,810,505],{"class":504},[490,812,791],{"class":500},[490,814,505],{"class":504},[490,816,50],{"class":500},[490,818,505],{"class":504},[490,820,821]