er function uses the fully wired instance from ",[477,478,177],"a",{"href":178},":",[481,482,487],"pre",{"className":483,"code":484,"language":485,"meta":486,"style":486},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\Exceptions\\InvalidWebhookSignatureException;\nuse Vatly\\Fluent\\Vatly;\n\nfunction receiveWebhook(Vatly $vatly, string $rawBody, string $signature): int\n{\n    try {\n        $vatly->webhookProcessor()->handle($rawBody, $signature);\n        return 201;\n    } catch (InvalidWebhookSignatureException) {\n        return 403;\n    }\n}\n","php","",[472,488,489,522,540,547,596,602,612,646,657,676,686,692],{"__ignoreMap":486},[490,491,494,498,502,506,509,511,514,516,519],"span",{"class":492,"line":493},"line",1,[490,495,497],{"class":496},"sbssI","use",[490,499,501],{"class":500},"sTEyZ"," Vatly",[490,503,505],{"class":504},"sMK4o","\\",[490,507,508],{"class":500},"Fluent",[490,510,505],{"class":504},[490,512,513],{"class":500},"Exceptions",[490,515,505],{"class":504},[490,517,518],{"class":500},"InvalidWebhookSignatureException",[490,520,521],{"class":504},";\n",[490,523,525,527,529,531,533,535,538],{"class":492,"line":524},2,[490,526,497],{"class":496},[490,528,501],{"class":500},[490,530,505],{"class":504},[490,532,508],{"class":500},[490,534,505],{"class":504},[490,536,537],{"class":500},"Vatly",[490,539,521],{"class":504},[490,541,543],{"class":492,"line":542},3,[490,544,546],{"emptyLinePlaceholder":545},true,"\n",[490,548,550,554,558,561,564,567,570,573,576,578,581,583,585,587,590,593],{"class":492,"line":549},4,[490,551,553],{"class":552},"spNyl","function",[490,555,557],{"class":556},"s2Zo4"," receiveWebhook",[490,559,560],{"class":504},"(",[490,562,537],{"class":563},"sBMFI",[490,565,566],{"class":504}," $",[490,568,569],{"class":500},"vatly",[490,571,572],{"class":504},",",[490,574,575],{"class":496}," string",[490,577,566],{"class":504},[490,579,580],{"class":500},"rawBody",