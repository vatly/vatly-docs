lass":532},"chargebacks",[506,797,564],{"class":512},[506,799,801,803,806,808,810,812,814,817],{"class":508,"line":800},8,[506,802,513],{"class":512},[506,804,805],{"class":516},"lines ",[506,807,520],{"class":512},[506,809,523],{"class":512},[506,811,533],{"class":516},[506,813,529],{"class":512},[506,815,816],{"class":532},"lines",[506,818,564],{"class":512},[484,820,821],{},"Reversal amounts are net of tax, in integer cents. They come from the live API, not a sum of your local records. The handle fetches the API order once and shares that snapshot with invoice and reversal helpers. Build a new handle when you need a fresh snapshot.",[484,823,824,825,828],{},"The order remains ",[488,826,827],{},"paid"," after a reversal; do not invent a refunded order status. Your application decides what a refund or dispute means for access.",[484,830,831,834,835,838,839,842],{},[488,832,833],{},"refunds()",", ",[488,836,837],{},"chargebacks()",", and ",[488,840,841],{},"lines()"," are local reads. Each returns an empty array if its optional repository is not wired. That does not prove the API has no such records. Wire refund and chargeback repositories to persist their events. Persist lines in your order writer and supply an order-line repository to read them back.",[641,844,846],{"id":845},"find-a-subscriptions-orders","Find a subscription's orders",[484,848,849],{},"List the local lines of every order a subscription generated, including the initial signup order, through the order-line repository you wired:",[497,851,853],{"className":499,"code":852,"language":501,"meta":502,"style":502},"$lines = $orderLines->listForSubscription($subscriptionId);\n$orderIds = array_unique(array_map(fn ($line) => $line->getOrderId(), $lines));\n",[488,854,855,880],{"__ignoreMap":502},[506,856,857,859,861,863,865,868,870,873,875,878],{"class":508,"line":509},[506,858,513],{"class":512},[506,860,805],{"class":516},[506,862,520],{"class":512},[506,864,523],{"class":512},[506,866,867],{"class":516