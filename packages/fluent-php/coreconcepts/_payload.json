:500},[486,800,802,805,807,809,811],{"class":488,"line":801},19,[486,803,804],{"class":689},"        config",[486,806,475],{"class":500},[486,808,693],{"class":500},[486,810,696],{"class":496},[486,812,699],{"class":500},[486,814,816,819,821,823,825],{"class":488,"line":815},20,[486,817,818],{"class":689},"        subscriptions",[486,820,475],{"class":500},[486,822,693],{"class":500},[486,824,723],{"class":496},[486,826,699],{"class":500},[486,828,830,833,835,837,839],{"class":488,"line":829},21,[486,831,832],{"class":689},"        orders",[486,834,475],{"class":500},[486,836,693],{"class":500},[486,838,736],{"class":496},[486,840,699],{"class":500},[486,842,844,847,849,851,853],{"class":488,"line":843},22,[486,845,846],{"class":689},"        webhookCalls",[486,848,475],{"class":500},[486,850,693],{"class":500},[486,852,749],{"class":496},[486,854,699],{"class":500},[486,856,858,861,863,865,867],{"class":488,"line":857},23,[486,859,860],{"class":689},"        events",[486,862,475],{"class":500},[486,864,693],{"class":500},[486,866,762],{"class":496},[486,868,699],{"class":500},[486,870,872,875,877,879,881],{"class":488,"line":871},24,[486,873,874],{"class":689},"        customerBindings",[486,876,475],{"class":500},[486,878,693],{"class":500},[486,880,710],{"class":496},[486,882,699],{"class":500},[486,884,886],{"class":488,"line":885},25,[486,887,888],{"class":500},"    ));\n",[486,890,892],{"class":488,"line":891},26,[486,893,894],{"class":500},"}\n",[468,896,897,898,905],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[899,900,904],"a",{"href":901,"rel":902},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[903],"nofollow","vatly-laravel"," instead of writing this wiring.",[907,908,910],"h2",{"id":909},"choose-the-billable","Choose the billable",[468,912,913,914,917,918,921,922,924],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[472,915,916],{},"Billable"," interface or required base model. Give Fluent a ",[472,919,920],{},"CustomerProfile"," with a Vatly customer ID, or use ",[899,923,68],{"href":181}," to create and bind one to your host ID.",[468,926,927],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[907,929,931],{"id":930},"save-local-billing-state","Save local billing state",[933,934,935,948],"table",{},[936,937,938],"thead",{},[939,940,941,945],"tr",{},[942,943,944],"th",{},"Contract",[942,946,947],{},"Your implementation does",[949,950,951,961,970,979,988],"tbody",{},[939,952,953,958],{},[954,955,956],"td",{},[472,957,537],{},[954,959,960],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[939,962,963,967],{},[954,964,965],{},[472,966,603],{},[954,968,969],{},"Finds by Vatly ID, stores a subscription, updates it.",[939,971,972,976],{},[954,973,974],{},[472,975,581],{},[954,977,978],{},"Finds by Vatly ID, stores an order, updates it.",[939,980,981,985],{},[954,982,983],{},[472,984,625],{},[954,986,987],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing.",[939,989,990,994],{},[954,991,992],{},[472,993,559],{},[954,995,996,997,1000],{},"Dispatches typed events to your listeners. ",[472,998,999],{},"NullEventDispatcher"," is available if you need no listeners.",[468,1002,1003,1004,1007,1008,1011,1012,1015],{},"Repositories return your objects implementing ",[472,1005,1006],{},"SubscriptionInterface"," or ",[472,1009,1010],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[899,1013,1014],{"href":205},"Host tables",". Reader and writer contracts are also available separately when a component needs only one role.",[468,1017,1018,1019,1022,1023,1026,1027,1030],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[472,1020,1021],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[472,1024,1025],{},"store()"," methods may return ",[472,1028,1029],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[907,1032,1034],{"id":1033},"apply-partial-updates-correctly","Apply partial updates correctly",[468,1036,1037,1040,1041,1044,1045,1048,1049,1052],{},[472,1038,1039],{},"Store*Data"," and ",[472,1042,1043],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[472,1046,1047],{},"Money"," objects instead; use ",[472,1050,1051],{},"toCents()"," at your own persistence boundary.",[468,1054,1055,1056,1058,1059,1040,1062,1065],{},"In updates, ",[472,1057,1029],{}," normally means leave the stored value alone. Subscription updates have explicit ",[472,1060,1061],{},"clearEndsAt",[472,1063,1064],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[468,1067,1068,1069,1072,1073,1076],{},"Persist ",[472,1070,1071],{},"testmode"," from store data and expose it through the entity's ",[472,1074,1075],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[468,1078,1079,1082,1083,1086],{},[472,1080,1081],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[472,1084,1085],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[907,1088,1090],{"id":1089},"add-optional-records","Add optional records",[468,1092,1093,1095,1096,1099,1100,1103,1104,1107,1108,1111],{},[472,1094,474],{}," also accepts ",[472,1097,1098],{},"refunds",", ",[472,1101,1102],{},"chargebacks",", and ",[472,1105,1106],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[472,1109,1110],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[468,1113,1114,1115,1117,1118,1121,1122,1126],{},"Use ",[899,1116,50],{"href":197}," for transactions and ",[899,1119,1120],{"href":201},"Event flow"," for the event-to-storage mapping. Field details live in the ",[899,1123,280],{"href":1124,"rel":1125},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[903],".",[1128,1129,1130],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--sh