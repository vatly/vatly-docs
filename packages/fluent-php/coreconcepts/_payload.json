"line":756},14,[514,758,759],{"class":717},"    OrderRepositoryInterface",[514,761,721],{"class":528},[514,763,764],{"class":524},"orders",[514,766,727],{"class":528},[514,768,770,773,775,778],{"class":516,"line":769},15,[514,771,772],{"class":717},"    WebhookCallRepositoryInterface",[514,774,721],{"class":528},[514,776,777],{"class":524},"webhookCalls",[514,779,727],{"class":528},[514,781,783,786,788,791],{"class":516,"line":782},16,[514,784,785],{"class":717},"    EventDispatcherInterface",[514,787,721],{"class":528},[514,789,790],{"class":524},"events",[514,792,727],{"class":528},[514,794,796,799,801],{"class":516,"line":795},17,[514,797,798],{"class":528},"):",[514,800,525],{"class":717},[514,802,803],{"class":528}," {\n",[514,805,807,811,814,816,819,822,825],{"class":516,"line":806},18,[514,808,810],{"class":809},"s7zQu","    return",[514,812,813],{"class":520}," new",[514,815,525],{"class":717},[514,817,818],{"class":528},"(",[514,820,821],{"class":520},"new",[514,823,824],{"class":717}," Wiring",[514,826,711],{"class":528},[514,828,830,833,835,837,839],{"class":516,"line":829},19,[514,831,832],{"class":717},"        config",[514,834,503],{"class":528},[514,836,721],{"class":528},[514,838,724],{"class":524},[514,840,727],{"class":528},[514,842,844,847,849,851,853],{"class":516,"line":843},20,[514,845,846],{"class":717},"        subscriptions",[514,848,503],{"class":528},[514,850,721],{"class":528},[514,852,751],{"class":524},[514,854,727],{"class":528},[514,856,858,861,863,865,867],{"class":516,"line":857},21,[514,859,860],{"class":717},"        orders",[514,862,503],{"class":528},[514,864,721],{"class":528},[514,866,764],{"class":524},[514,868,727],{"class":528},[514,870,872,875,877,879,881],{"class":516,"line":871},22,[514,873,874],{"class":717},"        webhookCalls",[514,876,503],{"class":528},[514,878,721],{"class":528},[514,880,777],{"class":524},[514,882,727],{"class":528},[514,884,886,889,891,893,895],{"class":516,"line":885},23,[514,887,888],{"class":717},"        events",[514,890,503],{"class":528},[514,892,721],{"class":528},[514,894,790],{"class":524},[514,896,727],{"class":528},[514,898,900,903,905,907,909],{"class":516,"line":899},24,[514,901,902],{"class":717},"        customerBindings",[514,904,503],{"class":528},[514,906,721],{"class":528},[514,908,738],{"class":524},[514,910,727],{"class":528},[514,912,914],{"class":516,"line":913},25,[514,915,916],{"class":528},"    ));\n",[514,918,920],{"class":516,"line":919},26,[514,921,922],{"class":528},"}\n",[496,924,925,926,933],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[927,928,932],"a",{"href":929,"rel":930},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[931],"nofollow","vatly-laravel"," instead of writing this wiring.",[935,936,938],"h2",{"id":937},"choose-the-billable","Choose the billable",[496,940,941,942,945,946,949,950,952],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[500,943,944],{},"Billable"," interface or required base model. Give Fluent a ",[500,947,948],{},"CustomerProfile"," with a Vatly customer ID, or use ",[927,951,72],{"href":206}," to create and bind one to your host ID.",[496,954,955],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[935,957,959],{"id":958},"save-local-billing-state","Save local billing state",[961,962,963,976],"table",{},[964,965,966],"thead",{},[967,968,969,973],"tr",{},[970,971,972],"th",{},"Contract",[970,974,975],{},"Your implementation does",[977,978,979,989,998,1007,1038],"tbody",{},[967,980,981,986],{},[982,983,984],"td",{},[500,985,565],{},[982,987,988],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[967,990,991,995],{},[982,992,993],{},[500,994,631],{},[982,996,997],{},"Finds by Vatly ID, stores a subscription, updates it.",[967,999,1000,1004],{},[982,1001,1002],{},[500,1003,609],{},[982,1005,1006],{},"Finds by Vatly ID, stores an order, updates it.",[967,1008,1009,1013],{},[982,1010,1011],{},[500,1012,653],{},[982,1014,1015,1016,1019,1020,1023,1024,1023,1027,1023,1030,1033,1034,1037],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing. The recorded ",[500,1017,1018],{},"object"," has the customer's personal data (",[500,1021,1022],{},"customerDetails",", ",[500,1025,1026],{},"billingAddress",[500,1028,1029],{},"shippingAddress",[500,1031,1032],{},"mandate",") redacted to ",[500,1035,1036],{},"[redacted]","; keys and nesting are kept.",[967,1039,1040,1044],{},[982,1041,1042],{},[500,1043,587],{},[982,1045,1046,1047,1050],{},"Dispatches typed events to your listeners. ",[500,1048,1049],{},"NullEventDispatcher"," is available if you need no listeners.",[496,1052,1053,1054,1057,1058,1061,1062,1065],{},"Repositories return your objects implementing ",[500,1055,1056],{},"SubscriptionInterface"," or ",[500,1059,1060],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[927,1063,1064],{"href":230},"Host tables",". Reader and writer contracts are also available separately when a component needs only one role.",[496,1067,1068,1069,1072,1073,1076,1077,1080],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[500,1070,1071],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[500,1074,1075],{},"store()"," methods may return ",[500,1078,1079],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[935,1082,1084],{"id":1083},"apply-partial-updates-correctly","Apply partial updates correctly",[496,1086,1087,1090,1091,1094,1095,1098,1099,1102],{},[500,1088,1089],{},"Store*Data"," and ",[500,1092,1093],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[500,1096,1097],{},"Money"," objects instead; use ",[500,1100,1101],{},"toCents()"," at your own persistence boundary.",[496,1104,1105,1106,1108,1109,1090,1112,1115],{},"In updates, ",[500,1107,1079],{}," normally means leave the stored value alone. Subscription updates have explicit ",[500,1110,1111],{},"clearEndsAt",[500,1113,1114],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[496,1117,1118,1119,1122,1123,1126],{},"Persist ",[500,1120,1121],{},"testmode"," from store data and expose it through the entity's ",[500,1124,1125],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[496,1128,1129,1132,1133,1136],{},[500,1130,1131],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[500,1134,1135],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[935,1138,1140],{"id":1139},"add-optional-records","Add optional records",[496,1142,1143,1145,1146,1023,1149,1152,1153,1156,1157,1160],{},[500,1144,502],{}," also accepts ",[500,1147,1148],{},"refunds",[500,1150,1151],{},"chargebacks",", and ",[500,1154,1155],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[500,1158,1159],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[496,1162,1163,1164,1166,1167,1170,1171,1175],{},"Use ",[927,1165,54],{"href":222}," for transactions and ",[927,1168,1169],{"href":226},"Event flow"," for the event-to-storage mapping. Field details live in the ",[927,1172,305],{"href":1173,"rel":1174},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[931],".",[1177,1178,1179],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decora