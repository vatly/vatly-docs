ions\u002Findex",{"title":479,"path":480,"stem":481},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":483,"path":484,"stem":485},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":487,"title":198,"body":488,"description":1182,"extension":1183,"links":1184,"meta":1185,"navigation":1186,"path":199,"seo":1187,"stem":200,"__hash__":1188},"docs\u002F3.packages\u002F2.fluent-php\u002F02.coreconcepts.md",{"type":489,"value":490,"toc":1176},"minimark",[491,500,919,930,935,949,952,956,1047,1062,1077,1081,1099,1112,1123,1133,1137,1157,1172],[492,493,494,495,499],"p",{},"Connect Fluent to your database without replacing your models. Build a driver by implementing the storage contracts, then pass those implementations to ",[496,497,498],"code",{},"Wiring",":",[501,502,507],"pre",{"className":503,"code":504,"language":505,"meta":506,"style":506},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\Contracts\\ConfigurationInterface;\nuse Vatly\\Fluent\\Contracts\\CustomerBindingRepository;\nuse Vatly\\Fluent\\Contracts\\EventDispatcherInterface;\nuse Vatly\\Fluent\\Contracts\\OrderRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\SubscriptionRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\WebhookCallRepositoryInterface;\nuse Vatly\\Fluent\\Vatly;\nuse Vatly\\Fluent\\Wiring;\n\nfunction billing(\n    ConfigurationInterface $config,\n    CustomerBindingRepository $bindings,\n    SubscriptionRepositoryInterface $subscriptions,\n    OrderRepositoryInterface $orders,\n    WebhookCallRepositoryInterface $webhookCalls,\n    EventDispatcherInterface $events,\n): Vatly {\n    return new Vatly(new Wiring(\n        config: $config,\n        subscriptions: $subscriptions,\n        orders: $orders,\n        webhookCalls: $webhookCalls,\n        events: $events,\n        customerBindings: $bindings,\n    ));\n}\n","php","",[496,