04,"line":770},16,[502,772,773],{"class":705},"    EventDispatcherInterface",[502,775,709],{"class":516},[502,777,778],{"class":512},"events",[502,780,715],{"class":516},[502,782,784,787,789],{"class":504,"line":783},17,[502,785,786],{"class":516},"):",[502,788,513],{"class":705},[502,790,791],{"class":516}," {\n",[502,793,795,799,802,804,807,810,813],{"class":504,"line":794},18,[502,796,798],{"class":797},"s7zQu","    return",[502,800,801],{"class":508}," new",[502,803,513],{"class":705},[502,805,806],{"class":516},"(",[502,808,809],{"class":508},"new",[502,811,812],{"class":705}," Wiring",[502,814,699],{"class":516},[502,816,818,821,823,825,827],{"class":504,"line":817},19,[502,819,820],{"class":705},"        config",[502,822,491],{"class":516},[502,824,709],{"class":516},[502,826,712],{"class":512},[502,828,715],{"class":516},[502,830,832,835,837,839,841],{"class":504,"line":831},20,[502,833,834],{"class":705},"        subscriptions",[502,836,491],{"class":516},[502,838,709],{"class":516},[502,840,739],{"class":512},[502,842,715],{"class":516},[502,844,846,849,851,853,855],{"class":504,"line":845},21,[502,847,848],{"class":705},"        orders",[502,850,491],{"class":516},[502,852,709],{"class":516},[502,854,752],{"class":512},[502,856,715],{"class":516},[502,858,860,863,865,867,869],{"class":504,"line":859},22,[502,861,862],{"class":705},"        webhookCalls",[502,864,491],{"class":516},[502,866,709],{"class":516},[502,868,765],{"class":512},[502,870,715],{"class":516},[502,872,874,877,879,881,883],{"class":504,"line":873},23,[502,875,876],{"class":705},"        events",[502,878,491],{"class":516},[502,880,709],{"class":516},[502,882,778],{"class":512},[502,884,715],{"class":516},[502,886,888,891,893,895,897],{"class":504,"line":887},24,[502,889,890],{"class":705},"        customerBindings",[502,892,491],{"class":516},[502,894,709],{"class":516},[502,896,726],{"class":512},[502,898,715],{"class":516},[502,900,902],{"class":504,"line":901},25,[502,903,904],{"class":516},"    ));\n",[502,906,908],{"class":504,"line":907},26,[502,909,910],{"class":516},"}\n",[484,912,913,914,921],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[915,916,920],"a",{"href":917,"rel":918},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[919],"nofollow","vatly-laravel"," instead of writing this wiring.",[923,924,926],"h2",{"id":925},"choose-the-billable","Choose the billable",[484,928,929,930,933,934,937,938,940],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[488,931,932],{},"Billable"," interface or required base model. Give Fluent a ",[488,935,936],{},"CustomerProfile"," with a Vatly customer ID, or use ",[915,939,68],{"href":194}," to create and bind one to your host ID.",[484,942,943],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[923,945,947],{"id":946},"save-local-billing-state","Save local billing state",[949,950,951,964],"table",{},[952,953,954],"thead",{},[955,956,957,961],"tr",{},[958,959,960],"th",{},"Contract",[958,962,963],{},"Your implementation does",[965,966,967,977,986,995,1004],"tbody",{},[955,968,969,974],{},[970,971,972],"td",{},[488,973,553],{},[970,975,976],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[955,978,979,983],{},[970,980,981],{},[488,982,619],{},[970,984,985],{},"Finds by Vatly ID, stores a subscription, updates it.",[955,987,988,992],{},[970,989,990],{},[488,991,597],{},[970,993,994],{},"Finds by Vatly ID, stores an order, updates it.",[955,996,997,1001],{},[970,998,999],{},[488,1000,641],{},[970,1002,1003],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing.",[955,1005,1006,1010],{},[970,1007,1008],{},[488,1009,575],{},[970,1011,1012,1013,1016],{},"Dispatches typed events to your listeners. ",[488,1014,1015],{},"NullEventDispatcher"," is available if you need no listeners.",[484,1018,1019,1020,1023,1024,1027,1028,1031],{},"Repositories return your objects implementing ",[488,1021,1022],{},"SubscriptionInterface"," or ",[488,1025,1026],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[915,1029,1030],{"href":218},"Host tables",". Reader and writer contracts are also available separately when a component needs only one role.",[484,1033,1034,1035,1038,1039,1042,1043,1046],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[488,1036,1037],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[488,1040,1041],{},"store()"," methods may return ",[488,1044,1045],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[923,1048,1050],{"id":1049},"apply-partial-updates-correctly","Apply partial updates correctly",[484,1052,1053,1056,1057,1060,1061,1064,1065,1068],{},[488,1054,1055],{},"Store*Data"," and ",[488,1058,1059],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[488,1062,1063],{},"Money"," objects instead; use ",[488,1066,1067],{},"toCents()"," at your own persistence boundary.",[484,1070,1071,1072,1074,1075,1056,1078,1081],{},"In updates, ",[488,1073,1045],{}," normally means leave the stored value alone. Subscription updates have explicit ",[488,1076,1077],{},"clearEndsAt",[488,1079,1080],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[484,1083,1084,1085,1088,1089,1092],{},"Persist ",[488,1086,1087],{},"testmode"," from store data and expose it through the entity's ",[488,1090,1091],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[484,1094,1095,1098,1099,1102],{},[488,1096,1097],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[488,1100,1101],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[923,1104,1106],{"id":1105},"add-optional-records","Add optional records",[484,1108,1109,1111,1112,1115,1116,1119,1120,1123,1124,1127],{},[488,1110,490],{}," also accepts ",[488,1113,1114],{},"refunds",", ",[488,1117,1118],{},"chargebacks",", and ",[488,1121,1122],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[488,1125,1126],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[484,1129,1130,1131,1133,1134,1137,1138,1142],{},"Use ",[915,1132,50],{"href":210}," for transactions and ",[915,1135,1136],{"href":214},"Event flow"," for the event-to-storage mapping. Field details live in the ",[915,1139,293],{"href":1140,"rel":1141},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[919],".",[1144,1145,1146],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark