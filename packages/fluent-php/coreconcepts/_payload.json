ations\u002F2.bolt",{"id":479,"title":190,"body":480,"description":1153,"extension":1154,"links":1155,"meta":1156,"navigation":1157,"path":191,"seo":1158,"stem":192,"__hash__":1159},"docs\u002F3.packages\u002F2.fluent-php\u002F02.coreconcepts.md",{"type":481,"value":482,"toc":1147},"minimark",[483,492,911,922,927,941,944,948,1017,1032,1047,1051,1069,1082,1093,1103,1107,1128,1143],[484,485,486,487,491],"p",{},"Connect Fluent to your database without replacing your models. Build a driver by implementing the storage contracts, then pass those implementations to ",[488,489,490],"code",{},"Wiring",":",[493,494,499],"pre",{"className":495,"code":496,"language":497,"meta":498,"style":498},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\Contracts\\ConfigurationInterface;\nuse Vatly\\Fluent\\Contracts\\CustomerBindingRepository;\nuse Vatly\\Fluent\\Contracts\\EventDispatcherInterface;\nuse Vatly\\Fluent\\Contracts\\OrderRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\SubscriptionRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\WebhookCallRepositoryInterface;\nuse Vatly\\Fluent\\Vatly;\nuse Vatly\\Fluent\\Wiring;\n\nfunction billing(\n    ConfigurationInterface $config,\n    CustomerBindingRepository $bindings,\n    SubscriptionRepositoryInterface $subscriptions,\n    OrderRepositoryInterface $orders,\n    WebhookCallRepositoryInterface $webhookCalls,\n    EventDispatcherInterface $events,\n): Vatly {\n    return new Vatly(new Wiring(\n        config: $config,\n        subscriptions: $subscriptions,\n        orders: $orders,\n        webhookCalls: $webhookCalls,\n        events: $events,\n        customerBindings: $bindings,\n    ));\n}\n","php","",[488,500,501,534,556,578,600,622,644,662,679,686,700,716,729,742,755,768,781,792,815,829,843,857,871,885,899,905],{"__ignoreMap":498},[502,503,506,510,514,518,521,523,526,528,531],"span",{"class":504,"line":505},"line",1,[502,507,509],{"class":508},"sbssI",