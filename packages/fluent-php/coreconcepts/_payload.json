96}," new",[490,791,501],{"class":693},[490,793,794],{"class":504},"(",[490,796,797],{"class":496},"new",[490,799,800],{"class":693}," Wiring",[490,802,687],{"class":504},[490,804,806,809,811,813,815],{"class":492,"line":805},19,[490,807,808],{"class":693},"        config",[490,810,479],{"class":504},[490,812,697],{"class":504},[490,814,700],{"class":500},[490,816,703],{"class":504},[490,818,820,823,825,827,829],{"class":492,"line":819},20,[490,821,822],{"class":693},"        subscriptions",[490,824,479],{"class":504},[490,826,697],{"class":504},[490,828,727],{"class":500},[490,830,703],{"class":504},[490,832,834,837,839,841,843],{"class":492,"line":833},21,[490,835,836],{"class":693},"        orders",[490,838,479],{"class":504},[490,840,697],{"class":504},[490,842,740],{"class":500},[490,844,703],{"class":504},[490,846,848,851,853,855,857],{"class":492,"line":847},22,[490,849,850],{"class":693},"        webhookCalls",[490,852,479],{"class":504},[490,854,697],{"class":504},[490,856,753],{"class":500},[490,858,703],{"class":504},[490,860,862,865,867,869,871],{"class":492,"line":861},23,[490,863,864],{"class":693},"        events",[490,866,479],{"class":504},[490,868,697],{"class":504},[490,870,766],{"class":500},[490,872,703],{"class":504},[490,874,876,879,881,883,885],{"class":492,"line":875},24,[490,877,878],{"class":693},"        customerBindings",[490,880,479],{"class":504},[490,882,697],{"class":504},[490,884,714],{"class":500},[490,886,703],{"class":504},[490,888,890],{"class":492,"line":889},25,[490,891,892],{"class":504},"    ));\n",[490,894,896],{"class":492,"line":895},26,[490,897,898],{"class":504},"}\n",[472,900,901,902,909],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[903,904,908],"a",{"href":905,"rel":906},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[907],"nofollow","vatly-laravel"," instead of writing this wiring.",[911,912,914],"h2",{"id":913},"choose-the-billable","Choose the billable",[472,916,917,918,921,922,925,926,928],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[476,919,920],{},"Billable"," interface or required base model. Give Fluent a ",[476,923,924],{},"CustomerProfile"," with a Vatly customer ID, or use ",[903,927,68],{"href":182}," to create and bind one to your host ID.",[472,930,931],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[911,933,935],{"id":934},"save-local-billing-state","Save local billing state",[937,938,939,952],"table",{},[940,941,942],"thead",{},[943,944,945,949],"tr",{},[946,947,948],"th",{},"Contract",[946,950,951],{},"Your implementation does",[953,954,955,965,974,983,992],"tbody",{},[943,956,957,962],{},[958,959,960],"td",{},[476,961,541],{},[958,963,964],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[943,966,967,971],{},[958,968,969],{},[476,970,607],{},[958,972,973],{},"Finds by Vatly ID, stores a subscription, updates it.",[943,975,976,980],{},[958,977,978],{},[476,979,585],{},[958,981,982],{},"Finds by Vatly ID, stores an order, updates it.",[943,984,985,989],{},[958,986,987],{},[476,988,629],{},[958,990,991],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing.",[943,993,994,998],{},[958,995,996],{},[476,997,563],{},[958,999,1000,1001,1004],{},"Dispatches typed events to your listeners. ",[476,1002,1003],{},"NullEventDispatcher"," is available if you need no listeners.",[472,1006,1007,1008,1011,1012,1015,1016,1019],{},"Repositories return your objects implementing ",[476,1009,1010],{},"SubscriptionInterface"," or ",[476,1013,1014],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[903,1017,1018],{"href":206},"Host tables",". Reader and writer contracts are also available separately when a component needs only one role.",[472,1021,1022,1023,1026,1027,1030,1031,1034],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[476,1024,1025],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[476,1028,1029],{},"store()"," methods may return ",[476,1032,1033],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[911,1036,1038],{"id":1037},"apply-partial-updates-correctly","Apply partial updates correctly",[472,1040,1041,1044,1045,1048,1049,1052,1053,1056],{},[476,1042,1043],{},"Store*Data"," and ",[476,1046,1047],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[476,1050,1051],{},"Money"," objects instead; use ",[476,1054,1055],{},"toCents()"," at your own persistence boundary.",[472,1058,1059,1060,1062,1063,1044,1066,1069],{},"In updates, ",[476,1061,1033],{}," normally means leave the stored value alone. Subscription updates have explicit ",[476,1064,1065],{},"clearEndsAt",[476,1067,1068],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[472,1071,1072,1073,1076,1077,1080],{},"Persist ",[476,1074,1075],{},"testmode"," from store data and expose it through the entity's ",[476,1078,1079],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[472,1082,1083,1086,1087,1090],{},[476,1084,1085],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[476,1088,1089],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[911,1092,1094],{"id":1093},"add-optional-records","Add optional records",[472,1096,1097,1099,1100,1103,1104,1107,1108,1111,1112,1115],{},[476,1098,478],{}," also accepts ",[476,1101,1102],{},"refunds",", ",[476,1105,1106],{},"chargebacks",", and ",[476,1109,1110],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[476,1113,1114],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[472,1117,1118,1119,1121,1122,1125,1126,1130],{},"Use ",[903,1120,50],{"href":198}," for transactions and ",[903,1123,1124],{"href":202},"Event flow"," for the event-to-storage mapping. Field details live in the ",[903,1127,281],{"href":1128,"rel":1129},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[907],".",[1132,1133,1134],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style