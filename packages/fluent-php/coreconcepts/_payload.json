25},[511,778,780,783,785,788],{"class":513,"line":779},16,[511,781,782],{"class":714},"    EventDispatcherInterface",[511,784,718],{"class":525},[511,786,787],{"class":521},"events",[511,789,724],{"class":525},[511,791,793,796,798],{"class":513,"line":792},17,[511,794,795],{"class":525},"):",[511,797,522],{"class":714},[511,799,800],{"class":525}," {\n",[511,802,804,808,811,813,816,819,822],{"class":513,"line":803},18,[511,805,807],{"class":806},"s7zQu","    return",[511,809,810],{"class":517}," new",[511,812,522],{"class":714},[511,814,815],{"class":525},"(",[511,817,818],{"class":517},"new",[511,820,821],{"class":714}," Wiring",[511,823,708],{"class":525},[511,825,827,830,832,834,836],{"class":513,"line":826},19,[511,828,829],{"class":714},"        config",[511,831,500],{"class":525},[511,833,718],{"class":525},[511,835,721],{"class":521},[511,837,724],{"class":525},[511,839,841,844,846,848,850],{"class":513,"line":840},20,[511,842,843],{"class":714},"        subscriptions",[511,845,500],{"class":525},[511,847,718],{"class":525},[511,849,748],{"class":521},[511,851,724],{"class":525},[511,853,855,858,860,862,864],{"class":513,"line":854},21,[511,856,857],{"class":714},"        orders",[511,859,500],{"class":525},[511,861,718],{"class":525},[511,863,761],{"class":521},[511,865,724],{"class":525},[511,867,869,872,874,876,878],{"class":513,"line":868},22,[511,870,871],{"class":714},"        webhookCalls",[511,873,500],{"class":525},[511,875,718],{"class":525},[511,877,774],{"class":521},[511,879,724],{"class":525},[511,881,883,886,888,890,892],{"class":513,"line":882},23,[511,884,885],{"class":714},"        events",[511,887,500],{"class":525},[511,889,718],{"class":525},[511,891,787],{"class":521},[511,893,724],{"class":525},[511,895,897,900,902,904,906],{"class":513,"line":896},24,[511,898,899],{"class":714},"        customerBindings",[511,901,500],{"class":525},[511,903,718],{"class":525},[511,905,735],{"class":521},[511,907,724],{"class":525},[511,909,911],{"class":513,"line":910},25,[511,912,913],{"class":525},"    ));\n",[511,915,917],{"class":513,"line":916},26,[511,918,919],{"class":525},"}\n",[493,921,922,923,930],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[924,925,929],"a",{"href":926,"rel":927},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[928],"nofollow","vatly-laravel"," instead of writing this wiring.",[932,933,935],"h2",{"id":934},"choose-the-billable","Choose the billable",[493,937,938,939,942,943,946,947,949],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[497,940,941],{},"Billable"," interface or required base model. Give Fluent a ",[497,944,945],{},"CustomerProfile"," with a Vatly customer ID, or use ",[924,948,68],{"href":172}," to create and bind one to your host ID.",[493,951,952],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[932,954,956],{"id":955},"save-local-billing-state","Save local billing state",[958,959,960,973],"table",{},[961,962,963],"thead",{},[964,965,966,970],"tr",{},[967,968,969],"th",{},"Contract",[967,971,972],{},"Your implementation does",[974,975,976,986,995,1004,1013],"tbody",{},[964,977,978,983],{},[979,980,981],"td",{},[497,982,562],{},[979,984,985],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[964,987,988,992],{},[979,989,990],{},[497,991,628],{},[979,993,994],{},"Finds by Vatly ID, stores a subscription, updates it.",[964,996,997,1001],{},[979,998,999],{},[497,1000,606],{},[979,1002,1003],{},"Finds by Vatly ID, stores an order, updates it.",[964,1005,1006,1010],{},[979,1007,1008],{},[497,1009,650],{},[979,1011,1012],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing.",[964,1014,1015,1019],{},[979,1016,1017],{},[497,1018,584],{},[979,1020,1021,1022,1025],{},"Dispatches typed events to your listeners. ",[497,1023,1024],{},"NullEventDispatcher"," is available if you need no listeners.",[493,1027,1028,1029,1032,1033,1036,1037,1039],{},"Repositories return your objects implementing ",[497,1030,1031],{},"SubscriptionInterface"," or ",[497,1034,1035],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[924,1038,199],{"href":200},". Reader and writer contracts are also available separately when a component needs only one role.",[493,1041,1042,1043,1046,1047,1050,1051,1054],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[497,1044,1045],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[497,1048,1049],{},"store()"," methods may return ",[497,1052,1053],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[932,1056,1058],{"id":1057},"apply-partial-updates-correctly","Apply partial updates correctly",[493,1060,1061,1064,1065,1068,1069,1072,1073,1076],{},[497,1062,1063],{},"Store*Data"," and ",[497,1066,1067],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[497,1070,1071],{},"Money"," objects instead; use ",[497,1074,1075],{},"toCents()"," at your own persistence boundary.",[493,1078,1079,1080,1082,1083,1064,1086,1089],{},"In updates, ",[497,1081,1053],{}," normally means leave the stored value alone. Subscription updates have explicit ",[497,1084,1085],{},"clearEndsAt",[497,1087,1088],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[493,1091,1092,1093,1096,1097,1100],{},"Persist ",[497,1094,1095],{},"testmode"," from store data and expose it through the entity's ",[497,1098,1099],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[493,1102,1103,1106,1107,1110],{},[497,1104,1105],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[497,1108,1109],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[932,1112,1114],{"id":1113},"add-optional-records","Add optional records",[493,1116,1117,1119,1120,1123,1124,1127,1128,1131,1132,1135],{},[497,1118,499],{}," also accepts ",[497,1121,1122],{},"refunds",", ",[497,1125,1126],{},"chargebacks",", and ",[497,1129,1130],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[497,1133,1134],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[493,1137,1138,1139,1141,1142,1144,1145,1149],{},"Use ",[924,1140,50],{"href":184}," for transactions and ",[924,1143,206],{"href":207}," for the event-to-storage mapping. Field details live in the ",[924,1146,334],{"href":1147,"rel":1148},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[928],".",[1151,1152,1153],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default: