0,500],{"class":692},[489,792,793],{"class":503},"(",[489,795,796],{"class":495},"new",[489,798,799],{"class":692}," Wiring",[489,801,686],{"class":503},[489,803,805,808,810,812,814],{"class":491,"line":804},19,[489,806,807],{"class":692},"        config",[489,809,478],{"class":503},[489,811,696],{"class":503},[489,813,699],{"class":499},[489,815,702],{"class":503},[489,817,819,822,824,826,828],{"class":491,"line":818},20,[489,820,821],{"class":692},"        subscriptions",[489,823,478],{"class":503},[489,825,696],{"class":503},[489,827,726],{"class":499},[489,829,702],{"class":503},[489,831,833,836,838,840,842],{"class":491,"line":832},21,[489,834,835],{"class":692},"        orders",[489,837,478],{"class":503},[489,839,696],{"class":503},[489,841,739],{"class":499},[489,843,702],{"class":503},[489,845,847,850,852,854,856],{"class":491,"line":846},22,[489,848,849],{"class":692},"        webhookCalls",[489,851,478],{"class":503},[489,853,696],{"class":503},[489,855,752],{"class":499},[489,857,702],{"class":503},[489,859,861,864,866,868,870],{"class":491,"line":860},23,[489,862,863],{"class":692},"        events",[489,865,478],{"class":503},[489,867,696],{"class":503},[489,869,765],{"class":499},[489,871,702],{"class":503},[489,873,875,878,880,882,884],{"class":491,"line":874},24,[489,876,877],{"class":692},"        customerBindings",[489,879,478],{"class":503},[489,881,696],{"class":503},[489,883,713],{"class":499},[489,885,702],{"class":503},[489,887,889],{"class":491,"line":888},25,[489,890,891],{"class":503},"    ));\n",[489,893,895],{"class":491,"line":894},26,[489,896,897],{"class":503},"}\n",[471,899,900,901,908],{},"Register that instance in your application's container. Fluent does not ship a database driver or migrations. Laravel users should use ",[902,903,907],"a",{"href":904,"rel":905},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[906],"nofollow","vatly-laravel"," instead of writing this wiring.",[910,911,913],"h2",{"id":912},"choose-the-billable","Choose the billable",[471,915,916,917,920,921,924,925,927],{},"Your billable is the user, team, company, or tenant that pays. There is no ",[475,918,919],{},"Billable"," interface or required base model. Give Fluent a ",[475,922,923],{},"CustomerProfile"," with a Vatly customer ID, or use ",[902,926,68],{"href":181}," to create and bind one to your host ID.",[471,929,930],{},"A profile is input, not a stored customer. Supplying only its email to a checkout builder does not create or bind a customer. Create the customer explicitly, or use an empty profile for an anonymous checkout.",[910,932,934],{"id":933},"save-local-billing-state","Save local billing state",[936,937,938,951],"table",{},[939,940,941],"thead",{},[942,943,944,948],"tr",{},[945,946,947],"th",{},"Contract",[945,949,950],{},"Your implementation does",[952,953,954,964,973,982,991],"tbody",{},[942,955,956,961],{},[957,958,959],"td",{},[475,960,540],{},[957,962,963],{},"Maps host IDs to Vatly customer IDs in both directions; records unattributed customers.",[942,965,966,970],{},[957,967,968],{},[475,969,606],{},[957,971,972],{},"Finds by Vatly ID, stores a subscription, updates it.",[942,974,975,979],{},[957,976,977],{},[475,978,584],{},[957,980,981],{},"Finds by Vatly ID, stores an order, updates it.",[942,983,984,988],{},[957,985,986],{},[475,987,628],{},[957,989,990],{},"Records received deliveries and cleans up old audit rows. It does not skip duplicate processing.",[942,992,993,997],{},[957,994,995],{},[475,996,562],{},[957,998,999,1000,1003],{},"Dispatches typed events to your listeners. ",[475,1001,1002],{},"NullEventDispatcher"," is available if you need no listeners.",[471,1005,1006,1007,1010,1011,1014,1015,1018],{},"Repositories return your objects implementing ",[475,1008,1009],{},"SubscriptionInterface"," or ",[475,1012,1013],{},"OrderInterface",". Wrap existing host records rather than copying them; see ",[902,1016,1017],{"href":205},"Host tables",". Reader and writer contracts are also available separately when a component needs only one role.",[471,1020,1021,1022,1025,1026,1029,1030,1033],{},"Enforce unique Vatly IDs in storage and binding uniqueness in both directions. Accept ",[475,1023,1024],{},"hostCustomerId: null"," on store data: anonymous payments may arrive before a customer is linked. Entity ",[475,1027,1028],{},"store()"," methods may return ",[475,1031,1032],{},"null"," when a record genuinely does not belong to your integration. Throw on a storage failure so the delivery can retry.",[910,1035,1037],{"id":1036},"apply-partial-updates-correctly","Apply partial updates correctly",[471,1039,1040,1043,1044,1047,1048,1051,1052,1055],{},[475,1041,1042],{},"Store*Data"," and ",[475,1045,1046],{},"Update*Data"," carry local persistence data. Amounts are integer cents with a separate currency. SDK resources and money-bearing webhook events use ",[475,1049,1050],{},"Money"," objects instead; use ",[475,1053,1054],{},"toCents()"," at your own persistence boundary.",[471,1057,1058,1059,1061,1062,1043,1065,1068],{},"In updates, ",[475,1060,1032],{}," normally means leave the stored value alone. Subscription updates have explicit ",[475,1063,1064],{},"clearEndsAt",[475,1066,1067],{},"clearMandate"," flags. A non-null mandate replaces both its method and masked identifier; do not keep an old card's last four digits when a new mandate has no identifier.",[471,1070,1071,1072,1075,1076,1079],{},"Persist ",[475,1073,1074],{},"testmode"," from store data and expose it through the entity's ",[475,1077,1078],{},"isTestmode()",". Select the matching key in your application; storing the flag does not switch keys automatically.",[471,1081,1082,1085,1086,1089],{},[475,1083,1084],{},"DerivesSubscriptionState"," implements the subscription state predicates from ",[475,1087,1088],{},"getEndsAt()",": no end date means active, a future end date means a valid grace period, a past date means ended. These predicates are not a full entitlement policy for trials, failed payments, or disputes. Your app decides access.",[910,1091,1093],{"id":1092},"add-optional-records","Add optional records",[471,1095,1096,1098,1099,1102,1103,1106,1107,1110,1111,1114],{},[475,1097,477],{}," also accepts ",[475,1100,1101],{},"refunds",", ",[475,1104,1105],{},"chargebacks",", and ",[475,1108,1109],{},"orderLines",". Refund and chargeback repositories enable their persistence reactions. Order lines need your order writer to persist the ",[475,1112,1113],{},"StoreOrderData::$lines"," supplied on a new paid order; wiring a line reader alone does not save lines.",[471,1116,1117,1118,1120,1121,1124,1125,1129],{},"Use ",[902,1119,50],{"href":197}," for transactions and ",[902,1122,1123],{"href":201},"Event flow"," for the event-to-storage mapping. Field details live in the ",[902,1126,280],{"href":1127,"rel":1128},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[906],".",[1131,1132,1133],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(