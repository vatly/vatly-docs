,"\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":488,"title":191,"body":489,"description":1160,"extension":1161,"links":1162,"meta":1163,"navigation":693,"path":192,"seo":1164,"stem":193,"__hash__":1165},"docs\u002F3.packages\u002F2.fluent-php\u002F99.coreconcepts.md",{"type":490,"value":491,"toc":1154},"minimark",[492,501,920,931,936,950,953,957,1026,1040,1055,1059,1077,1090,1101,1111,1115,1136,1150],[493,494,495,496,500],"p",{},"Connect Fluent to your database without replacing your models. Build a driver by implementing the storage contracts, then pass those implementations to ",[497,498,499],"code",{},"Wiring",":",[502,503,508],"pre",{"className":504,"code":505,"language":506,"meta":507,"style":507},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\Contracts\\ConfigurationInterface;\nuse Vatly\\Fluent\\Contracts\\CustomerBindingRepository;\nuse Vatly\\Fluent\\Contracts\\EventDispatcherInterface;\nuse Vatly\\Fluent\\Contracts\\OrderRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\SubscriptionRepositoryInterface;\nuse Vatly\\Fluent\\Contracts\\WebhookCallRepositoryInterface;\nuse Vatly\\Fluent\\Vatly;\nuse Vatly\\Fluent\\Wiring;\n\nfunction billing(\n    ConfigurationInterface $config,\n    CustomerBindingRepository $bindings,\n    SubscriptionRepositoryInterface $subscriptions,\n    OrderRepositoryInterface $orders,\n    WebhookCallRepositoryInterface $webhookCalls,\n    EventDispatcherInterface $events,\n): Vatly {\n    return new Vatly(new Wiring(\n        config: $config,\n        subscriptions: $subscriptions,\n        orders: $orders,\n        webhookCalls: $webhookCalls,\n        events: $events,\n        customerBindings: $bindings,\n    ));\n}\n","php","",[497,509,510,543,565,587,609,631,653,671,688,695,709,725,738,751,764,777,790,801,824,838,852,866,880,894,908,914],{"__ignoreMap":507},[511,512,515,519,523,527,530,532,535,537,540],"span",{"class":513,"line":514},"line