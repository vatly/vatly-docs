,709,710],{"class":533},"),\n",[519,712,714,717,719,722,724,727,729,732,734,737,739],{"class":521,"line":713},8,[519,715,716],{"class":650},"        additionalPayload",[519,718,654],{"class":533},[519,720,721],{"class":533}," [",[519,723,589],{"class":533},[519,725,726],{"class":592},"locale",[519,728,589],{"class":533},[519,730,731],{"class":533}," =>",[519,733,657],{"class":533},[519,735,736],{"class":592},"nl_NL",[519,738,589],{"class":533},[519,740,741],{"class":533},"],\n",[519,743,745],{"class":521,"line":744},9,[519,746,747],{"class":533},"    );\n",[519,749,751],{"class":521,"line":750},10,[519,752,753],{"class":533},"}\n",[519,755,757,759,762,764,766,768,770,773,775,777,780,782,785],{"class":521,"line":756},11,[519,758,558],{"class":533},[519,760,761],{"class":529},"profile ",[519,763,564],{"class":533},[519,765,675],{"class":525},[519,767,678],{"class":650},[519,769,586],{"class":533},[519,771,772],{"class":650},"vatlyId",[519,774,654],{"class":533},[519,776,567],{"class":533},[519,778,779],{"class":529},"customer",[519,781,573],{"class":533},[519,783,784],{"class":529},"id",[519,786,597],{"class":533},[493,788,789,790,793,794,798,799,802],{},"Use ",[497,791,792],{},"$profile"," in a ",[795,796,797],"a",{"href":175},"checkout",". ",[497,800,801],{},"createFor()"," always creates a new remote customer and then calls your binding repository. It throws if that host ID is already bound. Serialize concurrent creation for the same host account; a lookup followed by create is not an atomic lock. Remote creation and your database write are not one transaction. Reconcile the remote ID if binding fails rather than blindly creating again.",[804,805,807],"h2",{"id":806},"link-an-existing-customer","Link an existing customer",[493,809,810,811,814,815,818],{},"After checking ownership, call ",[497,812,813],{},"attribute($vatlyCustomerId, $hostCustomerId)",". Repeating the same pair is safe. Linking a host already bound to another customer raises ",[497,816,817],{},"CustomerAlreadyBoundException",". Your repository must also prevent one remote customer from being assigned to two host accounts.",[493,820,821,822,825,826,829,830,833],{},"For anonymous checkout, use ",[497,823,824],{},"new CustomerProfile()",". After payment you can call ",[497,827,828],{},"claimCustomerFromCheckout($checkoutId, $hostCustomerId)",": it returns ",[497,831,832],{},"false"," if no customer can be resolved yet. Only claim checkouts your server recorded for this user or session. A checkout ID supplied by a browser is not proof of ownership. Claiming the binding does not reassign earlier anonymous order rows; your driver must do that if needed.",[804,835,837],{"id":836},"update-account-identity","Update account identity",[493,839,840],{},"This uses the same authorized customer from above:",[510,842,844],{"className":512,"code":843,"language":514,"meta":515,"style":515},"use Vatly\\Fluent\\Data\\UpdateCustomerData;\n\n$handle = $vatly->customer($customer->id);\n$handle->update(new UpdateCustomerData(name: 'Alex Example'));\n$identity = $handle->identity();\n",[497,845,846,868,872,900,937],{"__ignoreMap":515},[519,847,848,850,852,854,856,858,861,863,866],{"class":521,"line":522},[519,849,526],{"class":525},[519,851,530],{"class":529},[519,853,534],{"class":533},[519,855,537],{"class":529},[519,857,534],{"class":533},[519,859,860],{"class":529},"Data",[519,862,534],{"class":533},[519,864,865],{"class":529},"UpdateCustomerData",[519,867,545],{"class":533},[519,869,870],{"class":521,"line":548},[519,871,552],{"emptyLinePlaceholder":551},[519,873,874,876,879,881,883,885,887,889,892,894,896,898],{"class":521,"line":555},[519,875,558],{"class":533},[519,877,878],{"class":529},"handle ",[519,880,564],{"class":533},[519,882,567],{"class":533},[519,884,570],{"class":529},[519,886,573],{"class":533},[519,888,779],{"class":576},[519,890,891],{"class":533},"($",[519,893,779],{"class":529},[519,895,573],{"class":533},[519,897,784],{"class":529},[519,899,597],{"class":533}