s":500,"line":723},9,[498,725,726],{"class":512},"    );\n",[498,728,730],{"class":500,"line":729},10,[498,731,732],{"class":512},"}\n",[498,734,736,738,741,743,745,747,749,752,754,756,759,761,764],{"class":500,"line":735},11,[498,737,537],{"class":512},[498,739,740],{"class":508},"profile ",[498,742,543],{"class":512},[498,744,654],{"class":504},[498,746,657],{"class":629},[498,748,565],{"class":512},[498,750,751],{"class":629},"vatlyId",[498,753,633],{"class":512},[498,755,546],{"class":512},[498,757,758],{"class":508},"customer",[498,760,552],{"class":512},[498,762,763],{"class":508},"id",[498,765,576],{"class":512},[472,767,768,769,772,773,777,778,781],{},"Use ",[476,770,771],{},"$profile"," in a ",[774,775,776],"a",{"href":185},"checkout",". ",[476,779,780],{},"createFor()"," always creates a new remote customer and then calls your binding repository. It throws if that host ID is already bound. Serialize concurrent creation for the same host account; a lookup followed by create is not an atomic lock. Remote creation and your database write are not one transaction. Reconcile the remote ID if binding fails rather than blindly creating again.",[783,784,786],"h2",{"id":785},"link-an-existing-customer","Link an existing customer",[472,788,789,790,793,794,797],{},"After checking ownership, call ",[476,791,792],{},"attribute($vatlyCustomerId, $hostCustomerId)",". Repeating the same pair is safe. Linking a host already bound to another customer raises ",[476,795,796],{},"CustomerAlreadyBoundException",". Your repository must also prevent one remote customer from being assigned to two host accounts.",[472,799,800,801,804,805,808,809,812],{},"For anonymous checkout, use ",[476,802,803],{},"new CustomerProfile()",". After payment you can call ",[476,806,807],{},"claimCustomerFromCheckout($checkoutId, $hostCustomerId)",": it returns ",[476,810,811],{},"false"," if no customer can be resolved yet. Only claim checkouts your server recorded for this user or session. A checkout ID supplied by a browser is not proof of ownership. Claiming the binding does not reassign earlier anonymous order rows; your driver must do that if needed.",[783,814,816],{"id":815},"update-account-identity","Update account identity",[472,818,819],{},"This uses the same authorized customer from above:",[489,821,823],{"className":491,"code":822,"language":493,"meta":494,"style":494},"use Vatly\\Fluent\\Data\\UpdateCustomerData;\n\n$handle = $vatly->customer($customer->id);\n$handle->update(new UpdateCustomerData(name: 'Alex Example'));\n$identity = $handle->identity();\n",[476,824,825,847,851,879,916],{"__ignoreMap":494},[498,826,827,829,831,833,835,837,840,842,845],{"class":500,"line":501},[498,828,505],{"class":504},[498,830,509],{"class":508},[498,832,513],{"class":512},[498,834,516],{"class":508},[498,836,513],{"class":512},[498,838,839],{"class":508},"Data",[498,841,513],{"class":512},[498,843,844],{"class":508},"UpdateCustomerData",[498,846,524],{"class":512},[498,848,849],{"class":500,"line":527},[498,850,531],{"emptyLinePlaceholder":530},[498,852,853,855,858,860,862,864,866,868,871,873,875,877],{"class":500,"line":534},[498,854,537],{"class":512},[498,856,857],{"class":508},"handle ",[498,859,543],{"class":512},[498,861,546],{"class":512},[498,863,549],{"class":508},[498,865,552],{"class":512},[498,867,758],{"class":555},[498,869,870],{"class":512},"($",[498,872,758],{"class":508},[498,874,552],{"class":512},[498,876,763],{"class":508},[498,878,576],{"class":512},[498,880,881,883,886,888,891,893,896,899,901,904,906,908,911,913],{"class":500,"line":579},[498,882,537],{"class":512},[498,884,885],{"class":508},"handle",[498,887,552],{"class":512},[498,889,890],{"class":555},"update",[498,892,565],{"class":512},[498,894,895],{"class":504},"new",[498,897,898],{"class":629}," UpdateCustomerData",[498,900,565],{"class":512},[498,902,903],{"class":629},"name",[498,905,633],{"class":512},[498,907,636],{"class":512},[498,909,910],{"class":571},"Alex Example",[498,91