08,710,713,715,718,720,723,725,728,730],{"class":512,"line":704},8,[510,706,707],{"class":641},"        additionalPayload",[510,709,645],{"class":524},[510,711,712],{"class":524}," [",[510,714,580],{"class":524},[510,716,717],{"class":583},"locale",[510,719,580],{"class":524},[510,721,722],{"class":524}," =>",[510,724,648],{"class":524},[510,726,727],{"class":583},"nl_NL",[510,729,580],{"class":524},[510,731,732],{"class":524},"],\n",[510,734,736],{"class":512,"line":735},9,[510,737,738],{"class":524},"    );\n",[510,740,742],{"class":512,"line":741},10,[510,743,744],{"class":524},"}\n",[510,746,748,750,753,755,757,759,761,764,766,768,771,773,776],{"class":512,"line":747},11,[510,749,549],{"class":524},[510,751,752],{"class":520},"profile ",[510,754,555],{"class":524},[510,756,666],{"class":516},[510,758,669],{"class":641},[510,760,577],{"class":524},[510,762,763],{"class":641},"vatlyId",[510,765,645],{"class":524},[510,767,558],{"class":524},[510,769,770],{"class":520},"customer",[510,772,564],{"class":524},[510,774,775],{"class":520},"id",[510,777,588],{"class":524},[484,779,780,781,784,785,789,790,793],{},"Use ",[488,782,783],{},"$profile"," in a ",[786,787,788],"a",{"href":197},"checkout",". ",[488,791,792],{},"createFor()"," always creates a new remote customer and then calls your binding repository. It throws if that host ID is already bound. Serialize concurrent creation for the same host account; a lookup followed by create is not an atomic lock. Remote creation and your database write are not one transaction. Reconcile the remote ID if binding fails rather than blindly creating again.",[795,796,798],"h2",{"id":797},"link-an-existing-customer","Link an existing customer",[484,800,801,802,805,806,809],{},"After checking ownership, call ",[488,803,804],{},"attribute($vatlyCustomerId, $hostCustomerId)",". Repeating the same pair is safe. Linking a host already bound to another customer raises ",[488,807,808],{},"CustomerAlreadyBoundException",". Your repository must also prevent one remote customer from being assigned to two host accounts.",[484,811,812,813,816,817,820,821,824],{},"For anonymous checkout, use ",[488,814,815],{},"new CustomerProfile()",". After payment you can call ",[488,818,819],{},"claimCustomerFromCheckout($checkoutId, $hostCustomerId)",": it returns ",[488,822,823],{},"false"," if no customer can be resolved yet. Only claim checkouts your server recorded for this user or session. A checkout ID supplied by a browser is not proof of ownership. Claiming the binding does not reassign earlier anonymous order rows; your driver must do that if needed.",[795,826,828],{"id":827},"update-account-identity","Update account identity",[484,830,831],{},"This uses the same authorized customer from above:",[501,833,835],{"className":503,"code":834,"language":505,"meta":506,"style":506},"use Vatly\\Fluent\\Data\\UpdateCustomerData;\n\n$handle = $vatly->customer($customer->id);\n$handle->update(new UpdateCustomerData(name: 'Alex Example'));\n$identity = $handle->identity();\n",[488,836,837,859,863,891,928],{"__ignoreMap":506},[510,838,839,841,843,845,847,849,852,854,857],{"class":512,"line":513},[510,840,517],{"class":516},[510,842,521],{"class":520},[510,844,525],{"class":524},[510,846,528],{"class":520},[510,848,525],{"class":524},[510,850,851],{"class":520},"Data",[510,853,525],{"class":524},[510,855,856],{"class":520},"UpdateCustomerData",[510,858,536],{"class":524},[510,860,861],{"class":512,"line":539},[510,862,543],{"emptyLinePlaceholder":542},[510,864,865,867,870,872,874,876,878,880,883,885,887,889],{"class":512,"line":546},[510,866,549],{"class":524},[510,868,869],{"class":520},"handle ",[510,871,555],{"class":524},[510,873,558],{"class":524},[510,875,561],{"class":520},[510,877,564],{"class":524},[510,879,770],{"class":567},[510,881,882],{"class":524},"($",[510,884,770],{"class":520},[510,886,564],{"class":524},[510,888,775],{"class":520},[510,890,588],{"class":524},[510,892,893,895,898,900,903,905,908,911,913,916,918,920,923,925],{"class":512,"line":591},[510,894,549],{"class":524},[510,896,897],{"class":520},"handle",[510,899,564],{"class":524},[510,901,902],{"class":567},"update",[510,904,577],{"class":524},[510,906,907],{"class":516},"new",[510,909,910],{"class":641}," UpdateCustomerData",[510,912,577],{"class":524},[510,914,915],{"class":641},"name",[510,917,645],{"class":524},[510,919,648],{"class":524},[510,921,922],{"class":583},"Alex Example",[510,924,580],{"class":524},[510,926,927],{"class":524},"));\n",[510,929,930,932,935,937,939,941,943,946],{"class":512,"line":612},[510,931,549],{"class":524},[510,933,934],{"class":520},"identity ",[510,936,555],{"class":524},[510,938,558],{"class":524},[510,940,897],{"class":520},[510,942,564],{"class":524},[510,944,945],{"class":567},"identity",[510,947,948],{"class":524},"();\n",[484,950,951,952,955,956,960],{},"Identity updates cover name and email. To clear a name explicitly, pass ",[488,953,954],{},"['name' => null]"," instead of a DTO. Billing addresses, company details, and VAT numbers go through the hosted ",[786,957,959],{"href":958},"\u002Fpackages\u002Ffluent-php\u002Fsubscriptions#update-billing","billing-update flow",".",[484,962,963,966,967,970,971,974],{},[488,964,965],{},"findByEmail()"," returns a collection, not a unique match. ",[488,968,969],{},"findOneByEmail()"," returns the first match or ",[488,972,973],{},"null",". Email search is a recovery tool, not authorization or an automatic binding rule.",[484,976,977,978,980,981,960],{},"Next: ",[786,979,206],{"href":207},". For field details, see the ",[786,982,293],{"href":983,"rel":984},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[985],"nofollow",[987,988,989],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.sh