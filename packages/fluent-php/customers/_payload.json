 browser is not proof of ownership. Claiming the binding does not reassign earlier anonymous order rows; your driver must do that if needed.",[782,813,815],{"id":814},"update-account-identity","Update account identity",[471,817,818],{},"This uses the same authorized customer from above:",[488,820,822],{"className":490,"code":821,"language":492,"meta":493,"style":493},"use Vatly\\Fluent\\Data\\UpdateCustomerData;\n\n$handle = $vatly->customer($customer->id);\n$handle->update(new UpdateCustomerData(name: 'Alex Example'));\n$identity = $handle->identity();\n",[475,823,824,846,850,878,915],{"__ignoreMap":493},[497,825,826,828,830,832,834,836,839,841,844],{"class":499,"line":500},[497,827,504],{"class":503},[497,829,508],{"class":507},[497,831,512],{"class":511},[497,833,515],{"class":507},[497,835,512],{"class":511},[497,837,838],{"class":507},"Data",[497,840,512],{"class":511},[497,842,843],{"class":507},"UpdateCustomerData",[497,845,523],{"class":511},[497,847,848],{"class":499,"line":526},[497,849,530],{"emptyLinePlaceholder":529},[497,851,852,854,857,859,861,863,865,867,870,872,874,876],{"class":499,"line":533},[497,853,536],{"class":511},[497,855,856],{"class":507},"handle ",[497,858,542],{"class":511},[497,860,545],{"class":511},[497,862,548],{"class":507},[497,864,551],{"class":511},[497,866,757],{"class":554},[497,868,869],{"class":511},"($",[497,871,757],{"class":507},[497,873,551],{"class":511},[497,875,762],{"class":507},[497,877,575],{"class":511},[497,879,880,882,885,887,890,892,895,898,900,903,905,907,910,912],{"class":499,"line":578},[497,881,536],{"class":511},[497,883,884],{"class":507},"handle",[497,886,551],{"class":511},[497,888,889],{"class":554},"update",[497,891,564],{"class":511},[497,893,894],{"class":503},"new",[497,896,897],{"class":628}," UpdateCustomerData",[497,899,564],{"class":511},[497,901,902],{"class":628},"name",[497,904,632],{"class":511},[497,906,635],{"class":511},[497,908,909],{"class":570},"Alex Example",[497,911,567],{"class":51