1,572],{"class":524},"'",[518,574,576],{"class":575},"sfazB","subscription_plan_pro",[518,578,572],{"class":524},[518,580,554],{"class":524},[518,582,584,586,589,591,593,595,597,600],{"class":520,"line":583},3,[518,585,525],{"class":524},[518,587,588],{"class":528},"pending ",[518,590,532],{"class":524},[518,592,535],{"class":524},[518,594,545],{"class":528},[518,596,541],{"class":524},[518,598,599],{"class":544},"scheduledUpdate",[518,601,602],{"class":524},"();\n",[484,604,605,608,609,612,613,616,617,620,621,624,625,628,629,632],{},[488,606,607],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[488,610,611],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[488,614,615],{},"ScheduledSubscriptionUpdate","; read its ",[488,618,619],{},"subscriptionPlanId",", ",[488,622,623],{},"quantity",", and ",[488,626,627],{},"effectiveAt"," to show the pending change. ",[488,630,631],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[484,634,635],{},"To apply the change now and invoice the prorated difference:",[509,637,639],{"className":511,"code":638,"language":513,"meta":514,"style":514},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[488,640,641],{"__ignoreMap":514},[518,642,643,645,647,649,651,653,655,658,661,663,665,667,669],{"class":520,"line":521},[518,644,525],{"class":524},[518,646,538],{"class":528},[518,648,541],{"class":524},[518,650,545],{"class":544},[518,652,548],{"class":524},[518,654,551],{"class":528},[518,656,657],{"class":524},")->",[518,659,660],{"class":544},"swapAndInvoice",[518,662,569],{"class":524},[518,664,572],{"class":524},[518,666,576],{"class":575},[518,668,572],{"class":524},[518,670,554],{"class":524},[484,672,673],{},"To apply it now without charging for the change:",[509,675,677],{"className":511,"code":676,"language":513,"meta":514,"style":514},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[488,678,679],{"__ignoreMap":514},[518,680,681,683,685,687,689,691,693,695,698,700,702,704,706],{"class":520,"line":521},[518,682,525],{"class":524},[518,684,538],{"class":528},[518,686,541],{"class":524},[518,688,545],{"class":544},[518,690,548],{"class":524},[518,692,551],{"class":528},[518,694,657],{"class":524},[518,696,697],{"class":544},"swapWithoutCharge",[518,699,569],{"class":524},[518,701,572],{"class":524},[518,703,576],{"class":575},[518,705,572],{"class":524},[518,707,554],{"class":524},[484,709,710,711,717],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[712,713,293],"a",{"href":714,"rel":715},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[716],"nofollow"," for proration and update options.",[501,719,721],{"id":720},"cancel-and-resume","Cancel and resume",[484,723,724],{},"Request cancellation:",[509,726,728],{"className":511,"code":727,"language":513,"meta":514,"style":514},"$vatly->subscription($localSubscription)->cancel();\n",[488,729,730],{"__ignoreMap":514},[518,731,732,734,736,738,740,742,744,746,749],{"class":520,"line":521},[518,733,525],{"class":524},[518,735,538],{"class":528},[518,737,541],{"class":524},[518,739,545],{"class":544},[518,741,548],{"class":524},[518,743,551],{"class":528},[518,745,657],{"class":524},[518,747,748],{"class":544},"cancel",[518,750,602],{"class":524},[484,752,753,756],{},[488,754,755],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[484,758,759],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[509,761,763],{"className":511,"code":762,"language":513,"meta":514,"style":514},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[488,764,765,787,809,823],{"__ignoreMap":514},[518,766,767,769,771,773,775,777,779,781,783,785],{"class":520,"line":521},[518,768,525],{"class":524},[518,770,529],{"class":528},[518,772,532],{"class":524},[518,774,535],{"class":524},[518,776,538],{"class":528},[518,778,541],{"class":524},[518,780,545],{"class":544},[518,782,548],{"class":524},[518,784,551],{"class":528},[518,786,554],{"class":524},[518,788,789,793,796,798,800,803,806],{"class":520,"line":557},[518,790,792],{"class":791},"s7zQu","if",[518,794,795],{"class":524}," ($",[518,797,545],{"class":528},[518,799,541],{"class":524},[518,801,802],{"class":544},"isOnGracePeriod",[518,804,805],{"class":524},"())",[518,807,808],{"class":524}," {\n",[518,810,811,814,816,818,821],{"class":520,"line":583},[518,812,813],{"class":524},"    $",[518,815,545],{"class":528},[518,817,541],{"class":524},[518,819,820],{"class":544},"resume",[518,822,602],{"class":524},[518,824,826],{"class":520,"line":825},4,[518,827,828],{"class":524},"}\n",[484,830,831,834,835,838,839,620,842,845,846,849],{},[488,832,833],{},"resume()"," clears the local end date after the API succeeds. It is not a way to restart an already-ended subscription. ",[488,836,837],{},"cancellationReason()"," fetches the live reason, such as ",[488,840,841],{},"customer_request",[488,843,844],{},"merchant_request",", or ",[488,847,848],{},"payment_failure",".",[501,851,853],{"id":852},"update-billing","Update billing",[484,855,856],{},"Send the customer to Vatly to change billing details, including their address or VAT number:",[509,858,860],{"className":511,"code":859,"language":513,"meta":514,"style":514},"$url = $vatly->subscription($localSubscription)->updateBilling([\n    'billingAddress' => [\n        'companyName' => 'Example BV',\n        'country' => 'NL',\n    ],\n]);\n",[488,861