s":512},"();\n",[472,592,593,596,597,600,601,604,605,608,609,612,613,616,617,620],{},[476,594,595],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[476,598,599],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[476,602,603],{},"ScheduledSubscriptionUpdate","; read its ",[476,606,607],{},"subscriptionPlanId",", ",[476,610,611],{},"quantity",", and ",[476,614,615],{},"effectiveAt"," to show the pending change. ",[476,618,619],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[472,622,623],{},"To apply the change now and invoice the prorated difference:",[497,625,627],{"className":499,"code":626,"language":501,"meta":502,"style":502},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[476,628,629],{"__ignoreMap":502},[506,630,631,633,635,637,639,641,643,646,649,651,653,655,657],{"class":508,"line":509},[506,632,513],{"class":512},[506,634,526],{"class":516},[506,636,529],{"class":512},[506,638,533],{"class":532},[506,640,536],{"class":512},[506,642,539],{"class":516},[506,644,645],{"class":512},")->",[506,647,648],{"class":532},"swapAndInvoice",[506,650,557],{"class":512},[506,652,560],{"class":512},[506,654,564],{"class":563},[506,656,560],{"class":512},[506,658,542],{"class":512},[472,660,661],{},"To apply it now without charging for the change:",[497,663,665],{"className":499,"code":664,"language":501,"meta":502,"style":502},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[476,666,667],{"__ignoreMap":502},[506,668,669,671,673,675,677,679,681,683,686,688,690,692,694],{"class":508,"line":509},[506,670,513],{"class":512},[506,672,526],{"class":516},[506,674,529],{"class":512},[506,676,533],{"class":532},[506,678,536],{"class":512},[506,680,539],{"class":516},[506,682,645],{"class":512},[506,684,685],{"class":532},"swapWithoutCharge",[506,687,557],{"class":512},[506,689,560],{"class":512},[506,691,564],{"class":563},[506,693,560],{"class":512},[506,695,542],{"class":512},[472,697,698,699,705],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[700,701,281],"a",{"href":702,"rel":703},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[704],"nofollow"," for proration and update options.",[489,707,709],{"id":708},"cancel-and-resume","Cancel and resume",[472,711,712],{},"Request cancellation:",[497,714,716],{"className":499,"code":715,"language":501,"meta":502,"style":502},"$vatly->subscription($localSubscription)->cancel();\n",[476,717,718],{"__ignoreMap":502},[506,719,720,722,724,726,728,730,732,734,737],{"class":508,"line":509},[506,721,513],{"class":512},[506,723,526],{"class":516},[506,725,529],{"class":512},[506,727,533],{"class":532},[506,729,536],{"class":512},[506,731,539],{"class":516},[506,733,645],{"class":512},[506,735,736],{"class":532},"cancel",[506,738,590],{"class":512},[472,740,741,744],{},[476,742,743],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[472,746,747],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[497,749,751],{"className":499,"code":750,"language":501,"meta":502,"style":502},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[476,752,753,775,797,811],{"__ignoreMap":502},[506,754,755,757,759,761,763,765,767,769,771,773],{"class":508,"line":509},[506,756,513],{"class":512},[506,758,517],{"class":516},[506,760,520],{"class":512},[506,762,523],{"class":512},[506,764,526],{"class":516},[506,766,529],{"c