p",[527,577,578],{"class":533},"(",[527,580,581],{"class":533},"'",[527,583,585],{"class":584},"sfazB","subscription_plan_pro",[527,587,581],{"class":533},[527,589,563],{"class":533},[527,591,593,595,598,600,602,604,606,609],{"class":529,"line":592},3,[527,594,534],{"class":533},[527,596,597],{"class":537},"pending ",[527,599,541],{"class":533},[527,601,544],{"class":533},[527,603,554],{"class":537},[527,605,550],{"class":533},[527,607,608],{"class":553},"scheduledUpdate",[527,610,611],{"class":533},"();\n",[493,613,614,617,618,621,622,625,626,629,630,633,634,637,638,641],{},[497,615,616],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[497,619,620],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[497,623,624],{},"ScheduledSubscriptionUpdate","; read its ",[497,627,628],{},"subscriptionPlanId",", ",[497,631,632],{},"quantity",", and ",[497,635,636],{},"effectiveAt"," to show the pending change. ",[497,639,640],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[493,643,644],{},"To apply the change now and invoice the prorated difference:",[518,646,648],{"className":520,"code":647,"language":522,"meta":523,"style":523},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[497,649,650],{"__ignoreMap":523},[527,651,652,654,656,658,660,662,664,667,670,672,674,676,678],{"class":529,"line":530},[527,653,534],{"class":533},[527,655,547],{"class":537},[527,657,550],{"class":533},[527,659,554],{"class":553},[527,661,557],{"class":533},[527,663,560],{"class":537},[527,665,666],{"class":533},")->",[527,668,669],{"class":553},"swapAndInvoice",[527,671,578],{"class":533},[527,673,581],{"class":533},[527,675,585],{"class":584},[527,677,581],{"class":533},[527,679,563],{"class":533},[493,681,682],{},"To apply it now without charging for the change:",[518,684,686],{"className":520,"code":685,"language":522,"meta":523,"style":523},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[497,687,688],{"__ignoreMap":523},[527,689,690,692,694,696,698,700,702,704,707,709,711,713,715],{"class":529,"line":530},[527,691,534],{"class":533},[527,693,547],{"class":537},[527,695,550],{"class":533},[527,697,554],{"class":553},[527,699,557],{"class":533},[527,701,560],{"class":537},[527,703,666],{"class":533},[527,705,706],{"class":553},"swapWithoutCharge",[527,708,578],{"class":533},[527,710,581],{"class":533},[527,712,585],{"class":584},[527,714,581],{"class":533},[527,716,563],{"class":533},[493,718,719,720,726],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[721,722,334],"a",{"href":723,"rel":724},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[725],"nofollow"," for proration and update options.",[510,728,730],{"id":729},"cancel-and-resume","Cancel and resume",[493,732,733],{},"Request cancellation:",[518,735,737],{"className":520,"code":736,"language":522,"meta":523,"style":523},"$vatly->subscription($localSubscription)->cancel();\n",[497,738,739],{"__ignoreMap":523},[527,740,741,743,745,747,749,751,753,755,758],{"class":529,"line":530},[527,742,534],{"class":533},[527,744,547],{"class":537},[527,746,550],{"class":533},[527,748,554],{"class":553},[527,750,557],{"class":533},[527,752,560],{"class":537},[527,754,666],{"class":533},[527,756,757],{"class":553},"cancel",[527,759,611],{"class":533},[493,761,762,765],{},[497,763,764],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[493,767,768],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[518,770,772],{"className":520,"code":771,"language":522,"meta":523,"style":523},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[497,773,774,796,818,832],{"__ignoreMap":523},[527,775,776,778,780,782,784,786,788,790,792,794],{"class":529,"line":530},[527,777,534],{"class":533},[527,779,538],{"class":537},[527,781,541],{"class":533},[527,783,544],{"class":533},[527,785,547],{"class":537},[527,787,550],{"class":533},[527,789,554],{"class":553},[527,791,557],{"class":533},[527,793,560],{"class":537},[527,795,563],{"class":533},[527,797,798,802,805,807,809,812,815],{"class":529,"line":566},[527,799,801],{"class":800},"s7zQu","if",[527,803,804],{"class":533}," ($",[527,806,554],{"class":537},[527,808,550],{"class":533},[527,810,811],{"class":553},"isOnGracePeriod",[527,813,814],{"class":533},"())",[527,816,817],{"class":533}," {\n",[527,819,820,823,825,827,830],{"class":529,"line":592},[527,821,822],{"class":533},"    $",[527,824,554],{"class":537},[527,826,550],{"class":533},[527,828,829],{"class":553},"resume",[527,831,611],{"class":533},[527,833,835],{"class":529,"line":834},4,[527,836,837],{"class":533},"}\n",[493,839,840,843,844,847,848,629,851,854,855,858],{},[497,841,842],{},"resume()"," clears the local end date after the API succeeds. It is not a way to restart an already-ended subscription. ",[497,845,846],{},"cancellationReason()"," fetches the live reason, such as ",[497,849,850],{},"customer_request",[497,852,853],{},"merchant_request",", or ",[497,856,857],{},"payment_failure",".",[510,860,862],{"id":861},"update-billing","Update billing",[493,864,865],{},"Send the customer to Vatly to change billing details, including their address or VAT number:",[518,867,869],{"className":520,"code":868,"language":522,"meta":523,"style":523},"$url = $vatly->subscription($localSubscription)->updateBilling([\n    'billingAddress' => [\n        'companyName' => 'Example BV',\n        'country' => 'NL',\n    ],\n]);\n",[497,870,871,900,916,939,959,965],{"__ignoreMap":523},[527,872,873,875,878,880,882,884,886,888,890,892,894,897],{"class":529,"line":530},[527,874,534],{"class":533},[527,876,877],{"class":537},"url ",[527,879,541],{"class":533},[527,881,544],{"class":533},[527,883,547],{"class":537},[527,885,550],{"class":533},[527,887,554],{"class":553},[527,889,557],{"class":533},[527,891,560],{"class":537},[527,893,666],{"class":533},[527,895,896],{"class":553},"updateBilling",[527,898,899],{"class":533},"([\n",[527,901,902,905,908,910,913],{"class":529,"line":566},[527,903,904],{"class":533},"    '",[527,906,907],{"class":584},"billingAddress",[527,909,581],{"class":533},[527,911,912],{"class":533}," =>",[527,914,915],{"class":533}," [\n",[527,917,918,921,924,926,928,931,934,936],{"class":529,"line":592},[527,919,920],{"class":533},"        '",[527,922,923],{"class":584},"companyName",[527,925,581],{"class":533},[527,927,912],{"class":533},[527,929,930],{"class":533}," '",[527,932,933],{"class":584},"Example BV",[527,935,581],{"class":533},[527,937,938],{"class":533},",\n",[527,940,941,943,946,948,950,952,955,957],{"class":529,"line":834},[527,942,920],{"class":533},[527,944,945],{"class":584},"country",[527,947,581],{"class":533},[527,949,912],{"class":533},[527,951,930],{"class":533},[527,953,954],{"class":584},"NL",[527,956,581],{"class":533},[527,958,938],{"class":533},[527,960,962],{"class":529,"line":961},5,[527,963,964],{"class":533},"    ],\n",[527,966,968],{"class":529,"line":967},6,[527,969,970],{"class":533},"]);\n",[493,972,973,974,977,978,981,982,985,986,858],{},"Redirect to ",[497,975,976],{},"$url",". Each call returns a fresh time-bounded link; do not cache it. Redirect defaults come from configuration, and the array can override ",[497,979,980],{},"redirectUrlSuccess"," and ",[497,983,984],{},"redirectUrlCanceled",". Missing URLs raise ",[497,987,988],{},"IncompleteInformationException",[493,990,991,992,995,996,999],{},"The ",[497,993,994],{},"subscription.billing_updated"," reaction refreshes the locally stored mandate summary. The ",[721,997,998],{"href":196},"customer portal"," is an alternative for broader self-service billing.",[510,1001,1003],{"id":1002},"read-local-state-carefully","Read local state carefully",[493,1005,1006,629,1009,633,1012,1015,1016,1019,1020,858],{},[497,1007,1008],{},"isValid()",[497,1010,1011],{},"isOnGracePeriod()",[497,1013,1014],{},"isEnded()"," delegate to your local model. They are only as current as your webhook handling. The optional ",[497,1017,1018],{},"DerivesSubscriptionState"," trait derives them from the end date, not payment status. Handle payment recovery and entitlement rules explicitly; see ",[721,1021,206],{"href":207},[1023,1024,1025],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(-