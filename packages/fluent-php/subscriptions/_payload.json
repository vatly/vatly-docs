,{"class":532},");\n",[526,564,566,568,570,572,575,578,581,585,587],{"class":528,"line":565},2,[526,567,533],{"class":532},[526,569,553],{"class":536},[526,571,549],{"class":532},[526,573,574],{"class":552},"swap",[526,576,577],{"class":532},"(",[526,579,580],{"class":532},"'",[526,582,584],{"class":583},"sfazB","subscription_plan_pro",[526,586,580],{"class":532},[526,588,562],{"class":532},[526,590,592,594,597,599,601,603,605,608],{"class":528,"line":591},3,[526,593,533],{"class":532},[526,595,596],{"class":536},"pending ",[526,598,540],{"class":532},[526,600,543],{"class":532},[526,602,553],{"class":536},[526,604,549],{"class":532},[526,606,607],{"class":552},"scheduledUpdate",[526,609,610],{"class":532},"();\n",[492,612,613,616,617,620,621,624,625,628,629,632,633,636,637,640],{},[496,614,615],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[496,618,619],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[496,622,623],{},"ScheduledSubscriptionUpdate","; read its ",[496,626,627],{},"subscriptionPlanId",", ",[496,630,631],{},"quantity",", and ",[496,634,635],{},"effectiveAt"," to show the pending change. ",[496,638,639],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[492,642,643],{},"To apply the change now and invoice the prorated difference:",[517,645,647],{"className":519,"code":646,"language":521,"meta":522,"style":522},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[496,648,649],{"__ignoreMap":522},[526,650,651,653,655,657,659,661,663,666,669,671,673,675,677],{"class":528,"line":529},[526,652,533],{"class":532},[526,654,546],{"class":536},[526,656,549],{"class":532},[526,658,553],{"class":552},[526,660,556],{"class":532},[526,662,559],{"class":536},[526,664,665],{"class":532},")->",[526,667,668],{"class":552},"swapAndInvoice",[526,670,577],{"class":532},[526,672,580],{"class":532},[526,674,584],{"class":583},[526,676,580],{"class":532},[526,678,562],{"class":532},[492,680,681],{},"To apply it now without charging for the change:",[517,683,685],{"className":519,"code":684,"language":521,"meta":522,"style":522},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[496,686,687],{"__ignoreMap":522},[526,688,689,691,693,695,697,699,701,703,706,708,710,712,714],{"class":528,"line":529},[526,690,533],{"class":532},[526,692,546],{"class":536},[526,694,549],{"class":532},[526,696,553],{"class":552},[526,698,556],{"class":532},[526,700,559],{"class":536},[526,702,665],{"class":532},[526,704,705],{"class":552},"swapWithoutCharge",[526,707,577],{"class":532},[526,709,580],{"class":532},[526,711,584],{"class":583},[526,713,580],{"class":532},[526,715,562],{"class":532},[492,717,718,719,725],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[720,721,301],"a",{"href":722,"rel":723},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[724],"nofollow"," for proration and update options.",[509,727,729],{"id":728},"cancel-and-resume","Cancel and resume",[492,731,732],{},"Request cancellation:",[517,734,736],{"className":519,"code":735,"language":521,"meta":522,"style":522},"$vatly->subscription($localSubscription)->cancel();\n",[496,737,738],{"__ignoreMap":522},[526,739,740,742,744,746,748,750,752,754,757],{"class":528,"line":529},[526,741,533],{"class":532},[526,743,546],{"class":536},[526,745,549],{"class":532},[526,747,553],{"class":552},[526,749,556],{"class":532},[526,751,559],{"class":536},[526,753,665],{"class":532},[526,755,756],{"class":552},"cancel",[526,758,610],{"class":532},[492,760,761,764],{},[496,762,763],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[492,766,767],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[517,769,771],{"className":519,"code":770,"language":521,"meta":522,"style":522},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[496,772,773,795,817,831],{"__ignoreMap":522},[526,774,775,777,779,781,783,785,787,789,791,793],{"class":528,"line":529},[526,776,533],{"class":532},[526,778,537],{"class":536},[526,780,540],{"class":532},[526,782,543],{"class":532},[526,784,546],{"class":536},[526,786,549],{"class":532},[526,788,553],{"class":552},[526,790,556],{"class":532},[526,792,559],{"class":536},[526,794,562],{"class":532},[526,796,797,801,804,806,808,811,814],{"class":528,"line":565},[526,798,800],{"class":799},"s7zQu","if",[526,802,803],{"class":532}," ($",[526,805,553],{"class":536},[526,807,549],{"class":532},[526,809,810],{"class":552},"isOnGracePeriod",[526,812,813],{"class":532},"())",[526,815,816],{"class":532}," {\n",[526,818,819,822,824,826,829],{"class":528,"line":591},[526,820,821],{"class":532},"    $",[526,823,553],{"class":536},[526,825,549],{"class":532},[526,827,828],{"class":552},"resume",[526,830,610],{"class":532},[526,832,834],{"class":528,"line":833},4,[526,835,836],{"class":532},"}\n",[492,838,839,842,843,846,847,628,850,853,854,857],{},[496,840,841],{},"resume()"," clears the local end date after the API succeeds. It is not a way to restart an already-ended subscription. ",[496,844,845],{},"cancellationReason()"," fetches the live reason, such as ",[496,848,849],{},"customer_request",[496,851,852],{},"merchant_request",", or ",[496,855,856],{},"payment_failure",".",[509,859,861],{"id":860},"update-billing","Update billing",[492,863,864],{},"Send the customer to Vatly to change billing details, including their address or VAT number:",[517,866,868],{"className":519,"code":867,"language":521,"meta":522,"style":522},"$url = $vatly->subscription($localSubscription)->updateBilling([\n    'billingAddress' => [\n        'companyName' => 'Example BV',\n        'country' => 'NL',\n    ],\n]);\n",[496,869,870,899,915,938,958,964],{"__ignoreMap":522},[526,871,872,874,877,879,881,883,885,887,889,891,893,896],{"class":528,"line":529},[526,873,533],{"class":532},[526,875,876],{"class":536},"url ",[526,878,540],{"class":532},[526,880,543],{"class":532},[526,882,546],{"class":536},[526,884,549],{"class":532},[526,886,553],{"class":552},[526,888,556],{"class":532},[526,890,559],{"class":536},[526,892,665],{"class":532},[526,894,895],{"class":552},"updateBilling",[526,897,898],{"class":532},"([\n",[526,900,901,904,907,909,912],{"class":528,"line":565},[526,902,903],{"class":532},"    '",[526,905,906],{"class":583},"billingAddress",[526,908,580],{"class":532},[526,910,911],{"class":532}," =>",[526,913,914],{"class":532}," [\n",[526,916,917,920,923,925,927,930,933,935],{"class":528,"line":591},[526,918,919],{"class":532},"        '",[526,921,922],{"class":583},"companyName",[526,924,580],{"class":532},[526,926,911],{"class":532},[526,928,929],{"class":532}," '",[526,931,932],{"class":583},"Example BV",[526,934,580],{"class":532},[526,936,937],{"class":532},",\n",[526,939,940,942,945,947,949,951,954,956],{"class":528,"line":833},[526,941,919],{"class":532},[526,943,944],{"class":583},"country",[526,946,580],{"class":532},[526,948,911],{"class":532},[526,950,929],{"class":532},[526,952,953],{"class":583},"NL",[526,955,580],{"class":532},[526,957,937],{"class":532},[526,959,961],{"class":528,"line":960},5,[526,962,963],{"class":532},"    ],\n",[526,965,967],{"class":528,"line":966},6,[526,968,969],{"class":532},"]);\n",[492,971,972,973,976,977,980,981,984,985,857],{},"Redirect to ",[496,974,975],{},"$url",". Each call returns a fresh time-bounded link; do not cache it. Redirect defaults come from configuration, and the array can override ",[496,978,979],{},"redirectUrlSuccess"," and ",[496,982,983],{},"redirectUrlCanceled",". Missing URLs raise ",[496,986,987],{},"IncompleteInformationException",[492,989,990,991,994,995,998],{},"The ",[496,992,993],{},"subscription.billing_updated"," reaction refreshes the locally stored mandate summary. The ",[720,996,997],{"href":215},"customer portal"," is an alternative for broader self-service billing.",[509,1000,1002],{"id":1001},"read-local-state-carefully","Read local state carefully",[492,1004,1005,628,1008,632,1011,1014,1015,1018,1019,857],{},[496,1006,1007],{},"isValid()",[496,1009,1010],{},"isOnGracePeriod()",[496,1012,1013],{},"isEnded()"," delegate to your local model. They are only as current as your webhook handling. The optional ",[496,1016,1017],{},"DerivesSubscriptionState"," trait derives them from the end date, not payment status. Handle payment recovery and entitlement rules explicitly; see ",[720,1020,1021],{"href":222},"Event flow",[1023,1024,1025],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--s