fault. The current plan remains in effect until then. ",[472,594,595],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[472,598,599],{},"ScheduledSubscriptionUpdate","; read its ",[472,602,603],{},"subscriptionPlanId",", ",[472,606,607],{},"quantity",", and ",[472,610,611],{},"effectiveAt"," to show the pending change. ",[472,614,615],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[468,618,619],{},"To apply the change now and invoice the prorated difference:",[493,621,623],{"className":495,"code":622,"language":497,"meta":498,"style":498},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[472,624,625],{"__ignoreMap":498},[502,626,627,629,631,633,635,637,639,642,645,647,649,651,653],{"class":504,"line":505},[502,628,509],{"class":508},[502,630,522],{"class":512},[502,632,525],{"class":508},[502,634,529],{"class":528},[502,636,532],{"class":508},[502,638,535],{"class":512},[502,640,641],{"class":508},")->",[502,643,644],{"class":528},"swapAndInvoice",[502,646,553],{"class":508},[502,648,556],{"class":508},[502,650,560],{"class":559},[502,652,556],{"class":508},[502,654,538],{"class":508},[468,656,657],{},"To apply it now without charging for the change:",[493,659,661],{"className":495,"code":660,"language":497,"meta":498,"style":498},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[472,662,663],{"__ignoreMap":498},[502,664,665,667,669,671,673,675,677,679,682,684,686,688,690],{"class":504,"line":505},[502,666,509],{"class":508},[502,668,522],{"class":512},[502,670,525],{"class":508},[502,672,529],{"class":528},[502,674,532],{"class":508},[502,676,535],{"class":512},[502,678,641],{"class":508},[502,680,681],{"class":528},"swapWithoutCharge",[502,683,553],{"class":508},[502,685,556],{"class":508},[502,687,560],{"class":559},[502,689,556],{"class":508},[502,691,538],{"class":508},[468,693,694,695,701],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[696,697,280],"a",{"href":698,"rel":699},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[700],"nofollow"," for proration and update options.",[485,703,705],{"id":704},"cancel-and-resume","Cancel and resume",[468,707,708],{},"Request cancellation:",[493,710,712],{"className":495,"code":711,"language":497,"meta":498,"style":498},"$vatly->subscription($localSubscription)->cancel();\n",[472,713,714],{"__ignoreMap":498},[502,715,716,718,720,722,724,726,728,730,733],{"class":504,"line":505},[502,717,509],{"class":508},[502,719,522],{"class":512},[502,721,525],{"class":508},[502,723,529],{"class":528},[502,725,532],{"class":508},[502,727,535],{"class":512},[502,729,641],{"class":508},[502,731,732],{"class":528},"cancel",[502,734,586],{"class":508},[468,736,737,740],{},[472,738,739],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[468,742,743],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[493,745,747],{"className":495,"code":746,"language":497,"meta":498,"style":498},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[472,748,749,771,793,807],{"__ignoreMap":498},[502,750,751,753,755,757,759,761,763,765,767,769],{"class":504,"line":505},[502,752,509],{"class":508},[502,754,513],{"class":512},[502,756,516],{"class":508},[502,758,519],{"class":508},[502,760,522],{"class":512},[502,762,525],{"class":508},[502,764,529],{"class":528},[502,766,532],{"class":508},[502,768,535],{"class":512},[502,770,538],{"class":508},[502,772,773,777,780,782,784,787,790],{"class":504,"line":541},[502,774,776],{"class":775},"s7zQu","if",[502,778,779],{"class":508}," ($",[502,781,529],{"class":512},[502,783,525],{"class":508},[502,785,786],{"class":528},"isOnGracePeriod",[502,788,789],{"class":508},"())",[502,791,792],{"class":508}," {\n",[502,794,795,798,800,802,805],{"class":504,"line":567},[502,796,797],{"class":508},"    $",[502,799,529],{"class":512},[502,801,525],{"class":508},[502,803,804],{"class":528},"resume",[502,806,586],{"class":508},[502,808,810],{"class":504,"line":809},4,[502,811,812],{"class":508},"}\n",[468,814,815,818,819,822,823,604,826,829,830,833],{},[472,816,817],{},"resume()"," clears the local end date after the API succeeds. It is not a way to restart an already-ended subscription. ",[472,820,821],{},"cancellationReason()"," fetches the live reason, such as ",[472,824,825],{},"customer_request",[472,827,828],{},"merchant_request",", or ",[472,831,832],{},"payment_failure",".",[485,835,837],{"id":836},"update-billing","Update billing",[468,839,840],{},"Send the customer to Vatly to change billing details, including their address or VAT number:",[493,842,844],{"className":495,"code":843,"language":497,"meta":498,"style":498},"$url = $vatly->subscription($localSubscription)->updateBilling([\n    'billingAddress' => [\n        'companyName' => 'Example BV',\n        'country' => 'NL',\n    ],\n]);\n",[472,845,846,875,891,914,934,940],{"__ignoreMap":498},[502,847,848,850,853,855,857,859,861,863,865,867,869,872],{"class":504,"line":505},[502,849,509],{"class":508},[502,851,852],{"class":512},"url ",[502,854,516],{"class":508},[502,856,519],{"class":508},[502,858,522],{"class":512},[502,860,525],{"class":508},[502,862,529],{"class":528},[502,864,532],{"class":508},[502,866,535],{"class":512},[502,868,641],{"class":508},[502,870,871],{"class":528},"updateBilling",[502,873,874],{"class":508},"([\n",[502,876,877,880,883,885,888],{"class":504,"line":541},[502,878,879],{"class":508},"    '",[502,881,882],{"class":559},"billin