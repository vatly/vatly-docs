71,591,592,595,596,599,600,603,604,607,608,611,612,615,616,619],{},[475,593,594],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[475,597,598],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[475,601,602],{},"ScheduledSubscriptionUpdate","; read its ",[475,605,606],{},"subscriptionPlanId",", ",[475,609,610],{},"quantity",", and ",[475,613,614],{},"effectiveAt"," to show the pending change. ",[475,617,618],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[471,621,622],{},"To apply the change now and invoice the prorated difference:",[496,624,626],{"className":498,"code":625,"language":500,"meta":501,"style":501},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[475,627,628],{"__ignoreMap":501},[505,629,630,632,634,636,638,640,642,645,648,650,652,654,656],{"class":507,"line":508},[505,631,512],{"class":511},[505,633,525],{"class":515},[505,635,528],{"class":511},[505,637,532],{"class":531},[505,639,535],{"class":511},[505,641,538],{"class":515},[505,643,644],{"class":511},")->",[505,646,647],{"class":531},"swapAndInvoice",[505,649,556],{"class":511},[505,651,559],{"class":511},[505,653,563],{"class":562},[505,655,559],{"class":511},[505,657,541],{"class":511},[471,659,660],{},"To apply it now without charging for the change:",[496,662,664],{"className":498,"code":663,"language":500,"meta":501,"style":501},"$vatly->subscription($localSubscription)->swapWithoutCharge('subscription_plan_pro');\n",[475,665,666],{"__ignoreMap":501},[505,667,668,670,672,674,676,678,680,682,685,687,689,691,693],{"class":507,"line":508},[505,669,512],{"class":511},[505,671,525],{"class":515},[505,673,528],{"class":511},[505,675,532],{"class":531},[505,677,535],{"class":511},[505,679,538],{"class":515},[505,681,644],{"class":511},[505,683,684],{"class":531},"swapWithoutCharge",[505,686,556],{"class":511},[505,688,559],{"class":511},[505,690,563],{"class":562},[505,692,559],{"class":511},[505,694,541],{"class":511},[471,696,697,698,704],{},"The next renewal uses the new price. Each method also accepts an options array for API update fields. Fluent updates local plan and quantity from the API response; webhooks reconcile subsequent changes. Use the ",[699,700,280],"a",{"href":701,"rel":702},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[703],"nofollow"," for proration and update options.",[488,706,708],{"id":707},"cancel-and-resume","Cancel and resume",[471,710,711],{},"Request cancellation:",[496,713,715],{"className":498,"code":714,"language":500,"meta":501,"style":501},"$vatly->subscription($localSubscription)->cancel();\n",[475,716,717],{"__ignoreMap":501},[505,718,719,721,723,725,727,729,731,733,736],{"class":507,"line":508},[505,720,512],{"class":511},[505,722,525],{"class":515},[505,724,528],{"class":511},[505,726,532],{"class":531},[505,728,535],{"class":511},[505,730,538],{"class":515},[505,732,644],{"class":511},[505,734,735],{"class":531},"cancel",[505,737,589],{"class":511},[471,739,740,743],{},[475,741,742],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[471,745,746],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[496,748,750],{"className":498,"code":749,"language":500,"meta":501,"style":501},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[475,751,752,774,796,810],{"__ignoreMap":501},[505,753,754,756,758,760,762,764,766,768,770,772],{"class":507,"line":508},[505,755,512],{"class":511},[505,757,516],{"class":515},[505,759,519],{"class":511},[505,761,522],{"class":511},[505,763,525],{"class":515},[505,765,528],{"class":511},[505,76