,553],{"class":536},"->",[530,555,557],{"class":556},"s2Zo4","subscription",[530,559,560],{"class":536},"($",[530,562,563],{"class":540},"localSubscription",[530,565,566],{"class":536},");\n",[530,568,570,572,574,576,579,582,585,589,591],{"class":532,"line":569},2,[530,571,537],{"class":536},[530,573,557],{"class":540},[530,575,553],{"class":536},[530,577,578],{"class":556},"swap",[530,580,581],{"class":536},"(",[530,583,584],{"class":536},"'",[530,586,588],{"class":587},"sfazB","subscription_plan_pro",[530,590,584],{"class":536},[530,592,566],{"class":536},[530,594,596,598,601,603,605,607,609,612],{"class":532,"line":595},3,[530,597,537],{"class":536},[530,599,600],{"class":540},"pending ",[530,602,544],{"class":536},[530,604,547],{"class":536},[530,606,557],{"class":540},[530,608,553],{"class":536},[530,610,611],{"class":556},"scheduledUpdate",[530,613,614],{"class":536},"();\n",[496,616,617,620,621,624,625,628,629,632,633,636,637,640,641,644],{},[500,618,619],{},"swap()"," schedules the change for the next billing cycle by default. The current plan remains in effect until then. ",[500,622,623],{},"scheduledUpdate()"," makes a live API call and returns a nullable ",[500,626,627],{},"ScheduledSubscriptionUpdate","; read its ",[500,630,631],{},"subscriptionPlanId",", ",[500,634,635],{},"quantity",", and ",[500,638,639],{},"effectiveAt"," to show the pending change. ",[500,642,643],{},"hasScheduledUpdate()"," also makes a live call, so do not call both just to get the same data.",[496,646,647],{},"To apply the change now and invoice the prorated difference:",[521,649,651],{"className":523,"code":650,"language":525,"meta":526,"style":526},"$vatly->subscription($localSubscription)->swapAndInvoice('subscription_plan_pro');\n",[500,652,653],{"__ignoreMap":526},[530,654,655,657,659,661,663,665,667,670,673,675,677,679,681],{"class":532,"line":533},[530,656,537],{"class":536},[530,658,550],{"class":540},[530,660,553],{"class":536},[530,662,557],{"class":556},[530,664,560],{