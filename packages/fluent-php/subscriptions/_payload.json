,[496,764,765,768],{},[500,766,767],{},"cancel()"," takes no options and does not set the local end date itself. The cancellation webhook carries the confirmed end date. Keep access through a valid grace period; do not revoke access just because a cancellation was requested.",[496,770,771],{},"While the local subscription is on its grace period, reverse the pending cancellation:",[521,773,775],{"className":523,"code":774,"language":525,"meta":526,"style":526},"$subscription = $vatly->subscription($localSubscription);\nif ($subscription->isOnGracePeriod()) {\n    $subscription->resume();\n}\n",[500,776,777,799,821,835],{"__ignoreMap":526},[530,778,779,781,783,785,787,789,791,793,795,797],{"class":532,"line":533},[530,780,537],{"class":536},[530,782,541],{"class":540},[530,784,544],{"class":536},[530,786,547],{"class":536},[530,788,550],{"class":540},[530,790,553],{"class":536},[530,792,557],{"class":556},[530,794,560],{"class":536},[530,796,563],{"class":540},[530,798,566],{"class":536},[530,800,801,805,808,810,812,815,818],{"class":532,"line":569},[530,802,804],{"class":803},"s7zQu","if",[530,806,807],{"class":536}," ($",[530,809,557],{"class":540},[530,811,553],{"class":536},[530,813,814],{"class":556},"isOnGracePeriod",[530,816,817],{"class":536},"())",[530,819,820],{"class":536}," {\n",[530,822,823,826,828,830,833],{"class":532,"line":595},[530,824,825],{"class":536},"    $",[530,827,557],{"class":540},[530,829,553],{"class":536},[530,831,832],{"class":556},"resume",[530,834,614],{"class":536},[530,836,838],{"class":532,"line":837},4,[530,839,840],{"class":536},"}\n",[496,842,843,846,847,850,851,632,854,857,858,861],{},[500,844,845],{},"resume()"," clears the local end date after the API succeeds. It is not a way to restart an already-ended subscription. ",[500,848,849],{},"cancellationReason()"," fetches the live reason, such as ",[500,852,853],{},"customer_request",[500,855,856],{},"merchant_request",", or ",[500,859,860],{},"payment_failure",".",[513,863,865],