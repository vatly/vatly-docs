y $vatly, string $customerId, string $planId): ?string\n{\n    try {\n        $checkout = $vatly->subscriptionBuilder(new CustomerProfile(vatlyId: $customerId))\n            ->toPlan($planId)->create();\n        return $checkout->links->checkoutUrl->href;\n    } catch (VatlyException $error) {\n        error_log('Vatly checkout failed: ' . $error->getCode());\n        return null;\n    }\n}\n",[483,879,880,897,919,935,939,986,991,1000,1041,1063,1090,1113,1143,1151,1157],{"__ignoreMap":481},[486,881,882,884,886,888,890,892,895],{"class":488,"line":489},[486,883,556],{"class":555},[486,885,560],{"class":559},[486,887,564],{"class":563},[486,889,567],{"class":559},[486,891,564],{"class":563},[486,893,894],{"class":559},"CustomerProfile",[486,896,579],{"class":563},[486,898,899,901,903,905,907,909,912,914,917],{"class":488,"line":582},[486,900,556],{"class":555},[486,902,560],{"class":559},[486,904,564],{"class":563},[486,906,567],{"class":559},[486,908,564],{"class":563},[486,910,911],{"class":559},"Exceptions",[486,913,564],{"class":563},[486,915,916],{"class":559},"VatlyException",[486,918,579],{"class":563},[486,920,921,923,925,927,929,931,933],{"class":488,"line":600},[486,922,556],{"class":555},[486,924,560],{"class":559},[486,926,564],{"class":563},[486,928,567],{"class":559},[486,930,564],{"class":563},[486,932,595],{"class":559},[486,934,579],{"class":563},[486,936,937],{"class":488,"line":618},[486,938,622],{"emptyLinePlaceholder":621},[486,940,941,945,948,950,952,954,957,960,963,965,968,970,972,974,977,980,983],{"class":488,"line":625},[486,942,944],{"class":943},"spNyl","function",[486,946,947],{"class":661}," tryCheckout",[486,949,665],{"class":563},[486,951,595],{"class":492},[486,953,781],{"class":563},[486,955,956],{"class":559},"vatly",[486,958,959],{"class":563},",",[486,961,962],{"class":555}," string",[486,964,781],{"class":563},[486,966,967],{"class":559},"customerId",[486,969,959],{"class":563},[486,971,962],{"class":555},[486,973,781],{"class":563