s\u002Fphp\u002Freadme",[866],"vatly-api-php",". No Fluent layer required.",[496,891,892,893,896,897,896,900,903,904,907],{},"With the raw SDK you assemble checkout payloads and coordinate webhook persistence yourself. Fluent gives those common tasks names: ",[512,894,895],{},"toPlan()",", ",[512,898,899],{},"swapAndInvoice()",[512,901,902],{},"updateBilling()",", and ",[512,905,906],{},"webhookProcessor()->handle()",". It does not supply tables, routes, authorization, transactions, or exactly-once delivery.",[517,909,9],{"id":910},"guides",[836,912,913,923],{},[839,914,915],{},[842,916,917,920],{},[845,918,919],{},"Task",[845,921,922],{},"Page",[852,924,925,934,943,952,961,970,979,988,998,1007,1016],{},[842,926,927,930],{},[857,928,929],{},"Install, set keys, redirects, and handle errors",[857,931,932],{},[525,933,198],{"href":199},[842,935,936,939],{},[857,937,938],{},"Connect billables and storage",[857,940,941],{},[525,942,202],{"href":203},[842,944,945,948],{},[857,946,947],{},"Link your users to Vatly customers",[857,949,950],{},[525,951,72],{"href":206},[842,953,954,957],{},[857,955,956],{},"Sell one-off products and subscriptions",[857,958,959],{},[525,960,84],{"href":209},[842,962,963,966],{},[857,964,965],{},"Swap, cancel, resume, and update billing",[857,967,968],{},[525,969,92],{"href":212},[842,971,972,975],{},[857,973,974],{},"Open hosted self-service billing",[857,976,977],{},[525,978,218],{"href":219},[842,980,981,984],{},[857,982,983],{},"Verify deliveries and handle retries safely",[857,985,986],{},[525,987,54],{"href":222},[842,989,990,993],{},[857,991,992],{},"Choose which events to persist or listen for",[857,994,995],{},[525,996,997],{"href":226},"Event flow",[842,999,1000,1003],{},[857,1001,1002],{},"Show invoices, lines, refunds, and chargebacks",[857,1004,1005],{},[525,1006,100],{"href":215},[842,1008,1009,1012],{},[857,1010,1011],{},"Test without charging a customer",[857,1013,1014],{},[525,1015,62],{"href":233},[842,1017,1018,1021],{},[857