iguration","3.packages\u002F8.django\u002F02.configuration",{"title":424,"path":425,"stem":426},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":428,"path":429,"stem":430},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":432,"stem":433},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":193,"path":435,"stem":436},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":438,"stem":439},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":441,"path":442,"stem":443},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":445,"stem":446},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":363,"path":448,"stem":449},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":451,"path":452,"stem":453,"children":454},"Integrations","\u002Fintegrations","4.integrations",[455,457,461],{"title":451,"path":452,"stem":456},"4.integrations\u002Findex",{"title":458,"path":459,"stem":460},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":462,"path":463,"stem":464},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":466,"title":165,"body":467,"description":1018,"extension":1019,"links":1020,"meta":1021,"navigation":1022,"path":170,"seo":1023,"stem":171,"__hash__":1024},"docs\u002F3.packages\u002F2.fluent-php\u002F00.readme.md",{"type":468,"value":469,"toc":1013},"minimark",[470,474,483,491,496,503,800,806,810,865,883,886,1001,1009],[471,472,473],"p",{},"Sell a download, start a subscription, and keep your app's billing records in step with Vatly.\nVatly is the European Merchant of Record for AI, software and digital products.",[475,476,477],"blockquote",{},[471,478,479],{},[480,481,482],"strong",{},"Alpha — under active development. Every alpha release may include breaking changes. Pin exact versions during alpha.",[471,484,485,486,490],{},"Fluent adds checkout builders, subscription operations, customer bindings, and a webhook processing pipeline to ",[487,488,489],"code",{},"vatly\u002Fvatly-api-php",". You keep your database and framework. Fluent calls your storage contracts to save orders and subscriptions.",[492,493,495],"h2",{"id":494},"start-a-subscription","Start a subscription",[471,497,498,499,502],{},"Install the package using ",[500,501,173],"a",{"href":174},". This function creates a hosted checkout and returns the URL to send to the browser:",[504,505,510],"pre",{"className":506,"code":507,"language":508,"meta":509,"style":509},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\CustomerProfile;\nuse Vatly\\Fluent\\Vatly;\n\nfunction subscriptionCheckout(string $apiKey, string $customerId, string $planId): string\n{\n    $vatly = Vatly::apiOnly($apiKey);\n    $checkout = $vatly->subscriptionBuilder(new CustomerProfile(vatlyId: $customerId))\n        ->toPlan($planId)\n        ->withRedirectUrlSuccess('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Freturn')\n        ->withRedirectUrlCanceled('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled')\n        ->create();\n\n    return $checkout->links->checkoutUrl->href;\n}\n","php","",[487,511,512,540,558,565,614,620,649,693,709,730,749,760,765,794],{"__ignoreMap":509},[513,514,517,521,525,529,532,534,537],"span",{"class":515,"line":516},"line",1,[513,518,520],{"class":519},"sbssI","use",[513,522,524],{"class":523},"sTEyZ"," Vatly",[513,526,528],{"class":527},"sMK4o","\\",[513,530,531],{"class":523},"Fluent",[513,533,528],{"class":527},[513,535,536],{"class":523},"CustomerProfile",[513,538,5