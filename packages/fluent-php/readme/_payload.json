r(new CustomerProfile(vatlyId: $customerId))\n        ->toPlan($planId)\n        ->withRedirectUrlSuccess('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Freturn')\n        ->withRedirectUrlCanceled('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled')\n        ->create();\n\n    return $checkout->links->checkoutUrl->href;\n}\n","php","",[508,532,533,561,579,586,635,641,670,714,730,751,770,781,786,815],{"__ignoreMap":530},[534,535,538,542,546,550,553,555,558],"span",{"class":536,"line":537},"line",1,[534,539,541],{"class":540},"sbssI","use",[534,543,545],{"class":544},"sTEyZ"," Vatly",[534,547,549],{"class":548},"sMK4o","\\",[534,551,552],{"class":544},"Fluent",[534,554,549],{"class":548},[534,556,557],{"class":544},"CustomerProfile",[534,559,560],{"class":548},";\n",[534,562,564,566,568,570,572,574,577],{"class":536,"line":563},2,[534,565,541],{"class":540},[534,567,545],{"class":544},[534,569,549],{"class":548},[534,571,552],{"class":544},[534,573,549],{"class":548},[534,575,576],{"class":544},"Vatly",[534,578,560],{"class":548},[534,580,582],{"class":536,"line":581},3,[534,583,585],{"emptyLinePlaceholder":584},true,"\n",[534,587,589,593,597,600,603,606,609,612,615,617,620,622,624,626,629,632],{"class":536,"line":588},4,[534,590,592],{"class":591},"spNyl","function",[534,594,596],{"class":595},"s2Zo4"," subscriptionCheckout",[534,598,599],{"class":548},"(",[534,601,602],{"class":540},"string",[534,604,605],{"class":548}," $",[534,607,608],{"class":544},"apiKey",[534,610,611],{"class":548},",",[534,613,614],{"class":540}," string",[534,616,605],{"class":548},[534,618,619],{"class":544},"customerId",[534,621,611],{"class":548},[534,623,614],{"class":540},[534,625,605],{"class":548},[534,627,628],{"class":544},"planId",[534,630,631],{"class":548},"):",[534,633,634],{"class":540}," string\n",[534,636,638],{"class":536,"line":637},5,[534,639,640],{"class":548},"{\n",[534,642,644,647,650,653,656,659,662,665,667],{"class":536,"line":643},6,[534,645,646],{"c