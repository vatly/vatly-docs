lass":548},"();\n",[534,782,784],{"class":536,"line":783},12,[534,785,585],{"emptyLinePlaceholder":584},[534,787,789,793,795,798,800,803,805,808,810,813],{"class":536,"line":788},13,[534,790,792],{"class":791},"s7zQu","    return",[534,794,605],{"class":548},[534,796,797],{"class":544},"checkout",[534,799,687],{"class":548},[534,801,802],{"class":544},"links",[534,804,687],{"class":548},[534,806,807],{"class":544},"checkoutUrl",[534,809,687],{"class":548},[534,811,812],{"class":544},"href",[534,814,560],{"class":548},[534,816,818],{"class":536,"line":817},14,[534,819,820],{"class":548},"}\n",[492,822,823,824,826],{},"Use a customer and plan from the same storefront and mode as your key. Authorize the signed-in user's access to that customer first. Redirect to the returned URL, then use ",[521,825,50],{"href":218}," to confirm the subscription and grant access. The return page alone is not proof of payment.",[513,828,830],{"id":829},"choose-your-layer","Choose your layer",[832,833,834,847],"table",{},[835,836,837],"thead",{},[838,839,840,844],"tr",{},[841,842,843],"th",{},"You need",[841,845,846],{},"Use",[848,849,850,865,873],"tbody",{},[838,851,852,856],{},[853,854,855],"td",{},"Billing in a Laravel app",[853,857,858,864],{},[521,859,863],{"href":860,"rel":861},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[862],"nofollow","vatly-laravel",". It wires Fluent into Laravel for you.",[838,866,867,870],{},[853,868,869],{},"Fluent billing flows in plain PHP, Symfony, WordPress, or a custom driver",[853,871,872],{},"This package. Start without storage; add repositories when you need local records.",[838,874,875,878],{},[853,876,877],{},"A few direct API calls, without local billing state",[853,879,880,885],{},[521,881,884],{"href":882,"rel":883},"https:\u002F\u002Fdocs.vatly.com\u002Fpackages\u002Fphp\u002Freadme",[862],"vatly-api-php",". No Fluent layer required.",[492,887,888,889,892,893,892,896,899,900,903],{},"With the raw SDK you assemble checkout payloads and coordinate webhook persistence yourself. Fluent gives those common tasks names: ",[508,890,891],{},"toPlan()",", ",[508,894,895],{},"swapAndInvoice()",[508,897,898],{},"updateBilling()",", and ",[508,901,902],{},"webhookProcessor()->handle()",". It does not supply tables, routes, authorization, transactions, or exactly-once delivery.",[513,905,9],{"id":906},"guides",[832,908,909,919],{},[835,910,911],{},[838,912,913,916],{},[841,914,915],{},"Task",[841,917,918],{},"Page",[848,920,921,930,939,948,957,966,975,984,994,1003,1012],{},[838,922,923,926],{},[853,924,925],{},"Install, set keys, redirects, and handle errors",[853,927,928],{},[521,929,194],{"href":195},[838,931,932,935],{},[853,933,934],{},"Connect billables and storage",[853,936,937],{},[521,938,198],{"href":199},[838,940,941,944],{},[853,942,943],{},"Link your users to Vatly customers",[853,945,946],{},[521,947,68],{"href":202},[838,949,950,953],{},[853,951,952],{},"Sell one-off products and subscriptions",[853,954,955],{},[521,956,80],{"href":205},[838,958,959,962],{},[853,960,961],{},"Swap, cancel, resume, and update billing",[853,963,964],{},[521,965,88],{"href":208},[838,967,968,971],{},[853,969,970],{},"Open hosted self-service billing",[853,972,973],{},[521,974,214],{"href":215},[838,976,977,980],{},[853,978,979],{},"Verify deliveries and handle retries safely",[853,981,982],{},[521,983,50],{"href":218},[838,985,986,989],{},[853,987,988],{},"Choose which events to persist or listen for",[853,990,991],{},[521,992,993],{"href":222},"Event flow",[838,995,996,999],{},[853,997,998],{},"Show invoices, lines, refunds, and chargebacks",[853,1000,1001],{},[521,1002,96],{"href":211},[838,1004,1005,1008],{},[853,1006,1007],{},"Test without charging a customer",[853,1009,1010],{},[521,1011,58],{"href":229},[838,1013,1014,1017],{},[853,1015,1016],{},"Reuse your existing order and subscription tables",[853,1018,1019],{},[521,1020,1021],{"href":226},"Host tables",[492,1023,1024,1025,1029],{},"For request and