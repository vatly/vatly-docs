nt.",[489,804,806],{"id":805},"choose-your-layer","Choose your layer",[808,809,810,823],"table",{},[811,812,813],"thead",{},[814,815,816,820],"tr",{},[817,818,819],"th",{},"You need",[817,821,822],{},"Use",[824,825,826,841,849],"tbody",{},[814,827,828,832],{},[829,830,831],"td",{},"Billing in a Laravel app",[829,833,834,840],{},[497,835,839],{"href":836,"rel":837},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-laravel",[838],"nofollow","vatly-laravel",". It wires Fluent into Laravel for you.",[814,842,843,846],{},[829,844,845],{},"Fluent billing flows in plain PHP, Symfony, WordPress, or a custom driver",[829,847,848],{},"This package. Start without storage; add repositories when you need local records.",[814,850,851,854],{},[829,852,853],{},"A few direct API calls, without local billing state",[829,855,856,861],{},[497,857,860],{"href":858,"rel":859},"https:\u002F\u002Fdocs.vatly.com\u002Fpackages\u002Fphp\u002Freadme",[838],"vatly-api-php",". No Fluent layer required.",[468,863,864,865,868,869,868,872,875,876,879],{},"With the raw SDK you assemble checkout payloads and coordinate webhook persistence yourself. Fluent gives those common tasks names: ",[484,866,867],{},"toPlan()",", ",[484,870,871],{},"swapAndInvoice()",[484,873,874],{},"updateBilling()",", and ",[484,877,878],{},"webhookProcessor()->handle()",". It does not supply tables, routes, authorization, transactions, or exactly-once delivery.",[489,881,9],{"id":882},"guides",[808,884,885,895],{},[811,886,887],{},[814,888,889,892],{},[817,890,891],{},"Task",[817,893,894],{},"Page",[824,896,897,906,915,924,933,942,951,960,970,979,988],{},[814,898,899,902],{},[829,900,901],{},"Install, set keys, redirects, and handle errors",[829,903,904],{},[497,905,173],{"href":174},[814,907,908,911],{},[829,909,910],{},"Connect billables and storage",[829,912,913],{},[497,914,177],{"href":178},[814,916,917,920],{},[829,918,919],{},"Link your users to Vatly customers",[829,921,922],{},[497,923,68],{"href":181},[814,925,9