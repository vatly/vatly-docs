grations\u002Fbolt","4.integrations\u002F2.bolt",{"id":488,"title":168,"body":489,"description":1038,"extension":1039,"links":1040,"meta":1041,"navigation":585,"path":169,"seo":1042,"stem":170,"__hash__":1043},"docs\u002F3.packages\u002F2.fluent-php\u002F0.readme.md",{"type":490,"value":491,"toc":1033},"minimark",[492,496,505,513,518,525,822,828,832,887,905,908,1021,1029],[493,494,495],"p",{},"Sell a download, start a subscription, and keep your app's billing records in step with Vatly.\nVatly is the European merchant of record for AI, software and digital products.",[497,498,499],"blockquote",{},[493,500,501],{},[502,503,504],"strong",{},"Alpha — under active development. Every alpha release may include breaking changes. Pin exact versions during alpha.",[493,506,507,508,512],{},"Fluent adds checkout builders, subscription operations, customer bindings, and a webhook processing pipeline to ",[509,510,511],"code",{},"vatly\u002Fvatly-api-php",". You keep your database and framework. Fluent calls your storage contracts to save orders and subscriptions.",[514,515,517],"h2",{"id":516},"start-a-subscription","Start a subscription",[493,519,520,521,524],{},"Install the package using ",[522,523,187],"a",{"href":188},". This function creates a hosted checkout and returns the URL to send to the browser:",[526,527,532],"pre",{"className":528,"code":529,"language":530,"meta":531,"style":531},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use Vatly\\Fluent\\CustomerProfile;\nuse Vatly\\Fluent\\Vatly;\n\nfunction subscriptionCheckout(string $apiKey, string $customerId, string $planId): string\n{\n    $vatly = Vatly::apiOnly($apiKey);\n    $checkout = $vatly->subscriptionBuilder(new CustomerProfile(vatlyId: $customerId))\n        ->toPlan($planId)\n        ->withRedirectUrlSuccess('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Freturn')\n        ->withRedirectUrlCanceled('https:\u002F\u002Fapp.example.com\u002Fbilling\u002Fcanceled')\n        ->create();\n\n    return $checkout->links->checkoutUrl->href;\n}\n","php","",[509,533,534,562,580,587,636,642,671,715,731,752,771,782,787,816],{"__ignoreMap":531},[535,536,539,543,547,551,554,556,559],"span",{"class":537,"line":538},"line",1,[535,540,542],{"class":541},"sbssI","use",[535,544,546],{"class":545},"sTEyZ"," Vatly",[535,548,550],{"class":549},"sMK4o","\\",[535,552,553],{"class":545},"Fluent",[535,555,550],{"class":549},[535,557,558],{"class":545},"CustomerProfile",[535,560,561],{"class":549},";\n",[535,563,565,567,569,571,573,575,578],{"class":537,"line":564},2,[535,566,542],{"class":541},[535,568,546],{"class":545},[535,570,550],{"class":549},[535,572,553],{"class":545},[535,574,550],{"class":549},[535,576,577],{"class":545},"Vatly",[535,579,561],{"class":549},[535,581,583],{"class":537,"line":582},3,[535,584,586],{"emptyLinePlaceholder":585},true,"\n",[535,588,590,594,598,601,604,607,610,613,616,618,621,623,625,627,630,633],{"class":537,"line":589},4,[535,591,593],{"class":592},"spNyl","function",[535,595,597],{"class":596},"s2Zo4"," subscriptionCheckout",[535,599,600],{"class":549},"(",[535,602,603],{"class":541},"string",[535,605,606],{"class":549}," $",[535,608,609],{"class":545},"apiKey",[535,611,612],{"class":549},",",[535,614,615],{"class":541}," string",[535,617,606],{"class":549},[535,619,620],{"class":545},"customerId",[535,622,612],{"class":549},[535,624,615],{"class":541},[535,626,606],{"class":549},[535,628,629],{"class":545},"planId",[535,631,632],{"class":549},"):",[535,634,635],{"class":541}," string\n",[535,637,639],{"class":537,"line":638},5,[535,640,641],{"class":549},"{\n",[535,643,645,648,651,654,657,660,663,666,668],{"class":537,"line":644},6,[535,646,647],{"class":549},"    $",[535,649,650],{"class":545},"vatly ",[535,652,653],{"class":549},"=",[535,655,546],{"class":656},"sBMFI",[535,658,659],{"class":549},"::",[535,661,662],{"class":596},"apiOnly",[535,664,665],{"class":549},"($",[535,667,609],{"class":545},