eived",[907,1567,1568],{},"-",[907,1570,1571],{},"none",[907,1573,1546,1574,1576],{},[432,1575,1549],{}," envelope",[735,1578,1580],{"id":1579},"reading-the-matrix","Reading the matrix",[765,1582,1583,1610,1628,1649,1702,1728,1738],{},[768,1584,1585,1588,1589,1592,1593,1596,1597,1600,1601,1603,1604,1606,1607,455],{},[494,1586,1587],{},"\"store if new, else update\""," - every entity reaction first calls ",[432,1590,1591],{},"findByVatlyId()",". A null return routes to ",[432,1594,1595],{},"store()","; a hit routes to ",[432,1598,1599],{},"update()",". This is the idempotency hinge: once ",[432,1602,1595],{}," writes the Vatly id back, webhook re-deliveries safely hit ",[432,1605,1599],{},". See the ",[437,1608,1609],{"href":174},"host-owns-its-tables recipe",[768,1611,1612,1615,1616,1618,1619,501,1621,501,1623,501,1625,1627],{},[494,1613,1614],{},"\"find-or-skip\""," - the reaction only ",[432,1617,1599],{},"s an existing local record and never creates one (",[432,1620,829],{},[432,1622,789],{},[432,1624,792],{},[432,1626,1269],{},").",[768,1629,1630,1634,1635,1070,1638,1641,1642,1644,1645,1648],{},[494,1631,1632],{},[432,1633,940],{}," - resolved from your ",[432,1636,1637],{},"CustomerBindingRepository",[480,1639,1640],{},"before"," the reaction calls your writer, so ",[432,1643,1595],{}," can fill the owner column directly. It's ",[432,1646,1647],{},"null"," for unattributed \u002F anonymous-checkout rows; accept that.",[768,1650,1651,1656,1657,1659,1660,1663,1664,1666,1667,1670,1671,687,1673,1675,1676,525,1678,687,1680,1682,1683,687,1685,1687,1688,1690,1691,1693,1694,593,1697,1699,1700,455],{},[494,1652,1653,1655],{},[432,1654,862],{}," is persistable"," - when a cancellation ends the subscription, ",[432,1658,1308],{}," passes the raw Vatly reason on ",[432,1661,1662],{},"UpdateSubscriptionData"," alongside ",[432,1665,1290],{},"; persist it if your host tracks ",[480,1668,1669],{},"why"," a subscription ended. All three cancel events carry one: ",[432,1672,1323],{},[432,1674,1298],{},"), ",[432,1677,1353],{},[432,1679,1323],{},[432,1681,1330],{},"), and ",[432,1684,1042],{},[432,1686,838],{},"). ",[432,1689,1647],{}," means \"no change\" (don't overwrite a stored reason). ",[432,1692,1022],{}," does the same for orders on ",[432,1695,1696],{},"UpdateOrderData",[432,1698,1042],{}," when payment recovery for the unpaid order was exhausted, otherwise ",[432,1701,1647],{},[768,1703,1704,1709,1710,501,1713,501,1716,659,1719,1070,1722,1724,1725,1727],{},[494,1705,1706,1707],{},"store may return ",[432,1708,1647],{}," - ",[432,1711,1712],{},"OrderWriter",[432,1714,1715],{},"SubscriptionWriter",[432,1717,1718],{},"RefundWriter",[432,1720,1721],{},"ChargebackWriter",[432,1723,1595],{}," may return ",[432,1726,1647],{}," when the driver can't route the data. Built-in reactions tolerate it.",[768,1729,1730,1733,1734,1737],{},[494,1731,1732],{},"opt-in reactions"," register only when their repository is wired into ",[432,1735,1736],{},"Wiring",". Without it, the typed events still dispatch for you to handle yourself.",[768,1739,1740,1743,1744,1747,1748,525,1751,525,1754,525,1757,525,1760,1763,1764,1766,1767,1770],{},[494,1741,1742],{},"order reversal progress is not a webhook reaction."," Whether - and how much of - an order was returned to the customer (by refund ",[480,1745,1746],{},"or"," chargeback) is read from the live API Order via ",[432,1749,1750],{},"OrderHandle::reversedSubtotal()",[432,1752,1753],{},"refundableSubtotal()",[432,1755,1756],{},"isReversed()",[432,1758,1759],{},"isPartiallyReversed()",[432,1761,1762],{},"isFullyReversed()",". The order's own ",[432,1765,1032],{}," stays terminal ",[432,1768,1769],{},"paid","; fluent never synthesizes a local refunded\u002Fchargeback status.",{"title":1772,"searchDepth":1773,"depth":1773,"links":1774},"",2,[1775,1776,1777],{"id":737,"depth":1773,"text":738},{"id":874,"depth":1773,"text":875},{"id":1579,"depth":1773,"text":1580},"Vatly PHP Fluent - Webhook flow: event → reacti