9],{"class":562}," EventDispatcherInterface\n",[511,571,573],{"class":513,"line":572},4,[511,574,575],{"class":525},"{\n",[511,577,579,582,585,589,592,595,598,601,604,607],{"class":513,"line":578},5,[511,580,581],{"class":555},"    public",[511,583,584],{"class":555}," function",[511,586,588],{"class":587},"s2Zo4"," __construct",[511,590,591],{"class":525},"(",[511,593,594],{"class":555},"private",[511,596,597],{"class":562}," Closure",[511,599,600],{"class":525}," $",[511,602,603],{"class":521},"listener",[511,605,606],{"class":525},")",[511,608,609],{"class":525}," {}\n",[511,611,613],{"class":513,"line":612},6,[511,614,549],{"emptyLinePlaceholder":548},[511,616,618,620,622,625,627,630,632,635,638],{"class":513,"line":617},7,[511,619,581],{"class":555},[511,621,584],{"class":555},[511,623,624],{"class":587}," dispatch",[511,626,591],{"class":525},[511,628,629],{"class":517},"object",[511,631,600],{"class":525},[511,633,634],{"class":521},"event",[511,636,637],{"class":525},"):",[511,639,640],{"class":517}," void\n",[511,642,644],{"class":513,"line":643},8,[511,645,646],{"class":525},"    {\n",[511,648,650,653,655,658,660],{"class":513,"line":649},9,[511,651,652],{"class":525},"        ($this->",[511,654,603],{"class":521},[511,656,657],{"class":525},")($",[511,659,634],{"class":521},[511,661,662],{"class":525},");\n",[511,664,666],{"class":513,"line":665},10,[511,667,668],{"class":525},"    }\n",[511,670,672],{"class":513,"line":671},11,[511,673,674],{"class":525},"}\n",[493,676,677,678,681],{},"In production, let that callback write outbox jobs on the same transaction as your repositories. It receives the typed event after the built-in reactions have run. Follow ",[679,680,50],"a",{"href":184}," for verification, deduplication, and the transaction boundary.",[683,684,686],"h2",{"id":685},"events-that-save-records","Events that save records",[688,689,690,703],"table",{},[691,692,693],"thead",{},[694,695,696,700],"tr",{},[697,698,699],"th",{},"Event",[697,701,702],{},"Built-in persistence",[704,705,706,717,735,745,755,765,775,785,799,813,823,839],"tbody",{},[694,707,708,714],{},[709,710,711],"td",{},[497,712,713],{},"order.paid",[709,715,716],{},"Find by Vatly ID; store a new order or update the existing one. New store data includes lines.",[694,718,719,724],{},[709,720,721],{},[497,722,723],{},"order.payment_failed",[709,725,726,727,730,731,734],{},"Store or update the order with the payload's status, usually ",[497,728,729],{},"pending"," during recovery. It does not invent a ",[497,732,733],{},"failed"," order status.",[694,736,737,742],{},[709,738,739],{},[497,740,741],{},"order.canceled",[709,743,744],{},"Update an existing order's status and cancellation reason; skip if missing.",[694,746,747,752],{},[709,748,749],{},[497,750,751],{},"subscription.started",[709,753,754],{},"Store a new subscription or update an existing one.",[694,756,757,762],{},[709,758,759],{},[497,760,761],{},"subscription.updated",[709,763,764],{},"Update an existing subscription's plan, name, and quantity for an immediate change.",[694,766,767,772],{},[709,768,769],{},[497,770,771],{},"subscription.billing_updated",[709,773,774],{},"Update an existing subscription's mandate summary.",[694,776,777,782],{},[709,778,779],{},[497,780,781],{},"subscription.resumed",[709,783,784],{},"Clear the end date on an existing subscription.",[694,786,787,796],{},[709,788,789,792,793],{},[497,790,791],{},"subscription.canceled_immediately",", ",[497,794,795],{},"subscription.canceled_with_grace_period",[709,797,798],{},"Update the existing subscription's confirmed end date and reason.",[694,800,801,806],{},[709,802,803],{},[497,804,805],{},"subscription.canceled_for_nonpayment",[709,807,808,809,812],{},"End the existing subscription after recovery is exhausted, with reason ",[497,810,811],{},"payment_failure",".",[694,814,815,820],{},[709,816,817],{},[497,818,819],{},"subscription.cancellation_grace_period_completed",[709,821,822],{},"Stamp the actual end date on an existing subscription.",[694,824,825,836],{},[709,826,827,792,830,792,833],{},[497,828,829],{},"refund.completed",[497,831,832],{},"refund.failed",[497,834,835],{},"refund.canceled",[709,837,838],{},"Store or update only when a refund repository is wired.",[694,840,841,849],{},[709,842,843,792,846],{},[497,844,845],{},"order.chargeback_received",[497,847,848],{},"order.chargeback_reversed",[709,850,851,852,812],{},"Store or update only when a chargeback repository is wired. The order stays ",[497,853,854],{},"paid",[493,856,857,858,861,862,865,866,869],{},"Order and subscription creation resolve ",[497,859,860],{},"hostCustomerId"," through your binding repository. It can be ",[497,863,864],{},"null",". The store DTOs carry ",[497,867,868],{},"testmode","; persist it. Order, refund, and chargeback store DTOs also carry totals, currency, and tax details.",[493,871,872,873,875,876,879,880,883],{},"All entity stores can return ",[497,874,864],{}," for an unroutable record. Successful new paid-order and subscription stores dispatch ",[497,877,878],{},"OrderWasCreatedFromWebhook"," and ",[497,881,882],{},"SubscriptionWasCreatedFromWebhook",". Updates do not dispatch those local-created events. This distinction is not a concurrency lock: enforce unique IDs and transactions in storage.",[493,885,886,887,889,890,893],{},"Partial updates use ",[497,888,864],{}," for no change. Persist cancellation reasons if your host needs them. Subscription resume uses ",[497,891,892],{},"clearEndsAt: true","; honor it in your writer.",[683,895,897],{"id":896},"events-your-app-handles","Events your app handles",[688,899,900,909],{},[691,901,902],{},[694,903,904,906],{},[697,905,699],{},[697,907,908],{},"Useful for",[704,910,911,925,938,954,964,972],{},[694,912,913,918],{},[709,914,915],{},[497,916,917],{},"subscription.update_scheduled",[709,919,920,921,924],{},"Showing a pending next-cycle change from the typed ",[497,922,923],{},"scheduledUpdate",". No current local plan change.",[694,926,927,932],{},[709,928,929],{},[497,930,931],{},"checkout.paid",[709,933,934,935,937],{},"Checkout analytics or handoff. Use ",[497,936,713],{}," for full order persistence.",[694,939,940,951],{},[709,941,942,792,945,792,948],{},[497,943,944],{},"checkout.failed",[497,946,947],{},"checkout.canceled",[497,949,950],{},"checkout.expired",[709,952,953],{},"Retry and abandoned-cart flows.",[694,955,956,961],{},[709,957,958],{},[497,959,960],{},"webhook.setup",[709,962,963],{},"Endpoint setup verification; acknowledge with 2xx.",[694,965,966,969],{},[709,967,968],{},"Product update, approval, rejection, archive, and unarchive events",[709,970,971],{},"Catalog notifications; no built-in storage.",[694,973,974,977],{},[709,975,976],{},"Unknown event names",[709,978,979,982],{},[497,980,981],{},"UnsupportedWebhookReceived",", so you can observe new events without inventing a handler.",[493,984,985],{},"Refund and chargeback events still dispatch when their optional repositories are absent. Checkout events do not create local orders or bindings on their own. Anonymous checkout events may have no customer ID yet.",[683,987,989],{"id":988},"money-and-snapshots","Money and snapshots",[493,991,992,993,996,997,1000,1001,1004,1005,1008,1009,1012],{},"Typed event classes are owned by ",[497,994,995],{},"vatly-api-php"," in ",[497,998,999],{},"Vatly\\API\\Webhooks\\Events",". Money-bearing events use ",[497,1002,1003],{},"Money",", not integer amounts. For paid orders and refunds, read currency from ",[497,1006,1007],{},"total->currency","; use ",[497,1010,1011],{},"total->toCents()"," for local integer cents. Chargeback amounts are nullable at the event contract level and retain a separate currency field.",[493,1014,1015,1016,1019],{},"Fluent builds events from the signed resource snapshot without a follow-up GET. Its reactions flatten money to integer cents in persistence DTOs. They do not save subscription prices or build entitlement policy for you. Reversal totals are read live through the ",[679,1017,1018],{"href":181},"order handle",", not synthesized into order statuses.",[493,1021,1022,1023,1025,1026,1031],{},"See ",[679,1024,199],{"href":200}," for routing initial payments and renewals, and the ",[679,1027,334],{"href":1028,"rel":1029},"https:\u002F\u002Fdocs.vatly.com\u002Fapi-reference",[1030],"nofollow"," for complete payload fields.",[1033,1034,1035],"style",{},"html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-defau