95,1596,1598,1599,1601,1602,450],{},[489,1581,1582],{},"\"store if new, else update\""," - every entity reaction first calls ",[427,1585,1586],{},"findByVatlyId()",". A null return routes to ",[427,1589,1590],{},"store()","; a hit routes to ",[427,1593,1594],{},"update()",". This is the idempotency hinge: once ",[427,1597,1590],{}," writes the Vatly id back, webhook re-deliveries safely hit ",[427,1600,1594],{},". See the ",[432,1603,1604],{"href":169},"host-owns-its-tables recipe",[763,1606,1607,1610,1611,1613,1614,496,1616,496,1618,496,1620,1622],{},[489,1608,1609],{},"\"find-or-skip\""," - the reaction only ",[427,1612,1594],{},"s an existing local record and never creates one (",[427,1615,824],{},[427,1617,784],{},[427,1619,787],{},[427,1621,1264],{},").",[763,1624,1625,1629,1630,1065,1633,1636,1637,1639,1640,1643],{},[489,1626,1627],{},[427,1628,935],{}," - resolved from your ",[427,1631,1632],{},"CustomerBindingRepository",[475,1634,1635],{},"before"," the reaction calls your writer, so ",[427,1638,1590],{}," can fill the owner column directly. It's ",[427,1641,1642],{},"null"," for unattributed \u002F anonymous-checkout rows; accept that.",[763,1645,1646,1651,1652,1654,1655,1658,1659,1661,1662,1665,1666,682,1668,1670,1671,520,1673,682,1675,1677,1678,682,1680,1682,1683,1685,1686,1688,1689,588,1692,1694,1695,450],{},[489,1647,1648,1650],{},[427,1649,857],{}," is persistable"," - when a cancellation ends the subscription, ",[427,1653,1303],{}," passes the raw Vatly reason on ",[427,1656,1657],{},"UpdateSubscriptionData"," alongside ",[427,1660,1285],{},"; persist it if your host tracks ",[475,1663,1664],{},"why"," a subscription ended. All three cancel events carry one: ",[427,1667,1318],{},[427,1669,1293],{},"), ",[427,1672,1348],{},[427,1674,1318],{},[427,1676,1325],{},"), and ",[427,1679,1037],{},[427,1681,833],{},"). ",[427,1684,1642],{}," means \"no change\" (don't overwrite a stored reason). ",[427,1687,1017],{}," does the same for orders on ",[427,1690,1691],{},"UpdateOrderData",[427,1693,1037],{}," when payment recovery for the unpaid order was exhausted, otherwise ",[427,1696,1642],{},[763,1698,1699,1704,1705,496,1708,496,1711,654,1714,1065,1717,1719,1720,1722],{},[489,1700,1701,1702],{},"store may return ",[427,1703,1642],{}," - ",[427,1706,1707],{},"OrderWriter",[427,1709,1710],{},"SubscriptionWriter",[427,1712,1713],{},"RefundWriter",[427,1715,1716],{},"ChargebackWriter",[427,1718,1590],{}," may return ",[427,1721,1642],{}," when the driver can't route the data. Built-in reactions tolerate it.",[763,1724,1725,1728,1729,1732],{},[489,1726,1727],{},"opt-in reactions"," register only when their repository is wired into ",[427,1730,1731],{},"Wiring",". Without it, the typed events still dispatch for you to handle yourself.",[763,1734,1735,1738,1739,1742,1743,520,1746,520,1749,520,1752,520,1755,1758,1759,1761,1762,1765],{},[489,1736,1737],{},"order reversal progress is not a webhook reaction."," Whether - and how much of - an order was returned to the customer (by refund ",[475,1740,1741],{},"or"," chargeback) is read from the live API Order via ",[427,1744,1745],{},"OrderHandle::reversedSubtotal()",[427,1747,1748],{},"refundableSubtotal()",[427,1750,1751],{},"isReversed()",[427,1753,1754],{},"isPartiallyReversed()",[427,1756,1757],{},"isFullyReversed()",". The order's own ",[427,1760,1027],{}," stays terminal ",[427,1763,1764],{},"paid","; fluent never synthesizes a local refunded\u002Fchargeback status.",{"title":1767,"searchDepth":1768,"depth":1768,"links":1769},"",2,[1770,1771,1772],{"id":732,"depth":1768,"text":733},{"id":869,"depth":1768,"text":870},{"id":1574,"depth":1768,"text":1575},"Vatly PHP Fluent - Webhook event flow","md",null,{},true,{"title":172,"description":1773},"5p8_TUEBMNDew08zxiDebnvvMDiIceTLCQVXkKf78LA",[1781,1783],{"title":168,"path":169,"stem":170,"description":1782,"children":-1},"Vatly PHP Fluent - Adapting to your framework",{"title":128,"path":181,"stem":182,"description":1784,"children"