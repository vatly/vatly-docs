,{},"docs\u002F"," sync to ",[437,438,442],"a",{"href":439,"rel":440},"https:\u002F\u002Fdocs.vatly.com\u002Fpackages\u002Ffluent-php\u002Fwebhook-flow",[441],"nofollow","Vatly Docs"," on pushes to ",[432,445,446],{},"main",". The notifier uses the Actions secret ",[432,449,450],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to ",[432,453,454],{},"vatly\u002Fvatly-docs",".",[428,457,458,459,462,463,466,467,470,471,474,475,478,479,487],{},"A driver author shouldn't have to read several directories (the event DTOs and the ",[432,460,461],{},"WebhookEventFactory"," in ",[432,464,465],{},"vatly-api-php","'s ",[432,468,469],{},"Vatly\\API\\Webhooks\\*",", plus fluent's ",[432,472,473],{},"src\u002FWebhooks\u002FReactions\u002F"," and ",[432,476,477],{},"src\u002FContracts\u002F",") to answer ",[480,481,482,483,486],"em",{},"\"if I implement ",[432,484,485],{},"OrderWriter::store",", which webhooks flow into it and with what data?\""," This page is that single reference.",[489,490,491],"blockquote",{},[428,492,493,497,498,501,502,501,505,508,509,513,514,517,518,521,522,525,526,525,529,532,533,536,537,540,541,544,545,548,549,552,553,548,556,559,560,563,564,567,568,571,572,575,576,525,579,525,582,585,586,588,589,593,594,597,598,601],{},[494,495,496],"strong",{},"Where the event DTOs live:"," the typed webhook events (",[432,499,500],{},"OrderPaid",", ",[432,503,504],{},"OrderPaymentFailed",[432,506,507],{},"SubscriptionStarted",", …) are owned by ",[494,510,511],{},[432,512,465],{}," under ",[432,515,516],{},"Vatly\\API\\Webhooks\\Events\\*"," and consumed by fluent - fluent no longer ships its own ",[432,519,520],{},"src\u002FEvents\u002F"," copies (only the driver-side ",[432,523,524],{},"SubscriptionWasCreatedFromWebhook"," \u002F ",[432,527,528],{},"OrderWasCreatedFromWebhook",[432,530,531],{},"NullEventDispatcher"," remain in ",[432,534,535],{},"Vatly\\Fluent\\Events\\","). Their ",[432,538,539],{},"taxSummary"," field is a ",[432,542,543],{},"Vatly\\API\\Types\\TaxSummaryCollection"," whose items expose ",[432,546,547],{},"taxRate"," (a ",[432,550,551],{},"TaxSummaryRate",") + ",[432,554,555],{},"amount",[432,557,558],{},"Money","); call ",[432,561,562],{},"$item->amount->toCents()"," for integer cents. Order lines are ",[432,565,566],{},"Vatly\\API\\Types\\OrderLineData[]"," (note: ",[432,569,570],{},"Vatly\\API\\Types\\",", not the old ",[432,573,574],{},"Vatly\\API\\Data\\","), and each line's ",[432,577,578],{},"basePrice",[432,580,581],{},"total",[432,583,584],{},"subtotal"," are likewise ",[432,587,558],{},". The event construction - verify → parse → map - is owned by ",[494,590,591],{},[432,592,465],{},": ",[432,595,596],{},"Vatly\\API\\Webhooks\\WebhookEventFactory"," builds the typed events from the signed payload. Fluent owns the downstream orchestration (the reactions and ",[432,599,600],{},"WebhookProcessor",", which records → reacts → dispatches) and consumes that factory.",[489,603,604],{},[428,605,606,616,617,525,619,621,622,625,626,629,630,633,634,637,638,641,642,648,649,501,651,501,653,501,656,659,660,663,664,525,666,668,669,671,672,525,675,678,679,525,681,683,684,687,688,691,692,695,696,698,699,702,703,525,706,709,710,525,712,714,715,717],{},[494,607,608,609,611,612,615],{},"Event money is ",[432,610,558],{},", not int cents (api-php ≥ ",[432,613,614],{},"0.1.0-alpha.18","):"," the ",[432,618,581],{},[432,620,584],{}," fields on the money-bearing events are ",[432,623,624],{},"Vatly\\API\\Types\\Money"," value objects (decimal-string ",[432,627,628],{},"value"," + ",[432,631,632],{},"currency","), not raw integer cents. Read the currency off the Money (",[432,635,636],{},"$event->total->currency",") and flatten to integer cents with ",[432,639,640],{},"$event->total->toCents()",". The ",[494,643,644,645,647],{},"standalone ",[432,646,632],{}," field was removed"," from ",[432,650,500],{},[432,652,504],{},[432,654,655],{},"RefundCompleted",[432,657,658],{},"RefundFailed",", and ",[432,661,662],{},"RefundCanceled"," (their ",[432,665,581],{},[432,667,584],{}," are non-null ",[432,670,558],{},"). The chargeback events ",[432,673,674],{},"OrderChargebackReceived",[432,676,677],{},"OrderChargebackReversed"," are the exception: their ",[432,680,581],{},[432,682,584],{}," are typed ",[494,685,686],{},"nullable"," (",[432,689,690],{},"?Money",") at the api-php contract level and they ",[494,693,694],{},"keep"," a standalone ",[432,697,632],{}," string - though the fat chargeback payload populates the amounts in practice. Fluent's built-in reactions flatten ",[432,700,701],{},"Money → int"," at the persistence edge, so the driver-facing ",[432,704,705],{},"Store*Data",[432,707,708],{},"Update*Data"," DTOs still carry integer-cents ",[432,711,581],{},[432,713,584],{}," and a ",[432,716,632],{}," string - drivers are unaffected.",[428,719,720,721,726,727,730,731,733],{},"The ",[437,722,725],{"href":723,"rel":724},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluent-php\u002Fblob\u002Fmain\u002FREADME.md#webhook-pipeline-at-a-glance",[441],"README's \"Webhook pipeline at a glance\""," table is the quick version; this one adds the ",[494,728,729],{},"fields drivers care about"," column so you know exactly what each ",[432,732,705],{}," \u002F event carries.",[735,736,738],"h2",{"id":737},"how-events-are-built-no-api-round-trip","How events are built (no API round-trip)",[428,740,741,742,745,746,749,750,753,754,756,757,760,761,763],{},"Vatly sends ",[494,743,744],{},"fat, HMAC-signed"," webhook deliveries: the payload's ",[432,747,748],{},"object"," is the full resource - byte-identical to the corresponding ",[432,751,752],{},"GET \u002F…\u002F{id}"," body (subtotal, the complete tax summary, lines, mandate). The HMAC signature (verified in ",[432,755,600],{},") is the trust boundary, so the payload is the authoritative snapshot and there is ",[494,758,759],{},"no follow-up API GET to \"enrich\"",". The mapping below is performed by api-php's ",[432,762,596],{},":",[765,766,767,823],"ul",{},[768,769,770,793,794,525,797,525,800,525,803,806,807,810,811,814,815,818,819,822],"li",{},[494,771,772,501,775,501,778,501,781,501,784,501,787,501,790],{},[432,773,774],{},"order.paid",[432,776,777],{},"order.payment_failed",[432,779,780],{},"refund.*",[432,782,783],{},"order.chargeback_*",[432,785,786],{},"subscription.started",[432,788,789],{},"subscription.billing_updated",[432,791,792],{},"subscription.updated"," - the matching api-php Resource (",[432,795,796],{},"Order",[432,798,799],{},"Refund",[432,801,802],{},"Chargeback",[432,804,805],{},"Subscription",") is hydrated in memory from ",[432,808,809],{},"$webhook->object"," (via ",[432,812,813],{},"ResourceFactory::createResourceFromApiResult()",", the same path the API client uses to build a resource from a ",[432,816,817],{},"GET"," response), then mapped through the event's ",[432,820,821],{},"fromApi*"," constructor. Same enriched event - full tax breakdown, lines, mandate, dispute status - with zero network call.",[768,824,825,845,846,848,849,852,853,856,857,859,860,863],{},[494,826,827,501,830,501,833,501,836,501,839,501,842],{},[432,828,829],{},"order.canceled",[432,831,832],{},"checkout.*",[432,834,835],{},"subscription.cancellation_grace_period_completed",[432,837,838],{},"subscription.canceled_for_nonpayment",[432,840,841],{},"subscription.update_scheduled",[432,843,844],{},"webhook.setup"," - built straight from the payload envelope; they carry no money\u002Ftax resource to hydrate. (",[432,847,841],{}," exposes the envelope's ",[432,850,851],{},"object.scheduledUpdate"," as a typed ",[432,854,855],{},"ScheduledSubscriptionUpdate","; ",[432,858,838],{}," exposes ",[432,861,862],{},"cancellationReason",".)",[428,865,866,867,474,869,871],{},"Because nothing depends on a live API call, a transient API error can never block a delivery, and all events (including ",[432,868,780],{},[432,870,783],{},") are always supported regardless of which optional repositories are wired.",[73