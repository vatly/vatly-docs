5],{},"VATLY_DOCS_DISPATCH_TOKEN"," with Contents: write access to ",[427,448,449],{},"vatly\u002Fvatly-docs",".",[423,452,453,454,457,458,461,462,465,466,469,470,473,474,482],{},"A driver author shouldn't have to read several directories (the event DTOs and the ",[427,455,456],{},"WebhookEventFactory"," in ",[427,459,460],{},"vatly-api-php","'s ",[427,463,464],{},"Vatly\\API\\Webhooks\\*",", plus fluent's ",[427,467,468],{},"src\u002FWebhooks\u002FReactions\u002F"," and ",[427,471,472],{},"src\u002FContracts\u002F",") to answer ",[475,476,477,478,481],"em",{},"\"if I implement ",[427,479,480],{},"OrderWriter::store",", which webhooks flow into it and with what data?\""," This page is that single reference.",[484,485,486],"blockquote",{},[423,487,488,492,493,496,497,496,500,503,504,508,509,512,513,516,517,520,521,520,524,527,528,531,532,535,536,539,540,543,544,547,548,543,551,554,555,558,559,562,563,566,567,570,571,520,574,520,577,580,581,583,584,588,589,592,593,596],{},[489,490,491],"strong",{},"Where the event DTOs live:"," the typed webhook events (",[427,494,495],{},"OrderPaid",", ",[427,498,499],{},"OrderPaymentFailed",[427,501,502],{},"SubscriptionStarted",", …) are owned by ",[489,505,506],{},[427,507,460],{}," under ",[427,510,511],{},"Vatly\\API\\Webhooks\\Events\\*"," and consumed by fluent - fluent no longer ships its own ",[427,514,515],{},"src\u002FEvents\u002F"," copies (only the driver-side ",[427,518,519],{},"SubscriptionWasCreatedFromWebhook"," \u002F ",[427,522,523],{},"OrderWasCreatedFromWebhook",[427,525,526],{},"NullEventDispatcher"," remain in ",[427,529,530],{},"Vatly\\Fluent\\Events\\","). Their ",[427,533,534],{},"taxSummary"," field is a ",[427,537,538],{},"Vatly\\API\\Types\\TaxSummaryCollection"," whose items expose ",[427,541,542],{},"taxRate"," (a ",[427,545,546],{},"TaxSummaryRate",") + ",[427,549,550],{},"amount",[427,552,553],{},"Money","); call ",[427,556,557],{},"$item->amount->toCents()"," for integer cents. Order lines are ",[427,560,561],{},"Vatly\\API\\Types\\OrderLineData[]"," (note: ",[427,564,565],{},"Vatly\\API\\Types\\",", not the old ",[427,568,569],{},"Vatly\\API\\Data\\","), and each line's ",[427,572,573],{},"basePrice",[427,575,576],{},"total",[427,578,579],{},"subtotal"," are likewise ",[427,582,553],{},". The event construction - verify → parse → map - is owned by ",[489,585,586],{},[427,587,460],{},": ",[427,590,591],{},"Vatly\\API\\Webhooks\\WebhookEventFactory"," builds the typed events from the signed payload. Fluent owns the downstream orchestration (the reactions and ",[427,594,595],{},"WebhookProcessor",", which records → reacts → dispatches) and consumes that factory.",[484,598,599],{},[423,600,601,611,612,520,614,616,617,620,621,624,625,628,629,632,633,636,637,643,644,496,646,496,648,496,651,654,655,658,659,520,661,663,664,666,667,520,670,673,674,520,676,678,679,682,683,686,687,690,691,693,694,697,698,520,701,704,705,520,707,709,710,712],{},[489,602,603,604,606,607,610],{},"Event money is ",[427,605,553],{},", not int cents (api-php ≥ ",[427,608,609],{},"0.1.0-alpha.18","):"," the ",[427,613,576],{},[427,615,579],{}," fields on the money-bearing events are ",[427,618,619],{},"Vatly\\API\\Types\\Money"," value objects (decimal-string ",[427,622,623],{},"value"," + ",[427,626,627],{},"currency","), not raw integer cents. Read the currency off the Money (",[427,630,631],{},"$event->total->currency",") and flatten to integer cents with ",[427,634,635],{},"$event->total->toCents()",". The ",[489,638,639,640,642],{},"standalone ",[427,641,627],{}," field was removed"," from ",[427,645,495],{},[427,647,499],{},[427,649,650],{},"RefundCompleted",[427,652,653],{},"RefundFailed",", and ",[427,656,657],{},"RefundCanceled"," (their ",[427,660,576],{},[427,662,579],{}," are non-null ",[427,665,553],{},"). The chargeback events ",[427,668,669],{},"OrderChargebackReceived",[427,671,672],{},"OrderChargebackReversed"," are the exception: their ",[427,675,576],{},[427,677,579],{}," are typed ",[489,680,681],{},"nullable"," (",[427,684,685],{},"?Money",") at the api-php contract level and they ",[489,688,689],{},"keep"," a standalone ",[427,692,627],{}," string - though the fat chargeback payload populates the amounts in practice. Fluent's built-in reactions flatten ",[427,695,696],{},"Money → int"," at the persistence edge, so the driver-facing ",[427,699,700],{},"Store*Data",[427,702,703],{},"Update*Data"," DTOs still carry integer-cents ",[427,706,576],{},[427,708,579],{}," and a ",[427,711,627],{}," string - drivers are unaffected.",[423,714,715,716,721,722,725,726,728],{},"The ",[432,717,720],{"href":718,"rel":719},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluent-php\u002Fblob\u002Fmain\u002FREADME.md#webhook-pipeline-at-a-glance",[436],"README's \"Webhook pipeline at a glance\""," table is the quick version; this one adds the ",[489,723,724],{},"fields drivers care about"," column so you know exactly what each ",[427,727,700],{}," \u002F event carries.",[730,731,733],"h2",{"id":732},"how-events-are-built-no-api-round-trip","How events are built (no API round-trip)",[423,735,736,737,740,741,744,745,748,749,751,752,755,756,758],{},"Vatly sends ",[489,738,739],{},"fat, HMAC-signed"," webhook deliveries: the payload's ",[427,742,743],{},"object"," is the full resource - byte-identical to the corresponding ",[427,746,747],{},"GET \u002F…\u002F{id}"," body (subtotal, the complete tax summary, lines, mandate). The HMAC signature (verified in ",[427,750,595],{},") is the trust boundary, so the payload is the authoritative snapshot and there is ",[489,753,754],{},"no follow-up API GET to \"enrich\"",". The mapping below is performed by api-php's ",[427,757,591],{},":",[760,761,762,818],"ul",{},[763,764,765,788,789,520,792,520,795,520,798,801,802,805,806,809,810,813,814,817],"li",{},[489,766,767,496,770,496,773,496,776,496,779,496,782,496,785],{},[427,768,769],{},"order.paid",[427,771,772],{},"order.payment_failed",[427,774,775],{},"refund.*",[427,777,778],{},"order.chargeback_*",[427,780,781],{},"subscription.started",[427,783,784],{},"subscription.billing_updated",[427,786,787],{},"subscription.updated"," - the matching api-php Resource (",[427,790,791],{},"Order",[427,793,794],{},"Refund",[427,796,797],{},"Chargeback",[427,799,800],{},"Subscription",") is hydrated in memory from ",[427,803,804],{},"$webhook->object"," (via ",[427,807,808],{},"ResourceFactory::createResourceFromApiResult()",", the same path the API client uses to build a resource from a ",[427,811,812],{},"GET"," response), then mapped through the event's ",[427,815,816],{},"fromApi*"," constructor. Same enriched event - full tax breakdown, lines, mandate, dispute status - with zero network call.",[763,819,820,840,841,843,844,847,848,851,852,854,855,858],{},[489,821,822,496,825,496,828,496,831,496,834,496,837],{},[427,823,824],{},"order.canceled",[427,826,827],{},"checkout.*",[427,829,830],{},"subscription.cancellation_grace_period_completed",[427,832,833],{},"subscription.canceled_for_nonpayment",[427,835,836],{},"subscription.update_scheduled",[427,838,839],{},"webhook.setup"," - built straight from the payload envelope; they carry no money\u002Ftax resource to hydrate. (",[427,842,836],{}," exposes the envelope's ",[427,845,846],{},"object.scheduledUpdate"," as a typed ",[427,849,850],{},"ScheduledSubscriptionUpdate","; ",[427,853,833],{}," exposes ",[427,856,857],{},"cancellationReason",".)",[423,860,861,862,469,864,866],{},"Because nothing depends on a live API call, a transient API error can never block a delivery, and all events (including ",[427,863,775],{},[427,865,778],{},") are always supported regardless of which optional repositories are wired.",[730,868,870],{"id":869},"full-matrix","Full matrix",[872,873,874,896],"table",{},[875,876,877],"thead",{},[878,879,880,884,887,890,893],"tr",{},[881,882,883],"th",{},"Vatly event",[881,885,886],{},"Typed event",[881,888,889],{},"Built-in reaction",[881,891,892],{},"Repo method c