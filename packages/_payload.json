.1.0a2",".",[426,666,667,668,673],{},"PHP Fluent currently has two in-depth guides, not a complete getting-started section. Follow its ",[467,669,672],{"href":670,"rel":671},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluent-php#readme",[471],"README"," for setup.",[426,675,676,677,680],{},"Not using one of these languages? You can use the ",[467,678,679],{"href":39},"REST API directly"," with any HTTP client.",{"title":682,"searchDepth":683,"depth":683,"links":684},"",2,[685],{"id":435,"depth":683,"text":436},"Official Vatly SDKs and fluent packages for PHP, Laravel, JavaScript, Python and Django. Installation, package registries and documentation.","md",null,{},true,{"title":116,"description":686},"twoEA2H3j4U3VcOh5Ekzdk2_Le1-27Yc54bgXdqRd20",[694,696],{"title":112,"path":113,"stem":114,"description":695,"children":-1},"Inspect individual webhook events and retrieve the full payload that was delivered by Vatly.",{"title":128,"path":129,"stem":130,"description":697,"children":-1},"Vatly PHP SDK - Getting Started",1794487920538]