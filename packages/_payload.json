655,656],{},"vatly",", ",[490,659,660],{},"vatly_fluent",", and ",[490,663,664],{},"vatly_django",", respectively. For example, pin the SDK with ",[490,667,668],{},"pip install vatly-api-python==0.1.0a2",".",[431,671,672,673,678],{},"PHP Fluent currently has two in-depth guides, not a complete getting-started section. Follow its ",[472,674,677],{"href":675,"rel":676},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluent-php#readme",[476],"README"," for setup.",[431,680,681,682,685],{},"Not using one of these languages? You can use the ",[472,683,684],{"href":39},"REST API directly"," with any HTTP client.",{"title":687,"searchDepth":688,"depth":688,"links":689},"",2,[690],{"id":440,"depth":688,"text":441},"Official Vatly SDKs and fluent packages for PHP, Laravel, JavaScript, Python and Django. Installation, package registries and documentation.","md",null,{},true,{"title":116,"description":691},"twoEA2H3j4U3VcOh5Ekzdk2_Le1-27Yc54bgXdqRd20",[699,701],{"title":112,"path":113,"stem":114,"description":700,"children":-1},"Inspect individual webhook events and retrieve the full payload that was delivered by Vatly.",{"title":128,"path":129,"stem":130,"description":702,"children":-1},"Vatly PHP SDK - Getting Started",1794487817984]