477,"stem":478,"children":479},"Integrations","\u002Fintegrations","4.integrations",[480,482,486],{"title":476,"path":477,"stem":481},"4.integrations\u002Findex",{"title":483,"path":484,"stem":485},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":487,"path":488,"stem":489},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":491,"title":492,"body":493,"description":864,"extension":865,"links":866,"meta":867,"navigation":868,"path":187,"seo":869,"stem":188,"__hash__":870},"docs\u002F3.packages\u002F11.pmpro\u002F00.readme.md","Paid Memberships Pro",{"type":494,"value":495,"toc":850},"minimark",[496,500,508,513,550,554,580,583,586,605,610,617,670,677,681,748,751,755,764,767,776,779,786,790,801,813,816,820,823,826,830,833,837,846],[497,498,499],"p",{},"Sell Paid Memberships Pro (PMPro) memberships through Vatly. Vatly is the European Merchant of Record for AI, software and digital products: it is the legal seller on every sale and handles payments, tax and compliance.\nThis plugin adds Vatly as a payment gateway to PMPro.",[501,502,503,507],"warning",{},[504,505,506],"strong",{},"Alpha."," The plugin can still change in ways that need you to update your setup. Try it in Vatly test mode before you take live payments with it.",[509,510,512],"h2",{"id":511},"what-it-does","What it does",[514,515,516,523,538,544],"ul",{},[517,518,519,522],"li",{},[504,520,521],{},"Hosted checkout."," Members pay at Vatly's hosted checkout (cards, PayPal, iDEAL, Apple Pay, SEPA).",[517,524,525,528,529,533,534,537],{},[504,526,527],{},"VAT handled for you."," Vatly collects VAT per country, applies the right rate on every renewal, and issues compliant invoices as the seller. You no longer need the ",[530,531,532],"code",{},"pmpro-vat-tax"," add-on or ",[530,535,536],{},"pmpro_tax"," filter snippets.",[517,539,540,543],{},[504,541,542],{},"Membership sync."," Webhooks keep PMPro in step: levels are assigned on payment, changed when a member switches plan, and revoked on cancellation.",[517,545,546,549],{},[504,547,548],{},"PMPro keeps the rest."," Membership levels, content gating, member dashboards and discount codes work as before.",[509,551,553],{"id":552},"requirements","Requirements",[514,555,556,559,562,571],{},[517,557,558],{},"WordPress 6.5 or newer",[517,560,561],{},"PHP 8.1 or newer",[517,563,564,570],{},[565,566,492],"a",{"href":567,"rel":568},"https:\u002F\u002Fwordpress.org\u002Fplugins\u002Fpaid-memberships-pro\u002F",[569],"nofollow"," 3.x, installed and active",[517,572,573,574,579],{},"A ",[565,575,578],{"href":576,"rel":577},"https:\u002F\u002Fvatly.com",[569],"Vatly"," account",[509,581,442],{"id":582},"installation",[497,584,585],{},"The plugin is not on WordPress.org. Install it from GitHub:",[587,588,589,598],"ol",{},[517,590,591,592,597],{},"Download the zip from the ",[565,593,596],{"href":594,"rel":595},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-pmpro\u002Freleases\u002Flatest",[569],"latest release",". It includes the plugin's dependencies, so you don't need Composer.",[517,599,600,601,604],{},"In WordPress, go to ",[504,602,603],{},"Plugins → Add New → Upload Plugin",", choose the zip, and activate it.",[606,607,609],"h3",{"id":608},"with-composer","With Composer",[497,611,612,613,616],{},"If your site manages its plugins with Composer, such as a Bedrock site with ",[530,614,615],{},"composer\u002Finstallers",", require the plugin from Packagist instead. Its dependencies are alpha releases, so allow alpha packages first:",[618,619,624],"pre",{"className":620,"code":621,"language":622,"meta":623,"style":623},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","composer config minimum-stability alpha\ncomposer config prefer-stable true\ncomposer require vatly\u002Fvatly-pmpro\n","bash","",[530,625,626,645,659],{"__ignoreMap":623},[627,628,631,635,639,642],"span",{"class":629,"line":630},"line",1,[627,632,634],{"class":633},"sBMFI","composer",[627,636,638],{"class":637},"sfazB"," config",[627,640,641],{"class":637}," minimum-stability",[627,643,644],{"class":637}," alpha\n",[627,646,648,650,652,655],{"class":629,"line":647},2,[627,649,634],{"class":633},[627,651,638],{"class":637},[627,653,654],{"class":637}," prefer-stable",[627,656,658],{"class":657},"sMK4o"," true\n",[627,660,662,664,667],{"class":629,"line":661},3,[627,663,634],{"class":633},[627,665,666],{"class":637}," require",[627,668,669],{"class":637}," vatly\u002Fvatly-pmpro\n",[497,671,672,673,676],{},"The plugin installs as ",[530,674,675],{},"vatly-gateway-for-paid-memberships-pro"," in your plugins directory, the same name the zip uses, so you can switch between the two. Its dependencies load through your site's Composer autoloader, which Bedrock includes. Then activate the plugin in WordPress.",[509,678,680],{"id":679},"setup","Setup",[587,682,683,712,734],{},[517,684,685,688,689,692,693,695,696,699,700,703,704,707,708,711],{},[504,686,687],{},"Add your credentials."," Go to ",[504,690,691],{},"Memberships → Settings → Payments"," and open the ",[504,694,578],{}," gateway. Enter your ",[504,697,698],{},"Live API key",", ",[504,701,702],{},"Test API key"," and ",[504,705,706],{},"Webhook signing secret"," from the ",[504,709,710],{},"Developers"," section of your Vatly dashboard, and save.",[517,713,714,717,718,726,729,730,733],{},[504,715,716],{},"Register the webhook in Vatly."," The settings screen shows your webhook URL:",[618,719,724],{"className":720,"code":722,"language":723,"meta":623},[721],"language-text","https:\u002F\u002Fyour-site.com\u002Fwp-json\u002Fvatly\u002Fv1\u002Fwebhook\n","text",[530,725,722],{"__ignoreMap":623},[727,728],"br",{},"Paste it into your Vatly dashboard under ",[504,731,732],{},"Developers → Webhooks",", using the signing secret you entered above.",[517,735,736,739,740,743,744,747],{},[504,737,738],{},"Map each membership level to a Vatly plan."," Edit each membership level you want billed through Vatly and paste the matching plan ID from ",[504,741,742],{},"Manage Products"," in your Vatly dashboard into the ",[504,745,746],{},"Vatly plan ID"," field.",[497,749,750],{},"Members pay the price of the Vatly plan, not the PMPro level price, so set both to the same amount. Selling to consumers? Create the plan as tax-inclusive, so buyers pay exactly the price you show and the VAT comes out of it. Tax-exclusive plans add VAT at checkout, so show those prices as \"excl. VAT\".",[509,752,754],{"id":753},"switching-from-another-gateway-or-the-vat-add-on","Switching from another gateway or the VAT add-on",[497,756,757,758,760,761,763],{},"Map every level to a Vatly plan first, then select ",[504,759,578],{}," as the gateway under ",[504,762,691],{},". Members who subscribed through your previous gateway stay billed there, so leave that gateway's webhook in place for their renewals.",[497,765,766],{},"You can keep offering a second gateway next to Vatly with an add-on such as Pay by Check. The checkout shows the button and fields of the gateway the member picks.",[497,768,769,770,775],{},"The ",[565,771,774],{"href":772,"rel":773},"https:\u002F\u002Fwww.paidmembershipspro.com\u002Fadd-ons\u002Fvat-tax\u002F",[569],"VAT Tax add-on"," can stay active. Vatly works out the member's country, checks VAT numbers and charges VAT on its own checkout, so on checkouts paid with Vatly the add-on's country and VAT number fields, its checks, its tax and its price note are skipped. Checkouts with your other gateways still use the add-on. If Vatly is your only gateway, you can deactivate the add-on; the plugin shows a reminder while it is active.",[509,777,54],{"id":778},"webhooks",[497,780,781,782,785],{},"Webhooks are refused until a webhook signing secret is saved. Until then the endpoint answers ",[530,783,784],{},"503"," and processes nothing; Vatly retries the delivery once the secret is saved. The endpoint is only registered while Paid Memberships Pro is active.",[509,787,789],{"id":788},"saved-keys-and-secrets","Saved keys and secrets",[497,791,792,793,796,797,800],{},"The API keys and webhook signing secret are stored encrypted, keyed from your WordPress salts or a ",[530,794,795],{},"VATLY_PMPRO_ENCRYPTION_KEY"," constant in ",[530,798,799],{},"wp-config.php",". The settings screen never shows saved values:",[514,802,803,806],{},[517,804,805],{},"Leave a field blank to keep its saved value.",[517,807,808,809,812],{},"Tick ",[504,810,811],{},"Remove saved value"," to delete it.",[497,814,815],{},"If the WordPress salts or the encryption key change, enter the API keys and webhook secret again.",[509,817,819],{"id":818},"invoices-and-credit-notes","Invoices and credit notes",[497,821,822],{},"Vatly issues the VAT invoice and, for refunds, the credit note. Links to them appear on the checkout confirmation page, on the member's order (invoice) page, and on the admin order screen. The links are fetched fresh from Vatly when shown and never stored.",[497,824,825],{},"A completed refund marks the PMPro order as refunded and keeps the membership.",[509,827,829],{"id":828},"cancellations","Cancellations",[497,831,832],{},"Cancelling a membership in WordPress cancels the subscription at Vatly, so renewals stop being charged.",[509,834,836],{"id":835},"support","Support",[497,838,839,840,845],{},"The source and issue tracker are on ",[565,841,844],{"href":842,"rel":843},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-pmpro",[569],"GitHub",".",[847,848,849],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":623,"searchDepth":647,"depth":647,"links":851},[852,853,854,857,858,859,860,861,862,863],{"id":511,"depth":647,"text":512},{"id":552,"depth":647,"text":553},{"id":582,"depth":647,"text":442,"children":855},[856],{"id":608,"depth":661,"text":609},{"id":679,"depth":647,"text":680},{"id":753,"depth":647,"text":754},{"id":778,"depth":647,"text":54},{"id":788,"depth":647,"text":789},{"id":818,"depth":647,"text":819},{"id":828,"depth":647,"text":829},{"id":835,"depth":647,"text":836},"Sell Paid Memberships Pro (PMPro) memberships through Vatly.","md",null,{},{"title":133},{"title":492,"description":864},"8k-N9CIs3JNM7y3siZONYCBoa__F5-GAahbEHC3hQC8",[872,874],{"title":178,"path":179,"stem":180,"description":873,"children":-1},"How the plugin makes Vatly the single source of truth for invoices on FluentCart orders, and the FluentCart integration points it relies on.",{"title":133,"path":195,"stem":196,"description":875,"children":-1},"Sell a download, start a subscription, and keep your app's billing records in step with Vatly.",1795620718545]