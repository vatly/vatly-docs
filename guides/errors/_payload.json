517,571,572,575],{},[520,573,574],{},"Code",[520,576,577],{},"Meaning",[527,579,580,590,600,610,620,630,640,650,660,674,684],{},[517,581,582,587],{},[532,583,584],{},[535,585,586],{},"200",[532,588,589],{},"OK - Request succeeded.",[517,591,592,597],{},[532,593,594],{},[535,595,596],{},"201",[532,598,599],{},"Created - Resource was successfully created.",[517,601,602,607],{},[532,603,604],{},[535,605,606],{},"204",[532,608,609],{},"No Content - Request succeeded with no response body (e.g., deletes).",[517,611,612,617],{},[532,613,614],{},[535,615,616],{},"400",[532,618,619],{},"Bad Request - The request was malformed.",[517,621,622,627],{},[532,623,624],{},[535,625,626],{},"401",[532,628,629],{},"Unauthorized - Invalid or missing API key.",[517,631,632,637],{},[532,633,634],{},[535,635,636],{},"403",[532,638,639],{},"Forbidden - The API key doesn't have permission for this action.",[517,641,642,647],{},[532,643,644],{},[535,645,646],{},"404",[532,648,649],{},"Not Found - The requested resource doesn't exist.",[517,651,652,657],{},[532,653,654],{},[535,655,656],{},"409",[532,658,659],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, a concurrent write, or a refund of the same order already being created.",[517,661,662,667],{},[532,663,664],{},[535,665,666],{},"422",[532,668,669,670,673],{},"Unprocessable Entity - Validation failed. Check the ",[535,671,672],{},"errors"," field for details.",[517,675,676,681],{},[532,677,678],{},[535,679,680],{},"429",[532,682,683],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[517,685,686,691],{},[532,687,688],{},[535,689,690],{},"500",[532,692,693],{},"Internal Server Error - Something went wrong on Vatly's end.",[500,695],{},[503,697,699],{"id":698},"error-responses","Error responses",[496,701,702],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[704,705,711],"pre",{"className":706,"code":707,"filename":708,"language":709,"meta":710,"style":710},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json","",[535,712,713,722,748],{"__ignoreMap":710},[714,715,718],"span",{"class":716,"line":717},"line",1,[714,719,721],{"class":720},"sMK4o","{\n",[714,723,725,728,732,735,738,741,745],{"class":716,"line":724},2,[714,726,727],{"class":720},"  \"",[714,729,731],{"class":730},"spNyl","message",[714,733,734],{"class":720},"\"",[714,736,737],{"class":720},":",[714,739,740],{"class":720}," \"",[714,742,744],{"class":743},"sfazB","Resource not found.",[714,746,747],{"class":720},"\"\n",[714,749,751],{"class":716,"line":750},3,[714,752,753],{"class":720},"}\n",[496,755,756,757,760,761,763],{},"Some errors also include an optional ",[535,758,759],{},"details"," object with structured context about the failure. Treat unknown keys as forward-compatible additions and branch on the HTTP status code rather than the shape of ",[535,762,759],{},".",[704,765,768],{"className":706,"code":766,"filename":767,"language":709,"meta":710,"style":710},"{\n  \"message\": \"The requested resource was not found.\",\n  \"details\": {\n    \"resource_type\": \"checkout\",\n    \"resource_id\": \"checkout_abc123\"\n  }\n}\n","Error response with details",[535,769,770,774,794,807,830,849,855],{"__ignoreMap":710},[714,771,772],{"class":716,"line":717},[714,773,721],{"class":720},[714,775,776,778,780,782,784,786,789,791],{"class":716,"line":724},[714,777,727],{"class":720},[714,779,731],{"class":730},[714,781,734],{"class":720},[714,783,737],{"class":720},[714,785,740],{"class":720},[714,787,788],{"class":743},"The requested resource was not found.",[714,790,734],{"class":720},[714,792,793],{"class":720},",\n",[714,795,796,798,800,802,804],{"class":