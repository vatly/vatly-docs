n",{"title":187,"path":188,"stem":189},"Migrating from Cashier","\u002Fpackages\u002Flaravel\u002Fmigrating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":191,"path":192,"stem":193},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":195,"path":196,"stem":197},"Integrations","\u002Fintegrations","4.integrations",{"id":199,"title":42,"body":200,"description":704,"extension":705,"links":706,"meta":707,"navigation":708,"path":43,"seo":709,"stem":44,"__hash__":710},"docs\u002F1.guides\u002F6.errors.md",{"type":201,"value":202,"toc":696},"minimark",[203,207,210,215,218,269,274,402,404,408,411,461,471,567,571,577,686,692],[204,205,206],"p",{},"You can tell if your request was successful by checking the status code in the API response. If a response is unsuccessful, use the HTTP status code and error message to understand what went wrong.",[208,209],"hr",{},[211,212,214],"h2",{"id":213},"status-codes","Status codes",[204,216,217],{},"Here is a list of the different categories of status codes returned by the Vatly API. Use these to understand if a request was successful.",[219,220,221,234],"table",{},[222,223,224],"thead",{},[225,226,227,231],"tr",{},[228,229,230],"th",{},"Status",[228,232,233],{},"Description",[235,236,237,249,259],"tbody",{},[225,238,239,246],{},[240,241,242],"td",{},[243,244,245],"code",{},"2xx",[240,247,248],{},"A 2xx status code indicates a successful response.",[225,250,251,256],{},[240,252,253],{},[243,254,255],{},"4xx",[240,257,258],{},"A 4xx status code indicates a client error. This means there's an issue with the request.",[225,260,261,266],{},[240,262,263],{},[243,264,265],{},"5xx",[240,267,268],{},"A 5xx status code indicates a server error. This means the issue is on Vatly's end and we are automatically notified of the problem.",[270,271,273],"h3",{"id":272},"common-status-codes","Common status codes",[219,275,276,286],{},[222,277,278],{},[225,279,280,283],{},[228,281,282],{},"Code",[228,284,285],{},"Meaning",[235,287,288,298,308,318,328,338,348,358,368,382,392],{},[225,289,290,295],{},[240,291,292],{},[243,293,294],{},"200",[240,296,297],{},"OK - Request succeeded.",[225,299,300,305],{},[240,301,302],{},[243,303,304],{},"201",[240,306,307],{},"Created - Resource was successfully created.",[225,309,310,315],{},[240,311,312],{},[243,313,314],{},"204",[240,316,317],{},"No Content - Request succeeded with no response body (e.g., deletes).",[225,319,320,325],{},[240,321,322],{},[243,323,324],{},"400",[240,326,327],{},"Bad Request - The request was malformed.",[225,329,330,335],{},[240,331,332],{},[243,333,334],{},"401",[240,336,337],{},"Unauthorized - Invalid or missing API key.",[225,339,340,345],{},[240,341,342],{},[243,343,344],{},"403",[240,346,347],{},"Forbidden - The API key doesn't have permission for this action.",[225,349,350,355],{},[240,351,352],{},[243,353,354],{},"404",[240,356,357],{},"Not Found - The requested resource doesn't exist.",[225,359,360,365],{},[240,361,362],{},[243,363,364],{},"409",[240,366,367],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, or a concurrent write.",[225,369,370,375],{},[240,371,372],{},[243,373,374],{},"422",[240,376,377,378,381],{},"Unprocessable Entity - Validation failed. Check the ",[243,379,380],{},"errors"," field for details.",[225,383,384,389],{},[240,385,386],{},[243,387,388],{},"429",[240,390,391],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[225,393,394,399],{},[240,395,396],{},[243,397,398],{},"500",[240,400,401],{},"Internal Server Error - Something went wrong on Vatly's end.",[208,403],{},[211,405,407],{"id":406},"error-responses","Error responses",[204,409,410],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[412,413,418],"pre",{"className":414,"code":415,"filename":416,"language":417,"meta":117,"style":117},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json",[243,419,420,429,455],{"__ignoreMap":117},[421,422,425],"span",{"class":423,"line":424},"line",1,[421,426,428],{"class":427},"sMK4o","{\n",[421,430,432,435,439,442,445,448,452],{"class":423,"line":431},2,[421,433,434],{"class":427},"  \"",[421,436,438],{"class":437},"spNyl","message",[421,440,441],{"class":427},"\"",[421,443,444],{"class":427},":",[421,446,447],{"class":427}," \"",[421,449,451],{"class":450},"sfazB","Resource not found.",[421,453,454],{"class":427},"\"\n",[421,456,458],{"class":423,"line":457},3,[421,459,460],{"class":427},"}\n",[204,462,463,464,467,468,470],{},"Some errors also include an optional ",[243,465,466],{},"details"," object with structured context about the failure. Treat unknown keys as forward-compatible additions and branch on the HTTP status code rather than the shape of ",[243,469,466],{},".",[412,472,475],{"className":414,"code":473,"filename":474,"language":417,"meta":117,"style":117},"{\n  \"message\": \"The requested resource was not found.\",\n  \"details\": {\n    \"resource_type\": \"checkout\",\n    \"resource_id\": \"checkout_abc123\"\n  }\n}\n","Error response with details",[243,476,477,481,501,514,537,556,562],{"__ignoreMap":117},[421,478,479],{"class":423,"line":424},[421,480,428],{"class":427},[421,482,483,485,487,489,491,493,496,498],{"class":423,"line":431},[421,484,434],{"class":427},[421,486,438],{"class":437},[421,488,441],{"class":427},[421,490,444],{"class":427},[421,492,447],{"class":427},[421,494,495],{"class":450},"The requested resource was not found.",[421,497,441],{"class":427},[421,499,500],{"class":427},",\n",[421,502,503,505,507,509,511],{"class":423,"line":457},[421,504,434],{"class":427},[421,506,466],{"