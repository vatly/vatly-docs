00",[528,584,585],{},"OK - Request succeeded.",[513,587,588,593],{},[528,589,590],{},[531,591,592],{},"201",[528,594,595],{},"Created - Resource was successfully created.",[513,597,598,603],{},[528,599,600],{},[531,601,602],{},"204",[528,604,605],{},"No Content - Request succeeded with no response body (e.g., deletes).",[513,607,608,613],{},[528,609,610],{},[531,611,612],{},"400",[528,614,615],{},"Bad Request - The request was malformed.",[513,617,618,623],{},[528,619,620],{},[531,621,622],{},"401",[528,624,625],{},"Unauthorized - Invalid or missing API key.",[513,627,628,633],{},[528,629,630],{},[531,631,632],{},"403",[528,634,635],{},"Forbidden - The API key doesn't have permission for this action.",[513,637,638,643],{},[528,639,640],{},[531,641,642],{},"404",[528,644,645],{},"Not Found - The requested resource doesn't exist.",[513,647,648,653],{},[528,649,650],{},[531,651,652],{},"409",[528,654,655],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, a concurrent write, or a refund of the same order already being created.",[513,657,658,663],{},[528,659,660],{},[531,661,662],{},"422",[528,664,665,666,669],{},"Unprocessable Entity - Validation failed. Check the ",[531,667,668],{},"errors"," field for details.",[513,671,672,677],{},[528,673,674],{},[531,675,676],{},"429",[528,678,679],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[513,681,682,687],{},[528,683,684],{},[531,685,686],{},"500",[528,688,689],{},"Internal Server Error - Something went wrong on Vatly's end.",[496,691],{},[499,693,695],{"id":694},"error-responses","Error responses",[492,697,698],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[700,701,707],"pre",{"className":702,"code":703,"filename":704,"language":705,"meta":706,"style":706},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json","",[531,708,709,718,744],{"__ignoreMap":706},[710,711,714],"span",{"class":712,"line":713},"line",1,[710,715,717],{"class":716},"sMK4o","{\n",[710,719,721,724,728,731,734,737,741],{"class":712,"line":720},2,[710,722,723],{"class":716},"  \"",[710,725,727],{"class":726},"spNyl","message",[710,729,730],{"class":716},"\"",[710,732,733],{"class":716},":",[710,735,736],{"class":716}," \"",[710,738,740],{"class":739},"sfazB","Resource not found.",[710,742,743],{"class":716},"\"\n",[710,745,747],{"class":712,"line":746},3,[710,748,749],{"class":716},"}\n",[492,751,752,753,756,757,759],{},"Some errors also include an optional ",[531,754,755],{},"details"," object with structured context about the failure. Treat unknown keys as forward-compatible additions and branch on the HTTP status code rather than the shape of ",[531,758,755],{},".",[700,761,764],{"className":702,"code":762,"filename":763,"language":705,"meta":706,"style":706},"{\n  \"message\": \"The requested resource was not found.\",\n  \"details\": {\n    \"resource_type\": \"checkout\",\n    \"resource_id\": \"checkout_abc123\"\n  }\n}\n","Error response with details",[531,765,766,770,790,803,826,845,851],{"__ignoreMap":706},[710,767,768],{"class":712,"line":713},[710,769,717],{"class":716},[710,771,772,774,776,778,780,782,785,787],{"class":712,"line":720},[710,773,723],{"class":716},[710,775,727],{"class":726},[710,777,730],{"class":716},[710,779,733],{"class":716},[710,781,736],{"class":716},[710,783,784],{"class":739},"The requested resource was not found.",[710,786,730],{"class":716},[710,788,789],{"class":716},",\n",[710,791,792,794,796,798,800],{"class":712,"line":746},[710,793,723],{"class":716},[710,795,755],{"class":726},[710,797,730],{"class":716},[710,799,733],{"class":716},[710,801,802],{"class":716}," {\n",[710,804,806,809,813,8