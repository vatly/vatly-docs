ful.",[438,439,440,453],"table",{},[441,442,443],"thead",{},[444,445,446,450],"tr",{},[447,448,449],"th",{},"Status",[447,451,452],{},"Description",[454,455,456,468,478],"tbody",{},[444,457,458,465],{},[459,460,461],"td",{},[462,463,464],"code",{},"2xx",[459,466,467],{},"A 2xx status code indicates a successful response.",[444,469,470,475],{},[459,471,472],{},[462,473,474],{},"4xx",[459,476,477],{},"A 4xx status code indicates a client error. This means there's an issue with the request.",[444,479,480,485],{},[459,481,482],{},[462,483,484],{},"5xx",[459,486,487],{},"A 5xx status code indicates a server error. This means the issue is on Vatly's end and we are automatically notified of the problem.",[489,490,492],"h3",{"id":491},"common-status-codes","Common status codes",[438,494,495,505],{},[441,496,497],{},[444,498,499,502],{},[447,500,501],{},"Code",[447,503,504],{},"Meaning",[454,506,507,517,527,537,547,557,567,577,587,601,611],{},[444,508,509,514],{},[459,510,511],{},[462,512,513],{},"200",[459,515,516],{},"OK - Request succeeded.",[444,518,519,524],{},[459,520,521],{},[462,522,523],{},"201",[459,525,526],{},"Created - Resource was successfully created.",[444,528,529,534],{},[459,530,531],{},[462,532,533],{},"204",[459,535,536],{},"No Content - Request succeeded with no response body (e.g., deletes).",[444,538,539,544],{},[459,540,541],{},[462,542,543],{},"400",[459,545,546],{},"Bad Request - The request was malformed.",[444,548,549,554],{},[459,550,551],{},[462,552,553],{},"401",[459,555,556],{},"Unauthorized - Invalid or missing API key.",[444,558,559,564],{},[459,560,561],{},[462,562,563],{},"403",[459,565,566],{},"Forbidden - The API key doesn't have permission for this action.",[444,568,569,574],{},[459,570,571],{},[462,572,573],{},"404",[459,575,576],{},"Not Found - The requested resource doesn't exist.",[444,578,579,584],{},[459,580,581],{},[462,582,583],{},"409",[459,585,586],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, a concurrent write, or a refund of the same order already being created.",[444,588,589,594],{},[459,590,591],{},[462,592,593],{},"422",[459,595,596,597,600],{},"Unprocessable Entity - Validation failed. Check the ",[462,598,599],{},"errors"," field for details.",[444,602,603,608],{},[459,604,605],{},[462,606,607],{},"429",[459,609,610],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[444,612,613,618],{},[459,614,615],{},[462,616,617],{},"500",[459,619,620],{},"Internal Server Error - Something went wrong on Vatly's end.",[427,622],{},[430,624,626],{"id":625},"error-responses","Error responses",[423,628,629],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[631,632,638],"pre",{"className":633,"code":634,"filename":635,"language":636,"meta":637,"style":637},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json","",[462,639,640,649,675],{"__ignoreMap":637},[641,642,645],"span",{"class":643,"line":644},"line",1,[641,646,648],{"class":647},"sMK4o","{\n",[641,650,652,655,659,662,665,668,672],{"class":643,"line":651},2,[641,653,654],{"class":647},"  \"",[641,656,658],{"class":657},"spNyl","message",[641,660,661],{"class":647},"\"",[641,663,664],{"class":647},":",[641,666,667],{"class":647}," \"",[641,669,671],{"class":670},"sfazB","Resource not found.",[641,673,674],{"class":647},"\"\n",[641,676,678],{"class":643,"line":677},3,[641,679,680],{"class":647},"}\n",[423,682,683,684,687,688,690],{},"Some errors also include an optional ",[462,685,686],{},"details"," object with structured context about the failure. Treat unknown keys as forward-compatible additions and branch on the HTTP status code rather than the shape of "