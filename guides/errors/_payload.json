[532,602,603],{},"204",[529,605,606],{},"No Content - Request succeeded with no response body (e.g., deletes).",[514,608,609,614],{},[529,610,611],{},[532,612,613],{},"400",[529,615,616],{},"Bad Request - The request was malformed.",[514,618,619,624],{},[529,620,621],{},[532,622,623],{},"401",[529,625,626],{},"Unauthorized - Invalid or missing API key.",[514,628,629,634],{},[529,630,631],{},[532,632,633],{},"403",[529,635,636],{},"Forbidden - The API key doesn't have permission for this action.",[514,638,639,644],{},[529,640,641],{},[532,642,643],{},"404",[529,645,646],{},"Not Found - The requested resource doesn't exist.",[514,648,649,654],{},[529,650,651],{},[532,652,653],{},"409",[529,655,656],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, a concurrent write, or a refund of the same order already being created.",[514,658,659,664],{},[529,660,661],{},[532,662,663],{},"422",[529,665,666,667,670],{},"Unprocessable Entity - Validation failed. Check the ",[532,668,669],{},"errors"," field for details.",[514,672,673,678],{},[529,674,675],{},[532,676,677],{},"429",[529,679,680],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[514,682,683,688],{},[529,684,685],{},[532,686,687],{},"500",[529,689,690],{},"Internal Server Error - Something went wrong on Vatly's end.",[497,692],{},[500,694,696],{"id":695},"error-responses","Error responses",[493,698,699],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[701,702,708],"pre",{"className":703,"code":704,"filename":705,"language":706,"meta":707,"style":707},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json","",[532,709,710,719,745],{"__ignor