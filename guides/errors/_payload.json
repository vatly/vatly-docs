 code and error message to understand what went wrong.",[476,477],"hr",{},[479,480,482],"h2",{"id":481},"status-codes","Status codes",[472,484,485],{},"Here is a list of the different categories of status codes returned by the Vatly API. Use these to understand if a request was successful.",[487,488,489,502],"table",{},[490,491,492],"thead",{},[493,494,495,499],"tr",{},[496,497,498],"th",{},"Status",[496,500,501],{},"Description",[503,504,505,517,527],"tbody",{},[493,506,507,514],{},[508,509,510],"td",{},[511,512,513],"code",{},"2xx",[508,515,516],{},"A 2xx status code indicates a successful response.",[493,518,519,524],{},[508,520,521],{},[511,522,523],{},"4xx",[508,525,526],{},"A 4xx status code indicates a client error. This means there's an issue with the request.",[493,528,529,534],{},[508,530,531],{},[511,532,533],{},"5xx",[508,535,536],{},"A 5xx status code indicates a server error. This means the issue is on Vatly's end and we are automatically notified of the problem.",[538,539,541],"h3",{"id":540},"common-status-codes","Common status codes",[487,543,544,554],{},[490,545,546],{},[493,547,548,551],{},[496,549,550],{},"Code",[496,552,553],{},"Meaning",[503,555,556,566,576,586,596,606,616,626,636,650,660],{},[493,557,558,563],{},[508,559,560],{},[511,561,562],{},"200",[508,564,565],{},"OK - Request succeeded.",[493,567,568,573],{},[508,569,570],{},[511,571,572],{},"201",[508,574,575],{},"Created - Resource was successfully created.",[493,577,578,583],{},[508,579,580],{},[511,581,582],{},"204",[508,584,585],{},"No Content - Request succeeded with no response body (e.g., deletes).",[493,587,588,593],{},[508,589,590],{},[511,591,592],{},"400",[508,594,595],{},"Bad Request - The request was malformed.",[493,597,598,603],{},[508,599,600],{},[511,601,602],{},"401",[508,604,605],{},"Unauthorized - Invalid or missing API key.",[493,607,608,613],{},[508,609,610],{},[511,611,612],{},"403",[508,614,615],{},"Forbidden - The API key doesn't have permission for this action.",[493,617,618,623],{},[508,619,620],{},[511,621,622],{},"404",[508,624,625],{},"Not Found - The requested resource doesn't exist.",[493,627,628,633],{},[508,629,630],{},[511,631,632],{},"409",[508,634,635],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, a concurrent write, or a refund of the same order already being created.",[493,637,638,643],{},[508,639,640],{},[511,641,642],{},"422",[508,644,645,646,649],{},"Unprocessable Entity - Validation failed. Check the ",[511,647,648],{},"errors"," field for details.",[493,651,652,657],{},[508,653,654],{},[511,655,656],{},"429",[508,658,659],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[493,661,662,667],{},[508,663,664],{},[511,665,666],{},"500",[508,668,669],{},"Internal Server Error - Something went wrong on Vatly's end.",[476,671],{},[479,673,675],{"id":674},"error-responses","Error responses",[472,677,678],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[680,681,687],"pre",{"className":682,"code":683,"filename":684,"language":685,"meta":686,"style":686},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"message\": \"Resource not found.\"\n}\n","Error response","json","",[511,688,689,698,724],{"__ignoreMap":686},[690,691,694],"span",{"class":692,"line":693},"line",1,[690,695,697],{"class":696},"sMK4o","{\n",[690,699,701,704,708,711,714,717,721],{"class":692,"line":700},2,[690,702,703],{"class":696},"  \"",[690,705,707],{"class":706},"spNyl","message",[690,709,710],{"class":696},"\"",[690,712,713],{"class":696},":",[690,715,716],{"class":696}," \"",[690,718,720],{"class":719},"sfazB","Resource not found.",[690,722,723],{"class":696},"\"\n",[690,725,727],{"class":692,"line":726},3,[690,728,729