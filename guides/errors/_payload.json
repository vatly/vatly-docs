286,291],{},[236,287,288],{},[239,289,290],{},"200",[236,292,293],{},"OK - Request succeeded.",[221,295,296,301],{},[236,297,298],{},[239,299,300],{},"201",[236,302,303],{},"Created - Resource was successfully created.",[221,305,306,311],{},[236,307,308],{},[239,309,310],{},"204",[236,312,313],{},"No Content - Request succeeded with no response body (e.g., deletes).",[221,315,316,321],{},[236,317,318],{},[239,319,320],{},"400",[236,322,323],{},"Bad Request - The request was malformed.",[221,325,326,331],{},[236,327,328],{},[239,329,330],{},"401",[236,332,333],{},"Unauthorized - Invalid or missing API key.",[221,335,336,341],{},[236,337,338],{},[239,339,340],{},"403",[236,342,343],{},"Forbidden - The API key doesn't have permission for this action.",[221,345,346,351],{},[236,347,348],{},[239,349,350],{},"404",[236,352,353],{},"Not Found - The requested resource doesn't exist.",[221,355,356,361],{},[236,357,358],{},[239,359,360],{},"409",[236,362,363],{},"Conflict - Idempotency mismatch, request still in progress, outcome unknown, or a concurrent write.",[221,365,366,371],{},[236,367,368],{},[239,369,370],{},"422",[236,372,373,374,377],{},"Unprocessable Entity - Validation failed. Check the ",[239,375,376],{},"errors"," field for details.",[221,379,380,385],{},[236,381,382],{},[239,383,384],{},"429",[236,386,387],{},"Too Many Requests - Rate limit exceeded. Slow down your requests.",[221,389,390,395],{},[236,391,392],{},[239,393,394],{},"500",[236,396,397],{},"Internal Server Error - Something went wrong on Vatly's end.",[204,399],{},[207,401,403],{"id":402},"error-responses","Error responses",[200,405,406],{},"Whenever a request is unsuccessful, the Vatly API will return an error response with a human-readable message. Combine it with the HTTP status code to understand what has gone wrong and how to fix it. Most of the error messages are pretty helpful and actionable.",[408,409,414],"pre",{"className":410,"code":411,"filename":412,"language":413,"meta":113,"style":11