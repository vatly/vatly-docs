th":381,"stem":382},"\u002Fpackages\u002Ffluent-python\u002Ftesting","3.packages\u002F7.fluent-python\u002F99.testing",{"title":384,"path":385,"stem":386,"children":387,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[388,392,396,400,403],{"title":389,"path":390,"stem":391},"Vatly Django guides","\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F0.readme",{"title":393,"path":394,"stem":395},"Webhooks, storage and outbox","\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F9.webhooks",{"title":397,"path":398,"stem":399},"Billable operations","\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F99.billing",{"title":212,"path":401,"stem":402},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F99.configuration",{"title":404,"path":405,"stem":406},"Development, support and release","\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F99.development",{"title":408,"path":409,"stem":410,"children":411},"Integrations","\u002Fintegrations","4.integrations",[412,414,418],{"title":408,"path":409,"stem":413},"4.integrations\u002Findex",{"title":415,"path":416,"stem":417},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":419,"path":420,"stem":421},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":423,"title":18,"body":424,"description":536,"extension":537,"links":538,"meta":539,"navigation":540,"path":19,"seo":541,"stem":20,"__hash__":542},"docs\u002F1.guides\u002F10.payouts.md",{"type":425,"value":426,"toc":528},"minimark",[427,432,436,439,443,447,450,453,457,469,521,525],[428,429,431],"h2",{"id":430},"how-you-get-paid","How you get paid",[433,434,435],"p",{},"Vatly settles each payment to your connected Mollie account after a 7-day hold by default. Your share is the sale price excluding the customer's tax, minus Vatly's fee. Where VAT applies to your supply to Vatly, it is settled along with it.",[433,437,438],{},"In your Mollie account, you can configure payouts to your own bank account or another one. Mollie's payout schedule and payout fees apply from there.",[440,441,442],"note",{},"You need a connected Mollie account to receive live payments. Connect it during onboarding in the Vatly dashboard.",[428,444,446],{"id":445},"the-hold-period","The hold period",[433,448,449],{},"The hold starts when a payment is paid. Each payment is settled on its own, so a payment made today is settled about a week from now, regardless of when your other payments were made.",[433,451,452],{},"The hold gives room to handle refunds, chargebacks and risk checks before money moves to your account. Vatly can apply a longer hold where risk checks require it.",[428,454,456],{"id":455},"follow-your-settlements-in-the-dashboard","Follow your settlements in the dashboard",[433,458,459,460,464,465,468],{},"Open ",[461,462,463],"strong",{},"Settlements"," in the Vatly dashboard. Payments are grouped into monthly settlement periods. Each period shows its ",[461,466,467],{},"Payout release status",":",[470,471,472,485],"table",{},[473,474,475],"thead",{},[476,477,478,482],"tr",{},[479,480,481],"th",{},"Line",[479,483,484],{},"Meaning",[486,487,488,497,505,513],"tbody",{},[476,489,490,494],{},[491,492,493],"td",{},"Released to your account",[491,495,496],{},"Already settled to your Mollie account.",[476,498,499,502],{},[491,500,501],{},"Scheduled for release",[491,503,504],{},"Still in its hold period. The next release date is shown alongside.",[476,506,507,510],{},[491,508,509],{},"Held for settlement",[491,511,512],{},"Could not be released with the payment itself, so it is handled through the period's settlement instead.",[476,514,515,518],{},[491,516,517],{},"Charged back before release",[491,519,520],{},"Charged back before its hold ended, so it was not released.",[428,522,524],{"id":523},"test-mode","Test mode",[433,526,527],{},"Test-mode payments are settled after a much shorter hold, so you can follow the full flow while you build. No real money moves in test mode.",{"title":529,"searchDepth":530,"depth":530,"links":531},"",2,[532,533,534,535],{"id":430,"depth":530,"text":431},{"id":445,"depth":530,"text":446},{"id":455,"depth":530,"text":456},{"id":523,"depth":530,"text":524},"How and when your share of each payment reaches your Mollie account, and where to follow it in the dashboard.","md",null,{},true,{"title":18,"description":536},"iRGhAaidF78dfio06hVOKcufrkdZs8_JQU7ZVow9bfs",[544,546],{"title":14,"path":15,"stem":16,"description":545,"children":-1},"This guide will get you all set up and ready to use the Vatly API. We’ll cover how to set up an API client and how to make your first API request.",{"title":22,"path":23,"stem":24,"description":547,"children":-1},"The billing emails Vatly sends to your customers as Merchant of Record, when each one is sent, and what you can configure.",1794487816082]