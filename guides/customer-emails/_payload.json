aravel\u002F6.comparison",{"title":186,"path":187,"stem":188},"Migrating from Cashier","\u002Fpackages\u002Flaravel\u002Fmigrating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":190,"path":191,"stem":192},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":194,"path":195,"stem":196,"children":197,"page":57},"Javascript","\u002Fpackages\u002Fjavascript","3.packages\u002F3.javascript",[198,201,204,208,211,214,217,220,223,226,229],{"title":124,"path":199,"stem":200},"\u002Fpackages\u002Fjavascript\u002Freadme","3.packages\u002F3.javascript\u002F0.readme",{"title":64,"path":202,"stem":203},"\u002Fpackages\u002Fjavascript\u002Fcustomers","3.packages\u002F3.javascript\u002F1.customers",{"title":205,"path":206,"stem":207},"SDK operation reference","\u002Fpackages\u002Fjavascript\u002Fapi","3.packages\u002F3.javascript\u002F10.api",{"title":76,"path":209,"stem":210},"\u002Fpackages\u002Fjavascript\u002Fcheckouts","3.packages\u002F3.javascript\u002F2.checkouts",{"title":84,"path":212,"stem":213},"\u002Fpackages\u002Fjavascript\u002Fsubscriptions","3.packages\u002F3.javascript\u002F3.subscriptions",{"title":88,"path":215,"stem":216},"\u002Fpackages\u002Fjavascript\u002Fsubscriptionplans","3.packages\u002F3.javascript\u002F4.subscriptionplans",{"title":92,"path":218,"stem":219},"\u002Fpackages\u002Fjavascript\u002Forders","3.packages\u002F3.javascript\u002F5.orders",{"title":100,"path":221,"stem":222},"\u002Fpackages\u002Fjavascript\u002Frefunds","3.packages\u002F3.javascript\u002F6.refunds",{"title":146,"path":224,"stem":225},"\u002Fpackages\u002Fjavascript\u002Foneoffproducts","3.packages\u002F3.javascript\u002F7.oneoffproducts",{"title":104,"path":227,"stem":228},"\u002Fpackages\u002Fjavascript\u002Fchargebacks","3.packages\u002F3.javascript\u002F8.chargebacks",{"title":46,"path":230,"stem":231},"\u002Fpackages\u002Fjavascript\u002Fwebhooks","3.packages\u002F3.javascript\u002F9.webhooks",{"title":233,"path":234,"stem":235,"children":236,"page":57},"Fluent Js","\u002Fpackages\u002Ffluent-js","3.packages\u002F4.fluent-js",[237],{"title":124,"path":238,"stem":239},"\u002Fpackages\u002Ffluent-js\u002Freadme","3.packages\u002F4.fluent-js\u002F0.readme",{"title":241,"path":242,"stem":243},"Integrations","\u002Fintegrations","4.integrations",{"id":245,"title":22,"body":246,"description":586,"extension":587,"links":588,"meta":589,"navigation":590,"path":23,"seo":591,"stem":24,"__hash__":592},"docs\u002F1.guides\u002F11.customer-emails.md",{"type":247,"value":248,"toc":572},"minimark",[249,254,258,266,270,273,295,303,307,343,346,349,393,396,399,403,439,443,446,466,469,472,475,492,495,515,519,539,546,550,556,560,563],[250,251,253],"h2",{"id":252},"vatly-sends-the-billing-emails","Vatly sends the billing emails",[255,256,257],"p",{},"As Merchant of Record, Vatly is the seller on your customer's invoice. That makes Vatly responsible for the billing communication with your customers, so you don't need to build receipts, payment reminders or refund confirmations yourself.",[255,259,260,261,265],{},"Vatly sends these emails automatically. Use ",[262,263,264],"a",{"href":47},"webhooks"," to keep your own application in sync, for example to grant or revoke access. Anything about your product itself, such as onboarding or usage emails, stays with you.",[250,267,269],{"id":268},"what-your-customers-see","What your customers see",[255,271,272],{},"Every customer email:",[274,275,276,280,283,292],"ul",{},[277,278,279],"li",{},"Shows your storefront name and logo in the header",[277,281,282],{},"Is sent by Vatly, and states that the sale is made by Vatly",[277,284,285,286],{},"Points billing and payment questions to ",[262,287,291],{"href":288,"rel":289},"https:\u002F\u002Fvatly.com\u002Fsupport",[290],"nofollow","Vatly support",[277,293,294],{},"Is written in English",[255,296,297,298,302],{},"Set your storefront name and logo in the Vatly dashboard under ",[299,300,301],"strong",{},"Settings » Branding",". Until you set a name, customers see a placeholder name in their emails.",[250,304,306],{"id":305},"purchases-and-invoices","Purchases and invoices",[308,309,310,323],"table",{},[311,312,313],"thead",{},[314,315,316,320],"tr",{},[317,318,319],"th",{},"Email",[317,321,322],{},"When it is sent",[324,325,326,335],"tbody",{},[314,327,328,332],{},[329,330,331],"td",{},"Receipt",[329,333,334],{},"After every successful payment: a one-off purchase, the first payment of a subscription, and every renewal. It lists the items, any discount and the VAT, and links to the invoice.",[314,336,337,340],{},[329,338,339],{},"Invoice link",[329,341,342],{},"When a customer opens an expired invoice link and requests a new one.",[255,344,345],{},"Each order gets one receipt. The receipt links to the invoice in the customer portal instead of attaching a PDF.",[250,347,84],{"id":348},"subscriptions",[308,350,351,359],{},[311,352,353],{},[314,354,355,357],{},[317,356,319],{},[317,358,322],{},[324,360,361,369,377,385],{},[314,362,363,366],{},[329,364,365],{},"Upcoming renewal",[329,367,368],{},"Ahead of the renewal of a subscription billed less often than monthly, or of its first charge after a free trial. It shows the amount, the date and how to cancel.",[314,370,371,374],{},[329,372,373],{},"Payment initiated",[329,375,376],{},"When Vatly starts a recurring payment, such as a renewal. It shows the amount, the payment method and the expected charge date.",[314,378,379,382],{},[329,380,381],{},"Cancellation confirmation",[329,383,384],{},"When the customer cancels their subscription in the customer portal. It confirms until when they keep access.",[314,386,387,390],{},[329,388,389],{},"Cancellation notice",[329,391,392],{},"When you cancel a subscription through the API, or Vatly cancels it on your behalf. It tells the customer when their access ends.",[255,394,395],{},"The upcoming renewal email goes out 7 days ahead for plans billed up to every 3 months, 14 days ahead for plans up to every 6 months, and 30 days ahead for longer plans. Monthly and shorter plans don't get one. If the renewal changes after the email went out, for example because you scheduled a plan change, the customer gets an updated email. If the renewal date changes or the subscription is canceled or paused before the email goes out, Vatly doesn't send it. A changed date gets its own email.",[255,397,398],{},"If you end a trial early with an immediate plan change, Vatly charges the first paid cycle on the day of the change, so the customer gets the payment emails that day. A subscription that was canceled during its trial keeps its trial end date.",[250,400,402],{"id":401},"payment-methods","Payment methods",[308,404,405,413],{},[311,406,407],{},[314,408,409,411],{},[317,410,319],{},[317,412,322],{},[324,414,415,423,431],{},[314,416,417,420],{},[329,418,419],{},"Card expiring",[329,421,422],{},"When the card used for a subscription is about to expire. It asks the customer to update their payment method.",[314,424,425,428],{},[329,426,427],{},"Recurring payment setup failed",[329,429,430],{},"When a recurring payment could not be set up because the customer's first payment never completed. It asks the customer to set up their payment method again.",[314,432,433,436],{},[329,434,435],{},"Payment method update link",[329,437,438],{},"When a customer opens an expired payment method update link and requests a new one.",[250,440,442],{"id":441},"failed-payments","Failed payments",[255,444,445],{},"When a recurring payment fails, Vatly starts a payment recovery process for the subscription. The customer receives:",[447,448,449,456,459],"ol",{},[277,450,451,452,455],{},"A ",[299,453,454],{},"Payment failed"," email straight away.",[277,457,458],{},"A series of reminders while Vatly retries the payment. The reminders become more urgent as the process continues, ending with a final notice.",[277,460,461,462,465],{},"If the payment still fails, a ",[299,463,464],{},"Service canceled"," email. Vatly cancels the subscriptions that use the failed payment method.",[255,467,468],{},"Payment recovery also starts if a customer updates their payment method while a renewal payment is still processing and that payment then fails. Vatly retries using the updated payment method.",[255,470,471],{},"When the payment method can't be charged at all, for example because the card is no longer valid, Vatly does not retry. Instead, the customer receives reminders to update their payment method.",[255,473,474],{},"As soon as a retry succeeds or the customer adds a working payment method, the reminders stop and the customer receives the usual receipt.",[255,476,477,478,482,483,486,487,491],{},"Follow the process on your side with the ",[479,480,481],"code",{},"order.payment_failed"," and ",[479,484,485],{},"order.paid"," webhooks. See ",[262,488,490],{"href":489},"\u002Fguides\u002Fwebhooks#handling-failed-subscription-payments","Handling failed subscription payments",".",[250,493,100],{"id":494},"refunds",[308,496,497,505],{},[311,498,499],{},[314,500,501,503],{},[317,502,319],{},[317,504,322],{},[324,506,507],{},[314,508,509,512],{},[329,510,511],{},"Refund processed",[329,513,514],{},"When a refund is completed, whether you created it through the API or the dashboard. It lists the refunded items and the total.",[250,516,518],{"id":517},"customer-portal","Customer portal",[308,520,521,529],{},[311,522,523],{},[314,524,525,527],{},[317,526,319],{},[317,528,322],{},[324,530,531],{},[314,532,533,536],{},[329,534,535],{},"Sign-in link",[329,537,538],{},"When a customer requests a sign-in link on the customer portal login page.",[255,540,541,545],{},[262,542,544],{"href":543},"\u002Fapi-reference\u002Fcustomers#create-a-customer-portal-session","Customer portal sessions"," created through the API return a URL and do not send an email.",[250,547,549],{"id":548},"test-mode","Test mode",[255,551,552,553,491],{},"Emails for test mode orders are never delivered to a real inbox. Vatly still renders and saves them, so you can review what your customer would receive. Open an order in the dashboard and find its emails under ",[299,554,555],{},"Emails",[250,557,559],{"id":558},"customization","Customization",[255,561,562],{},"You can't turn off these emails. Most of them are required for Vatly to bill your customers correctly, such as the receipt and the invoice.",[255,564,565,566,571],{},"Additional email branding is on the ",[262,567,570],{"href":568,"rel":569},"https:\u002F\u002Froadmap.vatly.com\u002Fprojects\u002F2-merchant-ui\u002Fitems\u002F26-email-co-branding",[290],"roadmap",". Vote for it to let us know it matters to you.",{"title":573,"searchDepth":574,"depth":574,"links":575},"",2,[576,577,578,579,580,581,582,583,584,585],{"id":252,"depth":574,"text":253},{"id":268,"depth":574,"text":269},{"id":305,"depth":574,"text":306},{"id":348,"depth":574,"text":84},{"id":401,"depth":574,"text":402},{"id":441,"depth":574,"text":442},{"id":494,"depth":574,"text":100},{"id":517,"depth":574,"text":518},{"id":548,"depth":574,"text":549},{"id":558,"depth":574,"text":559},"The billing emails Vatly sends to your customers as Merchant of Record, when each one is sent, and what you can configure.","md",null,{},true,{"title":22,"description":586},"5dsB_Ndg2TXa40wZtfW5ZvdjLG85XKBD6U72VeVLLLo",[594,596],{"title":18,"path":19,"stem":20,"description":595,"children":-1},"How and when your share of each payment reaches your Mollie account, and where to follow it in the dashboard.",{"title":26,"path":27,"stem":28,"description":597,"children":-1},"Follow the typical Vatly happy path from account setup to product delivery, and prepare for refunds and chargebacks.",1794185862125]