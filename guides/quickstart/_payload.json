9},"sfazB"," --version\n",[531,562,565],{"className":533,"code":563,"filename":564,"language":536,"meta":537,"style":537},"# Install the Vatly PHP SDK\ncomposer require vatly\u002Fvatly-api-php\n","PHP",[539,566,567,572],{"__ignoreMap":537},[542,568,569],{"class":544,"line":545},[542,570,571],{"class":548},"# Install the Vatly PHP SDK\n",[542,573,574,577,580],{"class":544,"line":552},[542,575,576],{"class":555},"composer",[542,578,579],{"class":559}," require",[542,581,582],{"class":559}," vatly\u002Fvatly-api-php\n",[505,584,585],{},[497,586,587],{"href":35},"Check out our list of first-party SDKs",[515,589,591],{"id":590},"making-your-first-api-request","Making your first API request",[505,593,594],{},"After picking your preferred client, you are ready to make your first call to the Vatly API. Below, you can see how to send a GET request to the Checkouts endpoint to get a list of all your checkouts. In the cURL example, results are limited to ten checkouts, the default page length for each client.",[527,596,597,646],{"sync":529},[531,598,600],{"className":533,"code":599,"filename":535,"language":536,"meta":537,"style":537},"curl -G https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer test_your_api_key_here\" \\\n  -d limit=10\n",[539,601,602,616,633],{"__ignoreMap":537},[542,603,604,606,609,612],{"class":544,"line":545},[542,605,556],{"class":555},[542,607,608],{"class":559}," -G",[542,610,611],{"class":559}," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[542,613,615],{"class":614},"sTEyZ"," \\\n",[542,617,618,621,625,628,631],{"class":544,"line":552},[542,619,620],{"class":559},"  -H",[542,622,624],{"class":623},"sMK4o"," \"",[542,626,627],{"class":559},"Authorization: Bearer test_your_api_key_here",[542,629,630],{"class":623},"\"",[542,632,615],{"class":614},[542,634,636,639,642],{"class":544,"line":635},3,[542,637,638],{"class":559},"  -d",[542,640,641],{"class":559}," limit=",[542,643,645],{"class":644},"sbssI","10