ackages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":172,"path":173,"stem":174},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Integrations","/integrations","4.integrations",{"id":184,"title":26,"body":185,"description":381,"extension":382,"links":383,"meta":384,"navigation":385,"path":27,"seo":386,"stem":28,"__hash__":387},"docs/1.guides/4.authentication.md",{"type":186,"value":187,"toc":377},"minimark",[188,193,215,218,241,245,248,290,293,297,300,368,373],[189,190,192],"h2",{"id":191},"api-keys","API keys",[194,195,196,197,201,202,209,210,214],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[198,199,200],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[203,204,208],"a",{"href":205,"rel":206},"https://my.vatly.com",[207],"nofollow","Vatly dashboard"," under ",[211,212,213],"strong",{},"Settings » API",".",[194,216,217],{},"Vatly provides separate API keys for live and test environments:",[219,220,221,232],"ul",{},[222,223,224,227,228,231],"li",{},[211,225,226],{},"Live keys"," are prefixed with ",[198,229,230],{},"live_"," and are used for production requests.",[222,233,234,227,237,240],{},[211,235,236],{},"Test keys",[198,238,239],{},"test_"," and are used for testing and development.",[242,243,244],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[194,246,247],{},"Here's how to authenticate your requests using cURL:",[249,250,255],"pre",{"className":251,"code":252,"filename":253,"language":254,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https://api.vatly.com/v1/checkouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash",[198,256,257,274],{"__ignoreMap":105},[258,259,262,266,270],"span",{"class":260,"line":261},"line",1,[258,263,265],{"class":264},"sBMFI","curl",[258,267,269],{"class":268},"sfazB"," https://api.vatly.com/v1/checkouts",[258,271,273],{"class":272},"sTEyZ"," \\\n",[258,275,277,280,284,287],{"class":260,"line":276},2,[258,278,279],{"class":268},"  -H",[258,281,283],{"class":282},"sMK4o"," \"",[258,285,286],{"class":268},"Authorization: Bearer live_your_api_key_here",[258,288,289],{"class":282},"\"\n",[194,291,292],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[189,294,296],{"id":295},"using-an-sdk","Using an SDK",[194,298,299],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[249,301,306],{"className":302,"code":303,"filename":304,"language":305,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SD