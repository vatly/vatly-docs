2Fbolt","4.integrations\u002F2.bolt",{"id":488,"title":38,"body":489,"description":686,"extension":687,"links":688,"meta":689,"navigation":690,"path":39,"seo":691,"stem":40,"__hash__":692},"docs\u002F1.guides\u002F4.authentication.md",{"type":490,"value":491,"toc":682},"minimark",[492,497,519,522,545,549,552,595,598,602,605,673,678],[493,494,496],"h2",{"id":495},"api-keys","API keys",[498,499,500,501,505,506,513,514,518],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[502,503,504],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[507,508,512],"a",{"href":509,"rel":510},"https:\u002F\u002Fmy.vatly.com",[511],"nofollow","Vatly dashboard"," under ",[515,516,517],"strong",{},"Developers » API keys",".",[498,520,521],{},"Vatly provides separate API keys for live and test environments:",[523,524,525,536],"ul",{},[526,527,528,531,532,535],"li",{},[515,529,530],{},"Live keys"," are prefixed with ",[502,533,534],{},"live_"," and are used for production requests.",[526,537,538,531,541,544],{},[515,539,540],{},"Test keys",[502,542,543],{},"test_"," and are used for testing and development.",[546,547,548],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[498,550,551],{},"Here's how to authenticate your requests using cURL:",[553,554,560],"pre",{"className":555,"code":556,"filename":557,"language":558,"meta":559,"style":559},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash","",[502,561,562,579],{"__ignoreMap":559},[563,564,567,571,575],"span",{"class":565,"line":566},"line",1,[563,568,570],{"class":569},"sBMFI","curl",[563,572,574],{"class":573},"sfazB"," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[563,576,578],{"class":577},"sTEyZ"," \\\n",[563,580,582,585,589,592],{"class":565,"line":581},2,[563,583,584],{"class":573},"  -H",[563,586,588],{"class":587},"sMK4o"," \"",[563,590,591],{"class":573},"Authorization: Bearer live_your_api_key_here",[563,593,594],{"class":587},"\"\n",[498,596,597],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[493,599,601],{"id":600},"using-an-sdk","Using an SDK",[498,603,604],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[553,606,611],{"className":607,"code":608,"filename":609,"language":610,"meta":559,"style":559},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SDK example","php",[502,612,613,645],{"__ignoreMap":559},[563,614,615,618,621,624,628,631,634,637,639,642],{"class":565,"line":566},[563,616,617],{"class":587},"$",[563,619,620],{"class":577},"vatly ",[563,622,623],{"class":587},"=",[563,625,627],{"class":626},"sbssI"," new",[563,629,630],{"class":577}," Vatly",[563,632,633],{"class":587},"\\",[563,635,636],{"class":577},"Api",[563,638,633],{"class":587},[563,640,641],{"class":569},"VatlyApiClient",[563,643,644],{"class":587},";\n",[563,646,647,649,652,655,659,662,665,668,670],{"class":565,"line":581},[563,648,617],{"class":587},[563,650,651],{"class":577},"vatly",[563,653,654],{"class":587},"->",[563,656,658],{"class":657},"s2Zo4","setApiKey",[563,660,661],{"class":587},"(",[563,663,664],{"class":587},"'",[563,666,667],{"class":573},"live_your_api_key_here",[563,669,664],{"class":587},[563,671,672],{"class":587},");\n",[498,674,675],{},[507,676,677],{"href":35},"Check out our list of first-party SDKs",[679,680,681],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .s2Zo4