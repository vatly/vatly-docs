ly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":187,"path":188,"stem":189},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":191,"path":192,"stem":193},"Integrations","\u002Fintegrations","4.integrations",{"id":195,"title":30,"body":196,"description":392,"extension":393,"links":394,"meta":395,"navigation":396,"path":31,"seo":397,"stem":32,"__hash__":398},"docs\u002F1.guides\u002F4.authentication.md",{"type":197,"value":198,"toc":388},"minimark",[199,204,226,229,252,256,259,301,304,308,311,379,384],[200,201,203],"h2",{"id":202},"api-keys","API keys",[205,206,207,208,212,213,220,221,225],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[209,210,211],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[214,215,219],"a",{"href":216,"rel":217},"https:\u002F\u002Fmy.vatly.com",[218],"nofollow","Vatly dashboard"," under ",[222,223,224],"strong",{},"Developers » API keys",".",[205,227,228],{},"Vatly provides separate API keys for live and test environments:",[230,231,232,243],"ul",{},[233,234,235,238,239,242],"li",{},[222,236,237],{},"Live keys"," are prefixed with ",[209,240,241],{},"live_"," and are used for production requests.",[233,244,245,238,248,251],{},[222,246,247],{},"Test keys",[209,249,250],{},"test_"," and are used for testing and development.",[253,254,255],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[205,257,258],{},"Here's how to authenticate your requests using cURL:",[260,261,266],"pre",{"className":262,"code":263,"filename":264,"language":265,"meta":113,"style":113},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash",[209,267,268,285],{"__ignoreMap":113},[269,270,273,277,281],"span",{"class":271,"line":272},"line",1,[269,274,276],{"class":275},"sBMFI","curl",[269,278,280],{"class":279},"sfazB"," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[269,282,284],{"class":283},"sTEyZ"," \\\n",[269,286,288,291,295,298],{"class":271,"line":287},2,[269,289,290],{"class":279},"  -H",[269,292,294],{"class":293},"sMK4o"," \"",[269,296,297],{"class":279},"Authorization: Bearer live_your_api_key_here",[269,299,300],{"class":293},"\"\n",[205,302,303],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[200,305,307],{"id":306},"using-an-sdk","Using an SDK",[205,309,310],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[260,312,317],{"className":313,"code":314,"filename":315,"language":316,"meta":113,"style":113},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SDK example","php",[209,318,319,351],{"__ignoreMap":113},[269,320,321,324,327,330,334,337,340,343,345,348],{"class":271,"line":272},[269,322,323],{"class":293},"$",[269,325,326],{"class":283},"vatly ",[269,328,329],{"class":293},"=",[269,331,333],{"class":332},"sbssI"," new",[269,335,336],{"class":283}," Vatly",[269,338,339],{"class":293},"\\",[269,341,342],{"class":283},"Api",[269,344,339],{"class":293},[269,346,347],{"class":275},"VatlyApiClient",[269,349,350],{"class":293},";\n",[269,352,353,355,358,361,365,368,371,374,376],{"class":271,"line":287},[269,354,323],{"class":293},[269,356,357],{"class":283},"vatly",[269,359,360],{"class":293},"->",[269,362,364],{"class":363},"s2Zo4","setA