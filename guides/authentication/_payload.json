":479,"path":480,"stem":481},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":483,"path":484,"stem":485},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":487,"title":38,"body":488,"description":685,"extension":686,"links":687,"meta":688,"navigation":689,"path":39,"seo":690,"stem":40,"__hash__":691},"docs\u002F1.guides\u002F4.authentication.md",{"type":489,"value":490,"toc":681},"minimark",[491,496,518,521,544,548,551,594,597,601,604,672,677],[492,493,495],"h2",{"id":494},"api-keys","API keys",[497,498,499,500,504,505,512,513,517],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[501,502,503],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[506,507,511],"a",{"href":508,"rel":509},"https:\u002F\u002Fmy.vatly.com",[510],"nofollow","Vatly dashboard"," under ",[514,515,516],"strong",{},"Developers » API keys",".",[497,519,520],{},"Vatly provides separate API keys for live and test environments:",[522,523,524,535],"ul",{},[525,526,527,530,531,534],"li",{},[514,528,529],{},"Live keys"," are prefixed with ",[501,532,533],{},"live_"," and are used for production requests.",[525,536,537,530,540,543],{},[514,538,539],{},"Test keys",[501,541,542],{},"test_"," and are used for testing and development.",[545,546,547],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[497,549,550],{},"Here's how to authenticate your requests using cURL:",[552,553,559],"pre",{"className":554,"code":555,"filename":556,"language":557,"meta":558,"style":558},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash","",[501,560,561,578],{"__ignoreMap":558},[562,563,566,570,574],"span",{"class":564,"line":565},"line",1,[562,567,569],{"class":568},"sBMFI","curl",[562,571,573],{"class":572},"sfazB"," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[562,575,577],{"class":576},"sTEyZ"," \\\n",[562,579,581,584,588,591],{"class":564,"line":580},2,[562,582,583],{"class":572},"  -H",[562,585,587],{"class":586},"sMK4o"," \"",[562,589,590],{"class":572},"Authorization: Bearer live_your_api_key_here",[562,592,593],{"class":586},"\"\n",[497,595,596],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[492,598,600],{"id":599},"using-an-sdk","Using an SDK",[497,602,603],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[552,605,610],{"className":606,"code":607,"filename":608,"language":609,"meta":558,"style":558},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SDK example","php",[501,611,612,644],{"__ignoreMap":558},[562,613,614,617,620,623,627,630,633,636,638,641],{"class":564,"line":565},[562,615,616],{"class":586},"$",[562,618,619],{"class":576},"vatly ",[562,621,622],{"class":586},"=",[562,624,626],{"class":625},"sbssI"," new",[562,628,629],{"class":576}," Vatly",[562,631,632],{"class":586},"\\",[562,634,635],{"class":576},"Api",[562,637,632],{"class":586},[562,639,640],{"class":568},"VatlyApiClient",[562,642,643],{"class":586},";\n",[562,645,646,648,651,654,658,661,664,667,669],{"class":564,"line":580},[562,647,616],{"class":586},[562,649,650],{"class":576},"vatly",[562,652,653],{"class":586},"->",[562,655,657],{"class":656},"s2Zo4","setApiKey",[562,659,660],{"class":586},"(",[562,662