84,"stem":36,"__hash__":485},"docs\u002F1.guides\u002F4.authentication.md",{"type":283,"value":284,"toc":475},"minimark",[285,290,312,315,338,342,345,388,391,395,398,466,471],[286,287,289],"h2",{"id":288},"api-keys","API keys",[291,292,293,294,298,299,306,307,311],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[295,296,297],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[300,301,305],"a",{"href":302,"rel":303},"https:\u002F\u002Fmy.vatly.com",[304],"nofollow","Vatly dashboard"," under ",[308,309,310],"strong",{},"Developers » API keys",".",[291,313,314],{},"Vatly provides separate API keys for live and test environments:",[316,317,318,329],"ul",{},[319,320,321,324,325,328],"li",{},[308,322,323],{},"Live keys"," are prefixed with ",[295,326,327],{},"live_"," and are used for production requests.",[319,330,331,324,334,337],{},[308,332,333],{},"Test keys",[295,335,336],{},"test_"," and are used for testing and development.",[339,340,341],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[291,343,344],{},"Here's how to authenticate your requests using cURL:",[346,347,353],"pre",{"className":348,"code":349,"filename":350,"language":351,"meta":352,"style":352},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash","",[295,354,355,372],{"__ignoreMap":352},[356,357,360,364,368],"span",{"class":358,"line":359},"line",1,[356,361,363],{"class":362},"sBMFI","curl",[356,365,367],{"class":366},"sfazB"," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[356,369,371],{"class":370},"sTEyZ"," \\\n",[356,373,375,378,382,385],{"class":358,"line":374},2,[356,376,377],{"class":366},"  -H",[356,379,381],{"class":380},"sMK4o"," \"",[356,383,384],{"class":366},"Authorization: Bearer live_your_api_key_here",[356,386,387],{"class":380},"\"\n",[291,389,390],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[286,392,394],{"id":393},"using-an-sdk","Using an SDK",[291,396,397],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[346,399,404],{"className":400,"code":401,"filename":402,"language":403,"meta":352,"style":352},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SDK example","php",[295,405,406,438],{"__ignoreMap":352},[356,407,408,411,414,417,421,424,427,430,432,435],{"class":358,"line":359},[356,409,410],{"class":380},"$",[356,412,413],{"class":370},"vatly ",[356,415,416],{"class":380},"=",[356,418,420],{"class":419},"sbssI"," new",[356,422,423],{"class":370}," Vatly",[356,425,426],{"class":380},"\\",[356,428,429],{"class":370},"Api",[356,431,426],{"class":380},[356,433,434],{"class":362},"VatlyApiClient",[356,436,437],{"class":380},";\n",[356,439,440,442,445,448,452,455,458,461,463],{"class":358,"line":374},[356,441,410],{"class":380},[356,443,444],{"class":370},"vatly",[356,446,447],{"class":380},"->",[356,449,451],{"class":450},"s2Zo4","setApiKey",[356,453,454],{"class":380},"(",[356,456,457],{"class":380},"'",[356,459,460],{"class":366},"live_your_api_key_here",[356,462,457],{"class":380},[356,464,465],{"class":380},");\n",[291,467,468],{},[300,469,470],{"href":31},"Check out our list of first-party SDKs",[472,473,474],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}htm