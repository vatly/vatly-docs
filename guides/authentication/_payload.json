ckages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":187,"path":188,"stem":189},"Integrations","\u002Fintegrations","4.integrations",{"id":191,"title":26,"body":192,"description":388,"extension":389,"links":390,"meta":391,"navigation":392,"path":27,"seo":393,"stem":28,"__hash__":394},"docs\u002F1.guides\u002F4.authentication.md",{"type":193,"value":194,"toc":384},"minimark",[195,200,222,225,248,252,255,297,300,304,307,375,380],[196,197,199],"h2",{"id":198},"api-keys","API keys",[201,202,203,204,208,209,216,217,221],"p",{},"To authenticate with the Vatly API, you need to include your API key in the ",[205,206,207],"code",{},"Authorization"," header of each request. You can obtain your API key from the ",[210,211,215],"a",{"href":212,"rel":213},"https:\u002F\u002Fmy.vatly.com",[214],"nofollow","Vatly dashboard"," under ",[218,219,220],"strong",{},"Settings » API",".",[201,223,224],{},"Vatly provides separate API keys for live and test environments:",[226,227,228,239],"ul",{},[229,230,231,234,235,238],"li",{},[218,232,233],{},"Live keys"," are prefixed with ",[205,236,237],{},"live_"," and are used for production requests.",[229,240,241,234,244,247],{},[218,242,243],{},"Test keys",[205,245,246],{},"test_"," and are used for testing and development.",[249,250,251],"note",{},"Use your test API key during development to avoid affecting live data. Switch to your live API key when you're ready to go to production.",[201,253,254],{},"Here's how to authenticate your requests using cURL:",[256,257,262],"pre",{"className":258,"code":259,"filename":260,"language":261,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\"\n","Example request with API key","bash",[205,263,264,281],{"__ignoreMap":109},[265,266,269,273,277],"span",{"class":267,"line":268},"line",1,[265,270,272],{"class":271},"sBMFI","curl",[265,274,276],{"class":275},"sfazB"," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Fcheckouts",[265,278,280],{"class":279},"sTEyZ"," \\\n",[265,282,284,287,291,294],{"class":267,"line":283},2,[265,285,286],{"class":275},"  -H",[265,288,290],{"class":289},"sMK4o"," \"",[265,292,293],{"class":275},"Authorization: Bearer live_your_api_key_here",[265,295,296],{"class":289},"\"\n",[201,298,299],{},"Always keep your API key safe and never expose it in client-side code or commit it to version control. If you suspect your API key has been compromised, you can regenerate it from the Vatly dashboard.",[196,301,303],{"id":302},"using-an-sdk","Using an SDK",[201,305,306],{},"If you use one of our official SDKs, authentication is straightforward. Simply provide your API key when initializing the client, and the SDK will handle the rest.",[256,308,313],{"className":309,"code":310,"filename":311,"language":312,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly = new Vatly\\Api\\VatlyApiClient;\n$vatly->setApiKey('live_your_api_key_here');\n","PHP SDK example","php",[205,314,315,347],{"__ignoreMap":109},[265,316,317,320,323,326,330,333,336,339,341,344],{"class":267,"line":268},[265,318,319],{"class":289},"$",[265,321,322],{"class":279},"vatly ",[265,324,325],{"class":289},"=",[265,327,329],{"class":328},"sbssI"," new",[265,331,332],{"class":279}," Vatly",[265,334,335],{"class":289},"\\",[265,337,338],{"class":279},"Api",[265,340,335],{"class":289},[265,342,343],{"class":271},"VatlyApiClient",[265,345,346],{"class":289},";\n",[265,348,349,351,354,357,361,364,367,370,372],{"class":267,"line":283},[265,350,319],{"class":289},[265,352,353],{"class":279},"vatly",[265,355,356],{"class":289},"->",[265,358,360],{"class":359},"s2Zo4","setApiKey",[265,362,363],{"class":289},"(",[265,365,366],{"class":289},"'",[265,368,369],{"class":275},"live_your_api_key_here",[2