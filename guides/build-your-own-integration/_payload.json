ython\u002F99.porting",{"title":58,"path":381,"stem":382},"\u002Fpackages\u002Ffluent-python\u002Ftesting","3.packages\u002F7.fluent-python\u002F99.testing",{"title":384,"path":385,"stem":386,"children":387,"page":61},"Django","\u002Fpackages\u002Fdjango","3.packages\u002F8.django",[388,392,396,400,403],{"title":389,"path":390,"stem":391},"Vatly Django guides","\u002Fpackages\u002Fdjango\u002Freadme","3.packages\u002F8.django\u002F0.readme",{"title":393,"path":394,"stem":395},"Webhooks, storage and outbox","\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F9.webhooks",{"title":397,"path":398,"stem":399},"Billable operations","\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F99.billing",{"title":212,"path":401,"stem":402},"\u002Fpackages\u002Fdjango\u002Fconfiguration","3.packages\u002F8.django\u002F99.configuration",{"title":404,"path":405,"stem":406},"Development, support and release","\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F99.development",{"title":408,"path":409,"stem":410,"children":411},"Integrations","\u002Fintegrations","4.integrations",[412,414,418],{"title":408,"path":409,"stem":413},"4.integrations\u002Findex",{"title":415,"path":416,"stem":417},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":419,"path":420,"stem":421},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":423,"title":26,"body":424,"description":771,"extension":772,"links":773,"meta":774,"navigation":775,"path":27,"seo":776,"stem":28,"__hash__":777},"docs\u002F1.guides\u002F2.build-your-own-integration.md",{"type":425,"value":426,"toc":760},"minimark",[427,431,434,439,477,481,533,540,544,562,568,572,594,597,600,604,607,678,685,689,692,706,724,728,731,745],[428,429,430],"p",{},"You do not need to build a payment form or your own tax and invoicing workflow to sell with Vatly. Vatly is the European merchant of record for AI, software and digital products: it acts as the legal seller and provides hosted checkout. Your app delivers the product and controls access.",[428,432,433],{},"This guide helps you decide what to connect before writing code or asking an agent to implement it. Whether a developer or an AI agent does the work, the responsibilities are the same.",[435,436,438],"h2",{"id":437},"choose-your-starting-point","Choose your starting point",[440,441,442,462,468],"ul",{},[443,444,445,449,450,454,455,458,459,461],"li",{},[446,447,448],"strong",{},"Using Lovable or Bolt?"," Follow the ",[451,452,453],"a",{"href":416},"Lovable"," or ",[451,456,457],{"href":420},"Bolt"," guide for the setup in your platform and a ready-to-use agent prompt. Find platform-specific instructions under ",[451,460,408],{"href":409},".",[443,463,464,467],{},[446,465,466],{},"Connecting your own app?"," Continue below to plan the integration and choose the right implementation documentation.",[443,469,470,473,474,476],{},[446,471,472],{},"Ready to make an API request?"," The ",[451,475,14],{"href":15}," covers your first authenticated call. It is a technical first step, not a complete payment integration.",[435,478,480],{"id":479},"what-vatly-handles-and-what-stays-in-your-app","What Vatly handles, and what stays in your app",[482,483,484,497],"table",{},[485,486,487],"thead",{},[488,489,490,494],"tr",{},[491,492,493],"th",{},"Vatly handles",[491,495,496],{},"Your app handles",[498,499,500,509,517,525],"tbody",{},[488,501,502,506],{},[503,504,505],"td",{},"Being the legal seller, including tax and customer invoicing for Vatly sales",[503,507,508],{},"Your software or digital product, customer accounts, and support for your product",[488,510,511,514],{},[503,512,513],{},"The hosted checkout and payment flow",[503,515,516],{},"Your pricing UI and the decision about which products a customer can buy",[488,518,519,522],{},[503,520,521],{},"Billing events, including payments and subscription changes",[503,523,524],{},"Delivering downloads, activating licenses, or granting and updating access",[488,526,527,530],{},[503,528,529],{},"A hosted customer portal for eligible customers",[503,531,532],{},"Authenticating the customer and opening their portal session securely",[428,534,535,536,539],{},"Portal access requires an issued invoice. See the ",[451,537,538],{"href":289},"customer portal documentation",". Your existing login and database can remain in place; adding Vatly does not require replacing them.",[435,541,543],{"id":542},"what-a-purchase-looks-like","What a purchase looks like",[545,546,547,550,553,556,559],"ol",{},[443,548,549],{},"A customer chooses a product or plan in your app.",[443,551,552],{},"Your backend checks what that customer can buy and asks Vatly to create a checkout. The API key stays on your server.",[443,554,555],{},"Your app sends the customer to Vatly's hosted checkout to pay, then shows a return page in your app.",[443,557,558],{},"Vatly sends a signed notification, called a webhook, to your backend. Your app verifies it before recording the purchase and delivering access.",[443,560,561],{},"For subscriptions, your app keeps access in step with renewals, cancellations, and other billing changes. Refunds and disputes also need an access policy.",[428,563,564,565,567],{},"The return page is not proof of payment. A customer may close the checkout tab or visit the return URL directly; delivery must depend on the verified billing result, not that browser visit. The ",[451,566,30],{"href":31}," walks through the sale lifecycle in more detail.",[435,569,571],{"id":570},"prepare-a-test-integration","Prepare a test integration",[428,573,574,580,581,585,586,589,590,593],{},[451,575,579],{"href":576,"rel":577},"https:\u002F\u002Fmy.vatly.com",[578],"nofollow","Create a Vatly account",", get a ",[582,583,584],"code",{},"test_"," key under ",[446,587,588],{},"Developers » API keys",", and create a test product under ",[446,591,592],{},"Manage Products",". Choose a one-off product for a single purchase or a subscription plan for recurring access. Keep the key, products, and customers in the same storefront and mode.",[428,595,596],{},"Your app needs a deployed backend that can call Vatly privately, receive HTTPS webhooks, and store billing state. A frontend-only site needs a backend or server functions for these tasks. Store API keys and webhook signing secrets in that backend's secret manager—not browser code, frontend environment variables, or agent chat.",[428,598,599],{},"Test mode is available before going live. Your first milestone is one complete test purchase that grants the right customer access, not a finished billing dashboard.",[435,601,603],{"id":602},"choose-your-tools","Choose your tools",[428,605,606],{},"For app-level billing, start with a fluent package rather than assembling every flow from low-level API calls:",[440,608,609,629,641,653],{},[443,610,611,614,615,620,621,624,625,628],{},[446,612,613],{},"JavaScript \u002F TypeScript:"," ",[451,616,617],{"href":260},[582,618,619],{},"@getvatly\u002Ffluent"," builds on ",[582,622,623],{},"@getvatly\u002Fsdk"," with checkout and subscription builders, customer bindings, and webhook processing. Follow ",[451,626,627],{"href":281},"configuration"," for compatible versions and runtime requirements.",[443,630,631,614,634,636,637,640],{},[446,632,633],{},"PHP:",[451,635,163],{"href":178}," provides higher-level billing flows. The ",[451,638,639],{"href":186},"Laravel package"," wires fluent for Laravel.",[443,642,643,614,646,648,649,652],{},[446,644,645],{},"Python:",[451,647,341],{"href":346}," provides async-first billing flows and storage contracts. The ",[451,650,651],{"href":390},"Django package"," integrates fluent with Django's ORM and webhook handling. Both are available on PyPI.",[443,654,655,658,659,662,663,666,667,669,670,673,674,677],{},[446,656,657],{},"Direct API access:"," Use the matching ",[451,660,661],{"href":117},"SDK"," when you only need the API client, or the ",[451,664,665],{"href":64},"HTTP API"," from another server-side language. The ",[451,668,295],{"href":301}," is available on PyPI as ",[582,671,672],{},"vatly-api-python"," (import ",[582,675,676],{},"vatly",").",[428,679,680,681,684],{},"The JavaScript, Python, Django and PHP fluent packages are ",[446,682,683],{},"alpha",". Every alpha release may include breaking changes. Pin exact versions during alpha. Follow each package's installation guidance and review upgrades. Fluent packages provide building blocks, not your app's access policy or a database integration that configures itself: your developer or agent must wire the required storage drivers and authorization checks.",[435,686,688],{"id":687},"hand-off-a-clear-brief","Hand off a clear brief",[428,690,691],{},"Give your developer or agent the decisions that belong to your business:",[440,693,694,697,700,703],{},[443,695,696],{},"Which products or plans you will sell, and what each purchase unlocks.",[443,698,699],{},"Which existing login, database, and deployed backend to use.",[443,701,702],{},"Where customers should return after completing or canceling checkout.",[443,704,705],{},"How access should change after a renewal, cancellation, refund, or dispute.",[428,707,708,709,714,715,717,718,723],{},"Ask them to follow the chosen package's checkout and webhook documentation, and to show you the deployed checkout flow and webhook URL. Secrets should be entered through the host's secure secret form, never included in the brief. Agents can use the ",[451,710,713],{"href":711,"rel":712},"https:\u002F\u002Fdocs.vatly.com\u002Fllms.txt",[578],"documentation index",", ",[451,716,307],{"href":64},", and ",[451,719,722],{"href":720,"rel":721},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[578],"OpenAPI specification"," to check implementation details.",[435,725,727],{"id":726},"know-when-you-are-ready-to-sell","Know when you are ready to sell",[428,729,730],{},"Before switching to live credentials, review the integration as a customer:",[440,732,733,736,739,742],{},[443,734,735],{},"A completed test purchase grants the right access; a canceled checkout or a visit to the return URL alone does not.",[443,737,738],{},"Customers cannot buy on another user's account or grant themselves access through the browser.",[443,740,741],{},"Repeated webhook deliveries do not fulfill a purchase twice, invalid signatures are rejected, and failed processing can retry.",[443,743,744],{},"Subscription and post-payment changes follow the access policy you chose.",[428,746,747,748,714,751,754,755,759],{},"Your implementer can use the ",[451,749,750],{"href":51},"webhook guide",[451,752,753],{"href":59},"test-mode guide",", and package-specific tests for these checks. Live selling also requires ",[451,756,758],{"href":757},"\u002Fintroduction#going-live","Vatly approval, product review, and Mollie verification",". A working test integration is not a guarantee of a go-live date.",{"title":761,"searchDepth":762,"depth":762,"links":763},"",2,[764,765,766,767,768,769,770],{"id":437,"depth":762,"text":438},{"id":479,"depth":762,"text":480},{"id":542,"depth":762,"text":543},{"id":570,"depth":762,"text":571},{"id":602,"depth":762,"text":603},{"id":687,"depth":762,"text":688},{"id":726,"depth":762,"text":727},"Understand what adopting Vatly involves: responsibilities, checkout and fulfillment, choosing an integration path, and preparing your developer or AI agent.","md",null,{},true,{"title":26,"description":771},"2SSa0vGnoFiy-6vR3Wx4XfDtorzswL7_Kobivt6ONq0",[779,781],{"title":22,"path":23,"stem":24,"description":780,"children":-1},"The billing emails Vatly sends to your customers as Merchant of Record, when each one is sent, and what you can configure.",{"title":30,"path":31,"stem":32,"description":782,"children":-1},"Follow the typical Vatly happy path from account setup to product delivery, and prepare for refunds and chargebacks.",1794487816461]