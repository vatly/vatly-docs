469},[466,617,618],{"class":472},"pip",[466,620,535],{"class":476},[466,622,623],{"class":476}," vatly-api-python\n",[423,625,626,627,630,631,440],{},"See the ",[437,628,629],{"href":296},"Python SDK docs"," for initialization and API resources, or the source on ",[437,632,549],{"href":633,"rel":634},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-api-python",[450],[427,636,336],{"id":637},"python-fluent",[423,639,640,647,648,440],{},[437,641,644],{"href":642,"rel":643},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-fluent-python\u002F",[450],[452,645,646],{},"vatly-fluent-python"," builds on the Python SDK with async-first billing flows, checkout builders, subscriptions and transactional webhooks. Import it as ",[452,649,650],{},"vatly_fluent",[457,652,654],{"className":459,"code":653,"language":461,"meta":462,"style":462},"pip install vatly-fluent-python\n",[452,655,656],{"__ignoreMap":462},[466,657,658,660,662],{"class":468,"line":469},[466,659,618],{"class":472},[466,661,535],{"class":476},[466,663,664],{"class":476}," vatly-fluent-python\n",[423,666,626,667,670,671,440],{},[437,668,669],{"href":341},"Python Fluent docs"," for storage contracts and configuration, or the source on ",[437,672,549],{"href":673,"rel":674},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-fluent-python",[450],[427,676,379],{"id":677},"django",[423,679,680,687,688,440],{},[437,681,684],{"href":682,"rel":683},"https:\u002F\u002Fpypi.org\u002Fproject\u002Fvatly-django\u002F",[450],[452,685,686],{},"vatly-django"," integrates Python Fluent with Django, including ORM storage, billable operations and webhook handling. Import it as ",[452,689,690],{},"vatly_django",[457,692,694],{"className":459,"code":693,"language":461,"meta":462,"style":462},"pip install vatly-django\n",[452,695,696],{"__ignoreMap":462},[466,697,698,700,702],{"class":468,"line":469},[466,699,618],{"class":472},[466,701,535],{"class":476},[466,703,704],{"class":476}," vatly-django\n",[423,706,626,707,710,711,715],{},[437,708,709],{"href":385},"Django docs"," for installation and settings, or the source on ",[437,712,549],{"href":713,"rel":714},"https:\u002F\u002Fgithub.com\u002Fvatly\u002Fvatly-django",[450],". Like Laravel for PHP, Django is the framework integration; its reference lives under Packages.",[423,717,718,719,722,723,726],{},"These packages are in alpha. Every alpha release may include breaking changes. Pin exact versions during alpha. All three Python packages are released at ",[452,720,721],{},"0.1.0a2","; for example, use ",[452,724,725],{},"pip install vatly-django==0.1.0a2"," to pin Django and its matching Python package dependencies.",[728,729],"hr",{},[427,731,733],{"id":732},"sdk-availability","SDK availability",[735,736,737,750],"table",{},[738,739,740],"thead",{},[741,742,743,747],"tr",{},[744,745,746],"th",{},"SDK",[744,748,749],{},"Status",[751,752,753,763,771,779,787,795,803,811,819],"tbody",{},[741,754,755,760],{},[756,757,758],"td",{},[437,759,123],{"href":129},[756,761,762],{},"Available (alpha)",[741,764,765,769],{},[756,766,767],{},[437,768,163],{"href":173},[756,770,762],{},[741,772,773,777],{},[756,774,775],{},[437,776,176],{"href":181},[756,778,762],{},[741,780,781,785],{},[756,782,783],{},[437,784,211],{"href":216},[756,786,762],{},[741,788,789,793],{},[756,790,791],{},[437,792,250],{"href":255},[756,794,762],{},[741,796,797,801],{},[756,798,799],{},[437,800,290],{"href":296},[756,802,762],{},[741,804,805,809],{},[756,806,807],{},[437,808,336],{"href":341},[756,810,762],{},[741,812,813,817],{},[756,814,815],{},[437,816,379],{"href":385},[756,818,762],{},[741,820,821,824],{},[756,822,823],{},"Ruby",[756,825,826],{},"Planned",[423,828,829,830,833],{},"In the meantime, you can use the ",[437,831,832],{"href":39},"REST API directly"," with any HTTP client in any language.",[728,835],{},[427,837,839],{"id":838},"openapi-specification","OpenAPI specification",[423,841,842],{},"The whole Vatly API is described by an OpenAPI 3.1 specification. Download it here:",[423,844,845],{},[437,846,847],{"href":847,"rel":848},"https:\u002F\u002Fdocs.vatly.com\u002Fopenapi.yaml",[450],[423,850,851],{},"Use it to generate a typed client in your language, import the API into Postman, Insomnia, or another tool, or feed it to your own codegen and tests. It stays in sync with the live API, so a client generated from it matches this reference.",[427,853,855],{"id":854},"point-your-ai-agent-at-the-docs","Point your AI agent at the docs",[423,857,858,859,862],{},"These docs are built to be read by AI coding agents, not only by people. Point an assistant such as Claude or ChatGPT at ",[452,860,861],{},"docs.vatly.com"," and it can build your integration against the real API surface.",[864,865,866,888,907,913],"ul",{},[867,868,869,875,876,881,882,887],"li",{},[870,871,872],"strong",{},[452,873,874],{},"llms.txt",": a machine-readable index of the site at ",[437,877,880],{"href":878,"rel":879},"https:\u002F\u002Fdocs.vatly.com\u002Fllms.txt",[450],"docs.vatly.com\u002Fllms.txt",", with the full documentation as one file at ",[437,883,886],{"href":884,"rel":885},"https:\u002F\u002Fdocs.vatly.com\u002Fllms-full.txt",[450],"docs.vatly.com\u002Fllms-full.txt",". Give your agent either one and it has the whole reference in a single fetch.",[867,889,890,893,894,897,898,901,902,440],{},[870,891,892],{},"Markdown for every page",": put ",[452,895,896],{},"\u002Fraw"," in front of any docs path and add ",[452,899,900],{},".md",". For this page that is ",[437,903,906],{"href":904,"rel":905},"https:\u002F\u002Fdocs.vatly.com\u002Fraw\u002Fguides\u002Fsdks.md",[450],"docs.vatly.com\u002Fraw\u002Fguides\u002Fsdks.md",[867,908,909,912],{},[870,910,911],{},"Open in ChatGPT or Claude",": every page has buttons in its header to copy it as Markdown or open it straight in ChatGPT or Claude.",[867,914,915,918,919,923],{},[870,916,917],{},"OpenAPI spec",": the ",[437,920,922],{"href":921},"#openapi-specification","specification above"," gives an agent the exact endpoints, parameters, and schemas.",[925,926,927],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":462,"searchDepth":929,"depth":929,"links":930},2,[931,932,933,934,935,936,937,938,939,940,941],{"id":429,"depth":929,"text":123},{"id":443,"depth":929,"text":163},{"id":499,"depth":929,"text":176},{"id":511,"depth":929,"text":211},{"id":552,"depth":929,"text":250},{"id":595,"depth":929,"text":290},{"id":637,"depth":929,"text":336},{"id":677,"depth":929,"text":379},{"id":732,"depth":929,"text":733},{"id":838,"depth":929,"text":839},{"id":854,"depth":929,"text":855},"Install official Vatly SDKs and fluent billing packages for PHP, Laravel, JavaScript, Python and Django. Compare availability and find package guides.","md",null,{},true,{"title":34,"description":942},"W2KQ82RoETmvzjvrCCg1W-cTP_IMM1_8_FQrwbQSB-k",[950,952],{"title":30,"path":31,"stem":32,"description":951,"children":-1},"Follow the typical Vatly happy path from account setup to product delivery, and prepare for refunds and chargebacks.",{"title":38,"path":39,"stem":40,"description":953,"children":-1},"In this guide, we'll look at how authentication works. Vatly uses API keys to authenticate your API requests.",1794489066485]