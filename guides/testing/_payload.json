laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to another billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Migrating to Vatly","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/99.migrating-to-vatly",{"title":184,"path":185,"stem":186},"Integrations","/integrations","4.integrations",{"id":188,"title":46,"body":189,"description":1529,"extension":1530,"links":1531,"meta":1532,"navigation":1533,"path":47,"seo":1534,"stem":48,"__hash__":1535},"docs/1.guides/9.testing.md",{"type":190,"value":191,"toc":1512},"minimark",[192,197,211,215,238,243,262,266,288,303,307,310,314,319,359,362,366,460,464,467,1153,1157,1160,1163,1168,1218,1223,1305,1308,1438,1441,1508],[193,194,196],"h2",{"id":195},"overview","Overview",[198,199,200,201,205,206,210],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[202,203,204],"strong",{},"test mode"," and require a ",[207,208,209],"code",{},"test_"," prefixed API token.",[193,212,214],{"id":213},"taxes-in-test-mode","Taxes in test mode",[216,217,218,219,222,223,225,226,229,230,233,234,237],"warning",{},"In test mode, Vatly does ",[202,220,221],{},"not"," run real tax determination. Checkouts and orders created with a ",[207,224,209],{}," token use a ",[202,227,228],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[202,231,232],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[207,235,236],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[239,240,242],"h3",{"id":241},"how-test-mode-rates-are-applied","How test-mode rates are applied",[198,244,245,246,249,250,253,254,257,258,261],{},"The buyer's country determines a single fixed ",[202,247,248],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[202,251,252],{},"20%",". As an example of multi-rate handling, a Canada (",[207,255,256],{},"CA",") buyer also gets an additional 9.975% ",[207,259,260],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[239,263,265],{"id":264},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[198,267,268,269,271,272,275,276,279,280,283,284,287],{},"Tax IDs are ",[202,270,221],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[202,273,274],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[207,277,278],{},"DE123456789"," is valid for a German buyer, while ",[207,281,282],{},"de123456789"," or ",[207,285,286],{},"FR123…"," for a German buyer is not.",[198,289,290,291,294,295,298,299,302],{},"When a ",[202,292,293],{},"valid"," test tax ID is supplied and the buyer's country ",[202,296,297],{},"differs"," from the seller's, a ",[202,300,301],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[193,304,306],{"id":305},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[198,308,309],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval.",[239,311,313],{"id":312},"request","Request",[198,315,316],{},[207,317,318],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[320,321,322,338],"table",{},[323,324,325],"thead",{},[326,327,328,332,335],"tr",{},[329,330,331],"th",{},"Parameter",[329,333,334],{},"Type",[329,336,337],{},"Description",[339,340,341],"tbody",{},[326,342,343,349,352],{},[344,345,346],"td",{},[207,347,348],{},"subscriptionId",[344,350,351],{},"string",[344,353,354,355,358],{},"ID of the subscription to renew (starts with ",[207,356,357],{},"subscription_",")",[198,360,361],{},"No request body is required.",[239,363,365],{"id":364},"example","Example",[367,368,370,418],"code-group",{"sync":369},"client",[371,372,377],"pre",{"className":373,"code":374,"filename":375,"language":376,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[207,378,379,402],{"__ignoreMap":105},[380,381,384,388,392,395,398],"span",{"class":382,"line":383},"line",1,[380,385,387],{"class":386},"sBMFI","curl",[380,389,391],{"class":390},"sfazB"," -X",[380,393,394],{"class":390}," POST",[380,396,397],{"class":390}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal",[380,399,401],{"class":400},"sTEyZ"," \\\n",[380,403,405,408,412,415],{"class":382,"line":404},2,[380,406,407],{"class":390},"  -H",[380,409,411],{"class":410},"sMK4o"," \"",[380,413,414],{"class":390},"Authorization: Bearer test_your_api_key_here",[380,416,417],{"class":410},"\"\n",[371,419,424],{"className":420,"code":421,"filename":422,"language":423,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[207,425,426],{"__ignoreMap":105},[380,427,428,431,434,437,440,442,446,449,452,455,457],{"class":382,"line":383},[380,429,430],{"class":410},"$",[380,432,433],{"class":400},"vatly",[380,435,436],{"class":410},"->",[380,438,439],{"class":400},"testHelpers",[380,441,436],{"class":410},[380,443,445],{"class":444},"s2Zo4","fastForwardRenewal",[380,447,448],{"class":410},"(",[380,450,451],{"class":410},"'",[380,453,454],{"class":390},"subscription_Lp3mNvBxKw7RjTgYcZaE",[380,456,451],{"class":410},[380,458,459],{"class":410},");\n",[239,461,463],{"id":462},"response","Response",[198,465,466],{},"Returns the updated subscription with new renewal dates:",[371,468,472],{"className":469,"code":470,"language":471,"meta":105,"style":105},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"id\": \"subscription_Lp3mNvBxKw7RjTgYcZaE\",\n  \"resource\": \"subscription\",\n  \"customerId\": \"customer_Lp3mNvBxKw7RjTgYcZaE\",\n  \"testmode\": true,\n  \"name\": \"Pro Monthly\",\n  \"description\": \"Full access to all Pro features\",\n  \"billingAddress\": {\n    \"fullName\": \"John Doe\",\n    \"companyName\": \"Acme Corp\",\n    \"streetAndNumber\": \"123 Main Street\",\n    \"city\": \"Berlin\",\n    \"postalCode\": \"10115\",\n    \"country\": \"DE\"\n  },\n  \"basePrice\": {\n    \"value\": \"29.00\",\n    \"currency\": \"EUR\"\n  },\n  \"quantity\": 1,\n  \"interval\": \"month\",\n  \"intervalCount\": 1,\n  