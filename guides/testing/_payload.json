s","3.packages/1.php/99.webhookendpoints",{"title":152,"path":153,"stem":154,"children":155,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[156,159,162,165,168,171,174,178,182],{"title":117,"path":157,"stem":158},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":160,"stem":161},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":163,"stem":164},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":166,"stem":167},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":169,"stem":170},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":172,"stem":173},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":175,"path":176,"stem":177},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":179,"path":180,"stem":181},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":183,"path":184,"stem":185},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":187,"path":188,"stem":189},"Integrations","/integrations","4.integrations",{"id":191,"title":46,"body":192,"description":1529,"extension":1530,"links":1531,"meta":1532,"navigation":1533,"path":47,"seo":1534,"stem":48,"__hash__":1535},"docs/1.guides/9.testing.md",{"type":193,"value":194,"toc":1517},"minimark",[195,200,214,218,241,246,265,269,291,306,310,313,317,322,362,369,474,478,481,575,578,734,738,741,1513],[196,197,199],"h2",{"id":198},"overview","Overview",[201,202,203,204,208,209,213],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[205,206,207],"strong",{},"test mode"," and require a ",[210,211,212],"code",{},"test_"," prefixed API token.",[196,215,217],{"id":216},"taxes-in-test-mode","Taxes in test mode",[219,220,221,222,225,226,228,229,232,233,236,237,240],"warning",{},"In test mode, Vatly does ",[205,223,224],{},"not"," run real tax determination. Checkouts and orders created with a ",[210,227,212],{}," token use a ",[205,230,231],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[205,234,235],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[210,238,239],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[242,243,245],"h3",{"id":244},"how-test-mode-rates-are-applied","How test-mode rates are applied",[201,247,248,249,252,253,256,257,260,261,264],{},"The buyer's country determines a single fixed ",[205,250,251],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[205,254,255],{},"20%",". As an example of multi-rate handling, a Canada (",[210,258,259],{},"CA",") buyer also gets an additional 9.975% ",[210,262,263],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[242,266,268],{"id":267},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[201,270,271,272,274,275,278,279,282,283,286,287,290],{},"Tax IDs are ",[205,273,224],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[205,276,277],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[210,280,281],{},"DE123456789"," is valid for a German buyer, while ",[210,284,285],{},"de123456789"," or ",[210,288,289],{},"FR123…"," for a German buyer is not.",[201,292,293,294,297,298,301,302,305],{},"When a ",[205,295,296],{},"valid"," test tax ID is supplied and the buyer's country ",[205,299,300],{},"differs"," from the seller's, a ",[205,303,304],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[196,307,309],{"id":308},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[201,311,312],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval.",[242,314,316],{"id":315},"request","Request",[201,318,319],{},[210,320,321],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[323,324,325,341],"table",{},[326,327,328],"thead",{},[329,330,331,335,338],"tr",{},[332,333,334],"th",{},"Parameter",[332,336,337],{},"Type",[332,339,340],{},"Description",[342,343,344],"tbody",{},[329,345,346,352,355],{},[347,348,349],"td",{},[210,350,351],{},"subscriptionId",[347,353,354],{},"string",[347,356,357,358,361],{},"ID of the subscription to renew (starts with ",[210,359,360],{},"subscription_",")",[201,363,364,365,368],{},"The request body is ",[205,366,367],{},"optional",". Omit it to advance the billing cycle and leave the renewal payment pending — the endpoint's original behaviour. Provide it to force a specific renewal payment outcome so you can exercise your payment-recovery handling.",[323,370,371,382],{},[326,372,373],{},[329,374,375,378,380],{},[332,376,377],{},"Field",[332,379,337],{},[332,381,340],{},[342,383,384,413],{},[329,385,386,391,393],{},[347,387,388],{},[210,389,390],{},"paymentStatus",[347,392,354],{},[347,394,395,396,286,399,402,403,405,406,409,410,412],{},"Optional. Outcome to force on the renewal payment: ",[210,397,398],{},"paid",[210,400,401],{},"failed",". Omit to leave the payment pending. ",[210,404,401],{}," declines the payment and starts a payment recovery (delivering ",[210,407,408],{},"order.payment_failed"," to your webhook); ",[210,411,398],{}," settles it.",[329,414,415,420,422],{},[347,416,417],{},[210,418,419],{},"failureReason",[347,421,354],{},[347,423,424,425,428,429,432,433,432,436,439,440,442,443,432,445,432,447,432,449,432,452,432,455,432,458,432,461,432,464,432,467,432,470,473],{},"Optional. Which decline to simulate, valid only with ",[210,426,427],{},"paymentStatus: failed",". Soft declines (",[210,430,431],{},"insufficient_funds",", ",[210,434,435],{},"temporary_decline",[210,437,438],{},"general_failure",") retry over multiple weeks; every other value is a hard decline that asks the customer for a new payment method. Defaults to ",[210,441,438],{},". Allowed values: ",[210,444,431],{},[210,446,435],{},[210,448,438],{},[210,450,451],{},"invalid_mandate",[210,453,454],{},"mandate_canceled",[210,456,457],{},"account_closed",[210,459,460],{},"card_expired",[210,462,463],{},"card_lost_or_stolen",[210,465,466],{},"invalid_card_details",[210,468,469],{},"authentication_failed",[210,471,472],{},"fraud_suspected",".",[242,475,477],{"id":476},"example","Example",[201,479,480],{},"Advance the cycle and leave the renewal payment pending:",[482,483,485,533],"code-group",{"sync":484},"client",[486,487,492],"pre",{"className":488,"code":489,"filename":490,"language":491,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[210,493,494,517],{"__ignoreMap":109},[495,496,499,503,507,510,513],"span",{"class":497,"line":498},"line",1,[495,500,502],{"class":501},"sBMFI","curl",[495,504,506],{"class":505},"sfazB"," -X",[495,508,509],{"class":505}," POST",[495,511,512],{"class":505}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal",[495,514,516],{"class":515},"sTEyZ"," \\\n",[495,518,520,523,527,530],{"class":497,"line":519},2,[495,521,522],{"class":505},"  -H",[495,524,526],{"class":525},"sMK4o"," \"",[495,528,529],{"class":505},"Authorization: Bearer test_your_api_key_here",[495,531,532],{"class":525},"\"\n",[486,534,539],{"className":535,"code":536,"filename":537,"language":538,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[210,540,541],{"__ignoreMap":109},[495,542,543,546,549,552,555,557,561,564,567,570,572],{"class":497,"line":498},[495,544,545],{"class":525},"$",[495,547,548],{"class":515},"vatly",[495,550,551],{"class":525},"->",[495,553,554],{"class":515},"testHelpers",[495,556,551],{"class":525},[495,558,560],{"class":559},"s2Zo4","fastForwardRenewal",[495,562,563],{"class":525},"(",[495,565,566],{"class":525},"'",[495,568,569],{"class":505},"subscription_Lp3mNvBxKw7RjTgYcZaE",[495,571,566],{"class":525},[495,573,574],{"class":525},");\n",[201,576,577],{},"Force the renewal payment to fail with a hard decline to test payment recovery:",[482,579,580,657],{"sync":484},[486,581,583],{"className":488,"code":582,"filename":490,"language":491,"meta":109,"style":109},"curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"paymentStatus\": \"failed\",\n    \"failureReason\": \"card_expired\"\n  }'\n",[210,584,585,597,610,624,636,642,648],{"__ignoreMap":109},[495,586,587,589,591,593,595],{"class":497,"line":498},[495,588,502],{"class":501},[495,590,506],{"class":505},[495,592,509],{"class":505},[495,594,512],{"class":505},[495,596,516],{"class":515},[495,598,599,601,603,605,608],{"class":497,"line":519},[495,600,522],{"class":505},[495,602,526],{"class":525},[495,604,529],{"class":505},[495,606,607],{"class":525},"\"",[495,609,516],{"class