laravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":187,"path":188,"stem":189},"Integrations","\u002Fintegrations","4.integrations",{"id":191,"title":46,"body":192,"description":1650,"extension":1651,"links":1652,"meta":1653,"navigation":1654,"path":47,"seo":1655,"stem":48,"__hash__":1656},"docs\u002F1.guides\u002F9.testing.md",{"type":193,"value":194,"toc":1637},"minimark",[195,200,214,218,241,246,265,269,291,306,310,313,344,348,353,393,400,503,507,510,604,607,763,767,781,1551,1555,1567,1572,1625,1633],[196,197,199],"h2",{"id":198},"overview","Overview",[201,202,203,204,208,209,213],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[205,206,207],"strong",{},"test mode"," and require a ",[210,211,212],"code",{},"test_"," prefixed API token.",[196,215,217],{"id":216},"taxes-in-test-mode","Taxes in test mode",[219,220,221,222,225,226,228,229,232,233,236,237,240],"warning",{},"In test mode, Vatly does ",[205,223,224],{},"not"," run real tax determination. Checkouts and orders created with a ",[210,227,212],{}," token use a ",[205,230,231],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[205,234,235],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[210,238,239],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[242,243,245],"h3",{"id":244},"how-test-mode-rates-are-applied","How test-mode rates are applied",[201,247,248,249,252,253,256,257,260,261,264],{},"The buyer's country determines a single fixed ",[205,250,251],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[205,254,255],{},"20%",". As an example of multi-rate handling, a Canada (",[210,258,259],{},"CA",") buyer also gets an additional 9.975% ",[210,262,263],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[242,266,268],{"id":267},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[201,270,271,272,274,275,278,279,282,283,286,287,290],{},"Tax IDs are ",[205,273,224],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[205,276,277],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[210,280,281],{},"DE123456789"," is valid for a German buyer, while ",[210,284,285],{},"de123456789"," or ",[210,288,289],{},"FR123…"," for a German buyer is not.",[201,292,293,294,297,298,301,302,305],{},"When a ",[205,295,296],{},"valid"," test tax ID is supplied and the buyer's country ",[205,299,300],{},"differs"," from the seller's, a ",[205,303,304],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[196,307,309],{"id":308},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[201,311,312],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval. The subscription must be active and have a scheduled next renewal.",[201,314,315,316,319,320,323,324,327,328,331,332,335,336,339,340,343],{},"Like a live renewal, this runs ",[205,317,318],{},"asynchronously",": the request is accepted immediately, the renewal runs from a queue a moment later, and the outcome arrives on your ",[210,321,322],{},"order.paid"," \u002F ",[210,325,326],{},"order.payment_failed"," webhooks. The response therefore returns the subscription ",[205,329,330],{},"before"," the renewal — ",[210,333,334],{},"renewedAt",", ",[210,337,338],{},"renewedUntil",", and ",[210,341,342],{},"nextRenewalAt"," have not moved yet.",[242,345,347],{"id":346},"request","Request",[201,349,350],{},[210,351,352],{},"POST \u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002F{subscriptionId}\u002Ffast-forward-renewal",[354,355,356,372],"table",{},[357,358,359],"thead",{},[360,361,362,366,369],"tr",{},[363,364,365],"th",{},"Parameter",[363,367,368],{},"Type",[363,370,371],{},"Description",[373,374,375],"tbody",{},[360,376,377,383,386],{},[378,379,380],"td",{},[210,381,382],{},"subscriptionId",[378,384,385],{},"string",[378,387,388,389,392],{},"ID of the subscription to renew (starts with ",[210,390,391],{},"subscription_",")",[201,394,395,396,399],{},"The request body is ",[205,397,398],{},"optional",". Omit it to advance the billing cycle and leave the renewal payment pending — the endpoint's original behaviour. Provide it to force a specific renewal payment outcome so you can exercise your payment-recovery handling.",[354,401,402,413],{},[357,403,404],{},[360,405,406,409,411],{},[363,407,408],{},"Field",[363,410,368],{},[363,412,371],{},[373,414,415,443],{},[360,416,417,422,424],{},[378,418,419],{},[210,420,421],{},"paymentStatus",[378,423,385],{},[378,425,426,427,286,430,433,434,436,437,439,440,442],{},"Optional. Outcome to force on the renewal payment: ",[210,428,429],{},"paid",[210,431,432],{},"failed",". Omit to leave the payment pending. ",[210,435,432],{}," declines the payment and starts a payment recovery (delivering ",[210,438,326],{}," to your webhook); ",[210,441,429],{}," settles it.",[360,444,445,450,452],{},[378,446,447],{},[210,448,449],{},"failureReason",[378,451,385],{},[378,453,454,455,458,459,335,462,335,465,468,469,471,472,335,474,335,476,335,478,335,481,335,484,335,487,335,490,335,493,335,496,335,499,502],{},"Optional. Which decline to simulate, valid only with ",[210,456,457],{},"paymentStatus: failed",". Soft declines (",[210,460,461],{},"insufficient_funds",[210,463,464],{},"temporary_decline",[210,466,467],{},"general_failure",") retry over multiple weeks; every other value is a hard decline that asks the customer for a new payment method. Defaults to ",[210,470,467],{},". Allowed values: ",[210,473,461],{},[210,475,464],{},[210,477,467],{},[210,479,480],{},"invalid_mandate",[210,482,483],{},"mandate_canceled",[210,485,486],{},"account_closed",[210,488,489],{},"card_expired",[210,491,492],{},"card_lost_or_stolen",[210,494,495],{},"invalid_card_details",[210,497,498],{},"authentication_failed",[210,500,501],{},"fraud_suspected",".",[242,504,506],{"id":505},"example","Example",[201,508,509],{},"Advance the cycle and leave the renewal payment pending:",[511,512,514,562],"code-group",{"sync":513},"client",[515,516,521],"pre",{"className":517,"code":518,"filename":519,"language":520,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[210,522,523,546],{"__ignoreMap":109},[524,525,528,532,536,539,542],"span",{"class":526,"line":527},"line",1,[524,529,531],{"class":530},"sBMFI","curl",[524,533,535],{"class":534},"sfazB"," -X",[524,537,538],{"class":534}," POST",[524,540,541],{"class":534}," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal",[524,543,545],{"class":544},"sTEyZ"," \\\n",[524,547,549,552,556,559],{"class":526,"line":548},2,[524,550,551],{"class":534},"  -H",[524,553,555],{"class":554},"sMK4o"," \"",[524,557,558],{"class":534},"Authorization: Bearer test_your_api_key_here",[524,560,561],{"class":554},"\"\n",[515,563,568],{"className":564,"code":565,"filename":566,"language":567,"meta":109,"style":109},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[210,569,570],{"__ignoreMap":109},[524,571,572,575,578,581,584,586,590,593,596,599,601],{"class":526,"line":527},[524,573,574],{"class":554},"$",[524,576,577],{"class":544},"vatly",[524,579,580],{"class":554},"->",[524,582,583],{"class":544},"testHelpers",[524,585,580],{"class":554},[524,587,589],{"class":588},"s2Zo4","fastForwardRenewal",[524,591,592],{"class":554},"(",[524,594,595],{"class":554},"'",[524,597,598],{"class":534},"subscription_Lp3mNvBxKw7RjTgYcZaE",[524,600,595],{"class":554},[524,602,603],{"class":554},");\n",[201,605,606],{},"Force the renewal payment to fail with a hard decline to test payment recovery:",[511,608,609,686],{"sync":513},[515,610,612],{"className":517,"code":611,"filename":519,"language":520,"meta":109,"style":109},"curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\" \\\n  -H \"Content-Type: application\u002Fjson\" \\\n  -d '{\n    \"paymentStatus\": \"failed\",\n    \"failureReason\": \"card_expired\"\n  }'\n",[210,613,614,626,639,653,665,671,677],{"__ignoreMap":109},[524,615,616,618,620,622,624],{"class":526,"line":527},[524,617,531],{"class":530},[524,619,535],{"class":534},[524,621,538],{"class":534},[524,623,541],{"class":534},[524,625,545],{"class":544},[524,627,628,630,632,634,637],{"class":526,"line":548},[524,629,551],{"class":534},[524,631,555],{"class":554},[524,633,558],{"class":534},[524,635,636],{"class":554},"\"",[524,638,545],{"class":544},[524,640,642,644,646,649,651],{"class":526,"line":641},3,[524,643,551],{"class":534},[524,645,555],{"class":554},[524,647,648],{"class":534},"Content-Type: application\u002Fjson",[524,650,636],{"class":554},[524,652,545],{"class":544},[524,654,656,659,662],{"class":526,"line":655},4,[524,657,658],{"class":534},"  -d",[524,66