s","3.packages/1.php/99.webhookendpoints",{"title":152,"path":153,"stem":154,"children":155,"page":49},"Laravel","/packages/laravel","3.packages/2.laravel",[156,159,162,165,168,171,174,178,182],{"title":117,"path":157,"stem":158},"/packages/laravel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":160,"stem":161},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":68,"path":163,"stem":164},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":76,"path":166,"stem":167},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":84,"path":169,"stem":170},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":172,"stem":173},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":175,"path":176,"stem":177},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/6.comparison",{"title":179,"path":180,"stem":181},"Migrating from Cashier","/packages/laravel/migrating-to-vatly","3.packages/2.laravel/7.migrating-to-vatly",{"title":183,"path":184,"stem":185},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":187,"path":188,"stem":189},"Integrations","/integrations","4.integrations",{"id":191,"title":46,"body":192,"description":1172,"extension":1173,"links":1174,"meta":1175,"navigation":1176,"path":47,"seo":1177,"stem":48,"__hash__":1178},"docs/1.guides/9.testing.md",{"type":193,"value":194,"toc":1160},"minimark",[195,200,214,218,241,246,265,269,291,306,310,313,317,322,362,365,369,463,467,470,1156],[196,197,199],"h2",{"id":198},"overview","Overview",[201,202,203,204,208,209,213],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[205,206,207],"strong",{},"test mode"," and require a ",[210,211,212],"code",{},"test_"," prefixed API token.",[196,215,217],{"id":216},"taxes-in-test-mode","Taxes in test mode",[219,220,221,222,225,226,228,229,232,233,236,237,240],"warning",{},"In test mode, Vatly does ",[205,223,224],{},"not"," run real tax determination. Checkouts and orders created with a ",[210,227,212],{}," token use a ",[205,230,231],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[205,234,235],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[210,238,239],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[242,243,245],"h3",{"id":244},"how-test-mode-rates-are-applied","How test-mode rates are applied",[201,247,248,249,252,253,256,257,260,261,264],{},"The buyer's country determines a single fixed ",[205,250,251],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[205,254,255],{},"20%",". As an example of multi-rate handling, a Canada (",[210,258,259],{},"CA",") buyer also gets an additional 9.975% ",[210,262,263],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[242,266,268],{"id":267},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[201,270,271,272,274,275,278,279,282,283,286,287,290],{},"Tax IDs are ",[205,273,224],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[205,276,277],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[210,280,281],{},"DE123456789"," is valid for a German buyer, while ",[210,284,285],{},"de123456789"," or ",[210,288,289],{},"FR123…"," for a German buyer is not.",[201,292,293,294,297,298,301,302,305],{},"When a ",[205,295,296],{},"valid"," test tax ID is supplied and the buyer's country ",[205,299,300],{},"differs"," from the seller's, a ",[205,303,304],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[196,307,309],{"id":308},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[201,311,312],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval.",[242,314,316],{"id":315},"request","Request",[201,318,319],{},[210,320,321],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[323,324,325,341],"table",{},[326,327,328],"thead",{},[329,330,331,335,338],"tr",{},[332,333,334],"th",{},"Parameter",[332,336,337],{},"Type",[332,339,340],{},"Description",[342,343,344],"tbody",{},[329,345,346,352,355],{},[347,348,349],"td",{},[210,350,351],{},"subscriptionId",[347,353,354],{},"string",[347,356,357,358,361],{},"ID of the subscription to renew (starts with ",[210,359,360],{},"subscription_",")",[201,363,364],{},"No request body is required.",[242,366,368],{"id":367},"example","Example",[370,371,373,421],"code-group",{"sync":372},"client",[374,375,380],"pre",{"className":376,"code":377,"filename":378,"language":379,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[210,381,382,405],{"__ignoreMap":109},[383,384,387,391,395,398,401],"span",{"class":385,"line":386},"line",1,[383,388,390],{"class":389},"sBMFI","curl",[383,392,394],{"class":393},"sfazB"," -X",[383,396,397],{"class":393}," POST",[383,399,400],{"class":393}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal",[383,402,404],{"class":403},"sTEyZ",