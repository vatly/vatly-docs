vel/readme","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Running Vatly next to another billing provider","/packages/laravel/coexisting-with-cashier","3.packages/2.laravel/99.coexisting-with-cashier",{"title":172,"path":173,"stem":174},"Vs Cashier (Stripe, Paddle) & Lemon Squeezy","/packages/laravel/comparison","3.packages/2.laravel/99.comparison",{"title":176,"path":177,"stem":178},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":180,"path":181,"stem":182},"Integrations","/integrations","4.integrations",{"id":184,"title":46,"body":185,"description":1525,"extension":1526,"links":1527,"meta":1528,"navigation":1529,"path":47,"seo":1530,"stem":48,"__hash__":1531},"docs/1.guides/9.testing.md",{"type":186,"value":187,"toc":1508},"minimark",[188,193,207,211,234,239,258,262,284,299,303,306,310,315,355,358,362,456,460,463,1149,1153,1156,1159,1164,1214,1219,1301,1304,1434,1437,1504],[189,190,192],"h2",{"id":191},"overview","Overview",[194,195,196,197,201,202,206],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[198,199,200],"strong",{},"test mode"," and require a ",[203,204,205],"code",{},"test_"," prefixed API token.",[189,208,210],{"id":209},"taxes-in-test-mode","Taxes in test mode",[212,213,214,215,218,219,221,222,225,226,229,230,233],"warning",{},"In test mode, Vatly does ",[198,216,217],{},"not"," run real tax determination. Checkouts and orders created with a ",[203,220,205],{}," token use a ",[198,223,224],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[198,227,228],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[203,231,232],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[235,236,238],"h3",{"id":237},"how-test-mode-rates-are-applied","How test-mode rates are applied",[194,240,241,242,245,246,249,250,253,254,257],{},"The buyer's country determines a single fixed ",[198,243,244],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[198,247,248],{},"20%",". As an example of multi-rate handling, a Canada (",[203,251,252],{},"CA",") buyer also gets an additional 9.975% ",[203,255,256],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[235,259,261],{"id":260},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[194,263,264,265,267,268,271,272,275,276,279,280,283],{},"Tax IDs are ",[198,266,217],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[198,269,270],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[203,273,274],{},"DE123456789"," is valid for a German buyer, while ",[203,277,278],{},"de123456789"," or ",[203,281,282],{},"FR123…"," for a German buyer is not.",[194,285,286,287,290,291,294,295,298],{},"When a ",[198,288,289],{},"valid"," test tax ID is supplied and the buyer's country ",[198,292,293],{},"differs"," from the seller's, a ",[198,296,297],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[189,300,302],{"id":301},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[194,304,305],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval.",[235,307,309],{"id":308},"request","Request",[194,311,312],{},[203,313,314],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[316,317,318,334],"table",{},[319,320,321],"thead",{},[322,323,324,328,331],"tr",{},[325,326,327],"th",{},"Parameter",[325,329,330],{},"Type",[325,332,333],{},"Description",[335,336,337],"tbody",{},[322,338,339,345,348],{},[340,341,342],"td",{},[203,343,344],{},"subscriptionId",[340,346,347],{},"string",[340,349,350,351,354],{},"ID of the subscription to renew (starts with ",[203,352,353],{},"subscription_",")",[194,356,357],{},"No request body is required.",[235,359,361],{"id":360},"example","Example",[363,364,366,414],"code-group",{"sync":365},"client",[367,368,373],"pre",{"className":369,"code":370,"filename":371,"language":372,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[203,374,375,398],{"__ignoreMap":105},[376,377,380,384,388,391,394],"span",{"class":378,"line":379},"line",1,[376,381,383],{"class":382},"sBMFI","curl",[376,385,387],{"class":386},"sfazB"," -X",[376,389,390],{"class":386}," POST",[376,392,393],{"class":386}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal",[376,395,397],{"class":396},"sTEyZ"," \\\n",[376,399,401,404,408,411],{"class":378,"line":400},2,[376,402,403],{"class":386},"  -H",[376,405,407],{"class":406},"sMK4o"," \"",[376,409,410],{"