002F8.django\u002F02.configuration",{"title":424,"path":425,"stem":426},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":428,"path":429,"stem":430},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":432,"stem":433},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":193,"path":435,"stem":436},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":438,"stem":439},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":441,"path":442,"stem":443},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":445,"stem":446},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":363,"path":448,"stem":449},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":451,"path":452,"stem":453,"children":454},"Integrations","\u002Fintegrations","4.integrations",[455,457,461],{"title":451,"path":452,"stem":456},"4.integrations\u002Findex",{"title":458,"path":459,"stem":460},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":462,"path":463,"stem":464},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":466,"title":58,"body":467,"description":1926,"extension":1927,"links":1928,"meta":1929,"navigation":1930,"path":59,"seo":1931,"stem":60,"__hash__":1932},"docs\u002F1.guides\u002F9.testing.md",{"type":468,"value":469,"toc":1913},"minimark",[470,475,489,493,516,521,540,544,566,581,585,588,619,623,628,668,675,778,782,785,880,883,1039,1043,1057,1827,1831,1843,1848,1901,1909],[471,472,474],"h2",{"id":473},"overview","Overview",[476,477,478,479,483,484,488],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[480,481,482],"strong",{},"test mode"," and require a ",[485,486,487],"code",{},"test_"," prefixed API token.",[471,490,492],{"id":491},"taxes-in-test-mode","Taxes in test mode",[494,495,496,497,500,501,503,504,507,508,511,512,515],"warning",{},"In test mode, Vatly does ",[480,498,499],{},"not"," run real tax determination. Checkouts and orders created with a ",[485,502,487],{}," token use a ",[480,505,506],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[480,509,510],{},"These rates are simulated for testing only. They are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[485,513,514],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[517,518,520],"h3",{"id":519},"how-test-mode-rates-are-applied","How test-mode rates are applied",[476,522,523,524,527,528,531,532,535,536,539],{},"The buyer's country determines a single fixed ",[480,525,526],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[480,529,530],{},"20%",". As an example of multi-rate handling, a Canada (",[485,533,534],{},"CA",") buyer also gets an additional 9.975% ",[485,537,538],{},"QST"," line. Only the standard rate is ever applied: there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[517,541,543],{"id":542},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[476,545,546,547,549,550,553,554,557,558,561,562,565],{},"Tax IDs are ",[480,548,499],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[480,551,552],{},"valid only when it starts with the buyer's uppercase country code",". For example, ",[485,555,556],{},"DE123456789"," is valid for a German buyer, while ",[485,559,560],{},"de123456789"," or ",[485,563,564],{},"FR123…"," for a German buyer is not.",[476,567,568,569,572,573,576,577,580],{},"When a ",[480,570,571],{},"valid"," test tax ID is supplied and the buyer's country ",[480,574,575],{},"differs"," from the seller's, a ",[480,578,579],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[471,582,584],{"id":583},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[476,586,587],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval. The subscription must be active and have a scheduled next renewal.",[476,589,590,591,594,595,598,599,602,603,606,607,610,611,614,615,618],{},"Like a live renewal, this runs ",[480,592,593],{},"asynchronously",": the request is accepted immediately, the renewal runs from a queue a moment later, and the outcome arrives on your ",[485,596,597],{},"order.paid"," \u002F ",[485,600,601],{},"order.payment_failed"," webhooks. The response therefore returns the subscription ",[480,604,605],{},"before"," the renewal: ",[485,608,609],{},"renewedAt",", ",[485,612,613],{},"renewedUntil",", and ",[485,616,617],{},"nextRenewalAt"," have not moved yet.",[517,620,622],{"id":621},"request","Request",[476,624,625],{},[485,626,627],{},"POST \u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002F{subscriptionId}\u002Ffast-forward-renewal",[629,630,631,647],"table",{},[632,633,634],"thead",{},[635,636,637,641,644],"tr",{},[638,639,640],"th",{},"Parameter",[638,642,643],{},"Type",[638,645,646],{},"Description",[648,649,650],"tbody",{},[635,651,652,658,661],{},[653,654,655],"td",{},[485,656,657],{},"subscriptionId",[653,659,660],{},"string",[653,662,663,664,667],{},"ID of the subscription to renew (starts with ",[485,665,666],{},"subscription_",")",[476,669,670,671,674],{},"The request body is ",[480,672,673],{},"optional",". Omit it to advance the billing cycle and leave the renewal payment pending, the endpoint's original behaviour. Provide it to force a specific renewal payment outcome so you can exercise your payment-recovery handling.",[629,676,677,688],{},[632,678,679],{},[635,680,681,684,686],{},[638,682,683],{},"Field",[638,685,643],{},[638,687,646],{},[648,689,690,718],{},[635,691,692,697,699],{},[653,693,694],{},[485,695,696],{},"paymentStatus",[653,698,660],{},[653,700,701,702,561,705,708,709,711,712,714,715,717],{},"Optional. Outcome to force on the renewal payment: ",[485,703,704],{},"paid",[485,706,707],{},"failed",". Omit to leave the payment pending. ",[485,710,707],{}," declines the payment and starts a payment recovery (delivering ",[485,713,601],{}," to your webhook); ",[485,716,704],{}," settles it.",[635,719,720,725,727],{},[653,721,722],{},[485,723,724],{},"failureReason",[653,726,660],{},[653,728,729,730,733,734,610,737,610,740,743,744,746,747,610,749,610,751,610,753,610,756,610,759,610,762,610,765,610,768,610,771,610,774,777],{},"Optional. Which decline to simulate, valid only with ",[485,731,732],{},"paymentStatus: failed",". Soft declines (",[485,735,736],{},"insufficient_funds",[485,738,739],{},"temporary_decline",[485,741,742],{},"general_failure",") retry over multiple weeks; every other value is a hard decline that asks the customer for a new payment method. Defaults to ",[485,745,742],{},". Allowed values: ",[485,748,736],{},[485,750,739],{},[485,752,742],{},[485,754,755],{},"invalid_mandate",[485,757,758],{},"mandate_canceled",[485,760,761],{},"account_closed",[485,763,764],{},"card_expired",[485,766,767],{},"card_lost_or_stolen",[485,769,770],{},"invalid_card_details",[485,772,773],{},"authentication_failed",[485,775,776],{},"fraud_suspected",".",[517,779,781],{"id":780},"example","Example",[476,783,784],{},"Advance the cycle and leave the renewal payment pending:",[786,787,789,838],"code-group",{"sync":788},"client",[790,791,797],"pre",{"className":792,"code":793,"filename":794,"language":795,"meta":796,"style":796},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash","",[485,798,799,822],{"__ignoreMap":796},[800,801,804,808,812,815,818],"span",{"class":802,"line":803},"line",1,[800,805,807],{"class":806},"sBMFI","curl",[800,809,811],{"class":810},"sfazB"," -X",[800,813,814],{"class":810}," POST",[800,816,817],{"class":810}," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal",[800,819,821],{"class":820},"sTEyZ"," \\\n",[800,823,825,828,832,835],{"class":802,"line":824},2,[800,826,827],{"class":810},"  -H",[800,829,831],{"class":830},"sMK4o"," \"",[800,833,834],{"class":810},"Authorization: Bearer test_your_api_key_here",[800,836,837],{"class":830},"\"\n",[790,839,844],{"className":840,"code":841,"filename":842,"language":843,"meta":796,"style":796},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[485,845,846],{"__ignoreMap":796},[800,847,848,851,854,857,860,862,866,869,872,875,877],{"class":802,"line":803},[800,849,850],{"class":830},"$",[800,852,853],{"class":820},"vatly",[800,855,856],{"class":830},"->",[800,858,859],{"class":820},"testHelpers",[800,861,856],{"class":830},[800,863,865],{"class":864},"s2Zo4","fastForwardRenewal",[800,867,868],{"class":830},"(",[800,870,871],{"class":830},"'",[800,873,874],{"class":810},"subscription_Lp3mNvBxKw7RjTgYcZaE",[800,876,871],{"class":830},[800,878,879],{"class":830},");\n",[476,881,882],{},"Fo