ion","3.packages\u002F8.django\u002F02.configuration",{"title":425,"path":426,"stem":427},"Billable models","\u002Fpackages\u002Fdjango\u002Fbillablemodels","3.packages\u002F8.django\u002F03.billablemodels",{"title":429,"path":430,"stem":431},"Checkout","\u002Fpackages\u002Fdjango\u002Fcheckout","3.packages\u002F8.django\u002F04.checkout",{"title":88,"path":433,"stem":434},"\u002Fpackages\u002Fdjango\u002Fbilling","3.packages\u002F8.django\u002F05.billing",{"title":194,"path":436,"stem":437},"\u002Fpackages\u002Fdjango\u002Fcustomerportal","3.packages\u002F8.django\u002F06.customerportal",{"title":50,"path":439,"stem":440},"\u002Fpackages\u002Fdjango\u002Fwebhooks","3.packages\u002F8.django\u002F07.webhooks",{"title":442,"path":443,"stem":444},"Admin","\u002Fpackages\u002Fdjango\u002Fadmin","3.packages\u002F8.django\u002F08.admin",{"title":58,"path":446,"stem":447},"\u002Fpackages\u002Fdjango\u002Ftesting","3.packages\u002F8.django\u002F09.testing",{"title":364,"path":449,"stem":450},"\u002Fpackages\u002Fdjango\u002Fdevelopment","3.packages\u002F8.django\u002F10.development",{"title":452,"path":453,"stem":454,"children":455},"Integrations","\u002Fintegrations","4.integrations",[456,458,462],{"title":452,"path":453,"stem":457},"4.integrations\u002Findex",{"title":459,"path":460,"stem":461},"Lovable payments with Vatly","\u002Fintegrations\u002Flovable","4.integrations\u002F1.lovable",{"title":463,"path":464,"stem":465},"Bolt payments with Vatly","\u002Fintegrations\u002Fbolt","4.integrations\u002F2.bolt",{"id":467,"title":58,"body":468,"description":1927,"extension":1928,"links":1929,"meta":1930,"navigation":1931,"path":59,"seo":1932,"stem":60,"__hash__":1933},"docs\u002F1.guides\u002F9.testing.md",{"type":469,"value":470,"toc":1914},"minimark",[471,476,490,494,517,522,541,545,567,582,586,589,620,624,629,669,676,779,783,786,881,884,1040,1044,1058,1828,1832,1844,1849,1902,1910],[472,473,475],"h2",{"id":474},"overview","Overview",[477,478,479,480,484,485,489],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[481,482,483],"strong",{},"test mode"," and require a ",[486,487,488],"code",{},"test_"," prefixed API token.",[472,491,493],{"id":492},"taxes-in-test-mode","Taxes in test mode",[495,496,497,498,501,502,504,505,508,509,512,513,516],"warning",{},"In test mode, Vatly does ",[481,499,500],{},"not"," run real tax determination. Checkouts and orders created with a ",[486,503,488],{}," token use a ",[481,506,507],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[481,510,511],{},"These rates are simulated for testing only. They are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[486,514,515],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[518,519,521],"h3",{"id":520},"how-test-mode-rates-are-applied","How test-mode rates are applied",[477,523,524,525,528,529,532,533,536,537,540],{},"The buyer's country determines a single fixed ",[481,526,527],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[481,530,531],{},"20%",". As an example of multi-rate handling, a Canada (",[486,534,535],{},"CA",") buyer also gets an additional 9.975% ",[486,538,539],{},"QST"," line. Only the standard rate is ever applied: there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[518,542,544],{"id":543},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[477,546,547,548,550,551,554,555,558,559,562,563,566],{},"Tax IDs are ",[481,549,500],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[481,552,553],{},"valid only when it starts with the buyer's uppercase country code",". For example, ",[486,556,557],{},"DE123456789"," is valid for a German buyer, while ",[486,560,561],{},"de123456789"," or ",[486,564,565],{},"FR123…"," for a German buyer is not.",[477,568,569,570,573,574,577,578,581],{},"When a ",[481,571,572],{},"valid"," test tax ID is supplied and the buyer's country ",[481,575,576],{},"differs"," from the seller's, a ",[481,579,580],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[472,583,585],{"id":584},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[477,587,588],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval. The subscription must be active and have a scheduled next renewal.",[477,590,591,592,595,596,599,600,603,604,607,608,611,612,615,616,619],{},"Like a live renewal, this runs ",[481,593,594],{},"asynchronously",": the request is accepted immediately, the renewal runs from a queue a moment later, and the outcome arrives on your ",[486,597,598],{},"order.paid"," \u002F ",[486,601,602],{},"order.payment_failed"," webhooks. The response therefore returns the subscription ",[481,605,606],{},"before"," the renewal: ",[486,609,610],{},"renewedAt",", ",[486,613,614],{},"renewedUntil",", and ",[486,617,618],{},"nextRenewalAt"," have not moved yet.",[518,621,623],{"id":622},"request","Request",[477,625,626],{},[486,627,628],{},"POST \u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002F{subscriptionId}\u002Ffast-forward-renewal",[630,631,632,648],"table",{},[633,634,635],"thead",{},[636,637,638,642,645],"tr",{},[639,640,641],"th",{},"Parameter",[639,643,644],{},"Type",[639,646,647],{},"Description",[649,650,651],"tbody",{},[636,652,653,659,662],{},[654,655,656],"td",{},[486,657,658],{},"subscriptionId",[654,660,661],{},"string",[654,663,664,665,668],{},"ID of the subscription to renew (starts with ",[486,666,667],{},"subscription_",")",[477,670,671,672,675],{},"The request body is ",[481,673,674],{},"optional",". Omit it to advance the billing cycle and leave the renewal payment pending, the endpoint's original behaviour. Provide it to force a specific renewal payment outcome so you can exercise your payment-recovery handling.",[630,677,678,689],{},[633,679,680],{},[636,681,682,685,687],{},[639,683,684],{},"Field",[639,686,644],{},[639,688,647],{},[649,690,691,719],{},[636,692,693,698,700],{},[654,694,695],{},[486,696,697],{},"paymentStatus",[654,699,661],{},[654,701,702,703,562,706,709,710,712,713,715,716,718],{},"Optional. Outcome to force on the renewal payment: ",[486,704,705],{},"paid",[486,707,708],{},"failed",". Omit to leave the payment pending. ",[486,711,708],{}," declines the payment and starts a payment recovery (delivering ",[486,714,602],{}," to your webhook); ",[486,717,705],{}," settles it.",[636,720,721,726,728],{},[654,722,723],{},[486,724,725],{},"failureReason",[654,727,661],{},[654,729,730,731,734,735,611,738,611,741,744,745,747,748,611,750,611,752,611,754,611,757,611,760,611,763,611,766,611,769,611,772,611,775,778],{},"Optional. Which decline to simulate, valid only with ",[486,732,733],{},"paymentStatus: failed",". Soft declines (",[486,736,737],{},"insufficient_funds",[486,739,740],{},"temporary_decline",[486,742,743],{},"general_failure",") retry over multiple weeks; every other value is a hard decline that asks the customer for a new payment method. Defaults to ",[486,746,743],{},". Allowed values: ",[486,749,737],{},[486,751,740],{},[486,753,743],{},[486,755,756],{},"invalid_mandate",[486,758,759],{},"mandate_canceled",[486,761,762],{},"account_closed",[486,764,765],{},"card_expired",[486,767,768],{},"card_lost_or_stolen",[486,770,771],{},"invalid_card_details",[486,773,774],{},"authentication_failed",[486,776,777],{},"fraud_suspected",".",[518,780,782],{"id":781},"example","Example",[477,784,785],{},"Advance the cycle and leave the renewal payment pending:",[787,788,790,839],"code-group",{"sync":789},"client",[791,792,798],"pre",{"className":793,"code":794,"filename":795,"language":796,"meta":797,"style":797},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash","",[486,799,800,823],{"__ignoreMap":797},[801,802,805,809,813,816,819],"span",{"class":803,"line":804},"line",1,[801,806,808],{"class":807},"sBMFI","curl",[801,810,812],{"class":811},"sfazB"," -X",[801,814,815],{"class":811}," POST",[801,817,818],{"class":811}," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal",[801,820,822],{"class":821},"sTEyZ"," \\\n",[801,824,826,829,833,836],{"class":803,"line":825},2,[801,827,828],{"class":811},"  -H",[801,830,832],{"class":831},"sMK4o"," \"",[801,834,835],{"class":811},"Authorization: Bearer test_your_api_key_here",[801,837,838],{"class":831},"\"\n",[791,840,845],{"className":841,"code":842,"filename":843,"language":844,"meta":797,"style":797},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[486,846,847],{"__ignoreMap":797},[801,848,849,852,855,858,861,863,867,870,873,876,878],{"class":803,"line":804},[801,850,851],{"class":831},"$",[801,853,854],{"class":821},"vatly",[801,856,857],{"class":831},"->",[801,859,860],{"class":821},"testHelpers",[801,862,857],{"class":831},[801,864,866],{"class":865},"s2Zo4","fastForwardRenewal",[801,868,869],{"class":831},"(",[801,871,872],{"class":831},"'",[801,874,875],{"class":811},"subscription_Lp3mNvBxKw7RjTgYcZaE",[801,877,872],{"class":831},[801,879,880],{"class":831},");\n",[4