rison",{"title":187,"path":188,"stem":189},"Migrating from Cashier","\u002Fpackages\u002Flaravel\u002Fmigrating-to-vatly","3.packages\u002F2.laravel\u002F7.migrating-to-vatly",{"title":191,"path":192,"stem":193},"Configuration","\u002Fpackages\u002Flaravel\u002Fconfiguration","3.packages\u002F2.laravel\u002F99.configuration",{"title":195,"path":196,"stem":197},"Integrations","\u002Fintegrations","4.integrations",{"id":199,"title":54,"body":200,"description":1658,"extension":1659,"links":1660,"meta":1661,"navigation":1662,"path":55,"seo":1663,"stem":56,"__hash__":1664},"docs\u002F1.guides\u002F9.testing.md",{"type":201,"value":202,"toc":1645},"minimark",[203,208,222,226,249,254,273,277,299,314,318,321,352,356,361,401,408,511,515,518,612,615,771,775,789,1559,1563,1575,1580,1633,1641],[204,205,207],"h2",{"id":206},"overview","Overview",[209,210,211,212,216,217,221],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[213,214,215],"strong",{},"test mode"," and require a ",[218,219,220],"code",{},"test_"," prefixed API token.",[204,223,225],{"id":224},"taxes-in-test-mode","Taxes in test mode",[227,228,229,230,233,234,236,237,240,241,244,245,248],"warning",{},"In test mode, Vatly does ",[213,231,232],{},"not"," run real tax determination. Checkouts and orders created with a ",[218,235,220],{}," token use a ",[213,238,239],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[213,242,243],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[218,246,247],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[250,251,253],"h3",{"id":252},"how-test-mode-rates-are-applied","How test-mode rates are applied",[209,255,256,257,260,261,264,265,268,269,272],{},"The buyer's country determines a single fixed ",[213,258,259],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[213,262,263],{},"20%",". As an example of multi-rate handling, a Canada (",[218,266,267],{},"CA",") buyer also gets an additional 9.975% ",[218,270,271],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[250,274,276],{"id":275},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[209,278,279,280,282,283,286,287,290,291,294,295,298],{},"Tax IDs are ",[213,281,232],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[213,284,285],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[218,288,289],{},"DE123456789"," is valid for a German buyer, while ",[218,292,293],{},"de123456789"," or ",[218,296,297],{},"FR123…"," for a German buyer is not.",[209,300,301,302,305,306,309,310,313],{},"When a ",[213,303,304],{},"valid"," test tax ID is supplied and the buyer's country ",[213,307,308],{},"differs"," from the seller's, a ",[213,311,312],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[204,315,317],{"id":316},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[209,319,320],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval. The subscription must be active and have a scheduled next renewal.",[209,322,323,324,327,328,331,332,335,336,339,340,343,344,347,348,351],{},"Like a live renewal, this runs ",[213,325,326],{},"asynchronously",": the request is accepted immediately, the renewal runs from a queue a moment later, and the outcome arrives on your ",[218,329,330],{},"order.paid"," \u002F ",[218,333,334],{},"order.payment_failed"," webhooks. The response therefore returns the subscription ",[213,337,338],{},"before"," the renewal — ",[218,341,342],{},"renewedAt",", ",[218,345,346],{},"renewedUntil",", and ",[218,349,350],{},"nextRenewalAt"," have not moved yet.",[250,353,355],{"id":354},"request","Request",[209,357,358],{},[218,359,360],{},"POST \u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002F{subscriptionId}\u002Ffast-forward-renewal",[362,363,364,380],"table",{},[365,366,367],"thead",{},[368,369,370,374,377],"tr",{},[371,372,373],"th",{},"Parameter",[371,375,376],{},"Type",[371,378,379],{},"Description",[381,382,383],"tbody",{},[368,384,385,391,394],{},[386,387,388],"td",{},[218,389,390],{},"subscriptionId",[386,392,393],{},"string",[386,395,396,397,400],{},"ID of the subscription to renew (starts with ",[218,398,399],{},"subscription_",")",[209,402,403,404,407],{},"The request body is ",[213,405,406],{},"optional",". Omit it to advance the billing cycle and leave the renewal payment pending — the endpoint's original behaviour. Provide it to force a specific renewal payment outcome so you can exercise your payment-recovery handling.",[362,409,410,421],{},[365,411,412],{},[368,413,414,417,419],{},[371,415,416],{},"Field",[371,418,376],{},[371,420,379],{},[381,422,423,451],{},[368,424,425,430,432],{},[386,426,427],{},[218,428,429],{},"paymentStatus",[386,431,393],{},[386,433,434,435,294,438,441,442,444,445,447,448,450],{},"Optional. Outcome to force on the renewal payment: ",[218,436,437],{},"paid",[218,439,440],{},"failed",". Omit to leave the payment pending. ",[218,443,440],{}," declines the payment and starts a payment recovery (delivering ",[218,446,334],{}," to your webhook); ",[218,449,437],{}," settles it.",[368,452,453,458,460],{},[386,454,455],{},[218,456,457],{},"failureReason",[386,459,393],{},[386,461,462,463,466,467,343,470,343,473,476,477,479,480,343,482,343,484,343,486,343,489,343,492,343,495,343,498,343,501,343,504,343,507,510],{},"Optional. Which decline to simulate, valid only with ",[218,464,465],{},"paymentStatus: failed",". Soft declines (",[218,468,469],{},"insufficient_funds",[218,471,472],{},"temporary_decline",[218,474,475],{},"general_failure",") retry over multiple weeks; every other value is a hard decline that asks the customer for a new payment method. Defaults to ",[218,478,475],{},". Allowed values: ",[218,481,469],{},[218,483,472],{},[218,485,475],{},[218,487,488],{},"invalid_mandate",[218,490,491],{},"mandate_canceled",[218,493,494],{},"account_closed",[218,496,497],{},"card_expired",[218,499,500],{},"card_lost_or_stolen",[218,502,503],{},"invalid_card_details",[218,505,506],{},"authentication_failed",[218,508,509],{},"fraud_suspected",".",[250,512,514],{"id":513},"example","Example",[209,516,517],{},"Advance the cycle and leave the renewal payment pending:",[519,520,522,570],"code-group",{"sync":521},"client",[523,524,529],"pre",{"className":525,"code":526,"filename":527,"language":528,"meta":117,"style":117},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[218,530,531,554],{"__ignoreMap":117},[532,533,536,540,544,547,550],"span",{"class":534,"line":535},"line",1,[532,537,539],{"class":538},"sBMFI","curl",[532,541,543],{"class":542},"sfazB"," -X",[532,545,546],{"class":542}," POST",[532,548,549],{"class":542}," https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal",[532,551,553],{"class":552},"sTEyZ"," \\\n",[532,555,557,560,564,567],{"class":534,"line":556},2,[532,558,559],{"class":542},"  -H",[532,561,563],{"class":562},"sMK4o"," \"",[532,565,566],{"class":542},"Authorization: Bearer test_your_api_key_here",[532,568,569],{"class":562},"\"\n",[523,571,576],{"className":572,"code":573,"filename":574,"language":575,"meta":117,"style":117},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscription_Lp3mNvBxKw7RjTgYcZaE');\n","PHP","php",[218,577,578],{"__ignoreMap":117},[532,579,580,583,586,589,592,594,598,601,604,607,609],{"class":534,"line":535},[532,581,582],{"class":562},"$",[532,584,585],{"class":552},"vatly",[532,587,588],{"class":562},"->",[532,590,591],{"class":552},"testHelpers",[532,593,588],{"class":562},[532,595,597],{"class":596},"s2Zo4","fastForwardRenewal",[532,599,600],{"class":562},"(",[532,602,603],{"class":562},"'",[532,605,606],{"class":542},"subscription_Lp3mNvBxKw7RjTgYcZaE",[532,608,603],{"class":562},[532,610,611],{"class":562},");\n",[209,613,614],{},"Force the renewal payment to fail with a hard decline to test payment recovery:",[519,616,617,694],{"sync":521},[523,618,620],{"className":525,"code":619,"filename":527,"language":528,"meta":117,"style":117},"curl -X POST https:\u002F\u002Fapi.vatly.com\u002Fv1\u002Ftest-helpers\u002Fsubscriptions\u002Fsubscription_Lp3mNvBxKw7RjTgYcZaE\u002Ffast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\" \\\n  -H \"Content-Type: application\u002Fjson\" \\\n  -d '{\n    \"paymentStatus\": \"failed\",\n    \"failureReason\": \"card_expired\"\n  }'\n",[218,621,622,634,647,661,673,679,685],{"__ignoreMap":117},[532,623,624,626,628,630,632],{"class":534,"line":535},[532,625,539],{"class":538},[532,627,543],{"class":542},[532,629,546],{"class":542},[532,631,549],{"class":542},[532,633,553],{"class":552},[532,635,636,638,640,642,645],{"class":534,"line":556},[532,637,559],{"class":542},[532,639,563],{"class":562},[532,641,566],{"class":542},[532,643,644],{"class":562},"\"",[532,646,553],{"class":552},[532,648,650,652,654,657,659],{"class":534,"line":649},3,[532,651,559],{"clas