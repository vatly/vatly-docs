me","3.packages/2.laravel/0.readme",{"title":56,"path":153,"stem":154},"/packages/laravel/customers","3.packages/2.laravel/1.customers",{"title":64,"path":156,"stem":157},"/packages/laravel/checkouts","3.packages/2.laravel/2.checkouts",{"title":72,"path":159,"stem":160},"/packages/laravel/subscriptions","3.packages/2.laravel/3.subscriptions",{"title":80,"path":162,"stem":163},"/packages/laravel/orders","3.packages/2.laravel/4.orders",{"title":38,"path":165,"stem":166},"/packages/laravel/webhooks","3.packages/2.laravel/5.webhooks",{"title":168,"path":169,"stem":170},"Configuration","/packages/laravel/configuration","3.packages/2.laravel/99.configuration",{"title":172,"path":173,"stem":174},"Integrations","/integrations","4.integrations",{"id":176,"title":46,"body":177,"description":1517,"extension":1518,"links":1519,"meta":1520,"navigation":1521,"path":47,"seo":1522,"stem":48,"__hash__":1523},"docs/1.guides/9.testing.md",{"type":178,"value":179,"toc":1500},"minimark",[180,185,199,203,226,231,250,254,276,291,295,298,302,307,347,350,354,448,452,455,1141,1145,1148,1151,1156,1206,1211,1293,1296,1426,1429,1496],[181,182,184],"h2",{"id":183},"overview","Overview",[186,187,188,189,193,194,198],"p",{},"Vatly provides test helper endpoints that let you simulate billing events without waiting for real billing cycles. These endpoints are only available in ",[190,191,192],"strong",{},"test mode"," and require a ",[195,196,197],"code",{},"test_"," prefixed API token.",[181,200,202],{"id":201},"taxes-in-test-mode","Taxes in test mode",[204,205,206,207,210,211,213,214,217,218,221,222,225],"warning",{},"In test mode, Vatly does ",[190,208,209],{},"not"," run real tax determination. Checkouts and orders created with a ",[195,212,197],{}," token use a ",[190,215,216],{},"fixed, predefined set of tax rates"," so results are predictable while you build your integration. ",[190,219,220],{},"These rates are simulated for testing only — they are not guaranteed to match real, current statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[195,223,224],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[227,228,230],"h3",{"id":229},"how-test-mode-rates-are-applied","How test-mode rates are applied",[186,232,233,234,237,238,241,242,245,246,249],{},"The buyer's country determines a single fixed ",[190,235,236],{},"standard"," VAT rate from a built-in lookup. Any country without a specific entry is taxed at a flat ",[190,239,240],{},"20%",". As an example of multi-rate handling, a Canada (",[195,243,244],{},"CA",") buyer also gets an additional 9.975% ",[195,247,248],{},"QST"," line. Only the standard rate is ever applied — there are no reduced or product-specific rates, and the lookup is not kept in sync with statutory changes.",[227,251,253],{"id":252},"tax-ids-and-reverse-charge-in-test-mode","Tax IDs and reverse charge in test mode",[186,255,256,257,259,260,263,264,267,268,271,272,275],{},"Tax IDs are ",[190,258,209],{}," checked against VIES or any real registry in test mode. A test tax ID is treated as ",[190,261,262],{},"valid only when it starts with the buyer's uppercase country code"," — for example ",[195,265,266],{},"DE123456789"," is valid for a German buyer, while ",[195,269,270],{},"de123456789"," or ",[195,273,274],{},"FR123…"," for a German buyer is not.",[186,277,278,279,282,283,286,287,290],{},"When a ",[190,280,281],{},"valid"," test tax ID is supplied and the buyer's country ",[190,284,285],{},"differs"," from the seller's, a ",[190,288,289],{},"0% reverse charge"," is applied (B2B cross-border). Otherwise the buyer's country standard rate applies.",[181,292,294],{"id":293},"fast-forward-subscription-renewal","Fast-forward subscription renewal",[186,296,297],{},"Simulates a subscription renewal cycle, allowing you to test renewal billing flows, lifecycle events, and webhooks without waiting for the actual billing interval.",[227,299,301],{"id":300},"request","Request",[186,303,304],{},[195,305,306],{},"POST /v1/test-helpers/subscriptions/{subscriptionId}/fast-forward-renewal",[308,309,310,326],"table",{},[311,312,313],"thead",{},[314,315,316,320,323],"tr",{},[317,318,319],"th",{},"Parameter",[317,321,322],{},"Type",[317,324,325],{},"Description",[327,328,329],"tbody",{},[314,330,331,337,340],{},[332,333,334],"td",{},[195,335,336],{},"subscriptionId",[332,338,339],{},"string",[332,341,342,343,346],{},"ID of the subscription to renew (starts with ",[195,344,345],{},"subscription_",")",[186,348,349],{},"No request body is required.",[227,351,353],{"id":352},"example","Example",[355,356,358,406],"code-group",{"sync":357},"client",[359,360,365],"pre",{"className":361,"code":362,"filename":363,"language":364,"meta":105,"style":105},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal \\\n  -H \"Authorization: Bearer test_your_api_key_here\"\n","cURL","bash",[195,366,367,390],{"__ignoreMap":105},[368,369,372,376,380,383,386],"span",{"class":370,"line":371},"line",1,[368,373,375],{"class":374},"sBMFI","curl",[368,377,379],{"class":378},"sfazB"," -X",[368,381,382],{"class":378}," POST",[368,384,385],{"class":378}," https://api.vatly.com/v1/test-helpers/subscriptions/subscription_Lp3mNvBxKw7RjTgYcZaE/fast-forward-renewal",[368,387,389],{"class":388},"sTEyZ"," \\\n",[368,391,393,396,400,403],{"class":370,"line":392},2,[368,394,395],{"class":378},"  -H",[368,397,399],{"class":398},"sMK4o"," \"",[368,401,402],{"class":378},"Authorization: Bearer test_your_api_key_here",[368,404,405],{"class":398},"\"\n",[359,407,412],{"className":408,"code":409,"filename":410,"language":411,"meta":105,"style":105},"language-php shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","$vatly->testHelpers->fastForwardRenewal('subscrip