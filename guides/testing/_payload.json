t statutory rates, and must never be relied upon for pricing decisions, accounting, invoicing, or tax compliance."," Switch to a ",[195,223,224],{},"live_"," token to get Vatly's real, jurisdiction-accurate tax determination.",[227,228,230],"h3",{"id":229},"how-test-mode-rates-are-applied","How test-mode rates are applied",[186,232,233,234,236,237,240],{},"The buyer's country determines a single fixed standard rate. Any country ",[190,235,209],{}," in the table below is taxed at a flat ",[190,238,239],{},"20% \"VAT\"",".",[242,243,244,263],"table",{},[245,246,247],"thead",{},[248,249,250,254,257,260],"tr",{},[251,252,253],"th",{},"Country",[251,255,256],{},"Code",[251,258,259],{},"Rate",[251,261,262],{},"Name",[264,265,266,283,299,314,330,346,361,376,391,407,422,436,450,466,482,498,513,528,543,559,574,589,603,617,631,646,660,675],"tbody",{},[248,267,268,272,277,280],{},[269,270,271],"td",{},"Austria",[269,273,274],{},[195,275,276],{},"AT",[269,278,279],{},"20%",[269,281,282],{},"MwSt./USt.",[248,284,285,288,293,296],{},[269,286,287],{},"Belgium",[269,289,290],{},[195,291,292],{},"BE",[269,294,295],{},"21%",[269,297,298],{},"BTW/TVA/MWSt",[248,300,301,304,309,311],{},[269,302,303],{},"Bulgaria",[269,305,306],{},[195,307,308],{},"BG",[269,310,279],{},[269,312,313],{},"ДДС",[248,315,316,319,324,327],{},[269,317,318],{},"Croatia",[269,320,321],{},[195,322,323],{},"HR",[269,325,326],{},"25%",[269,328,329],{},"PDV",[248,331,332,335,340,343],{},[269,333,334],{},"Cyprus",[269,336,337],{},[195,338,339],{},"CY",[269,341,342],{},"19%",[269,344,345],{},"ΦΠΑ",[248,347,348,351,356,358],{},[269,349,350],{},"Czechia",[269,352,353],{},[195,354,355],{},"CZ",[269,357,295],{},[269,359,360],{},"DPH",[248,362,363,366,371,373],{},[269,364,365],{},"Denmark",[269,367,368],{},[195,369,370],{},"DK",[269,372,326],{},[269,374,375],{},"moms",[248,377,378,381,386,388],{},[269,379,380],{},"Estonia",[269,382,383],{},[195,384,385],{},"EE",[269,387,279],{},[269,389,390],{},"km",[248,392,393,396,401,4