24,1056,1057],{"class":344},"e",[324,1059,876],{"class":354},[324,1061,879],{"class":354},[324,1063,1065,1068,1071],{"class":326,"line":1064},15,[324,1066,1067],{"class":354},"            $",[324,1069,1070],{"class":344},"attempt",[324,1072,1073],{"class":354},"++;\n",[324,1075,1077],{"class":326,"line":1076},16,[324,1078,506],{"emptyLinePlaceholder":505},[324,1080,1082],{"class":326,"line":1081},17,[324,1083,1085],{"class":1084},"sHwdD","            \u002F\u002F Only retry on network errors or server errors (5xx)\n",[324,1087,1089,1092,1094,1096,1098,1101,1104,1107,1110,1113,1115,1117,1120,1122,1124,1126],{"class":326,"line":1088},18,[324,1090,1091],{"class":955},"            if",[324,1093,959],{"class":354},[324,1095,1057],{"class":344},[324,1097,482],{"class":354},[324,1099,1100],{"class":485},"getCode",[324,1102,1103],{"class":354},"()",[324,1105,1106],{"class":354}," \u003C",[324,1108,1109],{"class":451}," 500",[324,1111,1112],{"class":354}," ||",[324,1114,518],{"class":354},[324,1116,939],{"class":344},[324,1118,1119],{"class":354},">=",[324,1121,518],{"class":354},[324,1123,969],{"class":344},[324,1125,876],{"class":354},[324,1127,879],{"class":354},[324,1129,1131,1134,1136,1138],{"class":326,"line":1130},19,[324,1132,1133],{"class":955},"                throw",[324,1135,518],{"class":354},[324,1137,1057],{"class":344},[324,1139,932],{"class":354},[324,1141,1143],{"class":326,"line":1142},20,[324,1144,1145],{"class":354},"            }\n",[324,1147,1149],{"class":326,"line":1148},21,[324,1150,506],{"emptyLinePlaceholder":505},[324,1152,1154],{"class":326,"line":1153},22,[324,1155,1156],{"class":1084},"            \u002F\u002F Wait before retrying (with exponential backoff)\n",[324,1158,1160,1163,1165,1168,1170,1173,1175,1177,1179],{"class":326,"line":1159},23,[324,1161,1162],{"class":485},"            sleep",[324,1164,489],{"class":354},[324,1166,1167],{"class":485},"pow",[324,1169,489],{"class":354},[324,1171,1172],{"class":451},"2",[324,1174,868],{"class":354},[324,1176,518],{"class":354},[324,1178,1070],{"class":344},[324,1180,1181],{"class":354},"));\n",[324,1183,1185],{"class":326,"line":1184},24,[324,1186,1187],{"class":354},"        }\n",[324,1189,1191],{"class":326,"line":1190},25,[324,1192,1193],{"class":354},"    }\n",[324,1195,1197],{"class":326,"line":1196},26,[324,1198,1199],{"class":354},"}\n",[286,1201,1203],{"id":1202},"supported-endpoints","Supported endpoints",[291,1205,1206,1207,1209],{},"All mutating requests accept an optional ",[305,1208,307],{}," header:",[719,1211,1212,1219,1224,1229],{},[667,1213,1214,1215,1218],{},"All ",[305,1216,1217],{},"POST"," requests",[667,1220,1214,1221,1218],{},[305,1222,1223],{},"PATCH",[667,1225,1214,1226,1218],{},[305,1227,1228],{},"PUT",[667,1230,1214,1231,1218],{},[305,1232,1233],{},"DELETE",[656,1235,1236,1237,1239,1240,691,1243,1246],{},"An ",[305,1238,307],{}," sent on a ",[305,1241,1242],{},"GET",[305,1244,1245],{},"HEAD"," request is ignored, since those methods don't mutate state.",[286,1248,1250],{"id":1249},"error-handling","Error handling",[291,1252,1253],{},"If you receive an error response, check the status code to determine if you should retry the request:",[719,1255,1256,1261],{},[667,1257,1258,1260],{},[305,1259,690],{}," errors: Client errors (like validation errors) should not be retried with the same data.",[667,1262,1263,1265],{},[305,1264,694],{}," errors: Server errors can be safely retried with the same idempotency key.",[1267,1268,1270,1271],"h3",{"id":1269},"understanding-409-conflict","Understanding ",[305,1272,712],{},[291,1274,1275,1276,1278,1279,1282,1283,717],{},"A ",[305,1277,751],{}," shares one HTTP status across several distinct cases. The ",[305,1280,1281],{},"message"," distinguishes them, and idempotency cases also set ",[305,1284,1285],{},"details.idempotency_outcome",[719,1287,1288,1302,1318,1329,1335],{},[667,1289,1290,1293,1294,1296,1297,1301],{},[671,1291,1292],{},"Replay mismatch",": the ",[305,1295,307],{}," was reused with different request parameters (see ",[1298,1299,702],"a",{"href":1300},"#what-binds-an-idempotency-key","). Retry with the original parameters or generate a new key.",[667,1303,1304,1309,1310,1313,1314,1317],{},[671,1305,1306],{},[305,1307,1308],{},"details.idempotency_outcome = in_progress",": ",[671,1311,1312],{},"retryable."," Another caller is still processing this exact request. Wait the number of seconds in the ",[305,1315,1316],{},"Retry-After"," header, then resend the exact same request and key.",[667,1319,1320,1309,1325,1328],{},[671,1321,1322],{},[305,1323,1324],{},"details.idempotency_outcome = unknown",[671,1326,1327],{},"not retryable."," The mutation may have completed, but its response could not be recorded and cannot be replayed safely. Read and reconcile the affected resource state before taking any further mutating action. Never automatically retry, with either the same key or a fresh one.",[667,1330,1331,1334],{},[671,1332,1333],{},"Concurrent write",": two writers modified the same resource at the same version. Reload the latest state and retry; the conflict resolves itself unless contention is sustained.",[667,1336,1337,1340,1341,1344,1345,1347,1348,1351],{},[671,1338,1339],{},"Refund already being created",": another refund of the same order is still being created, flagged by ",[305,1342,1343],{},"details.retry_with_new_idempotency_key = true",". This response is stored against the ",[305,1346,307],{}," you sent, so retry with a ",[671,1349,1350],{},"new"," key.",[656,1353,1354,1356,1357,1360],{},[305,1355,1316],{}," is present only for the ",[305,1358,1359],{},"in_progress"," case. It tells you how many seconds to wait before resending the exact request and key.",[286,1362,1364],{"id":1363},"rate-limits","Rate limits",[291,1366,1367,1370,1371,1375,1376,1379,1380,1317],{},[671,1368,1369],{},"Exact replays still consume rate-limit budget."," API and per-merchant write throttles run ",[1372,1373,1374],"em",{},"before"," the idempotency lookup, so an otherwise valid replay can return ",[305,1377,1378],{},"429 Too Many Requests"," instead of the stored response. When this happens, wait for the interval in the ",[305,1381,1316],{},[1383,1384,1385],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .s7zQu, html code.shiki .s7zQu{--shiki-light:#39ADB5;--shiki-light-font-style:italic;--shiki-default:#89DDFF;--shiki-default-font-style:italic;--shiki-dark:#89DDFF;--shiki-dark-font-style:italic}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}",{"title":320,"searchDepth":348,"depth":348,"links":1387},[1388,1389,1390,1391,1392,1393,1394,1395,1399],{"id":288,"depth":348,"text":289},{"id":299,"depth":348,"text":300},{"id":661,"depth":348,"text":662},{"id":701,"depth":348,"text":702},{"id":761,"depth":348,"text":762},{"id":794,"depth":348,"text":795},{"id":1202,"depth":348,"text":1203},{"id":1249,"depth":348,"text":1250,"children":1396},[1397],{"id":1269,"depth":366,"text":1398},"Understanding 409 Conflict",{"id":1363,"depth":348,"text":1364},"Learn how to use idempotency keys to safely retry API requests without creating duplicate resources.","md",null,{},{"title":50,"description":1400},"a2Q1a4rg9JLp9rkPkGD3u-DpeiFxJX4ijhv9tyGlTKs",[1407,1409],{"title":46,"path":47,"stem":48,"description":1408,"children":-1},"In this guide, we will look at how to register and consume webhooks to integrate your app with Vatly.",{"title":54,"path":55,"stem":56,"description":1410,"children":-1},"Use test helper endpoints to simulate billing events like subscription renewals in sandbox mode.",1794234737741]