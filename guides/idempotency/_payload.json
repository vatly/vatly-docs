ep track of idempotency keys alongside your request data.",[577,618,619,622],{},[607,620,621],{},"Set retry policies",": Configure your HTTP client to automatically retry failed requests with the same idempotency key.",[577,624,625,628],{},[607,626,627],{},"Handle errors",": Check error responses to determine if you should retry with the same key.",[196,630,632],{"id":631},"example-retry-implementation","Example retry implementation",[201,634,635],{},"Here's an example of how to implement automatic retries with idempotency:",[224,637,639],{"className":342,"code":638,"filename":344,"language":345,"meta":109,"style":109},"$vatly = new \\Vatly\\API\\VatlyApiClient();\n$vatly->setApiKey('live_your_api_key_here');\n\nfunction createCheckoutWithRetry($vatly, $data) {\n    $idempotencyKey = \\Ramsey\\Uuid\\Uuid::uuid4()->toString();\n    $maxRetries = 3;\n    $attempt = 0;\n\n    while ($attempt \u003C $maxRetries) {\n        try {\n            return $vatly->checkouts->create($data, [\n                'idempotencyKey' => $idempotencyKey,\n            ]);\n        } catch (\\Vatly\\Exception\\ApiException $e) {\n            $attempt++;\n\n            // Only retry on network errors or server errors (5xx)\n            if ($e->getCode() \u003C 500 || $attempt >= $maxRetries) {\n                throw $e;\n            }\n\n            // Wait before retrying (with exponential backoff)\n            sleep(pow(2, $attempt));\n        }\n    }\n}\n",[215,640,641,665,685,689,717,755,770,784,788,811,818,843,860,866,899,911,916,923,965,977,983,988,994,1019,1025,1031],{"__ignoreMap":109},[233,642,643,645,647,649,651,653,655,657,659,661,663],{"class":235,"line":236},[233,644,352],{"class":263},[233,646,355],{"class":253},[233,648,358],{"class":263},[233,650,362],{"class":361},[233,652,365],{"class":263},[233,654,368],{"class":253},[233,656,371],{"class":263},[233,658,374],{"class":253},[233,660,371],{"class":263},[233,662,379],{"class":239},[233,664,382],{"class":263},[233,666,667,669,