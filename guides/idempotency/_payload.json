201,205,206],{},"For example, if you're creating a checkout and the request fails due to a network error, you can safely retry the request without worrying about creating duplicate checkouts.",[196,208,210],{"id":209},"using-idempotency-keys","Using idempotency keys",[201,212,213,214,218],{},"To make an idempotent request, include a unique ",[215,216,217],"code",{},"Idempotency-Key"," header with your request:",[220,221,223,340],"code-group",{"sync":222},"client",[224,225,230],"pre",{"className":226,"code":227,"filename":228,"language":229,"meta":109,"style":109},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST https://api.vatly.com/v1/checkouts \\\n  -H \"Authorization: Bearer live_your_api_key_here\" \\\n  -H \"Idempotency-Key: 123e4567-e89b-12d3-a456-426614174000\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"products\": [{\"id\": \"subscription_plan_Bm7xNvPwKr3YjTgHcZaE\"}],\n    \"redirectUrlSuccess\": \"https://example.com/success\",\n    \"redirectUrlCanceled\": \"https://example.com/canceled\"\n  }'\n","cURL","bash",[215,231,232,255,273,287,301,313,319,325,331],{"__ignoreMap":109},[233,234,237,241,245,248,251],"span",{"class":235,"line":236},"line",1,[233,238,240],{"class":239},"sBMFI","curl",[233,242,244],{"class":243},"sfazB"," -X",[233,246,247],{"class":243}," POST",[233,249,250],{"class":243}," https://api.vatly.com/v1/checkouts",[233,252,254],{"class":253},"sTEyZ"," \\\n",[233,256,258,261,265,268,271],{"class":235,"line":257},2,[233,259,260],{"class":243},"  -H",[233,262,264],{"class":263},"sMK4o"," \"",[233,266,267],{"class":243},"Authorization: Bearer live_your_api_key_here",[233,269,270],{"class":263},"\"",[233,272,254],{"class":253},[233,274,276,278,280,283,285],{"class":235,"line":275},3,[233,277,260],{"class":243},[233,279,264],{"class":263},[233,281,282],{"class":243},"Idempotency-Key: 123e4567-e89b-12d3-a456-426614174000",[233,284,270],{"class":263},[233,286,254],{"